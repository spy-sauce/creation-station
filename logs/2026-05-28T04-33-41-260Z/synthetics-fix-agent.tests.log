data-agent.migrations.application\n        scope: backend/migrations/003_application.sql — applications,\n          application_events, outreach_messages, contacts\n      - id: data-agent.migrations.auth\n        scope: backend/migrations/004_auth.sql — magic_link_tokens, sessions\n      - id: data-agent.models.base\n        scope: backend/models/__init__.py + base Declarative class with UUID PK +\n          created_at/updated_at mixins\n      - id: data-agent.models.discovery\n        scope: backend/models/discovery.py — Candidate, DiscoveredJob, ScoredJob,\n          DailyDigest, CrawlRun ORM\n      - id: data-agent.models.application\n        scope: backend/models/application.py — Application, ApplicationEvent,\n          OutreachMessage, Contact ORM\n      - id: data-agent.models.auth\n        scope: backend/models/auth.py — MagicLinkToken, Session ORM\n      - id: data-agent.schemas.discovery\n        scope: backend/agents/discovery/schemas.py — Pydantic v2 schemas for all\n          discovery contracts\n      - id: data-agent.schemas.application\n        scope: backend/agents/application/schemas.py — Pydantic v2 schemas for\n          application contracts\n  - id: design-agent\n    scope: Design tokens, Top Shelf editorial, CSS custom properties, typography,\n      StatusBadge, StatCard\n    branch: feat/design-agent\n    blocked_by: []\n    blocks:\n      - frontend-agent\n    capabilities:\n      - tailwind\n      - css-tokens\n      - design-system\n    sub_agents:\n      - id: design-agent.tokens.palette\n        scope: frontend/src/design/tokens.css — Top Shelf palette as CSS custom\n          properties (--ink, --paper, --gold, severity colors)\n      - id: design-agent.tokens.typography\n        scope: frontend/src/design/typography.css — font stacks + scale + line-heights\n      - id: design-agent.tokens.spacing\n        scope: frontend/src/design/spacing.css — 4px-based spacing scale + radius tokens\n      - id: design-agent.primitives.status-badge\n        scope: frontend/src/components/StatusBadge.tsx — variant prop per agent\n          lifecycle state, identity-color border\n      - id: design-agent.primitives.stat-card\n        scope: frontend/src/components/StatCard.tsx — title + value + delta + sparkline\n          slot\n      - id: design-agent.docs.cheatsheet\n        scope: frontend/src/design/CHEATSHEET.md — token names, usage rules, do/don't\n      - id: design-agent.docs.reference\n        scope: frontend/src/design/REFERENCE.md — full token table + component gallery\n  - id: auth-agent\n    scope: JWT issuance, magic-link flow, Resend integration, get_current_user\n      dependency\n    branch: feat/auth-agent\n    blocked_by:\n      - data-agent\n    blocks:\n      - api-agent\n      - frontend-agent\n      - api-streaming-agent\n    capabilities:\n      - jwt\n      - resend\n      - fastapi-deps\n    sub_agents:\n      - id: auth-agent.magic-link.request\n        scope: backend/api/auth.py POST /auth/magic-link — issue token, send via Resend,\n          rate-limit 3/hour/email\n      - id: auth-agent.magic-link.verify\n        scope: backend/api/auth.py POST /auth/verify — validate token, mint JWT, return\n          session cookie\n      - id: auth-agent.magic-link.resend\n        scope: backend/api/auth.py POST /auth/resend — invalidate prior token, issue new\n      - id: auth-agent.jwt.issue\n        scope: backend/auth/jwt.py issue_jwt(candidate_id, ttl_hours=24) — HS256, signed\n          with settings.jwt_secret\n      - id: auth-agent.jwt.validate\n        scope: backend/auth/jwt.py validate_jwt(token) — raise on expired/invalid\n      - id: auth-agent.jwt.current-user\n        scope: backend/auth/deps.py get_current_user FastAPI dependency — reads cookie\n          or Authorization header, loads Candidate\n  - id: obs-agent\n    scope: \"Observability: structlog config, PII redaction, Redis pub/sub taxonomy,\n      CRM events, health endpoint\"\n    branch: feat/obs-agent\n    blocked_by:\n      - data-agent\n    blocks:\n      - api-agent\n      - discover-agent\n      - apply-agent\n      - api-streaming-agent\n    capabilities:\n      - structlog\n      - redis-pubsub\n      - logging\n    sub_agents:\n      - id: obs-agent.logging.config\n        scope: backend/obs/logging.py — structlog config, JSON renderer in prod, console\n          in dev, request-id correlation\n      - id: obs-agent.logging.pii-redact\n        scope: backend/obs/redact.py — processor that scrubs emails, phones, resumes,\n          tokens before log emission\n      - id: obs-agent.pubsub.taxonomy\n        scope: backend/obs/events.py — channel constants + payload schemas\n          (agent.status.{name}, digest.ready, application.event)\n      - id: obs-agent.pubsub.publisher\n        scope: backend/obs/publisher.py — publish_event(channel, payload) async helper\n          with retry + dead-letter logging\n  - id: apply-agent\n    scope: \"Application engine: JD parser, resume tailor, company intel, contact\n      finder, outreach composer, auto-apply\"\n    branch: feat/apply-agent\n    blocked_by:\n      - data-agent\n      - obs-agent\n      - discover-agent\n    blocks:\n      - agents-agent\n    capabilities:\n      - anthropic-sdk\n      - playwright\n      - pydantic\n    sub_agents:\n      - id: apply-agent.jd-parser\n        scope: backend/agents/application/jd_parser.py — Claude extracts requirements,\n          responsibilities, comp signal from raw_description\n      - id: apply-agent.resume-tailor\n        scope: backend/agents/application/resume_tailor.py — emphasize matching\n          experience without fabricating skills\n      - id: apply-agent.company-intel\n        scope: backend/agents/application/company_intel.py — Claude + web fetch for\n          mission, recent news, funding signal\n      - id: apply-agent.contact-finder\n        scope: backend/agents/application/contact_finder.py — LinkedIn/Hunter pivot to\n          recruiter or hiring manager\n      - id: apply-agent.outreach.composer\n        scope: backend/agents/application/outreach_composer.py — personalized opener +\n          value pitch + call to action\n      - id: apply-agent.auto-apply.greenhouse\n        scope: backend/agents/application/auto_apply.py Greenhouse path — uses\n          ats_selectors.yaml for field mapping\n      - id: apply-agent.auto-apply.lever\n        scope: backend/agents/application/auto_apply.py Lever path — split single 'name'\n          into first/last\n      - id: apply-agent.auto-apply.ashby\n        scope: backend/agents/application/auto_apply.py Ashby path — _systemfield_name\n          combined-name handling\n      - id: apply-agent.auto-apply.workday\n        scope: backend/agents/application/auto_apply.py Workday path — multi-step\n          continuation, account creation flow, file upload\n      - id: apply-agent.orchestrator\n        scope: backend/agents/application/orchestrator.py — ApplicationOrchestrator\n          wires all sub-agents + Application state machine +\n          agent.status.application pub/sub\n  - id: agents-agent\n    scope: \"AgentManager: Claude tool_use agentic loop, sub-agent registry, pipeline\n      dispatcher, execution records\"\n    branch: feat/agents-agent\n    blocked_by:\n      - apply-agent\n    blocks:\n      - api-agent\n    capabilities:\n      - anthropic-sdk\n      - tool-use\n      - redis-pubsub\n    sub_agents:\n      - id: agents-agent.registry.defaults\n        scope: backend/agents/manager/registry.py — default sub-agent registry mapping\n          {discover, apply, score, compose} → handler\n      - id: agents-agent.runner.execute\n        scope: backend/agents/manager/runner.py — Claude tool_use agentic loop, max-iter\n          guard, structured result envelope\n      - id: agents-agent.runner.retry\n        scope: backend/agents/manager/retry.py — exponential backoff retry policy with\n          dead-letter logging on terminal failure\n      - id: agents-agent.dispatcher.pipeline\n        scope: backend/agents/manager/dispatcher.py — multi-step pipeline orchestration\n          across registered handlers\n  - id: api-agent\n    scope: FastAPI app, routers, middleware, health endpoint, CORS, database wiring\n    branch: feat/api-agent\n    blocked_by:\n      - data-agent\n      - auth-agent\n      - obs-agent\n      - agents-agent\n    blocks:\n      - frontend-agent\n      - infra-agent\n      - api-client-agent\n      - api-streaming-agent\n    capabilities:\n      - fastapi\n      - pydantic\n      - sqlalchemy\n      - uvicorn\n    sub_agents:\n      - id: api-agent.core.main\n        scope: backend/main.py — FastAPI app factory, router registration, lifespan (db\n          + redis init)\n      - id: api-agent.core.config\n        scope: backend/config.py — Pydantic Settings, env loading, secret resolution\n      - id: api-agent.core.database\n        scope: backend/database.py — async SQLAlchemy engine, session factory, redis\n          client factory, get_db dependency\n      - id: api-agent.routers.discovery\n        scope: backend/api/discovery.py — GET /digest/today, POST /discovery/run, GET\n          /jobs/{id}\n      - id: api-agent.routers.application\n        scope: backend/api/application.py — POST /applications, GET /applications, POST\n          /applications/{id}/approve, POST /applications/{id}/reject\n      - id: api-agent.routers.review\n        scope: backend/api/review.py — GET /review/queue, POST /review/{id}/decision\n      - id: api-agent.onboarding.resume-profile\n        scope: backend/api/onboarding.py — POST /onboarding/resume upload + profile\n          build + initial archetype expansion\n      - id: api-agent.health.endpoint\n        scope: backend/api/health.py — GET /health, GET /readiness with db + redis\n          probes\n  - id: frontend-agent\n    scope: React 19 + Vite 8 frontend, UI primitives, routing, auth context, pages\n    branch: feat/frontend-agent\n    blocked_by:\n      - desi