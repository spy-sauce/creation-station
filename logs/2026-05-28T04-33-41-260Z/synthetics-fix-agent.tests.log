beat\n        scope: backend/api/events.py — :ping every 15s for connection loss detection\n      - id: api-streaming-agent.backpressure\n        scope: backend/api/events.py — drop >100 messages behind, emit slow_client event\n  - id: api-client-agent\n    scope: \"Frontend API client wiring: fetch wrapper, auth token injection, page\n      data integration\"\n    branch: feat/api-client-agent\n    blocked_by:\n      - api-agent\n      - frontend-agent\n      - api-streaming-agent\n    blocks:\n      - tests-agent\n    capabilities:\n      - typescript\n      - fetch\n      - eventsource\n    sub_agents:\n      - id: api-client-agent.client\n        scope: frontend/src/api/client.ts — single apiClient instance, base URL from\n          VITE_API_BASE_URL\n      - id: api-client-agent.auth\n        scope: frontend/src/api/auth.ts — requestMagicLink, verifyToken, refreshSession,\n          JWT in localStorage\n      - id: api-client-agent.discovery\n        scope: frontend/src/api/discovery.ts — getTodayDigest, triggerDiscoveryRun,\n          getJob\n      - id: api-client-agent.applications\n        scope: frontend/src/api/applications.ts — listApplications, approveApplication,\n          rejectApplication\n      - id: api-client-agent.events\n        scope: frontend/src/api/events.ts — subscribeAgentStatus(channel, onMessage) via\n          EventSource\n      - id: api-client-agent.error-handling\n        scope: frontend/src/api/client.ts — 401 → invalidate JWT, redirect to /login,\n          toast\n      - id: api-client-agent.page-wiring\n        scope: Re-wire Overview.tsx, Pipeline.tsx, Analytics.tsx, ReviewQueue.tsx,\n          ReviewDetail.tsx to use apiClient\n  - id: tests-agent\n    scope: pytest and vitest test suites for all iter-4 biomes\n    branch: feat/tests-agent\n    blocked_by:\n      - discover-agent\n      - scheduler-agent\n      - api-streaming-agent\n      - api-client-agent\n    blocks: []\n    capabilities:\n      - pytest\n      - vitest\n      - fakeredis\n    sub_agents:\n      - id: tests-agent.discovery.pubsub\n        scope: tests/discovery/test_orchestrator_pubsub.py — fake Redis, verify 8+ event\n          sequence\n      - id: tests-agent.scheduler.daily\n        scope: tests/scheduler/test_daily_task.py — mock orchestrator, verify crawl_runs\n          creation\n      - id: tests-agent.api.events\n        scope: tests/api/test_events_stream.py — TestClient streaming, verify SSE frames\n          + heartbeat\n      - id: tests-agent.api.review\n        scope: tests/api/test_review_approve.py — full integration approve flow\n      - id: tests-agent.frontend.client\n        scope: frontend/src/api/__tests__/client.test.ts — vitest, mock fetch, 401\n          handling\n  - id: synthetics-fixtures-agent\n    scope: Synthetic candidate fixtures, JD fixtures, baseline scaffolding, seeder\n      for deterministic test data\n    branch: feat/synthetics-fixtures-agent\n    blocked_by: []\n    blocks:\n      - synthetics-scoring-agent\n      - synthetics-crawler-agent\n    capabilities:\n      - pydantic\n      - pyyaml\n      - uuid5\n    sub_agents:\n      - id: synthetics-fixtures-agent.candidates\n        scope: synthetics/fixtures/candidates.yaml — 3 synthetic candidates with full\n          resume text + identity context\n      - id: synthetics-fixtures-agent.jobs\n        scope: synthetics/fixtures/jobs/ — 12 JD markdown files with expected_hot +\n          expected_score_band frontmatter\n      - id: synthetics-fixtures-agent.baselines\n        scope: synthetics/fixtures/baselines/ — gitignored scaffold for baseline\n          fingerprints\n      - id: synthetics-fixtures-agent.seeder\n        scope: synthetics/fixtures/seeder.py — idempotent loader that upserts synthetic\n          candidates into Postgres on backend boot\n  - id: synthetics-scoring-agent\n    scope: Deterministic scoring drift detection via fingerprinting and diffing\n      against accepted baselines\n    branch: feat/synthetics-scoring-agent\n    blocked_by:\n      - synthetics-fixtures-agent\n    blocks: []\n    capabilities:\n      - anthropic-sdk\n      - pydantic\n      - structlog\n    sub_agents:\n      - id: synthetics-scoring-agent.runner\n        scope: backend/synthetics/scoring_runner.py — ScoringSyntheticRunner.run_suite()\n          iterates synthetic candidates × JDs\n      - id: synthetics-scoring-agent.fingerprint\n        scope: backend/synthetics/fingerprint.py — compute_fingerprint(digest, contract)\n          produces stable JSON per candidate\n      - id: synthetics-scoring-agent.diff\n        scope: backend/synthetics/diff.py — diff_against_baseline(fingerprint, baseline,\n          contract) returns DriftReport\n      - id: synthetics-scoring-agent.cli\n        scope: backend/synthetics/cli.py — python -m backend.synthetics run\n          --suite=scoring\n      - id: synthetics-scoring-agent.cache-verification\n        scope: backend/synthetics/scoring_runner.py — verify cache_creation_input_tokens\n          == 0 on subsequent runs\n  - id: synthetics-crawler-agent\n    scope: Upstream health monitoring with state machine alerts for consecutive\n      failures\n    branch: feat/synthetics-crawler-agent\n    blocked_by:\n      - synthetics-fixtures-agent\n    blocks: []\n    capabilities:\n      - httpx\n      - redis-pubsub\n      - structlog\n    sub_agents:\n      - id: synthetics-crawler-agent.runner\n        scope: backend/synthetics/crawler_health.py — CrawlerHealthRunner.run_suite()\n          hits known-good slugs per source\n      - id: synthetics-crawler-agent.schemas\n        scope: backend/synthetics/expected_schema_v1.json — expected top-level shape for\n          Greenhouse/Lever/Ashby\n      - id: synthetics-crawler-agent.state-machine\n        scope: synthetics/state.json — consecutive_failures tracking with 3-strike alert\n          threshold\n      - id: synthetics-crawler-agent.beat-extension\n        scope: backend/synthetics/beat_schedule.py —