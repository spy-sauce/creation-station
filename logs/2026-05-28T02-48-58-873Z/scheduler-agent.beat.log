{"t":"2026-05-28T02:50:20.801Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LNFsR6CzbTcYSGajQzkBoB","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"Celery task definitions for daily discovery runs.\n     5→\n     6→This module defines the `daily_discovery_task` that wraps the async\n     7→DiscoveryOrchestrator.run() with asyncio.run() for Celery's sync workers.\n     8→\n     9→Retry policy:\n    10→    - 3 retries with exponential backoff: 60s, 300s, 900s\n    11→    - On terminal failure: write traceback to crawl_runs.error_log\n    12→    - Publish DAILY_TASK_DEAD event to agent.status.discovery\n    13→\n    14→Idempotency:\n    15→    - Task ID format: discovery-{candidate_id}-{YYYY-MM-DD}\n    16→    - Prevents duplicate runs if worker re-fires on the same day\n    17→\n    18→Contract: HYPHA-SCHEDULER.md\n    19→\"\"\"\n    20→\n    21→from __future__ import annotations\n    22→\n    23→import asyncio\n    24→import traceback\n    25→from datetime import date, datetime, timezone\n    26→from typing import TYPE_CHECKING\n    27→from uuid import UUID\n    28→\n    29→import redis.asyncio as aioredis\n    30→import structlog\n    31→from celery import Task\n    32→from celery.exceptions import MaxRetriesExceededError\n    33→from sqlalchemy import select\n    34→from sqlalchemy.ext.asyncio import AsyncSession, create_async_engine, async_sessionmaker\n    35→\n    36→from backend.config import settings\n    37→from backend.scheduler.celery_app import celery_app\n    38→from backend.observability.events import PubSubChannel, publish_event, BaseEvent\n    39→\n    40→if TYPE_CHECKING:\n    41→    from backend.agents.discovery.orchestrator import DiscoveryOrchestrator\n    42→\n    43→logger = structlog.get_logger(__name__)\n    44→\n    45→# Retry countdown in seconds: 60s, 300s (5min), 900s (15min)\n    46→RETRY_COUNTDOWNS = [60, 300, 900]\n    47→\n    48→\n    49→class DailyTaskDeadEvent(BaseEvent):\n    50→    \"\"\"Event published when a daily discovery task exhausts all retries.\n    51→\n    52→    Published to: agent.status.discovery\n    53→    \"\"\"\n    54→\n    55→    event: str = \"DAILY_TASK_DEAD\"\n    56→    candidate_id: str\n    57→    task_id: str\n    58→    error: str\n    59→    retries_exhausted: int\n    60→\n    61→\n    62→def _compute_task_id(candidate_id: str | UUID) -> str:\n    63→    \"\"\"Compute idempotent task ID for a candidate on today's date (UTC).\n    64→\n    65→    Format: discovery-{candidate_id}-{YYYY-MM-DD}\n    66→\n    67→    Args:\n    68→        candidate_id: The candidate's UUID\n    69→\n    70→    Returns:\n    71→        Idempotent task ID string\n    72→    \"\"\"\n    73→    run_date = date.today().isoformat()\n    74→    return f\"discovery-{candidate_id}-{run_date}\"\n    75→\n    76→\n    77→async def _run_discovery(candidate_id: UUID) -> None:\n    78→    \"\"\"Run the async discovery orchestrator with fresh connections.\n    79→\n    80→    Creates a fresh DB session and Redis client for this invocation,\n    81→    ensuring no connection pooling issues across Celery tasks.\n    82→\n    83→    Args:\n    84→        candidate_id: UUID of the candidate to run discovery for\n    85→\n    86→    Raises:\n    87→        Exception: Any error from the orchestrator is propagated\n    88→    \"\"\"\n    89→    # Import here to avoid circular imports at module load time\n    90→    from backend.agents.discovery.orchestrator import DiscoveryOrchestrator\n    91→    from backend.models.discovery import CrawlRun\n    92→\n    93→    # Create fresh async engine for this task (no shared pool across workers)\n    94→    engine = create_async_engine(\n    95→        settings.database_url,\n    96→        echo=False,\n    97→        pool_pre_ping=True,\n    98→        pool_size=1,\n    99→        max_overflow=0,\n   100→    )\n   101→    session_factory = async_sessionmaker(\n   102→        engine,\n   103→        class_=AsyncSession,\n   104→        expire_on_commit=False,\n   105→    )\n   106→\n   107→    # Create fresh Redis client\n   108→    redis_client = aioredis.from_url(\n   109→        settings.redis_url,\n   110→        decode_responses=True,\n   111→    )\n   112→\n   113→    try:\n   114→        async with session_factory() as db:\n   115→            orchestrator = DiscoveryOrchestrator(db, redis_client)\n   116→            await orchestrator.run(candidate_id, dry_run=False)\n   117→    finally:\n   118→        await redis_client.aclose()\n   119→        await engine.dispose()\n   120→\n   121→\n   122→async def _mark_crawl_run_failed(candidate_id: UUID, error_log: str) -> None:\n   123→    \"\"\"Mark the most recent RUNNING crawl run as FAILED with error log.\n   124→\n   125→    Args:\n   126→        candidate_id: UUID of the candidate\n   127→        error_log: Traceback or error message to record\n   128→    \"\"\"\n   129→    from backend.models.discovery import CrawlRun\n   130→\n   131→    engine = create_async_engine(\n   132→        settings.database_url,\n   133→        echo=False,\n   134→        pool_pre_ping=True,\n   135→        pool_size=1,\n   136→        max_overflow=0,\n   137→    )\n   138→    session_factory = async_sessionmaker(\n   139→        engine,\n   140→        class_=AsyncSession,\n   141→        expire_on_commit=False,\n   142→    )\n   143→\n   144→    try:\n   145→        async with session_factory() as db:\n   146→            # Find the most recent RUNNING crawl run for this candidate\n   147→            result = await db.execute(\n   148→                select(CrawlRun)\n   149→                .where(CrawlRun.candidate_id == candidate_id)\n   150→                .where(CrawlRun.status == \"RUNNING\")\n   151→                .order_by(CrawlRun.started_at.desc())\n   152→                .limit(1)\n   153→            )\n   154→            crawl_run = result.scalar_one_or_none()\n   155→\n   156→            if crawl_run:\n   157→                crawl_run.status = \"FAILED\"\n   158→                crawl_run.completed_at = datetime.now(timezone.utc)\n   159→                crawl_run.error_log = error_log\n   160→                await db.commit()\n   161→                logger.info(\n   162→                    \"task.crawl_run_marked_failed\",\n   163→                    crawl_run_id=str(crawl_run.id),\n   164→                    candidate_id=str(candidate_id),\n   165→                )\n   166→            else:\n   167→                logger.warning(\n   168→                    \"task.no_running_crawl_run\",\n   169→                    candidate_id=str(candidate_id),\n   170→                )\n   171→    finally:\n   172→        await engine.dispose()\n   173→\n   174→\n   175→async def _publish_dead_event(\n   176→    candidate_id: UUID, task_id: str, error: str, retries: int\n   177→) -> None:\n   178→    \"\"\"Publish DAILY_TASK_DEAD event to agent.status.discovery.\n   179→\n   180→    Args:\n   181→        candidate_id: UUID of the candidate\n   182→        task_id: The Celery task ID\n   183→        error: Error message or traceback\n   184→        retries: Number of retries exhausted\n   185→    \"\"\"\n   186→    redis_client = aioredis.from_url(\n   187→        settings.redis_url,\n   188→        decode_responses=True,\n   189→    )\n   190→\n   191→    try:\n   192→        event = DailyTaskDeadEvent(\n   193→            candidate_id=str(candidate_id),\n   194→            task_id=task_id,\n   195→            error=error,\n   196→            retries_exhausted=retries,\n   197→        )\n   198→        await publish_event(redis_client, PubSubChannel.DISCOVERY, event)\n   199→        logger.info(\n   200→            \"task.dead_event_published\",\n   201→            candidate_id=str(candidate_id),\n   202→            task_id=task_id,\n   203→        )\n   204→    finally:\n   205→        await redis_client.aclose()\n   206→\n   207→\n   208→@celery_app.task(\n   209→    bind=True,\n   210→    name=\"backend.scheduler.tasks.daily_discovery_task\",\n   211→    max_retries=3,\n   212→    default_retry_delay=60,\n   213→    autoretry_for=(Exception,),\n   214→    retry_backoff=False,  # We implement custom backoff via countdown\n   215→    acks_late=True,\n   216→    reject_on_worker_lost=True,\n   217→    track_started=True,\n   218→)\n   219→def daily_discovery_task(self: Task, candidate_id: str) -> dict:\n   220→    \"\"\"Run daily job discovery for a single candidate.\n   221→\n   222→    This task wraps the async DiscoveryOrchestrator.run() with asyncio.run()\n   223→    since Celery workers are synchronous by design. Each invocation creates\n   224→    a fresh event loop, DB session, and Redis client.\n   225→\n   226→    Retry policy:\n   227→        - 3 retries with exponential backoff: 60s, 300s, 900s\n   228→        - On MaxRetriesExceededError: write to crawl_runs.error_log,\n   229→          publish DAILY_TASK_DEAD, then re-raise\n   230→\n   231→    Args:\n   232→        candidate_id: UUID string of the candidate\n   233→\n   234→    Returns:\n   235→        dict with status and candidate_id on success\n   236→\n   237→    Raises:\n   238→        MaxRetriesExceededError: After 3 failed attempts\n   239→    \"\"\"\n   240→    candidate_uuid = UUID(candidate_id)\n   241→    task_id = _compute_task_id(candidate_id)\n   242→    attempt = self.request.retries + 1\n   243→\n   244→    log = logger.bind(\n   245→        candidate_id=candidate_id,\n   246→        task_id=task_id,\n   247→        attempt=attempt,\n   248→        max_retries=self.max_retries,\n   249→    )\n   250→\n   251→    log.info(\"task.started\")\n   252→\n   253→    try:\n   254→        # Run the async orchestrator in a fresh event loop\n   255→        asyncio.run(_run_discovery(candidate_uuid))\n   256→\n   257→        log.info(\"task.completed\")\n   258→        return {\n   259→            \"status\": \"completed\",\n   260→            \"candidate_id\": candidate_id,\n   261→            \"task_id\": task_id,\n   262→        }\n   263→\n   264→    except Exception as exc:\n   265→        error_msg = str(exc)\n   266→        tb = traceback.format_exc()\n   267→\n   268→        log.error(\n   269→            \"task.failed\",\n   270→            error=error_msg,\n   271→            traceback=tb,\n   272→        )\n   273→\n   274→        # Check if we've exhausted retries\n   275→        if self.request.retries >= self.max_retries:\n   276→            log.error(\n   277→                \"task.max_retries_exceeded\",\n   278→                retries_exhausted=self.max_retries,\n   279→            )\n   280→\n   281→            # Write to crawl_runs.error_log and publish DAILY_TASK_DEAD\n   282→            asyncio.run(_mark_crawl_run_failed(candidate_uuid, tb))\n   283→            asyncio.run(\n   284→                _publish_dead_event(\n   285→                    candidate_uuid,\n   286→                    task_id,\n   287→                    error_msg,\n   288→                    self.max_retries,\n   289→                )\n   290→            )\n   291→\n   292→            # Re-raise to mark task as failed\n   293→            raise MaxRetriesExceededError(\n   294→                f\"Task {task_id} failed after {self.max_retries} retries: {error_msg}\"\n   295→            ) from exc\n   296→\n   297→        # Calculate countdown for next retry (exponential backoff)\n   298→        retry_index = min(self.request.retries, len(RETRY_COUNTDOWNS) - 1)\n   299→        countdown = RETRY_COUNTDOWNS[retry_index]\n   300→\n   301→        log.info(\n   302→            \"task.retrying\",\n   303→            countdown=countdown,\n   304→            next_attempt=attempt + 1,\n   305→        )\n   306→\n   307→        # Schedule retry with backoff\n   308→        raise self.retry(exc=exc, countdown=countdown)\n   309→\n   310→\n   311→def trigger_daily_discovery(candidate_id: str | UUID) -> str:\n   312→    \"\"\"Trigger a daily discovery task for a candidate.\n   313→\n   314→    This is a convenience function for programmatic triggering,\n   315→    e.g., from the API endpoint or Celery beat scheduler.\n   316→\n   317→    Args:\n   318→        candidate_id: UUID or string UUID of the candidate\n   319→\n   320→    Returns:\n   321→        The Celery task ID (idempotent, based on candidate + date)\n   322→    \"\"\"\n   323→    candidate_str = str(candidate_id)\n   324→    task_id = _compute_task_id(candidate_str)\n   325→\n   326→    daily_discovery_task.apply_async(\n   327→        args=[candidate_str],\n   328→        task_id=task_id,\n   329→    )\n   330→\n   331→    logger.info(\n   332→        \"task.triggered\",\n   333→        candidate_id=candidate_str,\n   334→        task_id=task_id,\n   335→    )\n   336→\n   337→    return task_id\n   338→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"c75b5245-28ca-4616-895d-d50eaafdef6b","uuid":"f695cc7b-48da-43ed-8dc1-8ff677a0c6b4","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/scheduler/tasks.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"Celery task definitions for daily discovery runs.\n\nThis module defines the `daily_discovery_task` that wraps the async\nDiscoveryOrchestrator.run() with asyncio.run() for Celery's sync workers.\n\nRetry policy:\n    - 3 retries with exponential backoff: 60s, 300s, 900s\n    - On terminal failure: write traceback to crawl_runs.error_log\n    - Publish DAILY_TASK_DEAD event to agent.status.discovery\n\nIdempotency:\n    - Task ID format: discovery-{candidate_id}-{YYYY-MM-DD}\n    - Prevents duplicate runs if worker re-fires on the same day\n\nContract: HYPHA-SCHEDULER.md\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport traceback\nfrom datetime import date, datetime, timezone\nfrom typing import TYPE_CHECKING\nfrom uuid import UUID\n\nimport redis.asyncio as aioredis\nimport structlog\nfrom celery import Task\nfrom celery.exceptions import MaxRetriesExceededError\nfrom sqlalchemy import select\nfrom sqlalchemy.ext.asyncio import AsyncSession, create_async_engine, async_sessionmaker\n\nfrom backend.config import settings\nfrom backend.scheduler.celery_app import celery_app\nfrom backend.observability.events import PubSubChannel, publish_event, BaseEvent\n\nif TYPE_CHECKING:\n    from backend.agents.discovery.orchestrator import DiscoveryOrchestrator\n\nlogger = structlog.get_logger(__name__)\n\n# Retry countdown in seconds: 60s, 300s (5min), 900s (15min)\nRETRY_COUNTDOWNS = [60, 300, 900]\n\n\nclass DailyTaskDeadEvent(BaseEvent):\n    \"\"\"Event published when a daily discovery task exhausts all retries.\n\n    Published to: agent.status.discovery\n    \"\"\"\n\n    event: str = \"DAILY_TASK_DEAD\"\n    candidate_id: str\n    task_id: str\n    error: str\n    retries_exhausted: int\n\n\ndef _compute_task_id(candidate_id: str | UUID) -> str:\n    \"\"\"Compute idempotent task ID for a candidate on today's date (UTC).\n\n    Format: discovery-{candidate_id}-{YYYY-MM-DD}\n\n    Args:\n        candidate_id: The candidate's UUID\n\n    Returns:\n        Idempotent task ID string\n    \"\"\"\n    run_date = date.today().isoformat()\n    return f\"discovery-{candidate_id}-{run_date}\"\n\n\nasync def _run_discovery(candidate_id: UUID) -> None:\n    \"\"\"Run the async discovery orchestrator with fresh connections.\n\n    Creates a fresh DB session and Redis client for this invocation,\n    ensuring no connection pooling issues across Celery tasks.\n\n    Args:\n        candidate_id: UUID of the candidate to run discovery for\n\n    Raises:\n        Exception: Any error from the orchestrator is propagated\n    \"\"\"\n    # Import here to avoid circular imports at module load time\n    from backend.agents.discovery.orchestrator import DiscoveryOrchestrator\n    from backend.models.discovery import CrawlRun\n\n    # Create fresh async engine for this task (no shared pool across workers)\n    engine = create_async_engine(\n        settings.database_url,\n        echo=False,\n        pool_pre_ping=True,\n        pool_size=1,\n        max_overflow=0,\n    )\n    session_factory = async_sessionmaker(\n        engine,\n        class_=AsyncSession,\n        expire_on_commit=False,\n    )\n\n    # Create fresh Redis client\n    redis_client = aioredis.from_url(\n        settings.redis_url,\n        decode_responses=True,\n    )\n\n    try:\n        async with session_factory() as db:\n            orchestrator = DiscoveryOrchestrator(db, redis_client)\n            await orchestrator.run(candidate_id, dry_run=False)\n    finally:\n        await redis_client.aclose()\n        await engine.dispose()\n\n\nasync def _mark_crawl_run_failed(candidate_id: UUID, error_log: str) -> None:\n    \"\"\"Mark the most recent RUNNING crawl run as FAILED with error log.\n\n    Args:\n        candidate_id: UUID of the candidate\n        error_log: Traceback or error message to record\n    \"\"\"\n    from backend.models.discovery import CrawlRun\n\n    engine = create_async_engine(\n        settings.database_url,\n        echo=False,\n        pool_pre_ping=True,\n        pool_size=1,\n        max_overflow=0,\n    )\n    session_factory = async_sessionmaker(\n        engine,\n        class_=AsyncSession,\n        expire_on_commit=False,\n    )\n\n    try:\n        async with session_factory() as db:\n            # Find the most recent RUNNING crawl run for this candidate\n            result = await db.execute(\n                select(CrawlRun)\n                .where(CrawlRun.candidate_id == candidate_id)\n                .where(CrawlRun.status == \"RUNNING\")\n                .order_by(CrawlRun.started_at.desc())\n                .limit(1)\n            )\n            crawl_run = result.scalar_one_or_none()\n\n            if crawl_run:\n                crawl_run.status = \"FAILED\"\n                crawl_run.completed_at = datetime.now(timezone.utc)\n                crawl_run.error_log = error_log\n                await db.commit()\n                logger.info(\n                    \"task.crawl_run_marked_failed\",\n                    crawl_run_id=str(crawl_run.id),\n                    candidate_id=str(candidate_id),\n                )\n            else:\n                logger.warning(\n                    \"task.no_running_crawl_run\",\n                    candidate_id=str(candidate_id),\n                )\n    finally:\n        await engine.dispose()\n\n\nasync def _publish_dead_event(\n    candidate_id: UUID, task_id: str, error: str, retries: int\n) -> None:\n    \"\"\"Publish DAILY_TASK_DEAD event to agent.status.discovery.\n\n    Args:\n        candidate_id: UUID of the candidate\n        task_id: The Celery task ID\n        error: Error message or traceback\n        retries: Number of retries exhausted\n    \"\"\"\n    redis_client = aioredis.from_url(\n        settings.redis_url,\n        decode_responses=True,\n    )\n\n    try:\n        event = DailyTaskDeadEvent(\n            candidate_id=str(candidate_id),\n            task_id=task_id,\n            error=error,\n            retries_exhausted=retries,\n        )\n        await publish_event(redis_client, PubSubChannel.DISCOVERY, event)\n        logger.info(\n            \"task.dead_event_published\",\n            candidate_id=str(candidate_id),\n            task_id=task_id,\n        )\n    finally:\n        await redis_client.aclose()\n\n\n@celery_app.task(\n    bind=True,\n    name=\"backend.scheduler.tasks.daily_discovery_task\",\n    max_retries=3,\n    default_retry_delay=60,\n    autoretry_for=(Exception,),\n    retry_backoff=False,  # We implement custom backoff via countdown\n    acks_late=True,\n    reject_on_worker_lost=True,\n    track_started=True,\n)\ndef daily_discovery_task(self: Task, candidate_id: str) -> dict:\n    \"\"\"Run daily job discovery for a single candidate.\n\n    This task wraps the async DiscoveryOrchestrator.run() with asyncio.run()\n    since Celery workers are synchronous by design. Each invocation creates\n    a fresh event loop, DB session, and Redis client.\n\n    Retry policy:\n        - 3 retries with exponential backoff: 60s, 300s, 900s\n        - On MaxRetriesExceededError: write to crawl_runs.error_log,\n          publish DAILY_TASK_DEAD, then re-raise\n\n    Args:\n        candidate_id: UUID string of the candidate\n\n    Returns:\n        dict with status and candidate_id on success\n\n    Raises:\n        MaxRetriesExceededError: After 3 failed attempts\n    \"\"\"\n    candidate_uuid = UUID(candidate_id)\n    task_id = _compute_task_id(candidate_id)\n    attempt = self.request.retries + 1\n\n    log = logger.bind(\n        candidate_id=candidate_id,\n        task_id=task_id,\n        attempt=attempt,\n        max_retries=self.max_retries,\n    )\n\n    log.info(\"task.started\")\n\n    try:\n        # Run the async orchestrator in a fresh event loop\n        asyncio.run(_run_discovery(candidate_uuid))\n\n        log.info(\"task.completed\")\n        return {\n            \"status\": \"completed\",\n            \"candidate_id\": candidate_id,\n            \"task_id\": task_id,\n        }\n\n    except Exception as exc:\n        error_msg = str(exc)\n        tb = traceback.format_exc()\n\n        log.error(\n            \"task.failed\",\n            error=error_msg,\n            traceback=tb,\n        )\n\n        # Check if we've exhausted retries\n        if self.request.retries >= self.max_retries:\n            log.error(\n                \"task.max_retries_exceeded\",\n                retries_exhausted=self.max_retries,\n            )\n\n            # Write to crawl_runs.error_log and publish DAILY_TASK_DEAD\n            asyncio.run(_mark_crawl_run_failed(candidate_uuid, tb))\n            asyncio.run(\n                _publish_dead_event(\n                    candidate_uuid,\n                    task_id,\n                    error_msg,\n                    self.max_retries,\n                )\n            )\n\n            # Re-raise to mark task as failed\n            raise MaxRetriesExceededError(\n                f\"Task {task_id} failed after {self.max_retries} retries: {error_msg}\"\n            ) from exc\n\n        # Calculate countdown for next retry (exponential backoff)\n        retry_index = min(self.request.retries, len(RETRY_COUNTDOWNS) - 1)\n        countdown = RETRY_COUNTDOWNS[retry_index]\n\n        log.info(\n            \"task.retrying\",\n            countdown=countdown,\n            next_attempt=attempt + 1,\n        )\n\n        # Schedule retry with backoff\n        raise self.retry(exc=exc, countdown=countdown)\n\n\ndef trigger_daily_discovery(candidate_id: str | UUID) -> str:\n    \"\"\"Trigger a daily discovery task for a candidate.\n\n    This is a convenience function for programmatic triggering,\n    e.g., from the API endpoint or Celery beat scheduler.\n\n    Args:\n        candidate_id: UUID or string UUID of the candidate\n\n    Returns:\n        The Celery task ID (idempotent, based on candidate + date)\n    \"\"\"\n    candidate_str = str(candidate_id)\n    task_id = _compute_task_id(candidate_str)\n\n    daily_discovery_task.apply_async(\n        args=[candidate_str],\n        task_id=task_id,\n    )\n\n    logger.info(\n        \"task.triggered\",\n        candidate_id=candidate_str,\n        task_id=task_id,\n    )\n\n    return task_id\n","numLines":338,"startLine":1,"totalLines":338}}}}
