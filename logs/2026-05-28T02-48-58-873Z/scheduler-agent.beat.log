{"t":"2026-05-28T02:51:52.616Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016pGbFmD1RCjeT6bVTLrXjF","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Celery Beat schedule configuration for daily discovery runs.\n     6→\n     7→Runs at 07:00 America/New_York daily, iterating over all active candidates\n     8→and dispatching individual discovery tasks with idempotent task IDs.\n     9→\n    10→Schedule:\n    11→    07:00 America/New_York → dispatch_daily_discovery_runs\n    12→    → For each active candidate: daily_discovery_task(candidate_id)\n    13→\n    14→Idempotency:\n    15→    Task ID format: discovery-{candidate_id}-{YYYY-MM-DD}\n    16→    Prevents duplicate runs if the beat scheduler or worker re-fires.\n    17→\n    18→Contract: HYPHA-SCHEDULER.md\n    19→Symbol: beat_schedule (owner: scheduler-agent)\n    20→\"\"\"\n    21→\n    22→from __future__ import annotations\n    23→\n    24→import asyncio\n    25→from datetime import date\n    26→from typing import TYPE_CHECKING\n    27→\n    28→import structlog\n    29→from celery import Task\n    30→from celery.schedules import crontab\n    31→from sqlalchemy import select\n    32→from sqlalchemy.ext.asyncio import AsyncSession, create_async_engine, async_sessionmaker\n    33→\n    34→from backend.config import settings\n    35→from backend.scheduler.celery_app import celery_app\n    36→\n    37→if TYPE_CHECKING:\n    38→    from backend.models.discovery import Candidate\n    39→\n    40→logger = structlog.get_logger(__name__)\n    41→\n    42→\n    43→def _compute_task_id(candidate_id: str) -> str:\n    44→    \"\"\"Compute idempotent task ID for a candidate on today's date (UTC).\n    45→\n    46→    Format: discovery-{candidate_id}-{YYYY-MM-DD}\n    47→\n    48→    Args:\n    49→        candidate_id: The candidate's UUID as string\n    50→\n    51→    Returns:\n    52→        Idempotent task ID string\n    53→    \"\"\"\n    54→    run_date = date.today().isoformat()\n    55→    return f\"discovery-{candidate_id}-{run_date}\"\n    56→\n    57→\n    58→async def _get_active_candidates() -> list[str]:\n    59→    \"\"\"Query all active candidate IDs from the database.\n    60→\n    61→    Creates a fresh DB session for this query, ensuring no connection\n    62→    pooling issues across Celery tasks.\n    63→\n    64→    Returns:\n    65→        List of candidate UUID strings\n    66→    \"\"\"\n    67→    from backend.models.discovery import Candidate\n    68→\n    69→    engine = create_async_engine(\n    70→        settings.database_url,\n    71→        echo=False,\n    72→        pool_pre_ping=True,\n    73→        pool_size=1,\n    74→        max_overflow=0,\n    75→    )\n    76→    session_factory = async_sessionmaker(\n    77→        engine,\n    78→        class_=AsyncSession,\n    79→        expire_on_commit=False,\n    80→    )\n    81→\n    82→    try:\n    83→        async with session_factory() as db:\n    84→            # Query all candidates (single-tenant MVP — all candidates are active)\n    85→            # Future: add is_active column filter when multi-tenant\n    86→            result = await db.execute(select(Candidate.id))\n    87→            candidate_ids = [str(row[0]) for row in result.fetchall()]\n    88→\n    89→            logger.info(\n    90→                \"beat.candidates_queried\",\n    91→                count=len(candidate_ids),\n    92→            )\n    93→\n    94→            return candidate_ids\n    95→    finally:\n    96→        await engine.dispose()\n    97→\n    98→\n    99→@celery_app.task(\n   100→    bind=True,\n   101→    name=\"backend.scheduler.tasks.dispatch_daily_discovery_runs\",\n   102→    acks_late=True,\n   103→    track_started=True,\n   104→)\n   105→def dispatch_daily_discovery_runs(self: Task) -> dict:\n   106→    \"\"\"Dispatch daily discovery tasks for all active candidates.\n   107→\n   108→    This task is triggered by the Celery beat scheduler at 07:00 America/New_York.\n   109→    It queries all active candidates and dispatches individual discovery tasks\n   110→    with idempotent task IDs to prevent duplicate runs.\n   111→\n   112→    Returns:\n   113→        dict with dispatched count and task IDs\n   114→    \"\"\"\n   115→    log = logger.bind(task=\"dispatch_daily_discovery_runs\")\n   116→    log.info(\"beat.dispatch_started\")\n   117→\n   118→    # Query active candidates\n   119→    candidate_ids = asyncio.run(_get_active_candidates())\n   120→\n   121→    if not candidate_ids:\n   122→        log.info(\"beat.no_candidates\")\n   123→        return {\n   124→            \"status\": \"completed\",\n   125→            \"dispatched\": 0,\n   126→            \"message\": \"No active candidates found\",\n   127→        }\n   128→\n   129→    # Dispatch individual tasks with idempotent task IDs\n   130→    dispatched_tasks = []\n   131→\n   132→    for candidate_id in candidate_ids:\n   133→        task_id = _compute_task_id(candidate_id)\n   134→\n   135→        # Import here to avoid circular import at module load\n   136→        from backend.scheduler.tasks import daily_discovery_task\n   137→\n   138→        daily_discovery_task.apply_async(\n   139→            args=[candidate_id],\n   140→            task_id=task_id,\n   141→        )\n   142→\n   143→        dispatched_tasks.append({\n   144→            \"candidate_id\": candidate_id,\n   145→            \"task_id\": task_id,\n   146→        })\n   147→\n   148→        log.info(\n   149→            \"beat.task_dispatched\",\n   150→            candidate_id=candidate_id,\n   151→            task_id=task_id,\n   152→        )\n   153→\n   154→    log.info(\n   155→        \"beat.dispatch_completed\",\n   156→        dispatched=len(dispatched_tasks),\n   157→    )\n   158→\n   159→    return {\n   160→        \"status\": \"completed\",\n   161→        \"dispatched\": len(dispatched_tasks),\n   162→        \"tasks\": dispatched_tasks,\n   163→    }\n   164→\n   165→\n   166→# Beat schedule configuration\n   167→# Maps task name → schedule + options\n   168→beat_schedule = {\n   169→    \"dispatch-daily-discovery\": {\n   170→        \"task\": \"backend.scheduler.tasks.dispatch_daily_discovery_runs\",\n   171→        \"schedule\": crontab(hour=7, minute=0),  # 07:00 in timezone configured on celery_app\n   172→        \"options\": {\n   173→            \"queue\": \"default\",\n   174→        },\n   175→    },\n   176→}\n   177→\n   178→# Apply beat schedule to the Celery app\n   179→celery_app.conf.beat_schedule = beat_schedule\n   180→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"c75b5245-28ca-4616-895d-d50eaafdef6b","uuid":"9b7df532-e32f-438c-a3d9-58ab0d90e724","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/scheduler/beat.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nCelery Beat schedule configuration for daily discovery runs.\n\nRuns at 07:00 America/New_York daily, iterating over all active candidates\nand dispatching individual discovery tasks with idempotent task IDs.\n\nSchedule:\n    07:00 America/New_York → dispatch_daily_discovery_runs\n    → For each active candidate: daily_discovery_task(candidate_id)\n\nIdempotency:\n    Task ID format: discovery-{candidate_id}-{YYYY-MM-DD}\n    Prevents duplicate runs if the beat scheduler or worker re-fires.\n\nContract: HYPHA-SCHEDULER.md\nSymbol: beat_schedule (owner: scheduler-agent)\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nfrom datetime import date\nfrom typing import TYPE_CHECKING\n\nimport structlog\nfrom celery import Task\nfrom celery.schedules import crontab\nfrom sqlalchemy import select\nfrom sqlalchemy.ext.asyncio import AsyncSession, create_async_engine, async_sessionmaker\n\nfrom backend.config import settings\nfrom backend.scheduler.celery_app import celery_app\n\nif TYPE_CHECKING:\n    from backend.models.discovery import Candidate\n\nlogger = structlog.get_logger(__name__)\n\n\ndef _compute_task_id(candidate_id: str) -> str:\n    \"\"\"Compute idempotent task ID for a candidate on today's date (UTC).\n\n    Format: discovery-{candidate_id}-{YYYY-MM-DD}\n\n    Args:\n        candidate_id: The candidate's UUID as string\n\n    Returns:\n        Idempotent task ID string\n    \"\"\"\n    run_date = date.today().isoformat()\n    return f\"discovery-{candidate_id}-{run_date}\"\n\n\nasync def _get_active_candidates() -> list[str]:\n    \"\"\"Query all active candidate IDs from the database.\n\n    Creates a fresh DB session for this query, ensuring no connection\n    pooling issues across Celery tasks.\n\n    Returns:\n        List of candidate UUID strings\n    \"\"\"\n    from backend.models.discovery import Candidate\n\n    engine = create_async_engine(\n        settings.database_url,\n        echo=False,\n        pool_pre_ping=True,\n        pool_size=1,\n        max_overflow=0,\n    )\n    session_factory = async_sessionmaker(\n        engine,\n        class_=AsyncSession,\n        expire_on_commit=False,\n    )\n\n    try:\n        async with session_factory() as db:\n            # Query all candidates (single-tenant MVP — all candidates are active)\n            # Future: add is_active column filter when multi-tenant\n            result = await db.execute(select(Candidate.id))\n            candidate_ids = [str(row[0]) for row in result.fetchall()]\n\n            logger.info(\n                \"beat.candidates_queried\",\n                count=len(candidate_ids),\n            )\n\n            return candidate_ids\n    finally:\n        await engine.dispose()\n\n\n@celery_app.task(\n    bind=True,\n    name=\"backend.scheduler.tasks.dispatch_daily_discovery_runs\",\n    acks_late=True,\n    track_started=True,\n)\ndef dispatch_daily_discovery_runs(self: Task) -> dict:\n    \"\"\"Dispatch daily discovery tasks for all active candidates.\n\n    This task is triggered by the Celery beat scheduler at 07:00 America/New_York.\n    It queries all active candidates and dispatches individual discovery tasks\n    with idempotent task IDs to prevent duplicate runs.\n\n    Returns:\n        dict with dispatched count and task IDs\n    \"\"\"\n    log = logger.bind(task=\"dispatch_daily_discovery_runs\")\n    log.info(\"beat.dispatch_started\")\n\n    # Query active candidates\n    candidate_ids = asyncio.run(_get_active_candidates())\n\n    if not candidate_ids:\n        log.info(\"beat.no_candidates\")\n        return {\n            \"status\": \"completed\",\n            \"dispatched\": 0,\n            \"message\": \"No active candidates found\",\n        }\n\n    # Dispatch individual tasks with idempotent task IDs\n    dispatched_tasks = []\n\n    for candidate_id in candidate_ids:\n        task_id = _compute_task_id(candidate_id)\n\n        # Import here to avoid circular import at module load\n        from backend.scheduler.tasks import daily_discovery_task\n\n        daily_discovery_task.apply_async(\n            args=[candidate_id],\n            task_id=task_id,\n        )\n\n        dispatched_tasks.append({\n            \"candidate_id\": candidate_id,\n            \"task_id\": task_id,\n        })\n\n        log.info(\n            \"beat.task_dispatched\",\n            candidate_id=candidate_id,\n            task_id=task_id,\n        )\n\n    log.info(\n        \"beat.dispatch_completed\",\n        dispatched=len(dispatched_tasks),\n    )\n\n    return {\n        \"status\": \"completed\",\n        \"dispatched\": len(dispatched_tasks),\n        \"tasks\": dispatched_tasks,\n    }\n\n\n# Beat schedule configuration\n# Maps task name → schedule + options\nbeat_schedule = {\n    \"dispatch-daily-discovery\": {\n        \"task\": \"backend.scheduler.tasks.dispatch_daily_discovery_runs\",\n        \"schedule\": crontab(hour=7, minute=0),  # 07:00 in timezone configured on celery_app\n        \"options\": {\n            \"queue\": \"default\",\n        },\n    },\n}\n\n# Apply beat schedule to the Celery app\ncelery_app.conf.beat_schedule = beat_schedule\n","numLines":180,"startLine":1,"totalLines":180}}}}
