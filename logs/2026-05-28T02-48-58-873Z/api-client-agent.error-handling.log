'] = 'application/json'\n    56→  }\n    57→\n    58→  const response = await fetch(`${API_BASE}${path}`, {\n    59→    ...options,\n    60→    headers,\n    61→  })\n    62→\n    63→  if (response.status === 401) {\n    64→    clearAuth()\n    65→    window.location.href = routes.login\n    66→    throw new Error('Unauthorized')\n    67→  }\n    68→\n    69→  if (!response.ok) {\n    70→    const error = await response.json().catch(() => ({ detail: 'Request failed' }))\n    71→    throw new Error(error.detail || `HTTP ${response.status}`)\n    72→  }\n    73→\n    74→  return response.json()\n    75→}\n    76→\n    77→// ─── Auth ─────────────────────────────────────────────────────────────────────\n    78→// Per NUTRIENTS.md API_CONTRACTS §Auth Endpoints\n    79→\n    80→export async function requestMagicLink(email) {\n    81→  if (USE_MOCK) return mock.requestMagicLink(email)\n    82→  return request('/auth/request-link', { method: 'POST', body: JSON.stringify({ email }) })\n    83→}\n    84→\n    85→export async function verifyMagicLink(token) {\n    86→  if (USE_MOCK) return mock.verifyMagicLink(token)\n    87→  return request('/auth/verify', { method: 'POST', body: JSON.stringify({ token }) })\n    88→}\n    89→\n    90→export async function getMe() {\n    91→  if (USE_MOCK) return mock.getMe()\n    92→  return request('/auth/me')\n    93→}\n    94→\n    95→// ─── Onboarding ───────────────────────────────────────────────────────────────\n    96→\n    97→export async function uploadResume(file) {\n    98→  if (USE_MOCK) return mock.uploadResume(file)\n    99→  const formData = new FormData()\n   100→  formData.append('file', file)\n   101→  return request('/onboarding/resume', { method: 'POST', body: formData })\n   102→}\n   103→\n   104→export async function saveProfile(profile) {\n   105→  if (USE_MOCK) return mock.saveProfile(profile)\n   106→  return request('/onboarding/profile', { method: 'POST', body: JSON.stringify(profile) })\n   107→}\n   108→\n   109→export async function getOnboardingStatus() {\n   110→  if (USE_MOCK) return mock.getOnboardingStatus()\n   111→  return request('/onboarding/status')\n   112→}\n   113→\n   114→// ─── Discovery ────────────────────────────────────────────────────────────────\n   115→\n   116→export async function triggerDiscovery(candidateId, dryRun = false) {\n   117→  if (USE_MOCK) return mock.triggerDiscovery(candidateId, dryRun)\n   118→  return request('/discovery/trigger', { method: 'POST', body: JSON.stringify({ candidate_id: candidateId, dry_run: dryRun }) })\n   119→}\n   120→\n   121→export async function getDigest(digestId) {\n   122→  if (USE_MOCK) return mock.getDigest(digestId)\n   123→  return request(`/discovery/digest/${digestId}`)\n   124→}\n   125→\n   126→export async function getLatestDigest(candidateId) {\n   127→  if (USE_MOCK) return mock.getLatestDigest(candidateId)\n   128→  return request(`/discovery/digest/${candidateId}`)\n   129→}\n   130→\n   131→export async function getDiscoveryStats(candidateId) {\n   132→  if (USE_MOCK) return mock.getDiscoveryStats(candidateId)\n   133→  return request(`/discovery/stats/${candidateId}`)\n   134→}\n   135→\n   136→export async function triggerDiscoveryRun(candidateId, dryRun = false) {\n   137→  if (USE_MOCK) return mock.triggerDiscoveryRun(candidateId, dryRun)\n   138→  return request(`/discovery/run/${candidateId}?dry_run=${dryRun}`, { method: 'POST' })\n   139→}\n   140→\n   141→// ─── Application ──────────────────────────────────────────────────────────────\n   142→\n   143→export async function startApplication(jobId, candidateId) {\n   144→  if (USE_MOCK) return mock.startApplication(jobId, candidateId)\n   145→  return request('/application/start', { method: 'POST', body: JSON.stringify({ job_id: jobId, candidate_id: candidateId }) })\n   146→}\n   147→\n   148→export async function submitApplication(pipelineId) {\n   149→  if (USE_MOCK) return mock.submitApplication(pipelineId)\n   150→  return request(`/application/submit/${pipelineId}`, { method: 'POST' })\n   151→}\n   152→\n   153→export async function listApplications(opts = {}) {\n   154→  if (USE_MOCK) return mock.listApplications(opts)\n   155→  const { candidateId, status, limit = 50, offset = 0 } = opts\n   156→  const params = new URLSearchParams()\n   157→  if (candidateId) params.append('candidate_id', candidateId)\n   158→  if (status) params.append('status', status)\n   159→  params.append('limit', limit.toString())\n   160→  params.append('offset', offset.toString())\n   161→  return request(`/application/list?${params}`)\n   162→}\n   163→\n   164→export async function getPipeline(pipelineId) {\n   165→  if (USE_MOCK) return mock.getPipeline(pipelineId)\n   166→  return request(`/application/${pipelineId}`)\n   167→}\n   168→\n   169→// ─── Review ───────────────────────────────────────────────────────────────────\n   170→\n   171→export async function getReviewQueue(candidateId = null) {\n   172→  if (USE_MOCK) return mock.getReviewQueue(candidateId)\n   173→  const params = candidateId ? `?candidate_id=${candidateId}` : ''\n   174→  return request(`/review/queue${params}`)\n   175→}\n   176→\n   177→export async function approvePipeline(pipelineId) {\n   178→  if (USE_MOCK) return mock.approvePipeline(pipelineId)\n   179→  return request(`/review/${pipelineId}/approve`, { method: 'POST' })\n   180→}\n   181→\n   182→export async function rejectPipeline(pipelineId, reason = null) {\n   183→  if (USE_MOCK) return mock.rejectPipeline(pipelineId, reason)\n   184→  return request(`/review/${pipelineId}/reject`, { method: 'POST', body: JSON.stringify({ reason }) })\n   185→}\n   186→\n   187→// ─── Health ───────────────────────────────────────────────────────────────────\n   188→\n   189→export async function getHealth() {\n   190→  if (USE_MOCK) return mock.getHealth()\n   191→  return request('/health')\n   192→}\n   193→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"a2f4882d-88a7-4b08-9274-4bd2fb39158e","uuid":"b7dd3bd5-d699-4737-bdc7-8fc1a1aa48d4","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/frontend/src/lib/api.js","content":"/**\n * API client for Talent Agent backend.\n * Handles auth headers and base URL configuration.\n * Per NUTRIENTS.md API_CONTRACTS — this is the ONLY place to construct fetch URLs.\n */\n\nimport { routes } from './routes'\nimport * as mock from './mock'\n\n// In dev, Vite proxies /api → http://localhost:8000\n// In prod, set VITE_API_URL to the full backend URL\nconst API_BASE = import.meta.env.VITE_API_URL || '/api/v1'\n\n// Mock mode: when VITE_MOCK=true the client short-circuits all network calls\n// with seeded fixture data so the dashboard is navigable without a live backend.\nconst USE_MOCK = import.meta.env.VITE_MOCK === 'true'\n\n/**\n * Get the stored JWT token.\n */\nexport function getToken() {\n  return localStorage.getItem('ta_token')\n}\n\n/**\n * Store a JWT token.\n */\nexport function setToken(token) {\n  localStorage.setItem('ta_token', token)\n}\n\n/**\n * Clear stored auth data.\n */\nexport function clearAuth() {\n  localStorage.removeItem('ta_token')\n  localStorage.removeItem('ta_user')\n}\n\n/**\n * Make an authenticated API request.\n */\nasync function request(path, options = {}) {\n  const token = getToken()\n  const headers = {\n    ...options.headers,\n  }\n\n  if (token) {\n    headers['Authorization'] = `Bearer ${token}`\n  }\n\n  // Don't set Content-Type for FormData (browser sets it with boundary)\n  if (!(options.body instanceof FormData)) {\n    headers['Content-Type'] = 'application/json'\n  }\n\n  const response = await fetch(`${API_BASE}${path}`, {\n    ...options,\n    headers,\n  })\n\n  if (response.status === 401) {\n    clearAuth()\n    window.location.href = routes.login\n    throw new Error('Unauthorized')\n  }\n\n  if (!response.ok) {\n    const error = await response.json().catch(() => ({ detail: 'Request failed' }))\n    throw new Error(error.detail || `HTTP ${response.status}`)\n  }\n\n  return response.json()\n}\n\n// ─── Auth ─────────────────────────────────────────────────────────────────────\n// Per NUTRIENTS.md API_CONTRACTS §Auth Endpoints\n\nexport async function requestMagicLink(email) {\n  if (USE_MOCK) return mock.requestMagicLink(email)\n  return request('/auth/request-link', { method: 'POST', body: JSON.stringify({ email }) })\n}\n\nexport async function verifyMagicLink(token) {\n  if (USE_MOCK) return mock.verifyMagicLink(token)\n  return request('/auth/verify', { method: 'POST', body: JSON.stringify({ token }) })\n}\n\nexport async function getMe() {\n  if (USE_MOCK) return mock.getMe()\n  return request('/auth/me')\n}\n\n// ─── Onboarding ───────────────────────────────────────────────────────────────\n\nexport async function uploadResume(file) {\n  if (USE_MOCK) return mock.uploadResume(file)\n  const formData = new FormData()\n  formData.append('file', file)\n  return request('/onboarding/resume', { method: 'POST', body: formData })\n}\n\nexport async function saveProfile(profile) {\n  if (USE_MOCK) return mock.saveProfile(profile)\n  return request('/onboarding/profile', { method: 'POST', body: JSON.stringify(profile) })\n}\n\nexport async function getOnboardingStatus() {\n  if (USE_MOCK) return mock.getOnboardingStatus()\n  return request('/onboarding/status')\n}\n\n// ─── Discovery ────────────────────────────────────────────────────────────────\n\nexport async function triggerDiscovery(candidateId, dryRun = false) {\n  if (USE_MOCK) return mock.triggerDiscovery(candidateId, dryRun)\n  return request('/discovery/trigger', { method: 'POST', body: JSON.stringify({ candidate_id: candidateId, dry_run: dryRun }) })\n}\n\nexport async function getDigest(digestId) {\n  if (USE_MOCK) return mock.getDigest(digestId)\n  return request(`/discovery/digest/${digestId}`)\n}\n\nexport async function getLatestDigest(candidateId) {\n  if (USE_MOCK) return mock.getLatestDigest(candidateId)\n  return request(`/discovery/digest/${candidateId}`)\n}\n\nexport async function getDiscoveryStats(candidateId) {\n  if (USE_MOCK) return mock.getDiscoveryStats(candidateId)\n  return request(`/discovery/stats/${candidateId}`)\n}\n\nexport async function triggerDiscoveryRun(candidateId, dryRun = false) {\n  if (USE_MOCK) return mock.triggerDiscoveryRun(candidateId, dryRun)\n  return request(`/discovery/run/${candidateId}?dry_run=${dryRun}`, { method: 'POST' })\n}\n\n// ─── Application ──────────────────────────────────────────────────────────────\n\nexport async function startApplication(jobId, candidateId) {\n  if (USE_MOCK) return mock.startApplication(jobId, candidateId)\n  return request('/application/start', { method: 'POST', body: JSON.stringify({ job_id: jobId, candidate_id: candidateId }) })\n}\n\nexport async function submitApplication(pipelineId) {\n  if (USE_MOCK) return mock.submitApplication(pipelineId)\n  return request(`/application/submit/${pipelineId}`, { method: 'POST' })\n}\n\nexport async function listApplications(opts = {}) {\n  if (USE_MOCK) return mock.listApplications(opts)\n  const { candidateId, status, limit = 50, offset = 0 } = opts\n  const params = new URLSearchParams()\n  if (candidateId) params.append('candidate_id', candidateId)\n  if (status) params.append('status', status)\n  params.append('limit', limit.toString())\n  params.append('offset', offset.toString())\n  return request(`/application/list?${params}`)\n}\n\nexport async function getPipeline(pipelineId) {\n  if (USE_MOCK) return mock.getPipeline(pipelineId)\n  return request(`/application/${pipelineId}`)\n}\n\n// ─── Review ───────────────────────────────────────────────────────────────────\n\nexport async function getReviewQueue(candidateId = null) {\n  if (USE_MOCK) return mock.getReviewQueue(candidateId)\n  const params = candidateId ? `?candidate_id=${candidateId}` : ''\n  return request(`/review/queue${params}`)\n}\n\nexport async function approvePipeline(pipelineId) {\n  if (USE_MOCK) return mock.approvePipeline(pipelineId)\n  return request(`/review/${pipelineId}/approve`, { method: 'POST' })\n}\n\nexport async function rejectPipeline(pipelineId, reason = null) {\n  if (USE_MOCK) return mock.rejectPipeline(pipelineId, reason)\n  return request(`/review/${pipelineId}/reject`, { method: 'POST', body: JSON.stringify({ reason }) })\n}\n\n// ─── Health ───────────────────────────────────────────────────────────────────\n\nexport async function getHealth() {\n  if (USE_MOCK) return mock.getHealth()\n  return request('/health')\n}\n","numLines":193,"startLine":1,"totalLines":193}}}}
