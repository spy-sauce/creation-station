recting to /login\n   169→   * - Normalizes errors to TalentAgentApiError\n   170→   * - Handles FormData bodies correctly (no JSON.stringify, no Content-Type)\n   171→   *\n   172→   * @param path - API path (e.g., '/auth/me')\n   173→   * @param options - Request options\n   174→   * @returns Parsed JSON response\n   175→   * @throws TalentAgentApiError on API errors\n   176→   */\n   177→  async request<T>(path: string, options: ApiRequestOptions = {}): Promise<T> {\n   178→    const { body, skipAuth = false, ...fetchOptions } = options\n   179→\n   180→    // Build headers\n   181→    const headers = new Headers(fetchOptions.headers)\n   182→\n   183→    // Inject auth header if token exists and not skipped\n   184→    if (!skipAuth) {\n   185→      const token = getToken()\n   186→      if (token) {\n   187→        headers.set('Authorization', `Bearer ${token}`)\n   188→      }\n   189→    }\n   190→\n   191→    // Prepare body\n   192→    let requestBody: BodyInit | undefined\n   193→\n   194→    if (body !== undefined) {\n   195→      if (body instanceof FormData) {\n   196→        // FormData: browser sets Content-Type with boundary\n   197→        requestBody = body\n   198→      } else {\n   199→        // JSON body\n   200→        headers.set('Content-Type', 'application/json')\n   201→        requestBody = JSON.stringify(body)\n   202→      }\n   203→    }\n   204→\n   205→    // Make request\n   206→    const url = `${API_BASE_URL}${path}`\n   207→    let response: Response\n   208→\n   209→    try {\n   210→      response = await fetch(url, {\n   211→        ...fetchOptions,\n   212→        headers,\n   213→        body: requestBody,\n   214→      })\n   215→    } catch (error) {\n   216→      // Network error (backend down, CORS, etc.)\n   217→      // Per HYPHA-API-CLIENT: \"Killing the backend mid-session triggers an error toast\"\n   218→      const networkError = new TalentAgentApiError({\n   219→        status: 0,\n   220→        code: 'NETWORK_ERROR',\n   221→        message: 'Unable to connect to server. Please check your connection.',\n   222→      })\n   223→\n   224→      dispatchToast({\n   225→        message: networkError.message,\n   226→        type: 'error',\n   227→        duration: 5000,\n   228→      })\n   229→\n   230→      throw networkError\n   231→    }\n   232→\n   233→    // Handle 401 — invalidate JWT, redirect to login, surface toast\n   234→    // Per HYPHA-API-CLIENT acceptance criteria: \"401 response invalidates JWT,\n   235→    // redirects to /login, shows toast 'Session expired'\"\n   236→    if (response.status === 401) {\n   237→      clearToken()\n   238→\n   239→      // Dispatch toast notification before redirect\n   240→      // The UI layer (ToastProvider) will render the message\n   241→      dispatchToast({\n   242→        message: 'Session expired. Please log in again.',\n   243→        type: 'error',\n   244→        duration: 5000,\n   245→      })\n   246→\n   247→      // Redirect to login after a brief delay to allow toast to render\n   248→      // Using setTimeout ensures the toast event is processed before navigation\n   249→      setTimeout(() => {\n   250→        window.location.href = routes.login\n   251→      }, 100)\n   252→\n   253→      throw new TalentAgentApiError({\n   254→        status: 401,\n   255→        code: 'UNAUTHORIZED',\n   256→        message: 'Session expired. Please log in again.',\n   257→      })\n   258→    }\n   259→\n   260→    // Handle error responses\n   261→    if (!response.ok) {\n   262→      let errorData: { detail?: string; code?: string } = {}\n   263→      try {\n   264→        errorData = await response.json()\n   265→      } catch {\n   266→        // Response body is not JSON\n   267→      }\n   268→\n   269→      throw new TalentAgentApiError({\n   270→        status: response.status,\n   271→        code: errorData.code || `HTTP_${response.status}`,\n   272→        message: errorData.detail || `Request failed with status ${response.status}`,\n   273→      })\n   274→    }\n   275→\n   276→    // Parse successful response\n   277→    // Handle 204 No Content\n   278→    if (response.status === 204) {\n   279→      return undefined as T\n   280→    }\n   281→\n   282→    return response.json()\n   283→  },\n   284→\n   285→  /**\n   286→   * GET request shorthand.\n   287→   */\n   288→  async get<T>(path: string, options?: Omit<ApiRequestOptions, 'method' | 'body'>): Promise<T> {\n   289→    return this.request<T>(path, { ...options, method: 'GET' })\n   290→  },\n   291→\n   292→  /**\n   293→   * POST request shorthand.\n   294→   */\n   295→  async post<T>(path: string, body?: unknown, options?: Omit<ApiRequestOptions, 'method' | 'body'>): Promise<T> {\n   296→    return this.request<T>(path, { ...options, method: 'POST', body })\n   297→  },\n   298→\n   299→  /**\n   300→   * PUT request shorthand.\n   301→   */\n   302→  async put<T>(path: string, body?: unknown, options?: Omit<ApiRequestOptions, 'method' | 'body'>): Promise<T> {\n   303→    return this.request<T>(path, { ...options, method: 'PUT', body })\n   304→  },\n   305→\n   306→  /**\n   307→   * DELETE request shorthand.\n   308→   */\n   309→  async delete<T>(path: string, options?: Omit<ApiRequestOptions, 'method' | 'body'>): Promise<T> {\n   310→    return this.request<T>(path, { ...options, method: 'DELETE' })\n   311→  },\n   312→\n   313→  /**\n   314→   * PATCH request shorthand.\n   315→   */\n   316→  async patch<T>(path: string, body?: unknown, options?: Omit<ApiRequestOptions, 'method' | 'body'>): Promise<T> {\n   317→    return this.request<T>(path, { ...options, method: 'PATCH', body })\n   318→  },\n   319→}\n   320→\n   321→// ─── Default Export ───────────────────────────────────────────────────────────\n   322→\n   323→export default apiClient\n   324→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"a2f4882d-88a7-4b08-9274-4bd2fb39158e","uuid":"dc9eaebb-4760-4a3f-8f7b-914018838e83","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/frontend/src/api/client.ts","content":"/**\n * API client for Talent Agent backend.\n * Single apiClient instance with auth header injection and error normalization.\n *\n * Per NUTRIENTS.md §ITER-4 CONTRACT EXTENSIONS:\n * - Symbol: apiClient owned by api-client-agent\n * - Symbol: TalentAgentApiError owned by api-client-agent\n * - JWT storage key: talent-agent-jwt\n * - Base URL: VITE_API_BASE_URL\n *\n * Error handling (api-client-agent.error-handling scope):\n * - 401 responses invalidate JWT, redirect to /login, and surface toast notification\n * - Network errors surface TalentAgentApiError with status 0\n *\n * @license Apache-2.0\n * @copyright VibeSpace LLC\n */\n\nimport { routes } from '../lib/routes'\n\n// ─── Toast Event System ──────────────────────────────────────────────────────\n// Custom event pattern for toast notifications. The UI layer (frontend-agent)\n// subscribes to these events and renders the actual toast UI.\n\n/**\n * Toast notification payload.\n */\nexport interface ToastPayload {\n  /** Toast message */\n  message: string\n  /** Toast type for styling */\n  type: 'error' | 'warning' | 'success' | 'info'\n  /** Auto-dismiss duration in ms (0 = manual dismiss) */\n  duration?: number\n}\n\n/**\n * Custom event name for toast notifications.\n * UI components can listen: window.addEventListener('talent-agent:toast', handler)\n */\nexport const TOAST_EVENT = 'talent-agent:toast' as const\n\n/**\n * Dispatch a toast notification event.\n * The UI layer is responsible for rendering the toast.\n *\n * @param payload - Toast notification payload\n */\nexport function dispatchToast(payload: ToastPayload): void {\n  const event = new CustomEvent<ToastPayload>(TOAST_EVENT, {\n    detail: payload,\n    bubbles: true,\n  })\n  window.dispatchEvent(event)\n}\n\n// ─── Constants ────────────────────────────────────────────────────────────────\n\n/**\n * Storage key for JWT in localStorage.\n * Per NUTRIENTS.md DATA_CONTRACTS: storageKey: 'talent-agent-jwt'\n */\nconst JWT_STORAGE_KEY = 'talent-agent-jwt'\n\n/**\n * Base URL for API requests.\n * Per NUTRIENTS.md: Env vars use VITE_* prefix per Vite's import.meta.env convention.\n */\nconst API_BASE_URL = import.meta.env.VITE_API_BASE_URL || '/api/v1'\n\n// ─── Types ────────────────────────────────────────────────────────────────────\n\n/**\n * Error data structure for API errors.\n * Per NUTRIENTS.md DATA_CONTRACTS §API Client Domain.\n */\nexport interface TalentAgentApiErrorData {\n  /** HTTP status code */\n  status: number\n  /** Backend error code if present */\n  code: string\n  /** User-facing message */\n  message: string\n}\n\n/**\n * Request options for API client.\n */\ninterface ApiRequestOptions extends Omit<RequestInit, 'body'> {\n  /** Request body — will be JSON.stringify'd unless FormData */\n  body?: unknown\n  /** Skip auth header injection */\n  skipAuth?: boolean\n}\n\n// ─── Error Class ──────────────────────────────────────────────────────────────\n\n/**\n * Custom error class for API errors.\n * Per HYPHA-API-CLIENT: includes status, code, message.\n */\nexport class TalentAgentApiError extends Error {\n  public readonly status: number\n  public readonly code: string\n\n  constructor(data: TalentAgentApiErrorData) {\n    super(data.message)\n    this.name = 'TalentAgentApiError'\n    this.status = data.status\n    this.code = data.code\n  }\n\n  /**\n   * Get error data as plain object.\n   */\n  toJSON(): TalentAgentApiErrorData {\n    return {\n      status: this.status,\n      code: this.code,\n      message: this.message,\n    }\n  }\n}\n\n// ─── JWT Helpers ──────────────────────────────────────────────────────────────\n\n/**\n * Get the stored JWT token.\n */\nexport function getToken(): string | null {\n  return localStorage.getItem(JWT_STORAGE_KEY)\n}\n\n/**\n * Store a JWT token.\n */\nexport function setToken(token: string): void {\n  localStorage.setItem(JWT_STORAGE_KEY, token)\n}\n\n/**\n * Clear stored JWT.\n * Per HYPHA-API-CLIENT: 401 handling invalidates JWT.\n */\nexport function clearToken(): void {\n  localStorage.removeItem(JWT_STORAGE_KEY)\n}\n\n// ─── API Client ───────────────────────────────────────────────────────────────\n\n/**\n * Single API client instance for all backend requests.\n * Per NUTRIENTS.md: All API calls go through this client.\n */\nexport const apiClient = {\n  /**\n   * Get the base URL for API requests.\n   */\n  get baseUrl(): string {\n    return API_BASE_URL\n  },\n\n  /**\n   * Make an authenticated request to the API.\n   *\n   * Features:\n   * - Auto-injects Authorization: Bearer header if JWT exists\n   * - Handles 401 by invalidating JWT and redirecting to /login\n   * - Normalizes errors to TalentAgentApiError\n   * - Handles FormData bodies correctly (no JSON.stringify, no Content-Type)\n   *\n   * @param path - API path (e.g., '/auth/me')\n   * @param options - Request options\n   * @returns Parsed JSON response\n   * @throws TalentAgentApiError on API errors\n   */\n  async request<T>(path: string, options: ApiRequestOptions = {}): Promise<T> {\n    const { body, skipAuth = false, ...fetchOptions } = options\n\n    // Build headers\n    const headers = new Headers(fetchOptions.headers)\n\n    // Inject auth header if token exists and not skipped\n    if (!skipAuth) {\n      const token = getToken()\n      if (token) {\n        headers.set('Authorization', `Bearer ${token}`)\n      }\n    }\n\n    // Prepare body\n    let requestBody: BodyInit | undefined\n\n    if (body !== undefined) {\n      if (body instanceof FormData) {\n        // FormData: browser sets Content-Type with boundary\n        requestBody = body\n      } else {\n        // JSON body\n        headers.set('Content-Type', 'application/json')\n        requestBody = JSON.stringify(body)\n      }\n    }\n\n    // Make request\n    const url = `${API_BASE_URL}${path}`\n    let response: Response\n\n    try {\n      response = await fetch(url, {\n        ...fetchOptions,\n        headers,\n        body: requestBody,\n      })\n    } catch (error) {\n      // Network error (backend down, CORS, etc.)\n      // Per HYPHA-API-CLIENT: \"Killing the backend mid-session triggers an error toast\"\n      const networkError = new TalentAgentApiError({\n        status: 0,\n        code: 'NETWORK_ERROR',\n        message: 'Unable to connect to server. Please check your connection.',\n      })\n\n      dispatchToast({\n        message: networkError.message,\n        type: 'error',\n        duration: 5000,\n      })\n\n      throw networkError\n    }\n\n    // Handle 401 — invalidate JWT, redirect to login, surface toast\n    // Per HYPHA-API-CLIENT acceptance criteria: \"401 response invalidates JWT,\n    // redirects to /login, shows toast 'Session expired'\"\n    if (response.status === 401) {\n      clearToken()\n\n      // Dispatch toast notification before redirect\n      // The UI layer (ToastProvider) will render the message\n      dispatchToast({\n        message: 'Session expired. Please log in again.',\n        type: 'error',\n        duration: 5000,\n      })\n\n      // Redirect to login after a brief delay to allow toast to render\n      // Using setTimeout ensures the toast event is processed before navigation\n      setTimeout(() => {\n        window.location.href = routes.login\n      }, 100)\n\n      throw new TalentAgentApiError({\n        status: 401,\n        code: 'UNAUTHORIZED',\n        message: 'Session expired. Please log in again.',\n      })\n    }\n\n    // Handle error responses\n    if (!response.ok) {\n      let errorData: { detail?: string; code?: string } = {}\n      try {\n        errorData = await response.json()\n      } catch {\n        // Response body is not JSON\n      }\n\n      throw new TalentAgentApiError({\n        status: response.status,\n        code: errorData.code || `HTTP_${response.status}`,\n        message: errorData.detail || `Request failed with status ${response.status}`,\n      })\n    }\n\n    // Parse successful response\n    // Handle 204 No Content\n    if (response.status === 204) {\n      return undefined as T\n    }\n\n    return response.json()\n  },\n\n  /**\n   * GET request shorthand.\n   */\n  async get<T>(path: string, options?: Omit<ApiRequestOptions, 'method' | 'body'>): Promise<T> {\n    return this.request<T>(path, { ...options, method: 'GET' })\n  },\n\n  /**\n   * POST request shorthand.\n   */\n  async post<T>(path: string, body?: unknown, options?: Omit<ApiRequestOptions, 'method' | 'body'>): Promise<T> {\n    return this.request<T>(path, { ...options, method: 'POST', body })\n  },\n\n  /**\n   * PUT request shorthand.\n   */\n  async put<T>(path: string, body?: unknown, options?: Omit<ApiRequestOptions, 'method' | 'body'>): Promise<T> {\n    return this.request<T>(path, { ...options, method: 'PUT', body })\n  },\n\n  /**\n   * DELETE request shorthand.\n   */\n  async delete<T>(path: string, options?: Omit<ApiRequestOptions, 'method' | 'body'>): Promise<T> {\n    return this.request<T>(path, { ...options, method: 'DELETE' })\n  },\n\n  /**\n   * PATCH request shorthand.\n   */\n  async patch<T>(path: string, body?: unknown, options?: Omit<ApiRequestOptions, 'method' | 'body'>): Promise<T> {\n    return this.request<T>(path, { ...options, method: 'PATCH', body })\n  },\n}\n\n// ─── Default Export ───────────────────────────────────────────────────────────\n\nexport default apiClient\n","numLines":324,"startLine":1,"totalLines":324}}}}
