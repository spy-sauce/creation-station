{"t":"2026-05-28T03:08:35.136Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JKXmU5iA7SdL2yKJyh3dsG","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Review Dashboard API — exposes all draft application artifacts for human review.\n     6→\n     7→Every deliverable (tailored resume, outreach email, form submission) must be\n     8→approved here before anything is sent. Human stays in the loop.\n     9→\n    10→GET    /review/queue                        → list all awaiting review\n    11→GET    /review/application/{pipeline_id}    → full application package\n    12→PATCH  /review/application/{pipeline_id}/approve → approve + trigger submission\n    13→PATCH  /review/application/{pipeline_id}/reject  → skip this application\n    14→PATCH  /review/resume/{pipeline_id}         → update tailored resume text\n    15→PATCH  /review/email/{pipeline_id}          → update outreach email\n    16→GET    /review/preview/{pipeline_id}/resume → render resume as plain text\n    17→GET    /review/preview/{pipeline_id}/email  → preview email body\n    18→GET    /review/timeline/{pipeline_id}       → CRM event timeline\n    19→\"\"\"\n    20→\n    21→from uuid import UUID\n    22→from typing import Optional\n    23→\n    24→import redis.asyncio as aioredis\n    25→import structlog\n    26→from fastapi import APIRouter, Depends, HTTPException\n    27→from pydantic import BaseModel\n    28→from sqlalchemy import select, desc\n    29→from sqlalchemy.ext.asyncio import AsyncSession\n    30→\n    31→from backend.database import get_db\n    32→from backend.api.discovery import get_redis\n    33→from backend.agents.application.crm import CRM\n    34→from backend.models.application import (\n    35→    ApplicationPipeline,\n    36→    TailoredResume,\n    37→    OutreachEmail,\n    38→    ParsedJD,\n    39→    CompanyIntel,\n    40→    Contact,\n    41→)\n    42→\n    43→logger = structlog.get_logger(__name__)\n    44→router = APIRouter()\n    45→\n    46→\n    47→# ─── Request/response schemas ─────────────────────────────────────────────────\n    48→\n    49→class ResumeUpdate(BaseModel):\n    50→    \"\"\"Updated resume text from the Review Dashboard.\"\"\"\n    51→    full_text: str\n    52→    summary: Optional[str] = None\n    53→\n    54→\n    55→class EmailUpdate(BaseModel):\n    56→    \"\"\"Updated email body or subject from the Review Dashboard.\"\"\"\n    57→    body: Optional[str] = None\n    58→    subject: Optional[str] = None\n    59→\n    60→\n    61→# ─── Endpoints ────────────────────────────────────────────────────────────────\n    62→\n    63→@router.get(\"/queue\")\n    64→async def get_review_queue(\n    65→    db: AsyncSession = Depends(get_db),\n    66→):\n    67→    \"\"\"List all application pipelines awaiting human review.\"\"\"\n    68→    result = await db.execute(\n    69→        select(ApplicationPipeline)\n    70→        .where(ApplicationPipeline.status == \"AWAITING_REVIEW\")\n    71→        .order_by(desc(ApplicationPipeline.updated_at))\n    72→    )\n    73→    pipelines = result.scalars().all()\n    74→\n    75→    return [\n    76→        {\n    77→            \"pipeline_id\": str(p.id),\n    78→            \"job_id\": str(p.job_id),\n    79→            \"candidate_id\": str(p.candidate_id),\n    80→            \"status\": p.status,\n    81→            \"current_step\": p.current_step,\n    82→            \"created_at\": p.created_at.isoformat(),\n    83→            \"updated_at\": p.updated_at.isoformat(),\n    84→        }\n    85→        for p in pipelines\n    86→    ]\n    87→\n    88→\n    89→@router.get(\"/application/{pipeline_id}\")\n    90→async def get_application_package(\n    91→    pipeline_id: UUID,\n    92→    db: AsyncSession = Depends(get_db),\n    93→):\n    94→    \"\"\"\n    95→    Return the full application package for review.\n    96→\n    97→    Includes: pipeline status, tailored resume, outreach email,\n    98→    company intel, contact, and parsed JD signals.\n    99→    \"\"\"\n   100→    result = await db.execute(\n   101→        select(ApplicationPipeline).where(ApplicationPipeline.id == pipeline_id)\n   102→    )\n   103→    pipeline = result.scalar_one_or_none()\n   104→    if not pipeline:\n   105→        raise HTTPException(status_code=404, detail=\"Pipeline not found\")\n   106→\n   107→    # Load related artifacts\n   108→    resume = await _get_resume(db, pipeline.resume_id)\n   109→    email = await _get_email(db, pipeline.email_id)\n   110→    parsed_jd = await _get_parsed_jd(db, pipeline.job_id)\n   111→\n   112→    return {\n   113→        \"pipeline_id\": str(pipeline.id),\n   114→        \"job_id\": str(pipeline.job_id),\n   115→        \"candidate_id\": str(pipeline.candidate_id),\n   116→        \"status\": pipeline.status,\n   117→        \"current_step\": pipeline.current_step,\n   118→        \"resume\": resume,\n   119→        \"email\": email,\n   120→        \"parsed_jd\": parsed_jd,\n   121→        \"created_at\": pipeline.created_at.isoformat(),\n   122→    }\n   123→\n   124→\n   125→@router.patch(\"/application/{pipeline_id}/approve\")\n   126→async def approve_application(\n   127→    pipeline_id: UUID,\n   128→    db: AsyncSession = Depends(get_db),\n   129→    redis: aioredis.Redis = Depends(get_redis),\n   130→):\n   131→    \"\"\"\n   132→    Approve this application and trigger auto-submit.\n   133→\n   134→    Status moves from AWAITING_REVIEW → APPROVED → SUBMITTED.\n   135→    \"\"\"\n   136→    result = await db.execute(\n   137→        select(ApplicationPipeline).where(ApplicationPipeline.id == pipeline_id)\n   138→    )\n   139→    pipeline = result.scalar_one_or_none()\n   140→    if not pipeline:\n   141→        raise HTTPException(status_code=404, detail=\"Pipeline not found\")\n   142→    if pipeline.status != \"AWAITING_REVIEW\":\n   143→        raise HTTPException(\n   144→            status_code=422,\n   145→            detail=f\"Pipeline is not awaiting review (status: {pipeline.status})\",\n   146→        )\n   147→\n   148→    pipeline.status = \"APPROVED\"\n   149→    await db.commit()\n   150→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"e1a6c245-4572-4816-9d85-5634565bd455","uuid":"d608ffc7-b22e-4ca6-80b7-173413558828","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/api/review.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nReview Dashboard API — exposes all draft application artifacts for human review.\n\nEvery deliverable (tailored resume, outreach email, form submission) must be\napproved here before anything is sent. Human stays in the loop.\n\nGET    /review/queue                        → list all awaiting review\nGET    /review/application/{pipeline_id}    → full application package\nPATCH  /review/application/{pipeline_id}/approve → approve + trigger submission\nPATCH  /review/application/{pipeline_id}/reject  → skip this application\nPATCH  /review/resume/{pipeline_id}         → update tailored resume text\nPATCH  /review/email/{pipeline_id}          → update outreach email\nGET    /review/preview/{pipeline_id}/resume → render resume as plain text\nGET    /review/preview/{pipeline_id}/email  → preview email body\nGET    /review/timeline/{pipeline_id}       → CRM event timeline\n\"\"\"\n\nfrom uuid import UUID\nfrom typing import Optional\n\nimport redis.asyncio as aioredis\nimport structlog\nfrom fastapi import APIRouter, Depends, HTTPException\nfrom pydantic import BaseModel\nfrom sqlalchemy import select, desc\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom backend.database import get_db\nfrom backend.api.discovery import get_redis\nfrom backend.agents.application.crm import CRM\nfrom backend.models.application import (\n    ApplicationPipeline,\n    TailoredResume,\n    OutreachEmail,\n    ParsedJD,\n    CompanyIntel,\n    Contact,\n)\n\nlogger = structlog.get_logger(__name__)\nrouter = APIRouter()\n\n\n# ─── Request/response schemas ─────────────────────────────────────────────────\n\nclass ResumeUpdate(BaseModel):\n    \"\"\"Updated resume text from the Review Dashboard.\"\"\"\n    full_text: str\n    summary: Optional[str] = None\n\n\nclass EmailUpdate(BaseModel):\n    \"\"\"Updated email body or subject from the Review Dashboard.\"\"\"\n    body: Optional[str] = None\n    subject: Optional[str] = None\n\n\n# ─── Endpoints ────────────────────────────────────────────────────────────────\n\n@router.get(\"/queue\")\nasync def get_review_queue(\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"List all application pipelines awaiting human review.\"\"\"\n    result = await db.execute(\n        select(ApplicationPipeline)\n        .where(ApplicationPipeline.status == \"AWAITING_REVIEW\")\n        .order_by(desc(ApplicationPipeline.updated_at))\n    )\n    pipelines = result.scalars().all()\n\n    return [\n        {\n            \"pipeline_id\": str(p.id),\n            \"job_id\": str(p.job_id),\n            \"candidate_id\": str(p.candidate_id),\n            \"status\": p.status,\n            \"current_step\": p.current_step,\n            \"created_at\": p.created_at.isoformat(),\n            \"updated_at\": p.updated_at.isoformat(),\n        }\n        for p in pipelines\n    ]\n\n\n@router.get(\"/application/{pipeline_id}\")\nasync def get_application_package(\n    pipeline_id: UUID,\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"\n    Return the full application package for review.\n\n    Includes: pipeline status, tailored resume, outreach email,\n    company intel, contact, and parsed JD signals.\n    \"\"\"\n    result = await db.execute(\n        select(ApplicationPipeline).where(ApplicationPipeline.id == pipeline_id)\n    )\n    pipeline = result.scalar_one_or_none()\n    if not pipeline:\n        raise HTTPException(status_code=404, detail=\"Pipeline not found\")\n\n    # Load related artifacts\n    resume = await _get_resume(db, pipeline.resume_id)\n    email = await _get_email(db, pipeline.email_id)\n    parsed_jd = await _get_parsed_jd(db, pipeline.job_id)\n\n    return {\n        \"pipeline_id\": str(pipeline.id),\n        \"job_id\": str(pipeline.job_id),\n        \"candidate_id\": str(pipeline.candidate_id),\n        \"status\": pipeline.status,\n        \"current_step\": pipeline.current_step,\n        \"resume\": resume,\n        \"email\": email,\n        \"parsed_jd\": parsed_jd,\n        \"created_at\": pipeline.created_at.isoformat(),\n    }\n\n\n@router.patch(\"/application/{pipeline_id}/approve\")\nasync def approve_application(\n    pipeline_id: UUID,\n    db: AsyncSession = Depends(get_db),\n    redis: aioredis.Redis = Depends(get_redis),\n):\n    \"\"\"\n    Approve this application and trigger auto-submit.\n\n    Status moves from AWAITING_REVIEW → APPROVED → SUBMITTED.\n    \"\"\"\n    result = await db.execute(\n        select(ApplicationPipeline).where(ApplicationPipeline.id == pipeline_id)\n    )\n    pipeline = result.scalar_one_or_none()\n    if not pipeline:\n        raise HTTPException(status_code=404, detail=\"Pipeline not found\")\n    if pipeline.status != \"AWAITING_REVIEW\":\n        raise HTTPException(\n            status_code=422,\n            detail=f\"Pipeline is not awaiting review (status: {pipeline.status})\",\n        )\n\n    pipeline.status = \"APPROVED\"\n    await db.commit()\n","numLines":150,"startLine":1,"totalLines":376}}}}
