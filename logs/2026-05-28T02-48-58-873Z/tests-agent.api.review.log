{"t":"2026-05-28T03:00:46.045Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FJHHnhnhg8qzxKon1en3pG","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→SSE Event Stream endpoint tests.\n     6→\n     7→Tests for GET /events/stream — Server-Sent Events for real-time agent status.\n     8→\n     9→Contract:\n    10→  - HYPHA-TESTS.md § tests-agent.api.events\n    11→  - HYPHA-API-STREAMING.md acceptance criteria\n    12→  - NUTRIENTS.md § API_CONTRACTS (iter-4 additions)\n    13→\n    14→Coverage:\n    15→  - TestClient streaming response\n    16→  - SSE frame format (data: {json}\\\\n\\\\n)\n    17→  - Heartbeat (:ping\\\\n\\\\n within 16s)\n    18→  - 401 on missing/invalid auth\n    19→  - Channel allowlist validation (400 on invalid channel)\n    20→  - Message delivery from Redis pub/sub\n    21→\"\"\"\n    22→\n    23→from __future__ import annotations\n    24→\n    25→import asyncio\n    26→import json\n    27→import uuid\n    28→from datetime import datetime, timedelta, timezone\n    29→from typing import AsyncGenerator, Generator\n    30→from unittest.mock import AsyncMock, patch\n    31→\n    32→import fakeredis.aioredis\n    33→import jwt\n    34→import pytest\n    35→import pytest_asyncio\n    36→from fastapi import FastAPI\n    37→from fastapi.testclient import TestClient\n    38→from httpx import ASGITransport, AsyncClient\n    39→from sqlalchemy import create_engine\n    40→from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker, create_async_engine\n    41→from sqlalchemy.orm import sessionmaker\n    42→from sqlalchemy.pool import StaticPool\n    43→\n    44→from backend.api.auth import create_jwt\n    45→from backend.api.events import (\n    46→    ALLOWED_CHANNELS,\n    47→    HEARTBEAT_INTERVAL_SECONDS,\n    48→    MAX_QUEUE_SIZE,\n    49→    SSESubscriber,\n    50→    router as events_router,\n    51→)\n    52→from backend.config import settings\n    53→from backend.database import Base, get_db, get_redis, set_redis_client\n    54→from backend.models.auth import User\n    55→from backend.observability.events import PubSubChannel\n    56→\n    57→\n    58→# ─── Test Database Setup ─────────────────────────────────────────────────────\n    59→\n    60→# Use SQLite for testing (async via aiosqlite)\n    61→TEST_DATABASE_URL = \"sqlite+aiosqlite:///:memory:\"\n    62→\n    63→test_engine = create_async_engine(\n    64→    TEST_DATABASE_URL,\n    65→    connect_args={\"check_same_thread\": False},\n    66→    poolclass=StaticPool,\n    67→)\n    68→\n    69→TestAsyncSessionLocal = async_sessionmaker(\n    70→    test_engine,\n    71→    class_=AsyncSession,\n    72→    expire_on_commit=False,\n    73→)\n    74→\n    75→\n    76→async def override_get_db() -> AsyncGenerator[AsyncSession, None]:\n    77→    \"\"\"Override get_db dependency for tests.\"\"\"\n    78→    async with TestAsyncSessionLocal() as session:\n    79→        yield session\n    80→\n    81→\n    82→# ─── Fixtures ────────────────────────────────────────────────────────────────\n    83→\n    84→\n    85→@pytest_asyncio.fixture\n    86→async def test_db():\n    87→    \"\"\"Create test database tables and yield a session.\"\"\"\n    88→    async with test_engine.begin() as conn:\n    89→        await conn.run_sync(Base.metadata.create_all)\n    90→\n    91→    async with TestAsyncSessionLocal() as session:\n    92→        yield session\n    93→\n    94→    async with test_engine.begin() as conn:\n    95→        await conn.run_sync(Base.metadata.drop_all)\n    96→\n    97→\n    98→@pytest.fixture\n    99→def fake_redis():\n   100→    \"\"\"Create a fake Redis client for testing.\"\"\"\n   101→    return fakeredis.aioredis.FakeRedis(decode_responses=True)\n   102→\n   103→\n   104→@pytest_asyncio.fixture\n   105→async def test_user(test_db: AsyncSession) -> User:\n   106→    \"\"\"Create a test user and return it.\"\"\"\n   107→    user = User(\n   108→        id=uuid.uuid4(),\n   109→        email=\"test@example.com\",\n   110→        name=\"Test User\",\n   111→        is_active=True,\n   112→        is_onboarded=True,\n   113→    )\n   114→    test_db.add(user)\n   115→    await test_db.commit()\n   116→    await test_db.refresh(user)\n   117→    return user\n   118→\n   119→\n   120→@pytest.fixture\n   121→def valid_jwt(test_user: User) -> str:\n   122→    \"\"\"Generate a valid JWT for the test user.\"\"\"\n   123→    payload = {\n   124→        \"sub\": str(test_user.id),\n   125→        \"email\": test_user.email,\n   126→        \"iat\": datetime.now(timezone.utc),\n   127→        \"exp\": datetime.now(timezone.utc) + timedelta(days=1),\n   128→    }\n   129→    return jwt.encode(payload, settings.jwt_secret, algorithm=\"HS256\")\n   130→\n   131→\n   132→@pytest.fixture\n   133→def expired_jwt(test_user: User) -> str:\n   134→    \"\"\"Generate an expired JWT for testing.\"\"\"\n   135→    payload = {\n   136→        \"sub\": str(test_user.id),\n   137→        \"email\": test_user.email,\n   138→        \"iat\": datetime.now(timezone.utc) - timedelta(days=10),\n   139→        \"exp\": datetime.now(timezone.utc) - timedelta(days=1),\n   140→    }\n   141→    return jwt.encode(payload, settings.jwt_secret, algorithm=\"HS256\")\n   142→\n   143→\n   144→@pytest.fixture\n   145→def app_with_overrides(test_db: AsyncSession, fake_redis) -> FastAPI:\n   146→    \"\"\"Create a FastAPI app with test dependency overrides.\"\"\"\n   147→    from backend.main import app\n   148→\n   149→    # Override dependencies\n   150→    app.dependency_overrides[get_db] = lambda: test_db\n   151→    app.dependency_overrides[get_redis] = lambda: fake_redis\n   152→\n   153→    # Set the fake Redis as the global client\n   154→    set_redis_client(fake_redis)\n   155→\n   156→    yield app\n   157→\n   158→    # Clean up overrides\n   159→    app.dependency_overrides.clear()\n   160→\n   161→\n   162→@pytest.fixture\n   163→def test_client(app_with_overrides: FastAPI) -> Generator[TestClient, None, None]:\n   164→    \"\"\"Create a TestClient for the app.\"\"\"\n   165→    with TestClient(app_with_overrides) as client:\n   166→        yield client\n   167→\n   168→\n   169→# ─── SSESubscriber Unit Tests ────────────────────────────────────────────────\n   170→\n   171→\n   172→class TestSSESubscriberValidation:\n   173→    \"\"\"Test SSESubscriber channel validation.\"\"\"\n   174→\n   175→    def test_valid_discovery_channel(self, fake_redis):\n   176→        \"\"\"Valid discovery channel should not raise.\"\"\"\n   177→        subscriber = SSESubscriber(\n   178→            redis_client=fake_redis,\n   179→            channel=PubSubChannel.DISCOVERY.value,\n   180→            user_id=\"test-user-123\",\n   181→        )\n   182→        assert subscriber.channel == \"agent.status.discovery\"\n   183→\n   184→    def test_valid_application_channel(self, fake_redis):\n   185→        \"\"\"Valid application channel should not raise.\"\"\"\n   186→        subscriber = SSESubscriber(\n   187→            redis_client=fake_redis,\n   188→            channel=PubSubChannel.APPLICATION.value,\n   189→            user_id=\"test-user-123\",\n   190→        )\n   191→        assert subscriber.channel == \"agent.status.application\"\n   192→\n   193→    def test_invalid_channel_raises_value_error(self, fake_redis):\n   194→        \"\"\"Invalid channel should raise ValueError.\"\"\"\n   195→        with pytest.raises(ValueError, match=\"Invalid channel\"):\n   196→            SSESubscriber(\n   197→                redis_client=fake_redis,\n   198→                channel=\"invalid.channel\",\n   199→                user_id=\"test-user-123\",\n   200→            )\n   201→\n   202→    def test_invalid_channel_error_lists_allowed(self, fake_redis):\n   203→        \"\"\"Error message should list allowed channels.\"\"\"\n   204→        with pytest.raises(ValueError) as exc_info:\n   205→            SSESubscriber(\n   206→                redis_client=fake_redis,\n   207→                channel=\"bad.channel\",\n   208→                user_id=\"test-user-123\",\n   209→            )\n   210→        error_message = str(exc_info.value)\n   211→        assert \"agent.status.application\" in error_message\n   212→        assert \"agent.status.discovery\" in error_message\n   213→\n   214→\n   215→# ─── Endpoint Integration Tests ──────────────────────────────────────────────\n   216→\n   217→\n   218→class TestEventStreamAuth:\n   219→    \"\"\"Test authentication requirements for /events/stream.\"\"\"\n   220→\n   221→    def test_missing_auth_returns_401(self, test_client: TestClient):\n   222→        \"\"\"Request without Authorization header should return 401.\"\"\"\n   223→        response = test_client.get(\n   224→            \"/events/stream\",\n   225→            params={\"channel\": \"agent.status.discovery\"},\n   226→        )\n   227→        assert response.status_code == 401\n   228→        assert \"Not authenticated\" in response.json().get(\"detail\", \"\")\n   229→\n   230→    def test_invalid_token_returns_401(self, test_client: TestClient):\n   231→        \"\"\"Request with invalid JWT should return 401.\"\"\"\n   232→        response = test_client.get(\n   233→            \"/events/stream\",\n   234→            params={\"channel\": \"agent.status.discovery\"},\n   235→            headers={\"Authorization\": \"Bearer invalid-token-xyz\"},\n   236→        )\n   237→        assert response.status_code == 401\n   238→\n   239→    def test_expired_token_returns_401(\n   240→        self, test_client: TestClient, expired_jwt: str\n   241→    ):\n   242→        \"\"\"Request with expired JWT should return 401.\"\"\"\n   243→        response = test_client.get(\n   244→            \"/events/stream\",\n   245→            params={\"channel\": \"agent.status.discovery\"},\n   246→            headers={\"Authorization\": f\"Bearer {expired_jwt}\"},\n   247→        )\n   248→        assert response.status_code == 401\n   249→        assert \"expired\" in response.json().get(\"detail\", \"\").lower()\n   250→\n   251→\n   252→class TestEventStreamChannelValidation:\n   253→    \"\"\"Test channel allowlist validation.\"\"\"\n   254→\n   255→    def test_invalid_channel_returns_400(\n   256→        self, test_client: TestClient, valid_jwt: str\n   257→    ):\n   258→        \"\"\"Request with invalid channel should return 400.\"\"\"\n   259→        response = test_client.get(\n   260→            \"/events/stream\",\n   261→            params={\"channel\": \"invalid.channel\"},\n   262→            headers={\"Authorization\": f\"Bearer {valid_jwt}\"},\n   263→        )\n   264→        assert response.status_code == 400\n   265→        detail = response.json().get(\"detail\", \"\")\n   266→        assert \"Invalid channel\" in detail\n   267→        assert \"agent.status.discovery\" in detail\n   268→        assert \"agent.status.application\" in detail\n   269→\n   270→    def test_missing_channel_param_returns_422(\n   271→        self, test_client: TestClient, valid_jwt: str\n   272→    ):\n   273→        \"\"\"Request without channel parameter should return 422 (validation error).\"\"\"\n   274→        response = test_client.get(\n   275→            \"/events/stream\",\n   276→            headers={\"Authorization\": f\"Bearer {valid_jwt}\"},\n   277→        )\n   278→        assert response.status_code == 422\n   279→\n   280→\n   281→class TestEventStreamSSEFormat:\n   282→    \"\"\"Test SSE frame format and streaming behavior.\"\"\"\n   283→\n   284→    @pytest.mark.asyncio\n   285→    async def test_stream_returns_event_stream_content_type(\n   286→        self, app_with_overrides: FastAPI, valid_jwt: str, fake_redis\n   287→    ):\n   288→        \"\"\"\n   289→        Response should have Content-Type: text/event-stream.\n   290→\n   291→        This test verifies the SSE endpoint returns the correct media type\n   292→        for Server-Sent Events streaming.\n   293→        \"\"\"\n   294→        async with AsyncClient(\n   295→            transport=ASGITransport(app=app_with_overrides),\n   296→            base_url=\"http://test\",\n   297→        ) as client:\n   298→            # Use a short timeout since we just need headers\n   299→            async def fetch_headers():\n   300→                async with client.stream(\n   301→                    \"GET\",\n   302→                    \"/events/stream\",\n   303→                    params={\"channel\": \"agent.status.discovery\"},\n   304→                    headers={\"Authorization\": f\"Bearer {valid_jwt}\"},\n   305→                ) as response:\n   306→                    return response.headers\n   307→\n   308→            try:\n   309→                headers = await asyncio.wait_for(fetch_headers(), timeout=2.0)\n   310→                assert headers.get(\"content-type\") == \"text/event-stream; charset=utf-8\"\n   311→                assert headers.get(\"cache-control\") == \"no-cache\"\n   312→            except asyncio.TimeoutError:\n   313→                # Stream didn't return headers in time — check we got the connection\n   314→                pass\n   315→\n   316→    @pytest.mark.asyncio\n   317→    async def test_published_message_appears_as_sse_frame(\n   318→        self, app_with_overrides: FastAPI, valid_jwt: str, fake_redis\n   319→    ):\n   320→        \"\"\"\n   321→        Messages published to Redis should appear as SSE data frames.\n   322→\n   323→        SSE frame format: data: {json}\\\\n\\\\n\n   324→        \"\"\"\n   325→        received_frames: list[str] = []\n   326→        test_event = {\n   327→            \"event\": \"TEST_EVENT\",\n   328→            \"candidate_id\": \"test-candidate-123\",\n   329→            \"ts\": datetime.now(timezone.utc).isoformat(),\n   330→        }\n   331→\n   332→        async def stream_reader():\n   333→            \"\"\"Read SSE frames from the stream.\"\"\"\n   334→            async with AsyncClient(\n   335→                transport=ASGITransport(app=app_with_overrides),\n   336→                base_url=\"http://test\",\n   337→            ) as client:\n   338→                async with client.stream(\n   339→                    \"GET\",\n   340→                    \"/events/stream\",\n   341→                    params={\"channel\": \"agent.status.discovery\"},\n   342→                    headers={\"Authorization\": f\"Bearer {valid_jwt}\"},\n   343→                ) as response:\n   344→                    # Collect frames until we get our test event or timeout\n   345→                    async for line in response.aiter_lines():\n   346→                        received_frames.append(line)\n   347→                        if \"TEST_EVENT\" in line:\n   348→                            return\n   349→\n   350→        async def publish_after_delay():\n   351→            \"\"\"Publish test event after a brief delay for stream to connect.\"\"\"\n   352→            await asyncio.sleep(0.3)\n   353→            await fake_redis.publish(\n   354→                PubSubChannel.DISCOVERY.value,\n   355→                json.dumps(test_event),\n   356→            )\n   357→\n   358→        # Run stream reader and publisher concurrently with timeout\n   359→        try:\n   360→            await asyncio.wait_for(\n   361→                asyncio.gather(stream_reader(), publish_after_delay()),\n   362→                timeout=5.0,\n   363→            )\n   364→        except asyncio.TimeoutError:\n   365→            pass  # Timeout is expected after receiving the event\n   366→\n   367→        # Verify we received the event as an SSE data frame\n   368→        data_frames = [f for f in received_frames if f.startswith(\"data:\")]\n   369→        assert len(data_frames) > 0, f\"No data frames received. Got: {received_frames}\"\n   370→\n   371→        # Find our test event\n   372→        test_event_found = any(\"TEST_EVENT\" in frame for frame in data_frames)\n   373→        assert test_event_found, f\"Test event not found in frames: {data_frames}\"\n   374→\n   375→\n   376→class TestEventStreamHeartbeat:\n   377→    \"\"\"Test heartbeat (:ping) behavior.\"\"\"\n   378→\n   379→    @pytest.mark.asyncio\n   380→    async def test_heartbeat_within_interval(\n   381→        self, app_with_overrides: FastAPI, valid_jwt: str, fake_redis\n   382→    ):\n   383→        \"\"\"\n   384→        Heartbeat (:ping) should be sent within HEARTBEAT_INTERVAL_SECONDS.\n   385→\n   386→        HYPHA-TESTS.md requires heartbeat within 16s.\n   387→        HYPHA-API-STREAMING.md specifies 15s heartbeat interval.\n   388→        \"\"\"\n   389→        received_frames: list[str] = []\n   390→        ping_received = asyncio.Event()\n   391→\n   392→        async def stream_reader():\n   393→            \"\"\"Read SSE frames and signal when ping received.\"\"\"\n   394→            async with AsyncClient(\n   395→                transport=ASGITransport(app=app_with_overrides),\n   396→                base_url=\"http://test\",\n   397→            ) as client:\n   398→                async with client.stream(\n   399→                    \"GET\",\n   400→                    \"/events/stream\",\n   401→                    params={\"channel\": \"agent.status.discovery\"},\n   402→                    headers={\"Authorization\": f\"Bearer {valid_jwt}\"},\n   403→                ) as response:\n   404→                    async for line in response.aiter_lines():\n   405→                        received_frames.append(line)\n   406→                        if line == \":ping\":\n   407→                            ping_received.set()\n   408→                            return\n   409→\n   410→        try:\n   411→            # Wait for heartbeat with margin above 15s interval\n   412→            await asyncio.wait_for(stream_reader(), timeout=16.0)\n   413→        except asyncio.TimeoutError:\n   414→            pytest.fail(\n   415→                f\"No heartbeat received within 16s. Frames: {received_frames}\"\n   416→            )\n   417→\n   418→        assert ping_received.is_set(), \"Heartbeat ping not received\"\n   419→\n   420→\n   421→class TestAllowedChannels:\n   422→    \"\"\"Test that ALLOWED_CHANNELS matches the contract.\"\"\"\n   423→\n   424→    def test_allowed_channels_matches_contract(self):\n   425→        \"\"\"\n   426→        ALLOWED_CHANNELS should match NUTRIENTS.md contract.\n   427→\n   428→        Contract: agent.status.discovery, agent.status.application\n   429→        \"\"\"\n   430→        assert \"agent.status.discovery\" in ALLOWED_CHANNELS\n   431→        assert \"agent.status.application\" in ALLOWED_CHANNELS\n   432→        assert len(ALLOWED_CHANNELS) == 2\n   433→\n   434→\n   435→class TestConstants:\n   436→    \"\"\"Test that constants match the contract.\"\"\"\n   437→\n   438→    def test_heartbeat_interval_is_15_seconds(self):\n   439→        \"\"\"Heartbeat interval should be 15 seconds per HYPHA-API-STREAMING.md.\"\"\"\n   440→        assert HEARTBEAT_INTERVAL_SECONDS == 15.0\n   441→\n   442→    def test_max_queue_size_is_100(self):\n   443→        \"\"\"Max queue size should be 100 per HYPHA-API-STREAMING.md.\"\"\"\n   444→        assert MAX_QUEUE_SIZE == 100\n   445→\n   446→\n   447→# ─── Backpressure Tests ──────────────────────────────────────────────────────\n   448→\n   449→\n   450→class TestBackpressure:\n   451→    \"\"\"Test backpressure handling for slow clients.\"\"\"\n   452→\n   453→    @pytest.mark.asyncio\n   454→    async def test_subscriber_drops_messages_when_queue_full(self, fake_redis):\n   455→        \"\"\"\n   456→        When message queue exceeds MAX_QUEUE_SIZE, oldest messages should be dropped.\n   457→\n   458→        Contract: HYPHA-API-STREAMING.md — drop >100 messages behind, emit slow_client event\n   459→        \"\"\"\n   460→        subscriber = SSESubscriber(\n   461→            redis_client=fake_redis,\n   462→            channel=PubSubChannel.DISCOVERY.value,\n   463→            user_id=\"test-user-123\",\n   464→        )\n   465→\n   466→        # Manually fill the queue beyond capacity\n   467→        for i in range(MAX_QUEUE_SIZE + 10):\n   468→            await subscriber._message_queue.put(f\"message-{i}\")\n   469→\n   470→        # Queue should be at max capacity, not over\n   471→        # (backpressure logic runs in _reader, not on put)\n   472→        assert subscriber._message_queue.qsize() == MAX_QUEUE_SIZE + 10\n   473→\n   474→        # Cleanup\n   475→        await subscriber._cleanup()\n   476→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"e1a6c245-4572-4816-9d85-5634565bd455","uuid":"efe57064-8a61-47a8-9699-f40ed1959d9a","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/tests/api/test_events_stream.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nSSE Event Stream endpoint tests.\n\nTests for GET /events/stream — Server-Sent Events for real-time agent status.\n\nContract:\n  - HYPHA-TESTS.md § tests-agent.api.events\n  - HYPHA-API-STREAMING.md acceptance criteria\n  - NUTRIENTS.md § API_CONTRACTS (iter-4 additions)\n\nCoverage:\n  - TestClient streaming response\n  - SSE frame format (data: {json}\\\\n\\\\n)\n  - Heartbeat (:ping\\\\n\\\\n within 16s)\n  - 401 on missing/invalid auth\n  - Channel allowlist validation (400 on invalid channel)\n  - Message delivery from Redis pub/sub\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport json\nimport uuid\nfrom datetime import datetime, timedelta, timezone\nfrom typing import AsyncGenerator, Generator\nfrom unittest.mock import AsyncMock, patch\n\nimport fakeredis.aioredis\nimport jwt\nimport pytest\nimport pytest_asyncio\nfrom fastapi import FastAPI\nfrom fastapi.testclient import TestClient\nfrom httpx import ASGITransport, AsyncClient\nfrom sqlalchemy import create_engine\nfrom sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker, create_async_engine\nfrom sqlalchemy.orm import sessionmaker\nfrom sqlalchemy.pool import StaticPool\n\nfrom backend.api.auth import create_jwt\nfrom backend.api.events import (\n    ALLOWED_CHANNELS,\n    HEARTBEAT_INTERVAL_SECONDS,\n    MAX_QUEUE_SIZE,\n    SSESubscriber,\n    router as events_router,\n)\nfrom backend.config import settings\nfrom backend.database import Base, get_db, get_redis, set_redis_client\nfrom backend.models.auth import User\nfrom backend.observability.events import PubSubChannel\n\n\n# ─── Test Database Setup ─────────────────────────────────────────────────────\n\n# Use SQLite for testing (async via aiosqlite)\nTEST_DATABASE_URL = \"sqlite+aiosqlite:///:memory:\"\n\ntest_engine = create_async_engine(\n    TEST_DATABASE_URL,\n    connect_args={\"check_same_thread\": False},\n    poolclass=StaticPool,\n)\n\nTestAsyncSessionLocal = async_sessionmaker(\n    test_engine,\n    class_=AsyncSession,\n    expire_on_commit=False,\n)\n\n\nasync def override_get_db() -> AsyncGenerator[AsyncSession, None]:\n    \"\"\"Override get_db dependency for tests.\"\"\"\n    async with TestAsyncSessionLocal() as session:\n        yield session\n\n\n# ─── Fixtures ────────────────────────────────────────────────────────────────\n\n\n@pytest_asyncio.fixture\nasync def test_db():\n    \"\"\"Create test database tables and yield a session.\"\"\"\n    async with test_engine.begin() as conn:\n        await conn.run_sync(Base.metadata.create_all)\n\n    async with TestAsyncSessionLocal() as session:\n        yield session\n\n    async with test_engine.begin() as conn:\n        await conn.run_sync(Base.metadata.drop_all)\n\n\n@pytest.fixture\ndef fake_redis():\n    \"\"\"Create a fake Redis client for testing.\"\"\"\n    return fakeredis.aioredis.FakeRedis(decode_responses=True)\n\n\n@pytest_asyncio.fixture\nasync def test_user(test_db: AsyncSession) -> User:\n    \"\"\"Create a test user and return it.\"\"\"\n    user = User(\n        id=uuid.uuid4(),\n        email=\"test@example.com\",\n        name=\"Test User\",\n        is_active=True,\n        is_onboarded=True,\n    )\n    test_db.add(user)\n    await test_db.commit()\n    await test_db.refresh(user)\n    return user\n\n\n@pytest.fixture\ndef valid_jwt(test_user: User) -> str:\n    \"\"\"Generate a valid JWT for the test user.\"\"\"\n    payload = {\n        \"sub\": str(test_user.id),\n        \"email\": test_user.email,\n        \"iat\": datetime.now(timezone.utc),\n        \"exp\": datetime.now(timezone.utc) + timedelta(days=1),\n    }\n    return jwt.encode(payload, settings.jwt_secret, algorithm=\"HS256\")\n\n\n@pytest.fixture\ndef expired_jwt(test_user: User) -> str:\n    \"\"\"Generate an expired JWT for testing.\"\"\"\n    payload = {\n        \"sub\": str(test_user.id),\n        \"email\": test_user.email,\n        \"iat\": datetime.now(timezone.utc) - timedelta(days=10),\n        \"exp\": datetime.now(timezone.utc) - timedelta(days=1),\n    }\n    return jwt.encode(payload, settings.jwt_secret, algorithm=\"HS256\")\n\n\n@pytest.fixture\ndef app_with_overrides(test_db: AsyncSession, fake_redis) -> FastAPI:\n    \"\"\"Create a FastAPI app with test dependency overrides.\"\"\"\n    from backend.main import app\n\n    # Override dependencies\n    app.dependency_overrides[get_db] = lambda: test_db\n    app.dependency_overrides[get_redis] = lambda: fake_redis\n\n    # Set the fake Redis as the global client\n    set_redis_client(fake_redis)\n\n    yield app\n\n    # Clean up overrides\n    app.dependency_overrides.clear()\n\n\n@pytest.fixture\ndef test_client(app_with_overrides: FastAPI) -> Generator[TestClient, None, None]:\n    \"\"\"Create a TestClient for the app.\"\"\"\n    with TestClient(app_with_overrides) as client:\n        yield client\n\n\n# ─── SSESubscriber Unit Tests ────────────────────────────────────────────────\n\n\nclass TestSSESubscriberValidation:\n    \"\"\"Test SSESubscriber channel validation.\"\"\"\n\n    def test_valid_discovery_channel(self, fake_redis):\n        \"\"\"Valid discovery channel should not raise.\"\"\"\n        subscriber = SSESubscriber(\n            redis_client=fake_redis,\n            channel=PubSubChannel.DISCOVERY.value,\n            user_id=\"test-user-123\",\n        )\n        assert subscriber.channel == \"agent.status.discovery\"\n\n    def test_valid_application_channel(self, fake_redis):\n        \"\"\"Valid application channel should not raise.\"\"\"\n        subscriber = SSESubscriber(\n            redis_client=fake_redis,\n            channel=PubSubChannel.APPLICATION.value,\n            user_id=\"test-user-123\",\n        )\n        assert subscriber.channel == \"agent.status.application\"\n\n    def test_invalid_channel_raises_value_error(self, fake_redis):\n        \"\"\"Invalid channel should raise ValueError.\"\"\"\n        with pytest.raises(ValueError, match=\"Invalid channel\"):\n            SSESubscriber(\n                redis_client=fake_redis,\n                channel=\"invalid.channel\",\n                user_id=\"test-user-123\",\n            )\n\n    def test_invalid_channel_error_lists_allowed(self, fake_redis):\n        \"\"\"Error message should list allowed channels.\"\"\"\n        with pytest.raises(ValueError) as exc_info:\n            SSESubscriber(\n                redis_client=fake_redis,\n                channel=\"bad.channel\",\n                user_id=\"test-user-123\",\n            )\n        error_message = str(exc_info.value)\n        assert \"agent.status.application\" in error_message\n        assert \"agent.status.discovery\" in error_message\n\n\n# ─── Endpoint Integration Tests ──────────────────────────────────────────────\n\n\nclass TestEventStreamAuth:\n    \"\"\"Test authentication requirements for /events/stream.\"\"\"\n\n    def test_missing_auth_returns_401(self, test_client: TestClient):\n        \"\"\"Request without Authorization header should return 401.\"\"\"\n        response = test_client.get(\n            \"/events/stream\",\n            params={\"channel\": \"agent.status.discovery\"},\n        )\n        assert response.status_code == 401\n        assert \"Not authenticated\" in response.json().get(\"detail\", \"\")\n\n    def test_invalid_token_returns_401(self, test_client: TestClient):\n        \"\"\"Request with invalid JWT should return 401.\"\"\"\n        response = test_client.get(\n            \"/events/stream\",\n            params={\"channel\": \"agent.status.discovery\"},\n            headers={\"Authorization\": \"Bearer invalid-token-xyz\"},\n        )\n        assert response.status_code == 401\n\n    def test_expired_token_returns_401(\n        self, test_client: TestClient, expired_jwt: str\n    ):\n        \"\"\"Request with expired JWT should return 401.\"\"\"\n        response = test_client.get(\n            \"/events/stream\",\n            params={\"channel\": \"agent.status.discovery\"},\n            headers={\"Authorization\": f\"Bearer {expired_jwt}\"},\n        )\n        assert response.status_code == 401\n        assert \"expired\" in response.json().get(\"detail\", \"\").lower()\n\n\nclass TestEventStreamChannelValidation:\n    \"\"\"Test channel allowlist validation.\"\"\"\n\n    def test_invalid_channel_returns_400(\n        self, test_client: TestClient, valid_jwt: str\n    ):\n        \"\"\"Request with invalid channel should return 400.\"\"\"\n        response = test_client.get(\n            \"/events/stream\",\n            params={\"channel\": \"invalid.channel\"},\n            headers={\"Authorization\": f\"Bearer {valid_jwt}\"},\n        )\n        assert response.status_code == 400\n        detail = response.json().get(\"detail\", \"\")\n        assert \"Invalid channel\" in detail\n        assert \"agent.status.discovery\" in detail\n        assert \"agent.status.application\" in detail\n\n    def test_missing_channel_param_returns_422(\n        self, test_client: TestClient, valid_jwt: str\n    ):\n        \"\"\"Request without channel parameter should return 422 (validation error).\"\"\"\n        response = test_client.get(\n            \"/events/stream\",\n            headers={\"Authorization\": f\"Bearer {valid_jwt}\"},\n        )\n        assert response.status_code == 422\n\n\nclass TestEventStreamSSEFormat:\n    \"\"\"Test SSE frame format and streaming behavior.\"\"\"\n\n    @pytest.mark.asyncio\n    async def test_stream_returns_event_stream_content_type(\n        self, app_with_overrides: FastAPI, valid_jwt: str, fake_redis\n    ):\n        \"\"\"\n        Response should have Content-Type: text/event-stream.\n\n        This test verifies the SSE endpoint returns the correct media type\n        for Server-Sent Events streaming.\n        \"\"\"\n        async with AsyncClient(\n            transport=ASGITransport(app=app_with_overrides),\n            base_url=\"http://test\",\n        ) as client:\n            # Use a short timeout since we just need headers\n            async def fetch_headers():\n                async with client.stream(\n                    \"GET\",\n                    \"/events/stream\",\n                    params={\"channel\": \"agent.status.discovery\"},\n                    headers={\"Authorization\": f\"Bearer {valid_jwt}\"},\n                ) as response:\n                    return response.headers\n\n            try:\n                headers = await asyncio.wait_for(fetch_headers(), timeout=2.0)\n                assert headers.get(\"content-type\") == \"text/event-stream; charset=utf-8\"\n                assert headers.get(\"cache-control\") == \"no-cache\"\n            except asyncio.TimeoutError:\n                # Stream didn't return headers in time — check we got the connection\n                pass\n\n    @pytest.mark.asyncio\n    async def test_published_message_appears_as_sse_frame(\n        self, app_with_overrides: FastAPI, valid_jwt: str, fake_redis\n    ):\n        \"\"\"\n        Messages published to Redis should appear as SSE data frames.\n\n        SSE frame format: data: {json}\\\\n\\\\n\n        \"\"\"\n        received_frames: list[str] = []\n        test_event = {\n            \"event\": \"TEST_EVENT\",\n            \"candidate_id\": \"test-candidate-123\",\n            \"ts\": datetime.now(timezone.utc).isoformat(),\n        }\n\n        async def stream_reader():\n            \"\"\"Read SSE frames from the stream.\"\"\"\n            async with AsyncClient(\n                transport=ASGITransport(app=app_with_overrides),\n                base_url=\"http://test\",\n            ) as client:\n                async with client.stream(\n                    \"GET\",\n                    \"/events/stream\",\n                    params={\"channel\": \"agent.status.discovery\"},\n                    headers={\"Authorization\": f\"Bearer {valid_jwt}\"},\n                ) as response:\n                    # Collect frames until we get our test event or timeout\n                    async for line in response.aiter_lines():\n                        received_frames.append(line)\n                        if \"TEST_EVENT\" in line:\n                            return\n\n        async def publish_after_delay():\n            \"\"\"Publish test event after a brief delay for stream to connect.\"\"\"\n            await asyncio.sleep(0.3)\n            await fake_redis.publish(\n                PubSubChannel.DISCOVERY.value,\n                json.dumps(test_event),\n            )\n\n        # Run stream reader and publisher concurrently with timeout\n        try:\n            await asyncio.wait_for(\n                asyncio.gather(stream_reader(), publish_after_delay()),\n                timeout=5.0,\n            )\n        except asyncio.TimeoutError:\n            pass  # Timeout is expected after receiving the event\n\n        # Verify we received the event as an SSE data frame\n        data_frames = [f for f in received_frames if f.startswith(\"data:\")]\n        assert len(data_frames) > 0, f\"No data frames received. Got: {received_frames}\"\n\n        # Find our test event\n        test_event_found = any(\"TEST_EVENT\" in frame for frame in data_frames)\n        assert test_event_found, f\"Test event not found in frames: {data_frames}\"\n\n\nclass TestEventStreamHeartbeat:\n    \"\"\"Test heartbeat (:ping) behavior.\"\"\"\n\n    @pytest.mark.asyncio\n    async def test_heartbeat_within_interval(\n        self, app_with_overrides: FastAPI, valid_jwt: str, fake_redis\n    ):\n        \"\"\"\n        Heartbeat (:ping) should be sent within HEARTBEAT_INTERVAL_SECONDS.\n\n        HYPHA-TESTS.md requires heartbeat within 16s.\n        HYPHA-API-STREAMING.md specifies 15s heartbeat interval.\n        \"\"\"\n        received_frames: list[str] = []\n        ping_received = asyncio.Event()\n\n        async def stream_reader():\n            \"\"\"Read SSE frames and signal when ping received.\"\"\"\n            async with AsyncClient(\n                transport=ASGITransport(app=app_with_overrides),\n                base_url=\"http://test\",\n            ) as client:\n                async with client.stream(\n                    \"GET\",\n                    \"/events/stream\",\n                    params={\"channel\": \"agent.status.discovery\"},\n                    headers={\"Authorization\": f\"Bearer {valid_jwt}\"},\n                ) as response:\n                    async for line in response.aiter_lines():\n                        received_frames.append(line)\n                        if line == \":ping\":\n                            ping_received.set()\n                            return\n\n        try:\n            # Wait for heartbeat with margin above 15s interval\n            await asyncio.wait_for(stream_reader(), timeout=16.0)\n        except asyncio.TimeoutError:\n            pytest.fail(\n                f\"No heartbeat received within 16s. Frames: {received_frames}\"\n            )\n\n        assert ping_received.is_set(), \"Heartbeat ping not received\"\n\n\nclass TestAllowedChannels:\n    \"\"\"Test that ALLOWED_CHANNELS matches the contract.\"\"\"\n\n    def test_allowed_channels_matches_contract(self):\n        \"\"\"\n        ALLOWED_CHANNELS should match NUTRIENTS.md contract.\n\n        Contract: agent.status.discovery, agent.status.application\n        \"\"\"\n        assert \"agent.status.discovery\" in ALLOWED_CHANNELS\n        assert \"agent.status.application\" in ALLOWED_CHANNELS\n        assert len(ALLOWED_CHANNELS) == 2\n\n\nclass TestConstants:\n    \"\"\"Test that constants match the contract.\"\"\"\n\n    def test_heartbeat_interval_is_15_seconds(self):\n        \"\"\"Heartbeat interval should be 15 seconds per HYPHA-API-STREAMING.md.\"\"\"\n        assert HEARTBEAT_INTERVAL_SECONDS == 15.0\n\n    def test_max_queue_size_is_100(self):\n        \"\"\"Max queue size should be 100 per HYPHA-API-STREAMING.md.\"\"\"\n        assert MAX_QUEUE_SIZE == 100\n\n\n# ─── Backpressure Tests ──────────────────────────────────────────────────────\n\n\nclass TestBackpressure:\n    \"\"\"Test backpressure handling for slow clients.\"\"\"\n\n    @pytest.mark.asyncio\n    async def test_subscriber_drops_messages_when_queue_full(self, fake_redis):\n        \"\"\"\n        When message queue exceeds MAX_QUEUE_SIZE, oldest messages should be dropped.\n\n        Contract: HYPHA-API-STREAMING.md — drop >100 messages behind, emit slow_client event\n        \"\"\"\n        subscriber = SSESubscriber(\n            redis_client=fake_redis,\n            channel=PubSubChannel.DISCOVERY.value,\n            user_id=\"test-user-123\",\n        )\n\n        # Manually fill the queue beyond capacity\n        for i in range(MAX_QUEUE_SIZE + 10):\n            await subscriber._message_queue.put(f\"message-{i}\")\n\n        # Queue should be at max capacity, not over\n        # (backpressure logic runs in _reader, not on put)\n        assert subscriber._message_queue.qsize() == MAX_QUEUE_SIZE + 10\n\n        # Cleanup\n        await subscriber._cleanup()\n","numLines":476,"startLine":1,"totalLines":476}}}}
{"t":"2026-05-28T03:00:46.053Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DbCWinQHi3UiGcZzJ26F42","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→CRM — tracks every application and its outcome over time.\n     6→\n     7→Simple PostgreSQL-backed event log. No third-party CRM dependency.\n     8→Every significant moment in the application journey gets an event.\n     9→\n    10→Event types:\n    11→  APPLICATION_STARTED\n    12→  RESUME_TAILORED\n    13→  COMPANY_RESEARCHED\n    14→  CONTACT_FOUND\n    15→  EMAIL_DRAFTED\n    16→  APPROVED_FOR_SUBMISSION\n    17→  SUBMITTED\n    18→  EMAIL_SENT\n    19→  EMAIL_OPENED\n    20→  RESPONDED\n    21→  INTERVIEW_SCHEDULED\n    22→  OFFER_RECEIVED\n    23→  REJECTED\n    24→  PLACED\n    25→\"\"\"\n    26→\n    27→from uuid import UUID\n    28→from typing import Optional\n    29→\n    30→import structlog\n    31→from sqlalchemy.ext.asyncio import AsyncSession\n    32→from sqlalchemy import select\n    33→\n    34→from backend.models.application import CRMEvent as CRMEventORM, ApplicationPipeline\n    35→\n    36→logger = structlog.get_logger(__name__)\n    37→\n    38→\n    39→class CRM:\n    40→    \"\"\"\n    41→    Logs application lifecycle events to PostgreSQL.\n    42→\n    43→    Provides a complete audit trail for every application from start to placement.\n    44→    \"\"\"\n    45→\n    46→    def __init__(self, db: AsyncSession):\n    47→        self._db = db\n    48→\n    49→    async def log(\n    50→        self,\n    51→        pipeline_id: UUID,\n    52→        candidate_id: UUID,\n    53→        job_id: UUID,\n    54→        event_type: str,\n    55→        details: Optional[dict] = None,\n    56→    ) -> None:\n    57→        \"\"\"\n    58→        Record an event in the application timeline.\n    59→\n    60→        Args:\n    61→            pipeline_id: The application pipeline this event belongs to\n    62→            candidate_id: Candidate FK\n    63→            job_id: Job FK\n    64→            event_type: One of the defined event type strings\n    65→            details: Optional metadata dict (scores, email subjects, confirmation numbers, etc.)\n    66→        \"\"\"\n    67→        orm = CRMEventORM(\n    68→            pipeline_id=pipeline_id,\n    69→            candidate_id=candidate_id,\n    70→            job_id=job_id,\n    71→            event_type=event_type,\n    72→            details=details,\n    73→        )\n    74→        self._db.add(orm)\n    75→        await self._db.commit()\n    76→\n    77→        logger.info(\n    78→            \"crm.event_logged\",\n    79→            pipeline_id=str(pipeline_id),\n    80→            event_type=event_type,\n    81→        )\n    82→\n    83→    async def get_timeline(self, pipeline_id: UUID) -> list[dict]:\n    84→        \"\"\"\n    85→        Return the full event timeline for an application pipeline.\n    86→\n    87→        Args:\n    88→            pipeline_id: Pipeline to fetch events for\n    89→\n    90→        Returns:\n    91→            List of event dicts ordered by created_at ascending\n    92→        \"\"\"\n    93→        result = await self._db.execute(\n    94→            select(CRMEventORM)\n    95→            .where(CRMEventORM.pipeline_id == pipeline_id)\n    96→            .order_by(CRMEventORM.created_at.asc())\n    97→        )\n    98→        events = result.scalars().all()\n    99→        return [\n   100→            {\n   101→                \"id\": str(e.id),\n   102→                \"event_type\": e.event_type,\n   103→                \"details\": e.details,\n   104→                \"created_at\": e.created_at.isoformat(),\n   105→            }\n   106→            for e in events\n   107→        ]\n   108→\n   109→    async def update_pipeline_status(\n   110→        self, pipeline_id: UUID, status: str, current_step: Optional[str] = None\n   111→    ) -> None:\n   112→        \"\"\"\n   113→        Update the application pipeline's status and log the transition.\n   114→\n   115→        Args:\n   116→            pipeline_id: Pipeline to update\n   117→            status: New pipeline status\n   118→            current_step: Optional current step name\n   119→        \"\"\"\n   120→        result = await self._db.execute(\n   121→            select(ApplicationPipeline).where(ApplicationPipeline.id == pipeline_id)\n   122→        )\n   123→        pipeline = result.scalar_one_or_none()\n   124→        if not pipeline:\n   125→            logger.warning(\"crm.pipeline_not_found\", pipeline_id=str(pipeline_id))\n   126→            return\n   127→\n   128→        old_status = pipeline.status\n   129→        pipeline.status = status\n   130→        if current_step:\n   131→            pipeline.current_step = current_step\n   132→\n   133→        await self._db.commit()\n   134→\n   135→        logger.info(\n   136→            \"crm.status_updated\",\n   137→            pipeline_id=str(pipeline_id),\n   138→            old_status=old_status,\n   139→            new_status=status,\n   140→        )\n   141→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"e1a6c245-4572-4816-9d85-5634565bd455","uuid":"2324c04a-5e64-41a6-935c-19ee9d32df10","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/agents/application/crm.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nCRM — tracks every application and its outcome over time.\n\nSimple PostgreSQL-backed event log. No third-party CRM dependency.\nEvery significant moment in the application journey gets an event.\n\nEvent types:\n  APPLICATION_STARTED\n  RESUME_TAILORED\n  COMPANY_RESEARCHED\n  CONTACT_FOUND\n  EMAIL_DRAFTED\n  APPROVED_FOR_SUBMISSION\n  SUBMITTED\n  EMAIL_SENT\n  EMAIL_OPENED\n  RESPONDED\n  INTERVIEW_SCHEDULED\n  OFFER_RECEIVED\n  REJECTED\n  PLACED\n\"\"\"\n\nfrom uuid import UUID\nfrom typing import Optional\n\nimport structlog\nfrom sqlalchemy.ext.asyncio import AsyncSession\nfrom sqlalchemy import select\n\nfrom backend.models.application import CRMEvent as CRMEventORM, ApplicationPipeline\n\nlogger = structlog.get_logger(__name__)\n\n\nclass CRM:\n    \"\"\"\n    Logs application lifecycle events to PostgreSQL.\n\n    Provides a complete audit trail for every application from start to placement.\n    \"\"\"\n\n    def __init__(self, db: AsyncSession):\n        self._db = db\n\n    async def log(\n        self,\n        pipeline_id: UUID,\n        candidate_id: UUID,\n        job_id: UUID,\n        event_type: str,\n        details: Optional[dict] = None,\n    ) -> None:\n        \"\"\"\n        Record an event in the application timeline.\n\n        Args:\n            pipeline_id: The application pipeline this event belongs to\n            candidate_id: Candidate FK\n            job_id: Job FK\n            event_type: One of the defined event type strings\n            details: Optional metadata dict (scores, email subjects, confirmation numbers, etc.)\n        \"\"\"\n        orm = CRMEventORM(\n            pipeline_id=pipeline_id,\n            candidate_id=candidate_id,\n            job_id=job_id,\n            event_type=event_type,\n            details=details,\n        )\n        self._db.add(orm)\n        await self._db.commit()\n\n        logger.info(\n            \"crm.event_logged\",\n            pipeline_id=str(pipeline_id),\n            event_type=event_type,\n        )\n\n    async def get_timeline(self, pipeline_id: UUID) -> list[dict]:\n        \"\"\"\n        Return the full event timeline for an application pipeline.\n\n        Args:\n            pipeline_id: Pipeline to fetch events for\n\n        Returns:\n            List of event dicts ordered by created_at ascending\n        \"\"\"\n        result = await self._db.execute(\n            select(CRMEventORM)\n            .where(CRMEventORM.pipeline_id == pipeline_id)\n            .order_by(CRMEventORM.created_at.asc())\n        )\n        events = result.scalars().all()\n        return [\n            {\n                \"id\": str(e.id),\n                \"event_type\": e.event_type,\n                \"details\": e.details,\n                \"created_at\": e.created_at.isoformat(),\n            }\n            for e in events\n        ]\n\n    async def update_pipeline_status(\n        self, pipeline_id: UUID, status: str, current_step: Optional[str] = None\n    ) -> None:\n        \"\"\"\n        Update the application pipeline's status and log the transition.\n\n        Args:\n            pipeline_id: Pipeline to update\n            status: New pipeline status\n            current_step: Optional current step name\n        \"\"\"\n        result = await self._db.execute(\n            select(ApplicationPipeline).where(ApplicationPipeline.id == pipeline_id)\n        )\n        pipeline = result.scalar_one_or_none()\n        if not pipeline:\n            logger.warning(\"crm.pipeline_not_found\", pipeline_id=str(pipeline_id))\n            return\n\n        old_status = pipeline.status\n        pipeline.status = status\n        if current_step:\n            pipeline.current_step = current_step\n\n        await self._db.commit()\n\n        logger.info(\n            \"crm.status_updated\",\n            pipeline_id=str(pipeline_id),\n            old_status=old_status,\n            new_status=status,\n        )\n","numLines":141,"startLine":1,"totalLines":141}}}}
{"t":"2026-05-28T03:00:46.060Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01H1RJqSQQZeEvmiZG6Banqn","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→from typing import Optional\n     5→\n     6→import redis.asyncio as aioredis\n     7→from sqlalchemy.ext.asyncio import create_async_engine, AsyncSession, async_sessionmaker\n     8→from sqlalchemy.orm import DeclarativeBase\n     9→from backend.config import settings\n    10→\n    11→engine = create_async_engine(\n    12→    settings.database_url,\n    13→    echo=settings.debug,\n    14→    pool_pre_ping=True,\n    15→    pool_size=10,\n    16→    max_overflow=20,\n    17→)\n    18→\n    19→AsyncSessionLocal = async_sessionmaker(\n    20→    engine,\n    21→    class_=AsyncSession,\n    22→    expire_on_commit=False,\n    23→)\n    24→\n    25→\n    26→class Base(DeclarativeBase):\n    27→    pass\n    28→\n    29→\n    30→async def get_db():\n    31→    \"\"\"\n    32→    FastAPI dependency that yields an async database session.\n    33→\n    34→    Automatically rolls back on exception to prevent partial commits.\n    35→    Contract: HYPHA-API.md Acceptance Criteria\n    36→    \"\"\"\n    37→    async with AsyncSessionLocal() as session:\n    38→        try:\n    39→            yield session\n    40→        except Exception:\n    41→            await session.rollback()\n    42→            raise\n    43→\n    44→\n    45→# ─── Redis Client ─────────────────────────────────────────────────────────────\n    46→\n    47→# Global Redis client — initialized lazily or at startup via lifespan\n    48→_redis_client: Optional[aioredis.Redis] = None\n    49→\n    50→\n    51→def set_redis_client(client: aioredis.Redis) -> None:\n    52→    \"\"\"Set the global Redis client (called from app lifespan).\"\"\"\n    53→    global _redis_client\n    54→    _redis_client = client\n    55→\n    56→\n    57→async def get_redis() -> aioredis.Redis:\n    58→    \"\"\"\n    59→    FastAPI dependency that returns the global Redis client.\n    60→\n    61→    The client is initialized at app startup via lifespan.\n    62→    Falls back to lazy initialization if not set.\n    63→    \"\"\"\n    64→    global _redis_client\n    65→    if _redis_client is None:\n    66→        _redis_client = aioredis.from_url(\n    67→            settings.redis_url,\n    68→            encoding=\"utf-8\",\n    69→            decode_responses=True,\n    70→        )\n    71→    return _redis_client\n    72→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"e1a6c245-4572-4816-9d85-5634565bd455","uuid":"ed9ef867-44d8-4855-b3e4-990dc2f6c553","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/database.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\nfrom typing import Optional\n\nimport redis.asyncio as aioredis\nfrom sqlalchemy.ext.asyncio import create_async_engine, AsyncSession, async_sessionmaker\nfrom sqlalchemy.orm import DeclarativeBase\nfrom backend.config import settings\n\nengine = create_async_engine(\n    settings.database_url,\n    echo=settings.debug,\n    pool_pre_ping=True,\n    pool_size=10,\n    max_overflow=20,\n)\n\nAsyncSessionLocal = async_sessionmaker(\n    engine,\n    class_=AsyncSession,\n    expire_on_commit=False,\n)\n\n\nclass Base(DeclarativeBase):\n    pass\n\n\nasync def get_db():\n    \"\"\"\n    FastAPI dependency that yields an async database session.\n\n    Automatically rolls back on exception to prevent partial commits.\n    Contract: HYPHA-API.md Acceptance Criteria\n    \"\"\"\n    async with AsyncSessionLocal() as session:\n        try:\n            yield session\n        except Exception:\n            await session.rollback()\n            raise\n\n\n# ─── Redis Client ─────────────────────────────────────────────────────────────\n\n# Global Redis client — initialized lazily or at startup via lifespan\n_redis_client: Optional[aioredis.Redis] = None\n\n\ndef set_redis_client(client: aioredis.Redis) -> None:\n    \"\"\"Set the global Redis client (called from app lifespan).\"\"\"\n    global _redis_client\n    _redis_client = client\n\n\nasync def get_redis() -> aioredis.Redis:\n    \"\"\"\n    FastAPI dependency that returns the global Redis client.\n\n    The client is initialized at app startup via lifespan.\n    Falls back to lazy initialization if not set.\n    \"\"\"\n    global _redis_client\n    if _redis_client is None:\n        _redis_client = aioredis.from_url(\n            settings.redis_url,\n            encoding=\"utf-8\",\n            decode_responses=True,\n        )\n    return _redis_client\n","numLines":72,"startLine":1,"totalLines":72}}}}
