{"t":"2026-05-28T03:00:51.758Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Lanf4sg51FmCVjeu12AY8c","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→SQLAlchemy ORM models for the Discovery Engine.\n     6→\n     7→Tables:\n     8→  - candidates: Job seeker profiles with resume, preferences, exclusions\n     9→  - discovered_jobs: Raw jobs from crawler sources\n    10→  - scored_jobs: Jobs scored against candidate profile (6-dim)\n    11→  - daily_digests: Compiled digest per candidate per day\n    12→  - crawl_runs: Crawler execution tracking\n    13→\"\"\"\n    14→\n    15→import uuid\n    16→from datetime import datetime, date\n    17→from typing import Optional\n    18→\n    19→from sqlalchemy import (\n    20→    String, Text, Integer, Boolean, Date, DateTime,\n    21→    ForeignKey, CheckConstraint, func, Enum,\n    22→)\n    23→from sqlalchemy.orm import Mapped, mapped_column, relationship\n    24→from sqlalchemy.dialects.postgresql import UUID, ARRAY, JSONB\n    25→import enum\n    26→\n    27→from backend.database import Base\n    28→\n    29→\n    30→# ─── Enums ───────────────────────────────────────────────────────────────────\n    31→\n    32→class JobSource(str, enum.Enum):\n    33→    \"\"\"ATS platforms supported by the crawler.\"\"\"\n    34→    GREENHOUSE = \"greenhouse\"\n    35→    LEVER = \"lever\"\n    36→    ASHBY = \"ashby\"\n    37→    WORKDAY = \"workday\"\n    38→\n    39→\n    40→class RemotePreference(str, enum.Enum):\n    41→    \"\"\"Candidate remote work preference.\"\"\"\n    42→    REMOTE_ONLY = \"remote_only\"\n    43→    HYBRID = \"hybrid\"\n    44→    ONSITE = \"onsite\"\n    45→    FLEXIBLE = \"flexible\"\n    46→\n    47→\n    48→class CrawlRunStatus(str, enum.Enum):\n    49→    \"\"\"Status of a crawl run.\"\"\"\n    50→    QUEUED = \"QUEUED\"\n    51→    RUNNING = \"RUNNING\"\n    52→    COMPLETED = \"COMPLETED\"\n    53→    FAILED = \"FAILED\"\n    54→\n    55→\n    56→# ─── Candidate ───────────────────────────────────────────────────────────────\n    57→\n    58→class Candidate(Base):\n    59→    \"\"\"A candidate being managed by the Talent Agent system.\"\"\"\n    60→\n    61→    __tablename__ = \"candidates\"\n    62→\n    63→    id: Mapped[uuid.UUID] = mapped_column(\n    64→        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n    65→    )\n    66→    name: Mapped[str] = mapped_column(String(255), nullable=False)\n    67→    email: Mapped[str] = mapped_column(String(255), unique=True, nullable=False)\n    68→    resume_text: Mapped[Optional[str]] = mapped_column(Text)\n    69→    linkedin_url: Mapped[Optional[str]] = mapped_column(String(500))\n    70→    github_url: Mapped[Optional[str]] = mapped_column(String(500))\n    71→    personal_context: Mapped[Optional[str]] = mapped_column(Text)\n    72→    target_locations: Mapped[list[str]] = mapped_column(\n    73→        ARRAY(String), server_default=\"{}\", nullable=False\n    74→    )\n    75→    remote_preference: Mapped[RemotePreference] = mapped_column(\n    76→        Enum(RemotePreference, name=\"remote_preference\", create_type=False),\n    77→        server_default=\"flexible\",\n    78→        nullable=False,\n    79→    )\n    80→    min_compensation: Mapped[Optional[int]] = mapped_column(Integer)\n    81→    excluded_companies: Mapped[list[str]] = mapped_column(\n    82→        ARRAY(String), server_default=\"{}\", nullable=False\n    83→    )\n    84→    excluded_industries: Mapped[list[str]] = mapped_column(\n    85→        ARRAY(String), server_default=\"{}\", nullable=False\n    86→    )\n    87→    created_at: Mapped[datetime] = mapped_column(\n    88→        DateTime(timezone=True), server_default=func.now(), nullable=False\n    89→    )\n    90→    updated_at: Mapped[datetime] = mapped_column(\n    91→        DateTime(timezone=True), server_default=func.now(), onupdate=func.now(), nullable=False\n    92→    )\n    93→\n    94→    # Relationships\n    95→    crawl_runs: Mapped[list[\"CrawlRun\"]] = relationship(\n    96→        back_populates=\"candidate\", cascade=\"all, delete-orphan\"\n    97→    )\n    98→    daily_digests: Mapped[list[\"DailyDigest\"]] = relationship(\n    99→        back_populates=\"candidate\", cascade=\"all, delete-orphan\"\n   100→    )\n   101→    scored_jobs: Mapped[list[\"ScoredJob\"]] = relationship(\n   102→        back_populates=\"candidate\", cascade=\"all, delete-orphan\"\n   103→    )\n   104→\n   105→\n   106→# ─── Discovered Job ──────────────────────────────────────────────────────────\n   107→\n   108→class DiscoveredJob(Base):\n   109→    \"\"\"A raw job posting discovered during a crawl run.\"\"\"\n   110→\n   111→    __tablename__ = \"discovered_jobs\"\n   112→\n   113→    id: Mapped[uuid.UUID] = mapped_column(\n   114→        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n   115→    )\n   116→    source: Mapped[JobSource] = mapped_column(\n   117→        Enum(JobSource, name=\"job_source\", create_type=False), nullable=False\n   118→    )\n   119→    source_id: Mapped[str] = mapped_column(String(255), nullable=False)\n   120→    title: Mapped[str] = mapped_column(String(500), nullable=False)\n   121→    company: Mapped[str] = mapped_column(String(255), nullable=False)\n   122→    location: Mapped[Optional[str]] = mapped_column(String(255))\n   123→    description: Mapped[Optional[str]] = mapped_column(Text)\n   124→    url: Mapped[str] = mapped_column(String(1000), nullable=False)\n   125→    posted_at: Mapped[Optional[datetime]] = mapped_column(DateTime(timezone=True))\n   126→    salary_min: Mapped[Optional[int]] = mapped_column(Integer)\n   127→    salary_max: Mapped[Optional[int]] = mapped_column(Integer)\n   128→    remote: Mapped[bool] = mapped_column(Boolean, server_default=\"false\", nullable=False)\n   129→    crawled_at: Mapped[datetime] = mapped_column(\n   130→        DateTime(timezone=True), server_default=func.now(), nullable=False\n   131→    )\n   132→    created_at: Mapped[datetime] = mapped_column(\n   133→        DateTime(timezone=True), server_default=func.now(), nullable=False\n   134→    )\n   135→    updated_at: Mapped[datetime] = mapped_column(\n   136→        DateTime(timezone=True), server_default=func.now(), onupdate=func.now(), nullable=False\n   137→    )\n   138→\n   139→    # Relationships\n   140→    scored_job: Mapped[Optional[\"ScoredJob\"]] = relationship(\n   141→        back_populates=\"discovered_job\", uselist=False\n   142→    )\n   143→\n   144→    __table_args__ = (\n   145→        # Unique constraint on source + source_id\n   146→        {\"extend_existing\": True},\n   147→    )\n   148→\n   149→\n   150→# ─── Scored Job ──────────────────────────────────────────────────────────────\n   151→\n   152→class ScoredJob(Base):\n   153→    \"\"\"Scoring breakdown for a discovered job against a candidate's identity profile.\"\"\"\n   154→\n   155→    __tablename__ = \"scored_jobs\"\n   156→\n   157→    id: Mapped[uuid.UUID] = mapped_column(\n   158→        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n   159→    )\n   160→    discovered_job_id: Mapped[uuid.UUID] = mapped_column(\n   161→        ForeignKey(\"discovered_jobs.id\", ondelete=\"CASCADE\"), nullable=False\n   162→    )\n   163→    candidate_id: Mapped[uuid.UUID] = mapped_column(\n   164→        ForeignKey(\"candidates.id\", ondelete=\"CASCADE\"), nullable=False\n   165→    )\n   166→    technical_match: Mapped[int] = mapped_column(Integer, nullable=False)\n   167→    level_match: Mapped[int] = mapped_column(Integer, nullable=False)\n   168→    culture_match: Mapped[int] = mapped_column(Integer, nullable=False)\n   169→    industry_match: Mapped[int] = mapped_column(Integer, nullable=False)\n   170→    growth_potential: Mapped[int] = mapped_column(Integer, nullable=False)\n   171→    compensation_match: Mapped[int] = mapped_column(Integer, nullable=False)\n   172→    composite_score: Mapped[int] = mapped_column(Integer, nullable=False)\n   173→    is_hot: Mapped[bool] = mapped_column(Boolean, server_default=\"false\", nullable=False)\n   174→    reasoning: Mapped[str] = mapped_column(Text, nullable=False)\n   175→    scored_at: Mapped[datetime] = mapped_column(\n   176→        DateTime(timezone=True), server_default=func.now(), nullable=False\n   177→    )\n   178→    created_at: Mapped[datetime] = mapped_column(\n   179→        DateTime(timezone=True), server_default=func.now(), nullable=False\n   180→    )\n   181→\n   182→    # Relationships\n   183→    discovered_job: Mapped[\"DiscoveredJob\"] = relationship(back_populates=\"scored_job\")\n   184→    candidate: Mapped[\"Candidate\"] = relationship(back_populates=\"scored_jobs\")\n   185→\n   186→    __table_args__ = (\n   187→        CheckConstraint(\"technical_match >= 0 AND technical_match <= 100\"),\n   188→        CheckConstraint(\"level_match >= 0 AND level_match <= 100\"),\n   189→        CheckConstraint(\"culture_match >= 0 AND culture_match <= 100\"),\n   190→        CheckConstraint(\"industry_match >= 0 AND industry_match <= 100\"),\n   191→        CheckConstraint(\"growth_potential >= 0 AND growth_potential <= 100\"),\n   192→        CheckConstraint(\"compensation_match >= 0 AND compensation_match <= 100\"),\n   193→        CheckConstraint(\"composite_score >= 0 AND composite_score <= 100\"),\n   194→    )\n   195→\n   196→\n   197→# ─── Daily Digest ────────────────────────────────────────────────────────────\n   198→\n   199→class DailyDigest(Base):\n   200→    \"\"\"Compiled digest per candidate per day.\"\"\"\n   201→\n   202→    __tablename__ = \"daily_digests\"\n   203→\n   204→    id: Mapped[uuid.UUID] = mapped_column(\n   205→        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n   206→    )\n   207→    candidate_id: Mapped[uuid.UUID] = mapped_column(\n   208→        ForeignKey(\"candidates.id\", ondelete=\"CASCADE\"), nullable=False\n   209→    )\n   210→    run_date: Mapped[date] = mapped_column(Date, nullable=False)\n   211→    top_picks: Mapped[list] = mapped_column(JSONB, server_default=\"[]\", nullable=False)\n   212→    hot_picks: Mapped[list] = mapped_column(JSONB, server_default=\"[]\", nullable=False)\n   213→    new_companies: Mapped[list[str]] = mapped_column(\n   214→        ARRAY(String), server_default=\"{}\", nullable=False\n   215→    )\n   216→    total_jobs_discovered: Mapped[int] = mapped_column(\n   217→        Integer, server_default=\"0\", nullable=False\n   218→    )\n   219→    total_jobs_scored: Mapped[int] = mapped_column(\n   220→        Integer, server_default=\"0\", nullable=False\n   221→    )\n   222→    created_at: Mapped[datetime] = mapped_column(\n   223→        DateTime(timezone=True), server_default=func.now(), nullable=False\n   224→    )\n   225→\n   226→    # Relationships\n   227→    candidate: Mapped[\"Candidate\"] = relationship(back_populates=\"daily_digests\")\n   228→\n   229→\n   230→# ─── Crawl Run ───────────────────────────────────────────────────────────────\n   231→\n   232→class CrawlRun(Base):\n   233→    \"\"\"Audit log of every discovery crawl run.\"\"\"\n   234→\n   235→    __tablename__ = \"crawl_runs\"\n   236→\n   237→    id: Mapped[uuid.UUID] = mapped_column(\n   238→        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n   239→    )\n   240→    candidate_id: Mapped[uuid.UUID] = mapped_column(\n   241→        ForeignKey(\"candidates.id\", ondelete=\"CASCADE\"), nullable=False\n   242→    )\n   243→    status: Mapped[CrawlRunStatus] = mapped_column(\n   244→        Enum(CrawlRunStatus, name=\"crawl_run_status\", create_type=False),\n   245→        server_default=\"QUEUED\",\n   246→        nullable=False,\n   247→    )\n   248→    jobs_discovered: Mapped[int] = mapped_column(\n   249→        Integer, server_default=\"0\", nullable=False\n   250→    )\n   251→    jobs_scored: Mapped[int] = mapped_column(Integer, server_default=\"0\", nullable=False)\n   252→    started_at: Mapped[datetime] = mapped_column(\n   253→        DateTime(timezone=True), server_default=func.now(), nullable=False\n   254→    )\n   255→    completed_at: Mapped[Optional[datetime]] = mapped_column(DateTime(timezone=True))\n   256→    error_log: Mapped[Optional[str]] = mapped_column(Text)\n   257→    created_at: Mapped[datetime] = mapped_column(\n   258→        DateTime(timezone=True), server_default=func.now(), nullable=False\n   259→    )\n   260→\n   261→    # Relationships\n   262→    candidate: Mapped[\"Candidate\"] = relationship(back_populates=\"crawl_runs\")\n   263→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"e1a6c245-4572-4816-9d85-5634565bd455","uuid":"7820450e-f990-4b7e-b52e-da4e9ffa68ca","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/models/discovery.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nSQLAlchemy ORM models for the Discovery Engine.\n\nTables:\n  - candidates: Job seeker profiles with resume, preferences, exclusions\n  - discovered_jobs: Raw jobs from crawler sources\n  - scored_jobs: Jobs scored against candidate profile (6-dim)\n  - daily_digests: Compiled digest per candidate per day\n  - crawl_runs: Crawler execution tracking\n\"\"\"\n\nimport uuid\nfrom datetime import datetime, date\nfrom typing import Optional\n\nfrom sqlalchemy import (\n    String, Text, Integer, Boolean, Date, DateTime,\n    ForeignKey, CheckConstraint, func, Enum,\n)\nfrom sqlalchemy.orm import Mapped, mapped_column, relationship\nfrom sqlalchemy.dialects.postgresql import UUID, ARRAY, JSONB\nimport enum\n\nfrom backend.database import Base\n\n\n# ─── Enums ───────────────────────────────────────────────────────────────────\n\nclass JobSource(str, enum.Enum):\n    \"\"\"ATS platforms supported by the crawler.\"\"\"\n    GREENHOUSE = \"greenhouse\"\n    LEVER = \"lever\"\n    ASHBY = \"ashby\"\n    WORKDAY = \"workday\"\n\n\nclass RemotePreference(str, enum.Enum):\n    \"\"\"Candidate remote work preference.\"\"\"\n    REMOTE_ONLY = \"remote_only\"\n    HYBRID = \"hybrid\"\n    ONSITE = \"onsite\"\n    FLEXIBLE = \"flexible\"\n\n\nclass CrawlRunStatus(str, enum.Enum):\n    \"\"\"Status of a crawl run.\"\"\"\n    QUEUED = \"QUEUED\"\n    RUNNING = \"RUNNING\"\n    COMPLETED = \"COMPLETED\"\n    FAILED = \"FAILED\"\n\n\n# ─── Candidate ───────────────────────────────────────────────────────────────\n\nclass Candidate(Base):\n    \"\"\"A candidate being managed by the Talent Agent system.\"\"\"\n\n    __tablename__ = \"candidates\"\n\n    id: Mapped[uuid.UUID] = mapped_column(\n        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n    )\n    name: Mapped[str] = mapped_column(String(255), nullable=False)\n    email: Mapped[str] = mapped_column(String(255), unique=True, nullable=False)\n    resume_text: Mapped[Optional[str]] = mapped_column(Text)\n    linkedin_url: Mapped[Optional[str]] = mapped_column(String(500))\n    github_url: Mapped[Optional[str]] = mapped_column(String(500))\n    personal_context: Mapped[Optional[str]] = mapped_column(Text)\n    target_locations: Mapped[list[str]] = mapped_column(\n        ARRAY(String), server_default=\"{}\", nullable=False\n    )\n    remote_preference: Mapped[RemotePreference] = mapped_column(\n        Enum(RemotePreference, name=\"remote_preference\", create_type=False),\n        server_default=\"flexible\",\n        nullable=False,\n    )\n    min_compensation: Mapped[Optional[int]] = mapped_column(Integer)\n    excluded_companies: Mapped[list[str]] = mapped_column(\n        ARRAY(String), server_default=\"{}\", nullable=False\n    )\n    excluded_industries: Mapped[list[str]] = mapped_column(\n        ARRAY(String), server_default=\"{}\", nullable=False\n    )\n    created_at: Mapped[datetime] = mapped_column(\n        DateTime(timezone=True), server_default=func.now(), nullable=False\n    )\n    updated_at: Mapped[datetime] = mapped_column(\n        DateTime(timezone=True), server_default=func.now(), onupdate=func.now(), nullable=False\n    )\n\n    # Relationships\n    crawl_runs: Mapped[list[\"CrawlRun\"]] = relationship(\n        back_populates=\"candidate\", cascade=\"all, delete-orphan\"\n    )\n    daily_digests: Mapped[list[\"DailyDigest\"]] = relationship(\n        back_populates=\"candidate\", cascade=\"all, delete-orphan\"\n    )\n    scored_jobs: Mapped[list[\"ScoredJob\"]] = relationship(\n        back_populates=\"candidate\", cascade=\"all, delete-orphan\"\n    )\n\n\n# ─── Discovered Job ──────────────────────────────────────────────────────────\n\nclass DiscoveredJob(Base):\n    \"\"\"A raw job posting discovered during a crawl run.\"\"\"\n\n    __tablename__ = \"discovered_jobs\"\n\n    id: Mapped[uuid.UUID] = mapped_column(\n        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n    )\n    source: Mapped[JobSource] = mapped_column(\n        Enum(JobSource, name=\"job_source\", create_type=False), nullable=False\n    )\n    source_id: Mapped[str] = mapped_column(String(255), nullable=False)\n    title: Mapped[str] = mapped_column(String(500), nullable=False)\n    company: Mapped[str] = mapped_column(String(255), nullable=False)\n    location: Mapped[Optional[str]] = mapped_column(String(255))\n    description: Mapped[Optional[str]] = mapped_column(Text)\n    url: Mapped[str] = mapped_column(String(1000), nullable=False)\n    posted_at: Mapped[Optional[datetime]] = mapped_column(DateTime(timezone=True))\n    salary_min: Mapped[Optional[int]] = mapped_column(Integer)\n    salary_max: Mapped[Optional[int]] = mapped_column(Integer)\n    remote: Mapped[bool] = mapped_column(Boolean, server_default=\"false\", nullable=False)\n    crawled_at: Mapped[datetime] = mapped_column(\n        DateTime(timezone=True), server_default=func.now(), nullable=False\n    )\n    created_at: Mapped[datetime] = mapped_column(\n        DateTime(timezone=True), server_default=func.now(), nullable=False\n    )\n    updated_at: Mapped[datetime] = mapped_column(\n        DateTime(timezone=True), server_default=func.now(), onupdate=func.now(), nullable=False\n    )\n\n    # Relationships\n    scored_job: Mapped[Optional[\"ScoredJob\"]] = relationship(\n        back_populates=\"discovered_job\", uselist=False\n    )\n\n    __table_args__ = (\n        # Unique constraint on source + source_id\n        {\"extend_existing\": True},\n    )\n\n\n# ─── Scored Job ──────────────────────────────────────────────────────────────\n\nclass ScoredJob(Base):\n    \"\"\"Scoring breakdown for a discovered job against a candidate's identity profile.\"\"\"\n\n    __tablename__ = \"scored_jobs\"\n\n    id: Mapped[uuid.UUID] = mapped_column(\n        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n    )\n    discovered_job_id: Mapped[uuid.UUID] = mapped_column(\n        ForeignKey(\"discovered_jobs.id\", ondelete=\"CASCADE\"), nullable=False\n    )\n    candidate_id: Mapped[uuid.UUID] = mapped_column(\n        ForeignKey(\"candidates.id\", ondelete=\"CASCADE\"), nullable=False\n    )\n    technical_match: Mapped[int] = mapped_column(Integer, nullable=False)\n    level_match: Mapped[int] = mapped_column(Integer, nullable=False)\n    culture_match: Mapped[int] = mapped_column(Integer, nullable=False)\n    industry_match: Mapped[int] = mapped_column(Integer, nullable=False)\n    growth_potential: Mapped[int] = mapped_column(Integer, nullable=False)\n    compensation_match: Mapped[int] = mapped_column(Integer, nullable=False)\n    composite_score: Mapped[int] = mapped_column(Integer, nullable=False)\n    is_hot: Mapped[bool] = mapped_column(Boolean, server_default=\"false\", nullable=False)\n    reasoning: Mapped[str] = mapped_column(Text, nullable=False)\n    scored_at: Mapped[datetime] = mapped_column(\n        DateTime(timezone=True), server_default=func.now(), nullable=False\n    )\n    created_at: Mapped[datetime] = mapped_column(\n        DateTime(timezone=True), server_default=func.now(), nullable=False\n    )\n\n    # Relationships\n    discovered_job: Mapped[\"DiscoveredJob\"] = relationship(back_populates=\"scored_job\")\n    candidate: Mapped[\"Candidate\"] = relationship(back_populates=\"scored_jobs\")\n\n    __table_args__ = (\n        CheckConstraint(\"technical_match >= 0 AND technical_match <= 100\"),\n        CheckConstraint(\"level_match >= 0 AND level_match <= 100\"),\n        CheckConstraint(\"culture_match >= 0 AND culture_match <= 100\"),\n        CheckConstraint(\"industry_match >= 0 AND industry_match <= 100\"),\n        CheckConstraint(\"growth_potential >= 0 AND growth_potential <= 100\"),\n        CheckConstraint(\"compensation_match >= 0 AND compensation_match <= 100\"),\n        CheckConstraint(\"composite_score >= 0 AND composite_score <= 100\"),\n    )\n\n\n# ─── Daily Digest ────────────────────────────────────────────────────────────\n\nclass DailyDigest(Base):\n    \"\"\"Compiled digest per candidate per day.\"\"\"\n\n    __tablename__ = \"daily_digests\"\n\n    id: Mapped[uuid.UUID] = mapped_column(\n        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n    )\n    candidate_id: Mapped[uuid.UUID] = mapped_column(\n        ForeignKey(\"candidates.id\", ondelete=\"CASCADE\"), nullable=False\n    )\n    run_date: Mapped[date] = mapped_column(Date, nullable=False)\n    top_picks: Mapped[list] = mapped_column(JSONB, server_default=\"[]\", nullable=False)\n    hot_picks: Mapped[list] = mapped_column(JSONB, server_default=\"[]\", nullable=False)\n    new_companies: Mapped[list[str]] = mapped_column(\n        ARRAY(String), server_default=\"{}\", nullable=False\n    )\n    total_jobs_discovered: Mapped[int] = mapped_column(\n        Integer, server_default=\"0\", nullable=False\n    )\n    total_jobs_scored: Mapped[int] = mapped_column(\n        Integer, server_default=\"0\", nullable=False\n    )\n    created_at: Mapped[datetime] = mapped_column(\n        DateTime(timezone=True), server_default=func.now(), nullable=False\n    )\n\n    # Relationships\n    candidate: Mapped[\"Candidate\"] = relationship(back_populates=\"daily_digests\")\n\n\n# ─── Crawl Run ───────────────────────────────────────────────────────────────\n\nclass CrawlRun(Base):\n    \"\"\"Audit log of every discovery crawl run.\"\"\"\n\n    __tablename__ = \"crawl_runs\"\n\n    id: Mapped[uuid.UUID] = mapped_column(\n        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n    )\n    candidate_id: Mapped[uuid.UUID] = mapped_column(\n        ForeignKey(\"candidates.id\", ondelete=\"CASCADE\"), nullable=False\n    )\n    status: Mapped[CrawlRunStatus] = mapped_column(\n        Enum(CrawlRunStatus, name=\"crawl_run_status\", create_type=False),\n        server_default=\"QUEUED\",\n        nullable=False,\n    )\n    jobs_discovered: Mapped[int] = mapped_column(\n        Integer, server_default=\"0\", nullable=False\n    )\n    jobs_scored: Mapped[int] = mapped_column(Integer, server_default=\"0\", nullable=False)\n    started_at: Mapped[datetime] = mapped_column(\n        DateTime(timezone=True), server_default=func.now(), nullable=False\n    )\n    completed_at: Mapped[Optional[datetime]] = mapped_column(DateTime(timezone=True))\n    error_log: Mapped[Optional[str]] = mapped_column(Text)\n    created_at: Mapped[datetime] = mapped_column(\n        DateTime(timezone=True), server_default=func.now(), nullable=False\n    )\n\n    # Relationships\n    candidate: Mapped[\"Candidate\"] = relationship(back_populates=\"crawl_runs\")\n","numLines":263,"startLine":1,"totalLines":263}}}}
