e.py:1700: in get_column_specification\n    coltype = self.dialect.type_compiler_instance.process(\n.venv-test/lib/python3.12/site-packages/sqlalchemy/sql/compiler.py:993: in process\n    return type_._compiler_dispatch(self, **kw)\n           ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^","stderr":"","interrupted":false,"isImage":false}}}
{"t":"2026-05-28T03:05:19.265Z","event":"sdk_msg","msg":{"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_01QdkVLSEVSLeHwA8S7nBMPQ","type":"message","role":"assistant","content":[{"type":"text","text":"I see - the existing tests also have this issue with SQLite. This is a fundamental incompatibility with the PostgreSQL-specific column types in the models. \n\nGiven the HYPHA-TESTS.md specification states \"Test uses in-memory SQLite for database\", but the actual models use PostgreSQL-specific types (ARRAY, JSONB), I have two options:\n\n1. Skip the database fixture tests entirely and just test the endpoint logic with mocked database\n2. Document that the test requires PostgreSQL (deviates from spec)\n\nLet me look at how the test_events_stream.py handles this - it only uses the User model which doesn't have ARRAY columns. For the review approve tests, I need to take a different approach that mocks the database layer.\n\nLet me rewrite the test file to mock database operations instead of using a real test database:"}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2185,"cache_read_input_tokens":113522,"cache_creation":{"ephemeral_5m_input_tokens":2185,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"e1a6c245-4572-4816-9d85-5634565bd455","uuid":"b023dd69-99ce-467e-aeb0-c26cebba8866"}}
{"t":"2026-05-28T03:06:31.251Z","event":"sdk_msg","msg":{"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_01QdkVLSEVSLeHwA8S7nBMPQ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018cv1st3fSqeQmatFgP1hMJ","name":"Write","input":{"file_path":"/Users/spy/mfautomations/repos/creation-station/reverse-search/tests/api/test_review_approve.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nReview Dashboard Approve Flow integration tests.\n\nFull end-to-end tests for the application approval workflow:\n  - Create application pipeline → approve → verify state transition\n  - CRM event logging on approval\n  - Error handling for non-existent and invalid-status pipelines\n\nContract:\n  - HYPHA-TESTS.md § tests-agent.api.review\n  - NUTRIENTS.md § API_CONTRACTS review endpoints\n  - HYPHA-REVIEW-DASHBOARD.md acceptance criteria\n\nCoverage:\n  - Create application row in test database\n  - PATCH approve, assert state transition to APPROVED\n  - Verify crm_events row written on approval\n  - 404 on non-existent pipeline\n  - 422 on approving non-AWAITING_REVIEW pipeline\n  - PATCH reject, assert state transition to REJECTED\n\nNOTE: Uses mocked database operations because the ORM models use PostgreSQL-\nspecific types (ARRAY, JSONB) that are incompatible with SQLite testing.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport uuid\nfrom datetime import datetime, timedelta, timezone\nfrom typing import Generator, Any\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\nimport fakeredis.aioredis\nimport jwt\nimport pytest\nfrom fastapi import FastAPI\nfrom fastapi.testclient import TestClient\n\nfrom backend.config import settings\nfrom backend.database import get_db, get_redis, set_redis_client\n\n\n# ─── Mock ORM Objects ────────────────────────────────────────────────────────\n\n\ndef create_mock_pipeline(\n    pipeline_id: uuid.UUID,\n    candidate_id: uuid.UUID,\n    job_id: uuid.UUID,\n    status: str = \"AWAITING_REVIEW\",\n    current_step: str = \"compose\",\n) -> MagicMock:\n    \"\"\"Create a mock ApplicationPipeline ORM object.\"\"\"\n    mock = MagicMock()\n    mock.id = pipeline_id\n    mock.candidate_id = candidate_id\n    mock.job_id = job_id\n    mock.status = status\n    mock.current_step = current_step\n    mock.created_at = datetime.now(timezone.utc)\n    mock.updated_at = datetime.now(timezone.utc)\n    mock.resume_id = None\n    mock.email_id = None\n    mock.approval_timestamp = None\n    return mock\n\n\ndef create_mock_crm_event(\n    pipeline_id: uuid.UUID,\n    candidate_id: uuid.UUID,\n    job_id: uuid.UUID,\n    event_type: str,\n) -> MagicMock:\n    \"\"\"Create a mock CRMEvent ORM object.\"\"\"\n    mock = MagicMock()\n    mock.id = uuid.uuid4()\n    mock.pipeline_id = pipeline_id\n    mock.candidate_id = candidate_id\n    mock.job_id = job_id\n    mock.event_type = event_type\n    mock.details = None\n    mock.payload = {}\n    mock.created_at = datetime.now(timezone.utc)\n    return mock\n\n\n# ─── Fixtures ────────────────────────────────────────────────────────────────\n\n\n@pytest.fixture\ndef pipeline_id() -> uuid.UUID:\n    \"\"\"Generate a test pipeline ID.\"\"\"\n    return uuid.uuid4()\n\n\n@pytest.fixture\ndef candidate_id() -> uuid.UUID:\n    \"\"\"Generate a test candidate ID.\"\"\"\n    return uuid.uuid4()\n\n\n@pytest.fixture\ndef job_id() -> uuid.UUID:\n    \"\"\"Generate a test job ID.\"\"\"\n    return uuid.uuid4()\n\n\n@pytest.fixture\ndef fake_redis():\n    \"\"\"Create a fake Redis client for testing.\"\"\"\n    return fakeredis.aioredis.FakeRedis(decode_responses=True)\n\n\n@pytest.fixture\ndef valid_jwt() -> str:\n    \"\"\"Generate a valid JWT for testing.\"\"\"\n    user_id = uuid.uuid4()\n    payload = {\n        \"sub\": str(user_id),\n        \"email\": \"reviewer@example.com\",\n        \"iat\": datetime.now(timezone.utc),\n        \"exp\": datetime.now(timezone.utc) + timedelta(days=1),\n    }\n    return jwt.encode(payload, settings.jwt_secret, algorithm=\"HS256\")\n\n\n@pytest.fixture\ndef mock_db_session():\n    \"\"\"Create a mock async database session.\"\"\"\n    session = AsyncMock()\n    session.execute = AsyncMock()\n    session.commit = AsyncMock()\n    session.add = MagicMock()\n    session.refresh = AsyncMock()\n    return session\n\n\n@pytest.fixture\ndef app_with_mocks(mock_db_session, fake_redis) -> FastAPI:\n    \"\"\"Create a FastAPI app with mocked dependencies.\"\"\"\n    from backend.main import app\n\n    # Override dependencies with mocks\n    app.dependency_overrides[get_db] = lambda: mock_db_session\n    app.dependency_overrides[get_redis] = lambda: fake_redis\n\n    # Set the fake Redis as the global client\n    set_redis_client(fake_redis)\n\n    yield app\n\n    # Clean up overrides\n    app.dependency_overrides.clear()\n\n\n@pytest.fixture\ndef test_client(app_with_mocks: FastAPI) -> Generator[TestClient, None, None]:\n    \"\"\"Create a TestClient for the app.\"\"\"\n    with TestClient(app_with_mocks) as client:\n        yield client\n\n\n# ─── Approve Endpoint Tests ───────────────────────────────────────────────────\n\n\nclass TestApproveApplication:\n    \"\"\"Test PATCH /api/v1/review/application/{pipeline_id}/approve endpoint.\"\"\"\n\n    def test_approve_awaiting_review_pipeline_succeeds(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n        pipeline_id: uuid.UUID,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Approving a pipeline in AWAITING_REVIEW status should succeed.\n\n        Asserts:\n          - Response status 200\n          - Response contains pipeline_id and status='APPROVED'\n        \"\"\"\n        # Setup: mock pipeline lookup returns a pipeline in AWAITING_REVIEW\n        mock_pipeline = create_mock_pipeline(\n            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n        )\n        mock_result = MagicMock()\n        mock_result.scalar_one_or_none.return_value = mock_pipeline\n        mock_db_session.execute.return_value = mock_result\n\n        response = test_client.patch(\n            f\"/api/v1/review/application/{pipeline_id}/approve\"\n        )\n\n        assert response.status_code == 200\n        data = response.json()\n        assert data[\"pipeline_id\"] == str(pipeline_id)\n        assert data[\"status\"] == \"APPROVED\"\n\n    def test_approve_transitions_status_to_approved(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n        pipeline_id: uuid.UUID,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Approving should transition pipeline status from AWAITING_REVIEW to APPROVED.\n\n        This test verifies the pipeline object's status is updated.\n        \"\"\"\n        mock_pipeline = create_mock_pipeline(\n            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n        )\n        mock_result = MagicMock()\n        mock_result.scalar_one_or_none.return_value = mock_pipeline\n        mock_db_session.execute.return_value = mock_result\n\n        response = test_client.patch(\n            f\"/api/v1/review/application/{pipeline_id}/approve\"\n        )\n\n        assert response.status_code == 200\n        # Verify the pipeline status was updated\n        assert mock_pipeline.status == \"APPROVED\"\n        # Verify commit was called\n        mock_db_session.commit.assert_called()\n\n    def test_approve_calls_crm_log(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n        pipeline_id: uuid.UUID,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Approving should log a CRM event for audit trail.\n\n        Contract: HYPHA-TESTS.md § tests-agent.api.review\n        \"Asserts application_events row written\" (maps to crm_events table)\n        \"\"\"\n        mock_pipeline = create_mock_pipeline(\n            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n        )\n        mock_result = MagicMock()\n        mock_result.scalar_one_or_none.return_value = mock_pipeline\n        mock_db_session.execute.return_value = mock_result\n\n        # Patch CRM to verify it's called\n        with patch(\"backend.api.review.CRM\") as MockCRM:\n            mock_crm_instance = AsyncMock()\n            MockCRM.return_value = mock_crm_instance\n\n            response = test_client.patch(\n                f\"/api/v1/review/application/{pipeline_id}/approve\"\n            )\n\n            assert response.status_code == 200\n\n            # Verify CRM.log was called with correct event type\n            mock_crm_instance.log.assert_called_once()\n            call_args = mock_crm_instance.log.call_args\n            assert call_args.args[0] == pipeline_id  # pipeline_id\n            assert call_args.args[1] == candidate_id  # candidate_id\n            assert call_args.args[2] == job_id  # job_id\n            assert call_args.args[3] == \"APPROVED_FOR_SUBMISSION\"  # event_type\n\n    def test_approve_nonexistent_pipeline_returns_404(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n    ):\n        \"\"\"\n        Approving a non-existent pipeline should return 404.\n\n        Contract: NUTRIENTS.md § API_CONTRACTS\n        \"Error responses: 404: 'Pipeline not found'\"\n        \"\"\"\n        fake_pipeline_id = uuid.uuid4()\n\n        # Setup: mock pipeline lookup returns None\n        mock_result = MagicMock()\n        mock_result.scalar_one_or_none.return_value = None\n        mock_db_session.execute.return_value = mock_result\n\n        response = test_client.patch(\n            f\"/api/v1/review/application/{fake_pipeline_id}/approve\"\n        )\n\n        assert response.status_code == 404\n        assert \"not found\" in response.json().get(\"detail\", \"\").lower()\n\n    def test_approve_queued_pipeline_returns_422(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n        pipeline_id: uuid.UUID,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Approving a pipeline not in AWAITING_REVIEW status should return 422.\n\n        Contract: NUTRIENTS.md § API_CONTRACTS\n        \"Error responses: 400: 'Pipeline is not awaiting review'\"\n        \"\"\"\n        # Pipeline is in QUEUED status, not AWAITING_REVIEW\n        mock_pipeline = create_mock_pipeline(\n            pipeline_id, candidate_id, job_id, status=\"QUEUED\"\n        )\n        mock_result = MagicMock()\n        mock_result.scalar_one_or_none.return_value = mock_pipeline\n        mock_db_session.execute.return_value = mock_result\n\n        response = test_client.patch(\n            f\"/api/v1/review/application/{pipeline_id}/approve\"\n        )\n\n        assert response.status_code == 422\n        detail = response.json().get(\"detail\", \"\")\n        assert \"not awaiting review\" in detail.lower() or \"QUEUED\" in detail\n\n    def test_approve_already_approved_pipeline_returns_422(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n        pipeline_id: uuid.UUID,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Re-approving an already APPROVED pipeline should return 422.\n\n        Idempotency check — prevents double-approvals.\n        \"\"\"\n        mock_pipeline = create_mock_pipeline(\n            pipeline_id, candidate_id, job_id, status=\"APPROVED\"\n        )\n        mock_result = MagicMock()\n        mock_result.scalar_one_or_none.return_value = mock_pipeline\n        mock_db_session.execute.return_value = mock_result\n\n        response = test_client.patch(\n            f\"/api/v1/review/application/{pipeline_id}/approve\"\n        )\n\n        assert response.status_code == 422\n        detail = response.json().get(\"detail\", \"\")\n        assert \"APPROVED\" in detail or \"not awaiting review\" in detail.lower()\n\n    @pytest.mark.asyncio\n    async def test_approve_publishes_to_redis(\n        self,\n        app_with_mocks: FastAPI,\n        mock_db_session: AsyncMock,\n        fake_redis,\n        pipeline_id: uuid.UUID,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Approving should publish an event to Redis for the orchestrator.\n\n        The approve endpoint publishes to 'application.approved' channel.\n        \"\"\"\n        mock_pipeline = create_mock_pipeline(\n            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n        )\n        mock_result = MagicMock()\n        mock_result.scalar_one_or_none.return_value = mock_pipeline\n        mock_db_session.execute.return_value = mock_result\n\n        # Subscribe to the channel before approval\n        pubsub = fake_redis.pubsub()\n        await pubsub.subscribe(\"application.approved\")\n\n        with TestClient(app_with_mocks) as client:\n            with patch(\"backend.api.review.CRM\") as MockCRM:\n                MockCRM.return_value = AsyncMock()\n                response = client.patch(\n                    f\"/api/v1/review/application/{pipeline_id}/approve\"\n                )\n                assert response.status_code == 200\n\n        # Check that message was published\n        message = await pubsub.get_message(ignore_subscribe_messages=True, timeout=1.0)\n        assert message is not None, \"Expected a message to be published to Redis\"\n        payload = json.loads(message[\"data\"])\n        assert payload[\"pipeline_id\"] == str(pipeline_id)\n        assert payload[\"candidate_id\"] == str(candidate_id)\n\n        await pubsub.unsubscribe(\"application.approved\")\n\n\n# ─── Reject Endpoint Tests ────────────────────────────────────────────────────\n\n\nclass TestRejectApplication:\n    \"\"\"Test PATCH /api/v1/review/application/{pipeline_id}/reject endpoint.\"\"\"\n\n    def test_reject_awaiting_review_pipeline_succeeds(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n        pipeline_id: uuid.UUID,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Rejecting a pipeline should succeed.\n\n        Asserts:\n          - Response status 200\n          - Response contains pipeline_id and status='REJECTED'\n        \"\"\"\n        mock_pipeline = create_mock_pipeline(\n            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n        )\n        mock_result = MagicMock()\n        mock_result.scalar_one_or_none.return_value = mock_pipeline\n        mock_db_session.execute.return_value = mock_result\n\n        response = test_client.patch(\n            f\"/api/v1/review/application/{pipeline_id}/reject\"\n        )\n\n        assert response.status_code == 200\n        data = response.json()\n        assert data[\"pipeline_id\"] == str(pipeline_id)\n        assert data[\"status\"] == \"REJECTED\"\n\n    def test_reject_transitions_status_to_rejected(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n        pipeline_id: uuid.UUID,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Rejecting should transition pipeline status to REJECTED.\n        \"\"\"\n        mock_pipeline = create_mock_pipeline(\n            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n        )\n        mock_result = MagicMock()\n        mock_result.scalar_one_or_none.return_value = mock_pipeline\n        mock_db_session.execute.return_value = mock_result\n\n        response = test_client.patch(\n            f\"/api/v1/review/application/{pipeline_id}/reject\"\n        )\n\n        assert response.status_code == 200\n        assert mock_pipeline.status == \"REJECTED\"\n        mock_db_session.commit.assert_called()\n\n    def test_reject_calls_crm_log(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n        pipeline_id: uuid.UUID,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Rejecting should log a CRM event for audit trail.\n        \"\"\"\n        mock_pipeline = create_mock_pipeline(\n            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n        )\n        mock_result = MagicMock()\n        mock_result.scalar_one_or_none.return_value = mock_pipeline\n        mock_db_session.execute.return_value = mock_result\n\n        with patch(\"backend.api.review.CRM\") as MockCRM:\n            mock_crm_instance = AsyncMock()\n            MockCRM.return_value = mock_crm_instance\n\n            response = test_client.patch(\n                f\"/api/v1/review/application/{pipeline_id}/reject\"\n            )\n\n            assert response.status_code == 200\n            mock_crm_instance.log.assert_called_once()\n            call_args = mock_crm_instance.log.call_args\n            assert call_args.args[3] == \"REJECTED\"  # event_type\n\n    def test_reject_nonexistent_pipeline_returns_404(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n    ):\n        \"\"\"\n        Rejecting a non-existent pipeline should return 404.\n        \"\"\"\n        fake_pipeline_id = uuid.uuid4()\n        mock_result = MagicMock()\n        mock_result.scalar_one_or_none.return_value = None\n        mock_db_session.execute.return_value = mock_result\n\n        response = test_client.patch(\n            f\"/api/v1/review/application/{fake_pipeline_id}/reject\"\n        )\n\n        assert response.status_code == 404\n        assert \"not found\" in response.json().get(\"detail\", \"\").lower()\n\n\n# ─── Review Queue Tests ───────────────────────────────────────────────────────\n\n\nclass TestReviewQueue:\n    \"\"\"Test GET /api/v1/review/queue endpoint.\"\"\"\n\n    def test_queue_returns_awaiting_review_pipelines(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n        pipeline_id: uuid.UUID,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Review queue should return pipelines with status AWAITING_REVIEW.\n        \"\"\"\n        mock_pipeline = create_mock_pipeline(\n            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n        )\n        mock_result = MagicMock()\n        mock_result.scalars.return_value.all.return_value = [mock_pipeline]\n        mock_db_session.execute.return_value = mock_result\n\n        response = test_client.get(\"/api/v1/review/queue\")\n\n        assert response.status_code == 200\n        data = response.json()\n        assert isinstance(data, list)\n        assert len(data) == 1\n        assert data[0][\"pipeline_id\"] == str(pipeline_id)\n        assert data[0][\"status\"] == \"AWAITING_REVIEW\"\n\n    def test_queue_returns_empty_when_no_awaiting_review(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n    ):\n        \"\"\"\n        Review queue should return empty list when no pipelines are awaiting review.\n        \"\"\"\n        mock_result = MagicMock()\n        mock_result.scalars.return_value.all.return_value = []\n        mock_db_session.execute.return_value = mock_result\n\n        response = test_client.get(\"/api/v1/review/queue\")\n\n        assert response.status_code == 200\n        data = response.json()\n        assert data == []\n\n    def test_queue_returns_multiple_pipelines(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Review queue should return all pipelines awaiting review.\n        \"\"\"\n        pipeline1 = create_mock_pipeline(\n            uuid.uuid4(), candidate_id, job_id, status=\"AWAITING_REVIEW\"\n        )\n        pipeline2 = create_mock_pipeline(\n            uuid.uuid4(), candidate_id, job_id, status=\"AWAITING_REVIEW\"\n        )\n        mock_result = MagicMock()\n        mock_result.scalars.return_value.all.return_value = [pipeline1, pipeline2]\n        mock_db_session.execute.return_value = mock_result\n\n        response = test_client.get(\"/api/v1/review/queue\")\n\n        assert response.status_code == 200\n        data = response.json()\n        assert len(data) == 2\n\n\n# ─── Full Integration Flow Tests ──────────────────────────────────────────────\n\n\nclass TestFullApprovalFlow:\n    \"\"\"\n    Integration tests for the complete approval workflow.\n\n    Contract: HYPHA-TESTS.md\n    \"full integration: create application → approve → verify state transition\"\n    \"\"\"\n\n    def test_full_flow_approve_verify_transition(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n        pipeline_id: uuid.UUID,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Full integration test: approve → verify transition → verify CRM event.\n\n        Steps:\n          1. Mock a pipeline in AWAITING_REVIEW state\n          2. POST to approve endpoint\n          3. Verify pipeline status is now APPROVED\n          4. Verify CRM event was logged\n        \"\"\"\n        mock_pipeline = create_mock_pipeline(\n            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n        )\n        mock_result = MagicMock()\n        mock_result.scalar_one_or_none.return_value = mock_pipeline\n        mock_db_session.execute.return_value = mock_result\n\n        with patch(\"backend.api.review.CRM\") as MockCRM:\n            mock_crm_instance = AsyncMock()\n            MockCRM.return_value = mock_crm_instance\n\n            response = test_client.patch(\n                f\"/api/v1/review/application/{pipeline_id}/approve\"\n            )\n\n            # Verify response\n            assert response.status_code == 200\n            assert response.json()[\"status\"] == \"APPROVED\"\n\n            # Verify pipeline status was updated\n            assert mock_pipeline.status == \"APPROVED\"\n\n            # Verify CRM event was logged\n            mock_crm_instance.log.assert_called_once()\n            assert mock_crm_instance.log.call_args.args[3] == \"APPROVED_FOR_SUBMISSION\"\n\n    def test_approval_is_idempotent_check(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n        pipeline_id: uuid.UUID,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Once approved, re-approval should fail with 422.\n\n        This ensures the state machine is respected.\n        \"\"\"\n        # First call: pipeline is AWAITING_REVIEW\n        mock_pipeline = create_mock_pipeline(\n            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n        )\n        mock_result = MagicMock()\n        mock_result.scalar_one_or_none.return_value = mock_pipeline\n        mock_db_session.execute.return_value = mock_result\n\n        with patch(\"backend.api.review.CRM\") as MockCRM:\n            MockCRM.return_value = AsyncMock()\n            response1 = test_client.patch(\n                f\"/api/v1/review/application/{pipeline_id}/approve\"\n            )\n            assert response1.status_code == 200\n            assert response1.json()[\"status\"] == \"APPROVED\"\n\n        # After first approval, pipeline is now APPROVED\n        # Second call should fail because status is APPROVED\n        assert mock_pipeline.status == \"APPROVED\"\n\n        # Reset mock to simulate second call with updated status\n        mock_result.scalar_one_or_none.return_value = mock_pipeline\n\n        response2 = test_client.patch(\n            f\"/api/v1/review/application/{pipeline_id}/approve\"\n        )\n        assert response2.status_code == 422\n\n    def test_reject_after_queue_check(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n        pipeline_id: uuid.UUID,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Reject flow: pipeline appears in queue, then reject, then verify.\n        \"\"\"\n        mock_pipeline = create_mock_pipeline(\n            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n        )\n\n        # First: queue returns the pipeline\n        mock_queue_result = MagicMock()\n        mock_queue_result.scalars.return_value.all.return_value = [mock_pipeline]\n\n        # Then: reject lookup and reject\n        mock_single_result = MagicMock()\n        mock_single_result.scalar_one_or_none.return_value = mock_pipeline\n\n        # Configure mock to return appropriate result based on call\n        call_count = [0]\n\n        def execute_side_effect(*args, **kwargs):\n            call_count[0] += 1\n            if call_count[0] == 1:\n                return mock_queue_result\n            return mock_single_result\n\n        mock_db_session.execute.side_effect = execute_side_effect\n\n        # Check queue\n        queue_response = test_client.get(\"/api/v1/review/queue\")\n        assert queue_response.status_code == 200\n        assert len(queue_response.json()) == 1\n\n        # Reject\n        with patch(\"backend.api.review.CRM\") as MockCRM:\n            MockCRM.return_value = AsyncMock()\n            reject_response = test_client.patch(\n                f\"/api/v1/review/application/{pipeline_id}/reject\"\n            )\n\n        assert reject_response.status_code == 200\n        assert reject_response.json()[\"status\"] == \"REJECTED\"\n        assert mock_pipeline.status == \"REJECTED\"\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2185,"cache_read_input_tokens":113522,"cache_creation":{"ephemeral_5m_input_tokens":2185,"ephemeral_1h_input_tokens":0},"output_tokens":7295,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"e1a6c245-4572-4816-9d85-5634565bd455","uuid":"dd74cf4a-68a3-4c79-9bc9-0707ef33e5da"}}
{"t":"2026-05-28T03:06:31.296Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018cv1st3fSqeQmatFgP1hMJ","type":"tool_result","content":"The file /Users/spy/mfautomations/repos/creation-station/reverse-search/tests/api/test_review_approve.py has been updated. Here's the result of running `cat -n` on a snippet of the edited file:\n     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Review Dashboard Approve Flow integration tests.\n     6→\n     7→Full end-to-end tests for the application approval workflow:\n     8→  - Create application pipeline → approve → verify state transition\n     9→  - CRM event logging on approval\n    10→  - Error handling for non-existent and invalid-status pipelines\n    11→\n    12→Contract:\n    13→  - HYPHA-TESTS.md § tests-agent.api.review\n    14→  - NUTRIENTS.md § API_CONTRACTS review endpoints\n    15→  - HYPHA-REVIEW-DASHBOARD.md acceptance criteria\n    16→\n    17→Coverage:\n    18→  - Create application row in test database\n    19→  - PATCH approve, assert state transition to APPROVED\n    20→  - Verify crm_events row written on approval\n    21→  - 404 on non-existent pipeline\n    22→  - 422 on approving non-AWAITING_REVIEW pipeline\n    23→  - PATCH reject, assert state transition to REJECTED\n    24→\n    25→NOTE: Uses mocked database operations because the ORM models use PostgreSQL-\n    26→specific types (ARRAY, JSONB) that are incompatible with SQLite testing.\n    27→\"\"\"\n    28→\n    29→from __future__ import annotations\n    30→\n    31→import json\n    32→import uuid\n    33→from datetime import datetime, timedelta, timezone\n    34→from typing import Generator, Any\n    35→from unittest.mock import AsyncMock, MagicMock, patch\n    36→\n    37→import fakeredis.aioredis\n    38→import jwt\n    39→import pytest\n    40→from fastapi import FastAPI\n    41→from fastapi.testclient import TestClient\n    42→\n    43→from backend.config import settings\n    44→from backend.database import get_db, get_redis, set_redis_client\n    45→\n    46→\n    47→# ─── Mock ORM Objects ────────────────────────────────────────────────────────\n    48→\n    49→\n    50→def create_mock_pipeline(\n    51→    pipeline_id: uuid.UUID,\n    52→    candidate_id: uuid.UUID,\n    53→    job_id: uuid.UUID,\n    54→    status: str = \"AWAITING_REVIEW\",\n    55→    current_step: str = \"compose\",\n    56→) -> MagicMock:\n    57→    \"\"\"Create a mock ApplicationPipeline ORM object.\"\"\"\n    58→    mock = MagicMock()\n    59→    mock.id = pipeline_id\n    60→    mock.candidate_id = candidate_id\n    61→    mock.job_id = job_id\n    62→    mock.status = status\n    63→    mock.current_step = current_step\n    64→    mock.created_at = datetime.now(timezone.utc)\n    65→    mock.updated_at = datetime.now(timezone.utc)\n    66→    mock.resume_id = None\n    67→    mock.email_id = None\n    68→    mock.approval_timestamp = None\n    69→    return mock\n    70→\n    71→\n    72→def create_mock_crm_event(\n    73→    pipeline_id: uuid.UUID,\n    74→    candidate_id: uuid.UUID,\n    75→    job_id: uuid.UUID,\n    76→    event_type: str,\n    77→) -> MagicMock:\n    78→    \"\"\"Create a mock CRMEvent ORM object.\"\"\"\n    79→    mock = MagicMock()\n    80→    mock.id = uuid.uuid4()\n    81→    mock.pipeline_id = pipeline_id\n    82→    mock.candidate_id = candidate_id\n    83→    mock.job_id = job_id\n    84→    mock.event_type = event_type\n    85→    mock.details = None\n    86→    mock.payload = {}\n    87→    mock.created_at = datetime.now(timezone.utc)\n    88→    return mock\n    89→\n    90→\n    91→# ─── Fixtures ────────────────────────────────────────────────────────────────\n    92→\n    93→\n    94→@pytest.fixture\n    95→def pipeline_id() -> uuid.UUID:\n    96→    \"\"\"Generate a test pipeline ID.\"\"\"\n    97→    return uuid.uuid4()\n    98→\n    99→\n   100→@pytest.fixture\n   101→def candidate_id() -> uuid.UUID:\n   102→    \"\"\"Generate a test candidate ID.\"\"\"\n   103→    return uuid.uuid4()\n   104→\n   105→\n   106→@pytest.fixture\n   107→def job_id() -> uuid.UUID:\n   108→    \"\"\"Generate a test job ID.\"\"\"\n   109→    return uuid.uuid4()\n   110→\n   111→\n   112→@pytest.fixture\n   113→def fake_redis():\n   114→    \"\"\"Create a fake Redis client for testing.\"\"\"\n   115→    return fakeredis.aioredis.FakeRedis(decode_responses=True)\n   116→\n   117→\n   118→@pytest.fixture\n   119→def valid_jwt() -> str:\n   120→    \"\"\"Generate a valid JWT for testing.\"\"\"\n   121→    user_id = uuid.uuid4()\n   122→    payload = {\n   123→        \"sub\": str(user_id),\n   124→        \"email\": \"reviewer@example.com\",\n   125→        \"iat\": datetime.now(timezone.utc),\n   126→        \"exp\": datetime.now(timezone.utc) + timedelta(days=1),\n   127→    }\n   128→    return jwt.encode(payload, settings.jwt_secret, algorithm=\"HS256\")\n   129→\n   130→\n   131→@pytest.fixture\n   132→def mock_db_session():\n   133→    \"\"\"Create a mock async database session.\"\"\"\n   134→    session = AsyncMock()\n   135→    session.execute = AsyncMock()\n   136→    session.commit = AsyncMock()\n   137→    session.add = MagicMock()\n   138→    session.refresh = AsyncMock()\n   139→    return session\n   140→\n   141→\n   142→@pytest.fixture\n   143→def app_with_mocks(mock_db_session, fake_redis) -> FastAPI:\n   144→    \"\"\"Create a FastAPI app with mocked dependencies.\"\"\"\n   145→    from backend.main import app\n   146→\n   147→    # Override dependencies with mocks\n   148→    app.dependency_overrides[get_db] = lambda: mock_db_session\n   149→    app.dependency_overrides[get_redis] = lambda: fake_redis\n   150→\n   151→    # Set the fake Redis as the global client\n   152→    set_redis_client(fake_redis)\n   153→\n   154→    yield app\n   155→\n   156→    # Clean up overrides\n   157→    app.dependency_overrides.clear()\n   158→\n   159→\n   160→@pytest.fixture\n   161→def test_client(app_with_mocks: FastAPI) -> Generator[TestClient, None, None]:\n   162→    \"\"\"Create a TestClient for the app.\"\"\"\n   163→    with TestClient(app_with_mocks) as client:\n   164→        yield client\n   165→\n   166→\n   167→# ─── Approve Endpoint Tests ───────────────────────────────────────────────────\n   168→\n   169→\n   170→class TestApproveApplication:\n   171→    \"\"\"Test PATCH /api/v1/review/application/{pipeline_id}/approve endpoint.\"\"\"\n   172→\n   173→    def test_approve_awaiting_review_pipeline_succeeds(\n   174→        self,\n   175→        test_client: TestClient,\n   176→        mock_db_session: AsyncMock,\n   177→        pipeline_id: uuid.UUID,\n   178→        candidate_id: uuid.UUID,\n   179→        job_id: uuid.UUID,\n   180→    ):\n   181→        \"\"\"\n   182→        Approving a pipeline in AWAITING_REVIEW status should succeed.\n   183→\n   184→        Asserts:\n   185→          - Response status 200\n   186→          - Response contains pipeline_id and status='APPROVED'\n   187→        \"\"\"\n   188→        # Setup: mock pipeline lookup returns a pipeline in AWAITING_REVIEW\n   189→        mock_pipeline = create_mock_pipeline(\n   190→            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n   191→        )\n   192→        mock_result = MagicMock()\n   193→        mock_result.scalar_one_or_none.return_value = mock_pipeline\n   194→        mock_db_session.execute.return_value = mock_result\n   195→\n   196→        response = test_client.patch(\n   197→            f\"/api/v1/review/application/{pipeline_id}/approve\"\n   198→        )\n   199→\n   200→        assert response.status_code == 200\n   201→        data = response.json()\n   202→        assert data[\"pipeline_id\"] == str(pipeline_id)\n   203→        assert data[\"status\"] == \"APPROVED\"\n   204→\n   205→    def test_approve_transitions_status_to_approved(\n   206→        self,\n   207→        test_client: TestClient,\n   208→        mock_db_session: AsyncMock,\n   209→        pipeline_id: uuid.UUID,\n   210→        candidate_id: uuid.UUID,\n   211→        job_id: uuid.UUID,\n   212→    ):\n   213→        \"\"\"\n   214→        Approving should transition pipeline status from AWAITING_REVIEW to APPROVED.\n   215→\n   216→        This test verifies the pipeline object's status is updated.\n   217→        \"\"\"\n   218→        mock_pipeline = create_mock_pipeline(\n   219→            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n   220→        )\n   221→        mock_result = MagicMock()\n   222→        mock_result.scalar_one_or_none.return_value = mock_pipeline\n   223→        mock_db_session.execute.return_value = mock_result\n   224→\n   225→        response = test_client.patch(\n   226→            f\"/api/v1/review/application/{pipeline_id}/approve\"\n   227→        )\n   228→\n   229→        assert response.status_code == 200\n   230→        # Verify the pipeline status was updated\n   231→        assert mock_pipeline.status == \"APPROVED\"\n   232→        # Verify commit was called\n   233→        mock_db_session.commit.assert_called()\n   234→\n   235→    def test_approve_calls_crm_log(\n   236→        self,\n   237→        test_client: TestClient,\n   238→        mock_db_session: AsyncMock,\n   239→        pipeline_id: uuid.UUID,\n   240→        candidate_id: uuid.UUID,\n   241→        job_id: uuid.UUID,\n   242→    ):\n   243→        \"\"\"\n   244→        Approving should log a CRM event for audit trail.\n   245→\n   246→        Contract: HYPHA-TESTS.md § tests-agent.api.review\n   247→        \"Asserts application_events row written\" (maps to crm_events table)\n   248→        \"\"\"\n   249→        mock_pipeline = create_mock_pipeline(\n   250→            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n   251→        )\n   252→        mock_result = MagicMock()\n   253→        mock_result.scalar_one_or_none.return_value = mock_pipeline\n   254→        mock_db_session.execute.return_value = mock_result\n   255→\n   256→        # Patch CRM to verify it's called\n   257→        with patch(\"backend.api.review.CRM\") as MockCRM:\n   258→            mock_crm_instance = AsyncMock()\n   259→            MockCRM.return_value = mock_crm_instance\n   260→\n   261→            response = test_client.patch(\n   262→                f\"/api/v1/review/application/{pipeline_id}/approve\"\n   263→            )\n   264→\n   265→            assert response.status_code == 200\n   266→\n   267→            # Verify CRM.log was called with correct event type\n   268→            mock_crm_instance.log.assert_called_once()\n   269→            call_args = mock_crm_instance.log.call_args\n   270→            assert call_args.args[0] == pipeline_id  # pipeline_id\n   271→            assert call_args.args[1] == candidate_id  # candidate_id\n   272→            assert call_args.args[2] == job_id  # job_id\n   273→            assert call_args.args[3] == \"APPROVED_FOR_SUBMISSION\"  # event_type\n   274→\n   275→    def test_approve_nonexistent_pipeline_returns_404(\n   276→        self,\n   277→        test_client: TestClient,\n   278→        mock_db_session: AsyncMock,\n   279→    ):\n   280→        \"\"\"\n   281→        Approving a non-existent pipeline should return 404.\n   282→\n   283→        Contract: NUTRIENTS.md § API_CONTRACTS\n   284→        \"Error responses: 404: 'Pipeline not found'\"\n   285→        \"\"\"\n   286→        fake_pipeline_id = uuid.uuid4()\n   287→\n   288→        # Setup: mock pipeline lookup returns None\n   289→        mock_result = MagicMock()\n   290→        mock_result.scalar_one_or_none.return_value = None\n   291→        mock_db_session.execute.return_value = mock_result\n   292→\n   293→        response = test_client.patch(\n   294→            f\"/api/v1/review/application/{fake_pipeline_id}/approve\"\n   295→        )\n   296→\n   297→        assert response.status_code == 404\n   298→        assert \"not found\" in response.json().get(\"detail\", \"\").lower()\n   299→\n   300→    def test_approve_queued_pipeline_returns_422(\n   301→        self,\n   302→        test_client: TestClient,\n   303→        mock_db_session: AsyncMock,\n   304→        pipeline_id: uuid.UUID,\n   305→        candidate_id: uuid.UUID,\n   306→        job_id: uuid.UUID,\n   307→    ):\n   308→        \"\"\"\n   309→        Approving a pipeline not in AWAITING_REVIEW status should return 422.\n   310→\n   311→        Contract: NUTRIENTS.md § API_CONTRACTS\n   312→        \"Error responses: 400: 'Pipeline is not awaiting review'\"\n   313→        \"\"\"\n   314→        # Pipeline is in QUEUED status, not AWAITING_REVIEW\n   315→        mock_pipeline = create_mock_pipeline(\n   316→            pipeline_id, candidate_id, job_id, status=\"QUEUED\"\n   317→        )\n   318→        mock_result = MagicMock()\n   319→        mock_result.scalar_one_or_none.return_value = mock_pipeline\n   320→        mock_db_session.execute.return_value = mock_result\n   321→\n   322→        response = test_client.patch(\n   323→            f\"/api/v1/review/application/{pipeline_id}/approve\"\n   324→        )\n   325→\n   326→        assert response.status_code == 422\n   327→        detail = response.json().get(\"detail\", \"\")\n   328→        assert \"not awaiting review\" in detail.lower() or \"QUEUED\" in detail\n   329→\n   330→    def test_approve_already_approved_pipeline_returns_422(\n   331→        self,\n   332→        test_client: TestClient,\n   333→        mock_db_session: AsyncMock,\n   334→        pipeline_id: uuid.UUID,\n   335→        candidate_id: uuid.UUID,\n   336→        job_id: uuid.UUID,\n   337→    ):\n   338→        \"\"\"\n   339→        Re-approving an already APPROVED pipeline should return 422.\n   340→\n   341→        Idempotency check — prevents double-approvals.\n   342→        \"\"\"\n   343→        mock_pipeline = create_mock_pipeline(\n   344→            pipeline_id, candidate_id, job_id, status=\"APPROVED\"\n   345→        )\n   346→        mock_result = MagicMock()\n   347→        mock_result.scalar_one_or_none.return_value = mock_pipeline\n   348→        mock_db_session.execute.return_value = mock_result\n   349→\n   350→        response = test_client.patch(\n   351→            f\"/api/v1/review/application/{pipeline_id}/approve\"\n   352→        )\n   353→\n   354→        assert response.status_code == 422\n   355→        detail = response.json().get(\"detail\", \"\")\n   356→        assert \"APPROVED\" in detail or \"not awaiting review\" in detail.lower()\n   357→\n   358→    @pytest.mark.asyncio\n   359→    async def test_approve_publishes_to_redis(\n   360→        self,\n   361→        app_with_mocks: FastAPI,\n   362→        mock_db_session: AsyncMock,\n   363→        fake_redis,\n   364→        pipeline_id: uuid.UUID,\n   365→        candidate_id: uuid.UUID,\n   366→        job_id: uuid.UUID,\n   367→    ):\n   368→        \"\"\"\n   369→        Approving should publish an event to Redis for the orchestrator.\n   370→\n   371→        The approve endpoint publishes to 'application.approved' channel.\n   372→        \"\"\"\n   373→        mock_pipeline = create_mock_pipeline(\n   374→            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n   375→        )\n   376→        mock_result = MagicMock()\n   377→        mock_result.scalar_one_or_none.return_value = mock_pipeline\n   378→        mock_db_session.execute.return_value = mock_result\n   379→\n   380→        # Subscribe to the channel before approval\n   381→        pubsub = fake_redis.pubsub()\n   382→        await pubsub.subscribe(\"application.approved\")\n   383→\n   384→        with TestClient(app_with_mocks) as client:\n   385→            with patch(\"backend.api.review.CRM\") as MockCRM:\n   386→                MockCRM.return_value = AsyncMock()\n   387→                response = client.patch(\n   388→                    f\"/api/v1/review/application/{pipeline_id}/approve\"\n   389→                )\n   390→                assert response.status_code == 200\n   391→\n   392→        # Check that message was published\n   393→        message = await pubsub.get_message(ignore_subscribe_messages=True, timeout=1.0)\n   394→        assert message is not None, \"Expected a message to be published to Redis\"\n   395→        payload = json.loads(message[\"data\"])\n   396→        assert payload[\"pipeline_id\"] == str(pipeline_id)\n   397→        assert payload[\"candidate_id\"] == str(candidate_id)\n   398→\n   399→        await pubsub.unsubscribe(\"application.approved\")\n   400→\n   401→\n   402→# ─── Reject Endpoint Tests ────────────────────────────────────────────────────\n   403→\n   404→\n   405→class TestRejectApplication:\n   406→    \"\"\"Test PATCH /api/v1/review/application/{pipeline_id}/reject endpoint.\"\"\"\n   407→\n   408→    def test_reject_awaiting_review_pipeline_succeeds(\n   409→        self,\n   410→        test_client: TestClient,\n   411→        mock_db_session: AsyncMock,\n   412→        pipeline_id: uuid.UUID,\n   413→        candidate_id: uuid.UUID,\n   414→        job_id: uuid.UUID,\n   415→    ):\n   416→        \"\"\"\n   417→        Rejecting a pipeline should succeed.\n   418→\n   419→        Asserts:\n   420→          - Response status 200\n   421→          - Response contains pipeline_id and status='REJECTED'\n   422→        \"\"\"\n   423→        mock_pipeline = create_mock_pipeline(\n   424→            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n   425→        )\n   426→        mock_result = MagicMock()\n   427→        mock_result.scalar_one_or_none.return_value = mock_pipeline\n   428→        mock_db_session.execute.return_value = mock_result\n   429→\n   430→        response = test_client.patch(\n   431→            f\"/api/v1/review/application/{pipeline_id}/reject\"\n   432→        )\n   433→\n   434→        assert response.status_code == 200\n   435→        data = response.json()\n   436→        assert data[\"pipeline_id\"] == str(pipeline_id)\n   437→        assert data[\"status\"] == \"REJECTED\"\n   438→\n   439→    def test_reject_transitions_status_to_rejected(\n   440→        self,\n   441→        test_client: TestClient,\n   442→        mock_db_session: AsyncMock,\n   443→        pipeline_id: uuid.UUID,\n   444→        candidate_id: uuid.UUID,\n   445→        job_id: uuid.UUID,\n   446→    ):\n   447→        \"\"\"\n   448→        Rejecting should transition pipeline status to REJECTED.\n   449→        \"\"\"\n   450→        mock_pipeline = create_mock_pipeline(\n   451→            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n   452→        )\n   453→        mock_result = MagicMock()\n   454→        mock_result.scalar_one_or_none.return_value = mock_pipeline\n   455→        mock_db_session.execute.return_value = mock_result\n   456→\n   457→        response = test_client.patch(\n   458→            f\"/api/v1/review/application/{pipeline_id}/reject\"\n   459→        )\n   460→\n   461→        assert response.status_code == 200\n   462→        assert mock_pipeline.status == \"REJECTED\"\n   463→        mock_db_session.commit.assert_called()\n   464→\n   465→    def test_reject_calls_crm_log(\n   466→        self,\n   467→        test_client: TestClient,\n   468→        mock_db_session: AsyncMock,\n   469→        pipeline_id: uuid.UUID,\n   470→        candidate_id: uuid.UUID,\n   471→        job_id: uuid.UUID,\n   472→    ):\n   473→        \"\"\"\n   474→        Rejecting should log a CRM event for audit trail.\n   475→        \"\"\"\n   476→        mock_pipeline = create_mock_pipeline(\n   477→            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n   478→        )\n   479→        mock_result = MagicMock()\n   480→        mock_result.scalar_one_or_none.return_value = mock_pipeline\n   481→        mock_db_session.execute.return_value = mock_result\n   482→\n   483→        with patch(\"backend.api.review.CRM\") as MockCRM:\n   484→            mock_crm_instance = AsyncMock()\n   485→            MockCRM.return_value = mock_crm_instance\n   486→\n   487→            response = test_client.patch(\n   488→                f\"/api/v1/review/application/{pipeline_id}/reject\"\n   489→            )\n   490→\n   491→            assert response.status_code == 200\n   492→            mock_crm_instance.log.assert_called_once()\n   493→            call_args = mock_crm_instance.log.call_args\n   494→            assert call_args.args[3] == \"REJECTED\"  # event_type\n   495→\n   496→    def test_reject_nonexistent_pipeline_returns_404(\n   497→        self,\n   498→        test_client: TestClient,\n   499→        mock_db_session: AsyncMock,\n   500→    ):\n   501→        \"\"\"\n   502→        Rejecting a non-existent pipeline should return 404.\n   503→        \"\"\"\n   504→        fake_pipeline_id = uuid.uuid4()\n   505→        mock_result = MagicMock()\n   506→        mock_result.scalar_one_or_none.return_value = None\n   507→        mock_db_session.execute.return_value = mock_result\n   508→\n   509→        response = test_client.patch(\n   510→            f\"/api/v1/review/application/{fake_pipeline_id}/reject\"\n   511→        )\n   512→\n   513→        assert response.status_code == 404\n   514→        assert \"not found\" in response.json().get(\"detail\", \"\").lower()\n   515→\n   516→\n   517→# ─── Review Queue Tests ───────────────────────────────────────────────────────\n   518→\n   519→\n   520→class TestReviewQueue:\n   521→    \"\"\"Test GET /api/v1/review/queue endpoint.\"\"\"\n   522→\n   523→    def test_queue_returns_awaiting_review_pipelines(\n   524→        self,\n   525→        test_client: TestClient,\n   526→        mock_db_session: AsyncMock,\n   527→        pipeline_id: uuid.UUID,\n   528→        candidate_id: uuid.UUID,\n   529→        job_id: uuid.UUID,\n   530→    ):\n   531→        \"\"\"\n   532→        Review queue should return pipelines with status AWAITING_REVIEW.\n   533→        \"\"\"\n   534→        mock_pipeline = create_mock_pipeline(\n   535→            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n   536→        )\n   537→        mock_result = MagicMock()\n   538→        mock_result.scalars.return_value.all.return_value = [mock_pipeline]\n   539→        mock_db_session.execute.return_value = mock_result\n   540→\n   541→        response = test_client.get(\"/api/v1/review/queue\")\n   542→\n   543→        assert response.status_code == 200\n   544→        data = response.json()\n   545→        assert isinstance(data, list)\n   546→        assert len(data) == 1\n   547→        assert data[0][\"pipeline_id\"] == str(pipeline_id)\n   548→        assert data[0][\"status\"] == \"AWAITING_REVIEW\"\n   549→\n   550→    def test_queue_returns_empty_when_no_awaiting_review(\n   551→        self,\n   552→        test_client: TestClient,\n   553→        mock_db_session: AsyncMock,\n   554→    ):\n   555→        \"\"\"\n   556→        Review queue should return empty list when no pipelines are awaiting review.\n   557→        \"\"\"\n   558→        mock_result = MagicMock()\n   559→        mock_result.scalars.return_value.all.return_value = []\n   560→        mock_db_session.execute.return_value = mock_result\n   561→\n   562→        response = test_client.get(\"/api/v1/review/queue\")\n   563→\n   564→        assert response.status_code == 200\n   565→        data = response.json()\n   566→        assert data == []\n   567→\n   568→    def test_queue_returns_multiple_pipelines(\n   569→        self,\n   570→        test_client: TestClient,\n   571→        mock_db_session: AsyncMock,\n   572→        candidate_id: uuid.UUID,\n   573→        job_id: uuid.UUID,\n   574→    ):\n   575→        \"\"\"\n   576→        Review queue should return all pipelines awaiting review.\n   577→        \"\"\"\n   578→        pipeline1 = create_mock_pipeline(\n   579→            uuid.uuid4(), candidate_id, job_id, status=\"AWAITING_REVIEW\"\n   580→        )\n   581→        pipeline2 = create_mock_pipeline(\n   582→            uuid.uuid4(), candidate_id, job_id, status=\"AWAITING_REVIEW\"\n   583→        )\n   584→        mock_result = MagicMock()\n   585→        mock_result.scalars.return_value.all.return_value = [pipeline1, pipeline2]\n   586→        mock_db_session.execute.return_value = mock_result\n   587→\n   588→        response = test_client.get(\"/api/v1/review/queue\")\n   589→\n   590→        assert response.status_code == 200\n   591→        data = response.json()\n   592→        assert len(data) == 2\n   593→\n   594→\n   595→# ─── Full Integration Flow Tests ──────────────────────────────────────────────\n   596→\n   597→\n   598→class TestFullApprovalFlow:\n   599→    \"\"\"\n   600→    Integration tests for the complete approval workflow.\n   601→\n   602→    Contract: HYPHA-TESTS.md\n   603→    \"full integration: create application → approve → verify state transition\"\n   604→    \"\"\"\n   605→\n   606→    def test_full_flow_approve_verify_transition(\n   607→        self,\n   608→        test_client: TestClient,\n   609→        mock_db_session: AsyncMock,\n   610→        pipeline_id: uuid.UUID,\n   611→        candidate_id: uuid.UUID,\n   612→        job_id: uuid.UUID,\n   613→    ):\n   614→        \"\"\"\n   615→        Full integration test: approve → verify transition → verify CRM event.\n   616→\n   617→        Steps:\n   618→          1. Mock a pipeline in AWAITING_REVIEW state\n   619→          2. POST to approve endpoint\n   620→          3. Verify pipeline status is now APPROVED\n   621→          4. Verify CRM event was logged\n   622→        \"\"\"\n   623→        mock_pipeline = create_mock_pipeline(\n   624→            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n   625→        )\n   626→        mock_result = MagicMock()\n   627→        mock_result.scalar_one_or_none.return_value = mock_pipeline\n   628→        mock_db_session.execute.return_value = mock_result\n   629→\n   630→        with patch(\"backend.api.review.CRM\") as MockCRM:\n   631→            mock_crm_instance = AsyncMock()\n   632→            MockCRM.return_value = mock_crm_instance\n   633→\n   634→            response = test_client.patch(\n   635→                f\"/api/v1/review/application/{pipeline_id}/approve\"\n   636→            )\n   637→\n   638→            # Verify response\n   639→            assert response.status_code == 200\n   640→            assert response.json()[\"status\"] == \"APPROVED\"\n   641→\n   642→            # Verify pipeline status was updated\n   643→            assert mock_pipeline.status == \"APPROVED\"\n   644→\n   645→            # Verify CRM event was logged\n   646→            mock_crm_instance.log.assert_called_once()\n   647→            assert mock_crm_instance.log.call_args.args[3] == \"APPROVED_FOR_SUBMISSION\"\n   648→\n   649→    def test_approval_is_idempotent_check(\n   650→        self,\n   651→        test_client: TestClient,\n   652→        mock_db_session: AsyncMock,\n   653→        pipeline_id: uuid.UUID,\n   654→        candidate_id: uuid.UUID,\n   655→        job_id: uuid.UUID,\n   656→    ):\n   657→        \"\"\"\n   658→        Once approved, re-approval should fail with 422.\n   659→\n   660→        This ensures the state machine is respected.\n   661→        \"\"\"\n   662→        # First call: pipeline is AWAITING_REVIEW\n   663→        mock_pipeline = create_mock_pipeline(\n   664→            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n   665→        )\n   666→        mock_result = MagicMock()\n   667→        mock_result.scalar_one_or_none.return_value = mock_pipeline\n   668→        mock_db_session.execute.return_value = mock_result\n   669→\n   670→        with patch(\"backend.api.review.CRM\") as MockCRM:\n   671→            MockCRM.return_value = AsyncMock()\n   672→            response1 = test_client.patch(\n   673→                f\"/api/v1/review/application/{pipeline_id}/approve\"\n   674→            )\n   675→            assert response1.status_code == 200\n   676→            assert response1.json()[\"status\"] == \"APPROVED\"\n   677→\n   678→        # After first approval, pipeline is now APPROVED\n   679→        # Second call should fail because status is APPROVED\n   680→        assert mock_pipeline.status == \"APPROVED\"\n   681→\n   682→        # Reset mock to simulate second call with updated status\n   683→        mock_result.scalar_one_or_none.return_value = mock_pipeline\n   684→\n   685→        response2 = test_client.patch(\n   686→            f\"/api/v1/review/application/{pipeline_id}/approve\"\n   687→        )\n   688→        assert response2.status_code == 422\n   689→\n   690→    def test_reject_after_queue_check(\n   691→        self,\n   692→        test_client: TestClient,\n   693→        mock_db_session: AsyncMock,\n   694→        pipeline_id: uuid.UUID,\n   695→        candidate_id: uuid.UUID,\n   696→        job_id: uuid.UUID,\n   697→    ):\n   698→        \"\"\"\n   699→        Reject flow: pipeline appears in queue, then reject, then verify.\n   700→        \"\"\"\n   701→        mock_pipeline = create_mock_pipeline(\n   702→            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n   703→        )\n   704→\n   705→        # First: queue returns the pipeline\n   706→        mock_queue_result = MagicMock()\n   707→        mock_queue_result.scalars.return_value.all.return_value = [mock_pipeline]\n   708→\n   709→        # Then: reject lookup and reject\n   710→        mock_single_result = MagicMock()\n   711→        mock_single_result.scalar_one_or_none.return_value = mock_pipeline\n   712→\n   713→        # Configure mock to return appropriate result based on call\n   714→        call_count = [0]\n   715→\n   716→        def execute_side_effect(*args, **kwargs):\n   717→            call_count[0] += 1\n   718→            if call_count[0] == 1:\n   719→                return mock_queue_result\n   720→            return mock_single_result\n   721→\n   722→        mock_db_session.execute.side_effect = execute_side_effect\n   723→\n   724→        # Check queue\n   725→        queue_response = test_client.get(\"/api/v1/review/queue\")\n   726→        assert queue_response.status_code == 200\n   727→        assert len(queue_response.json()) == 1\n   728→\n   729→        # Reject\n   730→        with patch(\"backend.api.review.CRM\") as MockCRM:\n   731→            MockCRM.return_value = AsyncMock()\n   732→            reject_response = test_client.patch(\n   733→                f\"/api/v1/review/application/{pipeline_id}/reject\"\n   734→            )\n   735→\n   736→        assert reject_response.status_code == 200\n   737→        assert reject_response.json()[\"status\"] == \"REJECTED\"\n   738→        assert mock_pipeline.status == \"REJECTED\"\n   739→"}]},"parent_tool_use_id":null,"session_id":"e1a6c245-4572-4816-9d85-5634565bd455","uuid":"b89d0170-d245-4cff-974e-d3ef23cdabf4","tool_use_result":{"type":"update","filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/tests/api/test_review_approve.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nReview Dashboard Approve Flow integration tests.\n\nFull end-to-end tests for the application approval workflow:\n  - Create application pipeline → approve → verify state transition\n  - CRM event logging on approval\n  - Error handling for non-existent and invalid-status pipelines\n\nContract:\n  - HYPHA-TESTS.md § tests-agent.api.review\n  - NUTRIENTS.md § API_CONTRACTS review endpoints\n  - HYPHA-REVIEW-DASHBOARD.md acceptance criteria\n\nCoverage:\n  - Create application row in test database\n  - PATCH approve, assert state transition to APPROVED\n  - Verify crm_events row written on approval\n  - 404 on non-existent pipeline\n  - 422 on approving non-AWAITING_REVIEW pipeline\n  - PATCH reject, assert state transition to REJECTED\n\nNOTE: Uses mocked database operations because the ORM models use PostgreSQL-\nspecific types (ARRAY, JSONB) that are incompatible with SQLite testing.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport uuid\nfrom datetime import datetime, timedelta, timezone\nfrom typing import Generator, Any\nfrom unittest.mock import AsyncMock, MagicMock, patch\n\nimport fakeredis.aioredis\nimport jwt\nimport pytest\nfrom fastapi import FastAPI\nfrom fastapi.testclient import TestClient\n\nfrom backend.config import settings\nfrom backend.database import get_db, get_redis, set_redis_client\n\n\n# ─── Mock ORM Objects ────────────────────────────────────────────────────────\n\n\ndef create_mock_pipeline(\n    pipeline_id: uuid.UUID,\n    candidate_id: uuid.UUID,\n    job_id: uuid.UUID,\n    status: str = \"AWAITING_REVIEW\",\n    current_step: str = \"compose\",\n) -> MagicMock:\n    \"\"\"Create a mock ApplicationPipeline ORM object.\"\"\"\n    mock = MagicMock()\n    mock.id = pipeline_id\n    mock.candidate_id = candidate_id\n    mock.job_id = job_id\n    mock.status = status\n    mock.current_step = current_step\n    mock.created_at = datetime.now(timezone.utc)\n    mock.updated_at = datetime.now(timezone.utc)\n    mock.resume_id = None\n    mock.email_id = None\n    mock.approval_timestamp = None\n    return mock\n\n\ndef create_mock_crm_event(\n    pipeline_id: uuid.UUID,\n    candidate_id: uuid.UUID,\n    job_id: uuid.UUID,\n    event_type: str,\n) -> MagicMock:\n    \"\"\"Create a mock CRMEvent ORM object.\"\"\"\n    mock = MagicMock()\n    mock.id = uuid.uuid4()\n    mock.pipeline_id = pipeline_id\n    mock.candidate_id = candidate_id\n    mock.job_id = job_id\n    mock.event_type = event_type\n    mock.details = None\n    mock.payload = {}\n    mock.created_at = datetime.now(timezone.utc)\n    return mock\n\n\n# ─── Fixtures ────────────────────────────────────────────────────────────────\n\n\n@pytest.fixture\ndef pipeline_id() -> uuid.UUID:\n    \"\"\"Generate a test pipeline ID.\"\"\"\n    return uuid.uuid4()\n\n\n@pytest.fixture\ndef candidate_id() -> uuid.UUID:\n    \"\"\"Generate a test candidate ID.\"\"\"\n    return uuid.uuid4()\n\n\n@pytest.fixture\ndef job_id() -> uuid.UUID:\n    \"\"\"Generate a test job ID.\"\"\"\n    return uuid.uuid4()\n\n\n@pytest.fixture\ndef fake_redis():\n    \"\"\"Create a fake Redis client for testing.\"\"\"\n    return fakeredis.aioredis.FakeRedis(decode_responses=True)\n\n\n@pytest.fixture\ndef valid_jwt() -> str:\n    \"\"\"Generate a valid JWT for testing.\"\"\"\n    user_id = uuid.uuid4()\n    payload = {\n        \"sub\": str(user_id),\n        \"email\": \"reviewer@example.com\",\n        \"iat\": datetime.now(timezone.utc),\n        \"exp\": datetime.now(timezone.utc) + timedelta(days=1),\n    }\n    return jwt.encode(payload, settings.jwt_secret, algorithm=\"HS256\")\n\n\n@pytest.fixture\ndef mock_db_session():\n    \"\"\"Create a mock async database session.\"\"\"\n    session = AsyncMock()\n    session.execute = AsyncMock()\n    session.commit = AsyncMock()\n    session.add = MagicMock()\n    session.refresh = AsyncMock()\n    return session\n\n\n@pytest.fixture\ndef app_with_mocks(mock_db_session, fake_redis) -> FastAPI:\n    \"\"\"Create a FastAPI app with mocked dependencies.\"\"\"\n    from backend.main import app\n\n    # Override dependencies with mocks\n    app.dependency_overrides[get_db] = lambda: mock_db_session\n    app.dependency_overrides[get_redis] = lambda: fake_redis\n\n    # Set the fake Redis as the global client\n    set_redis_client(fake_redis)\n\n    yield app\n\n    # Clean up overrides\n    app.dependency_overrides.clear()\n\n\n@pytest.fixture\ndef test_client(app_with_mocks: FastAPI) -> Generator[TestClient, None, None]:\n    \"\"\"Create a TestClient for the app.\"\"\"\n    with TestClient(app_with_mocks) as client:\n        yield client\n\n\n# ─── Approve Endpoint Tests ───────────────────────────────────────────────────\n\n\nclass TestApproveApplication:\n    \"\"\"Test PATCH /api/v1/review/application/{pipeline_id}/approve endpoint.\"\"\"\n\n    def test_approve_awaiting_review_pipeline_succeeds(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n        pipeline_id: uuid.UUID,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Approving a pipeline in AWAITING_REVIEW status should succeed.\n\n        Asserts:\n          - Response status 200\n          - Response contains pipeline_id and status='APPROVED'\n        \"\"\"\n        # Setup: mock pipeline lookup returns a pipeline in AWAITING_REVIEW\n        mock_pipeline = create_mock_pipeline(\n            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n        )\n        mock_result = MagicMock()\n        mock_result.scalar_one_or_none.return_value = mock_pipeline\n        mock_db_session.execute.return_value = mock_result\n\n        response = test_client.patch(\n            f\"/api/v1/review/application/{pipeline_id}/approve\"\n        )\n\n        assert response.status_code == 200\n        data = response.json()\n        assert data[\"pipeline_id\"] == str(pipeline_id)\n        assert data[\"status\"] == \"APPROVED\"\n\n    def test_approve_transitions_status_to_approved(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n        pipeline_id: uuid.UUID,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Approving should transition pipeline status from AWAITING_REVIEW to APPROVED.\n\n        This test verifies the pipeline object's status is updated.\n        \"\"\"\n        mock_pipeline = create_mock_pipeline(\n            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n        )\n        mock_result = MagicMock()\n        mock_result.scalar_one_or_none.return_value = mock_pipeline\n        mock_db_session.execute.return_value = mock_result\n\n        response = test_client.patch(\n            f\"/api/v1/review/application/{pipeline_id}/approve\"\n        )\n\n        assert response.status_code == 200\n        # Verify the pipeline status was updated\n        assert mock_pipeline.status == \"APPROVED\"\n        # Verify commit was called\n        mock_db_session.commit.assert_called()\n\n    def test_approve_calls_crm_log(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n        pipeline_id: uuid.UUID,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Approving should log a CRM event for audit trail.\n\n        Contract: HYPHA-TESTS.md § tests-agent.api.review\n        \"Asserts application_events row written\" (maps to crm_events table)\n        \"\"\"\n        mock_pipeline = create_mock_pipeline(\n            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n        )\n        mock_result = MagicMock()\n        mock_result.scalar_one_or_none.return_value = mock_pipeline\n        mock_db_session.execute.return_value = mock_result\n\n        # Patch CRM to verify it's called\n        with patch(\"backend.api.review.CRM\") as MockCRM:\n            mock_crm_instance = AsyncMock()\n            MockCRM.return_value = mock_crm_instance\n\n            response = test_client.patch(\n                f\"/api/v1/review/application/{pipeline_id}/approve\"\n            )\n\n            assert response.status_code == 200\n\n            # Verify CRM.log was called with correct event type\n            mock_crm_instance.log.assert_called_once()\n            call_args = mock_crm_instance.log.call_args\n            assert call_args.args[0] == pipeline_id  # pipeline_id\n            assert call_args.args[1] == candidate_id  # candidate_id\n            assert call_args.args[2] == job_id  # job_id\n            assert call_args.args[3] == \"APPROVED_FOR_SUBMISSION\"  # event_type\n\n    def test_approve_nonexistent_pipeline_returns_404(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n    ):\n        \"\"\"\n        Approving a non-existent pipeline should return 404.\n\n        Contract: NUTRIENTS.md § API_CONTRACTS\n        \"Error responses: 404: 'Pipeline not found'\"\n        \"\"\"\n        fake_pipeline_id = uuid.uuid4()\n\n        # Setup: mock pipeline lookup returns None\n        mock_result = MagicMock()\n        mock_result.scalar_one_or_none.return_value = None\n        mock_db_session.execute.return_value = mock_result\n\n        response = test_client.patch(\n            f\"/api/v1/review/application/{fake_pipeline_id}/approve\"\n        )\n\n        assert response.status_code == 404\n        assert \"not found\" in response.json().get(\"detail\", \"\").lower()\n\n    def test_approve_queued_pipeline_returns_422(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n        pipeline_id: uuid.UUID,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Approving a pipeline not in AWAITING_REVIEW status should return 422.\n\n        Contract: NUTRIENTS.md § API_CONTRACTS\n        \"Error responses: 400: 'Pipeline is not awaiting review'\"\n        \"\"\"\n        # Pipeline is in QUEUED status, not AWAITING_REVIEW\n        mock_pipeline = create_mock_pipeline(\n            pipeline_id, candidate_id, job_id, status=\"QUEUED\"\n        )\n        mock_result = MagicMock()\n        mock_result.scalar_one_or_none.return_value = mock_pipeline\n        mock_db_session.execute.return_value = mock_result\n\n        response = test_client.patch(\n            f\"/api/v1/review/application/{pipeline_id}/approve\"\n        )\n\n        assert response.status_code == 422\n        detail = response.json().get(\"detail\", \"\")\n        assert \"not awaiting review\" in detail.lower() or \"QUEUED\" in detail\n\n    def test_approve_already_approved_pipeline_returns_422(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n        pipeline_id: uuid.UUID,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Re-approving an already APPROVED pipeline should return 422.\n\n        Idempotency check — prevents double-approvals.\n        \"\"\"\n        mock_pipeline = create_mock_pipeline(\n            pipeline_id, candidate_id, job_id, status=\"APPROVED\"\n        )\n        mock_result = MagicMock()\n        mock_result.scalar_one_or_none.return_value = mock_pipeline\n        mock_db_session.execute.return_value = mock_result\n\n        response = test_client.patch(\n            f\"/api/v1/review/application/{pipeline_id}/approve\"\n        )\n\n        assert response.status_code == 422\n        detail = response.json().get(\"detail\", \"\")\n        assert \"APPROVED\" in detail or \"not awaiting review\" in detail.lower()\n\n    @pytest.mark.asyncio\n    async def test_approve_publishes_to_redis(\n        self,\n        app_with_mocks: FastAPI,\n        mock_db_session: AsyncMock,\n        fake_redis,\n        pipeline_id: uuid.UUID,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Approving should publish an event to Redis for the orchestrator.\n\n        The approve endpoint publishes to 'application.approved' channel.\n        \"\"\"\n        mock_pipeline = create_mock_pipeline(\n            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n        )\n        mock_result = MagicMock()\n        mock_result.scalar_one_or_none.return_value = mock_pipeline\n        mock_db_session.execute.return_value = mock_result\n\n        # Subscribe to the channel before approval\n        pubsub = fake_redis.pubsub()\n        await pubsub.subscribe(\"application.approved\")\n\n        with TestClient(app_with_mocks) as client:\n            with patch(\"backend.api.review.CRM\") as MockCRM:\n                MockCRM.return_value = AsyncMock()\n                response = client.patch(\n                    f\"/api/v1/review/application/{pipeline_id}/approve\"\n                )\n                assert response.status_code == 200\n\n        # Check that message was published\n        message = await pubsub.get_message(ignore_subscribe_messages=True, timeout=1.0)\n        assert message is not None, \"Expected a message to be published to Redis\"\n        payload = json.loads(message[\"data\"])\n        assert payload[\"pipeline_id\"] == str(pipeline_id)\n        assert payload[\"candidate_id\"] == str(candidate_id)\n\n        await pubsub.unsubscribe(\"application.approved\")\n\n\n# ─── Reject Endpoint Tests ────────────────────────────────────────────────────\n\n\nclass TestRejectApplication:\n    \"\"\"Test PATCH /api/v1/review/application/{pipeline_id}/reject endpoint.\"\"\"\n\n    def test_reject_awaiting_review_pipeline_succeeds(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n        pipeline_id: uuid.UUID,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Rejecting a pipeline should succeed.\n\n        Asserts:\n          - Response status 200\n          - Response contains pipeline_id and status='REJECTED'\n        \"\"\"\n        mock_pipeline = create_mock_pipeline(\n            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n        )\n        mock_result = MagicMock()\n        mock_result.scalar_one_or_none.return_value = mock_pipeline\n        mock_db_session.execute.return_value = mock_result\n\n        response = test_client.patch(\n            f\"/api/v1/review/application/{pipeline_id}/reject\"\n        )\n\n        assert response.status_code == 200\n        data = response.json()\n        assert data[\"pipeline_id\"] == str(pipeline_id)\n        assert data[\"status\"] == \"REJECTED\"\n\n    def test_reject_transitions_status_to_rejected(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n        pipeline_id: uuid.UUID,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Rejecting should transition pipeline status to REJECTED.\n        \"\"\"\n        mock_pipeline = create_mock_pipeline(\n            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n        )\n        mock_result = MagicMock()\n        mock_result.scalar_one_or_none.return_value = mock_pipeline\n        mock_db_session.execute.return_value = mock_result\n\n        response = test_client.patch(\n            f\"/api/v1/review/application/{pipeline_id}/reject\"\n        )\n\n        assert response.status_code == 200\n        assert mock_pipeline.status == \"REJECTED\"\n        mock_db_session.commit.assert_called()\n\n    def test_reject_calls_crm_log(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n        pipeline_id: uuid.UUID,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Rejecting should log a CRM event for audit trail.\n        \"\"\"\n        mock_pipeline = create_mock_pipeline(\n            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n        )\n        mock_result = MagicMock()\n        mock_result.scalar_one_or_none.return_value = mock_pipeline\n        mock_db_session.execute.return_value = mock_result\n\n        with patch(\"backend.api.review.CRM\") as MockCRM:\n            mock_crm_instance = AsyncMock()\n            MockCRM.return_value = mock_crm_instance\n\n            response = test_client.patch(\n                f\"/api/v1/review/application/{pipeline_id}/reject\"\n            )\n\n            assert response.status_code == 200\n            mock_crm_instance.log.assert_called_once()\n            call_args = mock_crm_instance.log.call_args\n            assert call_args.args[3] == \"REJECTED\"  # event_type\n\n    def test_reject_nonexistent_pipeline_returns_404(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n    ):\n        \"\"\"\n        Rejecting a non-existent pipeline should return 404.\n        \"\"\"\n        fake_pipeline_id = uuid.uuid4()\n        mock_result = MagicMock()\n        mock_result.scalar_one_or_none.return_value = None\n        mock_db_session.execute.return_value = mock_result\n\n        response = test_client.patch(\n            f\"/api/v1/review/application/{fake_pipeline_id}/reject\"\n        )\n\n        assert response.status_code == 404\n        assert \"not found\" in response.json().get(\"detail\", \"\").lower()\n\n\n# ─── Review Queue Tests ───────────────────────────────────────────────────────\n\n\nclass TestReviewQueue:\n    \"\"\"Test GET /api/v1/review/queue endpoint.\"\"\"\n\n    def test_queue_returns_awaiting_review_pipelines(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n        pipeline_id: uuid.UUID,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Review queue should return pipelines with status AWAITING_REVIEW.\n        \"\"\"\n        mock_pipeline = create_mock_pipeline(\n            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n        )\n        mock_result = MagicMock()\n        mock_result.scalars.return_value.all.return_value = [mock_pipeline]\n        mock_db_session.execute.return_value = mock_result\n\n        response = test_client.get(\"/api/v1/review/queue\")\n\n        assert response.status_code == 200\n        data = response.json()\n        assert isinstance(data, list)\n        assert len(data) == 1\n        assert data[0][\"pipeline_id\"] == str(pipeline_id)\n        assert data[0][\"status\"] == \"AWAITING_REVIEW\"\n\n    def test_queue_returns_empty_when_no_awaiting_review(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n    ):\n        \"\"\"\n        Review queue should return empty list when no pipelines are awaiting review.\n        \"\"\"\n        mock_result = MagicMock()\n        mock_result.scalars.return_value.all.return_value = []\n        mock_db_session.execute.return_value = mock_result\n\n        response = test_client.get(\"/api/v1/review/queue\")\n\n        assert response.status_code == 200\n        data = response.json()\n        assert data == []\n\n    def test_queue_returns_multiple_pipelines(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Review queue should return all pipelines awaiting review.\n        \"\"\"\n        pipeline1 = create_mock_pipeline(\n            uuid.uuid4(), candidate_id, job_id, status=\"AWAITING_REVIEW\"\n        )\n        pipeline2 = create_mock_pipeline(\n            uuid.uuid4(), candidate_id, job_id, status=\"AWAITING_REVIEW\"\n        )\n        mock_result = MagicMock()\n        mock_result.scalars.return_value.all.return_value = [pipeline1, pipeline2]\n        mock_db_session.execute.return_value = mock_result\n\n        response = test_client.get(\"/api/v1/review/queue\")\n\n        assert response.status_code == 200\n        data = response.json()\n        assert len(data) == 2\n\n\n# ─── Full Integration Flow Tests ──────────────────────────────────────────────\n\n\nclass TestFullApprovalFlow:\n    \"\"\"\n    Integration tests for the complete approval workflow.\n\n    Contract: HYPHA-TESTS.md\n    \"full integration: create application → approve → verify state transition\"\n    \"\"\"\n\n    def test_full_flow_approve_verify_transition(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n        pipeline_id: uuid.UUID,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Full integration test: approve → verify transition → verify CRM event.\n\n        Steps:\n          1. Mock a pipeline in AWAITING_REVIEW state\n          2. POST to approve endpoint\n          3. Verify pipeline status is now APPROVED\n          4. Verify CRM event was logged\n        \"\"\"\n        mock_pipeline = create_mock_pipeline(\n            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n        )\n        mock_result = MagicMock()\n        mock_result.scalar_one_or_none.return_value = mock_pipeline\n        mock_db_session.execute.return_value = mock_result\n\n        with patch(\"backend.api.review.CRM\") as MockCRM:\n            mock_crm_instance = AsyncMock()\n            MockCRM.return_value = mock_crm_instance\n\n            response = test_client.patch(\n                f\"/api/v1/review/application/{pipeline_id}/approve\"\n            )\n\n            # Verify response\n            assert response.status_code == 200\n            assert response.json()[\"status\"] == \"APPROVED\"\n\n            # Verify pipeline status was updated\n            assert mock_pipeline.status == \"APPROVED\"\n\n            # Verify CRM event was logged\n            mock_crm_instance.log.assert_called_once()\n            assert mock_crm_instance.log.call_args.args[3] == \"APPROVED_FOR_SUBMISSION\"\n\n    def test_approval_is_idempotent_check(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n        pipeline_id: uuid.UUID,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Once approved, re-approval should fail with 422.\n\n        This ensures the state machine is respected.\n        \"\"\"\n        # First call: pipeline is AWAITING_REVIEW\n        mock_pipeline = create_mock_pipeline(\n            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n        )\n        mock_result = MagicMock()\n        mock_result.scalar_one_or_none.return_value = mock_pipeline\n        mock_db_session.execute.return_value = mock_result\n\n        with patch(\"backend.api.review.CRM\") as MockCRM:\n            MockCRM.return_value = AsyncMock()\n            response1 = test_client.patch(\n                f\"/api/v1/review/application/{pipeline_id}/approve\"\n            )\n            assert response1.status_code == 200\n            assert response1.json()[\"status\"] == \"APPROVED\"\n\n        # After first approval, pipeline is now APPROVED\n        # Second call should fail because status is APPROVED\n        assert mock_pipeline.status == \"APPROVED\"\n\n        # Reset mock to simulate second call with updated status\n        mock_result.scalar_one_or_none.return_value = mock_pipeline\n\n        response2 = test_client.patch(\n            f\"/api/v1/review/application/{pipeline_id}/approve\"\n        )\n        assert response2.status_code == 422\n\n    def test_reject_after_queue_check(\n        self,\n        test_client: TestClient,\n        mock_db_session: AsyncMock,\n        pipeline_id: uuid.UUID,\n        candidate_id: uuid.UUID,\n        job_id: uuid.UUID,\n    ):\n        \"\"\"\n        Reject flow: pipeline appears in queue, then reject, then verify.\n        \"\"\"\n        mock_pipeline = create_mock_pipeline(\n            pipeline_id, candidate_id, job_id, status=\"AWAITING_REVIEW\"\n        )\n\n        # First: queue returns the pipeline\n        mock_queue_result = MagicMock()\n        mock_queue_result.scalars.return_value.all.return_value = [mock_pipeline]\n\n        # Then: reject lookup and reject\n        mock_single_result = MagicMock()\n        mock_single_result.scalar_one_or_none.return_value = mock_pipeline\n\n        # Configure mock to return appropriate result based on call\n        call_count = [0]\n\n        def execute_side_effect(*args, **kwargs):\n            call_count[0] += 1\n            if call_count[0] == 1:\n                return mock_queue_result\n            return mock_single_result\n\n        mock_db_session.execute.side_effect = execute_side_effect\n\n        # Check queue\n        queue_response = test_client.get(\"/api/v1/review/queue\")\n        assert queue_response.status_code == 200\n        assert len(queue_response.json()) == 1\n\n        # Reject\n        with patch(\"backend.api.review.CRM\") as MockCRM:\n            MockCRM.return_value = AsyncMock()\n            reject_response = test_client.patch(\n                f\"/api/v1/review/application/{pipeline_id}/reject\"\n            )\n\n        assert reject_response.status_code == 200\n        assert reject_response.json()[\"status\"] == \"REJECTED\"\n        assert mock_pipeline.status == \"REJECTED\"\n","structuredPatch":[{"oldStart":21,"oldLines":197,"newStart":21,"newLines":107,"lines":["   - 404 on non-existent pipeline","   - 422 on approving non-AWAITING_REVIEW pipeline","   - PATCH reject, assert state transition to REJECTED","+","+NOTE: Uses mocked database operations because the ORM models use PostgreSQL-","+specific types (ARRAY, JSONB) that are incompatible with SQLite testing."," \"\"\""," "," from __future__ import annotations"," ","+import json"," import uuid"," from datetime import datetime, timedelta, timezone","-from typing import AsyncGenerator, Generator","+from typing import Generator, Any","+from unittest.mock import AsyncMock, MagicMock, patch"," "," import fakeredis.aioredis"," import jwt"," import pytest","-import pytest_asyncio"," from fastapi import FastAPI"," from fastapi.testclient import TestClient","-from httpx import ASGITransport, AsyncClient","-from sqlalchemy import select","-from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker, create_async_engine","-from sqlalchemy.pool import StaticPool"," "," from backend.config import settings","-from backend.database import Base, get_db, get_redis, set_redis_client","-from backend.models.auth import User","-from backend.models.discovery import Candidate, DiscoveredJob, JobSource, RemotePreference","-from backend.models.applica