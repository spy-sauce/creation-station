{"t":"2026-05-28T03:00:39.255Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F4QzJpgDgWqdT9YgCA63nX","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Review Dashboard API — exposes all draft application artifacts for human review.\n     6→\n     7→Every deliverable (tailored resume, outreach email, form submission) must be\n     8→approved here before anything is sent. Human stays in the loop.\n     9→\n    10→GET    /review/queue                        → list all awaiting review\n    11→GET    /review/application/{pipeline_id}    → full application package\n    12→PATCH  /review/application/{pipeline_id}/approve → approve + trigger submission\n    13→PATCH  /review/application/{pipeline_id}/reject  → skip this application\n    14→PATCH  /review/resume/{pipeline_id}         → update tailored resume text\n    15→PATCH  /review/email/{pipeline_id}          → update outreach email\n    16→GET    /review/preview/{pipeline_id}/resume → render resume as plain text\n    17→GET    /review/preview/{pipeline_id}/email  → preview email body\n    18→GET    /review/timeline/{pipeline_id}       → CRM event timeline\n    19→\"\"\"\n    20→\n    21→from uuid import UUID\n    22→from typing import Optional\n    23→\n    24→import redis.asyncio as aioredis\n    25→import structlog\n    26→from fastapi import APIRouter, Depends, HTTPException\n    27→from pydantic import BaseModel\n    28→from sqlalchemy import select, desc\n    29→from sqlalchemy.ext.asyncio import AsyncSession\n    30→\n    31→from backend.database import get_db\n    32→from backend.api.discovery import get_redis\n    33→from backend.agents.application.crm import CRM\n    34→from backend.models.application import (\n    35→    ApplicationPipeline,\n    36→    TailoredResume,\n    37→    OutreachEmail,\n    38→    ParsedJD,\n    39→    CompanyIntel,\n    40→    Contact,\n    41→)\n    42→\n    43→logger = structlog.get_logger(__name__)\n    44→router = APIRouter()\n    45→\n    46→\n    47→# ─── Request/response schemas ─────────────────────────────────────────────────\n    48→\n    49→class ResumeUpdate(BaseModel):\n    50→    \"\"\"Updated resume text from the Review Dashboard.\"\"\"\n    51→    full_text: str\n    52→    summary: Optional[str] = None\n    53→\n    54→\n    55→class EmailUpdate(BaseModel):\n    56→    \"\"\"Updated email body or subject from the Review Dashboard.\"\"\"\n    57→    body: Optional[str] = None\n    58→    subject: Optional[str] = None\n    59→\n    60→\n    61→# ─── Endpoints ────────────────────────────────────────────────────────────────\n    62→\n    63→@router.get(\"/queue\")\n    64→async def get_review_queue(\n    65→    db: AsyncSession = Depends(get_db),\n    66→):\n    67→    \"\"\"List all application pipelines awaiting human review.\"\"\"\n    68→    result = await db.execute(\n    69→        select(ApplicationPipeline)\n    70→        .where(ApplicationPipeline.status == \"AWAITING_REVIEW\")\n    71→        .order_by(desc(ApplicationPipeline.updated_at))\n    72→    )\n    73→    pipelines = result.scalars().all()\n    74→\n    75→    return [\n    76→        {\n    77→            \"pipeline_id\": str(p.id),\n    78→            \"job_id\": str(p.job_id),\n    79→            \"candidate_id\": str(p.candidate_id),\n    80→            \"status\": p.status,\n    81→            \"current_step\": p.current_step,\n    82→            \"created_at\": p.created_at.isoformat(),\n    83→            \"updated_at\": p.updated_at.isoformat(),\n    84→        }\n    85→        for p in pipelines\n    86→    ]\n    87→\n    88→\n    89→@router.get(\"/application/{pipeline_id}\")\n    90→async def get_application_package(\n    91→    pipeline_id: UUID,\n    92→    db: AsyncSession = Depends(get_db),\n    93→):\n    94→    \"\"\"\n    95→    Return the full application package for review.\n    96→\n    97→    Includes: pipeline status, tailored resume, outreach email,\n    98→    company intel, contact, and parsed JD signals.\n    99→    \"\"\"\n   100→    result = await db.execute(\n   101→        select(ApplicationPipeline).where(ApplicationPipeline.id == pipeline_id)\n   102→    )\n   103→    pipeline = result.scalar_one_or_none()\n   104→    if not pipeline:\n   105→        raise HTTPException(status_code=404, detail=\"Pipeline not found\")\n   106→\n   107→    # Load related artifacts\n   108→    resume = await _get_resume(db, pipeline.resume_id)\n   109→    email = await _get_email(db, pipeline.email_id)\n   110→    parsed_jd = await _get_parsed_jd(db, pipeline.job_id)\n   111→\n   112→    return {\n   113→        \"pipeline_id\": str(pipeline.id),\n   114→        \"job_id\": str(pipeline.job_id),\n   115→        \"candidate_id\": str(pipeline.candidate_id),\n   116→        \"status\": pipeline.status,\n   117→        \"current_step\": pipeline.current_step,\n   118→        \"resume\": resume,\n   119→        \"email\": email,\n   120→        \"parsed_jd\": parsed_jd,\n   121→        \"created_at\": pipeline.created_at.isoformat(),\n   122→    }\n   123→\n   124→\n   125→@router.patch(\"/application/{pipeline_id}/approve\")\n   126→async def approve_application(\n   127→    pipeline_id: UUID,\n   128→    db: AsyncSession = Depends(get_db),\n   129→    redis: aioredis.Redis = Depends(get_redis),\n   130→):\n   131→    \"\"\"\n   132→    Approve this application and trigger auto-submit.\n   133→\n   134→    Status moves from AWAITING_REVIEW → APPROVED → SUBMITTED.\n   135→    \"\"\"\n   136→    result = await db.execute(\n   137→        select(ApplicationPipeline).where(ApplicationPipeline.id == pipeline_id)\n   138→    )\n   139→    pipeline = result.scalar_one_or_none()\n   140→    if not pipeline:\n   141→        raise HTTPException(status_code=404, detail=\"Pipeline not found\")\n   142→    if pipeline.status != \"AWAITING_REVIEW\":\n   143→        raise HTTPException(\n   144→            status_code=422,\n   145→            detail=f\"Pipeline is not awaiting review (status: {pipeline.status})\",\n   146→        )\n   147→\n   148→    pipeline.status = \"APPROVED\"\n   149→    await db.commit()\n   150→\n   151→    crm = CRM(db)\n   152→    await crm.log(pipeline_id, pipeline.candidate_id, pipeline.job_id, \"APPROVED_FOR_SUBMISSION\")\n   153→\n   154→    # Trigger the orchestrator's submit step via the background task\n   155→    # (In production, this publishes to Redis and the worker picks it up)\n   156→    import json\n   157→    await redis.publish(\n   158→        \"application.approved\",\n   159→        json.dumps({\"pipeline_id\": str(pipeline_id), \"candidate_id\": str(pipeline.candidate_id)}),\n   160→    )\n   161→\n   162→    logger.info(\"review.approved\", pipeline_id=str(pipeline_id))\n   163→    return {\"pipeline_id\": str(pipeline_id), \"status\": \"APPROVED\"}\n   164→\n   165→\n   166→@router.patch(\"/application/{pipeline_id}/reject\")\n   167→async def reject_application(\n   168→    pipeline_id: UUID,\n   169→    db: AsyncSession = Depends(get_db),\n   170→):\n   171→    \"\"\"Reject and skip this application.\"\"\"\n   172→    result = await db.execute(\n   173→        select(ApplicationPipeline).where(ApplicationPipeline.id == pipeline_id)\n   174→    )\n   175→    pipeline = result.scalar_one_or_none()\n   176→    if not pipeline:\n   177→        raise HTTPException(status_code=404, detail=\"Pipeline not found\")\n   178→\n   179→    pipeline.status = \"REJECTED\"\n   180→    await db.commit()\n   181→\n   182→    crm = CRM(db)\n   183→    await crm.log(pipeline_id, pipeline.candidate_id, pipeline.job_id, \"REJECTED\")\n   184→\n   185→    logger.info(\"review.rejected\", pipeline_id=str(pipeline_id))\n   186→    return {\"pipeline_id\": str(pipeline_id), \"status\": \"REJECTED\"}\n   187→\n   188→\n   189→@router.patch(\"/resume/{pipeline_id}\")\n   190→async def update_resume(\n   191→    pipeline_id: UUID,\n   192→    payload: ResumeUpdate,\n   193→    db: AsyncSession = Depends(get_db),\n   194→):\n   195→    \"\"\"Update the tailored resume before approval.\"\"\"\n   196→    result = await db.execute(\n   197→        select(ApplicationPipeline).where(ApplicationPipeline.id == pipeline_id)\n   198→    )\n   199→    pipeline = result.scalar_one_or_none()\n   200→    if not pipeline or not pipeline.resume_id:\n   201→        raise HTTPException(status_code=404, detail=\"Resume not found\")\n   202→\n   203→    resume_result = await db.execute(\n   204→        select(TailoredResume).where(TailoredResume.id == pipeline.resume_id)\n   205→    )\n   206→    resume = resume_result.scalar_one_or_none()\n   207→    if not resume:\n   208→        raise HTTPException(status_code=404, detail=\"Resume record not found\")\n   209→\n   210→    resume.full_text = payload.full_text\n   211→    if payload.summary:\n   212→        resume.summary = payload.summary\n   213→    resume.version += 1\n   214→    await db.commit()\n   215→\n   216→    logger.info(\"review.resume_updated\", pipeline_id=str(pipeline_id), version=resume.version)\n   217→    return {\"pipeline_id\": str(pipeline_id), \"resume_version\": resume.version}\n   218→\n   219→\n   220→@router.patch(\"/email/{pipeline_id}\")\n   221→async def update_email(\n   222→    pipeline_id: UUID,\n   223→    payload: EmailUpdate,\n   224→    db: AsyncSession = Depends(get_db),\n   225→):\n   226→    \"\"\"Update the outreach email body or subject before approval.\"\"\"\n   227→    result = await db.execute(\n   228→        select(ApplicationPipeline).where(ApplicationPipeline.id == pipeline_id)\n   229→    )\n   230→    pipeline = result.scalar_one_or_none()\n   231→    if not pipeline or not pipeline.email_id:\n   232→        raise HTTPException(status_code=404, detail=\"Email not found for this pipeline\")\n   233→\n   234→    email_result = await db.execute(\n   235→        select(OutreachEmail).where(OutreachEmail.id == pipeline.email_id)\n   236→    )\n   237→    email = email_result.scalar_one_or_none()\n   238→    if not email:\n   239→        raise HTTPException(status_code=404, detail=\"Email record not found\")\n   240→\n   241→    if payload.body:\n   242→        email.body = payload.body\n   243→    if payload.subject:\n   244→        email.subject = payload.subject\n   245→    await db.commit()\n   246→\n   247→    logger.info(\"review.email_updated\", pipeline_id=str(pipeline_id))\n   248→    return {\"pipeline_id\": str(pipeline_id), \"status\": \"updated\"}\n   249→\n   250→\n   251→@router.get(\"/preview/{pipeline_id}/resume\")\n   252→async def preview_resume(\n   253→    pipeline_id: UUID,\n   254→    db: AsyncSession = Depends(get_db),\n   255→):\n   256→    \"\"\"Return tailored resume as plain text for preview.\"\"\"\n   257→    result = await db.execute(\n   258→        select(ApplicationPipeline).where(ApplicationPipeline.id == pipeline_id)\n   259→    )\n   260→    pipeline = result.scalar_one_or_none()\n   261→    if not pipeline or not pipeline.resume_id:\n   262→        raise HTTPException(status_code=404, detail=\"Resume not found\")\n   263→\n   264→    resume_result = await db.execute(\n   265→        select(TailoredResume).where(TailoredResume.id == pipeline.resume_id)\n   266→    )\n   267→    resume = resume_result.scalar_one_or_none()\n   268→    if not resume:\n   269→        raise HTTPException(status_code=404, detail=\"Resume record not found\")\n   270→\n   271→    return {\n   272→        \"pipeline_id\": str(pipeline_id),\n   273→        \"summary\": resume.summary,\n   274→        \"full_text\": resume.full_text,\n   275→        \"change_log\": resume.change_log,\n   276→        \"version\": resume.version,\n   277→    }\n   278→\n   279→\n   280→@router.get(\"/preview/{pipeline_id}/email\")\n   281→async def preview_email(\n   282→    pipeline_id: UUID,\n   283→    db: AsyncSession = Depends(get_db),\n   284→):\n   285→    \"\"\"Return outreach email for preview.\"\"\"\n   286→    result = await db.execute(\n   287→        select(ApplicationPipeline).where(ApplicationPipeline.id == pipeline_id)\n   288→    )\n   289→    pipeline = result.scalar_one_or_none()\n   290→    if not pipeline or not pipeline.email_id:\n   291→        raise HTTPException(status_code=404, detail=\"Email not found\")\n   292→\n   293→    email_result = await db.execute(\n   294→        select(OutreachEmail).where(OutreachEmail.id == pipeline.email_id)\n   295→    )\n   296→    email = email_result.scalar_one_or_none()\n   297→    if not email:\n   298→        raise HTTPException(status_code=404, detail=\"Email record not found\")\n   299→\n   300→    return {\n   301→        \"pipeline_id\": str(pipeline_id),\n   302→        \"to\": email.contact_id,\n   303→        \"subject\": email.subject,\n   304→        \"subject_variants\": email.subject_variants,\n   305→        \"body\": email.body,\n   306→        \"tone_used\": email.tone_used,\n   307→        \"hook_used\": email.hook_used,\n   308→        \"status\": email.status,\n   309→    }\n   310→\n   311→\n   312→@router.get(\"/timeline/{pipeline_id}\")\n   313→async def get_timeline(\n   314→    pipeline_id: UUID,\n   315→    db: AsyncSession = Depends(get_db),\n   316→):\n   317→    \"\"\"Return the full CRM event timeline for a pipeline.\"\"\"\n   318→    crm = CRM(db)\n   319→    events = await crm.get_timeline(pipeline_id)\n   320→    return {\"pipeline_id\": str(pipeline_id), \"events\": events}\n   321→\n   322→\n   323→# ─── Helpers ──────────────────────────────────────────────────────────────────\n   324→\n   325→async def _get_resume(db: AsyncSession, resume_id) -> Optional[dict]:\n   326→    if not resume_id:\n   327→        return None\n   328→    result = await db.execute(select(TailoredResume).where(TailoredResume.id == resume_id))\n   329→    r = result.scalar_one_or_none()\n   330→    if not r:\n   331→        return None\n   332→    return {\n   333→        \"id\": str(r.id),\n   334→        \"summary\": r.summary,\n   335→        \"full_text\": r.full_text,\n   336→        \"change_log\": r.change_log,\n   337→        \"version\": r.version,\n   338→        \"pdf_path\": r.pdf_path,\n   339→    }\n   340→\n   341→\n   342→async def _get_email(db: AsyncSession, email_id) -> Optional[dict]:\n   343→    if not email_id:\n   344→        return None\n   345→    result = await db.execute(select(OutreachEmail).where(OutreachEmail.id == email_id))\n   346→    e = result.scalar_one_or_none()\n   347→    if not e:\n   348→        return None\n   349→    return {\n   350→        \"id\": str(e.id),\n   351→        \"subject\": e.subject,\n   352→        \"subject_variants\": e.subject_variants,\n   353→        \"body\": e.body,\n   354→        \"tone_used\": e.tone_used,\n   355→        \"hook_used\": e.hook_used,\n   356→        \"status\": e.status,\n   357→    }\n   358→\n   359→\n   360→async def _get_parsed_jd(db: AsyncSession, job_id) -> Optional[dict]:\n   361→    if not job_id:\n   362→        return None\n   363→    result = await db.execute(select(ParsedJD).where(ParsedJD.job_id == job_id))\n   364→    p = result.scalar_one_or_none()\n   365→    if not p:\n   366→        return None\n   367→    return {\n   368→        \"required_skills\": p.required_skills,\n   369→        \"preferred_skills\": p.preferred_skills,\n   370→        \"seniority_level\": p.seniority_level,\n   371→        \"tone\": p.tone,\n   372→        \"team_context\": p.team_context,\n   373→        \"red_flags\": p.red_flags,\n   374→        \"application_instructions\": p.application_instructions,\n   375→    }\n   376→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"e1a6c245-4572-4816-9d85-5634565bd455","uuid":"c4055dc9-458c-4496-bde7-9b0030ac6181","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/api/review.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nReview Dashboard API — exposes all draft application artifacts for human review.\n\nEvery deliverable (tailored resume, outreach email, form submission) must be\napproved here before anything is sent. Human stays in the loop.\n\nGET    /review/queue                        → list all awaiting review\nGET    /review/application/{pipeline_id}    → full application package\nPATCH  /review/application/{pipeline_id}/approve → approve + trigger submission\nPATCH  /review/application/{pipeline_id}/reject  → skip this application\nPATCH  /review/resume/{pipeline_id}         → update tailored resume text\nPATCH  /review/email/{pipeline_id}          → update outreach email\nGET    /review/preview/{pipeline_id}/resume → render resume as plain text\nGET    /review/preview/{pipeline_id}/email  → preview email body\nGET    /review/timeline/{pipeline_id}       → CRM event timeline\n\"\"\"\n\nfrom uuid import UUID\nfrom typing import Optional\n\nimport redis.asyncio as aioredis\nimport structlog\nfrom fastapi import APIRouter, Depends, HTTPException\nfrom pydantic import BaseModel\nfrom sqlalchemy import select, desc\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom backend.database import get_db\nfrom backend.api.discovery import get_redis\nfrom backend.agents.application.crm import CRM\nfrom backend.models.application import (\n    ApplicationPipeline,\n    TailoredResume,\n    OutreachEmail,\n    ParsedJD,\n    CompanyIntel,\n    Contact,\n)\n\nlogger = structlog.get_logger(__name__)\nrouter = APIRouter()\n\n\n# ─── Request/response schemas ─────────────────────────────────────────────────\n\nclass ResumeUpdate(BaseModel):\n    \"\"\"Updated resume text from the Review Dashboard.\"\"\"\n    full_text: str\n    summary: Optional[str] = None\n\n\nclass EmailUpdate(BaseModel):\n    \"\"\"Updated email body or subject from the Review Dashboard.\"\"\"\n    body: Optional[str] = None\n    subject: Optional[str] = None\n\n\n# ─── Endpoints ────────────────────────────────────────────────────────────────\n\n@router.get(\"/queue\")\nasync def get_review_queue(\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"List all application pipelines awaiting human review.\"\"\"\n    result = await db.execute(\n        select(ApplicationPipeline)\n        .where(ApplicationPipeline.status == \"AWAITING_REVIEW\")\n        .order_by(desc(ApplicationPipeline.updated_at))\n    )\n    pipelines = result.scalars().all()\n\n    return [\n        {\n            \"pipeline_id\": str(p.id),\n            \"job_id\": str(p.job_id),\n            \"candidate_id\": str(p.candidate_id),\n            \"status\": p.status,\n            \"current_step\": p.current_step,\n            \"created_at\": p.created_at.isoformat(),\n            \"updated_at\": p.updated_at.isoformat(),\n        }\n        for p in pipelines\n    ]\n\n\n@router.get(\"/application/{pipeline_id}\")\nasync def get_application_package(\n    pipeline_id: UUID,\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"\n    Return the full application package for review.\n\n    Includes: pipeline status, tailored resume, outreach email,\n    company intel, contact, and parsed JD signals.\n    \"\"\"\n    result = await db.execute(\n        select(ApplicationPipeline).where(ApplicationPipeline.id == pipeline_id)\n    )\n    pipeline = result.scalar_one_or_none()\n    if not pipeline:\n        raise HTTPException(status_code=404, detail=\"Pipeline not found\")\n\n    # Load related artifacts\n    resume = await _get_resume(db, pipeline.resume_id)\n    email = await _get_email(db, pipeline.email_id)\n    parsed_jd = await _get_parsed_jd(db, pipeline.job_id)\n\n    return {\n        \"pipeline_id\": str(pipeline.id),\n        \"job_id\": str(pipeline.job_id),\n        \"candidate_id\": str(pipeline.candidate_id),\n        \"status\": pipeline.status,\n        \"current_step\": pipeline.current_step,\n        \"resume\": resume,\n        \"email\": email,\n        \"parsed_jd\": parsed_jd,\n        \"created_at\": pipeline.created_at.isoformat(),\n    }\n\n\n@router.patch(\"/application/{pipeline_id}/approve\")\nasync def approve_application(\n    pipeline_id: UUID,\n    db: AsyncSession = Depends(get_db),\n    redis: aioredis.Redis = Depends(get_redis),\n):\n    \"\"\"\n    Approve this application and trigger auto-submit.\n\n    Status moves from AWAITING_REVIEW → APPROVED → SUBMITTED.\n    \"\"\"\n    result = await db.execute(\n        select(ApplicationPipeline).where(ApplicationPipeline.id == pipeline_id)\n    )\n    pipeline = result.scalar_one_or_none()\n    if not pipeline:\n        raise HTTPException(status_code=404, detail=\"Pipeline not found\")\n    if pipeline.status != \"AWAITING_REVIEW\":\n        raise HTTPException(\n            status_code=422,\n            detail=f\"Pipeline is not awaiting review (status: {pipeline.status})\",\n        )\n\n    pipeline.status = \"APPROVED\"\n    await db.commit()\n\n    crm = CRM(db)\n    await crm.log(pipeline_id, pipeline.candidate_id, pipeline.job_id, \"APPROVED_FOR_SUBMISSION\")\n\n    # Trigger the orchestrator's submit step via the background task\n    # (In production, this publishes to Redis and the worker picks it up)\n    import json\n    await redis.publish(\n        \"application.approved\",\n        json.dumps({\"pipeline_id\": str(pipeline_id), \"candidate_id\": str(pipeline.candidate_id)}),\n    )\n\n    logger.info(\"review.approved\", pipeline_id=str(pipeline_id))\n    return {\"pipeline_id\": str(pipeline_id), \"status\": \"APPROVED\"}\n\n\n@router.patch(\"/application/{pipeline_id}/reject\")\nasync def reject_application(\n    pipeline_id: UUID,\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"Reject and skip this application.\"\"\"\n    result = await db.execute(\n        select(ApplicationPipeline).where(ApplicationPipeline.id == pipeline_id)\n    )\n    pipeline = result.scalar_one_or_none()\n    if not pipeline:\n        raise HTTPException(status_code=404, detail=\"Pipeline not found\")\n\n    pipeline.status = \"REJECTED\"\n    await db.commit()\n\n    crm = CRM(db)\n    await crm.log(pipeline_id, pipeline.candidate_id, pipeline.job_id, \"REJECTED\")\n\n    logger.info(\"review.rejected\", pipeline_id=str(pipeline_id))\n    return {\"pipeline_id\": str(pipeline_id), \"status\": \"REJECTED\"}\n\n\n@router.patch(\"/resume/{pipeline_id}\")\nasync def update_resume(\n    pipeline_id: UUID,\n    payload: ResumeUpdate,\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"Update the tailored resume before approval.\"\"\"\n    result = await db.execute(\n        select(ApplicationPipeline).where(ApplicationPipeline.id == pipeline_id)\n    )\n    pipeline = result.scalar_one_or_none()\n    if not pipeline or not pipeline.resume_id:\n        raise HTTPException(status_code=404, detail=\"Resume not found\")\n\n    resume_result = await db.execute(\n        select(TailoredResume).where(TailoredResume.id == pipeline.resume_id)\n    )\n    resume = resume_result.scalar_one_or_none()\n    if not resume:\n        raise HTTPException(status_code=404, detail=\"Resume record not found\")\n\n    resume.full_text = payload.full_text\n    if payload.summary:\n        resume.summary = payload.summary\n    resume.version += 1\n    await db.commit()\n\n    logger.info(\"review.resume_updated\", pipeline_id=str(pipeline_id), version=resume.version)\n    return {\"pipeline_id\": str(pipeline_id), \"resume_version\": resume.version}\n\n\n@router.patch(\"/email/{pipeline_id}\")\nasync def update_email(\n    pipeline_id: UUID,\n    payload: EmailUpdate,\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"Update the outreach email body or subject before approval.\"\"\"\n    result = await db.execute(\n        select(ApplicationPipeline).where(ApplicationPipeline.id == pipeline_id)\n    )\n    pipeline = result.scalar_one_or_none()\n    if not pipeline or not pipeline.email_id:\n        raise HTTPException(status_code=404, detail=\"Email not found for this pipeline\")\n\n    email_result = await db.execute(\n        select(OutreachEmail).where(OutreachEmail.id == pipeline.email_id)\n    )\n    email = email_result.scalar_one_or_none()\n    if not email:\n        raise HTTPException(status_code=404, detail=\"Email record not found\")\n\n    if payload.body:\n        email.body = payload.body\n    if payload.subject:\n        email.subject = payload.subject\n    await db.commit()\n\n    logger.info(\"review.email_updated\", pipeline_id=str(pipeline_id))\n    return {\"pipeline_id\": str(pipeline_id), \"status\": \"updated\"}\n\n\n@router.get(\"/preview/{pipeline_id}/resume\")\nasync def preview_resume(\n    pipeline_id: UUID,\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"Return tailored resume as plain text for preview.\"\"\"\n    result = await db.execute(\n        select(ApplicationPipeline).where(ApplicationPipeline.id == pipeline_id)\n    )\n    pipeline = result.scalar_one_or_none()\n    if not pipeline or not pipeline.resume_id:\n        raise HTTPException(status_code=404, detail=\"Resume not found\")\n\n    resume_result = await db.execute(\n        select(TailoredResume).where(TailoredResume.id == pipeline.resume_id)\n    )\n    resume = resume_result.scalar_one_or_none()\n    if not resume:\n        raise HTTPException(status_code=404, detail=\"Resume record not found\")\n\n    return {\n        \"pipeline_id\": str(pipeline_id),\n        \"summary\": resume.summary,\n        \"full_text\": resume.full_text,\n        \"change_log\": resume.change_log,\n        \"version\": resume.version,\n    }\n\n\n@router.get(\"/preview/{pipeline_id}/email\")\nasync def preview_email(\n    pipeline_id: UUID,\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"Return outreach email for preview.\"\"\"\n    result = await db.execute(\n        select(ApplicationPipeline).where(ApplicationPipeline.id == pipeline_id)\n    )\n    pipeline = result.scalar_one_or_none()\n    if not pipeline or not pipeline.email_id:\n        raise HTTPException(status_code=404, detail=\"Email not found\")\n\n    email_result = await db.execute(\n        select(OutreachEmail).where(OutreachEmail.id == pipeline.email_id)\n    )\n    email = email_result.scalar_one_or_none()\n    if not email:\n        raise HTTPException(status_code=404, detail=\"Email record not found\")\n\n    return {\n        \"pipeline_id\": str(pipeline_id),\n        \"to\": email.contact_id,\n        \"subject\": email.subject,\n        \"subject_variants\": email.subject_variants,\n        \"body\": email.body,\n        \"tone_used\": email.tone_used,\n        \"hook_used\": email.hook_used,\n        \"status\": email.status,\n    }\n\n\n@router.get(\"/timeline/{pipeline_id}\")\nasync def get_timeline(\n    pipeline_id: UUID,\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"Return the full CRM event timeline for a pipeline.\"\"\"\n    crm = CRM(db)\n    events = await crm.get_timeline(pipeline_id)\n    return {\"pipeline_id\": str(pipeline_id), \"events\": events}\n\n\n# ─── Helpers ──────────────────────────────────────────────────────────────────\n\nasync def _get_resume(db: AsyncSession, resume_id) -> Optional[dict]:\n    if not resume_id:\n        return None\n    result = await db.execute(select(TailoredResume).where(TailoredResume.id == resume_id))\n    r = result.scalar_one_or_none()\n    if not r:\n        return None\n    return {\n        \"id\": str(r.id),\n        \"summary\": r.summary,\n        \"full_text\": r.full_text,\n        \"change_log\": r.change_log,\n        \"version\": r.version,\n        \"pdf_path\": r.pdf_path,\n    }\n\n\nasync def _get_email(db: AsyncSession, email_id) -> Optional[dict]:\n    if not email_id:\n        return None\n    result = await db.execute(select(OutreachEmail).where(OutreachEmail.id == email_id))\n    e = result.scalar_one_or_none()\n    if not e:\n        return None\n    return {\n        \"id\": str(e.id),\n        \"subject\": e.subject,\n        \"subject_variants\": e.subject_variants,\n        \"body\": e.body,\n        \"tone_used\": e.tone_used,\n        \"hook_used\": e.hook_used,\n        \"status\": e.status,\n    }\n\n\nasync def _get_parsed_jd(db: AsyncSession, job_id) -> Optional[dict]:\n    if not job_id:\n        return None\n    result = await db.execute(select(ParsedJD).where(ParsedJD.job_id == job_id))\n    p = result.scalar_one_or_none()\n    if not p:\n        return None\n    return {\n        \"required_skills\": p.required_skills,\n        \"preferred_skills\": p.preferred_skills,\n        \"seniority_level\": p.seniority_level,\n        \"tone\": p.tone,\n        \"team_context\": p.team_context,\n        \"red_flags\": p.red_flags,\n        \"application_instructions\": p.application_instructions,\n    }\n","numLines":376,"startLine":1,"totalLines":376}}}}
{"t":"2026-05-28T03:00:39.264Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Luqp18Fc2uVZYQJxyHgAEA","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Application Engine API — triggers and monitors the application pipeline.\n     6→\n     7→POST   /application/start/{job_id}          → start pipeline for approved job\n     8→POST   /application/cloud/{job_id}          → start pipeline via cloud agent manager\n     9→GET    /application/pipeline/{pipeline_id}  → get pipeline status + artifacts\n    10→GET    /application/pipelines/{candidate_id} → list all pipelines for candidate\n    11→GET    /application/crm/{candidate_id}      → CRM event log for all applications\n    12→POST   /application/submit/{pipeline_id}    → trigger auto-submit (post-approval)\n    13→GET    /application/agents                  → list registered cloud sub-agents\n    14→GET    /application/agents/plan             → preview execution plan (dependency tiers)\n    15→POST   /application/agents/{agent_name}     → run a single sub-agent in isolation\n    16→\"\"\"\n    17→\n    18→from uuid import UUID\n    19→from typing import Optional\n    20→\n    21→import redis.asyncio as aioredis\n    22→import structlog\n    23→from fastapi import APIRouter, Depends, HTTPException, BackgroundTasks, Query\n    24→from pydantic import BaseModel\n    25→from sqlalchemy import select, desc\n    26→from sqlalchemy.ext.asyncio import AsyncSession\n    27→\n    28→from backend.database import get_db\n    29→from backend.api.discovery import get_redis\n    30→from backend.agents.application.orchestrator import ApplicationOrchestrator\n    31→from backend.agents.application.agent_manager import AgentManager\n    32→from backend.agents.application.crm import CRM\n    33→from backend.models.application import ApplicationPipeline, CRMEvent\n    34→\n    35→logger = structlog.get_logger(__name__)\n    36→router = APIRouter()\n    37→\n    38→\n    39→# ─── Request/response schemas ─────────────────────────────────────────────────\n    40→\n    41→class StartPipelineRequest(BaseModel):\n    42→    \"\"\"Start an application pipeline for an approved job.\"\"\"\n    43→    candidate_id: UUID\n    44→\n    45→\n    46→class CloudPipelineRequest(BaseModel):\n    47→    \"\"\"Start a cloud-dispatched pipeline via the Agent Manager.\"\"\"\n    48→    candidate_id: UUID\n    49→    agents: Optional[list[str]] = None\n    50→\n    51→\n    52→class SingleAgentRequest(BaseModel):\n    53→    \"\"\"Run a single sub-agent in isolation.\"\"\"\n    54→    pipeline_id: UUID\n    55→    input_payload: dict\n    56→\n    57→\n    58→class PipelineStatusResponse(BaseModel):\n    59→    \"\"\"Current status of an application pipeline.\"\"\"\n    60→    pipeline_id: UUID\n    61→    job_id: UUID\n    62→    candidate_id: UUID\n    63→    status: str\n    64→    current_step: Optional[str]\n    65→    created_at: str\n    66→    updated_at: str\n    67→\n    68→\n    69→# ─── Endpoints ────────────────────────────────────────────────────────────────\n    70→\n    71→@router.post(\"/start/{job_id}\", response_model=PipelineStatusResponse)\n    72→async def start_pipeline(\n    73→    job_id: UUID,\n    74→    payload: StartPipelineRequest,\n    75→    background_tasks: BackgroundTasks,\n    76→    db: AsyncSession = Depends(get_db),\n    77→    redis: aioredis.Redis = Depends(get_redis),\n    78→):\n    79→    \"\"\"\n    80→    Start the application pipeline for an approved job.\n    81→\n    82→    Runs asynchronously — returns immediately with the pipeline ID.\n    83→    Monitor progress via GET /application/pipeline/{pipeline_id}.\n    84→    \"\"\"\n    85→    orchestrator = ApplicationOrchestrator(db=db, redis_client=redis)\n    86→\n    87→    async def _run():\n    88→        try:\n    89→            await orchestrator.start(job_id=job_id, candidate_id=payload.candidate_id)\n    90→        except Exception as e:\n    91→            logger.error(\n    92→                \"api.application.pipeline_failed\",\n    93→                job_id=str(job_id),\n    94→                error=str(e),\n    95→            )\n    96→\n    97→    background_tasks.add_task(_run)\n    98→\n    99→    # Create pipeline record immediately so we can return its ID\n   100→    from backend.models.application import ApplicationPipeline as APipeline\n   101→    from datetime import datetime, timezone\n   102→    pipeline = APipeline(\n   103→        job_id=job_id,\n   104→        candidate_id=payload.candidate_id,\n   105→        status=\"QUEUED\",\n   106→    )\n   107→    db.add(pipeline)\n   108→    await db.commit()\n   109→    await db.refresh(pipeline)\n   110→\n   111→    logger.info(\n   112→        \"api.application.pipeline_started\",\n   113→        pipeline_id=str(pipeline.id),\n   114→        job_id=str(job_id),\n   115→    )\n   116→\n   117→    return PipelineStatusResponse(\n   118→        pipeline_id=pipeline.id,\n   119→        job_id=pipeline.job_id,\n   120→        candidate_id=pipeline.candidate_id,\n   121→        status=pipeline.status,\n   122→        current_step=pipeline.current_step,\n   123→        created_at=pipeline.created_at.isoformat(),\n   124→        updated_at=pipeline.updated_at.isoformat(),\n   125→    )\n   126→\n   127→\n   128→@router.get(\"/pipeline/{pipeline_id}\", response_model=PipelineStatusResponse)\n   129→async def get_pipeline(\n   130→    pipeline_id: UUID,\n   131→    db: AsyncSession = Depends(get_db),\n   132→):\n   133→    \"\"\"Get the current status and step of an application pipeline.\"\"\"\n   134→    result = await db.execute(\n   135→        select(ApplicationPipeline).where(ApplicationPipeline.id == pipeline_id)\n   136→    )\n   137→    pipeline = result.scalar_one_or_none()\n   138→    if not pipeline:\n   139→        raise HTTPException(status_code=404, detail=\"Pipeline not found\")\n   140→\n   141→    return PipelineStatusResponse(\n   142→        pipeline_id=pipeline.id,\n   143→        job_id=pipeline.job_id,\n   144→        candidate_id=pipeline.candidate_id,\n   145→        status=pipeline.status,\n   146→        current_step=pipeline.current_step,\n   147→        created_at=pipeline.created_at.isoformat(),\n   148→        updated_at=pipeline.updated_at.isoformat(),\n   149→    )\n   150→\n   151→\n   152→@router.get(\"/pipelines/{candidate_id}\")\n   153→async def list_pipelines(\n   154→    candidate_id: UUID,\n   155→    status: Optional[str] = Query(default=None, description=\"Filter by status\"),\n   156→    limit: int = Query(default=20, le=100),\n   157→    db: AsyncSession = Depends(get_db),\n   158→):\n   159→    \"\"\"List all application pipelines for a candidate, newest first.\"\"\"\n   160→    query = (\n   161→        select(ApplicationPipeline)\n   162→        .where(ApplicationPipeline.candidate_id == candidate_id)\n   163→        .order_by(desc(ApplicationPipeline.updated_at))\n   164→        .limit(limit)\n   165→    )\n   166→    if status:\n   167→        query = query.where(ApplicationPipeline.status == status)\n   168→\n   169→    result = await db.execute(query)\n   170→    pipelines = result.scalars().all()\n   171→\n   172→    return [\n   173→        {\n   174→            \"pipeline_id\": str(p.id),\n   175→            \"job_id\": str(p.job_id),\n   176→            \"status\": p.status,\n   177→            \"current_step\": p.current_step,\n   178→            \"created_at\": p.created_at.isoformat(),\n   179→            \"updated_at\": p.updated_at.isoformat(),\n   180→        }\n   181→        for p in pipelines\n   182→    ]\n   183→\n   184→\n   185→@router.get(\"/crm/{candidate_id}\")\n   186→async def get_crm_log(\n   187→    candidate_id: UUID,\n   188→    limit: int = Query(default=100, le=500),\n   189→    db: AsyncSession = Depends(get_db),\n   190→):\n   191→    \"\"\"Return CRM event log for all applications by this candidate.\"\"\"\n   192→    result = await db.execute(\n   193→        select(CRMEvent)\n   194→        .where(CRMEvent.candidate_id == candidate_id)\n   195→        .order_by(desc(CRMEvent.created_at))\n   196→        .limit(limit)\n   197→    )\n   198→    events = result.scalars().all()\n   199→\n   200→    return [\n   201→        {\n   202→            \"id\": str(e.id),\n   203→            \"pipeline_id\": str(e.pipeline_id),\n   204→            \"job_id\": str(e.job_id),\n   205→            \"event_type\": e.event_type,\n   206→            \"details\": e.details,\n   207→            \"created_at\": e.created_at.isoformat(),\n   208→        }\n   209→        for e in events\n   210→    ]\n   211→\n   212→\n   213→@router.post(\"/submit/{pipeline_id}\")\n   214→async def submit_application(\n   215→    pipeline_id: UUID,\n   216→    background_tasks: BackgroundTasks,\n   217→    db: AsyncSession = Depends(get_db),\n   218→    redis: aioredis.Redis = Depends(get_redis),\n   219→):\n   220→    \"\"\"\n   221→    Trigger auto-submit for an APPROVED pipeline.\n   222→\n   223→    This is the second human confirmation — pipeline must be in APPROVED status.\n   224→    \"\"\"\n   225→    result = await db.execute(\n   226→        select(ApplicationPipeline).where(ApplicationPipeline.id == pipeline_id)\n   227→    )\n   228→    pipeline = result.scalar_one_or_none()\n   229→    if not pipeline:\n   230→        raise HTTPException(status_code=404, detail=\"Pipeline not found\")\n   231→    if pipeline.status != \"APPROVED\":\n   232→        raise HTTPException(\n   233→            status_code=422,\n   234→            detail=f\"Pipeline must be in APPROVED status to submit (current: {pipeline.status})\",\n   235→        )\n   236→\n   237→    orchestrator = ApplicationOrchestrator(db=db, redis_client=redis)\n   238→\n   239→    async def _submit():\n   240→        try:\n   241→            await orchestrator.submit(pipeline_id=pipeline_id)\n   242→        except Exception as e:\n   243→            logger.error(\"api.application.submit_failed\", pipeline_id=str(pipeline_id), error=str(e))\n   244→\n   245→    background_tasks.add_task(_submit)\n   246→\n   247→    logger.info(\"api.application.submit_triggered\", pipeline_id=str(pipeline_id))\n   248→    return {\"pipeline_id\": str(pipeline_id), \"message\": \"Submission started\"}\n   249→\n   250→\n   251→# ─── Cloud Agent Manager Endpoints ──────────────────────────────────────────\n   252→\n   253→\n   254→@router.post(\"/cloud/{job_id}\")\n   255→async def start_cloud_pipeline(\n   256→    job_id: UUID,\n   257→    payload: CloudPipelineRequest,\n   258→    background_tasks: BackgroundTasks,\n   259→    db: AsyncSession = Depends(get_db),\n   260→    redis: aioredis.Redis = Depends(get_redis),\n   261→):\n   262→    \"\"\"\n   263→    Start the application pipeline via cloud-dispatched sub-agents.\n   264→\n   265→    Each sub-agent runs as an independent Claude API call with its own\n   266→    system prompt and tool definitions. Agents within the same dependency\n   267→    tier execute concurrently.\n   268→\n   269→    Returns immediately with pipeline ID. Monitor via GET /application/pipeline/{id}.\n   270→    \"\"\"\n   271→    from backend.models.application import ApplicationPipeline as APipeline\n   272→\n   273→    # Create pipeline record\n   274→    pipeline = APipeline(\n   275→        job_id=job_id,\n   276→        candidate_id=payload.candidate_id,\n   277→        status=\"QUEUED\",\n   278→    )\n   279→    db.add(pipeline)\n   280→    await db.commit()\n   281→    await db.refresh(pipeline)\n   282→    pipeline_id = pipeline.id\n   283→\n   284→    # Load job data for the agent context\n   285→    from backend.models.discovery import DiscoveredJob, Candidate as CandidateORM\n   286→    job_result = await db.execute(\n   287→        select(DiscoveredJob).where(DiscoveredJob.id == job_id)\n   288→    )\n   289→    job_orm = job_result.scalar_one_or_none()\n   290→    if not job_orm:\n   291→        raise HTTPException(status_code=404, detail=\"Job not found\")\n   292→\n   293→    candidate_result = await db.execute(\n   294→        select(CandidateORM).where(CandidateORM.id == payload.candidate_id)\n   295→    )\n   296→    candidate_orm = candidate_result.scalar_one_or_none()\n   297→    if not candidate_orm:\n   298→        raise HTTPException(status_code=404, detail=\"Candidate not found\")\n   299→\n   300→    job_data = {\n   301→        \"job_id\": str(job_orm.id),\n   302→        \"title\": job_orm.title,\n   303→        \"company\": job_orm.company,\n   304→        \"description\": job_orm.description or \"\",\n   305→        \"url\": job_orm.url,\n   306→        \"location\": job_orm.location or \"\",\n   307→        \"source\": job_orm.source or \"\",\n   308→    }\n   309→    candidate_data = {\n   310→        \"id\": str(candidate_orm.id),\n   311→        \"name\": candidate_orm.name,\n   312→        \"email\": candidate_orm.email,\n   313→        \"resume_text\": candidate_orm.resume_text or \"\",\n   314→        \"linkedin_url\": candidate_orm.linkedin_url,\n   315→        \"github_url\": candidate_orm.github_url,\n   316→    }\n   317→\n   318→    async def _run_cloud():\n   319→        try:\n   320→            manager = AgentManager(db=db, redis_client=redis)\n   321→            results = await manager.run_application_pipeline(\n   322→                pipeline_id=pipeline_id,\n   323→                job_data=job_data,\n   324→                candidate_data=candidate_data,\n   325→                agents=payload.agents,\n   326→            )\n   327→            # Update pipeline status based on results\n   328→            all_completed = all(\n   329→                r.status == \"COMPLETED\" for r in results.values()\n   330→            )\n   331→            final_status = \"AWAITING_REVIEW\" if all_completed else \"FAILED\"\n   332→            pipeline.status = final_status\n   333→            await db.commit()\n   334→\n   335→            logger.info(\n   336→                \"api.application.cloud_pipeline_complete\",\n   337→                pipeline_id=str(pipeline_id),\n   338→                status=final_status,\n   339→                agents_run=list(results.keys()),\n   340→            )\n   341→        except Exception as e:\n   342→            logger.error(\n   343→                \"api.application.cloud_pipeline_failed\",\n   344→                pipeline_id=str(pipeline_id),\n   345→                error=str(e),\n   346→            )\n   347→            pipeline.status = \"FAILED\"\n   348→            await db.commit()\n   349→\n   350→    background_tasks.add_task(_run_cloud)\n   351→\n   352→    logger.info(\n   353→        \"api.application.cloud_pipeline_started\",\n   354→        pipeline_id=str(pipeline_id),\n   355→        job_id=str(job_id),\n   356→        agents=payload.agents,\n   357→    )\n   358→\n   359→    return {\n   360→        \"pipeline_id\": str(pipeline_id),\n   361→        \"mode\": \"cloud\",\n   362→        \"message\": \"Cloud agent pipeline dispatched\",\n   363→        \"agents\": payload.agents or [\n   364→            \"jd_parser\", \"resume_tailor\", \"company_intel\",\n   365→            \"contact_finder\", \"outreach_composer\",\n   366→        ],\n   367→    }\n   368→\n   369→\n   370→@router.get(\"/agents\")\n   371→async def list_agents(\n   372→    db: AsyncSession = Depends(get_db),\n   373→    redis: aioredis.Redis = Depends(get_redis),\n   374→):\n   375→    \"\"\"List all registered cloud sub-agents with their metadata.\"\"\"\n   376→    manager = AgentManager(db=db, redis_client=redis)\n   377→    return {\"agents\": manager.list_agents()}\n   378→\n   379→\n   380→@router.get(\"/agents/plan\")\n   381→async def get_execution_plan(\n   382→    agents: Optional[str] = Query(\n   383→        default=None,\n   384→        description=\"Comma-separated agent names (defaults to full pipeline)\",\n   385→    ),\n   386→    db: AsyncSession = Depends(get_db),\n   387→    redis: aioredis.Redis = Depends(get_redis),\n   388→):\n   389→    \"\"\"\n   390→    Preview the execution plan without running anything.\n   391→\n   392→    Returns tiers of agents — agents within a tier run concurrently.\n   393→    \"\"\"\n   394→    manager = AgentManager(db=db, redis_client=redis)\n   395→    agent_list = agents.split(\",\") if agents else None\n   396→    tiers = manager.get_execution_plan(agent_list)\n   397→    return {\n   398→        \"tiers\": [\n   399→            {\"tier\": i, \"agents\": tier, \"concurrent\": len(tier) > 1}\n   400→            for i, tier in enumerate(tiers)\n   401→        ],\n   402→    }\n   403→\n   404→\n   405→@router.post(\"/agents/{agent_name}\")\n   406→async def run_single_agent(\n   407→    agent_name: str,\n   408→    payload: SingleAgentRequest,\n   409→    background_tasks: BackgroundTasks,\n   410→    db: AsyncSession = Depends(get_db),\n   411→    redis: aioredis.Redis = Depends(get_redis),\n   412→):\n   413→    \"\"\"\n   414→    Run a single sub-agent in isolation.\n   415→\n   416→    Useful for re-running a failed agent, testing individual agents,\n   417→    or ad-hoc execution outside the full pipeline.\n   418→    \"\"\"\n   419→    manager = AgentManager(db=db, redis_client=redis)\n   420→\n   421→    # Validate agent exists\n   422→    try:\n   423→        manager._registry.get(agent_name)\n   424→    except KeyError as e:\n   425→        raise HTTPException(status_code=404, detail=str(e))\n   426→\n   427→    async def _run():\n   428→        try:\n   429→            record = await manager.run_single_agent(\n   430→                agent_name=agent_name,\n   431→                input_payload=payload.input_payload,\n   432→                pipeline_id=payload.pipeline_id,\n   433→            )\n   434→            logger.info(\n   435→                \"api.application.single_agent_complete\",\n   436→                agent=agent_name,\n   437→                status=record.status,\n   438→                duration_ms=record.duration_ms,\n   439→            )\n   440→        except Exception as e:\n   441→            logger.error(\n   442→                \"api.application.single_agent_failed\",\n   443→                agent=agent_name,\n   444→                error=str(e),\n   445→            )\n   446→\n   447→    background_tasks.add_task(_run)\n   448→\n   449→    return {\n   450→        \"agent\": agent_name,\n   451→        \"pipeline_id\": str(payload.pipeline_id),\n   452→        \"message\": f\"Agent '{agent_name}' dispatched\",\n   453→    }\n   454→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"e1a6c245-4572-4816-9d85-5634565bd455","uuid":"5dc66492-5433-45dd-8118-72f74dd6c44e","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/api/application.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nApplication Engine API — triggers and monitors the application pipeline.\n\nPOST   /application/start/{job_id}          → start pipeline for approved job\nPOST   /application/cloud/{job_id}          → start pipeline via cloud agent manager\nGET    /application/pipeline/{pipeline_id}  → get pipeline status + artifacts\nGET    /application/pipelines/{candidate_id} → list all pipelines for candidate\nGET    /application/crm/{candidate_id}      → CRM event log for all applications\nPOST   /application/submit/{pipeline_id}    → trigger auto-submit (post-approval)\nGET    /application/agents                  → list registered cloud sub-agents\nGET    /application/agents/plan             → preview execution plan (dependency tiers)\nPOST   /application/agents/{agent_name}     → run a single sub-agent in isolation\n\"\"\"\n\nfrom uuid import UUID\nfrom typing import Optional\n\nimport redis.asyncio as aioredis\nimport structlog\nfrom fastapi import APIRouter, Depends, HTTPException, BackgroundTasks, Query\nfrom pydantic import BaseModel\nfrom sqlalchemy import select, desc\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom backend.database import get_db\nfrom backend.api.discovery import get_redis\nfrom backend.agents.application.orchestrator import ApplicationOrchestrator\nfrom backend.agents.application.agent_manager import AgentManager\nfrom backend.agents.application.crm import CRM\nfrom backend.models.application import ApplicationPipeline, CRMEvent\n\nlogger = structlog.get_logger(__name__)\nrouter = APIRouter()\n\n\n# ─── Request/response schemas ─────────────────────────────────────────────────\n\nclass StartPipelineRequest(BaseModel):\n    \"\"\"Start an application pipeline for an approved job.\"\"\"\n    candidate_id: UUID\n\n\nclass CloudPipelineRequest(BaseModel):\n    \"\"\"Start a cloud-dispatched pipeline via the Agent Manager.\"\"\"\n    candidate_id: UUID\n    agents: Optional[list[str]] = None\n\n\nclass SingleAgentRequest(BaseModel):\n    \"\"\"Run a single sub-agent in isolation.\"\"\"\n    pipeline_id: UUID\n    input_payload: dict\n\n\nclass PipelineStatusResponse(BaseModel):\n    \"\"\"Current status of an application pipeline.\"\"\"\n    pipeline_id: UUID\n    job_id: UUID\n    candidate_id: UUID\n    status: str\n    current_step: Optional[str]\n    created_at: str\n    updated_at: str\n\n\n# ─── Endpoints ────────────────────────────────────────────────────────────────\n\n@router.post(\"/start/{job_id}\", response_model=PipelineStatusResponse)\nasync def start_pipeline(\n    job_id: UUID,\n    payload: StartPipelineRequest,\n    background_tasks: BackgroundTasks,\n    db: AsyncSession = Depends(get_db),\n    redis: aioredis.Redis = Depends(get_redis),\n):\n    \"\"\"\n    Start the application pipeline for an approved job.\n\n    Runs asynchronously — returns immediately with the pipeline ID.\n    Monitor progress via GET /application/pipeline/{pipeline_id}.\n    \"\"\"\n    orchestrator = ApplicationOrchestrator(db=db, redis_client=redis)\n\n    async def _run():\n        try:\n            await orchestrator.start(job_id=job_id, candidate_id=payload.candidate_id)\n        except Exception as e:\n            logger.error(\n                \"api.application.pipeline_failed\",\n                job_id=str(job_id),\n                error=str(e),\n            )\n\n    background_tasks.add_task(_run)\n\n    # Create pipeline record immediately so we can return its ID\n    from backend.models.application import ApplicationPipeline as APipeline\n    from datetime import datetime, timezone\n    pipeline = APipeline(\n        job_id=job_id,\n        candidate_id=payload.candidate_id,\n        status=\"QUEUED\",\n    )\n    db.add(pipeline)\n    await db.commit()\n    await db.refresh(pipeline)\n\n    logger.info(\n        \"api.application.pipeline_started\",\n        pipeline_id=str(pipeline.id),\n        job_id=str(job_id),\n    )\n\n    return PipelineStatusResponse(\n        pipeline_id=pipeline.id,\n        job_id=pipeline.job_id,\n        candidate_id=pipeline.candidate_id,\n        status=pipeline.status,\n        current_step=pipeline.current_step,\n        created_at=pipeline.created_at.isoformat(),\n        updated_at=pipeline.updated_at.isoformat(),\n    )\n\n\n@router.get(\"/pipeline/{pipeline_id}\", response_model=PipelineStatusResponse)\nasync def get_pipeline(\n    pipeline_id: UUID,\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"Get the current status and step of an application pipeline.\"\"\"\n    result = await db.execute(\n        select(ApplicationPipeline).where(ApplicationPipeline.id == pipeline_id)\n    )\n    pipeline = result.scalar_one_or_none()\n    if not pipeline:\n        raise HTTPException(status_code=404, detail=\"Pipeline not found\")\n\n    return PipelineStatusResponse(\n        pipeline_id=pipeline.id,\n        job_id=pipeline.job_id,\n        candidate_id=pipeline.candidate_id,\n        status=pipeline.status,\n        current_step=pipeline.current_step,\n        created_at=pipeline.created_at.isoformat(),\n        updated_at=pipeline.updated_at.isoformat(),\n    )\n\n\n@router.get(\"/pipelines/{candidate_id}\")\nasync def list_pipelines(\n    candidate_id: UUID,\n    status: Optional[str] = Query(default=None, description=\"Filter by status\"),\n    limit: int = Query(default=20, le=100),\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"List all application pipelines for a candidate, newest first.\"\"\"\n    query = (\n        select(ApplicationPipeline)\n        .where(ApplicationPipeline.candidate_id == candidate_id)\n        .order_by(desc(ApplicationPipeline.updated_at))\n        .limit(limit)\n    )\n    if status:\n        query = query.where(ApplicationPipeline.status == status)\n\n    result = await db.execute(query)\n    pipelines = result.scalars().all()\n\n    return [\n        {\n            \"pipeline_id\": str(p.id),\n            \"job_id\": str(p.job_id),\n            \"status\": p.status,\n            \"current_step\": p.current_step,\n            \"created_at\": p.created_at.isoformat(),\n            \"updated_at\": p.updated_at.isoformat(),\n        }\n        for p in pipelines\n    ]\n\n\n@router.get(\"/crm/{candidate_id}\")\nasync def get_crm_log(\n    candidate_id: UUID,\n    limit: int = Query(default=100, le=500),\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"Return CRM event log for all applications by this candidate.\"\"\"\n    result = await db.execute(\n        select(CRMEvent)\n        .where(CRMEvent.candidate_id == candidate_id)\n        .order_by(desc(CRMEvent.created_at))\n        .limit(limit)\n    )\n    events = result.scalars().all()\n\n    return [\n        {\n            \"id\": str(e.id),\n            \"pipeline_id\": str(e.pipeline_id),\n            \"job_id\": str(e.job_id),\n            \"event_type\": e.event_type,\n            \"details\": e.details,\n            \"created_at\": e.created_at.isoformat(),\n        }\n        for e in events\n    ]\n\n\n@router.post(\"/submit/{pipeline_id}\")\nasync def submit_application(\n    pipeline_id: UUID,\n    background_tasks: BackgroundTasks,\n    db: AsyncSession = Depends(get_db),\n    redis: aioredis.Redis = Depends(get_redis),\n):\n    \"\"\"\n    Trigger auto-submit for an APPROVED pipeline.\n\n    This is the second human confirmation — pipeline must be in APPROVED status.\n    \"\"\"\n    result = await db.execute(\n        select(ApplicationPipeline).where(ApplicationPipeline.id == pipeline_id)\n    )\n    pipeline = result.scalar_one_or_none()\n    if not pipeline:\n        raise HTTPException(status_code=404, detail=\"Pipeline not found\")\n    if pipeline.status != \"APPROVED\":\n        raise HTTPException(\n            status_code=422,\n            detail=f\"Pipeline must be in APPROVED status to submit (current: {pipeline.status})\",\n        )\n\n    orchestrator = ApplicationOrchestrator(db=db, redis_client=redis)\n\n    async def _submit():\n        try:\n            await orchestrator.submit(pipeline_id=pipeline_id)\n        except Exception as e:\n            logger.error(\"api.application.submit_failed\", pipeline_id=str(pipeline_id), error=str(e))\n\n    background_tasks.add_task(_submit)\n\n    logger.info(\"api.application.submit_triggered\", pipeline_id=str(pipeline_id))\n    return {\"pipeline_id\": str(pipeline_id), \"message\": \"Submission started\"}\n\n\n# ─── Cloud Agent Manager Endpoints ──────────────────────────────────────────\n\n\n@router.post(\"/cloud/{job_id}\")\nasync def start_cloud_pipeline(\n    job_id: UUID,\n    payload: CloudPipelineRequest,\n    background_tasks: BackgroundTasks,\n    db: AsyncSession = Depends(get_db),\n    redis: aioredis.Redis = Depends(get_redis),\n):\n    \"\"\"\n    Start the application pipeline via cloud-dispatched sub-agents.\n\n    Each sub-agent runs as an independent Claude API call with its own\n    system prompt and tool definitions. Agents within the same dependency\n    tier execute concurrently.\n\n    Returns immediately with pipeline ID. Monitor via GET /application/pipeline/{id}.\n    \"\"\"\n    from backend.models.application import ApplicationPipeline as APipeline\n\n    # Create pipeline record\n    pipeline = APipeline(\n        job_id=job_id,\n        candidate_id=payload.candidate_id,\n        status=\"QUEUED\",\n    )\n    db.add(pipeline)\n    await db.commit()\n    await db.refresh(pipeline)\n    pipeline_id = pipeline.id\n\n    # Load job data for the agent context\n    from backend.models.discovery import DiscoveredJob, Candidate as CandidateORM\n    job_result = await db.execute(\n        select(DiscoveredJob).where(DiscoveredJob.id == job_id)\n    )\n    job_orm = job_result.scalar_one_or_none()\n    if not job_orm:\n        raise HTTPException(status_code=404, detail=\"Job not found\")\n\n    candidate_result = await db.execute(\n        select(CandidateORM).where(CandidateORM.id == payload.candidate_id)\n    )\n    candidate_orm = candidate_result.scalar_one_or_none()\n    if not candidate_orm:\n        raise HTTPException(status_code=404, detail=\"Candidate not found\")\n\n    job_data = {\n        \"job_id\": str(job_orm.id),\n        \"title\": job_orm.title,\n        \"company\": job_orm.company,\n        \"description\": job_orm.description or \"\",\n        \"url\": job_orm.url,\n        \"location\": job_orm.location or \"\",\n        \"source\": job_orm.source or \"\",\n    }\n    candidate_data = {\n        \"id\": str(candidate_orm.id),\n        \"name\": candidate_orm.name,\n        \"email\": candidate_orm.email,\n        \"resume_text\": candidate_orm.resume_text or \"\",\n        \"linkedin_url\": candidate_orm.linkedin_url,\n        \"github_url\": candidate_orm.github_url,\n    }\n\n    async def _run_cloud():\n        try:\n            manager = AgentManager(db=db, redis_client=redis)\n            results = await manager.run_application_pipeline(\n                pipeline_id=pipeline_id,\n                job_data=job_data,\n                candidate_data=candidate_data,\n                agents=payload.agents,\n            )\n            # Update pipeline status based on results\n            all_completed = all(\n                r.status == \"COMPLETED\" for r in results.values()\n            )\n            final_status = \"AWAITING_REVIEW\" if all_completed else \"FAILED\"\n            pipeline.status = final_status\n            await db.commit()\n\n            logger.info(\n                \"api.application.cloud_pipeline_complete\",\n                pipeline_id=str(pipeline_id),\n                status=final_status,\n                agents_run=list(results.keys()),\n            )\n        except Exception as e:\n            logger.error(\n                \"api.application.cloud_pipeline_failed\",\n                pipeline_id=str(pipeline_id),\n                error=str(e),\n            )\n            pipeline.status = \"FAILED\"\n            await db.commit()\n\n    background_tasks.add_task(_run_cloud)\n\n    logger.info(\n        \"api.application.cloud_pipeline_started\",\n        pipeline_id=str(pipeline_id),\n        job_id=str(job_id),\n        agents=payload.agents,\n    )\n\n    return {\n        \"pipeline_id\": str(pipeline_id),\n        \"mode\": \"cloud\",\n        \"message\": \"Cloud agent pipeline dispatched\",\n        \"agents\": payload.agents or [\n            \"jd_parser\", \"resume_tailor\", \"company_intel\",\n            \"contact_finder\", \"outreach_composer\",\n        ],\n    }\n\n\n@router.get(\"/agents\")\nasync def list_agents(\n    db: AsyncSession = Depends(get_db),\n    redis: aioredis.Redis = Depends(get_redis),\n):\n    \"\"\"List all registered cloud sub-agents with their metadata.\"\"\"\n    manager = AgentManager(db=db, redis_client=redis)\n    return {\"agents\": manager.list_agents()}\n\n\n@router.get(\"/agents/plan\")\nasync def get_execution_plan(\n    agents: Optional[str] = Query(\n        default=None,\n        description=\"Comma-separated agent names (defaults to full pipeline)\",\n    ),\n    db: AsyncSession = Depends(get_db),\n    redis: aioredis.Redis = Depends(get_redis),\n):\n    \"\"\"\n    Preview the execution plan without running anything.\n\n    Returns tiers of agents — agents within a tier run concurrently.\n    \"\"\"\n    manager = AgentManager(db=db, redis_client=redis)\n    agent_list = agents.split(\",\") if agents else None\n    tiers = manager.get_execution_plan(agent_list)\n    return {\n        \"tiers\": [\n            {\"tier\": i, \"agents\": tier, \"concurrent\": len(tier) > 1}\n            for i, tier in enumerate(tiers)\n        ],\n    }\n\n\n@router.post(\"/agents/{agent_name}\")\nasync def run_single_agent(\n    agent_name: str,\n    payload: SingleAgentRequest,\n    background_tasks: BackgroundTasks,\n    db: AsyncSession = Depends(get_db),\n    redis: aioredis.Redis = Depends(get_redis),\n):\n    \"\"\"\n    Run a single sub-agent in isolation.\n\n    Useful for re-running a failed agent, testing individual agents,\n    or ad-hoc execution outside the full pipeline.\n    \"\"\"\n    manager = AgentManager(db=db, redis_client=redis)\n\n    # Validate agent exists\n    try:\n        manager._registry.get(agent_name)\n    except KeyError as e:\n        raise HTTPException(status_code=404, detail=str(e))\n\n    async def _run():\n        try:\n            record = await manager.run_single_agent(\n                agent_name=agent_name,\n                input_payload=payload.input_payload,\n                pipeline_id=payload.pipeline_id,\n            )\n            logger.info(\n                \"api.application.single_agent_complete\",\n                agent=agent_name,\n                status=record.status,\n                duration_ms=record.duration_ms,\n            )\n        except Exception as e:\n            logger.error(\n                \"api.application.single_agent_failed\",\n                agent=agent_name,\n                error=str(e),\n            )\n\n    background_tasks.add_task(_run)\n\n    return {\n        \"agent\": agent_name,\n        \"pipeline_id\": str(payload.pipeline_id),\n        \"message\": f\"Agent '{agent_name}' dispatched\",\n    }\n","numLines":454,"startLine":1,"totalLines":454}}}}
