     - apply-agent\n      - scheduler-agent\n    capabilities:\n      - postgresql\n      - sqlalchemy\n      - alembic\n      - pydantic\n    sub_agents:\n      - id: data-agent.migrations.init\n        scope: backend/migrations/001_init.sql — extensions, candidates table baseline\n      - id: data-agent.migrations.discovery\n        scope: backend/migrations/002_discovery.sql — discovered_jobs, scored_jobs,\n          daily_digests, crawl_runs per HYPHA-SCHEMA-CORE\n      - id: data-agent.migrations.application\n        scope: backend/migrations/003_application.sql — applications,\n          application_events, outreach_messages, contacts\n      - id: data-agent.migrations.auth\n        scope: backend/migrations/004_auth.sql — magic_link_tokens, sessions\n      - id: data-agent.models.base\n        scope: backend/models/__init__.py + base Declarative class with UUID PK +\n          created_at/updated_at mixins\n      - id: data-agent.models.discovery\n        scope: backend/models/discovery.py — Candidate, DiscoveredJob, ScoredJob,\n          DailyDigest, CrawlRun ORM\n      - id: data-agent.models.application\n        scope: backend/models/application.py — Application, ApplicationEvent,\n          OutreachMessage, Contact ORM\n      - id: data-agent.models.auth\n        scope: backend/models/auth.py — MagicLinkToken, Session ORM\n      - id: data-agent.schemas.discovery\n        scope: backend/agents/discovery/schemas.py — Pydantic v2 schemas for all\n          discovery contracts\n      - id: data-agent.schemas.application\n        scope: backend/agents/application/schemas.py — Pydantic v2 schemas for\n          application contracts\n  - id: design-agent\n    scope: Design tokens, Top Shelf editorial, CSS custom properties, typography,\n      StatusBadge, StatCard\n    branch: feat/design-agent\n    blocked_by: []\n    blocks:\n      - frontend-agent\n    capabilities:\n      - tailwind\n      - css-tokens\n      - design-system\n    sub_agents:\n      - id: de