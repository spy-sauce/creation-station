{"t":"2026-05-28T02:54:23.831Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019bqq2W38S4yxi9XBo1yjJG","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→SSE Event Stream — real-time agent status streaming.\n     6→\n     7→GET /events/stream?channel=agent.status.discovery\n     8→GET /events/stream?channel=agent.status.application\n     9→\n    10→Streams Redis pub/sub events to the frontend via Server-Sent Events.\n    11→Contract: HYPHA-API-STREAMING.md + NUTRIENTS.md § API_CONTRACTS (iter-4 additions)\n    12→\n    13→SSE format:\n    14→  - data: {json}\\\\n\\\\n for each message\n    15→  - :ping\\\\n\\\\n every 15s for connection keepalive\n    16→  - event: slow_client\\\\ndata: {\"dropped\": N}\\\\n\\\\n on backpressure\n    17→\n    18→Channel allowlist:\n    19→  - agent.status.discovery\n    20→  - agent.status.application\n    21→\n    22→Exports:\n    23→  - router: FastAPI APIRouter with /stream endpoint\n    24→  - SSESubscriber: Redis pub/sub subscriber class with channel allowlist\n    25→  - ALLOWED_CHANNELS: Frozenset of allowed channel names\n    26→\"\"\"\n    27→\n    28→from __future__ import annotations\n    29→\n    30→__all__ = [\n    31→    \"router\",\n    32→    \"SSESubscriber\",\n    33→    \"ALLOWED_CHANNELS\",\n    34→    \"HEARTBEAT_INTERVAL_SECONDS\",\n    35→    \"MAX_QUEUE_SIZE\",\n    36→]\n    37→\n    38→import asyncio\n    39→from typing import AsyncGenerator\n    40→\n    41→import redis.asyncio as aioredis\n    42→import structlog\n    43→from fastapi import APIRouter, Depends, HTTPException, Query\n    44→from fastapi.responses import StreamingResponse\n    45→\n    46→from backend.api.auth import get_current_user\n    47→from backend.database import get_redis\n    48→from backend.models.auth import User\n    49→from backend.observability.events import PubSubChannel\n    50→\n    51→logger = structlog.get_logger(__name__)\n    52→\n    53→router = APIRouter()\n    54→\n    55→# ─── Constants ────────────────────────────────────────────────────────────────\n    56→\n    57→# Allowed SSE channels (frozen contract from NUTRIENTS.md)\n    58→ALLOWED_CHANNELS: frozenset[str] = frozenset({\n    59→    PubSubChannel.DISCOVERY.value,    # agent.status.discovery\n    60→    PubSubChannel.APPLICATION.value,  # agent.status.application\n    61→})\n    62→\n    63→# Heartbeat interval in seconds\n    64→HEARTBEAT_INTERVAL_SECONDS: float = 15.0\n    65→\n    66→# Backpressure threshold — drop oldest messages if queue exceeds this\n    67→MAX_QUEUE_SIZE: int = 100\n    68→\n    69→\n    70→# ─── SSE Subscriber ───────────────────────────────────────────────────────────\n    71→\n    72→\n    73→class SSESubscriber:\n    74→    \"\"\"\n    75→    Redis pub/sub subscriber with channel allowlist for SSE streaming.\n    76→\n    77→    This class encapsulates the Redis subscription lifecycle:\n    78→      - Validates channels against the frozen allowlist\n    79→      - Subscribes to the Redis pub/sub channel\n    80→      - Buffers messages in an async queue with backpressure handling\n    81→      - Provides an async generator for SSE frame emission\n    82→\n    83→    Contract: NUTRIENTS.md § C. Symbol Ownership Matrix (iter-4 additions)\n    84→\n    85→    Attributes:\n    86→        redis_client: Async Redis client for pub/sub operations\n    87→        channel: Validated Redis channel to subscribe to\n    88→        user_id: Authenticated user ID for logging context\n    89→        queue: Internal message buffer with backpressure handling\n    90→        dropped_count: Counter for messages dropped due to slow client\n    91→\n    92→    Example:\n    93→        >>> subscriber = SSESubscriber(redis_client, \"agent.status.discovery\", user_id)\n    94→        >>> async for frame in subscriber.stream():\n    95→        ...     yield frame\n    96→    \"\"\"\n    97→\n    98→    def __init__(\n    99→        self,\n   100→        redis_client: aioredis.Redis,\n   101→        channel: str,\n   102→        user_id: str,\n   103→    ) -> None:\n   104→        \"\"\"\n   105→        Initialize an SSE subscriber for a Redis pub/sub channel.\n   106→\n   107→        Args:\n   108→            redis_client: Async Redis client for pub/sub subscription\n   109→            channel: Redis channel to subscribe to (must be in ALLOWED_CHANNELS)\n   110→            user_id: Authenticated user ID (for logging context)\n   111→\n   112→        Raises:\n   113→            ValueError: If channel is not in the allowlist\n   114→        \"\"\"\n   115→        if channel not in ALLOWED_CHANNELS:\n   116→            allowed_list = \", \".join(sorted(ALLOWED_CHANNELS))\n   117→            raise ValueError(f\"Invalid channel. Allowed: {allowed_list}\")\n   118→\n   119→        self.redis_client = redis_client\n   120→        self.channel = channel\n   121→        self.user_id = user_id\n   122→        self._pubsub: aioredis.client.PubSub | None = None\n   123→        self._message_queue: asyncio.Queue[str] = asyncio.Queue()\n   124→        self._dropped_count: int = 0\n   125→        self._reader_task: asyncio.Task | None = None\n   126→\n   127→    async def _reader(self) -> None:\n   128→        \"\"\"\n   129→        Background task that reads from Redis pub/sub and pushes to queue.\n   130→\n   131→        Handles backpressure by dropping oldest messages when queue is full.\n   132→        This prevents memory exhaustion when clients fall behind.\n   133→        \"\"\"\n   134→        try:\n   135→            self._pubsub = self.redis_client.pubsub()\n   136→            await self._pubsub.subscribe(self.channel)\n   137→\n   138→            async for message in self._pubsub.listen():\n   139→                if message[\"type\"] == \"message\":\n   140→                    data = message[\"data\"]\n   141→\n   142→                    # Backpressure: drop oldest messages if queue is full\n   143→                    while self._message_queue.qsize() >= MAX_QUEUE_SIZE:\n   144→                        try:\n   145→                            self._message_queue.get_nowait()\n   146→                            self._dropped_count += 1\n   147→                        except asyncio.QueueEmpty:\n   148→                            break\n   149→\n   150→                    await self._message_queue.put(data)\n   151→\n   152→        except asyncio.CancelledError:\n   153→            pass\n   154→        except Exception as exc:\n   155→            logger.error(\n   156→                \"sse.subscriber_reader_error\",\n   157→                channel=self.channel,\n   158→                user_id=self.user_id,\n   159→                error=str(exc),\n   160→            )\n   161→\n   162→    async def stream(self) -> AsyncGenerator[str, None]:\n   163→        \"\"\"\n   164→        Async generator that yields SSE frames from the subscription.\n   165→\n   166→        Yields:\n   167→            SSE-formatted strings:\n   168→              - data: {json}\\\\n\\\\n for each message\n   169→              - :ping\\\\n\\\\n every 15s for keepalive\n   170→              - event: slow_client\\\\ndata: {\"dropped\": N}\\\\n\\\\n on backpressure\n   171→\n   172→        The generator handles cleanup on cancellation or error, ensuring\n   173→        the Redis subscription is properly closed.\n   174→        \"\"\"\n   175→        logger.info(\n   176→            \"sse.subscriber_started\",\n   177→            channel=self.channel,\n   178→            user_id=self.user_id,\n   179→        )\n   180→\n   181→        # Start the background reader\n   182→        self._reader_task = asyncio.create_task(self._reader())\n   183→\n   184→        try:\n   185→            while True:\n   186→                try:\n   187→                    # Wait for message with timeout (for heartbeat)\n   188→                    message = await asyncio.wait_for(\n   189→                        self._message_queue.get(),\n   190→                        timeout=HEARTBEAT_INTERVAL_SECONDS,\n   191→                    )\n   192→\n   193→                    # Emit slow_client warning if messages were dropped\n   194→                    if self._dropped_count > 0:\n   195→                        yield f\"event: slow_client\\ndata: {{\\\"dropped\\\": {self._dropped_count}}}\\n\\n\"\n   196→                        logger.warning(\n   197→                            \"sse.slow_client\",\n   198→                            channel=self.channel,\n   199→                            user_id=self.user_id,\n   200→                            dropped=self._dropped_count,\n   201→                        )\n   202→                        self._dropped_count = 0\n   203→\n   204→                    # Emit the actual message\n   205→                    yield f\"data: {message}\\n\\n\"\n   206→\n   207→                except asyncio.TimeoutError:\n   208→                    # No message within heartbeat interval — send keepalive\n   209→                    yield \":ping\\n\\n\"\n   210→\n   211→        except asyncio.CancelledError:\n   212→            logger.info(\n   213→                \"sse.subscriber_cancelled\",\n   214→                channel=self.channel,\n   215→                user_id=self.user_id,\n   216→            )\n   217→        except Exception as exc:\n   218→            logger.error(\n   219→                \"sse.subscriber_error\",\n   220→                channel=self.channel,\n   221→                user_id=self.user_id,\n   222→                error=str(exc),\n   223→            )\n   224→        finally:\n   225→            await self._cleanup()\n   226→\n   227→    async def _cleanup(self) -> None:\n   228→        \"\"\"Clean up resources: cancel reader task and close subscription.\"\"\"\n   229→        if self._reader_task:\n   230→            self._reader_task.cancel()\n   231→            try:\n   232→                await self._reader_task\n   233→            except asyncio.CancelledError:\n   234→                pass\n   235→\n   236→        if self._pubsub:\n   237→            try:\n   238→                await self._pubsub.unsubscribe(self.channel)\n   239→                await self._pubsub.close()\n   240→            except Exception as exc:\n   241→                logger.warning(\n   242→                    \"sse.subscriber_cleanup_error\",\n   243→                    channel=self.channel,\n   244→                    error=str(exc),\n   245→                )\n   246→\n   247→        logger.info(\n   248→            \"sse.subscriber_closed\",\n   249→            channel=self.channel,\n   250→            user_id=self.user_id,\n   251→        )\n   252→\n   253→\n   254→# ─── SSE Generator (legacy wrapper) ───────────────────────────────────────────\n   255→\n   256→\n   257→async def sse_event_generator(\n   258→    redis_client: aioredis.Redis,\n   259→    channel: str,\n   260→    user_id: str,\n   261→) -> AsyncGenerator[str, None]:\n   262→    \"\"\"\n   263→    Generate SSE frames from Redis pub/sub messages.\n   264→\n   265→    Args:\n   266→        redis_client: Async Redis client for pub/sub subscription\n   267→        channel: Redis channel to subscribe to\n   268→        user_id: Authenticated user ID (for logging)\n   269→\n   270→    Yields:\n   271→        SSE-formatted strings (data: {json}\\n\\n or :ping\\n\\n)\n   272→\n   273→    Contract:\n   274→        - Each message yields: data: {json}\\n\\n\n   275→        - Heartbeat every 15s: :ping\\n\\n\n   276→        - Backpressure: if queue > 100, drop oldest and emit slow_client event\n   277→    \"\"\"\n   278→    pubsub = redis_client.pubsub()\n   279→    message_queue: asyncio.Queue[str] = asyncio.Queue()\n   280→    dropped_count: int = 0\n   281→\n   282→    logger.info(\n   283→        \"sse.connection_started\",\n   284→        channel=channel,\n   285→        user_id=user_id,\n   286→    )\n   287→\n   288→    async def reader_task() -> None:\n   289→        \"\"\"\n   290→        Background task that reads from Redis pub/sub and pushes to queue.\n   291→\n   292→        Handles backpressure by dropping oldest messages when queue is full.\n   293→        \"\"\"\n   294→        nonlocal dropped_count\n   295→\n   296→        try:\n   297→            await pubsub.subscribe(channel)\n   298→            async for message in pubsub.listen():\n   299→                if message[\"type\"] == \"message\":\n   300→                    data = message[\"data\"]\n   301→\n   302→                    # Backpressure check\n   303→                    while message_queue.qsize() >= MAX_QUEUE_SIZE:\n   304→                        try:\n   305→                            message_queue.get_nowait()\n   306→                            dropped_count += 1\n   307→                        except asyncio.QueueEmpty:\n   308→                            break\n   309→\n   310→                    await message_queue.put(data)\n   311→        except asyncio.CancelledError:\n   312→            pass\n   313→        except Exception as exc:\n   314→            logger.error(\n   315→                \"sse.reader_error\",\n   316→                channel=channel,\n   317→                user_id=user_id,\n   318→                error=str(exc),\n   319→            )\n   320→\n   321→    # Start the background reader\n   322→    reader = asyncio.create_task(reader_task())\n   323→\n   324→    try:\n   325→        while True:\n   326→            try:\n   327→                # Wait for message with timeout (for heartbeat)\n   328→                message = await asyncio.wait_for(\n   329→                    message_queue.get(),\n   330→                    timeout=HEARTBEAT_INTERVAL_SECONDS,\n   331→                )\n   332→\n   333→                # Emit slow_client warning if messages were dropped\n   334→                if dropped_count > 0:\n   335→                    yield f\"event: slow_client\\ndata: {{\\\"dropped\\\": {dropped_count}}}\\n\\n\"\n   336→                    logger.warning(\n   337→                        \"sse.slow_client\",\n   338→                        channel=channel,\n   339→                        user_id=user_id,\n   340→                        dropped=dropped_count,\n   341→                    )\n   342→                    dropped_count = 0\n   343→\n   344→                # Emit the actual message\n   345→                yield f\"data: {message}\\n\\n\"\n   346→\n   347→            except asyncio.TimeoutError:\n   348→                # No message within heartbeat interval — send keepalive\n   349→                yield \":ping\\n\\n\"\n   350→\n   351→    except asyncio.CancelledError:\n   352→        logger.info(\n   353→            \"sse.connection_cancelled\",\n   354→            channel=channel,\n   355→            user_id=user_id,\n   356→        )\n   357→    except Exception as exc:\n   358→        logger.error(\n   359→            \"sse.generator_error\",\n   360→            channel=channel,\n   361→            user_id=user_id,\n   362→            error=str(exc),\n   363→        )\n   364→    finally:\n   365→        # Cleanup: cancel reader and unsubscribe\n   366→        reader.cancel()\n   367→        try:\n   368→            await reader\n   369→        except asyncio.CancelledError:\n   370→            pass\n   371→\n   372→        try:\n   373→            await pubsub.unsubscribe(channel)\n   374→            await pubsub.close()\n   375→        except Exception as exc:\n   376→            logger.warning(\n   377→                \"sse.cleanup_error\",\n   378→                channel=channel,\n   379→                error=str(exc),\n   380→            )\n   381→\n   382→        logger.info(\n   383→            \"sse.connection_closed\",\n   384→            channel=channel,\n   385→            user_id=user_id,\n   386→        )\n   387→\n   388→\n   389→# ─── Endpoint ─────────────────────────────────────────────────────────────────\n   390→\n   391→\n   392→@router.get(\"/stream\")\n   393→async def event_stream(\n   394→    channel: str = Query(\n   395→        ...,\n   396→        description=\"Redis pub/sub channel to subscribe to\",\n   397→        examples=[\"agent.status.discovery\", \"agent.status.application\"],\n   398→    ),\n   399→    current_user: User = Depends(get_current_user),\n   400→    redis_client: aioredis.Redis = Depends(get_redis),\n   401→) -> StreamingResponse:\n   402→    \"\"\"\n   403→    Stream real-time agent status events via Server-Sent Events.\n   404→\n   405→    Args:\n   406→        channel: Redis pub/sub channel to subscribe to.\n   407→            Allowed: agent.status.discovery, agent.status.application\n   408→\n   409→    Returns:\n   410→        StreamingResponse with Content-Type: text/event-stream\n   411→\n   412→    Raises:\n   413→        400: Invalid channel (not in allowlist)\n   414→        401: Not authenticated (missing or invalid JWT)\n   415→\n   416→    Contract: NUTRIENTS.md § API_CONTRACTS → GET /events/stream\n   417→    \"\"\"\n   418→    # Validate channel against allowlist (also validated in SSESubscriber)\n   419→    if channel not in ALLOWED_CHANNELS:\n   420→        allowed_list = \", \".join(sorted(ALLOWED_CHANNELS))\n   421→        raise HTTPException(\n   422→            status_code=400,\n   423→            detail=f\"Invalid channel. Allowed: {allowed_list}\",\n   424→        )\n   425→\n   426→    logger.info(\n   427→        \"sse.stream_requested\",\n   428→        channel=channel,\n   429→        user_id=str(current_user.id),\n   430→    )\n   431→\n   432→    # Create subscriber with channel allowlist validation\n   433→    subscriber = SSESubscriber(\n   434→        redis_client=redis_client,\n   435→        channel=channel,\n   436→        user_id=str(current_user.id),\n   437→    )\n   438→\n   439→    return StreamingResponse(\n   440→        subscriber.stream(),\n   441→        media_type=\"text/event-stream\",\n   442→        headers={\n   443→            \"Cache-Control\": \"no-cache\",\n   444→            \"Connection\": \"keep-alive\",\n   445→            \"X-Accel-Buffering\": \"no\",  # Disable nginx buffering\n   446→        },\n   447→    )\n   448→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"4abf431d-40e8-4b65-91bf-402517737050","uuid":"c5132b55-e977-422b-af07-6511b1153c84","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/api/events.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nSSE Event Stream — real-time agent status streaming.\n\nGET /events/stream?channel=agent.status.discovery\nGET /events/stream?channel=agent.status.application\n\nStreams Redis pub/sub events to the frontend via Server-Sent Events.\nContract: HYPHA-API-STREAMING.md + NUTRIENTS.md § API_CONTRACTS (iter-4 additions)\n\nSSE format:\n  - data: {json}\\\\n\\\\n for each message\n  - :ping\\\\n\\\\n every 15s for connection keepalive\n  - event: slow_client\\\\ndata: {\"dropped\": N}\\\\n\\\\n on backpressure\n\nChannel allowlist:\n  - agent.status.discovery\n  - agent.status.application\n\nExports:\n  - router: FastAPI APIRouter with /stream endpoint\n  - SSESubscriber: Redis pub/sub subscriber class with channel allowlist\n  - ALLOWED_CHANNELS: Frozenset of allowed channel names\n\"\"\"\n\nfrom __future__ import annotations\n\n__all__ = [\n    \"router\",\n    \"SSESubscriber\",\n    \"ALLOWED_CHANNELS\",\n    \"HEARTBEAT_INTERVAL_SECONDS\",\n    \"MAX_QUEUE_SIZE\",\n]\n\nimport asyncio\nfrom typing import AsyncGenerator\n\nimport redis.asyncio as aioredis\nimport structlog\nfrom fastapi import APIRouter, Depends, HTTPException, Query\nfrom fastapi.responses import StreamingResponse\n\nfrom backend.api.auth import get_current_user\nfrom backend.database import get_redis\nfrom backend.models.auth import User\nfrom backend.observability.events import PubSubChannel\n\nlogger = structlog.get_logger(__name__)\n\nrouter = APIRouter()\n\n# ─── Constants ────────────────────────────────────────────────────────────────\n\n# Allowed SSE channels (frozen contract from NUTRIENTS.md)\nALLOWED_CHANNELS: frozenset[str] = frozenset({\n    PubSubChannel.DISCOVERY.value,    # agent.status.discovery\n    PubSubChannel.APPLICATION.value,  # agent.status.application\n})\n\n# Heartbeat interval in seconds\nHEARTBEAT_INTERVAL_SECONDS: float = 15.0\n\n# Backpressure threshold — drop oldest messages if queue exceeds this\nMAX_QUEUE_SIZE: int = 100\n\n\n# ─── SSE Subscriber ───────────────────────────────────────────────────────────\n\n\nclass SSESubscriber:\n    \"\"\"\n    Redis pub/sub subscriber with channel allowlist for SSE streaming.\n\n    This class encapsulates the Redis subscription lifecycle:\n      - Validates channels against the frozen allowlist\n      - Subscribes to the Redis pub/sub channel\n      - Buffers messages in an async queue with backpressure handling\n      - Provides an async generator for SSE frame emission\n\n    Contract: NUTRIENTS.md § C. Symbol Ownership Matrix (iter-4 additions)\n\n    Attributes:\n        redis_client: Async Redis client for pub/sub operations\n        channel: Validated Redis channel to subscribe to\n        user_id: Authenticated user ID for logging context\n        queue: Internal message buffer with backpressure handling\n        dropped_count: Counter for messages dropped due to slow client\n\n    Example:\n        >>> subscriber = SSESubscriber(redis_client, \"agent.status.discovery\", user_id)\n        >>> async for frame in subscriber.stream():\n        ...     yield frame\n    \"\"\"\n\n    def __init__(\n        self,\n        redis_client: aioredis.Redis,\n        channel: str,\n        user_id: str,\n    ) -> None:\n        \"\"\"\n        Initialize an SSE subscriber for a Redis pub/sub channel.\n\n        Args:\n            redis_client: Async Redis client for pub/sub subscription\n            channel: Redis channel to subscribe to (must be in ALLOWED_CHANNELS)\n            user_id: Authenticated user ID (for logging context)\n\n        Raises:\n            ValueError: If channel is not in the allowlist\n        \"\"\"\n        if channel not in ALLOWED_CHANNELS:\n            allowed_list = \", \".join(sorted(ALLOWED_CHANNELS))\n            raise ValueError(f\"Invalid channel. Allowed: {allowed_list}\")\n\n        self.redis_client = redis_client\n        self.channel = channel\n        self.user_id = user_id\n        self._pubsub: aioredis.client.PubSub | None = None\n        self._message_queue: asyncio.Queue[str] = asyncio.Queue()\n        self._dropped_count: int = 0\n        self._reader_task: asyncio.Task | None = None\n\n    async def _reader(self) -> None:\n        \"\"\"\n        Background task that reads from Redis pub/sub and pushes to queue.\n\n        Handles backpressure by dropping oldest messages when queue is full.\n        This prevents memory exhaustion when clients fall behind.\n        \"\"\"\n        try:\n            self._pubsub = self.redis_client.pubsub()\n            await self._pubsub.subscribe(self.channel)\n\n            async for message in self._pubsub.listen():\n                if message[\"type\"] == \"message\":\n                    data = message[\"data\"]\n\n                    # Backpressure: drop oldest messages if queue is full\n                    while self._message_queue.qsize() >= MAX_QUEUE_SIZE:\n                        try:\n                            self._message_queue.get_nowait()\n                            self._dropped_count += 1\n                        except asyncio.QueueEmpty:\n                            break\n\n                    await self._message_queue.put(data)\n\n        except asyncio.CancelledError:\n            pass\n        except Exception as exc:\n            logger.error(\n                \"sse.subscriber_reader_error\",\n                channel=self.channel,\n                user_id=self.user_id,\n                error=str(exc),\n            )\n\n    async def stream(self) -> AsyncGenerator[str, None]:\n        \"\"\"\n        Async generator that yields SSE frames from the subscription.\n\n        Yields:\n            SSE-formatted strings:\n              - data: {json}\\\\n\\\\n for each message\n              - :ping\\\\n\\\\n every 15s for keepalive\n              - event: slow_client\\\\ndata: {\"dropped\": N}\\\\n\\\\n on backpressure\n\n        The generator handles cleanup on cancellation or error, ensuring\n        the Redis subscription is properly closed.\n        \"\"\"\n        logger.info(\n            \"sse.subscriber_started\",\n            channel=self.channel,\n            user_id=self.user_id,\n        )\n\n        # Start the background reader\n        self._reader_task = asyncio.create_task(self._reader())\n\n        try:\n            while True:\n                try:\n                    # Wait for message with timeout (for heartbeat)\n                    message = await asyncio.wait_for(\n                        self._message_queue.get(),\n                        timeout=HEARTBEAT_INTERVAL_SECONDS,\n                    )\n\n                    # Emit slow_client warning if messages were dropped\n                    if self._dropped_count > 0:\n                        yield f\"event: slow_client\\ndata: {{\\\"dropped\\\": {self._dropped_count}}}\\n\\n\"\n                        logger.warning(\n                            \"sse.slow_client\",\n                            channel=self.channel,\n                            user_id=self.user_id,\n                            dropped=self._dropped_count,\n                        )\n                        self._dropped_count = 0\n\n                    # Emit the actual message\n                    yield f\"data: {message}\\n\\n\"\n\n                except asyncio.TimeoutError:\n                    # No message within heartbeat interval — send keepalive\n                    yield \":ping\\n\\n\"\n\n        except asyncio.CancelledError:\n            logger.info(\n                \"sse.subscriber_cancelled\",\n                channel=self.channel,\n                user_id=self.user_id,\n            )\n        except Exception as exc:\n            logger.error(\n                \"sse.subscriber_error\",\n                channel=self.channel,\n                user_id=self.user_id,\n                error=str(exc),\n            )\n        finally:\n            await self._cleanup()\n\n    async def _cleanup(self) -> None:\n        \"\"\"Clean up resources: cancel reader task and close subscription.\"\"\"\n        if self._reader_task:\n            self._reader_task.cancel()\n            try:\n                await self._reader_task\n            except asyncio.CancelledError:\n                pass\n\n        if self._pubsub:\n            try:\n                await self._pubsub.unsubscribe(self.channel)\n                await self._pubsub.close()\n            except Exception as exc:\n                logger.warning(\n                    \"sse.subscriber_cleanup_error\",\n                    channel=self.channel,\n                    error=str(exc),\n                )\n\n        logger.info(\n            \"sse.subscriber_closed\",\n            channel=self.channel,\n            user_id=self.user_id,\n        )\n\n\n# ─── SSE Generator (legacy wrapper) ───────────────────────────────────────────\n\n\nasync def sse_event_generator(\n    redis_client: aioredis.Redis,\n    channel: str,\n    user_id: str,\n) -> AsyncGenerator[str, None]:\n    \"\"\"\n    Generate SSE frames from Redis pub/sub messages.\n\n    Args:\n        redis_client: Async Redis client for pub/sub subscription\n        channel: Redis channel to subscribe to\n        user_id: Authenticated user ID (for logging)\n\n    Yields:\n        SSE-formatted strings (data: {json}\\n\\n or :ping\\n\\n)\n\n    Contract:\n        - Each message yields: data: {json}\\n\\n\n        - Heartbeat every 15s: :ping\\n\\n\n        - Backpressure: if queue > 100, drop oldest and emit slow_client event\n    \"\"\"\n    pubsub = redis_client.pubsub()\n    message_queue: asyncio.Queue[str] = asyncio.Queue()\n    dropped_count: int = 0\n\n    logger.info(\n        \"sse.connection_started\",\n        channel=channel,\n        user_id=user_id,\n    )\n\n    async def reader_task() -> None:\n        \"\"\"\n        Background task that reads from Redis pub/sub and pushes to queue.\n\n        Handles backpressure by dropping oldest messages when queue is full.\n        \"\"\"\n        nonlocal dropped_count\n\n        try:\n            await pubsub.subscribe(channel)\n            async for message in pubsub.listen():\n                if message[\"type\"] == \"message\":\n                    data = message[\"data\"]\n\n                    # Backpressure check\n                    while message_queue.qsize() >= MAX_QUEUE_SIZE:\n                        try:\n                            message_queue.get_nowait()\n                            dropped_count += 1\n                        except asyncio.QueueEmpty:\n                            break\n\n                    await message_queue.put(data)\n        except asyncio.CancelledError:\n            pass\n        except Exception as exc:\n            logger.error(\n                \"sse.reader_error\",\n                channel=channel,\n                user_id=user_id,\n                error=str(exc),\n            )\n\n    # Start the background reader\n    reader = asyncio.create_task(reader_task())\n\n    try:\n        while True:\n            try:\n                # Wait for message with timeout (for heartbeat)\n                message = await asyncio.wait_for(\n                    message_queue.get(),\n                    timeout=HEARTBEAT_INTERVAL_SECONDS,\n                )\n\n                # Emit slow_client warning if messages were dropped\n                if dropped_count > 0:\n                    yield f\"event: slow_client\\ndata: {{\\\"dropped\\\": {dropped_count}}}\\n\\n\"\n                    logger.warning(\n                        \"sse.slow_client\",\n                        channel=channel,\n                        user_id=user_id,\n                        dropped=dropped_count,\n                    )\n                    dropped_count = 0\n\n                # Emit the actual message\n                yield f\"data: {message}\\n\\n\"\n\n            except asyncio.TimeoutError:\n                # No message within heartbeat interval — send keepalive\n                yield \":ping\\n\\n\"\n\n    except asyncio.CancelledError:\n        logger.info(\n            \"sse.connection_cancelled\",\n            channel=channel,\n            user_id=user_id,\n        )\n    except Exception as exc:\n        logger.error(\n            \"sse.generator_error\",\n            channel=channel,\n            user_id=user_id,\n            error=str(exc),\n        )\n    finally:\n        # Cleanup: cancel reader and unsubscribe\n        reader.cancel()\n        try:\n            await reader\n        except asyncio.CancelledError:\n            pass\n\n        try:\n            await pubsub.unsubscribe(channel)\n            await pubsub.close()\n        except Exception as exc:\n            logger.warning(\n                \"sse.cleanup_error\",\n                channel=channel,\n                error=str(exc),\n            )\n\n        logger.info(\n            \"sse.connection_closed\",\n            channel=channel,\n            user_id=user_id,\n        )\n\n\n# ─── Endpoint ─────────────────────────────────────────────────────────────────\n\n\n@router.get(\"/stream\")\nasync def event_stream(\n    channel: str = Query(\n        ...,\n        description=\"Redis pub/sub channel to subscribe to\",\n        examples=[\"agent.status.discovery\", \"agent.status.application\"],\n    ),\n    current_user: User = Depends(get_current_user),\n    redis_client: aioredis.Redis = Depends(get_redis),\n) -> StreamingResponse:\n    \"\"\"\n    Stream real-time agent status events via Server-Sent Events.\n\n    Args:\n        channel: Redis pub/sub channel to subscribe to.\n            Allowed: agent.status.discovery, agent.status.application\n\n    Returns:\n        StreamingResponse with Content-Type: text/event-stream\n\n    Raises:\n        400: Invalid channel (not in allowlist)\n        401: Not authenticated (missing or invalid JWT)\n\n    Contract: NUTRIENTS.md § API_CONTRACTS → GET /events/stream\n    \"\"\"\n    # Validate channel against allowlist (also validated in SSESubscriber)\n    if channel not in ALLOWED_CHANNELS:\n        allowed_list = \", \".join(sorted(ALLOWED_CHANNELS))\n        raise HTTPException(\n            status_code=400,\n            detail=f\"Invalid channel. Allowed: {allowed_list}\",\n        )\n\n    logger.info(\n        \"sse.stream_requested\",\n        channel=channel,\n        user_id=str(current_user.id),\n    )\n\n    # Create subscriber with channel allowlist validation\n    subscriber = SSESubscriber(\n        redis_client=redis_client,\n        channel=channel,\n        user_id=str(current_user.id),\n    )\n\n    return StreamingResponse(\n        subscriber.stream(),\n        media_type=\"text/event-stream\",\n        headers={\n            \"Cache-Control\": \"no-cache\",\n            \"Connection\": \"keep-alive\",\n            \"X-Accel-Buffering\": \"no\",  # Disable nginx buffering\n        },\n    )\n","numLines":448,"startLine":1,"totalLines":448}}}}
