{"t":"2026-05-28T02:53:13.415Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V8RtHi99JxbriRNT6NMiBr","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→SSE Event Stream — real-time agent status streaming.\n     6→\n     7→GET /events/stream?channel=agent.status.discovery\n     8→GET /events/stream?channel=agent.status.application\n     9→\n    10→Streams Redis pub/sub events to the frontend via Server-Sent Events.\n    11→Contract: HYPHA-API-STREAMING.md + NUTRIENTS.md § API_CONTRACTS (iter-4 additions)\n    12→\n    13→SSE format:\n    14→  - data: {json}\\n\\n for each message\n    15→  - :ping\\n\\n every 15s for connection keepalive\n    16→  - event: slow_client\\ndata: {\"dropped\": N}\\n\\n on backpressure\n    17→\n    18→Channel allowlist:\n    19→  - agent.status.discovery\n    20→  - agent.status.application\n    21→\"\"\"\n    22→\n    23→from __future__ import annotations\n    24→\n    25→import asyncio\n    26→from typing import AsyncGenerator\n    27→\n    28→import redis.asyncio as aioredis\n    29→import structlog\n    30→from fastapi import APIRouter, Depends, HTTPException, Query\n    31→from fastapi.responses import StreamingResponse\n    32→\n    33→from backend.api.auth import get_current_user\n    34→from backend.database import get_redis\n    35→from backend.models.auth import User\n    36→from backend.observability.events import PubSubChannel\n    37→\n    38→logger = structlog.get_logger(__name__)\n    39→\n    40→router = APIRouter()\n    41→\n    42→# ─── Constants ────────────────────────────────────────────────────────────────\n    43→\n    44→# Allowed SSE channels (frozen contract from NUTRIENTS.md)\n    45→ALLOWED_CHANNELS: frozenset[str] = frozenset({\n    46→    PubSubChannel.DISCOVERY.value,    # agent.status.discovery\n    47→    PubSubChannel.APPLICATION.value,  # agent.status.application\n    48→})\n    49→\n    50→# Heartbeat interval in seconds\n    51→HEARTBEAT_INTERVAL_SECONDS: float = 15.0\n    52→\n    53→# Backpressure threshold — drop oldest messages if queue exceeds this\n    54→MAX_QUEUE_SIZE: int = 100\n    55→\n    56→\n    57→# ─── SSE Generator ────────────────────────────────────────────────────────────\n    58→\n    59→\n    60→async def sse_event_generator(\n    61→    redis_client: aioredis.Redis,\n    62→    channel: str,\n    63→    user_id: str,\n    64→) -> AsyncGenerator[str, None]:\n    65→    \"\"\"\n    66→    Generate SSE frames from Redis pub/sub messages.\n    67→\n    68→    Args:\n    69→        redis_client: Async Redis client for pub/sub subscription\n    70→        channel: Redis channel to subscribe to\n    71→        user_id: Authenticated user ID (for logging)\n    72→\n    73→    Yields:\n    74→        SSE-formatted strings (data: {json}\\n\\n or :ping\\n\\n)\n    75→\n    76→    Contract:\n    77→        - Each message yields: data: {json}\\n\\n\n    78→        - Heartbeat every 15s: :ping\\n\\n\n    79→        - Backpressure: if queue > 100, drop oldest and emit slow_client event\n    80→    \"\"\"\n    81→    pubsub = redis_client.pubsub()\n    82→    message_queue: asyncio.Queue[str] = asyncio.Queue()\n    83→    dropped_count: int = 0\n    84→\n    85→    logger.info(\n    86→        \"sse.connection_started\",\n    87→        channel=channel,\n    88→        user_id=user_id,\n    89→    )\n    90→\n    91→    async def reader_task() -> None:\n    92→        \"\"\"\n    93→        Background task that reads from Redis pub/sub and pushes to queue.\n    94→\n    95→        Handles backpressure by dropping oldest messages when queue is full.\n    96→        \"\"\"\n    97→        nonlocal dropped_count\n    98→\n    99→        try:\n   100→            await pubsub.subscribe(channel)\n   101→            async for message in pubsub.listen():\n   102→                if message[\"type\"] == \"message\":\n   103→                    data = message[\"data\"]\n   104→\n   105→                    # Backpressure check\n   106→                    while message_queue.qsize() >= MAX_QUEUE_SIZE:\n   107→                        try:\n   108→                            message_queue.get_nowait()\n   109→                            dropped_count += 1\n   110→                        except asyncio.QueueEmpty:\n   111→                            break\n   112→\n   113→                    await message_queue.put(data)\n   114→        except asyncio.CancelledError:\n   115→            pass\n   116→        except Exception as exc:\n   117→            logger.error(\n   118→                \"sse.reader_error\",\n   119→                channel=channel,\n   120→                user_id=user_id,\n   121→                error=str(exc),\n   122→            )\n   123→\n   124→    # Start the background reader\n   125→    reader = asyncio.create_task(reader_task())\n   126→\n   127→    try:\n   128→        while True:\n   129→            try:\n   130→                # Wait for message with timeout (for heartbeat)\n   131→                message = await asyncio.wait_for(\n   132→                    message_queue.get(),\n   133→                    timeout=HEARTBEAT_INTERVAL_SECONDS,\n   134→                )\n   135→\n   136→                # Emit slow_client warning if messages were dropped\n   137→                if dropped_count > 0:\n   138→                    yield f\"event: slow_client\\ndata: {{\\\"dropped\\\": {dropped_count}}}\\n\\n\"\n   139→                    logger.warning(\n   140→                        \"sse.slow_client\",\n   141→                        channel=channel,\n   142→                        user_id=user_id,\n   143→                        dropped=dropped_count,\n   144→                    )\n   145→                    dropped_count = 0\n   146→\n   147→                # Emit the actual message\n   148→                yield f\"data: {message}\\n\\n\"\n   149→\n   150→            except asyncio.TimeoutError:\n   151→                # No message within heartbeat interval — send keepalive\n   152→                yield \":ping\\n\\n\"\n   153→\n   154→    except asyncio.CancelledError:\n   155→        logger.info(\n   156→            \"sse.connection_cancelled\",\n   157→            channel=channel,\n   158→            user_id=user_id,\n   159→        )\n   160→    except Exception as exc:\n   161→        logger.error(\n   162→            \"sse.generator_error\",\n   163→            channel=channel,\n   164→            user_id=user_id,\n   165→            error=str(exc),\n   166→        )\n   167→    finally:\n   168→        # Cleanup: cancel reader and unsubscribe\n   169→        reader.cancel()\n   170→        try:\n   171→            await reader\n   172→        except asyncio.CancelledError:\n   173→            pass\n   174→\n   175→        try:\n   176→            await pubsub.unsubscribe(channel)\n   177→            await pubsub.close()\n   178→        except Exception as exc:\n   179→            logger.warning(\n   180→                \"sse.cleanup_error\",\n   181→                channel=channel,\n   182→                error=str(exc),\n   183→            )\n   184→\n   185→        logger.info(\n   186→            \"sse.connection_closed\",\n   187→            channel=channel,\n   188→            user_id=user_id,\n   189→        )\n   190→\n   191→\n   192→# ─── Endpoint ─────────────────────────────────────────────────────────────────\n   193→\n   194→\n   195→@router.get(\"/stream\")\n   196→async def event_stream(\n   197→    channel: str = Query(\n   198→        ...,\n   199→        description=\"Redis pub/sub channel to subscribe to\",\n   200→        examples=[\"agent.status.discovery\", \"agent.status.application\"],\n   201→    ),\n   202→    current_user: User = Depends(get_current_user),\n   203→    redis_client: aioredis.Redis = Depends(get_redis),\n   204→) -> StreamingResponse:\n   205→    \"\"\"\n   206→    Stream real-time agent status events via Server-Sent Events.\n   207→\n   208→    Args:\n   209→        channel: Redis pub/sub channel to subscribe to.\n   210→            Allowed: agent.status.discovery, agent.status.application\n   211→\n   212→    Returns:\n   213→        StreamingResponse with Content-Type: text/event-stream\n   214→\n   215→    Raises:\n   216→        400: Invalid channel (not in allowlist)\n   217→        401: Not authenticated (missing or invalid JWT)\n   218→\n   219→    Contract: NUTRIENTS.md § API_CONTRACTS → GET /events/stream\n   220→    \"\"\"\n   221→    # Validate channel against allowlist\n   222→    if channel not in ALLOWED_CHANNELS:\n   223→        allowed_list = \", \".join(sorted(ALLOWED_CHANNELS))\n   224→        raise HTTPException(\n   225→            status_code=400,\n   226→            detail=f\"Invalid channel. Allowed: {allowed_list}\",\n   227→        )\n   228→\n   229→    logger.info(\n   230→        \"sse.stream_requested\",\n   231→        channel=channel,\n   232→        user_id=str(current_user.id),\n   233→    )\n   234→\n   235→    return StreamingResponse(\n   236→        sse_event_generator(\n   237→            redis_client=redis_client,\n   238→            channel=channel,\n   239→            user_id=str(current_user.id),\n   240→        ),\n   241→        media_type=\"text/event-stream\",\n   242→        headers={\n   243→            \"Cache-Control\": \"no-cache\",\n   244→            \"Connection\": \"keep-alive\",\n   245→            \"X-Accel-Buffering\": \"no\",  # Disable nginx buffering\n   246→        },\n   247→    )\n   248→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"4abf431d-40e8-4b65-91bf-402517737050","uuid":"c7d9fad0-c82b-4e01-9303-05e7529c90b6","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/api/events.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nSSE Event Stream — real-time agent status streaming.\n\nGET /events/stream?channel=agent.status.discovery\nGET /events/stream?channel=agent.status.application\n\nStreams Redis pub/sub events to the frontend via Server-Sent Events.\nContract: HYPHA-API-STREAMING.md + NUTRIENTS.md § API_CONTRACTS (iter-4 additions)\n\nSSE format:\n  - data: {json}\\n\\n for each message\n  - :ping\\n\\n every 15s for connection keepalive\n  - event: slow_client\\ndata: {\"dropped\": N}\\n\\n on backpressure\n\nChannel allowlist:\n  - agent.status.discovery\n  - agent.status.application\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nfrom typing import AsyncGenerator\n\nimport redis.asyncio as aioredis\nimport structlog\nfrom fastapi import APIRouter, Depends, HTTPException, Query\nfrom fastapi.responses import StreamingResponse\n\nfrom backend.api.auth import get_current_user\nfrom backend.database import get_redis\nfrom backend.models.auth import User\nfrom backend.observability.events import PubSubChannel\n\nlogger = structlog.get_logger(__name__)\n\nrouter = APIRouter()\n\n# ─── Constants ────────────────────────────────────────────────────────────────\n\n# Allowed SSE channels (frozen contract from NUTRIENTS.md)\nALLOWED_CHANNELS: frozenset[str] = frozenset({\n    PubSubChannel.DISCOVERY.value,    # agent.status.discovery\n    PubSubChannel.APPLICATION.value,  # agent.status.application\n})\n\n# Heartbeat interval in seconds\nHEARTBEAT_INTERVAL_SECONDS: float = 15.0\n\n# Backpressure threshold — drop oldest messages if queue exceeds this\nMAX_QUEUE_SIZE: int = 100\n\n\n# ─── SSE Generator ────────────────────────────────────────────────────────────\n\n\nasync def sse_event_generator(\n    redis_client: aioredis.Redis,\n    channel: str,\n    user_id: str,\n) -> AsyncGenerator[str, None]:\n    \"\"\"\n    Generate SSE frames from Redis pub/sub messages.\n\n    Args:\n        redis_client: Async Redis client for pub/sub subscription\n        channel: Redis channel to subscribe to\n        user_id: Authenticated user ID (for logging)\n\n    Yields:\n        SSE-formatted strings (data: {json}\\n\\n or :ping\\n\\n)\n\n    Contract:\n        - Each message yields: data: {json}\\n\\n\n        - Heartbeat every 15s: :ping\\n\\n\n        - Backpressure: if queue > 100, drop oldest and emit slow_client event\n    \"\"\"\n    pubsub = redis_client.pubsub()\n    message_queue: asyncio.Queue[str] = asyncio.Queue()\n    dropped_count: int = 0\n\n    logger.info(\n        \"sse.connection_started\",\n        channel=channel,\n        user_id=user_id,\n    )\n\n    async def reader_task() -> None:\n        \"\"\"\n        Background task that reads from Redis pub/sub and pushes to queue.\n\n        Handles backpressure by dropping oldest messages when queue is full.\n        \"\"\"\n        nonlocal dropped_count\n\n        try:\n            await pubsub.subscribe(channel)\n            async for message in pubsub.listen():\n                if message[\"type\"] == \"message\":\n                    data = message[\"data\"]\n\n                    # Backpressure check\n                    while message_queue.qsize() >= MAX_QUEUE_SIZE:\n                        try:\n                            message_queue.get_nowait()\n                            dropped_count += 1\n                        except asyncio.QueueEmpty:\n                            break\n\n                    await message_queue.put(data)\n        except asyncio.CancelledError:\n            pass\n        except Exception as exc:\n            logger.error(\n                \"sse.reader_error\",\n                channel=channel,\n                user_id=user_id,\n                error=str(exc),\n            )\n\n    # Start the background reader\n    reader = asyncio.create_task(reader_task())\n\n    try:\n        while True:\n            try:\n                # Wait for message with timeout (for heartbeat)\n                message = await asyncio.wait_for(\n                    message_queue.get(),\n                    timeout=HEARTBEAT_INTERVAL_SECONDS,\n                )\n\n                # Emit slow_client warning if messages were dropped\n                if dropped_count > 0:\n                    yield f\"event: slow_client\\ndata: {{\\\"dropped\\\": {dropped_count}}}\\n\\n\"\n                    logger.warning(\n                        \"sse.slow_client\",\n                        channel=channel,\n                        user_id=user_id,\n                        dropped=dropped_count,\n                    )\n                    dropped_count = 0\n\n                # Emit the actual message\n                yield f\"data: {message}\\n\\n\"\n\n            except asyncio.TimeoutError:\n                # No message within heartbeat interval — send keepalive\n                yield \":ping\\n\\n\"\n\n    except asyncio.CancelledError:\n        logger.info(\n            \"sse.connection_cancelled\",\n            channel=channel,\n            user_id=user_id,\n        )\n    except Exception as exc:\n        logger.error(\n            \"sse.generator_error\",\n            channel=channel,\n            user_id=user_id,\n            error=str(exc),\n        )\n    finally:\n        # Cleanup: cancel reader and unsubscribe\n        reader.cancel()\n        try:\n            await reader\n        except asyncio.CancelledError:\n            pass\n\n        try:\n            await pubsub.unsubscribe(channel)\n            await pubsub.close()\n        except Exception as exc:\n            logger.warning(\n                \"sse.cleanup_error\",\n                channel=channel,\n                error=str(exc),\n            )\n\n        logger.info(\n            \"sse.connection_closed\",\n            channel=channel,\n            user_id=user_id,\n        )\n\n\n# ─── Endpoint ─────────────────────────────────────────────────────────────────\n\n\n@router.get(\"/stream\")\nasync def event_stream(\n    channel: str = Query(\n        ...,\n        description=\"Redis pub/sub channel to subscribe to\",\n        examples=[\"agent.status.discovery\", \"agent.status.application\"],\n    ),\n    current_user: User = Depends(get_current_user),\n    redis_client: aioredis.Redis = Depends(get_redis),\n) -> StreamingResponse:\n    \"\"\"\n    Stream real-time agent status events via Server-Sent Events.\n\n    Args:\n        channel: Redis pub/sub channel to subscribe to.\n            Allowed: agent.status.discovery, agent.status.application\n\n    Returns:\n        StreamingResponse with Content-Type: text/event-stream\n\n    Raises:\n        400: Invalid channel (not in allowlist)\n        401: Not authenticated (missing or invalid JWT)\n\n    Contract: NUTRIENTS.md § API_CONTRACTS → GET /events/stream\n    \"\"\"\n    # Validate channel against allowlist\n    if channel not in ALLOWED_CHANNELS:\n        allowed_list = \", \".join(sorted(ALLOWED_CHANNELS))\n        raise HTTPException(\n            status_code=400,\n            detail=f\"Invalid channel. Allowed: {allowed_list}\",\n        )\n\n    logger.info(\n        \"sse.stream_requested\",\n        channel=channel,\n        user_id=str(current_user.id),\n    )\n\n    return StreamingResponse(\n        sse_event_generator(\n            redis_client=redis_client,\n            channel=channel,\n            user_id=str(current_user.id),\n        ),\n        media_type=\"text/event-stream\",\n        headers={\n            \"Cache-Control\": \"no-cache\",\n            \"Connection\": \"keep-alive\",\n            \"X-Accel-Buffering\": \"no\",  # Disable nginx buffering\n        },\n    )\n","numLines":248,"startLine":1,"totalLines":248}}}}
