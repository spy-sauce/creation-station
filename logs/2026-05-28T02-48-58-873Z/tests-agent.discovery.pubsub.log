{"t":"2026-05-28T02:59:34.452Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Qc1HMDKRCKrLvgZnzz6MpZ","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Test suite for DiscoveryOrchestrator pub/sub event emissions.\n     6→\n     7→Validates that the orchestrator publishes the correct sequence of events\n     8→to Redis pub/sub during a discovery run.\n     9→\n    10→Uses fakeredis for async Redis mocking and patches Claude API calls.\n    11→\"\"\"\n    12→\n    13→import asyncio\n    14→import json\n    15→from datetime import datetime, timezone\n    16→from unittest.mock import AsyncMock, MagicMock, patch\n    17→from uuid import uuid4\n    18→\n    19→import pytest\n    20→import fakeredis.aioredis\n    21→from sqlalchemy.ext.asyncio import AsyncSession, create_async_engine, async_sessionmaker\n    22→from sqlalchemy.pool import StaticPool\n    23→\n    24→from backend.agents.discovery.orchestrator import DiscoveryOrchestrator\n    25→from backend.agents.discovery.schemas import (\n    26→    CandidateSchema,\n    27→    IdentityProfileSchema,\n    28→    SearchManifestSchema,\n    29→    ScoredJobSchema,\n    30→    ScoreBreakdown,\n    31→    DailyDigestSchema,\n    32→    DiscoveredJobSchema,\n    33→)\n    34→\n    35→\n    36→# ─── Fixtures ────────────────────────────────────────────────────────────────\n    37→\n    38→\n    39→@pytest.fixture\n    40→async def fake_redis():\n    41→    \"\"\"Create a fakeredis async client for testing pub/sub.\"\"\"\n    42→    server = fakeredis.FakeServer()\n    43→    client = fakeredis.aioredis.FakeRedis(server=server, decode_responses=True)\n    44→    yield client\n    45→    await client.aclose()\n    46→\n    47→\n    48→@pytest.fixture\n    49→async def async_db():\n    50→    \"\"\"\n    51→    Create a mock async database session for testing.\n    52→\n    53→    We don't need a real database since we mock all DB interactions.\n    54→    \"\"\"\n    55→    # Use a mock session since we patch all DB calls\n    56→    session = AsyncMock(spec=AsyncSession)\n    57→    session.add = MagicMock()\n    58→    session.commit = AsyncMock()\n    59→    session.refresh = AsyncMock()\n    60→    yield session\n    61→\n    62→\n    63→@pytest.fixture\n    64→def mock_candidate_id():\n    65→    \"\"\"Generate a deterministic candidate ID for testing.\"\"\"\n    66→    return uuid4()\n    67→\n    68→\n    69→@pytest.fixture\n    70→def test_candidate(mock_candidate_id):\n    71→    \"\"\"Create a test candidate schema (not ORM model).\"\"\"\n    72→    return CandidateSchema(\n    73→        id=mock_candidate_id,\n    74→        name=\"Test Candidate\",\n    75→        email=\"test@example.com\",\n    76→        resume_text=\"Senior software engineer with Python, FastAPI, PostgreSQL experience.\",\n    77→        linkedin_url=\"https://linkedin.com/in/testcandidate\",\n    78→        github_url=\"https://github.com/testcandidate\",\n    79→        personal_context=\"Looking for AI/ML leadership roles\",\n    80→        target_locations=[\"Remote\", \"Miami, FL\"],\n    81→        remote_preference=\"flexible\",\n    82→        min_compensation=200000,\n    83→        excluded_companies=[\"BigBank Corp\"],\n    84→        excluded_industries=[\"Gambling\"],\n    85→    )\n    86→\n    87→\n    88→@pytest.fixture\n    89→def mock_identity_profile():\n    90→    \"\"\"Create a mock identity profile returned by IdentityProfiler.\"\"\"\n    91→    return IdentityProfileSchema(\n    92→        archetypes=[\"Head of AI\", \"Principal Engineer\", \"VP Engineering\"],\n    93→        leadership_level=\"Director\",\n    94→        technical_skills=[\"Python\", \"FastAPI\", \"PostgreSQL\", \"Redis\", \"Claude API\"],\n    95→        soft_skills=[\"Leadership\", \"Communication\"],\n    96→        industry_experience=[\"Fintech\", \"AI/ML\", \"Music Tech\"],\n    97→        notable_achievements=[\"Led team of 15 engineers\", \"Built AI platform\"],\n    98→        career_trajectory=\"IC → Lead → Director, seeking VP/Head of roles\",\n    99→        ideal_role_description=\"AI/ML leadership at a growth-stage startup\",\n   100→        signals={\n   101→            \"startup_vs_enterprise\": \"startup\",\n   102→            \"remote_preference\": \"remote\",\n   103→            \"mission_vs_comp\": \"balanced\",\n   104→        },\n   105→    )\n   106→\n   107→\n   108→@pytest.fixture\n   109→def mock_search_manifest():\n   110→    \"\"\"Create a mock search manifest returned by ArchetypeGenerator.\"\"\"\n   111→    return SearchManifestSchema(\n   112→        target_titles=[\"Head of AI\", \"VP Engineering\", \"Director of AI\"],\n   113→        keywords=[\"AI\", \"ML\", \"Python\", \"FastAPI\"],\n   114→        excluded_titles=[],\n   115→        excluded_companies=[\"BigBank Corp\"],\n   116→        excluded_industries=[\"Gambling\"],\n   117→        location_filters=[\"Remote\", \"Miami\"],\n   118→        remote_preference=\"remote\",\n   119→        min_compensation=200000,\n   120→    )\n   121→\n   122→\n   123→@pytest.fixture\n   124→def mock_discovered_jobs():\n   125→    \"\"\"Create mock discovered jobs returned by CrawlerAgent.\"\"\"\n   126→    return [\n   127→        DiscoveredJobSchema(\n   128→            id=uuid4(),\n   129→            source=\"greenhouse\",\n   130→            source_id=\"gh-test-001\",\n   131→            title=\"Head of AI Engineering\",\n   132→            company=\"AI Startup Co\",\n   133→            location=\"Remote\",\n   134→            description=\"Looking for Head of AI...\",\n   135→            url=\"https://example.com/job/001\",\n   136→            salary_min=250000,\n   137→            salary_max=350000,\n   138→            remote=True,\n   139→            crawled_at=datetime.now(timezone.utc),\n   140→        ),\n   141→        DiscoveredJobSchema(\n   142→            id=uuid4(),\n   143→            source=\"lever\",\n   144→            source_id=\"lever-test-002\",\n   145→            title=\"VP Engineering\",\n   146→            company=\"FinTech Inc\",\n   147→            location=\"Miami, FL / Remote\",\n   148→            description=\"VP Engineering needed...\",\n   149→            url=\"https://example.com/job/002\",\n   150→            salary_min=300000,\n   151→            salary_max=400000,\n   152→            remote=True,\n   153→            crawled_at=datetime.now(timezone.utc),\n   154→        ),\n   155→    ]\n   156→\n   157→\n   158→@pytest.fixture\n   159→def mock_scored_jobs(mock_candidate_id, mock_discovered_jobs):\n   160→    \"\"\"Create mock scored jobs returned by RelevanceScorer.\"\"\"\n   161→    return [\n   162→        ScoredJobSchema(\n   163→            id=uuid4(),\n   164→            discovered_job_id=mock_discovered_jobs[0].id,\n   165→            candidate_id=mock_candidate_id,\n   166→            score_breakdown=ScoreBreakdown(\n   167→                technical_match=85,\n   168→                level_match=90,\n   169→                culture_match=80,\n   170→                industry_match=75,\n   171→                growth_potential=85,\n   172→                compensation_match=80,\n   173→            ),\n   174→            composite_score=84,\n   175→            is_hot=True,\n   176→            reasoning=\"Strong technical match with AI leadership experience.\",\n   177→            title=\"Head of AI Engineering\",\n   178→            company=\"AI Startup Co\",\n   179→            location=\"Remote\",\n   180→            url=\"https://example.com/job/001\",\n   181→            scored_at=datetime.now(timezone.utc),\n   182→        ),\n   183→        ScoredJobSchema(\n   184→            id=uuid4(),\n   185→            discovered_job_id=mock_discovered_jobs[1].id,\n   186→            candidate_id=mock_candidate_id,\n   187→            score_breakdown=ScoreBreakdown(\n   188→                technical_match=80,\n   189→                level_match=85,\n   190→                culture_match=75,\n   191→                industry_match=80,\n   192→                growth_potential=70,\n   193→                compensation_match=85,\n   194→            ),\n   195→            composite_score=80,\n   196→            is_hot=True,\n   197→            reasoning=\"Good fintech leadership opportunity.\",\n   198→            title=\"VP Engineering\",\n   199→            company=\"FinTech Inc\",\n   200→            location=\"Miami, FL / Remote\",\n   201→            url=\"https://example.com/job/002\",\n   202→            scored_at=datetime.now(timezone.utc),\n   203→        ),\n   204→    ]\n   205→\n   206→\n   207→# ─── Pub/Sub Collector Helper ────────────────────────────────────────────────\n   208→\n   209→\n   210→class PubSubCollector:\n   211→    \"\"\"\n   212→    Collects published messages from a fakeredis pub/sub channel.\n   213→\n   214→    Used to verify the sequence and content of events published by\n   215→    the orchestrator during a discovery run.\n   216→    \"\"\"\n   217→\n   218→    def __init__(self, redis_client, channel: str):\n   219→        self.redis_client = redis_client\n   220→        self.channel = channel\n   221→        self.messages: list[dict] = []\n   222→        self._pubsub = None\n   223→        self._task = None\n   224→\n   225→    async def start(self):\n   226→        \"\"\"Subscribe to the channel and start collecting messages.\"\"\"\n   227→        self._pubsub = self.redis_client.pubsub()\n   228→        await self._pubsub.subscribe(self.channel)\n   229→        self._task = asyncio.create_task(self._collect())\n   230→\n   231→    async def _collect(self):\n   232→        \"\"\"Background task to collect published messages.\"\"\"\n   233→        async for message in self._pubsub.listen():\n   234→            if message[\"type\"] == \"message\":\n   235→                data = message[\"data\"]\n   236→                if isinstance(data, bytes):\n   237→                    data = data.decode(\"utf-8\")\n   238→                try:\n   239→                    parsed = json.loads(data)\n   240→                    self.messages.append(parsed)\n   241→                except json.JSONDecodeError:\n   242→                    self.messages.append({\"raw\": data})\n   243→\n   244→    async def stop(self):\n   245→        \"\"\"Stop collecting and clean up.\"\"\"\n   246→        if self._task:\n   247→            self._task.cancel()\n   248→            try:\n   249→                await self._task\n   250→            except asyncio.CancelledError:\n   251→                pass\n   252→        if self._pubsub:\n   253→            await self._pubsub.unsubscribe(self.channel)\n   254→            await self._pubsub.aclose()\n   255→\n   256→    def get_event_sequence(self) -> list[str]:\n   257→        \"\"\"Return the sequence of event status values.\"\"\"\n   258→        return [msg.get(\"status\") for msg in self.messages if \"status\" in msg]\n   259→\n   260→\n   261→# ─── Tests ───────────────────────────────────────────────────────────────────\n   262→\n   263→\n   264→class TestOrchestratorPubSub:\n   265→    \"\"\"Test suite for DiscoveryOrchestrator pub/sub event emissions.\"\"\"\n   266→\n   267→    @pytest.mark.asyncio\n   268→    async def test_orchestrator_publishes_event_sequence(\n   269→        self,\n   270→        fake_redis,\n   271→        async_db,\n   272→        test_candidate,\n   273→        mock_identity_profile,\n   274→        mock_search_manifest,\n   275→        mock_discovered_jobs,\n   276→        mock_scored_jobs,\n   277→    ):\n   278→        \"\"\"\n   279→        Verify the orchestrator publishes the correct sequence of events.\n   280→\n   281→        Expected sequence (6 events minimum):\n   282→          1. CANDIDATE_LOADED\n   283→          2. PROFILE_BUILT\n   284→          3. MANIFEST_BUILT\n   285→          4. CRAWL_COMPLETE\n   286→          5. SCORING_COMPLETE\n   287→          6. RUN_COMPLETE\n   288→        \"\"\"\n   289→        collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n   290→        await collector.start()\n   291→\n   292→        # Allow subscriber to initialize\n   293→        await asyncio.sleep(0.1)\n   294→\n   295→        with (\n   296→            patch.object(\n   297→                DiscoveryOrchestrator, \"_load_candidate\"\n   298→            ) as mock_load,\n   299→            patch(\n   300→                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n   301→            ) as MockProfiler,\n   302→            patch(\n   303→                \"backend.agents.discovery.orchestrator.ArchetypeGenerator\"\n   304→            ) as MockArchetype,\n   305→            patch(\n   306→                \"backend.agents.discovery.orchestrator.CrawlerAgent\"\n   307→            ) as MockCrawler,\n   308→            patch(\n   309→                \"backend.agents.discovery.orchestrator.RelevanceScorer\"\n   310→            ) as MockScorer,\n   311→            patch(\n   312→                \"backend.agents.discovery.orchestrator.DigestBuilder\"\n   313→            ) as MockDigest,\n   314→        ):\n   315→            # Set up mocks\n   316→            mock_load.return_value = test_candidate\n   317→\n   318→            profiler_instance = AsyncMock()\n   319→            profiler_instance.build_profile.return_value = mock_identity_profile\n   320→            MockProfiler.return_value = profiler_instance\n   321→\n   322→            archetype_instance = MagicMock()\n   323→            archetype_instance.expand.return_value = mock_search_manifest\n   324→            MockArchetype.return_value = archetype_instance\n   325→\n   326→            crawler_instance = AsyncMock()\n   327→            crawler_instance.run.return_value = mock_discovered_jobs\n   328→            MockCrawler.return_value = crawler_instance\n   329→\n   330→            scorer_instance = AsyncMock()\n   331→            scorer_instance.score_batch.return_value = mock_scored_jobs\n   332→            MockScorer.return_value = scorer_instance\n   333→\n   334→            digest_instance = AsyncMock()\n   335→            digest_instance.compile.return_value = DailyDigestSchema(\n   336→                candidate_id=test_candidate.id,\n   337→                run_date=\"2026-05-27\",\n   338→                total_jobs_discovered=2,\n   339→                total_jobs_scored=2,\n   340→                top_picks=mock_scored_jobs,\n   341→                hot_picks=mock_scored_jobs,\n   342→                new_companies=[\"AI Startup Co\", \"FinTech Inc\"],\n   343→            )\n   344→            MockDigest.return_value = digest_instance\n   345→\n   346→            # Run orchestrator\n   347→            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n   348→                mock_settings.anthropic_api_key = \"test-key\"\n   349→                mock_settings.crawl_concurrency = 4\n   350→                mock_settings.min_score = 60\n   351→\n   352→                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n   353→                orchestrator._profiler = profiler_instance\n   354→                orchestrator._archetype_gen = archetype_instance\n   355→                orchestrator._scorer = scorer_instance\n   356→                orchestrator._digest_builder = digest_instance\n   357→\n   358→                result = await orchestrator.run(test_candidate.id, dry_run=True)\n   359→\n   360→        # Allow events to propagate\n   361→        await asyncio.sleep(0.2)\n   362→        await collector.stop()\n   363→\n   364→        # Verify event sequence\n   365→        event_sequence = collector.get_event_sequence()\n   366→\n   367→        # Assert minimum 6 events\n   368→        assert len(event_sequence) >= 6, (\n   369→            f\"Expected at least 6 events, got {len(event_sequence)}: {event_sequence}\"\n   370→        )\n   371→\n   372→        # Verify expected events are present\n   373→        expected_events = [\n   374→            \"CANDIDATE_LOADED\",\n   375→            \"PROFILE_BUILT\",\n   376→            \"MANIFEST_BUILT\",\n   377→            \"CRAWL_COMPLETE\",\n   378→            \"SCORING_COMPLETE\",\n   379→            \"RUN_COMPLETE\",\n   380→        ]\n   381→        for event in expected_events:\n   382→            assert event in event_sequence, f\"Missing expected event: {event}\"\n   383→\n   384→        # Verify RUN_COMPLETE is last\n   385→        assert event_sequence[-1] == \"RUN_COMPLETE\", (\n   386→            f\"RUN_COMPLETE should be last, but got: {event_sequence[-1]}\"\n   387→        )\n   388→\n   389→    @pytest.mark.asyncio\n   390→    async def test_no_duplicate_events(\n   391→        self,\n   392→        fake_redis,\n   393→        async_db,\n   394→        test_candidate,\n   395→        mock_identity_profile,\n   396→        mock_search_manifest,\n   397→        mock_discovered_jobs,\n   398→        mock_scored_jobs,\n   399→    ):\n   400→        \"\"\"Verify no duplicate events are published during a run.\"\"\"\n   401→        collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n   402→        await collector.start()\n   403→        await asyncio.sleep(0.1)\n   404→\n   405→        with (\n   406→            patch.object(\n   407→                DiscoveryOrchestrator, \"_load_candidate\"\n   408→            ) as mock_load,\n   409→            patch(\n   410→                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n   411→            ) as MockProfiler,\n   412→            patch(\n   413→                \"backend.agents.discovery.orchestrator.ArchetypeGenerator\"\n   414→            ) as MockArchetype,\n   415→            patch(\n   416→                \"backend.agents.discovery.orchestrator.CrawlerAgent\"\n   417→            ) as MockCrawler,\n   418→            patch(\n   419→                \"backend.agents.discovery.orchestrator.RelevanceScorer\"\n   420→            ) as MockScorer,\n   421→            patch(\n   422→                \"backend.agents.discovery.orchestrator.DigestBuilder\"\n   423→            ) as MockDigest,\n   424→        ):\n   425→            mock_load.return_value = test_candidate\n   426→\n   427→            profiler_instance = AsyncMock()\n   428→            profiler_instance.build_profile.return_value = mock_identity_profile\n   429→            MockProfiler.return_value = profiler_instance\n   430→\n   431→            archetype_instance = MagicMock()\n   432→            archetype_instance.expand.return_value = mock_search_manifest\n   433→            MockArchetype.return_value = archetype_instance\n   434→\n   435→            crawler_instance = AsyncMock()\n   436→            crawler_instance.run.return_value = mock_discovered_jobs\n   437→            MockCrawler.return_value = crawler_instance\n   438→\n   439→            scorer_instance = AsyncMock()\n   440→            scorer_instance.score_batch.return_value = mock_scored_jobs\n   441→            MockScorer.return_value = scorer_instance\n   442→\n   443→            digest_instance = AsyncMock()\n   444→            digest_instance.compile.return_value = DailyDigestSchema(\n   445→                candidate_id=test_candidate.id,\n   446→                run_date=\"2026-05-27\",\n   447→                total_jobs_discovered=2,\n   448→                total_jobs_scored=2,\n   449→                top_picks=mock_scored_jobs,\n   450→                hot_picks=mock_scored_jobs,\n   451→                new_companies=[\"AI Startup Co\", \"FinTech Inc\"],\n   452→            )\n   453→            MockDigest.return_value = digest_instance\n   454→\n   455→            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n   456→                mock_settings.anthropic_api_key = \"test-key\"\n   457→                mock_settings.crawl_concurrency = 4\n   458→                mock_settings.min_score = 60\n   459→\n   460→                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n   461→                orchestrator._profiler = profiler_instance\n   462→                orchestrator._archetype_gen = archetype_instance\n   463→                orchestrator._scorer = scorer_instance\n   464→                orchestrator._digest_builder = digest_instance\n   465→\n   466→                await orchestrator.run(test_candidate.id, dry_run=True)\n   467→\n   468→        await asyncio.sleep(0.2)\n   469→        await collector.stop()\n   470→\n   471→        event_sequence = collector.get_event_sequence()\n   472→\n   473→        # Check for duplicates\n   474→        seen = set()\n   475→        duplicates = []\n   476→        for event in event_sequence:\n   477→            if event in seen:\n   478→                duplicates.append(event)\n   479→            seen.add(event)\n   480→\n   481→        assert not duplicates, f\"Found duplicate events: {duplicates}\"\n   482→\n   483→    @pytest.mark.asyncio\n   484→    async def test_run_complete_is_last_event(\n   485→        self,\n   486→        fake_redis,\n   487→        async_db,\n   488→        test_candidate,\n   489→        mock_identity_profile,\n   490→        mock_search_manifest,\n   491→        mock_discovered_jobs,\n   492→        mock_scored_jobs,\n   493→    ):\n   494→        \"\"\"Explicitly verify RUN_COMPLETE is the final event.\"\"\"\n   495→        collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n   496→        await collector.start()\n   497→        await asyncio.sleep(0.1)\n   498→\n   499→        with (\n   500→            patch.object(\n   501→                DiscoveryOrchestrator, \"_load_candidate\"\n   502→            ) as mock_load,\n   503→            patch(\n   504→                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n   505→            ) as MockProfiler,\n   506→            patch(\n   507→                \"backend.agents.discovery.orchestrator.ArchetypeGenerator\"\n   508→            ) as MockArchetype,\n   509→            patch(\n   510→                \"backend.agents.discovery.orchestrator.CrawlerAgent\"\n   511→            ) as MockCrawler,\n   512→            patch(\n   513→                \"backend.agents.discovery.orchestrator.RelevanceScorer\"\n   514→            ) as MockScorer,\n   515→            patch(\n   516→                \"backend.agents.discovery.orchestrator.DigestBuilder\"\n   517→            ) as MockDigest,\n   518→        ):\n   519→            mock_load.return_value = test_candidate\n   520→\n   521→            profiler_instance = AsyncMock()\n   522→            profiler_instance.build_profile.return_value = mock_identity_profile\n   523→            MockProfiler.return_value = profiler_instance\n   524→\n   525→            archetype_instance = MagicMock()\n   526→            archetype_instance.expand.return_value = mock_search_manifest\n   527→            MockArchetype.return_value = archetype_instance\n   528→\n   529→            crawler_instance = AsyncMock()\n   530→            crawler_instance.run.return_value = mock_discovered_jobs\n   531→            MockCrawler.return_value = crawler_instance\n   532→\n   533→            scorer_instance = AsyncMock()\n   534→            scorer_instance.score_batch.return_value = mock_scored_jobs\n   535→            MockScorer.return_value = scorer_instance\n   536→\n   537→            digest_instance = AsyncMock()\n   538→            digest_instance.compile.return_value = DailyDigestSchema(\n   539→                candidate_id=test_candidate.id,\n   540→                run_date=\"2026-05-27\",\n   541→                total_jobs_discovered=2,\n   542→                total_jobs_scored=2,\n   543→                top_picks=mock_scored_jobs,\n   544→                hot_picks=mock_scored_jobs,\n   545→                new_companies=[\"AI Startup Co\", \"FinTech Inc\"],\n   546→            )\n   547→            MockDigest.return_value = digest_instance\n   548→\n   549→            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n   550→                mock_settings.anthropic_api_key = \"test-key\"\n   551→                mock_settings.crawl_concurrency = 4\n   552→                mock_settings.min_score = 60\n   553→\n   554→                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n   555→                orchestrator._profiler = profiler_instance\n   556→                orchestrator._archetype_gen = archetype_instance\n   557→                orchestrator._scorer = scorer_instance\n   558→                orchestrator._digest_builder = digest_instance\n   559→\n   560→                await orchestrator.run(test_candidate.id, dry_run=True)\n   561→\n   562→        await asyncio.sleep(0.2)\n   563→        await collector.stop()\n   564→\n   565→        event_sequence = collector.get_event_sequence()\n   566→        assert len(event_sequence) > 0, \"No events were published\"\n   567→        assert event_sequence[-1] == \"RUN_COMPLETE\", (\n   568→            f\"Expected RUN_COMPLETE as last event, got: {event_sequence[-1]}\"\n   569→        )\n   570→\n   571→    @pytest.mark.asyncio\n   572→    async def test_run_failed_emits_on_error(\n   573→        self,\n   574→        fake_redis,\n   575→        async_db,\n   576→        test_candidate,\n   577→    ):\n   578→        \"\"\"Verify RUN_FAILED is emitted when orchestrator encounters an error.\"\"\"\n   579→        collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n   580→        await collector.start()\n   581→        await asyncio.sleep(0.1)\n   582→\n   583→        with (\n   584→            patch.object(\n   585→                DiscoveryOrchestrator, \"_load_candidate\"\n   586→            ) as mock_load,\n   587→            patch(\n   588→                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n   589→            ) as MockProfiler,\n   590→        ):\n   591→            mock_load.return_value = test_candidate\n   592→\n   593→            # Make profiler raise an exception\n   594→            profiler_instance = AsyncMock()\n   595→            profiler_instance.build_profile.side_effect = Exception(\"Claude API error\")\n   596→            MockProfiler.return_value = profiler_instance\n   597→\n   598→            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n   599→                mock_settings.anthropic_api_key = \"test-key\"\n   600→                mock_settings.crawl_concurrency = 4\n   601→                mock_settings.min_score = 60\n   602→\n   603→                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n   604→                orchestrator._profiler = profiler_instance\n   605→\n   606→                with pytest.raises(Exception, match=\"Claude API error\"):\n   607→                    await orchestrator.run(test_candidate.id, dry_run=True)\n   608→\n   609→        await asyncio.sleep(0.2)\n   610→        await collector.stop()\n   611→\n   612→        event_sequence = collector.get_event_sequence()\n   613→\n   614→        # Should have CANDIDATE_LOADED then RUN_FAILED\n   615→        assert \"CANDIDATE_LOADED\" in event_sequence\n   616→        assert \"RUN_FAILED\" in event_sequence\n   617→        assert event_sequence[-1] == \"RUN_FAILED\", (\n   618→            f\"Expected RUN_FAILED as last event, got: {event_sequence[-1]}\"\n   619→        )\n   620→\n   621→    @pytest.mark.asyncio\n   622→    async def test_event_payload_contains_candidate_id(\n   623→        self,\n   624→        fake_redis,\n   625→        async_db,\n   626→        test_candidate,\n   627→        mock_identity_profile,\n   628→        mock_search_manifest,\n   629→        mock_discovered_jobs,\n   630→        mock_scored_jobs,\n   631→    ):\n   632→        \"\"\"Verify all published events contain the candidate_id.\"\"\"\n   633→        collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n   634→        await collector.start()\n   635→        await asyncio.sleep(0.1)\n   636→\n   637→        with (\n   638→            patch.object(\n   639→                DiscoveryOrchestrator, \"_load_candidate\"\n   640→            ) as mock_load,\n   641→            patch(\n   642→                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n   643→            ) as MockProfiler,\n   644→            patch(\n   645→                \"backend.agents.discovery.orchestrator.ArchetypeGenerator\"\n   646→            ) as MockArchetype,\n   647→            patch(\n   648→                \"backend.agents.discovery.orchestrator.CrawlerAgent\"\n   649→            ) as MockCrawler,\n   650→            patch(\n   651→                \"backend.agents.discovery.orchestrator.RelevanceScorer\"\n   652→            ) as MockScorer,\n   653→            patch(\n   654→                \"backend.agents.discovery.orchestrator.DigestBuilder\"\n   655→            ) as MockDigest,\n   656→        ):\n   657→            mock_load.return_value = test_candidate\n   658→\n   659→            profiler_instance = AsyncMock()\n   660→            profiler_instance.build_profile.return_value = mock_identity_profile\n   661→            MockProfiler.return_value = profiler_instance\n   662→\n   663→            archetype_instance = MagicMock()\n   664→            archetype_instance.expand.return_value = mock_search_manifest\n   665→            MockArchetype.return_value = archetype_instance\n   666→\n   667→            crawler_instance = AsyncMock()\n   668→            crawler_instance.run.return_value = mock_discovered_jobs\n   669→            MockCrawler.return_value = crawler_instance\n   670→\n   671→            scorer_instance = AsyncMock()\n   672→            scorer_instance.score_batch.return_value = mock_scored_jobs\n   673→            MockScorer.return_value = scorer_instance\n   674→\n   675→            digest_instance = AsyncMock()\n   676→            digest_instance.compile.return_value = DailyDigestSchema(\n   677→                candidate_id=test_candidate.id,\n   678→                run_date=\"2026-05-27\",\n   679→                total_jobs_discovered=2,\n   680→                total_jobs_scored=2,\n   681→                top_picks=mock_scored_jobs,\n   682→                hot_picks=mock_scored_jobs,\n   683→                new_companies=[\"AI Startup Co\", \"FinTech Inc\"],\n   684→            )\n   685→            MockDigest.return_value = digest_instance\n   686→\n   687→            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n   688→                mock_settings.anthropic_api_key = \"test-key\"\n   689→                mock_settings.crawl_concurrency = 4\n   690→                mock_settings.min_score = 60\n   691→\n   692→                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n   693→                orchestrator._profiler = profiler_instance\n   694→                orchestrator._archetype_gen = archetype_instance\n   695→                orchestrator._scorer = scorer_instance\n   696→                orchestrator._digest_builder = digest_instance\n   697→\n   698→                await orchestrator.run(test_candidate.id, dry_run=True)\n   699→\n   700→        await asyncio.sleep(0.2)\n   701→        await collector.stop()\n   702→\n   703→        # Verify all messages have candidate_id\n   704→        for msg in collector.messages:\n   705→            assert \"candidate_id\" in msg, f\"Message missing candidate_id: {msg}\"\n   706→            assert msg[\"candidate_id\"] == str(test_candidate.id), (\n   707→                f\"Wrong candidate_id: {msg['candidate_id']}\"\n   708→            )\n   709→\n   710→    @pytest.mark.asyncio\n   711→    async def test_events_published_to_correct_channel(\n   712→        self,\n   713→        fake_redis,\n   714→        async_db,\n   715→        test_candidate,\n   716→        mock_identity_profile,\n   717→        mock_search_manifest,\n   718→        mock_discovered_jobs,\n   719→        mock_scored_jobs,\n   720→    ):\n   721→        \"\"\"Verify events are published to agent.status.discovery channel.\"\"\"\n   722→        # Subscribe to a different channel — should receive nothing\n   723→        wrong_collector = PubSubCollector(fake_redis, \"agent.status.application\")\n   724→        await wrong_collector.start()\n   725→\n   726→        # Subscribe to the correct channel\n   727→        correct_collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n   728→        await correct_collector.start()\n   729→\n   730→        await asyncio.sleep(0.1)\n   731→\n   732→        with (\n   733→            patch.object(\n   734→                DiscoveryOrchestrator, \"_load_candidate\"\n   735→            ) as mock_load,\n   736→            patch(\n   737→                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n   738→            ) as MockProfiler,\n   739→            patch(\n   740→                \"backend.agents.discovery.orchestrator.ArchetypeGenerator\"\n   741→            ) as MockArchetype,\n   742→            patch(\n   743→                \"backend.agents.discovery.orchestrator.CrawlerAgent\"\n   744→            ) as MockCrawler,\n   745→            patch(\n   746→                \"backend.agents.discovery.orchestrator.RelevanceScorer\"\n   747→            ) as MockScorer,\n   748→            patch(\n   749→                \"backend.agents.discovery.orchestrator.DigestBuilder\"\n   750→            ) as MockDigest,\n   751→        ):\n   752→            mock_load.return_value = test_candidate\n   753→\n   754→            profiler_instance = AsyncMock()\n   755→            profiler_instance.build_profile.return_value = mock_identity_profile\n   756→            MockProfiler.return_value = profiler_instance\n   757→\n   758→            archetype_instance = MagicMock()\n   759→            archetype_instance.expand.return_value = mock_search_manifest\n   760→            MockArchetype.return_value = archetype_instance\n   761→\n   762→            crawler_instance = AsyncMock()\n   763→            crawler_instance.run.return_value = mock_discovered_jobs\n   764→            MockCrawler.return_value = crawler_instance\n   765→\n   766→            scorer_instance = AsyncMock()\n   767→            scorer_instance.score_batch.return_value = mock_scored_jobs\n   768→            MockScorer.return_value = scorer_instance\n   769→\n   770→            digest_instance = AsyncMock()\n   771→            digest_instance.compile.return_value = DailyDigestSchema(\n   772→                candidate_id=test_candidate.id,\n   773→                run_date=\"2026-05-27\",\n   774→                total_jobs_discovered=2,\n   775→                total_jobs_scored=2,\n   776→                top_picks=mock_scored_jobs,\n   777→                hot_picks=mock_scored_jobs,\n   778→                new_companies=[\"AI Startup Co\", \"FinTech Inc\"],\n   779→            )\n   780→            MockDigest.return_value = digest_instance\n   781→\n   782→            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n   783→                mock_settings.anthropic_api_key = \"test-key\"\n   784→                mock_settings.crawl_concurrency = 4\n   785→                mock_settings.min_score = 60\n   786→\n   787→                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n   788→                orchestrator._profiler = profiler_instance\n   789→                orchestrator._archetype_gen = archetype_instance\n   790→                orchestrator._scorer = scorer_instance\n   791→                orchestrator._digest_builder = digest_instance\n   792→\n   793→                await orchestrator.run(test_candidate.id, dry_run=True)\n   794→\n   795→        await asyncio.sleep(0.2)\n   796→        await wrong_collector.stop()\n   797→        await correct_collector.stop()\n   798→\n   799→        # Wrong channel should have no messages\n   800→        assert len(wrong_collector.messages) == 0, (\n   801→            f\"Wrong channel received messages: {wrong_collector.messages}\"\n   802→        )\n   803→\n   804→        # Correct channel should have messages\n   805→        assert len(correct_collector.messages) > 0, (\n   806→            \"Correct channel received no messages\"\n   807→        )\n   808→\n   809→    @pytest.mark.asyncio\n   810→    async def test_event_order_is_deterministic(\n   811→        self,\n   812→        fake_redis,\n   813→        async_db,\n   814→        test_candidate,\n   815→        mock_identity_profile,\n   816→        mock_search_manifest,\n   817→        mock_discovered_jobs,\n   818→        mock_scored_jobs,\n   819→    ):\n   820→        \"\"\"Verify event order follows the pipeline execution order.\"\"\"\n   821→        collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n   822→        await collector.start()\n   823→        await asyncio.sleep(0.1)\n   824→\n   825→        with (\n   826→            patch.object(\n   827→                DiscoveryOrchestrator, \"_load_candidate\"\n   828→            ) as mock_load,\n   829→            patch(\n   830→                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n   831→            ) as MockProfiler,\n   832→            patch(\n   833→                \"backend.agents.discovery.orchestrator.ArchetypeGenerator\"\n   834→            ) as MockArchetype,\n   835→            patch(\n   836→                \"backend.agents.discovery.orchestrator.CrawlerAgent\"\n   837→            ) as MockCrawler,\n   838→            patch(\n   839→                \"backend.agents.discovery.orchestrator.RelevanceScorer\"\n   840→            ) as MockScorer,\n   841→            patch(\n   842→                \"backend.agents.discovery.orchestrator.DigestBuilder\"\n   843→            ) as MockDigest,\n   844→        ):\n   845→            mock_load.return_value = test_candidate\n   846→\n   847→            profiler_instance = AsyncMock()\n   848→            profiler_instance.build_profile.return_value = mock_identity_profile\n   849→            MockProfiler.return_value = profiler_instance\n   850→\n   851→            archetype_instance = MagicMock()\n   852→            archetype_instance.expand.return_value = mock_search_manifest\n   853→            MockArchetype.return_value = archetype_instance\n   854→\n   855→            crawler_instance = AsyncMock()\n   856→            crawler_instance.run.return_value = mock_discovered_jobs\n   857→            MockCrawler.return_value = crawler_instance\n   858→\n   859→            scorer_instance = AsyncMock()\n   860→            scorer_instance.score_batch.return_value = mock_scored_jobs\n   861→            MockScorer.return_value = scorer_instance\n   862→\n   863→            digest_instance = AsyncMock()\n   864→            digest_instance.compile.return_value = DailyDigestSchema(\n   865→                candidate_id=test_candidate.id,\n   866→                run_date=\"2026-05-27\",\n   867→                total_jobs_discovered=2,\n   868→                total_jobs_scored=2,\n   869→                top_picks=mock_scored_jobs,\n   870→                hot_picks=mock_scored_jobs,\n   871→                new_companies=[\"AI Startup Co\", \"FinTech Inc\"],\n   872→            )\n   873→            MockDigest.return_value = digest_instance\n   874→\n   875→            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n   876→                mock_settings.anthropic_api_key = \"test-key\"\n   877→                mock_settings.crawl_concurrency = 4\n   878→                mock_settings.min_score = 60\n   879→\n   880→                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n   881→                orchestrator._profiler = profiler_instance\n   882→                orchestrator._archetype_gen = archetype_instance\n   883→                orchestrator._scorer = scorer_instance\n   884→                orchestrator._digest_builder = digest_instance\n   885→\n   886→                await orchestrator.run(test_candidate.id, dry_run=True)\n   887→\n   888→        await asyncio.sleep(0.2)\n   889→        await collector.stop()\n   890→\n   891→        event_sequence = collector.get_event_sequence()\n   892→\n   893→        # Define expected order\n   894→        expected_order = [\n   895→            \"CANDIDATE_LOADED\",\n   896→            \"PROFILE_BUILT\",\n   897→            \"MANIFEST_BUILT\",\n   898→            \"CRAWL_COMPLETE\",\n   899→            \"SCORING_COMPLETE\",\n   900→            \"RUN_COMPLETE\",\n   901→        ]\n   902→\n   903→        # Verify order\n   904→        for i, expected in enumerate(expected_order):\n   905→            assert event_sequence[i] == expected, (\n   906→                f\"Event at position {i} should be {expected}, \"\n   907→                f\"got {event_sequence[i]}. Full sequence: {event_sequence}\"\n   908→            )\n   909→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"f2750489-d8d6-41f5-b42f-4d2a4cab3a05","uuid":"e85ebf6c-e8c4-41c0-abd3-cc52b230a204","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/tests/discovery/test_orchestrator_pubsub.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nTest suite for DiscoveryOrchestrator pub/sub event emissions.\n\nValidates that the orchestrator publishes the correct sequence of events\nto Redis pub/sub during a discovery run.\n\nUses fakeredis for async Redis mocking and patches Claude API calls.\n\"\"\"\n\nimport asyncio\nimport json\nfrom datetime import datetime, timezone\nfrom unittest.mock import AsyncMock, MagicMock, patch\nfrom uuid import uuid4\n\nimport pytest\nimport fakeredis.aioredis\nfrom sqlalchemy.ext.asyncio import AsyncSession, create_async_engine, async_sessionmaker\nfrom sqlalchemy.pool import StaticPool\n\nfrom backend.agents.discovery.orchestrator import DiscoveryOrchestrator\nfrom backend.agents.discovery.schemas import (\n    CandidateSchema,\n    IdentityProfileSchema,\n    SearchManifestSchema,\n    ScoredJobSchema,\n    ScoreBreakdown,\n    DailyDigestSchema,\n    DiscoveredJobSchema,\n)\n\n\n# ─── Fixtures ────────────────────────────────────────────────────────────────\n\n\n@pytest.fixture\nasync def fake_redis():\n    \"\"\"Create a fakeredis async client for testing pub/sub.\"\"\"\n    server = fakeredis.FakeServer()\n    client = fakeredis.aioredis.FakeRedis(server=server, decode_responses=True)\n    yield client\n    await client.aclose()\n\n\n@pytest.fixture\nasync def async_db():\n    \"\"\"\n    Create a mock async database session for testing.\n\n    We don't need a real database since we mock all DB interactions.\n    \"\"\"\n    # Use a mock session since we patch all DB calls\n    session = AsyncMock(spec=AsyncSession)\n    session.add = MagicMock()\n    session.commit = AsyncMock()\n    session.refresh = AsyncMock()\n    yield session\n\n\n@pytest.fixture\ndef mock_candidate_id():\n    \"\"\"Generate a deterministic candidate ID for testing.\"\"\"\n    return uuid4()\n\n\n@pytest.fixture\ndef test_candidate(mock_candidate_id):\n    \"\"\"Create a test candidate schema (not ORM model).\"\"\"\n    return CandidateSchema(\n        id=mock_candidate_id,\n        name=\"Test Candidate\",\n        email=\"test@example.com\",\n        resume_text=\"Senior software engineer with Python, FastAPI, PostgreSQL experience.\",\n        linkedin_url=\"https://linkedin.com/in/testcandidate\",\n        github_url=\"https://github.com/testcandidate\",\n        personal_context=\"Looking for AI/ML leadership roles\",\n        target_locations=[\"Remote\", \"Miami, FL\"],\n        remote_preference=\"flexible\",\n        min_compensation=200000,\n        excluded_companies=[\"BigBank Corp\"],\n        excluded_industries=[\"Gambling\"],\n    )\n\n\n@pytest.fixture\ndef mock_identity_profile():\n    \"\"\"Create a mock identity profile returned by IdentityProfiler.\"\"\"\n    return IdentityProfileSchema(\n        archetypes=[\"Head of AI\", \"Principal Engineer\", \"VP Engineering\"],\n        leadership_level=\"Director\",\n        technical_skills=[\"Python\", \"FastAPI\", \"PostgreSQL\", \"Redis\", \"Claude API\"],\n        soft_skills=[\"Leadership\", \"Communication\"],\n        industry_experience=[\"Fintech\", \"AI/ML\", \"Music Tech\"],\n        notable_achievements=[\"Led team of 15 engineers\", \"Built AI platform\"],\n        career_trajectory=\"IC → Lead → Director, seeking VP/Head of roles\",\n        ideal_role_description=\"AI/ML leadership at a growth-stage startup\",\n        signals={\n            \"startup_vs_enterprise\": \"startup\",\n            \"remote_preference\": \"remote\",\n            \"mission_vs_comp\": \"balanced\",\n        },\n    )\n\n\n@pytest.fixture\ndef mock_search_manifest():\n    \"\"\"Create a mock search manifest returned by ArchetypeGenerator.\"\"\"\n    return SearchManifestSchema(\n        target_titles=[\"Head of AI\", \"VP Engineering\", \"Director of AI\"],\n        keywords=[\"AI\", \"ML\", \"Python\", \"FastAPI\"],\n        excluded_titles=[],\n        excluded_companies=[\"BigBank Corp\"],\n        excluded_industries=[\"Gambling\"],\n        location_filters=[\"Remote\", \"Miami\"],\n        remote_preference=\"remote\",\n        min_compensation=200000,\n    )\n\n\n@pytest.fixture\ndef mock_discovered_jobs():\n    \"\"\"Create mock discovered jobs returned by CrawlerAgent.\"\"\"\n    return [\n        DiscoveredJobSchema(\n            id=uuid4(),\n            source=\"greenhouse\",\n            source_id=\"gh-test-001\",\n            title=\"Head of AI Engineering\",\n            company=\"AI Startup Co\",\n            location=\"Remote\",\n            description=\"Looking for Head of AI...\",\n            url=\"https://example.com/job/001\",\n            salary_min=250000,\n            salary_max=350000,\n            remote=True,\n            crawled_at=datetime.now(timezone.utc),\n        ),\n        DiscoveredJobSchema(\n            id=uuid4(),\n            source=\"lever\",\n            source_id=\"lever-test-002\",\n            title=\"VP Engineering\",\n            company=\"FinTech Inc\",\n            location=\"Miami, FL / Remote\",\n            description=\"VP Engineering needed...\",\n            url=\"https://example.com/job/002\",\n            salary_min=300000,\n            salary_max=400000,\n            remote=True,\n            crawled_at=datetime.now(timezone.utc),\n        ),\n    ]\n\n\n@pytest.fixture\ndef mock_scored_jobs(mock_candidate_id, mock_discovered_jobs):\n    \"\"\"Create mock scored jobs returned by RelevanceScorer.\"\"\"\n    return [\n        ScoredJobSchema(\n            id=uuid4(),\n            discovered_job_id=mock_discovered_jobs[0].id,\n            candidate_id=mock_candidate_id,\n            score_breakdown=ScoreBreakdown(\n                technical_match=85,\n                level_match=90,\n                culture_match=80,\n                industry_match=75,\n                growth_potential=85,\n                compensation_match=80,\n            ),\n            composite_score=84,\n            is_hot=True,\n            reasoning=\"Strong technical match with AI leadership experience.\",\n            title=\"Head of AI Engineering\",\n            company=\"AI Startup Co\",\n            location=\"Remote\",\n            url=\"https://example.com/job/001\",\n            scored_at=datetime.now(timezone.utc),\n        ),\n        ScoredJobSchema(\n            id=uuid4(),\n            discovered_job_id=mock_discovered_jobs[1].id,\n            candidate_id=mock_candidate_id,\n            score_breakdown=ScoreBreakdown(\n                technical_match=80,\n                level_match=85,\n                culture_match=75,\n                industry_match=80,\n                growth_potential=70,\n                compensation_match=85,\n            ),\n            composite_score=80,\n            is_hot=True,\n            reasoning=\"Good fintech leadership opportunity.\",\n            title=\"VP Engineering\",\n            company=\"FinTech Inc\",\n            location=\"Miami, FL / Remote\",\n            url=\"https://example.com/job/002\",\n            scored_at=datetime.now(timezone.utc),\n        ),\n    ]\n\n\n# ─── Pub/Sub Collector Helper ────────────────────────────────────────────────\n\n\nclass PubSubCollector:\n    \"\"\"\n    Collects published messages from a fakeredis pub/sub channel.\n\n    Used to verify the sequence and content of events published by\n    the orchestrator during a discovery run.\n    \"\"\"\n\n    def __init__(self, redis_client, channel: str):\n        self.redis_client = redis_client\n        self.channel = channel\n        self.messages: list[dict] = []\n        self._pubsub = None\n        self._task = None\n\n    async def start(self):\n        \"\"\"Subscribe to the channel and start collecting messages.\"\"\"\n        self._pubsub = self.redis_client.pubsub()\n        await self._pubsub.subscribe(self.channel)\n        self._task = asyncio.create_task(self._collect())\n\n    async def _collect(self):\n        \"\"\"Background task to collect published messages.\"\"\"\n        async for message in self._pubsub.listen():\n            if message[\"type\"] == \"message\":\n                data = message[\"data\"]\n                if isinstance(data, bytes):\n                    data = data.decode(\"utf-8\")\n                try:\n                    parsed = json.loads(data)\n                    self.messages.append(parsed)\n                except json.JSONDecodeError:\n                    self.messages.append({\"raw\": data})\n\n    async def stop(self):\n        \"\"\"Stop collecting and clean up.\"\"\"\n        if self._task:\n            self._task.cancel()\n            try:\n                await self._task\n            except asyncio.CancelledError:\n                pass\n        if self._pubsub:\n            await self._pubsub.unsubscribe(self.channel)\n            await self._pubsub.aclose()\n\n    def get_event_sequence(self) -> list[str]:\n        \"\"\"Return the sequence of event status values.\"\"\"\n        return [msg.get(\"status\") for msg in self.messages if \"status\" in msg]\n\n\n# ─── Tests ───────────────────────────────────────────────────────────────────\n\n\nclass TestOrchestratorPubSub:\n    \"\"\"Test suite for DiscoveryOrchestrator pub/sub event emissions.\"\"\"\n\n    @pytest.mark.asyncio\n    async def test_orchestrator_publishes_event_sequence(\n        self,\n        fake_redis,\n        async_db,\n        test_candidate,\n        mock_identity_profile,\n        mock_search_manifest,\n        mock_discovered_jobs,\n        mock_scored_jobs,\n    ):\n        \"\"\"\n        Verify the orchestrator publishes the correct sequence of events.\n\n        Expected sequence (6 events minimum):\n          1. CANDIDATE_LOADED\n          2. PROFILE_BUILT\n          3. MANIFEST_BUILT\n          4. CRAWL_COMPLETE\n          5. SCORING_COMPLETE\n          6. RUN_COMPLETE\n        \"\"\"\n        collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n        await collector.start()\n\n        # Allow subscriber to initialize\n        await asyncio.sleep(0.1)\n\n        with (\n            patch.object(\n                DiscoveryOrchestrator, \"_load_candidate\"\n            ) as mock_load,\n            patch(\n                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n            ) as MockProfiler,\n            patch(\n                \"backend.agents.discovery.orchestrator.ArchetypeGenerator\"\n            ) as MockArchetype,\n            patch(\n                \"backend.agents.discovery.orchestrator.CrawlerAgent\"\n            ) as MockCrawler,\n            patch(\n                \"backend.agents.discovery.orchestrator.RelevanceScorer\"\n            ) as MockScorer,\n            patch(\n                \"backend.agents.discovery.orchestrator.DigestBuilder\"\n            ) as MockDigest,\n        ):\n            # Set up mocks\n            mock_load.return_value = test_candidate\n\n            profiler_instance = AsyncMock()\n            profiler_instance.build_profile.return_value = mock_identity_profile\n            MockProfiler.return_value = profiler_instance\n\n            archetype_instance = MagicMock()\n            archetype_instance.expand.return_value = mock_search_manifest\n            MockArchetype.return_value = archetype_instance\n\n            crawler_instance = AsyncMock()\n            crawler_instance.run.return_value = mock_discovered_jobs\n            MockCrawler.return_value = crawler_instance\n\n            scorer_instance = AsyncMock()\n            scorer_instance.score_batch.return_value = mock_scored_jobs\n            MockScorer.return_value = scorer_instance\n\n            digest_instance = AsyncMock()\n            digest_instance.compile.return_value = DailyDigestSchema(\n                candidate_id=test_candidate.id,\n                run_date=\"2026-05-27\",\n                total_jobs_discovered=2,\n                total_jobs_scored=2,\n                top_picks=mock_scored_jobs,\n                hot_picks=mock_scored_jobs,\n                new_companies=[\"AI Startup Co\", \"FinTech Inc\"],\n            )\n            MockDigest.return_value = digest_instance\n\n            # Run orchestrator\n            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n                mock_settings.anthropic_api_key = \"test-key\"\n                mock_settings.crawl_concurrency = 4\n                mock_settings.min_score = 60\n\n                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n                orchestrator._profiler = profiler_instance\n                orchestrator._archetype_gen = archetype_instance\n                orchestrator._scorer = scorer_instance\n                orchestrator._digest_builder = digest_instance\n\n                result = await orchestrator.run(test_candidate.id, dry_run=True)\n\n        # Allow events to propagate\n        await asyncio.sleep(0.2)\n        await collector.stop()\n\n        # Verify event sequence\n        event_sequence = collector.get_event_sequence()\n\n        # Assert minimum 6 events\n        assert len(event_sequence) >= 6, (\n            f\"Expected at least 6 events, got {len(event_sequence)}: {event_sequence}\"\n        )\n\n        # Verify expected events are present\n        expected_events = [\n            \"CANDIDATE_LOADED\",\n            \"PROFILE_BUILT\",\n            \"MANIFEST_BUILT\",\n            \"CRAWL_COMPLETE\",\n            \"SCORING_COMPLETE\",\n            \"RUN_COMPLETE\",\n        ]\n        for event in expected_events:\n            assert event in event_sequence, f\"Missing expected event: {event}\"\n\n        # Verify RUN_COMPLETE is last\n        assert event_sequence[-1] == \"RUN_COMPLETE\", (\n            f\"RUN_COMPLETE should be last, but got: {event_sequence[-1]}\"\n        )\n\n    @pytest.mark.asyncio\n    async def test_no_duplicate_events(\n        self,\n        fake_redis,\n        async_db,\n        test_candidate,\n        mock_identity_profile,\n        mock_search_manifest,\n        mock_discovered_jobs,\n        mock_scored_jobs,\n    ):\n        \"\"\"Verify no duplicate events are published during a run.\"\"\"\n        collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n        await collector.start()\n        await asyncio.sleep(0.1)\n\n        with (\n            patch.object(\n                DiscoveryOrchestrator, \"_load_candidate\"\n            ) as mock_load,\n            patch(\n                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n            ) as MockProfiler,\n            patch(\n                \"backend.agents.discovery.orchestrator.ArchetypeGenerator\"\n            ) as MockArchetype,\n            patch(\n                \"backend.agents.discovery.orchestrator.CrawlerAgent\"\n            ) as MockCrawler,\n            patch(\n                \"backend.agents.discovery.orchestrator.RelevanceScorer\"\n            ) as MockScorer,\n            patch(\n                \"backend.agents.discovery.orchestrator.DigestBuilder\"\n            ) as MockDigest,\n        ):\n            mock_load.return_value = test_candidate\n\n            profiler_instance = AsyncMock()\n            profiler_instance.build_profile.return_value = mock_identity_profile\n            MockProfiler.return_value = profiler_instance\n\n            archetype_instance = MagicMock()\n            archetype_instance.expand.return_value = mock_search_manifest\n            MockArchetype.return_value = archetype_instance\n\n            crawler_instance = AsyncMock()\n            crawler_instance.run.return_value = mock_discovered_jobs\n            MockCrawler.return_value = crawler_instance\n\n            scorer_instance = AsyncMock()\n            scorer_instance.score_batch.return_value = mock_scored_jobs\n            MockScorer.return_value = scorer_instance\n\n            digest_instance = AsyncMock()\n            digest_instance.compile.return_value = DailyDigestSchema(\n                candidate_id=test_candidate.id,\n                run_date=\"2026-05-27\",\n                total_jobs_discovered=2,\n                total_jobs_scored=2,\n                top_picks=mock_scored_jobs,\n                hot_picks=mock_scored_jobs,\n                new_companies=[\"AI Startup Co\", \"FinTech Inc\"],\n            )\n            MockDigest.return_value = digest_instance\n\n            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n                mock_settings.anthropic_api_key = \"test-key\"\n                mock_settings.crawl_concurrency = 4\n                mock_settings.min_score = 60\n\n                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n                orchestrator._profiler = profiler_instance\n                orchestrator._archetype_gen = archetype_instance\n                orchestrator._scorer = scorer_instance\n                orchestrator._digest_builder = digest_instance\n\n                await orchestrator.run(test_candidate.id, dry_run=True)\n\n        await asyncio.sleep(0.2)\n        await collector.stop()\n\n        event_sequence = collector.get_event_sequence()\n\n        # Check for duplicates\n        seen = set()\n        duplicates = []\n        for event in event_sequence:\n            if event in seen:\n                duplicates.append(event)\n            seen.add(event)\n\n        assert not duplicates, f\"Found duplicate events: {duplicates}\"\n\n    @pytest.mark.asyncio\n    async def test_run_complete_is_last_event(\n        self,\n        fake_redis,\n        async_db,\n        test_candidate,\n        mock_identity_profile,\n        mock_search_manifest,\n        mock_discovered_jobs,\n        mock_scored_jobs,\n    ):\n        \"\"\"Explicitly verify RUN_COMPLETE is the final event.\"\"\"\n        collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n        await collector.start()\n        await asyncio.sleep(0.1)\n\n        with (\n            patch.object(\n                DiscoveryOrchestrator, \"_load_candidate\"\n            ) as mock_load,\n            patch(\n                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n            ) as MockProfiler,\n            patch(\n                \"backend.agents.discovery.orchestrator.ArchetypeGenerator\"\n            ) as MockArchetype,\n            patch(\n                \"backend.agents.discovery.orchestrator.CrawlerAgent\"\n            ) as MockCrawler,\n            patch(\n                \"backend.agents.discovery.orchestrator.RelevanceScorer\"\n            ) as MockScorer,\n            patch(\n                \"backend.agents.discovery.orchestrator.DigestBuilder\"\n            ) as MockDigest,\n        ):\n            mock_load.return_value = test_candidate\n\n            profiler_instance = AsyncMock()\n            profiler_instance.build_profile.return_value = mock_identity_profile\n            MockProfiler.return_value = profiler_instance\n\n            archetype_instance = MagicMock()\n            archetype_instance.expand.return_value = mock_search_manifest\n            MockArchetype.return_value = archetype_instance\n\n            crawler_instance = AsyncMock()\n            crawler_instance.run.return_value = mock_discovered_jobs\n            MockCrawler.return_value = crawler_instance\n\n            scorer_instance = AsyncMock()\n            scorer_instance.score_batch.return_value = mock_scored_jobs\n            MockScorer.return_value = scorer_instance\n\n            digest_instance = AsyncMock()\n            digest_instance.compile.return_value = DailyDigestSchema(\n                candidate_id=test_candidate.id,\n                run_date=\"2026-05-27\",\n                total_jobs_discovered=2,\n                total_jobs_scored=2,\n                top_picks=mock_scored_jobs,\n                hot_picks=mock_scored_jobs,\n                new_companies=[\"AI Startup Co\", \"FinTech Inc\"],\n            )\n            MockDigest.return_value = digest_instance\n\n            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n                mock_settings.anthropic_api_key = \"test-key\"\n                mock_settings.crawl_concurrency = 4\n                mock_settings.min_score = 60\n\n                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n                orchestrator._profiler = profiler_instance\n                orchestrator._archetype_gen = archetype_instance\n                orchestrator._scorer = scorer_instance\n                orchestrator._digest_builder = digest_instance\n\n                await orchestrator.run(test_candidate.id, dry_run=True)\n\n        await asyncio.sleep(0.2)\n        await collector.stop()\n\n        event_sequence = collector.get_event_sequence()\n        assert len(event_sequence) > 0, \"No events were published\"\n        assert event_sequence[-1] == \"RUN_COMPLETE\", (\n            f\"Expected RUN_COMPLETE as last event, got: {event_sequence[-1]}\"\n        )\n\n    @pytest.mark.asyncio\n    async def test_run_failed_emits_on_error(\n        self,\n        fake_redis,\n        async_db,\n        test_candidate,\n    ):\n        \"\"\"Verify RUN_FAILED is emitted when orchestrator encounters an error.\"\"\"\n        collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n        await collector.start()\n        await asyncio.sleep(0.1)\n\n        with (\n            patch.object(\n                DiscoveryOrchestrator, \"_load_candidate\"\n            ) as mock_load,\n            patch(\n                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n            ) as MockProfiler,\n        ):\n            mock_load.return_value = test_candidate\n\n            # Make profiler raise an exception\n            profiler_instance = AsyncMock()\n            profiler_instance.build_profile.side_effect = Exception(\"Claude API error\")\n            MockProfiler.return_value = profiler_instance\n\n            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n                mock_settings.anthropic_api_key = \"test-key\"\n                mock_settings.crawl_concurrency = 4\n                mock_settings.min_score = 60\n\n                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n                orchestrator._profiler = profiler_instance\n\n                with pytest.raises(Exception, match=\"Claude API error\"):\n                    await orchestrator.run(test_candidate.id, dry_run=True)\n\n        await asyncio.sleep(0.2)\n        await collector.stop()\n\n        event_sequence = collector.get_event_sequence()\n\n        # Should have CANDIDATE_LOADED then RUN_FAILED\n        assert \"CANDIDATE_LOADED\" in event_sequence\n        assert \"RUN_FAILED\" in event_sequence\n        assert event_sequence[-1] == \"RUN_FAILED\", (\n            f\"Expected RUN_FAILED as last event, got: {event_sequence[-1]}\"\n        )\n\n    @pytest.mark.asyncio\n    async def test_event_payload_contains_candidate_id(\n        self,\n        fake_redis,\n        async_db,\n        test_candidate,\n        mock_identity_profile,\n        mock_search_manifest,\n        mock_discovered_jobs,\n        mock_scored_jobs,\n    ):\n        \"\"\"Verify all published events contain the candidate_id.\"\"\"\n        collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n        await collector.start()\n        await asyncio.sleep(0.1)\n\n        with (\n            patch.object(\n                DiscoveryOrchestrator, \"_load_candidate\"\n            ) as mock_load,\n            patch(\n                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n            ) as MockProfiler,\n            patch(\n                \"backend.agents.discovery.orchestrator.ArchetypeGenerator\"\n            ) as MockArchetype,\n            patch(\n                \"backend.agents.discovery.orchestrator.CrawlerAgent\"\n            ) as MockCrawler,\n            patch(\n                \"backend.agents.discovery.orchestrator.RelevanceScorer\"\n            ) as MockScorer,\n            patch(\n                \"backend.agents.discovery.orchestrator.DigestBuilder\"\n            ) as MockDigest,\n        ):\n            mock_load.return_value = test_candidate\n\n            profiler_instance = AsyncMock()\n            profiler_instance.build_profile.return_value = mock_identity_profile\n            MockProfiler.return_value = profiler_instance\n\n            archetype_instance = MagicMock()\n            archetype_instance.expand.return_value = mock_search_manifest\n            MockArchetype.return_value = archetype_instance\n\n            crawler_instance = AsyncMock()\n            crawler_instance.run.return_value = mock_discovered_jobs\n            MockCrawler.return_value = crawler_instance\n\n            scorer_instance = AsyncMock()\n            scorer_instance.score_batch.return_value = mock_scored_jobs\n            MockScorer.return_value = scorer_instance\n\n            digest_instance = AsyncMock()\n            digest_instance.compile.return_value = DailyDigestSchema(\n                candidate_id=test_candidate.id,\n                run_date=\"2026-05-27\",\n                total_jobs_discovered=2,\n                total_jobs_scored=2,\n                top_picks=mock_scored_jobs,\n                hot_picks=mock_scored_jobs,\n                new_companies=[\"AI Startup Co\", \"FinTech Inc\"],\n            )\n            MockDigest.return_value = digest_instance\n\n            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n                mock_settings.anthropic_api_key = \"test-key\"\n                mock_settings.crawl_concurrency = 4\n                mock_settings.min_score = 60\n\n                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n                orchestrator._profiler = profiler_instance\n                orchestrator._archetype_gen = archetype_instance\n                orchestrator._scorer = scorer_instance\n                orchestrator._digest_builder = digest_instance\n\n                await orchestrator.run(test_candidate.id, dry_run=True)\n\n        await asyncio.sleep(0.2)\n        await collector.stop()\n\n        # Verify all messages have candidate_id\n        for msg in collector.messages:\n            assert \"candidate_id\" in msg, f\"Message missing candidate_id: {msg}\"\n            assert msg[\"candidate_id\"] == str(test_candidate.id), (\n                f\"Wrong candidate_id: {msg['candidate_id']}\"\n            )\n\n    @pytest.mark.asyncio\n    async def test_events_published_to_correct_channel(\n        self,\n        fake_redis,\n        async_db,\n        test_candidate,\n        mock_identity_profile,\n        mock_search_manifest,\n        mock_discovered_jobs,\n        mock_scored_jobs,\n    ):\n        \"\"\"Verify events are published to agent.status.discovery channel.\"\"\"\n        # Subscribe to a different channel — should receive nothing\n        wrong_collector = PubSubCollector(fake_redis, \"agent.status.application\")\n        await wrong_collector.start()\n\n        # Subscribe to the correct channel\n        correct_collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n        await correct_collector.start()\n\n        await asyncio.sleep(0.1)\n\n        with (\n            patch.object(\n                DiscoveryOrchestrator, \"_load_candidate\"\n            ) as mock_load,\n            patch(\n                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n            ) as MockProfiler,\n            patch(\n                \"backend.agents.discovery.orchestrator.ArchetypeGenerator\"\n            ) as MockArchetype,\n            patch(\n                \"backend.agents.discovery.orchestrator.CrawlerAgent\"\n            ) as MockCrawler,\n            patch(\n                \"backend.agents.discovery.orchestrator.RelevanceScorer\"\n            ) as MockScorer,\n            patch(\n                \"backend.agents.discovery.orchestrator.DigestBuilder\"\n            ) as MockDigest,\n        ):\n            mock_load.return_value = test_candidate\n\n            profiler_instance = AsyncMock()\n            profiler_instance.build_profile.return_value = mock_identity_profile\n            MockProfiler.return_value = profiler_instance\n\n            archetype_instance = MagicMock()\n            archetype_instance.expand.return_value = mock_search_manifest\n            MockArchetype.return_value = archetype_instance\n\n            crawler_instance = AsyncMock()\n            crawler_instance.run.return_value = mock_discovered_jobs\n            MockCrawler.return_value = crawler_instance\n\n            scorer_instance = AsyncMock()\n            scorer_instance.score_batch.return_value = mock_scored_jobs\n            MockScorer.return_value = scorer_instance\n\n            digest_instance = AsyncMock()\n            digest_instance.compile.return_value = DailyDigestSchema(\n                candidate_id=test_candidate.id,\n                run_date=\"2026-05-27\",\n                total_jobs_discovered=2,\n                total_jobs_scored=2,\n                top_picks=mock_scored_jobs,\n                hot_picks=mock_scored_jobs,\n                new_companies=[\"AI Startup Co\", \"FinTech Inc\"],\n            )\n            MockDigest.return_value = digest_instance\n\n            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n                mock_settings.anthropic_api_key = \"test-key\"\n                mock_settings.crawl_concurrency = 4\n                mock_settings.min_score = 60\n\n                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n                orchestrator._profiler = profiler_instance\n                orchestrator._archetype_gen = archetype_instance\n                orchestrator._scorer = scorer_instance\n                orchestrator._digest_builder = digest_instance\n\n                await orchestrator.run(test_candidate.id, dry_run=True)\n\n        await asyncio.sleep(0.2)\n        await wrong_collector.stop()\n        await correct_collector.stop()\n\n        # Wrong channel should have no messages\n        assert len(wrong_collector.messages) == 0, (\n            f\"Wrong channel received messages: {wrong_collector.messages}\"\n        )\n\n        # Correct channel should have messages\n        assert len(correct_collector.messages) > 0, (\n            \"Correct channel received no messages\"\n        )\n\n    @pytest.mark.asyncio\n    async def test_event_order_is_deterministic(\n        self,\n        fake_redis,\n        async_db,\n        test_candidate,\n        mock_identity_profile,\n        mock_search_manifest,\n        mock_discovered_jobs,\n        mock_scored_jobs,\n    ):\n        \"\"\"Verify event order follows the pipeline execution order.\"\"\"\n        collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n        await collector.start()\n        await asyncio.sleep(0.1)\n\n        with (\n            patch.object(\n                DiscoveryOrchestrator, \"_load_candidate\"\n            ) as mock_load,\n            patch(\n                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n            ) as MockProfiler,\n            patch(\n                \"backend.agents.discovery.orchestrator.ArchetypeGenerator\"\n            ) as MockArchetype,\n            patch(\n                \"backend.agents.discovery.orchestrator.CrawlerAgent\"\n            ) as MockCrawler,\n            patch(\n                \"backend.agents.discovery.orchestrator.RelevanceScorer\"\n            ) as MockScorer,\n            patch(\n                \"backend.agents.discovery.orchestrator.DigestBuilder\"\n            ) as MockDigest,\n        ):\n            mock_load.return_value = test_candidate\n\n            profiler_instance = AsyncMock()\n            profiler_instance.build_profile.return_value = mock_identity_profile\n            MockProfiler.return_value = profiler_instance\n\n            archetype_instance = MagicMock()\n            archetype_instance.expand.return_value = mock_search_manifest\n            MockArchetype.return_value = archetype_instance\n\n            crawler_instance = AsyncMock()\n            crawler_instance.run.return_value = mock_discovered_jobs\n            MockCrawler.return_value = crawler_instance\n\n            scorer_instance = AsyncMock()\n            scorer_instance.score_batch.return_value = mock_scored_jobs\n            MockScorer.return_value = scorer_instance\n\n            digest_instance = AsyncMock()\n            digest_instance.compile.return_value = DailyDigestSchema(\n                candidate_id=test_candidate.id,\n                run_date=\"2026-05-27\",\n                total_jobs_discovered=2,\n                total_jobs_scored=2,\n                top_picks=mock_scored_jobs,\n                hot_picks=mock_scored_jobs,\n                new_companies=[\"AI Startup Co\", \"FinTech Inc\"],\n            )\n            MockDigest.return_value = digest_instance\n\n            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n                mock_settings.anthropic_api_key = \"test-key\"\n                mock_settings.crawl_concurrency = 4\n                mock_settings.min_score = 60\n\n                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n                orchestrator._profiler = profiler_instance\n                orchestrator._archetype_gen = archetype_instance\n                orchestrator._scorer = scorer_instance\n                orchestrator._digest_builder = digest_instance\n\n                await orchestrator.run(test_candidate.id, dry_run=True)\n\n        await asyncio.sleep(0.2)\n        await collector.stop()\n\n        event_sequence = collector.get_event_sequence()\n\n        # Define expected order\n        expected_order = [\n            \"CANDIDATE_LOADED\",\n            \"PROFILE_BUILT\",\n            \"MANIFEST_BUILT\",\n            \"CRAWL_COMPLETE\",\n            \"SCORING_COMPLETE\",\n            \"RUN_COMPLETE\",\n        ]\n\n        # Verify order\n        for i, expected in enumerate(expected_order):\n            assert event_sequence[i] == expected, (\n                f\"Event at position {i} should be {expected}, \"\n                f\"got {event_sequence[i]}. Full sequence: {event_sequence}\"\n            )\n","numLines":909,"startLine":1,"totalLines":909}}}}
