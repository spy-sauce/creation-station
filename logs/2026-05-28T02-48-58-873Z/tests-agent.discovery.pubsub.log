{"t":"2026-05-28T02:59:06.805Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PFdKZ1frmwDvknnTuZGdaS","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Smoke tests for the RelevanceScorer — scoring math, not Claude API calls.\n     6→\n     7→These tests run fully offline (no Anthropic API, no DB, no Redis).\n     8→\"\"\"\n     9→\n    10→import pytest\n    11→from uuid import uuid4\n    12→\n    13→from backend.agents.discovery.schemas import (\n    14→    IdentityProfileSchema,\n    15→    DiscoveredJobSchema,\n    16→    ScoreBreakdown,\n    17→)\n    18→from backend.agents.discovery.relevance_scorer import RelevanceScorer\n    19→\n    20→\n    21→# ─── Fixtures ─────────────────────────────────────────────────────────────────\n    22→\n    23→\n    24→@pytest.fixture\n    25→def profile() -> IdentityProfileSchema:\n    26→    \"\"\"A realistic identity profile for Sean Young.\"\"\"\n    27→    return IdentityProfileSchema(\n    28→        archetypes=[\n    29→            \"Head of AI\",\n    30→            \"VP Engineering at music-tech startup\",\n    31→            \"Technical Co-Founder Series A\",\n    32→            \"AI Creative Director\",\n    33→            \"CTO fractional\",\n    34→        ],\n    35→        leadership_level=\"C-Level\",\n    36→        technical_skills=[\n    37→            \"Python\",\n    38→            \"FastAPI\",\n    39→            \"Java\",\n    40→            \"Spring Boot\",\n    41→            \"PostgreSQL\",\n    42→            \"Redis\",\n    43→            \"Docker\",\n    44→            \"Kubernetes\",\n    45→            \"Claude API\",\n    46→            \"Solana\",\n    47→        ],\n    48→        soft_skills=[\"technical-leadership\", \"team-building\", \"product-vision\"],\n    49→        industry_experience=[\"fintech\", \"ai\", \"web3\", \"music\", \"creator-economy\"],\n    50→        notable_achievements=[\n    51→            \"Founded VibeSpace\",\n    52→            \"Built AI-powered talent agent system\",\n    53→        ],\n    54→        career_trajectory=\"From software engineer to founder\",\n    55→        ideal_role_description=\"Lead AI engineering at a mission-driven music-tech startup\",\n    56→        signals={\n    57→            \"startup_vs_enterprise\": \"startup\",\n    58→            \"remote_preference\": \"remote\",\n    59→            \"mission_vs_comp\": \"mission\",\n    60→        },\n    61→    )\n    62→\n    63→\n    64→@pytest.fixture\n    65→def strong_match_job() -> DiscoveredJobSchema:\n    66→    \"\"\"A job that should score high for this profile.\"\"\"\n    67→    return DiscoveredJobSchema(\n    68→        id=uuid4(),\n    69→        source=\"greenhouse\",\n    70→        source_id=\"gh-12345\",\n    71→        title=\"Head of AI Engineering\",\n    72→        company=\"MusicTech Startup\",\n    73→        location=\"Remote\",\n    74→        url=\"https://example.com/jobs/head-of-ai\",\n    75→        description=\"\"\"\n    76→        We're a Series B music-tech startup building AI tools for creators.\n    77→        Looking for a Head of AI Engineering to define our AI strategy from scratch.\n    78→\n    79→        Required: Python, FastAPI, PostgreSQL, Redis, LLMs, Claude API\n    80→        Preferred: Kubernetes, Solana, Web3\n    81→\n    82→        This is a 0-to-1 greenfield role. You'll shape the technical strategy,\n    83→        build the team from scratch, and report directly to the CTO.\n    84→\n    85→        Compensation: $250,000-$300,000 + equity\n    86→\n    87→        Remote-first. Mission-driven team.\n    88→        Industry: Music, AI, Creator Economy\n    89→        \"\"\",\n    90→    )\n    91→\n    92→\n    93→@pytest.fixture\n    94→def weak_match_job() -> DiscoveredJobSchema:\n    95→    \"\"\"A job that should score low for this profile.\"\"\"\n    96→    return DiscoveredJobSchema(\n    97→        id=uuid4(),\n    98→        source=\"indeed\",\n    99→        source_id=\"indeed-67890\",\n   100→        title=\"Junior Java Developer\",\n   101→        company=\"Big Bank Corp\",\n   102→        location=\"New York, NY (On-site required)\",\n   103→        url=\"https://bigbank.com/jobs/junior-java\",\n   104→        description=\"\"\"\n   105→        Entry-level Java developer position. 0-2 years experience preferred.\n   106→        Required: Java basics, SQL\n   107→        On-site 5 days/week in Manhattan.\n   108→        Salary: $65,000 - $80,000\n   109→        Industry: Traditional Banking\n   110→        \"\"\",\n   111→    )\n   112→\n   113→\n   114→# ─── ScoreBreakdown unit tests ────────────────────────────────────────────────\n   115→\n   116→\n   117→class TestScoreBreakdown:\n   118→    def test_composite_weights_sum_to_full_score(self):\n   119→        \"\"\"All dimensions at 100 should produce composite of 100.\"\"\"\n   120→        breakdown = ScoreBreakdown(\n   121→            technical_match=100,\n   122→            level_match=100,\n   123→            culture_match=100,\n   124→            industry_match=100,\n   125→            growth_potential=100,\n   126→            compensation_match=100,\n   127→        )\n   128→        assert breakdown.composite == 100\n   129→\n   130→    def test_composite_is_weighted(self):\n   131→        \"\"\"Technical match at 100 (30% weight) + zeros = 30.\"\"\"\n   132→        breakdown = ScoreBreakdown(\n   133→            technical_match=100,\n   134→            level_match=0,\n   135→            culture_match=0,\n   136→            industry_match=0,\n   137→            growth_potential=0,\n   138→            compensation_match=0,\n   139→        )\n   140→        assert breakdown.composite == 30\n   141→\n   142→    def test_composite_rounds_down(self):\n   143→        \"\"\"Composite should be an integer.\"\"\"\n   144→        breakdown = ScoreBreakdown(\n   145→            technical_match=50,\n   146→            level_match=50,\n   147→            culture_match=50,\n   148→            industry_match=50,\n   149→            growth_potential=50,\n   150→            compensation_match=50,\n   151→        )\n   152→        assert breakdown.composite == 50\n   153→        assert isinstance(breakdown.composite, int)\n   154→\n   155→    def test_field_bounds(self):\n   156→        \"\"\"Scores outside 0-100 should be rejected by pydantic.\"\"\"\n   157→        import pytest as pt\n   158→        from pydantic import ValidationError\n   159→\n   160→        with pt.raises(ValidationError):\n   161→            ScoreBreakdown(\n   162→                technical_match=101,\n   163→                level_match=0,\n   164→                culture_match=0,\n   165→                industry_match=0,\n   166→                growth_potential=0,\n   167→                compensation_match=0,\n   168→            )\n   169→\n   170→\n   171→# ─── RelevanceScorer local scoring tests (no Claude) ─────────────────────────\n   172→\n   173→\n   174→class TestRelevanceScorerLocal:\n   175→    \"\"\"\n   176→    Tests for the local scoring methods that don't require Claude API.\n   177→\n   178→    Instantiates RelevanceScorer with a None client — only _score_* methods\n   179→    that don't call self._claude are tested here.\n   180→    \"\"\"\n   181→\n   182→    @pytest.fixture\n   183→    def scorer(self):\n   184→        return RelevanceScorer(anthropic_client=None)  # type: ignore\n   185→\n   186→    def test_technical_match_high_overlap(self, scorer, profile):\n   187→        parsed_jd = {\n   188→            \"required_skills\": [\"Python\", \"FastAPI\", \"PostgreSQL\", \"Redis\"],\n   189→            \"preferred_skills\": [\"Kubernetes\", \"Docker\"],\n   190→        }\n   191→        score = scorer._score_technical(parsed_jd, profile)\n   192→        assert score >= 80, f\"Expected >= 80, got {score}\"\n   193→\n   194→    def test_technical_match_no_overlap(self, scorer, profile):\n   195→        parsed_jd = {\n   196→            \"required_skills\": [\"COBOL\", \"Fortran\", \"RPGLE\"],\n   197→            \"preferred_skills\": [],\n   198→        }\n   199→        score = scorer._score_technical(parsed_jd, profile)\n   200→        assert score < 30, f\"Expected < 30, got {score}\"\n   201→\n   202→    def test_technical_match_no_requirements(self, scorer, profile):\n   203→        \"\"\"Empty requirements = neutral score.\"\"\"\n   204→        score = scorer._score_technical({}, profile)\n   205→        assert score == 60\n   206→\n   207→    def test_level_match_exact(self, scorer, profile):\n   208→        \"\"\"C-Level → cto should be 100.\"\"\"\n   209→        parsed_jd = {\"seniority_level\": \"cto\"}\n   210→        score = scorer._score_level(parsed_jd, profile)\n   211→        assert score == 100\n   212→\n   213→    def test_level_match_one_step_off(self, scorer, profile):\n   214→        \"\"\"C-Level → vp (1 step) should be 80.\"\"\"\n   215→        parsed_jd = {\"seniority_level\": \"vp\"}\n   216→        score = scorer._score_level(parsed_jd, profile)\n   217→        assert score == 80\n   218→\n   219→    def test_level_match_junior_job_for_clevel(self, scorer, profile):\n   220→        \"\"\"C-Level vs junior (many steps) should be low.\"\"\"\n   221→        parsed_jd = {\"seniority_level\": \"junior\"}\n   222→        score = scorer._score_level(parsed_jd, profile)\n   223→        assert score <= 30\n   224→\n   225→    def test_culture_match_remote_alignment(self, scorer, profile):\n   226→        \"\"\"Remote candidate + remote job should score well.\"\"\"\n   227→        job = DiscoveredJobSchema(\n   228→            source=\"greenhouse\",\n   229→            source_id=\"test-1\",\n   230→            title=\"Test\",\n   231→            company=\"Test Co\",\n   232→            url=\"https://x.com\",\n   233→        )\n   234→        parsed_jd = {\n   235→            \"remote_type\": \"remote\",\n   236→            \"culture_signals\": {\"startup_vs_enterprise\": \"startup\"},\n   237→        }\n   238→        score = scorer._score_culture(parsed_jd, profile, job)\n   239→        assert score >= 80\n   240→\n   241→    def test_culture_match_onsite_penalty(self, scorer, profile):\n   242→        \"\"\"Remote candidate + onsite job should score low.\"\"\"\n   243→        job = DiscoveredJobSchema(\n   244→            source=\"greenhouse\",\n   245→            source_id=\"test-2\",\n   246→            title=\"Test\",\n   247→            company=\"Test Co\",\n   248→            url=\"https://x.com\",\n   249→        )\n   250→        parsed_jd = {\n   251→            \"remote_type\": \"onsite\",\n   252→            \"culture_signals\": {\"startup_vs_enterprise\": \"enterprise\"},\n   253→        }\n   254→        score = scorer._score_culture(parsed_jd, profile, job)\n   255→        assert score < 40\n   256→\n   257→    def test_compensation_not_listed(self, scorer, profile):\n   258→        \"\"\"Senior roles often don't list comp — should be generous neutral.\"\"\"\n   259→        score = scorer._score_compensation({}, profile)\n   260→        assert score >= 70\n   261→\n   262→\n   263→# ─── Archetype generator tests ────────────────────────────────────────────────\n   264→\n   265→\n   266→class TestArchetypeGenerator:\n   267→    def test_title_expansion_known_archetype(self, profile):\n   268→        from backend.agents.discovery.archetype_generator import ArchetypeGenerator\n   269→\n   270→        gen = ArchetypeGenerator()\n   271→        manifest = gen.expand(\n   272→            profile,\n   273→            {\"titles\": [], \"companies\": [], \"industries\": []},\n   274→        )\n   275→        assert len(manifest.target_titles) > 0\n   276→        assert len(manifest.keywords) > 0\n   277→\n   278→    def test_exclusions_passed_through(self, profile):\n   279→        \"\"\"Excluded companies and industries should be in the manifest.\"\"\"\n   280→        from backend.agents.discovery.archetype_generator import ArchetypeGenerator\n   281→\n   282→        gen = ArchetypeGenerator()\n   283→        manifest = gen.expand(\n   284→            profile,\n   285→            {\n   286→                \"titles\": [],\n   287→                \"companies\": [\"BadCo\"],\n   288→                \"industries\": [\"oil-and-gas\"],\n   289→            },\n   290→        )\n   291→        assert \"BadCo\" in manifest.excluded_companies\n   292→        assert \"oil-and-gas\" in manifest.excluded_industries\n   293→\n   294→    def test_keywords_include_skills(self, profile):\n   295→        \"\"\"Keywords should include technical skills from the profile.\"\"\"\n   296→        from backend.agents.discovery.archetype_generator import ArchetypeGenerator\n   297→\n   298→        gen = ArchetypeGenerator()\n   299→        manifest = gen.expand(\n   300→            profile,\n   301→            {\"titles\": [], \"companies\": [], \"industries\": []},\n   302→        )\n   303→        # At least some skills should be in keywords\n   304→        skill_overlap = set(profile.technical_skills[:10]) & set(manifest.keywords)\n   305→        assert len(skill_overlap) > 0\n   306→\n   307→\n   308→# ─── CrawlerAgent tests ───────────────────────────────────────────────────────\n   309→\n   310→\n   311→class TestCrawlerAgent:\n   312→    \"\"\"Tests for the CrawlerAgent Phase 1A stub implementation.\"\"\"\n   313→\n   314→    @pytest.fixture\n   315→    def manifest(self):\n   316→        from backend.agents.discovery.schemas import SearchManifestSchema\n   317→\n   318→        return SearchManifestSchema(\n   319→            target_titles=[\"Head of AI\", \"VP Engineering\", \"CTO\"],\n   320→            keywords=[\"Python\", \"FastAPI\", \"AI\", \"music\"],\n   321→            excluded_companies=[],\n   322→            excluded_industries=[],\n   323→            location_filters=[],\n   324→            remote_preference=\"remote\",\n   325→        )\n   326→\n   327→    @pytest.mark.asyncio\n   328→    async def test_crawler_returns_jobs(self, manifest):\n   329→        \"\"\"CrawlerAgent.run() should return a non-empty list of jobs.\"\"\"\n   330→        from backend.agents.discovery.crawler_agent import CrawlerAgent\n   331→\n   332→        crawler = CrawlerAgent(candidate_id=uuid4())\n   333→        jobs = await crawler.run(manifest)\n   334→\n   335→        assert len(jobs) > 0\n   336→        assert all(j.title for j in jobs)\n   337→        assert all(j.company for j in jobs)\n   338→        assert all(j.url for j in jobs)\n   339→\n   340→    @pytest.mark.asyncio\n   341→    async def test_crawler_respects_exclusions(self):\n   342→        \"\"\"CrawlerAgent should exclude companies on the exclusion list.\"\"\"\n   343→        from backend.agents.discovery.crawler_agent import CrawlerAgent\n   344→        from backend.agents.discovery.schemas import SearchManifestSchema\n   345→\n   346→        manifest = SearchManifestSchema(\n   347→            target_titles=[\"Head of AI\", \"VP Engineering\"],\n   348→            keywords=[\"Python\", \"AI\"],\n   349→            excluded_companies=[\"MusicTech AI\"],  # Exclude a fixture company\n   350→            excluded_industries=[],\n   351→            location_filters=[],\n   352→            remote_preference=\"flexible\",\n   353→        )\n   354→\n   355→        crawler = CrawlerAgent(candidate_id=uuid4())\n   356→        jobs = await crawler.run(manifest)\n   357→\n   358→        # None of the returned jobs should be from MusicTech AI\n   359→        for job in jobs:\n   360→            assert \"musictech ai\" not in job.company.lower()\n   361→\n   362→    @pytest.mark.asyncio\n   363→    async def test_crawler_filters_by_keywords(self):\n   364→        \"\"\"CrawlerAgent should only return jobs matching keywords or titles.\"\"\"\n   365→        from backend.agents.discovery.crawler_agent import CrawlerAgent\n   366→        from backend.agents.discovery.schemas import SearchManifestSchema\n   367→\n   368→        # Use keywords that won't match any fixture jobs\n   369→        manifest = SearchManifestSchema(\n   370→            target_titles=[\"Underwater Basket Weaver\"],\n   371→            keywords=[\"ancient-greek\", \"basket-weaving\"],\n   372→            excluded_companies=[],\n   373→            excluded_industries=[],\n   374→            location_filters=[],\n   375→            remote_preference=\"flexible\",\n   376→        )\n   377→\n   378→        crawler = CrawlerAgent(candidate_id=uuid4())\n   379→        jobs = await crawler.run(manifest)\n   380→\n   381→        # Should return empty list when nothing matches\n   382→        assert len(jobs) == 0\n   383→\n   384→    def test_url_hash_deterministic(self):\n   385→        \"\"\"url_hash should return the same hash for the same URL.\"\"\"\n   386→        from backend.agents.discovery.crawler_agent import CrawlerAgent\n   387→\n   388→        url = \"https://example.com/jobs/123\"\n   389→        hash1 = CrawlerAgent.url_hash(url)\n   390→        hash2 = CrawlerAgent.url_hash(url)\n   391→        assert hash1 == hash2\n   392→\n   393→    def test_url_hash_case_insensitive(self):\n   394→        \"\"\"url_hash should be case-insensitive.\"\"\"\n   395→        from backend.agents.discovery.crawler_agent import CrawlerAgent\n   396→\n   397→        hash1 = CrawlerAgent.url_hash(\"https://Example.COM/Jobs/123\")\n   398→        hash2 = CrawlerAgent.url_hash(\"https://example.com/jobs/123\")\n   399→        assert hash1 == hash2\n   400→\n   401→\n   402→# ─── Schema validation tests ─────────────────────────────────────────────────\n   403→\n   404→\n   405→class TestSchemas:\n   406→    def test_identity_profile_defaults(self):\n   407→        \"\"\"IdentityProfileSchema should have sensible defaults.\"\"\"\n   408→        profile = IdentityProfileSchema()\n   409→        assert profile.leadership_level == \"IC\"\n   410→        assert profile.archetypes == []\n   411→        assert profile.technical_skills == {} or profile.technical_skills == []\n   412→        assert profile.signals == {}\n   413→\n   414→    def test_discovered_job_minimal(self):\n   415→        \"\"\"DiscoveredJobSchema should work with minimal required fields.\"\"\"\n   416→        job = DiscoveredJobSchema(\n   417→            source=\"greenhouse\",\n   418→            source_id=\"test-123\",\n   419→            title=\"Test Job\",\n   420→            company=\"Test Co\",\n   421→            url=\"https://example.com/job\",\n   422→        )\n   423→        assert job.title == \"Test Job\"\n   424→        assert job.remote is False  # default\n   425→\n   426→    def test_scored_job_schema(self, profile):\n   427→        \"\"\"ScoredJobSchema should validate correctly.\"\"\"\n   428→        from backend.agents.discovery.schemas import ScoredJobSchema\n   429→\n   430→        scored = ScoredJobSchema(\n   431→            discovered_job_id=uuid4(),\n   432→            candidate_id=uuid4(),\n   433→            score_breakdown=ScoreBreakdown(\n   434→                technical_match=80,\n   435→                level_match=90,\n   436→                culture_match=75,\n   437→                industry_match=70,\n   438→                growth_potential=85,\n   439→                compensation_match=80,\n   440→            ),\n   441→            composite_score=80,\n   442→            is_hot=True,\n   443→            reasoning=\"Strong technical match with leadership alignment.\",\n   444→            title=\"Head of AI\",\n   445→            company=\"Test Co\",\n   446→            url=\"https://example.com/job\",\n   447→        )\n   448→        assert scored.is_hot is True\n   449→        assert scored.composite_score == 80\n   450→\n   451→    def test_daily_digest_schema(self):\n   452→        \"\"\"DailyDigestSchema should validate correctly.\"\"\"\n   453→        from backend.agents.discovery.schemas import DailyDigestSchema\n   454→\n   455→        digest = DailyDigestSchema(\n   456→            candidate_id=uuid4(),\n   457→            run_date=\"2026-05-20\",\n   458→            total_jobs_discovered=100,\n   459→            total_jobs_scored=25,\n   460→            top_picks=[],\n   461→            hot_picks=[],\n   462→            new_companies=[\"NewCo\", \"AnotherCo\"],\n   463→        )\n   464→        assert digest.total_jobs_discovered == 100\n   465→        assert len(digest.new_companies) == 2\n   466→\n   467→\n   468→# ─── Search manifest tests ───────────────────────────────────────────────────\n   469→\n   470→\n   471→class TestSearchManifest:\n   472→    def test_manifest_defaults(self):\n   473→        \"\"\"SearchManifestSchema should have sensible defaults.\"\"\"\n   474→        from backend.agents.discovery.schemas import SearchManifestSchema\n   475→\n   476→        manifest = SearchManifestSchema()\n   477→        assert manifest.target_titles == []\n   478→        assert manifest.keywords == []\n   479→        assert manifest.remote_preference == \"flexible\"\n   480→        assert manifest.min_compensation is None\n   481→\n   482→    def test_manifest_with_data(self):\n   483→        \"\"\"SearchManifestSchema should accept all fields.\"\"\"\n   484→        from backend.agents.discovery.schemas import SearchManifestSchema\n   485→\n   486→        manifest = SearchManifestSchema(\n   487→            target_titles=[\"CTO\", \"VP Engineering\"],\n   488→            keywords=[\"Python\", \"AI\"],\n   489→            excluded_titles=[\"Junior\"],\n   490→            excluded_companies=[\"BadCo\"],\n   491→            excluded_industries=[\"oil\"],\n   492→            location_filters=[\"Remote\", \"Miami\"],\n   493→            remote_preference=\"remote_only\",\n   494→            min_compensation=250000,\n   495→        )\n   496→        assert len(manifest.target_titles) == 2\n   497→        assert manifest.min_compensation == 250000\n   498→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"f2750489-d8d6-41f5-b42f-4d2a4cab3a05","uuid":"dab10120-ad9c-4a96-a5de-847e35cf2c63","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/tests/discovery/test_scorer.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nSmoke tests for the RelevanceScorer — scoring math, not Claude API calls.\n\nThese tests run fully offline (no Anthropic API, no DB, no Redis).\n\"\"\"\n\nimport pytest\nfrom uuid import uuid4\n\nfrom backend.agents.discovery.schemas import (\n    IdentityProfileSchema,\n    DiscoveredJobSchema,\n    ScoreBreakdown,\n)\nfrom backend.agents.discovery.relevance_scorer import RelevanceScorer\n\n\n# ─── Fixtures ─────────────────────────────────────────────────────────────────\n\n\n@pytest.fixture\ndef profile() -> IdentityProfileSchema:\n    \"\"\"A realistic identity profile for Sean Young.\"\"\"\n    return IdentityProfileSchema(\n        archetypes=[\n            \"Head of AI\",\n            \"VP Engineering at music-tech startup\",\n            \"Technical Co-Founder Series A\",\n            \"AI Creative Director\",\n            \"CTO fractional\",\n        ],\n        leadership_level=\"C-Level\",\n        technical_skills=[\n            \"Python\",\n            \"FastAPI\",\n            \"Java\",\n            \"Spring Boot\",\n            \"PostgreSQL\",\n            \"Redis\",\n            \"Docker\",\n            \"Kubernetes\",\n            \"Claude API\",\n            \"Solana\",\n        ],\n        soft_skills=[\"technical-leadership\", \"team-building\", \"product-vision\"],\n        industry_experience=[\"fintech\", \"ai\", \"web3\", \"music\", \"creator-economy\"],\n        notable_achievements=[\n            \"Founded VibeSpace\",\n            \"Built AI-powered talent agent system\",\n        ],\n        career_trajectory=\"From software engineer to founder\",\n        ideal_role_description=\"Lead AI engineering at a mission-driven music-tech startup\",\n        signals={\n            \"startup_vs_enterprise\": \"startup\",\n            \"remote_preference\": \"remote\",\n            \"mission_vs_comp\": \"mission\",\n        },\n    )\n\n\n@pytest.fixture\ndef strong_match_job() -> DiscoveredJobSchema:\n    \"\"\"A job that should score high for this profile.\"\"\"\n    return DiscoveredJobSchema(\n        id=uuid4(),\n        source=\"greenhouse\",\n        source_id=\"gh-12345\",\n        title=\"Head of AI Engineering\",\n        company=\"MusicTech Startup\",\n        location=\"Remote\",\n        url=\"https://example.com/jobs/head-of-ai\",\n        description=\"\"\"\n        We're a Series B music-tech startup building AI tools for creators.\n        Looking for a Head of AI Engineering to define our AI strategy from scratch.\n\n        Required: Python, FastAPI, PostgreSQL, Redis, LLMs, Claude API\n        Preferred: Kubernetes, Solana, Web3\n\n        This is a 0-to-1 greenfield role. You'll shape the technical strategy,\n        build the team from scratch, and report directly to the CTO.\n\n        Compensation: $250,000-$300,000 + equity\n\n        Remote-first. Mission-driven team.\n        Industry: Music, AI, Creator Economy\n        \"\"\",\n    )\n\n\n@pytest.fixture\ndef weak_match_job() -> DiscoveredJobSchema:\n    \"\"\"A job that should score low for this profile.\"\"\"\n    return DiscoveredJobSchema(\n        id=uuid4(),\n        source=\"indeed\",\n        source_id=\"indeed-67890\",\n        title=\"Junior Java Developer\",\n        company=\"Big Bank Corp\",\n        location=\"New York, NY (On-site required)\",\n        url=\"https://bigbank.com/jobs/junior-java\",\n        description=\"\"\"\n        Entry-level Java developer position. 0-2 years experience preferred.\n        Required: Java basics, SQL\n        On-site 5 days/week in Manhattan.\n        Salary: $65,000 - $80,000\n        Industry: Traditional Banking\n        \"\"\",\n    )\n\n\n# ─── ScoreBreakdown unit tests ────────────────────────────────────────────────\n\n\nclass TestScoreBreakdown:\n    def test_composite_weights_sum_to_full_score(self):\n        \"\"\"All dimensions at 100 should produce composite of 100.\"\"\"\n        breakdown = ScoreBreakdown(\n            technical_match=100,\n            level_match=100,\n            culture_match=100,\n            industry_match=100,\n            growth_potential=100,\n            compensation_match=100,\n        )\n        assert breakdown.composite == 100\n\n    def test_composite_is_weighted(self):\n        \"\"\"Technical match at 100 (30% weight) + zeros = 30.\"\"\"\n        breakdown = ScoreBreakdown(\n            technical_match=100,\n            level_match=0,\n            culture_match=0,\n            industry_match=0,\n            growth_potential=0,\n            compensation_match=0,\n        )\n        assert breakdown.composite == 30\n\n    def test_composite_rounds_down(self):\n        \"\"\"Composite should be an integer.\"\"\"\n        breakdown = ScoreBreakdown(\n            technical_match=50,\n            level_match=50,\n            culture_match=50,\n            industry_match=50,\n            growth_potential=50,\n            compensation_match=50,\n        )\n        assert breakdown.composite == 50\n        assert isinstance(breakdown.composite, int)\n\n    def test_field_bounds(self):\n        \"\"\"Scores outside 0-100 should be rejected by pydantic.\"\"\"\n        import pytest as pt\n        from pydantic import ValidationError\n\n        with pt.raises(ValidationError):\n            ScoreBreakdown(\n                technical_match=101,\n                level_match=0,\n                culture_match=0,\n                industry_match=0,\n                growth_potential=0,\n                compensation_match=0,\n            )\n\n\n# ─── RelevanceScorer local scoring tests (no Claude) ─────────────────────────\n\n\nclass TestRelevanceScorerLocal:\n    \"\"\"\n    Tests for the local scoring methods that don't require Claude API.\n\n    Instantiates RelevanceScorer with a None client — only _score_* methods\n    that don't call self._claude are tested here.\n    \"\"\"\n\n    @pytest.fixture\n    def scorer(self):\n        return RelevanceScorer(anthropic_client=None)  # type: ignore\n\n    def test_technical_match_high_overlap(self, scorer, profile):\n        parsed_jd = {\n            \"required_skills\": [\"Python\", \"FastAPI\", \"PostgreSQL\", \"Redis\"],\n            \"preferred_skills\": [\"Kubernetes\", \"Docker\"],\n        }\n        score = scorer._score_technical(parsed_jd, profile)\n        assert score >= 80, f\"Expected >= 80, got {score}\"\n\n    def test_technical_match_no_overlap(self, scorer, profile):\n        parsed_jd = {\n            \"required_skills\": [\"COBOL\", \"Fortran\", \"RPGLE\"],\n            \"preferred_skills\": [],\n        }\n        score = scorer._score_technical(parsed_jd, profile)\n        assert score < 30, f\"Expected < 30, got {score}\"\n\n    def test_technical_match_no_requirements(self, scorer, profile):\n        \"\"\"Empty requirements = neutral score.\"\"\"\n        score = scorer._score_technical({}, profile)\n        assert score == 60\n\n    def test_level_match_exact(self, scorer, profile):\n        \"\"\"C-Level → cto should be 100.\"\"\"\n        parsed_jd = {\"seniority_level\": \"cto\"}\n        score = scorer._score_level(parsed_jd, profile)\n        assert score == 100\n\n    def test_level_match_one_step_off(self, scorer, profile):\n        \"\"\"C-Level → vp (1 step) should be 80.\"\"\"\n        parsed_jd = {\"seniority_level\": \"vp\"}\n        score = scorer._score_level(parsed_jd, profile)\n        assert score == 80\n\n    def test_level_match_junior_job_for_clevel(self, scorer, profile):\n        \"\"\"C-Level vs junior (many steps) should be low.\"\"\"\n        parsed_jd = {\"seniority_level\": \"junior\"}\n        score = scorer._score_level(parsed_jd, profile)\n        assert score <= 30\n\n    def test_culture_match_remote_alignment(self, scorer, profile):\n        \"\"\"Remote candidate + remote job should score well.\"\"\"\n        job = DiscoveredJobSchema(\n            source=\"greenhouse\",\n            source_id=\"test-1\",\n            title=\"Test\",\n            company=\"Test Co\",\n            url=\"https://x.com\",\n        )\n        parsed_jd = {\n            \"remote_type\": \"remote\",\n            \"culture_signals\": {\"startup_vs_enterprise\": \"startup\"},\n        }\n        score = scorer._score_culture(parsed_jd, profile, job)\n        assert score >= 80\n\n    def test_culture_match_onsite_penalty(self, scorer, profile):\n        \"\"\"Remote candidate + onsite job should score low.\"\"\"\n        job = DiscoveredJobSchema(\n            source=\"greenhouse\",\n            source_id=\"test-2\",\n            title=\"Test\",\n            company=\"Test Co\",\n            url=\"https://x.com\",\n        )\n        parsed_jd = {\n            \"remote_type\": \"onsite\",\n            \"culture_signals\": {\"startup_vs_enterprise\": \"enterprise\"},\n        }\n        score = scorer._score_culture(parsed_jd, profile, job)\n        assert score < 40\n\n    def test_compensation_not_listed(self, scorer, profile):\n        \"\"\"Senior roles often don't list comp — should be generous neutral.\"\"\"\n        score = scorer._score_compensation({}, profile)\n        assert score >= 70\n\n\n# ─── Archetype generator tests ────────────────────────────────────────────────\n\n\nclass TestArchetypeGenerator:\n    def test_title_expansion_known_archetype(self, profile):\n        from backend.agents.discovery.archetype_generator import ArchetypeGenerator\n\n        gen = ArchetypeGenerator()\n        manifest = gen.expand(\n            profile,\n            {\"titles\": [], \"companies\": [], \"industries\": []},\n        )\n        assert len(manifest.target_titles) > 0\n        assert len(manifest.keywords) > 0\n\n    def test_exclusions_passed_through(self, profile):\n        \"\"\"Excluded companies and industries should be in the manifest.\"\"\"\n        from backend.agents.discovery.archetype_generator import ArchetypeGenerator\n\n        gen = ArchetypeGenerator()\n        manifest = gen.expand(\n            profile,\n            {\n                \"titles\": [],\n                \"companies\": [\"BadCo\"],\n                \"industries\": [\"oil-and-gas\"],\n            },\n        )\n        assert \"BadCo\" in manifest.excluded_companies\n        assert \"oil-and-gas\" in manifest.excluded_industries\n\n    def test_keywords_include_skills(self, profile):\n        \"\"\"Keywords should include technical skills from the profile.\"\"\"\n        from backend.agents.discovery.archetype_generator import ArchetypeGenerator\n\n        gen = ArchetypeGenerator()\n        manifest = gen.expand(\n            profile,\n            {\"titles\": [], \"companies\": [], \"industries\": []},\n        )\n        # At least some skills should be in keywords\n        skill_overlap = set(profile.technical_skills[:10]) & set(manifest.keywords)\n        assert len(skill_overlap) > 0\n\n\n# ─── CrawlerAgent tests ───────────────────────────────────────────────────────\n\n\nclass TestCrawlerAgent:\n    \"\"\"Tests for the CrawlerAgent Phase 1A stub implementation.\"\"\"\n\n    @pytest.fixture\n    def manifest(self):\n        from backend.agents.discovery.schemas import SearchManifestSchema\n\n        return SearchManifestSchema(\n            target_titles=[\"Head of AI\", \"VP Engineering\", \"CTO\"],\n            keywords=[\"Python\", \"FastAPI\", \"AI\", \"music\"],\n            excluded_companies=[],\n            excluded_industries=[],\n            location_filters=[],\n            remote_preference=\"remote\",\n        )\n\n    @pytest.mark.asyncio\n    async def test_crawler_returns_jobs(self, manifest):\n        \"\"\"CrawlerAgent.run() should return a non-empty list of jobs.\"\"\"\n        from backend.agents.discovery.crawler_agent import CrawlerAgent\n\n        crawler = CrawlerAgent(candidate_id=uuid4())\n        jobs = await crawler.run(manifest)\n\n        assert len(jobs) > 0\n        assert all(j.title for j in jobs)\n        assert all(j.company for j in jobs)\n        assert all(j.url for j in jobs)\n\n    @pytest.mark.asyncio\n    async def test_crawler_respects_exclusions(self):\n        \"\"\"CrawlerAgent should exclude companies on the exclusion list.\"\"\"\n        from backend.agents.discovery.crawler_agent import CrawlerAgent\n        from backend.agents.discovery.schemas import SearchManifestSchema\n\n        manifest = SearchManifestSchema(\n            target_titles=[\"Head of AI\", \"VP Engineering\"],\n            keywords=[\"Python\", \"AI\"],\n            excluded_companies=[\"MusicTech AI\"],  # Exclude a fixture company\n            excluded_industries=[],\n            location_filters=[],\n            remote_preference=\"flexible\",\n        )\n\n        crawler = CrawlerAgent(candidate_id=uuid4())\n        jobs = await crawler.run(manifest)\n\n        # None of the returned jobs should be from MusicTech AI\n        for job in jobs:\n            assert \"musictech ai\" not in job.company.lower()\n\n    @pytest.mark.asyncio\n    async def test_crawler_filters_by_keywords(self):\n        \"\"\"CrawlerAgent should only return jobs matching keywords or titles.\"\"\"\n        from backend.agents.discovery.crawler_agent import CrawlerAgent\n        from backend.agents.discovery.schemas import SearchManifestSchema\n\n        # Use keywords that won't match any fixture jobs\n        manifest = SearchManifestSchema(\n            target_titles=[\"Underwater Basket Weaver\"],\n            keywords=[\"ancient-greek\", \"basket-weaving\"],\n            excluded_companies=[],\n            excluded_industries=[],\n            location_filters=[],\n            remote_preference=\"flexible\",\n        )\n\n        crawler = CrawlerAgent(candidate_id=uuid4())\n        jobs = await crawler.run(manifest)\n\n        # Should return empty list when nothing matches\n        assert len(jobs) == 0\n\n    def test_url_hash_deterministic(self):\n        \"\"\"url_hash should return the same hash for the same URL.\"\"\"\n        from backend.agents.discovery.crawler_agent import CrawlerAgent\n\n        url = \"https://example.com/jobs/123\"\n        hash1 = CrawlerAgent.url_hash(url)\n        hash2 = CrawlerAgent.url_hash(url)\n        assert hash1 == hash2\n\n    def test_url_hash_case_insensitive(self):\n        \"\"\"url_hash should be case-insensitive.\"\"\"\n        from backend.agents.discovery.crawler_agent import CrawlerAgent\n\n        hash1 = CrawlerAgent.url_hash(\"https://Example.COM/Jobs/123\")\n        hash2 = CrawlerAgent.url_hash(\"https://example.com/jobs/123\")\n        assert hash1 == hash2\n\n\n# ─── Schema validation tests ─────────────────────────────────────────────────\n\n\nclass TestSchemas:\n    def test_identity_profile_defaults(self):\n        \"\"\"IdentityProfileSchema should have sensible defaults.\"\"\"\n        profile = IdentityProfileSchema()\n        assert profile.leadership_level == \"IC\"\n        assert profile.archetypes == []\n        assert profile.technical_skills == {} or profile.technical_skills == []\n        assert profile.signals == {}\n\n    def test_discovered_job_minimal(self):\n        \"\"\"DiscoveredJobSchema should work with minimal required fields.\"\"\"\n        job = DiscoveredJobSchema(\n            source=\"greenhouse\",\n            source_id=\"test-123\",\n            title=\"Test Job\",\n            company=\"Test Co\",\n            url=\"https://example.com/job\",\n        )\n        assert job.title == \"Test Job\"\n        assert job.remote is False  # default\n\n    def test_scored_job_schema(self, profile):\n        \"\"\"ScoredJobSchema should validate correctly.\"\"\"\n        from backend.agents.discovery.schemas import ScoredJobSchema\n\n        scored = ScoredJobSchema(\n            discovered_job_id=uuid4(),\n            candidate_id=uuid4(),\n            score_breakdown=ScoreBreakdown(\n                technical_match=80,\n                level_match=90,\n                culture_match=75,\n                industry_match=70,\n                growth_potential=85,\n                compensation_match=80,\n            ),\n            composite_score=80,\n            is_hot=True,\n            reasoning=\"Strong technical match with leadership alignment.\",\n            title=\"Head of AI\",\n            company=\"Test Co\",\n            url=\"https://example.com/job\",\n        )\n        assert scored.is_hot is True\n        assert scored.composite_score == 80\n\n    def test_daily_digest_schema(self):\n        \"\"\"DailyDigestSchema should validate correctly.\"\"\"\n        from backend.agents.discovery.schemas import DailyDigestSchema\n\n        digest = DailyDigestSchema(\n            candidate_id=uuid4(),\n            run_date=\"2026-05-20\",\n            total_jobs_discovered=100,\n            total_jobs_scored=25,\n            top_picks=[],\n            hot_picks=[],\n            new_companies=[\"NewCo\", \"AnotherCo\"],\n        )\n        assert digest.total_jobs_discovered == 100\n        assert len(digest.new_companies) == 2\n\n\n# ─── Search manifest tests ───────────────────────────────────────────────────\n\n\nclass TestSearchManifest:\n    def test_manifest_defaults(self):\n        \"\"\"SearchManifestSchema should have sensible defaults.\"\"\"\n        from backend.agents.discovery.schemas import SearchManifestSchema\n\n        manifest = SearchManifestSchema()\n        assert manifest.target_titles == []\n        assert manifest.keywords == []\n        assert manifest.remote_preference == \"flexible\"\n        assert manifest.min_compensation is None\n\n    def test_manifest_with_data(self):\n        \"\"\"SearchManifestSchema should accept all fields.\"\"\"\n        from backend.agents.discovery.schemas import SearchManifestSchema\n\n        manifest = SearchManifestSchema(\n            target_titles=[\"CTO\", \"VP Engineering\"],\n            keywords=[\"Python\", \"AI\"],\n            excluded_titles=[\"Junior\"],\n            excluded_companies=[\"BadCo\"],\n            excluded_industries=[\"oil\"],\n            location_filters=[\"Remote\", \"Miami\"],\n            remote_preference=\"remote_only\",\n            min_compensation=250000,\n        )\n        assert len(manifest.target_titles) == 2\n        assert manifest.min_compensation == 250000\n","numLines":498,"startLine":1,"totalLines":498}}}}
