{"t":"2026-05-28T02:56:32.939Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GnyEbaKTdAS5d89czk6LXZ","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→from typing import Optional\n     5→\n     6→import redis.asyncio as aioredis\n     7→from sqlalchemy.ext.asyncio import create_async_engine, AsyncSession, async_sessionmaker\n     8→from sqlalchemy.orm import DeclarativeBase\n     9→from backend.config import settings\n    10→\n    11→engine = create_async_engine(\n    12→    settings.database_url,\n    13→    echo=settings.debug,\n    14→    pool_pre_ping=True,\n    15→    pool_size=10,\n    16→    max_overflow=20,\n    17→)\n    18→\n    19→AsyncSessionLocal = async_sessionmaker(\n    20→    engine,\n    21→    class_=AsyncSession,\n    22→    expire_on_commit=False,\n    23→)\n    24→\n    25→\n    26→class Base(DeclarativeBase):\n    27→    pass\n    28→\n    29→\n    30→async def get_db():\n    31→    \"\"\"\n    32→    FastAPI dependency that yields an async database session.\n    33→\n    34→    Automatically rolls back on exception to prevent partial commits.\n    35→    Contract: HYPHA-API.md Acceptance Criteria\n    36→    \"\"\"\n    37→    async with AsyncSessionLocal() as session:\n    38→        try:\n    39→            yield session\n    40→        except Exception:\n    41→            await session.rollback()\n    42→            raise\n    43→\n    44→\n    45→# ─── Redis Client ─────────────────────────────────────────────────────────────\n    46→\n    47→# Global Redis client — initialized lazily or at startup via lifespan\n    48→_redis_client: Optional[aioredis.Redis] = None\n    49→\n    50→\n    51→def set_redis_client(client: aioredis.Redis) -> None:\n    52→    \"\"\"Set the global Redis client (called from app lifespan).\"\"\"\n    53→    global _redis_client\n    54→    _redis_client = client\n    55→\n    56→\n    57→async def get_redis() -> aioredis.Redis:\n    58→    \"\"\"\n    59→    FastAPI dependency that returns the global Redis client.\n    60→\n    61→    The client is initialized at app startup via lifespan.\n    62→    Falls back to lazy initialization if not set.\n    63→    \"\"\"\n    64→    global _redis_client\n    65→    if _redis_client is None:\n    66→        _redis_client = aioredis.from_url(\n    67→            settings.redis_url,\n    68→            encoding=\"utf-8\",\n    69→            decode_responses=True,\n    70→        )\n    71→    return _redis_client\n    72→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"f2750489-d8d6-41f5-b42f-4d2a4cab3a05","uuid":"56fba412-113d-4512-8daa-16aa73a827f3","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/database.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\nfrom typing import Optional\n\nimport redis.asyncio as aioredis\nfrom sqlalchemy.ext.asyncio import create_async_engine, AsyncSession, async_sessionmaker\nfrom sqlalchemy.orm import DeclarativeBase\nfrom backend.config import settings\n\nengine = create_async_engine(\n    settings.database_url,\n    echo=settings.debug,\n    pool_pre_ping=True,\n    pool_size=10,\n    max_overflow=20,\n)\n\nAsyncSessionLocal = async_sessionmaker(\n    engine,\n    class_=AsyncSession,\n    expire_on_commit=False,\n)\n\n\nclass Base(DeclarativeBase):\n    pass\n\n\nasync def get_db():\n    \"\"\"\n    FastAPI dependency that yields an async database session.\n\n    Automatically rolls back on exception to prevent partial commits.\n    Contract: HYPHA-API.md Acceptance Criteria\n    \"\"\"\n    async with AsyncSessionLocal() as session:\n        try:\n            yield session\n        except Exception:\n            await session.rollback()\n            raise\n\n\n# ─── Redis Client ─────────────────────────────────────────────────────────────\n\n# Global Redis client — initialized lazily or at startup via lifespan\n_redis_client: Optional[aioredis.Redis] = None\n\n\ndef set_redis_client(client: aioredis.Redis) -> None:\n    \"\"\"Set the global Redis client (called from app lifespan).\"\"\"\n    global _redis_client\n    _redis_client = client\n\n\nasync def get_redis() -> aioredis.Redis:\n    \"\"\"\n    FastAPI dependency that returns the global Redis client.\n\n    The client is initialized at app startup via lifespan.\n    Falls back to lazy initialization if not set.\n    \"\"\"\n    global _redis_client\n    if _redis_client is None:\n        _redis_client = aioredis.from_url(\n            settings.redis_url,\n            encoding=\"utf-8\",\n            decode_responses=True,\n        )\n    return _redis_client\n","numLines":72,"startLine":1,"totalLines":72}}}}
{"t":"2026-05-28T02:56:32.948Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017iJ4de1fub58uwAVtRJxxn","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Identity Profiler — transforms a raw candidate profile into a rich,\n     6→multi-dimensional identity model used by the rest of the Discovery Engine.\n     7→\n     8→Flow:\n     9→  1. Check Redis cache (TTL 24h) — return cached profile if fresh\n    10→  2. Parse resume + personal context with Claude\n    11→  3. Generate archetypes and identity dimensions via Claude\n    12→  4. Cache result in Redis\n    13→  5. Return IdentityProfileSchema\n    14→\"\"\"\n    15→\n    16→import json\n    17→import hashlib\n    18→\n    19→import redis.asyncio as aioredis\n    20→import structlog\n    21→from anthropic import AsyncAnthropic\n    22→from tenacity import retry, stop_after_attempt, wait_exponential\n    23→\n    24→from backend.agents.discovery.schemas import CandidateSchema, IdentityProfileSchema\n    25→\n    26→logger = structlog.get_logger(__name__)\n    27→\n    28→_CACHE_TTL = 86_400  # 24 hours\n    29→\n    30→\n    31→class IdentityProfiler:\n    32→    \"\"\"\n    33→    Builds a rich multi-dimensional identity model from a candidate profile.\n    34→\n    35→    Uses Claude to extract technical skills, leadership level, domain expertise,\n    36→    and generate archetypes for role matching.\n    37→    \"\"\"\n    38→\n    39→    def __init__(self, redis_client: aioredis.Redis, anthropic_client: AsyncAnthropic):\n    40→        \"\"\"\n    41→        Initialize the IdentityProfiler.\n    42→\n    43→        Args:\n    44→            redis_client: Async Redis client for caching\n    45→            anthropic_client: Async Anthropic client for Claude API\n    46→        \"\"\"\n    47→        self._redis = redis_client\n    48→        self._claude = anthropic_client\n    49→\n    50→    def _cache_key(self, candidate: CandidateSchema) -> str:\n    51→        \"\"\"\n    52→        Derive a cache key from the candidate's data hash.\n    53→\n    54→        Content hash ensures stale profiles auto-invalidate when resume changes.\n    55→        \"\"\"\n    56→        content = f\"{candidate.resume_text}{candidate.personal_context or ''}\"\n    57→        content_hash = hashlib.sha256(content.encode()).hexdigest()[:16]\n    58→        return f\"profile:candidate:{candidate.id}:{content_hash}\"\n    59→\n    60→    async def build_profile(self, candidate: CandidateSchema) -> IdentityProfileSchema:\n    61→        \"\"\"\n    62→        Build or retrieve cached identity profile for a candidate.\n    63→\n    64→        Args:\n    65→            candidate: Full candidate schema\n    66→\n    67→        Returns:\n    68→            IdentityProfileSchema with all dimensions populated\n    69→        \"\"\"\n    70→        cache_key = self._cache_key(candidate)\n    71→\n    72→        # Check cache first\n    73→        cached = await self._redis.get(cache_key)\n    74→        if cached:\n    75→            logger.info(\"identity_profiler.cache_hit\", candidate_id=str(candidate.id))\n    76→            return IdentityProfileSchema.model_validate_json(cached)\n    77→\n    78→        logger.info(\"identity_profiler.generating\", candidate_id=str(candidate.id))\n    79→        profile = await self._generate_profile(candidate)\n    80→\n    81→        # Cache the result\n    82→        await self._redis.setex(cache_key, _CACHE_TTL, profile.model_dump_json())\n    83→        logger.info(\n    84→            \"identity_profiler.cached\",\n    85→            candidate_id=str(candidate.id),\n    86→            archetypes=len(profile.archetypes),\n    87→        )\n    88→        return profile\n    89→\n    90→    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n    91→    async def _generate_profile(self, candidate: CandidateSchema) -> IdentityProfileSchema:\n    92→        \"\"\"Call Claude to extract identity dimensions and generate archetypes.\"\"\"\n    93→        prompt = self._build_prompt(candidate)\n    94→\n    95→        response = await self._claude.messages.create(\n    96→            model=\"claude-sonnet-4-20250514\",\n    97→            max_tokens=4096,\n    98→            messages=[{\"role\": \"user\", \"content\": prompt}],\n    99→        )\n   100→\n   101→        raw = response.content[0].text\n   102→        logger.info(\n   103→            \"identity_profiler.claude_response\",\n   104→            candidate_id=str(candidate.id),\n   105→            tokens_used=response.usage.output_tokens,\n   106→        )\n   107→\n   108→        return self._parse_response(raw)\n   109→\n   110→    def _build_prompt(self, candidate: CandidateSchema) -> str:\n   111→        \"\"\"Construct the Claude prompt for identity extraction.\"\"\"\n   112→        excluded = {\n   113→            \"companies\": candidate.excluded_companies,\n   114→            \"industries\": candidate.excluded_industries,\n   115→        }\n   116→        return f\"\"\"You are building a rich identity model for a talent agent system.\n   117→\n   118→Analyze this candidate and return a JSON object with the exact structure specified below.\n   119→\n   120→# CANDIDATE DATA\n   121→\n   122→Name: {candidate.name}\n   123→Remote Preference: {candidate.remote_preference}\n   124→Min Compensation: {candidate.min_compensation or \"Not specified\"}\n   125→Target Locations: {\", \".join(candidate.target_locations) or \"Flexible\"}\n   126→Excluded: {json.dumps(excluded)}\n   127→\n   128→## Resume\n   129→{candidate.resume_text}\n   130→\n   131→## Personal Context\n   132→{candidate.personal_context or \"Not provided\"}\n   133→\n   134→# INSTRUCTIONS\n   135→\n   136→Return ONLY valid JSON matching this exact schema. No markdown, no explanation:\n   137→\n   138→{{\n   139→  \"archetypes\": [\n   140→    \"<archetype_1>\",\n   141→    \"<archetype_2>\"\n   142→  ],\n   143→  \"leadership_level\": \"<IC|Lead|Manager|Director|VP|C-Level>\",\n   144→  \"technical_skills\": [\"<skill_1>\", \"<skill_2>\"],\n   145→  \"soft_skills\": [\"<skill_1>\", \"<skill_2>\"],\n   146→  \"industry_experience\": [\"<industry_1>\", \"<industry_2>\"],\n   147→  \"notable_achievements\": [\"<achievement_1>\", \"<achievement_2>\"],\n   148→  \"career_trajectory\": \"<one sentence describing career arc>\",\n   149→  \"ideal_role_description\": \"<one sentence describing ideal next role>\",\n   150→  \"signals\": {{\n   151→    \"startup_vs_enterprise\": \"<startup|enterprise|both>\",\n   152→    \"remote_preference\": \"<remote|hybrid|onsite|flexible>\",\n   153→    \"mission_vs_comp\": \"<mission|comp|balanced>\"\n   154→  }}\n   155→}}\n   156→\n   157→# RULES FOR archetypes\n   158→- Generate 15–20 non-obvious role archetypes beyond the candidate's current title\n   159→- Think: what roles would a headhunter NOT suggest but should?\n   160→- Include VP/director-level if seniority warrants\n   161→- Include cross-functional roles (e.g., DevRel, Technical PM, CTO, AI Creative Director)\n   162→- Include roles at the intersection of their technical + creative identity\n   163→- Do NOT include roles clearly below their level\n   164→- Do NOT include roles in their excluded_industries\n   165→\n   166→# CRITICAL RULES\n   167→- NEVER fabricate skills not evidenced in the resume\n   168→- Extract ONLY skills explicitly mentioned or clearly demonstrated\n   169→- Be conservative with leadership_level — evidence must be clear\n   170→\"\"\"\n   171→\n   172→    def _parse_response(self, raw: str) -> IdentityProfileSchema:\n   173→        \"\"\"Parse Claude's JSON response into an IdentityProfileSchema.\"\"\"\n   174→        import re\n   175→\n   176→        try:\n   177→            data = json.loads(raw.strip())\n   178→        except json.JSONDecodeError:\n   179→            # Attempt to extract JSON block if Claude included surrounding text\n   180→            match = re.search(r\"\\{.*\\}\", raw, re.DOTALL)\n   181→            if not match:\n   182→                raise ValueError(f\"Claude returned non-JSON response: {raw[:200]}\")\n   183→            data = json.loads(match.group())\n   184→\n   185→        return IdentityProfileSchema(\n   186→            archetypes=data.get(\"archetypes\", []),\n   187→            leadership_level=data.get(\"leadership_level\", \"IC\"),\n   188→            technical_skills=data.get(\"technical_skills\", []),\n   189→            soft_skills=data.get(\"soft_skills\", []),\n   190→            industry_experience=data.get(\"industry_experience\", []),\n   191→            notable_achievements=data.get(\"notable_achievements\", []),\n   192→            career_trajectory=data.get(\"career_trajectory\", \"\"),\n   193→            ideal_role_description=data.get(\"ideal_role_description\", \"\"),\n   194→            signals=data.get(\"signals\", {}),\n   195→        )\n   196→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"f2750489-d8d6-41f5-b42f-4d2a4cab3a05","uuid":"8aa171c1-8f14-458e-a5ce-a81ff1b1fcde","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/agents/discovery/identity_profiler.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nIdentity Profiler — transforms a raw candidate profile into a rich,\nmulti-dimensional identity model used by the rest of the Discovery Engine.\n\nFlow:\n  1. Check Redis cache (TTL 24h) — return cached profile if fresh\n  2. Parse resume + personal context with Claude\n  3. Generate archetypes and identity dimensions via Claude\n  4. Cache result in Redis\n  5. Return IdentityProfileSchema\n\"\"\"\n\nimport json\nimport hashlib\n\nimport redis.asyncio as aioredis\nimport structlog\nfrom anthropic import AsyncAnthropic\nfrom tenacity import retry, stop_after_attempt, wait_exponential\n\nfrom backend.agents.discovery.schemas import CandidateSchema, IdentityProfileSchema\n\nlogger = structlog.get_logger(__name__)\n\n_CACHE_TTL = 86_400  # 24 hours\n\n\nclass IdentityProfiler:\n    \"\"\"\n    Builds a rich multi-dimensional identity model from a candidate profile.\n\n    Uses Claude to extract technical skills, leadership level, domain expertise,\n    and generate archetypes for role matching.\n    \"\"\"\n\n    def __init__(self, redis_client: aioredis.Redis, anthropic_client: AsyncAnthropic):\n        \"\"\"\n        Initialize the IdentityProfiler.\n\n        Args:\n            redis_client: Async Redis client for caching\n            anthropic_client: Async Anthropic client for Claude API\n        \"\"\"\n        self._redis = redis_client\n        self._claude = anthropic_client\n\n    def _cache_key(self, candidate: CandidateSchema) -> str:\n        \"\"\"\n        Derive a cache key from the candidate's data hash.\n\n        Content hash ensures stale profiles auto-invalidate when resume changes.\n        \"\"\"\n        content = f\"{candidate.resume_text}{candidate.personal_context or ''}\"\n        content_hash = hashlib.sha256(content.encode()).hexdigest()[:16]\n        return f\"profile:candidate:{candidate.id}:{content_hash}\"\n\n    async def build_profile(self, candidate: CandidateSchema) -> IdentityProfileSchema:\n        \"\"\"\n        Build or retrieve cached identity profile for a candidate.\n\n        Args:\n            candidate: Full candidate schema\n\n        Returns:\n            IdentityProfileSchema with all dimensions populated\n        \"\"\"\n        cache_key = self._cache_key(candidate)\n\n        # Check cache first\n        cached = await self._redis.get(cache_key)\n        if cached:\n            logger.info(\"identity_profiler.cache_hit\", candidate_id=str(candidate.id))\n            return IdentityProfileSchema.model_validate_json(cached)\n\n        logger.info(\"identity_profiler.generating\", candidate_id=str(candidate.id))\n        profile = await self._generate_profile(candidate)\n\n        # Cache the result\n        await self._redis.setex(cache_key, _CACHE_TTL, profile.model_dump_json())\n        logger.info(\n            \"identity_profiler.cached\",\n            candidate_id=str(candidate.id),\n            archetypes=len(profile.archetypes),\n        )\n        return profile\n\n    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n    async def _generate_profile(self, candidate: CandidateSchema) -> IdentityProfileSchema:\n        \"\"\"Call Claude to extract identity dimensions and generate archetypes.\"\"\"\n        prompt = self._build_prompt(candidate)\n\n        response = await self._claude.messages.create(\n            model=\"claude-sonnet-4-20250514\",\n            max_tokens=4096,\n            messages=[{\"role\": \"user\", \"content\": prompt}],\n        )\n\n        raw = response.content[0].text\n        logger.info(\n            \"identity_profiler.claude_response\",\n            candidate_id=str(candidate.id),\n            tokens_used=response.usage.output_tokens,\n        )\n\n        return self._parse_response(raw)\n\n    def _build_prompt(self, candidate: CandidateSchema) -> str:\n        \"\"\"Construct the Claude prompt for identity extraction.\"\"\"\n        excluded = {\n            \"companies\": candidate.excluded_companies,\n            \"industries\": candidate.excluded_industries,\n        }\n        return f\"\"\"You are building a rich identity model for a talent agent system.\n\nAnalyze this candidate and return a JSON object with the exact structure specified below.\n\n# CANDIDATE DATA\n\nName: {candidate.name}\nRemote Preference: {candidate.remote_preference}\nMin Compensation: {candidate.min_compensation or \"Not specified\"}\nTarget Locations: {\", \".join(candidate.target_locations) or \"Flexible\"}\nExcluded: {json.dumps(excluded)}\n\n## Resume\n{candidate.resume_text}\n\n## Personal Context\n{candidate.personal_context or \"Not provided\"}\n\n# INSTRUCTIONS\n\nReturn ONLY valid JSON matching this exact schema. No markdown, no explanation:\n\n{{\n  \"archetypes\": [\n    \"<archetype_1>\",\n    \"<archetype_2>\"\n  ],\n  \"leadership_level\": \"<IC|Lead|Manager|Director|VP|C-Level>\",\n  \"technical_skills\": [\"<skill_1>\", \"<skill_2>\"],\n  \"soft_skills\": [\"<skill_1>\", \"<skill_2>\"],\n  \"industry_experience\": [\"<industry_1>\", \"<industry_2>\"],\n  \"notable_achievements\": [\"<achievement_1>\", \"<achievement_2>\"],\n  \"career_trajectory\": \"<one sentence describing career arc>\",\n  \"ideal_role_description\": \"<one sentence describing ideal next role>\",\n  \"signals\": {{\n    \"startup_vs_enterprise\": \"<startup|enterprise|both>\",\n    \"remote_preference\": \"<remote|hybrid|onsite|flexible>\",\n    \"mission_vs_comp\": \"<mission|comp|balanced>\"\n  }}\n}}\n\n# RULES FOR archetypes\n- Generate 15–20 non-obvious role archetypes beyond the candidate's current title\n- Think: what roles would a headhunter NOT suggest but should?\n- Include VP/director-level if seniority warrants\n- Include cross-functional roles (e.g., DevRel, Technical PM, CTO, AI Creative Director)\n- Include roles at the intersection of their technical + creative identity\n- Do NOT include roles clearly below their level\n- Do NOT include roles in their excluded_industries\n\n# CRITICAL RULES\n- NEVER fabricate skills not evidenced in the resume\n- Extract ONLY skills explicitly mentioned or clearly demonstrated\n- Be conservative with leadership_level — evidence must be clear\n\"\"\"\n\n    def _parse_response(self, raw: str) -> IdentityProfileSchema:\n        \"\"\"Parse Claude's JSON response into an IdentityProfileSchema.\"\"\"\n        import re\n\n        try:\n            data = json.loads(raw.strip())\n        except json.JSONDecodeError:\n            # Attempt to extract JSON block if Claude included surrounding text\n            match = re.search(r\"\\{.*\\}\", raw, re.DOTALL)\n            if not match:\n                raise ValueError(f\"Claude returned non-JSON response: {raw[:200]}\")\n            data = json.loads(match.group())\n\n        return IdentityProfileSchema(\n            archetypes=data.get(\"archetypes\", []),\n            leadership_level=data.get(\"leadership_level\", \"IC\"),\n            technical_skills=data.get(\"technical_skills\", []),\n            soft_skills=data.get(\"soft_skills\", []),\n            industry_experience=data.get(\"industry_experience\", []),\n            notable_achievements=data.get(\"notable_achievements\", []),\n            career_trajectory=data.get(\"career_trajectory\", \"\"),\n            ideal_role_description=data.get(\"ideal_role_description\", \"\"),\n            signals=data.get(\"signals\", {}),\n        )\n","numLines":196,"startLine":1,"totalLines":196}}}}
{"t":"2026-05-28T02:56:32.956Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011e4KZo4qeKcYr9Jk7CXbPH","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Archetype Generator — expands an IdentityProfileSchema into a SearchManifestSchema.\n     6→\n     7→Takes the abstract role archetypes and converts them into:\n     8→  - Specific job title search strings\n     9→  - Title variants (Head of AI → [VP AI, Director of AI, AI Lead, ...])\n    10→  - Search keyword combinations\n    11→  - Explicit exclusions\n    12→\n    13→The SearchManifestSchema is the crawler's search instructions.\n    14→\"\"\"\n    15→\n    16→import structlog\n    17→\n    18→from backend.agents.discovery.schemas import IdentityProfileSchema, SearchManifestSchema\n    19→\n    20→logger = structlog.get_logger(__name__)\n    21→\n    22→# Title variant expansion rules — maps archetype patterns to search variants\n    23→_TITLE_VARIANTS: dict[str, list[str]] = {\n    24→    \"head of ai\": [\"Head of AI\", \"Director of AI\", \"VP of AI\", \"AI Lead\", \"AI Director\"],\n    25→    \"principal engineer\": [\n    26→        \"Principal Engineer\",\n    27→        \"Staff Engineer\",\n    28→        \"Principal Software Engineer\",\n    29→        \"Distinguished Engineer\",\n    30→    ],\n    31→    \"vp engineering\": [\n    32→        \"VP Engineering\",\n    33→        \"VP of Engineering\",\n    34→        \"Head of Engineering\",\n    35→        \"Director of Engineering\",\n    36→    ],\n    37→    \"technical co-founder\": [\n    38→        \"Technical Co-Founder\",\n    39→        \"CTO\",\n    40→        \"Founding Engineer\",\n    41→        \"Head of Technology\",\n    42→    ],\n    43→    \"developer advocate\": [\n    44→        \"Developer Advocate\",\n    45→        \"Developer Relations\",\n    46→        \"DevRel Engineer\",\n    47→        \"Developer Experience\",\n    48→    ],\n    49→    \"ai architect\": [\"AI Architect\", \"ML Architect\", \"AI/ML Architect\", \"Principal AI Engineer\"],\n    50→    \"engineering manager\": [\n    51→        \"Engineering Manager\",\n    52→        \"Director of Engineering\",\n    53→        \"Head of Engineering\",\n    54→    ],\n    55→    \"cto\": [\"CTO\", \"Chief Technology Officer\", \"VP Engineering\", \"Head of Technology\"],\n    56→    \"product engineer\": [\n    57→        \"Product Engineer\",\n    58→        \"Full Stack Engineer\",\n    59→        \"Software Engineer - Product\",\n    60→    ],\n    61→    \"ai creative director\": [\n    62→        \"AI Creative Director\",\n    63→        \"Creative Technologist\",\n    64→        \"Director of Creative Technology\",\n    65→    ],\n    66→    \"technical pm\": [\n    67→        \"Technical Product Manager\",\n    68→        \"Senior PM - Platform\",\n    69→        \"Group Product Manager - AI\",\n    70→    ],\n    71→    \"fractional cto\": [\"Fractional CTO\", \"CTO Advisor\", \"Technology Advisor\", \"Interim CTO\"],\n    72→    \"solutions architect\": [\n    73→        \"Solutions Architect\",\n    74→        \"Principal Solutions Architect\",\n    75→        \"Enterprise Architect\",\n    76→    ],\n    77→    \"platform engineer\": [\n    78→        \"Platform Engineer\",\n    79→        \"Infrastructure Engineer\",\n    80→        \"Staff Platform Engineer\",\n    81→    ],\n    82→}\n    83→\n    84→\n    85→class ArchetypeGenerator:\n    86→    \"\"\"\n    87→    Converts an IdentityProfileSchema into a SearchManifestSchema for the crawler.\n    88→\n    89→    No external API calls — all logic is local expansion rules + profile data.\n    90→    \"\"\"\n    91→\n    92→    def expand(\n    93→        self,\n    94→        profile: IdentityProfileSchema,\n    95→        candidate_excluded: dict[str, list[str]],\n    96→    ) -> SearchManifestSchema:\n    97→        \"\"\"\n    98→        Build a SearchManifestSchema from an IdentityProfileSchema.\n    99→\n   100→        Args:\n   101→            profile: Candidate's identity profile\n   102→            candidate_excluded: {titles: [...], companies: [...], industries: [...]}\n   103→\n   104→        Returns:\n   105→            SearchManifestSchema with search targets and exclusions\n   106→        \"\"\"\n   107→        logger.info(\"archetype_generator.expanding\")\n   108→\n   109→        target_titles = self._extract_target_titles(profile.archetypes)\n   110→        keywords = self._build_keywords(profile, target_titles)\n   111→\n   112→        manifest = SearchManifestSchema(\n   113→            target_titles=target_titles,\n   114→            keywords=keywords,\n   115→            excluded_titles=candidate_excluded.get(\"titles\", []),\n   116→            excluded_companies=candidate_excluded.get(\"companies\", []),\n   117→            excluded_industries=candidate_excluded.get(\"industries\", []),\n   118→            location_filters=[],  # TODO: derive from profile if needed\n   119→            remote_preference=profile.signals.get(\"remote_preference\", \"flexible\"),\n   120→            min_compensation=None,  # Passed separately from candidate\n   121→        )\n   122→\n   123→        logger.info(\n   124→            \"archetype_generator.manifest_built\",\n   125→            title_count=len(target_titles),\n   126→            keyword_count=len(keywords),\n   127→        )\n   128→        return manifest\n   129→\n   130→    def _extract_target_titles(self, archetypes: list[str]) -> list[str]:\n   131→        \"\"\"\n   132→        Convert role archetype strings into specific job title search targets.\n   133→\n   134→        For each archetype, emit the archetype itself plus any known variants.\n   135→        Deduplicate while preserving order.\n   136→        \"\"\"\n   137→        seen: set[str] = set()\n   138→        titles: list[str] = []\n   139→\n   140→        for archetype in archetypes:\n   141→            # Try to find a matching variant group\n   142→            matched = False\n   143→            for pattern, variants in _TITLE_VARIANTS.items():\n   144→                if pattern in archetype.lower():\n   145→                    for v in variants:\n   146→                        if v not in seen:\n   147→                            titles.append(v)\n   148→                            seen.add(v)\n   149→                    matched = True\n   150→                    break\n   151→\n   152→            if not matched and archetype not in seen:\n   153→                titles.append(archetype)\n   154→                seen.add(archetype)\n   155→\n   156→        return titles\n   157→\n   158→    def _build_keywords(\n   159→        self, profile: IdentityProfileSchema, target_titles: list[str]\n   160→    ) -> list[str]:\n   161→        \"\"\"\n   162→        Build a flat keyword list for job board search queries.\n   163→\n   164→        Combines title variants with skill signals.\n   165→        \"\"\"\n   166→        keywords: set[str] = set()\n   167→\n   168→        # Add top 15 titles\n   169→        for title in target_titles[:15]:\n   170→            keywords.add(title)\n   171→\n   172→        # Add technical skills as qualifier terms (top 10)\n   173→        for skill in profile.technical_skills[:10]:\n   174→            keywords.add(skill)\n   175→\n   176→        # Add industry experience\n   177→        for industry in profile.industry_experience[:5]:\n   178→            keywords.add(industry)\n   179→\n   180→        return list(keywords)\n   181→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"f2750489-d8d6-41f5-b42f-4d2a4cab3a05","uuid":"3263a689-0560-4bec-8567-9cad5c642272","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/agents/discovery/archetype_generator.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nArchetype Generator — expands an IdentityProfileSchema into a SearchManifestSchema.\n\nTakes the abstract role archetypes and converts them into:\n  - Specific job title search strings\n  - Title variants (Head of AI → [VP AI, Director of AI, AI Lead, ...])\n  - Search keyword combinations\n  - Explicit exclusions\n\nThe SearchManifestSchema is the crawler's search instructions.\n\"\"\"\n\nimport structlog\n\nfrom backend.agents.discovery.schemas import IdentityProfileSchema, SearchManifestSchema\n\nlogger = structlog.get_logger(__name__)\n\n# Title variant expansion rules — maps archetype patterns to search variants\n_TITLE_VARIANTS: dict[str, list[str]] = {\n    \"head of ai\": [\"Head of AI\", \"Director of AI\", \"VP of AI\", \"AI Lead\", \"AI Director\"],\n    \"principal engineer\": [\n        \"Principal Engineer\",\n        \"Staff Engineer\",\n        \"Principal Software Engineer\",\n        \"Distinguished Engineer\",\n    ],\n    \"vp engineering\": [\n        \"VP Engineering\",\n        \"VP of Engineering\",\n        \"Head of Engineering\",\n        \"Director of Engineering\",\n    ],\n    \"technical co-founder\": [\n        \"Technical Co-Founder\",\n        \"CTO\",\n        \"Founding Engineer\",\n        \"Head of Technology\",\n    ],\n    \"developer advocate\": [\n        \"Developer Advocate\",\n        \"Developer Relations\",\n        \"DevRel Engineer\",\n        \"Developer Experience\",\n    ],\n    \"ai architect\": [\"AI Architect\", \"ML Architect\", \"AI/ML Architect\", \"Principal AI Engineer\"],\n    \"engineering manager\": [\n        \"Engineering Manager\",\n        \"Director of Engineering\",\n        \"Head of Engineering\",\n    ],\n    \"cto\": [\"CTO\", \"Chief Technology Officer\", \"VP Engineering\", \"Head of Technology\"],\n    \"product engineer\": [\n        \"Product Engineer\",\n        \"Full Stack Engineer\",\n        \"Software Engineer - Product\",\n    ],\n    \"ai creative director\": [\n        \"AI Creative Director\",\n        \"Creative Technologist\",\n        \"Director of Creative Technology\",\n    ],\n    \"technical pm\": [\n        \"Technical Product Manager\",\n        \"Senior PM - Platform\",\n        \"Group Product Manager - AI\",\n    ],\n    \"fractional cto\": [\"Fractional CTO\", \"CTO Advisor\", \"Technology Advisor\", \"Interim CTO\"],\n    \"solutions architect\": [\n        \"Solutions Architect\",\n        \"Principal Solutions Architect\",\n        \"Enterprise Architect\",\n    ],\n    \"platform engineer\": [\n        \"Platform Engineer\",\n        \"Infrastructure Engineer\",\n        \"Staff Platform Engineer\",\n    ],\n}\n\n\nclass ArchetypeGenerator:\n    \"\"\"\n    Converts an IdentityProfileSchema into a SearchManifestSchema for the crawler.\n\n    No external API calls — all logic is local expansion rules + profile data.\n    \"\"\"\n\n    def expand(\n        self,\n        profile: IdentityProfileSchema,\n        candidate_excluded: dict[str, list[str]],\n    ) -> SearchManifestSchema:\n        \"\"\"\n        Build a SearchManifestSchema from an IdentityProfileSchema.\n\n        Args:\n            profile: Candidate's identity profile\n            candidate_excluded: {titles: [...], companies: [...], industries: [...]}\n\n        Returns:\n            SearchManifestSchema with search targets and exclusions\n        \"\"\"\n        logger.info(\"archetype_generator.expanding\")\n\n        target_titles = self._extract_target_titles(profile.archetypes)\n        keywords = self._build_keywords(profile, target_titles)\n\n        manifest = SearchManifestSchema(\n            target_titles=target_titles,\n            keywords=keywords,\n            excluded_titles=candidate_excluded.get(\"titles\", []),\n            excluded_companies=candidate_excluded.get(\"companies\", []),\n            excluded_industries=candidate_excluded.get(\"industries\", []),\n            location_filters=[],  # TODO: derive from profile if needed\n            remote_preference=profile.signals.get(\"remote_preference\", \"flexible\"),\n            min_compensation=None,  # Passed separately from candidate\n        )\n\n        logger.info(\n            \"archetype_generator.manifest_built\",\n            title_count=len(target_titles),\n            keyword_count=len(keywords),\n        )\n        return manifest\n\n    def _extract_target_titles(self, archetypes: list[str]) -> list[str]:\n        \"\"\"\n        Convert role archetype strings into specific job title search targets.\n\n        For each archetype, emit the archetype itself plus any known variants.\n        Deduplicate while preserving order.\n        \"\"\"\n        seen: set[str] = set()\n        titles: list[str] = []\n\n        for archetype in archetypes:\n            # Try to find a matching variant group\n            matched = False\n            for pattern, variants in _TITLE_VARIANTS.items():\n                if pattern in archetype.lower():\n                    for v in variants:\n                        if v not in seen:\n                            titles.append(v)\n                            seen.add(v)\n                    matched = True\n                    break\n\n            if not matched and archetype not in seen:\n                titles.append(archetype)\n                seen.add(archetype)\n\n        return titles\n\n    def _build_keywords(\n        self, profile: IdentityProfileSchema, target_titles: list[str]\n    ) -> list[str]:\n        \"\"\"\n        Build a flat keyword list for job board search queries.\n\n        Combines title variants with skill signals.\n        \"\"\"\n        keywords: set[str] = set()\n\n        # Add top 15 titles\n        for title in target_titles[:15]:\n            keywords.add(title)\n\n        # Add technical skills as qualifier terms (top 10)\n        for skill in profile.technical_skills[:10]:\n            keywords.add(skill)\n\n        # Add industry experience\n        for industry in profile.industry_experience[:5]:\n            keywords.add(industry)\n\n        return list(keywords)\n","numLines":181,"startLine":1,"totalLines":181}}}}
