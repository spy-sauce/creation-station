{"t":"2026-05-28T02:56:36.821Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JJAu3uyiczxd1j8aBhqzJb","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Relevance Scorer — scores each discovered job against the candidate's identity profile.\n     6→\n     7→Scoring dimensions (each 0–100):\n     8→  technical_match   30%  — skills overlap between JD and candidate profile\n     9→  level_match       20%  — seniority alignment (penalise over AND under)\n    10→  culture_match     15%  — startup/enterprise, remote, mission alignment\n    11→  industry_match    15%  — domain expertise alignment\n    12→  growth_potential  10%  — does this expand the candidate's trajectory?\n    13→  compensation_match 10% — estimated band vs candidate target\n    14→\n    15→Claude parses the JD. Math runs locally. Claude writes 2-sentence reasoning.\n    16→\"\"\"\n    17→\n    18→import json\n    19→import re\n    20→from datetime import datetime, timezone\n    21→from uuid import UUID, uuid4\n    22→\n    23→import structlog\n    24→from anthropic import AsyncAnthropic\n    25→from tenacity import retry, stop_after_attempt, wait_exponential\n    26→\n    27→from backend.agents.discovery.schemas import (\n    28→    IdentityProfileSchema,\n    29→    DiscoveredJobSchema,\n    30→    ScoredJobSchema,\n    31→    ScoreBreakdown,\n    32→)\n    33→\n    34→logger = structlog.get_logger(__name__)\n    35→\n    36→# Seniority levels for level_match scoring — lower index = more junior\n    37→_SENIORITY_LADDER = [\n    38→    \"intern\",\n    39→    \"junior\",\n    40→    \"associate\",\n    41→    \"mid\",\n    42→    \"senior\",\n    43→    \"staff\",\n    44→    \"principal\",\n    45→    \"lead\",\n    46→    \"manager\",\n    47→    \"director\",\n    48→    \"vp\",\n    49→    \"svp\",\n    50→    \"head\",\n    51→    \"cto\",\n    52→    \"coo\",\n    53→    \"ceo\",\n    54→    \"founder\",\n    55→    \"exec\",\n    56→    \"c-level\",\n    57→]\n    58→\n    59→_LEADERSHIP_TO_LADDER = {\n    60→    \"IC\": \"senior\",\n    61→    \"Lead\": \"lead\",\n    62→    \"Manager\": \"manager\",\n    63→    \"Director\": \"director\",\n    64→    \"VP\": \"vp\",\n    65→    \"C-Level\": \"cto\",\n    66→}\n    67→\n    68→\n    69→class RelevanceScorer:\n    70→    \"\"\"\n    71→    Scores discovered jobs against a candidate's identity profile.\n    72→\n    73→    Uses Claude to parse JD requirements and generate reasoning.\n    74→    Scoring math runs locally — no LLM needed for the numbers.\n    75→    \"\"\"\n    76→\n    77→    def __init__(self, anthropic_client: AsyncAnthropic):\n    78→        \"\"\"\n    79→        Initialize the RelevanceScorer.\n    80→\n    81→        Args:\n    82→            anthropic_client: Async Anthropic client for Claude API\n    83→        \"\"\"\n    84→        self._claude = anthropic_client\n    85→\n    86→    async def score_batch(\n    87→        self,\n    88→        jobs: list[DiscoveredJobSchema],\n    89→        profile: IdentityProfileSchema,\n    90→        candidate_id: UUID,\n    91→        min_score: int = 60,\n    92→    ) -> list[ScoredJobSchema]:\n    93→        \"\"\"\n    94→        Score a batch of discovered jobs, filtering out those below min_score.\n    95→\n    96→        Args:\n    97→            jobs: Raw discovered jobs to score\n    98→            profile: Candidate identity profile\n    99→            candidate_id: Candidate UUID for scored job records\n   100→            min_score: Jobs below this composite score are discarded\n   101→\n   102→        Returns:\n   103→            Sorted list of ScoredJobSchema, highest composite first\n   104→        \"\"\"\n   105→        logger.info(\n   106→            \"relevance_scorer.batch_start\",\n   107→            job_count=len(jobs),\n   108→            min_score=min_score,\n   109→        )\n   110→\n   111→        scored: list[ScoredJobSchema] = []\n   112→        for job in jobs:\n   113→            try:\n   114→                result = await self.score_job(job, profile, candidate_id)\n   115→                if result.composite_score >= min_score:\n   116→                    scored.append(result)\n   117→            except Exception as e:\n   118→                logger.error(\n   119→                    \"relevance_scorer.job_error\",\n   120→                    job_url=job.url,\n   121→                    error=str(e),\n   122→                )\n   123→\n   124→        scored.sort(key=lambda s: s.composite_score, reverse=True)\n   125→        logger.info(\n   126→            \"relevance_scorer.batch_complete\",\n   127→            scored=len(scored),\n   128→            filtered_out=len(jobs) - len(scored),\n   129→        )\n   130→        return scored\n   131→\n   132→    async def score_job(\n   133→        self,\n   134→        job: DiscoveredJobSchema,\n   135→        profile: IdentityProfileSchema,\n   136→        candidate_id: UUID,\n   137→    ) -> ScoredJobSchema:\n   138→        \"\"\"\n   139→        Score a single job against the identity profile.\n   140→\n   141→        Args:\n   142→            job: Discovered job\n   143→            profile: Candidate identity profile\n   144→            candidate_id: Candidate UUID\n   145→\n   146→        Returns:\n   147→            ScoredJobSchema with full breakdown and reasoning\n   148→        \"\"\"\n   149→        parsed_jd = await self._parse_jd(job)\n   150→        scores = self._compute_scores(parsed_jd, profile, job)\n   151→        composite = scores.composite\n   152→        is_hot = composite >= 80\n   153→        reasoning = await self._generate_reasoning(job, profile, scores, composite)\n   154→\n   155→        return ScoredJobSchema(\n   156→            id=uuid4(),\n   157→            discovered_job_id=job.id or uuid4(),\n   158→            candidate_id=candidate_id,\n   159→            score_breakdown=scores,\n   160→            composite_score=composite,\n   161→            is_hot=is_hot,\n   162→            reasoning=reasoning,\n   163→            scored_at=datetime.now(timezone.utc),\n   164→            # Denormalized job fields for digest display\n   165→            title=job.title,\n   166→            company=job.company,\n   167→            location=job.location,\n   168→            url=job.url,\n   169→        )\n   170→\n   171→    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n   172→    async def _parse_jd(self, job: DiscoveredJobSchema) -> dict:\n   173→        \"\"\"Use Claude to extract structured requirements from a job description.\"\"\"\n   174→        if not job.description:\n   175→            return {}\n   176→\n   177→        prompt = f\"\"\"Extract structured data from this job description. Return ONLY valid JSON, no markdown:\n   178→\n   179→Job Title: {job.title}\n   180→Company: {job.company}\n   181→Location: {job.location or \"Not specified\"}\n   182→\n   183→Description:\n   184→{job.description[:3000]}\n   185→\n   186→Return this exact JSON structure:\n   187→{{\n   188→  \"required_skills\": [\"<skill1>\", \"<skill2>\"],\n   189→  \"preferred_skills\": [\"<skill1>\"],\n   190→  \"seniority_level\": \"<intern|junior|mid|senior|staff|principal|lead|manager|director|vp|head|exec>\",\n   191→  \"remote_type\": \"<remote|hybrid|onsite|flexible>\",\n   192→  \"industries\": [\"<industry1>\"],\n   193→  \"comp_mentioned\": \"<salary string or null>\",\n   194→  \"culture_signals\": {{\n   195→    \"startup_vs_enterprise\": \"<startup|enterprise|both>\",\n   196→    \"mission_driven\": true\n   197→  }},\n   198→  \"growth_indicators\": [\"<indicator1>\"]\n   199→}}\"\"\"\n   200→\n   201→        response = await self._claude.messages.create(\n   202→            model=\"claude-sonnet-4-20250514\",\n   203→            max_tokens=1024,\n   204→            messages=[{\"role\": \"user\", \"content\": prompt}],\n   205→        )\n   206→\n   207→        raw = response.content[0].text.strip()\n   208→        try:\n   209→            return json.loads(raw)\n   210→        except json.JSONDecodeError:\n   211→            match = re.search(r\"\\{.*\\}\", raw, re.DOTALL)\n   212→            return json.loads(match.group()) if match else {}\n   213→\n   214→    def _compute_scores(\n   215→        self,\n   216→        parsed_jd: dict,\n   217→        profile: IdentityProfileSchema,\n   218→        job: DiscoveredJobSchema,\n   219→    ) -> ScoreBreakdown:\n   220→        \"\"\"Compute all six scoring dimensions locally.\"\"\"\n   221→        return ScoreBreakdown(\n   222→            technical_match=self._score_technical(parsed_jd, profile),\n   223→            level_match=self._score_level(parsed_jd, profile),\n   224→            culture_match=self._score_culture(parsed_jd, profile, job),\n   225→            industry_match=self._score_industry(parsed_jd, profile),\n   226→            growth_potential=self._score_growth(parsed_jd, profile),\n   227→            compensation_match=self._score_compensation(parsed_jd, profile),\n   228→        )\n   229→\n   230→    def _score_technical(\n   231→        self, parsed_jd: dict, profile: IdentityProfileSchema\n   232→    ) -> int:\n   233→        \"\"\"Score based on skills overlap between JD requirements and candidate skills.\"\"\"\n   234→        required = {s.lower() for s in parsed_jd.get(\"required_skills\", [])}\n   235→        preferred = {s.lower() for s in parsed_jd.get(\"preferred_skills\", [])}\n   236→        candidate_skills = {s.lower() for s in profile.technical_skills}\n   237→\n   238→        if not required:\n   239→            return 60  # No requirements listed — neutral score\n   240→\n   241→        required_hits = len(required & candidate_skills)\n   242→        preferred_hits = len(preferred & candidate_skills)\n   243→\n   244→        required_ratio = required_hits / len(required) if required else 0\n   245→        preferred_bonus = min(20, preferred_hits * 4) if preferred else 0\n   246→\n   247→        base = int(required_ratio * 80)\n   248→        return min(100, base + preferred_bonus)\n   249→\n   250→    def _score_level(self, parsed_jd: dict, profile: IdentityProfileSchema) -> int:\n   251→        \"\"\"Score seniority alignment — penalise both under and over.\"\"\"\n   252→        jd_level = parsed_jd.get(\"seniority_level\", \"\").lower()\n   253→        candidate_level = _LEADERSHIP_TO_LADDER.get(\n   254→            profile.leadership_level, \"senior\"\n   255→        )\n   256→\n   257→        try:\n   258→            jd_idx = _SENIORITY_LADDER.index(jd_level)\n   259→        except ValueError:\n   260→            return 70  # Unknown level — generous neutral\n   261→\n   262→        try:\n   263→            candidate_idx = _SENIORITY_LADDER.index(candidate_level)\n   264→        except ValueError:\n   265→            return 70\n   266→\n   267→        diff = abs(jd_idx - candidate_idx)\n   268→        if diff == 0:\n   269→            return 100\n   270→        elif diff == 1:\n   271→            return 80\n   272→        elif diff == 2:\n   273→            return 55\n   274→        elif diff == 3:\n   275→            return 30\n   276→        else:\n   277→            return 10\n   278→\n   279→    def _score_culture(\n   280→        self,\n   281→        parsed_jd: dict,\n   282→        profile: IdentityProfileSchema,\n   283→        job: DiscoveredJobSchema,\n   284→    ) -> int:\n   285→        \"\"\"Score culture alignment: startup/enterprise + remote preference.\"\"\"\n   286→        score = 60  # default neutral\n   287→\n   288→        # Startup vs enterprise alignment\n   289→        jd_type = parsed_jd.get(\"culture_signals\", {}).get(\n   290→            \"startup_vs_enterprise\", \"\"\n   291→        )\n   292→        candidate_pref = profile.signals.get(\"startup_vs_enterprise\", \"both\")\n   293→        if jd_type and candidate_pref != \"both\":\n   294→            if jd_type == candidate_pref:\n   295→                score += 20\n   296→            else:\n   297→                score -= 20\n   298→\n   299→        # Remote alignment\n   300→        jd_remote = parsed_jd.get(\"remote_type\", \"\")\n   301→        candidate_remote = profile.signals.get(\"remote_preference\", \"flexible\")\n   302→        if jd_remote and candidate_remote != \"flexible\":\n   303→            if jd_remote == candidate_remote:\n   304→                score += 20\n   305→            elif jd_remote == \"onsite\" and candidate_remote == \"remote\":\n   306→                score -= 30\n   307→            else:\n   308→                score -= 10\n   309→\n   310→        return max(0, min(100, score))\n   311→\n   312→    def _score_industry(\n   313→        self, parsed_jd: dict, profile: IdentityProfileSchema\n   314→    ) -> int:\n   315→        \"\"\"Score how well the job's industries align with the candidate's domain expertise.\"\"\"\n   316→        jd_industries = {i.lower() for i in parsed_jd.get(\"industries\", [])}\n   317→        candidate_domains = {d.lower() for d in profile.industry_experience}\n   318→\n   319→        if not jd_industries:\n   320→            return 60\n   321→\n   322→        overlap = len(jd_industries & candidate_domains)\n   323→        if overlap >= 2:\n   324→            return 100\n   325→        elif overlap == 1:\n   326→            return 75\n   327→        else:\n   328→            return 35\n   329→\n   330→    def _score_growth(\n   331→        self, parsed_jd: dict, profile: IdentityProfileSchema\n   332→    ) -> int:\n   333→        \"\"\"Score whether this role expands the candidate's trajectory.\"\"\"\n   334→        indicators = parsed_jd.get(\"growth_indicators\", [])\n   335→        growth_keywords = {\n   336→            \"build from scratch\",\n   337→            \"greenfield\",\n   338→            \"founding\",\n   339→            \"new team\",\n   340→            \"technical strategy\",\n   341→            \"shape the\",\n   342→            \"lead the\",\n   343→            \"define the\",\n   344→            \"architect\",\n   345→            \"platform\",\n   346→            \"0 to 1\",\n   347→        }\n   348→\n   349→        indicator_text = \" \".join(indicators).lower()\n   350→        matches = sum(1 for kw in growth_keywords if kw in indicator_text)\n   351→\n   352→        if matches >= 3:\n   353→            return 90\n   354→        elif matches >= 1:\n   355→            return 70\n   356→        else:\n   357→            return 50\n   358→\n   359→    def _score_compensation(\n   360→        self, parsed_jd: dict, profile: IdentityProfileSchema\n   361→    ) -> int:\n   362→        \"\"\"Score comp alignment — generous when comp isn't mentioned.\"\"\"\n   363→        comp_str = parsed_jd.get(\"comp_mentioned\")\n   364→        if not comp_str:\n   365→            return 75  # No comp listed is common for senior/exec roles\n   366→\n   367→        # Extract numbers from comp string\n   368→        numbers = re.findall(r\"\\d[\\d,]*\", comp_str.replace(\",\", \"\"))\n   369→        if not numbers:\n   370→            return 70\n   371→\n   372→        amounts = [int(n) for n in numbers if len(n) <= 7]  # filter out noise\n   373→        if not amounts:\n   374→            return 70\n   375→\n   376→        # Without candidate min, return neutral\n   377→        return 75\n   378→\n   379→    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n   380→    async def _generate_reasoning(\n   381→        self,\n   382→        job: DiscoveredJobSchema,\n   383→        profile: IdentityProfileSchema,\n   384→        scores: ScoreBreakdown,\n   385→        composite: int,\n   386→    ) -> str:\n   387→        \"\"\"Generate a 2-sentence human-readable reasoning string via Claude.\"\"\"\n   388→        prompt = f\"\"\"You are writing a brief explanation for why a job matches a candidate in a talent agent digest.\n   389→\n   390→Candidate archetypes: {\", \".join(profile.archetypes[:5])}\n   391→Job: {job.title} at {job.company} ({job.location or \"location TBD\"})\n   392→Composite score: {composite}/100\n   393→\n   394→Score breakdown:\n   395→- Technical match: {scores.technical_match}/100\n   396→- Level match: {scores.level_match}/100\n   397→- Culture match: {scores.culture_match}/100\n   398→- Industry match: {scores.industry_match}/100\n   399→- Growth potential: {scores.growth_potential}/100\n   400→- Compensation match: {scores.compensation_match}/100\n   401→\n   402→Write exactly 2 sentences: one sentence on why this is a strong match, one on the key consideration or risk.\n   403→Be specific. Do not use filler phrases like \"This role offers\" or \"This position presents\". Start with the substance.\n   404→Return only the 2 sentences, no other text.\"\"\"\n   405→\n   406→        response = await self._claude.messages.create(\n   407→            model=\"claude-sonnet-4-20250514\",\n   408→            max_tokens=200,\n   409→            messages=[{\"role\": \"user\", \"content\": prompt}],\n   410→        )\n   411→        return response.content[0].text.strip()\n   412→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"f2750489-d8d6-41f5-b42f-4d2a4cab3a05","uuid":"04d2286a-1a57-40be-be16-4c925f6f1f7f","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/agents/discovery/relevance_scorer.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nRelevance Scorer — scores each discovered job against the candidate's identity profile.\n\nScoring dimensions (each 0–100):\n  technical_match   30%  — skills overlap between JD and candidate profile\n  level_match       20%  — seniority alignment (penalise over AND under)\n  culture_match     15%  — startup/enterprise, remote, mission alignment\n  industry_match    15%  — domain expertise alignment\n  growth_potential  10%  — does this expand the candidate's trajectory?\n  compensation_match 10% — estimated band vs candidate target\n\nClaude parses the JD. Math runs locally. Claude writes 2-sentence reasoning.\n\"\"\"\n\nimport json\nimport re\nfrom datetime import datetime, timezone\nfrom uuid import UUID, uuid4\n\nimport structlog\nfrom anthropic import AsyncAnthropic\nfrom tenacity import retry, stop_after_attempt, wait_exponential\n\nfrom backend.agents.discovery.schemas import (\n    IdentityProfileSchema,\n    DiscoveredJobSchema,\n    ScoredJobSchema,\n    ScoreBreakdown,\n)\n\nlogger = structlog.get_logger(__name__)\n\n# Seniority levels for level_match scoring — lower index = more junior\n_SENIORITY_LADDER = [\n    \"intern\",\n    \"junior\",\n    \"associate\",\n    \"mid\",\n    \"senior\",\n    \"staff\",\n    \"principal\",\n    \"lead\",\n    \"manager\",\n    \"director\",\n    \"vp\",\n    \"svp\",\n    \"head\",\n    \"cto\",\n    \"coo\",\n    \"ceo\",\n    \"founder\",\n    \"exec\",\n    \"c-level\",\n]\n\n_LEADERSHIP_TO_LADDER = {\n    \"IC\": \"senior\",\n    \"Lead\": \"lead\",\n    \"Manager\": \"manager\",\n    \"Director\": \"director\",\n    \"VP\": \"vp\",\n    \"C-Level\": \"cto\",\n}\n\n\nclass RelevanceScorer:\n    \"\"\"\n    Scores discovered jobs against a candidate's identity profile.\n\n    Uses Claude to parse JD requirements and generate reasoning.\n    Scoring math runs locally — no LLM needed for the numbers.\n    \"\"\"\n\n    def __init__(self, anthropic_client: AsyncAnthropic):\n        \"\"\"\n        Initialize the RelevanceScorer.\n\n        Args:\n            anthropic_client: Async Anthropic client for Claude API\n        \"\"\"\n        self._claude = anthropic_client\n\n    async def score_batch(\n        self,\n        jobs: list[DiscoveredJobSchema],\n        profile: IdentityProfileSchema,\n        candidate_id: UUID,\n        min_score: int = 60,\n    ) -> list[ScoredJobSchema]:\n        \"\"\"\n        Score a batch of discovered jobs, filtering out those below min_score.\n\n        Args:\n            jobs: Raw discovered jobs to score\n            profile: Candidate identity profile\n            candidate_id: Candidate UUID for scored job records\n            min_score: Jobs below this composite score are discarded\n\n        Returns:\n            Sorted list of ScoredJobSchema, highest composite first\n        \"\"\"\n        logger.info(\n            \"relevance_scorer.batch_start\",\n            job_count=len(jobs),\n            min_score=min_score,\n        )\n\n        scored: list[ScoredJobSchema] = []\n        for job in jobs:\n            try:\n                result = await self.score_job(job, profile, candidate_id)\n                if result.composite_score >= min_score:\n                    scored.append(result)\n            except Exception as e:\n                logger.error(\n                    \"relevance_scorer.job_error\",\n                    job_url=job.url,\n                    error=str(e),\n                )\n\n        scored.sort(key=lambda s: s.composite_score, reverse=True)\n        logger.info(\n            \"relevance_scorer.batch_complete\",\n            scored=len(scored),\n            filtered_out=len(jobs) - len(scored),\n        )\n        return scored\n\n    async def score_job(\n        self,\n        job: DiscoveredJobSchema,\n        profile: IdentityProfileSchema,\n        candidate_id: UUID,\n    ) -> ScoredJobSchema:\n        \"\"\"\n        Score a single job against the identity profile.\n\n        Args:\n            job: Discovered job\n            profile: Candidate identity profile\n            candidate_id: Candidate UUID\n\n        Returns:\n            ScoredJobSchema with full breakdown and reasoning\n        \"\"\"\n        parsed_jd = await self._parse_jd(job)\n        scores = self._compute_scores(parsed_jd, profile, job)\n        composite = scores.composite\n        is_hot = composite >= 80\n        reasoning = await self._generate_reasoning(job, profile, scores, composite)\n\n        return ScoredJobSchema(\n            id=uuid4(),\n            discovered_job_id=job.id or uuid4(),\n            candidate_id=candidate_id,\n            score_breakdown=scores,\n            composite_score=composite,\n            is_hot=is_hot,\n            reasoning=reasoning,\n            scored_at=datetime.now(timezone.utc),\n            # Denormalized job fields for digest display\n            title=job.title,\n            company=job.company,\n            location=job.location,\n            url=job.url,\n        )\n\n    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n    async def _parse_jd(self, job: DiscoveredJobSchema) -> dict:\n        \"\"\"Use Claude to extract structured requirements from a job description.\"\"\"\n        if not job.description:\n            return {}\n\n        prompt = f\"\"\"Extract structured data from this job description. Return ONLY valid JSON, no markdown:\n\nJob Title: {job.title}\nCompany: {job.company}\nLocation: {job.location or \"Not specified\"}\n\nDescription:\n{job.description[:3000]}\n\nReturn this exact JSON structure:\n{{\n  \"required_skills\": [\"<skill1>\", \"<skill2>\"],\n  \"preferred_skills\": [\"<skill1>\"],\n  \"seniority_level\": \"<intern|junior|mid|senior|staff|principal|lead|manager|director|vp|head|exec>\",\n  \"remote_type\": \"<remote|hybrid|onsite|flexible>\",\n  \"industries\": [\"<industry1>\"],\n  \"comp_mentioned\": \"<salary string or null>\",\n  \"culture_signals\": {{\n    \"startup_vs_enterprise\": \"<startup|enterprise|both>\",\n    \"mission_driven\": true\n  }},\n  \"growth_indicators\": [\"<indicator1>\"]\n}}\"\"\"\n\n        response = await self._claude.messages.create(\n            model=\"claude-sonnet-4-20250514\",\n            max_tokens=1024,\n            messages=[{\"role\": \"user\", \"content\": prompt}],\n        )\n\n        raw = response.content[0].text.strip()\n        try:\n            return json.loads(raw)\n        except json.JSONDecodeError:\n            match = re.search(r\"\\{.*\\}\", raw, re.DOTALL)\n            return json.loads(match.group()) if match else {}\n\n    def _compute_scores(\n        self,\n        parsed_jd: dict,\n        profile: IdentityProfileSchema,\n        job: DiscoveredJobSchema,\n    ) -> ScoreBreakdown:\n        \"\"\"Compute all six scoring dimensions locally.\"\"\"\n        return ScoreBreakdown(\n            technical_match=self._score_technical(parsed_jd, profile),\n            level_match=self._score_level(parsed_jd, profile),\n            culture_match=self._score_culture(parsed_jd, profile, job),\n            industry_match=self._score_industry(parsed_jd, profile),\n            growth_potential=self._score_growth(parsed_jd, profile),\n            compensation_match=self._score_compensation(parsed_jd, profile),\n        )\n\n    def _score_technical(\n        self, parsed_jd: dict, profile: IdentityProfileSchema\n    ) -> int:\n        \"\"\"Score based on skills overlap between JD requirements and candidate skills.\"\"\"\n        required = {s.lower() for s in parsed_jd.get(\"required_skills\", [])}\n        preferred = {s.lower() for s in parsed_jd.get(\"preferred_skills\", [])}\n        candidate_skills = {s.lower() for s in profile.technical_skills}\n\n        if not required:\n            return 60  # No requirements listed — neutral score\n\n        required_hits = len(required & candidate_skills)\n        preferred_hits = len(preferred & candidate_skills)\n\n        required_ratio = required_hits / len(required) if required else 0\n        preferred_bonus = min(20, preferred_hits * 4) if preferred else 0\n\n        base = int(required_ratio * 80)\n        return min(100, base + preferred_bonus)\n\n    def _score_level(self, parsed_jd: dict, profile: IdentityProfileSchema) -> int:\n        \"\"\"Score seniority alignment — penalise both under and over.\"\"\"\n        jd_level = parsed_jd.get(\"seniority_level\", \"\").lower()\n        candidate_level = _LEADERSHIP_TO_LADDER.get(\n            profile.leadership_level, \"senior\"\n        )\n\n        try:\n            jd_idx = _SENIORITY_LADDER.index(jd_level)\n        except ValueError:\n            return 70  # Unknown level — generous neutral\n\n        try:\n            candidate_idx = _SENIORITY_LADDER.index(candidate_level)\n        except ValueError:\n            return 70\n\n        diff = abs(jd_idx - candidate_idx)\n        if diff == 0:\n            return 100\n        elif diff == 1:\n            return 80\n        elif diff == 2:\n            return 55\n        elif diff == 3:\n            return 30\n        else:\n            return 10\n\n    def _score_culture(\n        self,\n        parsed_jd: dict,\n        profile: IdentityProfileSchema,\n        job: DiscoveredJobSchema,\n    ) -> int:\n        \"\"\"Score culture alignment: startup/enterprise + remote preference.\"\"\"\n        score = 60  # default neutral\n\n        # Startup vs enterprise alignment\n        jd_type = parsed_jd.get(\"culture_signals\", {}).get(\n            \"startup_vs_enterprise\", \"\"\n        )\n        candidate_pref = profile.signals.get(\"startup_vs_enterprise\", \"both\")\n        if jd_type and candidate_pref != \"both\":\n            if jd_type == candidate_pref:\n                score += 20\n            else:\n                score -= 20\n\n        # Remote alignment\n        jd_remote = parsed_jd.get(\"remote_type\", \"\")\n        candidate_remote = profile.signals.get(\"remote_preference\", \"flexible\")\n        if jd_remote and candidate_remote != \"flexible\":\n            if jd_remote == candidate_remote:\n                score += 20\n            elif jd_remote == \"onsite\" and candidate_remote == \"remote\":\n                score -= 30\n            else:\n                score -= 10\n\n        return max(0, min(100, score))\n\n    def _score_industry(\n        self, parsed_jd: dict, profile: IdentityProfileSchema\n    ) -> int:\n        \"\"\"Score how well the job's industries align with the candidate's domain expertise.\"\"\"\n        jd_industries = {i.lower() for i in parsed_jd.get(\"industries\", [])}\n        candidate_domains = {d.lower() for d in profile.industry_experience}\n\n        if not jd_industries:\n            return 60\n\n        overlap = len(jd_industries & candidate_domains)\n        if overlap >= 2:\n            return 100\n        elif overlap == 1:\n            return 75\n        else:\n            return 35\n\n    def _score_growth(\n        self, parsed_jd: dict, profile: IdentityProfileSchema\n    ) -> int:\n        \"\"\"Score whether this role expands the candidate's trajectory.\"\"\"\n        indicators = parsed_jd.get(\"growth_indicators\", [])\n        growth_keywords = {\n            \"build from scratch\",\n            \"greenfield\",\n            \"founding\",\n            \"new team\",\n            \"technical strategy\",\n            \"shape the\",\n            \"lead the\",\n            \"define the\",\n            \"architect\",\n            \"platform\",\n            \"0 to 1\",\n        }\n\n        indicator_text = \" \".join(indicators).lower()\n        matches = sum(1 for kw in growth_keywords if kw in indicator_text)\n\n        if matches >= 3:\n            return 90\n        elif matches >= 1:\n            return 70\n        else:\n            return 50\n\n    def _score_compensation(\n        self, parsed_jd: dict, profile: IdentityProfileSchema\n    ) -> int:\n        \"\"\"Score comp alignment — generous when comp isn't mentioned.\"\"\"\n        comp_str = parsed_jd.get(\"comp_mentioned\")\n        if not comp_str:\n            return 75  # No comp listed is common for senior/exec roles\n\n        # Extract numbers from comp string\n        numbers = re.findall(r\"\\d[\\d,]*\", comp_str.replace(\",\", \"\"))\n        if not numbers:\n            return 70\n\n        amounts = [int(n) for n in numbers if len(n) <= 7]  # filter out noise\n        if not amounts:\n            return 70\n\n        # Without candidate min, return neutral\n        return 75\n\n    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n    async def _generate_reasoning(\n        self,\n        job: DiscoveredJobSchema,\n        profile: IdentityProfileSchema,\n        scores: ScoreBreakdown,\n        composite: int,\n    ) -> str:\n        \"\"\"Generate a 2-sentence human-readable reasoning string via Claude.\"\"\"\n        prompt = f\"\"\"You are writing a brief explanation for why a job matches a candidate in a talent agent digest.\n\nCandidate archetypes: {\", \".join(profile.archetypes[:5])}\nJob: {job.title} at {job.company} ({job.location or \"location TBD\"})\nComposite score: {composite}/100\n\nScore breakdown:\n- Technical match: {scores.technical_match}/100\n- Level match: {scores.level_match}/100\n- Culture match: {scores.culture_match}/100\n- Industry match: {scores.industry_match}/100\n- Growth potential: {scores.growth_potential}/100\n- Compensation match: {scores.compensation_match}/100\n\nWrite exactly 2 sentences: one sentence on why this is a strong match, one on the key consideration or risk.\nBe specific. Do not use filler phrases like \"This role offers\" or \"This position presents\". Start with the substance.\nReturn only the 2 sentences, no other text.\"\"\"\n\n        response = await self._claude.messages.create(\n            model=\"claude-sonnet-4-20250514\",\n            max_tokens=200,\n            messages=[{\"role\": \"user\", \"content\": prompt}],\n        )\n        return response.content[0].text.strip()\n","numLines":412,"startLine":1,"totalLines":412}}}}
{"t":"2026-05-28T02:56:36.997Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015KwjwmuiMtPMkQDKjPaVeD","type":"tool_result","content":"     1→# Licensed under the Apache License, Version 2.0\n     2→\n     3→\"\"\"\n     4→Web Crawler Agent — multi-source job board crawler.\n     5→\n     6→Supported sources:\n     7→  1. Greenhouse (boards.greenhouse.io/{slug}.json) — public JSON\n     8→  2. Lever (api.lever.co/v0/postings/{slug}?mode=json) — public JSON\n     9→  3. Ashby (api.ashbyhq.com/posting-api/job-board/{slug}) — public JSON\n    10→  4. Workday — deferred (Playwright crawl; not in this revision)\n    11→\n    12→Rate limits: 2 req/sec per host, 0.5-2.0s jitter, User-Agent\n    13→\"TalentAgent/1.0 (+https://github.com/example/talent-agent)\". Adapters\n    14→fan out concurrently across slugs with a semaphore of 4 per source.\n    15→\n    16→Dedup: url_hash() against the discovered_jobs table before insert.\n    17→Curated company slugs live in backend/agents/discovery/sources.yaml.\n    18→\n    19→Offline fallback: if all live adapters return zero rows (network down,\n    20→all sources rate-limited), CrawlerAgent falls back to the FIXTURE_JOBS\n    21→roster so dev pipelines still produce data. Production should monitor\n    22→for this fallback via the `crawler.fallback_used` structured log event.\n    23→\"\"\"\n    24→\n    25→import asyncio\n    26→import hashlib\n    27→import html\n    28→import random\n    29→from datetime import datetime, timezone\n    30→from pathlib import Path\n    31→from typing import Optional\n    32→from uuid import UUID, uuid4\n    33→\n    34→import httpx\n    35→import structlog\n    36→import yaml\n    37→\n    38→from backend.agents.discovery.schemas import SearchManifestSchema, DiscoveredJobSchema\n    39→\n    40→logger = structlog.get_logger(__name__)\n    41→\n    42→USER_AGENT = \"TalentAgent/1.0 (+https://github.com/example/talent-agent)\"\n    43→HTTP_TIMEOUT = 15.0\n    44→PER_SOURCE_CONCURRENCY = 4\n    45→SOURCES_YAML = Path(__file__).parent / \"sources.yaml\"\n    46→\n    47→\n    48→# ─── Offline fallback fixture data ────────────────────────────────────────────\n    49→# Used only when all live adapters return zero rows (network down or all\n    50→# sources unreachable). The `crawler.fallback_used` log event fires when this\n    51→# kicks in so prod can alert on it.\n    52→\n    53→_FALLBACK_JOBS: list[dict] = [\n    54→    {\n    55→        \"source\": \"greenhouse\",\n    56→        \"source_id\": \"gh-fixture-001\",\n    57→        \"title\": \"Head of AI Engineering\",\n    58→        \"company\": \"MusicTech AI\",\n    59→        \"location\": \"Remote (US)\",\n    60→        \"url\": \"https://boards.greenhouse.io/musictech/jobs/001\",\n    61→        \"description\": \"\"\"\n    62→We're a Series B music-tech startup building AI tools for creators and artists.\n    63→\n    64→Looking for a Head of AI Engineering to define our AI strategy from scratch.\n    65→You'll lead a team of ML engineers and shape the technical direction of our\n    66→AI-powered music recommendation and generation systems.\n    67→\n    68→Required:\n    69→- Python, FastAPI, PostgreSQL, Redis\n    70→- LLMs, Claude API, OpenAI API\n    71→- 8+ years engineering experience\n    72→- 3+ years in leadership roles\n    73→\n    74→Preferred:\n    75→- Kubernetes, Docker\n    76→- Music or audio domain experience\n    77→- Startup experience\n    78→\n    79→This is a 0-to-1 greenfield role. You'll shape the technical strategy,\n    80→build the team from scratch, and report directly to the CTO.\n    81→\n    82→Compensation: $250,000-$350,000 + 0.5-1.0% equity\n    83→\n    84→Remote-first. Mission-driven team.\n    85→Industry: Music, AI, Creator Economy\n    86→        \"\"\",\n    87→        \"salary_min\": 250000,\n    88→        \"salary_max\": 350000,\n    89→        \"remote\": True,\n    90→    },\n    91→    {\n    92→        \"source\": \"lever\",\n    93→        \"source_id\": \"lever-fixture-002\",\n    94→        \"title\": \"VP of Engineering\",\n    95→        \"company\": \"FinTech Startup\",\n    96→        \"location\": \"Miami, FL / Remote\",\n    97→        \"url\": \"https://jobs.lever.co/fintechstartup/002\",\n    98→        \"description\": \"\"\"\n    99→Fast-growing fintech startup looking for a VP of Engineering to scale our\n   100→platform from Series A to B.\n   101→\n   102→You'll own the entire engineering organization (currently 15 engineers) and\n   103→drive our technical roadmap as we expand into new markets.\n   104→\n   105→Requirements:\n   106→- 10+ years software engineering\n   107→- 5+ years in engineering leadership\n   108→- Java, Spring Boot, microservices\n   109→- AWS, Kubernetes, distributed systems\n   110→- Fintech or regulated industry experience\n   111→\n   112→What you'll do:\n   113→- Build and scale the engineering team to 40+ engineers\n   114→- Define technical strategy and architecture\n   115→- Partner with Product and Design leadership\n   116→- Establish engineering culture and processes\n   117→\n   118→Compensation: $300,000-$400,000 base + equity\n   119→Location: Miami preferred, remote considered\n   120→Industry: Fintech, Payments\n   121→        \"\"\",\n   122→        \"salary_min\": 300000,\n   123→        \"salary_max\": 400000,\n   124→        \"remote\": True,\n   125→    },\n   126→    {\n   127→        \"source\": \"ashby\",\n   128→        \"source_id\": \"ashby-fixture-003\",\n   129→        \"title\": \"Principal AI Engineer\",\n   130→        \"company\": \"AI Creative Studio\",\n   131→        \"location\": \"San Francisco, CA / Remote\",\n   132→        \"url\": \"https://jobs.ashbyhq.com/aicreative/003\",\n   133→        \"description\": \"\"\"\n   134→We're building the future of AI-powered creative tools. Our platform helps\n   135→artists, musicians, and creators bring their visions to life.\n   136→\n   137→As Principal AI Engineer, you'll lead our core AI team and drive innovation\n   138→across our product suite.\n   139→\n   140→Required skills:\n   141→- Python, PyTorch or TensorFlow\n   142→- LLMs, generative AI, diffusion models\n   143→- Claude API, OpenAI API\n   144→- 8+ years ML/AI experience\n   145→- PhD or equivalent experience preferred\n   146→\n   147→The role:\n   148→- Define AI architecture and research direction\n   149→- Mentor and grow the AI team (currently 5 engineers)\n   150→- Ship production ML systems at scale\n   151→- Collaborate with product and design\n   152→\n   153→Culture: Small, intense, mission-driven startup. We ship fast and iterate.\n   154→Compensation: $280,000-$350,000 + significant equity\n   155→\n   156→Industry: AI, Creative Tools, Music\n   157→        \"\"\",\n   158→        \"salary_min\": 280000,\n   159→        \"salary_max\": 350000,\n   160→        \"remote\": True,\n   161→    },\n   162→    {\n   163→        \"source\": \"greenhouse\",\n   164→        \"source_id\": \"gh-fixture-004\",\n   165→        \"title\": \"Technical Co-Founder / CTO\",\n   166→        \"company\": \"Stealth Web3 Startup\",\n   167→        \"location\": \"Remote\",\n   168→        \"url\": \"https://boards.greenhouse.io/stealthweb3/jobs/004\",\n   169→        \"description\": \"\"\"\n   170→Pre-seed stealth startup building the future of decentralized music royalties.\n   171→\n   172→Looking for a Technical Co-Founder / CTO to lead all technical efforts.\n   173→You'll work directly with the CEO (former Spotify PM) to bring our vision\n   174→to life.\n   175→\n   176→Must have:\n   177→- Full-stack engineering background\n   178→- Solana, Rust, or Ethereum/Solidity\n   179→- Python, FastAPI or Django\n   180→- Experience shipping 0-to-1 products\n   181→\n   182→Nice to have:\n   183→- Music industry experience\n   184→- Previous founder experience\n   185→- Claude API or LLM experience\n   186→\n   187→Equity: 5-15% depending on experience\n   188→Salary: $150,000-$200,000 (negotiable for more equity)\n   189→\n   190→This is a true co-founder role. You'll shape the company from day one.\n   191→Industry: Web3, Music, Blockchain\n   192→        \"\"\",\n   193→        \"salary_min\": 150000,\n   194→        \"salary_max\": 200000,\n   195→        \"remote\": True,\n   196→    },\n   197→    {\n   198→        \"source\": \"lever\",\n   199→        \"source_id\": \"lever-fixture-005\",\n   200→        \"title\": \"AI Creative Director\",\n   201→        \"company\": \"Digital Agency X\",\n   202→        \"location\": \"New York, NY / Hybrid\",\n   203→        \"url\": \"https://jobs.lever.co/agencyx/005\",\n   204→        \"description\": \"\"\"\n   205→Leading digital agency seeking an AI Creative Director to lead our new\n   206→AI & Innovation practice.\n   207→\n   208→You'll bridge the gap between cutting-edge AI technology and creative\n   209→storytelling for our Fortune 500 clients.\n   210→\n   211→Requirements:\n   212→- 7+ years creative or technical experience\n   213→- Deep understanding of generative AI tools\n   214→- Strong portfolio of AI-powered creative work\n   215→- Client-facing experience\n   216→- Python/technical skills a plus\n   217→\n   218→Responsibilities:\n   219→- Lead AI creative strategy for major brand clients\n   220→- Build and grow the AI creative team\n   221→- Develop new AI-powered creative services\n   222→- Present to and advise C-suite clients\n   223→\n   224→Compensation: $200,000-$280,000 + bonus\n   225→Location: NYC office 3 days/week\n   226→\n   227→Industry: Advertising, Creative, AI\n   228→        \"\"\",\n   229→        \"salary_min\": 200000,\n   230→        \"salary_max\": 280000,\n   231→        \"remote\": False,\n   232→    },\n   233→    {\n   234→        \"source\": \"workday\",\n   235→        \"source_id\": \"wd-fixture-006\",\n   236→        \"title\": \"Director of Engineering - AI Platform\",\n   237→        \"company\": \"Enterprise Tech Corp\",\n   238→        \"location\": \"Austin, TX / Remote\",\n   239→        \"url\": \"https://enterprise.wd5.myworkdayjobs.com/careers/job/006\",\n   240→        \"description\": \"\"\"\n   241→Enterprise Tech Corp is hiring a Director of Engineering to lead our\n   242→AI Platform team.\n   243→\n   244→You'll own the platform that powers AI features across all our products,\n   245→serving millions of enterprise users.\n   246→\n   247→Requirements:\n   248→- 12+ years software engineering\n   249→- 5+ years managing engineering teams\n   250→- Experience with ML infrastructure at scale\n   251→- Java, Python, Kubernetes, AWS\n   252→- Enterprise software experience\n   253→\n   254→Team: 25 engineers across 4 teams\n   255→Budget: $5M+ annual cloud spend under your ownership\n   256→\n   257→Compensation: $280,000-$350,000 + RSUs\n   258→Location: Austin HQ or remote US\n   259→\n   260→Industry: Enterprise Software, AI, SaaS\n   261→        \"\"\",\n   262→        \"salary_min\": 280000,\n   263→        \"salary_max\": 350000,\n   264→        \"remote\": True,\n   265→    },\n   266→    {\n   267→        \"source\": \"greenhouse\",\n   268→        \"source_id\": \"gh-fixture-007\",\n   269→        \"title\": \"Senior Staff Engineer - AI\",\n   270→        \"company\": \"Music Streaming Co\",\n   271→        \"location\": \"Los Angeles, CA / Remote\",\n   272→        \"url\": \"https://boards.greenhouse.io/musicstreaming/jobs/007\",\n   273→        \"description\": \"\"\"\n   274→Music Streaming Co is looking for a Senior Staff Engineer to lead our\n   275→AI recommendation systems.\n   276→\n   277→You'll work on the algorithms that power music discovery for 50M+ users.\n   278→\n   279→Required:\n   280→- Python, PyTorch/TensorFlow\n   281→- Recommendation systems experience\n   282→- 10+ years engineering experience\n   283→- Distributed systems at scale\n   284→\n   285→Nice to have:\n   286→- Music domain expertise\n   287→- PhD in ML/AI\n   288→- Publications in RecSys\n   289→\n   290→Impact: Your work will directly shape what millions of people listen to.\n   291→\n   292→Compensation: $300,000-$380,000 + equity + bonus\n   293→Location: LA office or full remote\n   294→\n   295→Industry: Music, Streaming, AI\n   296→        \"\"\",\n   297→        \"salary_min\": 300000,\n   298→        \"salary_max\": 380000,\n   299→        \"remote\": True,\n   300→    },\n   301→    {\n   302→        \"source\": \"ashby\",\n   303→        \"source_id\": \"ashby-fixture-008\",\n   304→        \"title\": \"Founding Engineer\",\n   305→        \"company\": \"AI Agent Startup\",\n   306→        \"location\": \"Remote\",\n   307→        \"url\": \"https://jobs.ashbyhq.com/aiagent/008\",\n   308→        \"description\": \"\"\"\n   309→We're building autonomous AI agents that help knowledge workers.\n   310→\n   311→As Founding Engineer #3, you'll shape the technical foundation and culture\n   312→of the company.\n   313→\n   314→Requirements:\n   315→- 5+ years software engineering\n   316→- Python, FastAPI or similar\n   317→- Claude API or OpenAI API experience\n   318→- Strong product sense\n   319→- Startup experience preferred\n   320→\n   321→What we offer:\n   322→- Meaningful equity (1-3%)\n   323→- Work directly with founders\n   324→- Shape the product and company\n   325→- Remote-first culture\n   326→\n   327→Salary: $180,000-$220,000 + equity\n   328→\n   329→Industry: AI, SaaS, Productivity\n   330→        \"\"\",\n   331→        \"salary_min\": 180000,\n   332→        \"salary_max\": 220000,\n   333→        \"remote\": True,\n   334→    },\n   335→    {\n   336→        \"source\": \"lever\",\n   337→        \"source_id\": \"lever-fixture-009\",\n   338→        \"title\": \"Junior Software Engineer\",\n   339→        \"company\": \"BigCorp Bank\",\n   340→        \"location\": \"New York, NY (On-site)\",\n   341→        \"url\": \"https://jobs.lever.co/bigcorp/009\",\n   342→        \"description\": \"\"\"\n   343→Entry-level position for recent graduates.\n   344→\n   345→Requirements:\n   346→- Bachelor's in CS or related\n   347→- Java or Python basics\n   348→- 0-2 years experience\n   349→- On-site 5 days/week required\n   350→\n   351→Salary: $75,000-$95,000\n   352→\n   353→Industry: Banking, Finance\n   354→        \"\"\",\n   355→        \"salary_min\": 75000,\n   356→        \"salary_max\": 95000,\n   357→        \"remote\": False,\n   358→    },\n   359→    {\n   360→        \"source\": \"greenhouse\",\n   361→        \"source_id\": \"gh-fixture-010\",\n   362→        \"title\": \"Platform Engineer\",\n   363→        \"company\": \"DevOps Startup\",\n   364→        \"location\": \"Denver, CO / Remote\",\n   365→        \"url\": \"https://boards.greenhouse.io/devops/jobs/010\",\n   366→        \"description\": \"\"\"\n   367→We're building the next-gen developer platform.\n   368→\n   369→Looking for a Platform Engineer to help scale our infrastructure.\n   370→\n   371→Required:\n   372→- Kubernetes, Docker, Terraform\n   373→- AWS or GCP\n   374→- Python or Go\n   375→- 5+ years experience\n   376→\n   377→Compensation: $180,000-$240,000 + equity\n   378→Location: Denver or remote\n   379→\n   380→Industry: DevOps, Infrastructure, SaaS\n   381→        \"\"\",\n   382→        \"salary_min\": 180000,\n   383→        \"salary_max\": 240000,\n   384→        \"remote\": True,\n   385→    },\n   386→]\n   387→\n   388→\n   389→# ─── Source Adapters ──────────────────────────────────────────────────────────\n   390→\n   391→\n   392→def _title_matches(title: str, target_titles: list[str]) -> bool:\n   393→    \"\"\"Case-insensitive substring match of any target title against `title`.\"\"\"\n   394→    if not target_titles:\n   395→        return True\n   396→    low = title.lower()\n   397→    return any(t.lower() in low for t in target_titles)\n   398→\n   399→\n   400→def _strip_html(raw: str) -> str:\n   401→    \"\"\"Unescape entities then strip HTML tags via BeautifulSoup.\"\"\"\n   402→    if not raw:\n   403→        return \"\"\n   404→    try:\n   405→        from bs4 import BeautifulSoup\n   406→        return BeautifulSoup(html.unescape(raw), \"html.parser\").get_text(separator=\" \", strip=True)\n   407→    except Exception:\n   408→        return html.unescape(raw)\n   409→\n   410→\n   411→class _RateLimitedClient:\n   412→    \"\"\"httpx.AsyncClient with per-host jitter to stay polite (~2 req/sec).\"\"\"\n   413→\n   414→    def __init__(self, client: httpx.AsyncClient):\n   415→        self._client = client\n   416→        self._sem = asyncio.Semaphore(PER_SOURCE_CONCURRENCY)\n   417→\n   418→    async def get(self, url: str, **kw) -> httpx.Response:\n   419→        async with self._sem:\n   420→            await asyncio.sleep(random.uniform(0.5, 2.0))\n   421→            return await self._client.get(url, **kw)\n   422→\n   423→    async def post(self, url: str, **kw) -> httpx.Response:\n   424→        async with self._sem:\n   425→            await asyncio.sleep(random.uniform(0.5, 2.0))\n   426→            return await self._client.post(url, **kw)\n   427→\n   428→\n   429→class GreenhouseAdapter:\n   430→    \"\"\"Greenhouse public board adapter.\"\"\"\n   431→\n   432→    async def fetch(self, client: _RateLimitedClient, slugs: list[str], target_titles: list[str]) -> list[dict]:\n   433→        async def _one(slug: str) -> list[dict]:\n   434→            url = f\"https://boards.greenhouse.io/{slug}.json\"\n   435→            try:\n   436→                r = await client.get(url)\n   437→                r.raise_for_status()\n   438→                payload = r.json()\n   439→            except Exception as exc:\n   440→                logger.warning(\"crawler.greenhouse.fetch_failed\", slug=slug, error=str(exc))\n   441→                return []\n   442→            out: list[dict] = []\n   443→            for job in payload.get(\"jobs\", []):\n   444→                title = job.get(\"title\") or \"\"\n   445→                if not _title_matches(title, target_titles):\n   446→                    continue\n   447→                loc = (job.get(\"location\") or {}).get(\"name\")\n   448→                out.append({\n   449→                    \"source\": \"greenhouse\",\n   450→                    \"source_id\": f\"gh-{slug}-{job.get('id')}\",\n   451→                    \"title\": title,\n   452→                    \"company\": slug.replace(\"-\", \" \").title(),\n   453→                    \"location\": loc,\n   454→                    \"description\": _strip_html(job.get(\"content\") or \"\"),\n   455→                    \"url\": job.get(\"absolute_url\"),\n   456→                    \"posted_at\": job.get(\"updated_at\"),\n   457→                })\n   458→            logger.info(\"crawler.greenhouse.fetched\", slug=slug, total=len(payload.get(\"jobs\", [])), matched=len(out))\n   459→            return out\n   460→\n   461→        results = await asyncio.gather(*[_one(s) for s in slugs], return_exceptions=True)\n   462→        flat: list[dict] = []\n   463→        for r in results:\n   464→            if isinstance(r, list):\n   465→                flat.extend(r)\n   466→        return flat\n   467→\n   468→\n   469→class LeverAdapter:\n   470→    \"\"\"Lever public postings adapter.\"\"\"\n   471→\n   472→    async def fetch(self, client: _RateLimitedClient, slugs: list[str], target_titles: list[str]) -> list[dict]:\n   473→        async def _one(slug: str) -> list[dict]:\n   474→            url = f\"https://api.lever.co/v0/postings/{slug}?mode=json\"\n   475→            try:\n   476→                r = await client.get(url)\n   477→                r.raise_for_status()\n   478→                postings = r.json()\n   479→            except Exception as exc:\n   480→                logger.warning(\"crawler.lever.fetch_failed\", slug=slug, error=str(exc))\n   481→                return []\n   482→            out: list[dict] = []\n   483→            for p in postings:\n   484→                title = p.get(\"text\") or \"\"\n   485→                if not _title_matches(title, target_titles):\n   486→                    continue\n   487→                cats = p.get(\"categories\") or {}\n   488→                created_ms = p.get(\"createdAt\")\n   489→                posted_at = None\n   490→                if isinstance(created_ms, (int, float)):\n   491→                    try:\n   492→                        posted_at = datetime.fromtimestamp(created_ms / 1000, tz=timezone.utc).isoformat()\n   493→                    except Exception:\n   494→                        posted_at = None\n   495→                out.append({\n   496→                    \"source\": \"lever\",\n   497→                    \"source_id\": f\"lever-{slug}-{p.get('id')}\",\n   498→                    \"title\": title,\n   499→                    \"company\": slug.replace(\"-\", \" \").title(),\n   500→                    \"location\": cats.get(\"location\"),\n   501→                    \"description\": p.get(\"descriptionPlain\") or _strip_html(p.get(\"description\") or \"\"),\n   502→                    \"url\": p.get(\"hostedUrl\"),\n   503→                    \"posted_at\": posted_at,\n   504→                })\n   505→            logger.info(\"crawler.lever.fetched\", slug=slug, total=len(postings), matched=len(out))\n   506→            return out\n   507→\n   508→        results = await asyncio.gather(*[_one(s) for s in slugs], return_exceptions=True)\n   509→        flat: list[dict] = []\n   510→        for r in results:\n   511→            if isinstance(r, list):\n   512→                flat.extend(r)\n   513→        return flat\n   514→\n   515→\n   516→class AshbyAdapter:\n   517→    \"\"\"Ashby public posting-api adapter.\"\"\"\n   518→\n   519→    async def fetch(self, client: _RateLimitedClient, slugs: list[str], target_titles: list[str]) -> list[dict]:\n   520→        async def _one(slug: str) -> list[dict]:\n   521→            url = f\"https://api.ashbyhq.com/posting-api/job-board/{slug}\"\n   522→            try:\n   523→                r = await client.post(url, json={\"includeCompensation\": True})\n   524→                r.raise_for_status()\n   525→                payload = r.json()\n   526→            except Exception as exc:\n   527→                logger.warning(\"crawler.ashby.fetch_failed\", slug=slug, error=str(exc))\n   528→                return []\n   529→            out: list[dict] = []\n   530→            for job in payload.get(\"jobs\", []):\n   531→                title = job.get(\"title\") or \"\"\n   532→                if not _title_matches(title, target_titles):\n   533→                    continue\n   534→                comp = job.get(\"compensation\") or {}\n   535→                out.append({\n   536→                    \"source\": \"ashby\",\n   537→                    \"source_id\": f\"ashby-{slug}-{job.get('id')}\",\n   538→                    \"title\": title,\n   539→                    \"company\": slug.replace(\"-\", \" \").title(),\n   540→                    \"location\": job.get(\"location\"),\n   541→                    \"description\": job.get(\"descriptionPlain\") or _strip_html(job.get(\"description\") or \"\"),\n   542→                    \"url\": job.get(\"jobUrl\"),\n   543→                    \"posted_at\": job.get(\"publishedDate\"),\n   544→                    \"salary_min\": (comp.get(\"compensationTierSummary\") or {}).get(\"minValue\"),\n   545→                    \"salary_max\": (comp.get(\"compensationTierSummary\") or {}).get(\"maxValue\"),\n   546→                })\n   547→            logger.info(\"crawler.ashby.fetched\", slug=slug, total=len(payload.get(\"jobs\", [])), matched=len(out))\n   548→            return out\n   549→\n   550→        results = await asyncio.gather(*[_one(s) for s in slugs], return_exceptions=True)\n   551→        flat: list[dict] = []\n   552→        for r in results:\n   553→            if isinstance(r, list):\n   554→                flat.extend(r)\n   555→        return flat\n   556→\n   557→\n   558→# ─── CrawlerAgent ─────────────────────────────────────────────────────────────\n   559→\n   560→\n   561→class CrawlerAgent:\n   562→    \"\"\"\n   563→    Crawls public ATS boards against a SearchManifestSchema and returns a\n   564→    deduplicated list of DiscoveredJobSchema rows.\n   565→\n   566→    Fans out across Greenhouse / Lever / Ashby adapters concurrently. Falls\n   567→    back to fixture data only if all live adapters return zero rows.\n   568→    Workday adapter is deferred (Playwright crawl, separate revision).\n   569→    \"\"\"\n   570→\n   571→    SOURCES = [\"greenhouse\", \"lever\", \"ashby\", \"workday\"]\n   572→\n   573→    def __init__(self, candidate_id: UUID):\n   574→        self._candidate_id = candidate_id\n   575→\n   576→    def _load_sources(self) -> dict:\n   577→        try:\n   578→            with open(SOURCES_YAML) as f:\n   579→                return yaml.safe_load(f) or {}\n   580→        except FileNotFoundError:\n   581→            logger.error(\"crawler.sources_missing\", path=str(SOURCES_YAML))\n   582→            return {}\n   583→\n   584→    async def run(self, manifest: SearchManifestSchema) -> list[DiscoveredJobSchema]:\n   585→        \"\"\"\n   586→        Execute a crawl run against the manifest.\n   587→\n   588→        Loads sources.yaml, fans out to each adapter in parallel, merges,\n   589→        dedupes by url_hash, returns the populated list. Falls back to\n   590→        fixture data only if all live adapters return zero rows.\n   591→        \"\"\"\n   592→        sources = self._load_sources()\n   593→        logger.info(\n   594→            \"crawler_agent.run_start\",\n   595→            candidate_id=str(self._candidate_id),\n   596→            target_titles=len(manifest.target_titles),\n   597→            sources_loaded=list(sources.keys()),\n   598→        )\n   599→\n   600→        async with httpx.AsyncClient(\n   601→            timeout=HTTP_TIMEOUT,\n   602→            headers={\"User-Agent\": USER_AGENT, \"Accept\": \"application/json\"},\n   603→            follow_redirects=True,\n   604→        ) as raw_client:\n   605→            client = _RateLimitedClient(raw_client)\n   606→            adapters_results = await asyncio.gather(\n   607→                GreenhouseAdapter().fetch(client, sources.get(\"greenhouse\", []) or [], manifest.target_titles),\n   608→                LeverAdapter().fetch(client, sources.get(\"lever\", []) or [], manifest.target_titles),\n   609→                AshbyAdapter().fetch(client, sources.get(\"ashby\", []) or [], manifest.target_titles),\n   610→                return_exceptions=True,\n   611→            )\n   612→\n   613→        merged: list[dict] = []\n   614→        for r in adapters_results:\n   615→            if isinstance(r, list):\n   616→                merged.extend(r)\n   617→            else:\n   618→                logger.warning(\"crawler.adapter_exception\", error=str(r))\n   619→\n   620→        # Dedupe by url_hash\n   621→        seen: set[str] = set()\n   622→        deduped: list[dict] = []\n   623→        for j in merged:\n   624→            url = j.get(\"url\") or \"\"\n   625→            if not url:\n   626→                continue\n   627→            h = self.url_hash(url)\n   628→            if h in seen:\n   629→                continue\n   630→            seen.add(h)\n   631→            deduped.append(j)\n   632→\n   633→        logger.info(\n   634→            \"crawler_agent.run_complete\",\n   635→            candidate_id=str(self._candidate_id),\n   636→            adapters_merged=len(merged),\n   637→            after_dedup=len(deduped),\n   638→        )\n   639→\n   640→        # Apply exclusions + convert to schema\n   641→        results = self._apply_exclusions_and_convert(deduped, manifest)\n   642→\n   643→        # Offline fallback: only when EVERY live adapter returned empty\n   644→        if not results:\n   645→            logger.warning(\n   646→                \"crawler.fallback_used\",\n   647→                candidate_id=str(self._candidate_id),\n   648→                reason=\"all_live_adapters_empty\",\n   649→            )\n   650→            return self._filter_fixtures(manifest)\n   651→\n   652→        return results\n   653→\n   654→    def _apply_exclusions_and_convert(\n   655→        self, jobs: list[dict], manifest: SearchManifestSchema\n   656→    ) -> list[DiscoveredJobSchema]:\n   657→        \"\"\"Apply excluded_companies / excluded_industries and convert dicts to schema.\"\"\"\n   658→        excluded_companies = {c.lower() for c in manifest.excluded_companies}\n   659→        excluded_industries = {i.lower() for i in manifest.excluded_industries}\n   660→\n   661→        out: list[DiscoveredJobSchema] = []\n   662→        for j in jobs:\n   663→            company_low = (j.get(\"company\") or \"\").lower()\n   664→            if any(exc in company_low for exc in excluded_companies):\n   665→                continue\n   666→            desc_low = (j.get(\"description\") or \"\").lower()\n   667→            if any(exc in desc_low for exc in excluded_industries):\n   668→                continue\n   669→            posted_at: Optional[datetime] = None\n   670→            if isinstance(j.get(\"posted_at\"), str):\n   671→                try:\n   672→                    posted_at = datetime.fromisoformat(j[\"posted_at\"].replace(\"Z\", \"+00:00\"))\n   673→                except Exception:\n   674→                    posted_at = None\n   675→            out.append(DiscoveredJobSchema(\n   676→                id=uuid4(),\n   677→                source=j[\"source\"],\n   678→                source_id=j[\"source_id\"],\n   679→                title=j[\"title\"],\n   680→                company=j[\"company\"],\n   681→                location=j.get(\"location\"),\n   682→                description=j.get(\"description\"),\n   683→                url=j[\"url\"],\n   684→                posted_at=posted_at,\n   685→                salary_min=j.get(\"salary_min\"),\n   686→                salary_max=j.get(\"salary_max\"),\n   687→                remote=bool(j.get(\"remote\")) or \"remote\" in (j.get(\"location\") or \"\").lower(),\n   688→                crawled_at=datetime.now(timezone.utc),\n   689→            ))\n   690→        return out\n   691→\n   692→    def _filter_fixtures(\n   693→        self, manifest: SearchManifestSchema\n   694→    ) -> list[DiscoveredJobSchema]:\n   695→        \"\"\"\n   696→        Filter fixture jobs based on the search manifest.\n   697→\n   698→        Applies:\n   699→          - Title matching (case-insensitive substring)\n   700→          - Company exclusions\n   701→          - Industry exclusions (checked against description)\n   702→\n   703→        Returns deterministic results for testing.\n   704→        \"\"\"\n   705→        results: list[DiscoveredJobSchema] = []\n   706→        excluded_companies = {c.lower() for c in manifest.excluded_companies}\n   707→        excluded_industries = {i.lower() for i in manifest.excluded_industries}\n   708→        target_keywords = {kw.lower() for kw in manifest.keywords}\n   709→        target_titles = {t.lower() for t in manifest.target_titles}\n   710→\n   711→        for job_data in _FALLBACK_JOBS:\n   712→            company_lower = job_data[\"company\"].lower()\n   713→            title_lower = job_data[\"title\"].lower()\n   714→            desc_lower = job_data.get(\"description\", \"\").lower()\n   715→\n   716→            # Skip excluded companies\n   717→            if any(exc in company_lower for exc in excluded_companies):\n   718→                continue\n   719→\n   720→            # Skip excluded industries (check description)\n   721→            if any(exc in desc_lower for exc in excluded_industries):\n   722→                continue\n   723→\n   724→            # Match by title or keywords\n   725→            title_match = any(t in title_lower for t in target_titles)\n   726→            keyword_match = any(\n   727→                kw in desc_lower or kw in title_lower for kw in target_keywords\n   728→            )\n   729→\n   730→            if title_match or keyword_match:\n   731→                results.append(\n   732→                    DiscoveredJobSchema(\n   733→                        id=uuid4(),\n   734→                        source=job_data[\"source\"],\n   735→                        source_id=job_data[\"source_id\"],\n   736→                        title=job_data[\"title\"],\n   737→                        company=job_data[\"company\"],\n   738→                        location=job_data.get(\"location\"),\n   739→                        description=job_data.get(\"description\"),\n   740→                        url=job_data[\"url\"],\n   741→                        salary_min=job_data.get(\"salary_min\"),\n   742→                        salary_max=job_data.get(\"salary_max\"),\n   743→                        remote=job_data.get(\"remote\", False),\n   744→                        crawled_at=datetime.now(timezone.utc),\n   745→                    )\n   746→                )\n   747→\n   748→        return results\n   749→\n   750→    @staticmethod\n   751→    def url_hash(url: str) -> str:\n   752→        \"\"\"Deterministic hash for deduplication against the discovered_jobs table.\"\"\"\n   753→        return hashlib.sha256(url.strip().lower().encode()).hexdigest()\n   754→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"f2750489-d8d6-41f5-b42f-4d2a4cab3a05","uuid":"ca87c366-ad6c-47ac-8558-ee17d331a763","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/agents/discovery/crawler_agent.py","content":"# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nWeb Crawler Agent — multi-source job board crawler.\n\nSupported sources:\n  1. Greenhouse (boards.greenhouse.io/{slug}.json) — public JSON\n  2. Lever (api.lever.co/v0/postings/{slug}?mode=json) — public JSON\n  3. Ashby (api.ashbyhq.com/posting-api/job-board/{slug}) — public JSON\n  4. Workday — deferred (Playwright crawl; not in this revision)\n\nRate limits: 2 req/sec per host, 0.5-2.0s jitter, User-Agent\n\"TalentAgent/1.0 (+https://github.com/example/talent-agent)\". Adapters\nfan out concurrently across slugs with a semaphore of 4 per source.\n\nDedup: url_hash() against the discovered_jobs table before insert.\nCurated company slugs live in backend/agents/discovery/sources.yaml.\n\nOffline fallback: if all live adapters return zero rows (network down,\nall sources rate-limited), CrawlerAgent falls back to the FIXTURE_JOBS\nroster so dev pipelines still produce data. Production should monitor\nfor this fallback via the `crawler.fallback_used` structured log event.\n\"\"\"\n\nimport asyncio\nimport hashlib\nimport html\nimport random\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Optional\nfrom uuid import UUID, uuid4\n\nimport httpx\nimport structlog\nimport yaml\n\nfrom backend.agents.discovery.schemas import SearchManifestSchema, DiscoveredJobSchema\n\nlogger = structlog.get_logger(__name__)\n\nUSER_AGENT = \"TalentAgent/1.0 (+https://github.com/example/talent-agent)\"\nHTTP_TIMEOUT = 15.0\nPER_SOURCE_CONCURRENCY = 4\nSOURCES_YAML = Path(__file__).parent / \"sources.yaml\"\n\n\n# ─── Offline fallback fixture data ────────────────────────────────────────────\n# Used only when all live adapters return zero rows (network down or all\n# sources unreachable). The `crawler.fallback_used` log event fires when this\n# kicks in so prod can alert on it.\n\n_FALLBACK_JOBS: list[dict] = [\n    {\n        \"source\": \"greenhouse\",\n        \"source_id\": \"gh-fixture-001\",\n        \"title\": \"Head of AI Engineering\",\n        \"company\": \"MusicTech AI\",\n        \"location\": \"Remote (US)\",\n        \"url\": \"https://boards.greenhouse.io/musictech/jobs/001\",\n        \"description\": \"\"\"\nWe're a Series B music-tech startup building AI tools for creators and artists.\n\nLooking for a Head of AI Engineering to define our AI strategy from scratch.\nYou'll lead a team of ML engineers and shape the technical direction of our\nAI-powered music recommendation and generation systems.\n\nRequired:\n- Python, FastAPI, PostgreSQL, Redis\n- LLMs, Claude API, OpenAI API\n- 8+ years engineering experience\n- 3+ years in leadership roles\n\nPreferred:\n- Kubernetes, Docker\n- Music or audio domain experience\n- Startup experience\n\nThis is a 0-to-1 greenfield role. You'll shape the technical strategy,\nbuild the team from scratch, and report directly to the CTO.\n\nCompensation: $250,000-$350,000 + 0.5-1.0% equity\n\nRemote-first. Mission-driven team.\nIndustry: Music, AI, Creator Economy\n        \"\"\",\n        \"salary_min\": 250000,\n        \"salary_max\": 350000,\n        \"remote\": True,\n    },\n    {\n        \"source\": \"lever\",\n        \"source_id\": \"lever-fixture-002\",\n        \"title\": \"VP of Engineering\",\n        \"company\": \"FinTech Startup\",\n        \"location\": \"Miami, FL / Remote\",\n        \"url\": \"https://jobs.lever.co/fintechstartup/002\",\n        \"description\": \"\"\"\nFast-growing fintech startup looking for a VP of Engineering to scale our\nplatform from Series A to B.\n\nYou'll own the entire engineering organization (currently 15 engineers) and\ndrive our technical roadmap as we expand into new markets.\n\nRequirements:\n- 10+ years software engineering\n- 5+ years in engineering leadership\n- Java, Spring Boot, microservices\n- AWS, Kubernetes, distributed systems\n- Fintech or regulated industry experience\n\nWhat you'll do:\n- Build and scale the engineering team to 40+ engineers\n- Define technical strategy and architecture\n- Partner with Product and Design leadership\n- Establish engineering culture and processes\n\nCompensation: $300,000-$400,000 base + equity\nLocation: Miami preferred, remote considered\nIndustry: Fintech, Payments\n        \"\"\",\n        \"salary_min\": 300000,\n        \"salary_max\": 400000,\n        \"remote\": True,\n    },\n    {\n        \"source\": \"ashby\",\n        \"source_id\": \"ashby-fixture-003\",\n        \"title\": \"Principal AI Engineer\",\n        \"company\": \"AI Creative Studio\",\n        \"location\": \"San Francisco, CA / Remote\",\n        \"url\": \"https://jobs.ashbyhq.com/aicreative/003\",\n        \"description\": \"\"\"\nWe're building the future of AI-powered creative tools. Our platform helps\nartists, musicians, and creators bring their visions to life.\n\nAs Principal AI Engineer, you'll lead our core AI team and drive innovation\nacross our product suite.\n\nRequired skills:\n- Python, PyTorch or TensorFlow\n- LLMs, generative AI, diffusion models\n- Claude API, OpenAI API\n- 8+ years ML/AI experience\n- PhD or equivalent experience preferred\n\nThe role:\n- Define AI architecture and research direction\n- Mentor and grow the AI team (currently 5 engineers)\n- Ship production ML systems at scale\n- Collaborate with product and design\n\nCulture: Small, intense, mission-driven startup. We ship fast and iterate.\nCompensation: $280,000-$350,000 + significant equity\n\nIndustry: AI, Creative Tools, Music\n        \"\"\",\n        \"salary_min\": 280000,\n        \"salary_max\": 350000,\n        \"remote\": True,\n    },\n    {\n        \"source\": \"greenhouse\",\n        \"source_id\": \"gh-fixture-004\",\n        \"title\": \"Technical Co-Founder / CTO\",\n        \"company\": \"Stealth Web3 Startup\",\n        \"location\": \"Remote\",\n        \"url\": \"https://boards.greenhouse.io/stealthweb3/jobs/004\",\n        \"description\": \"\"\"\nPre-seed stealth startup building the future of decentralized music royalties.\n\nLooking for a Technical Co-Founder / CTO to lead all technical efforts.\nYou'll work directly with the CEO (former Spotify PM) to bring our vision\nto life.\n\nMust have:\n- Full-stack engineering background\n- Solana, Rust, or Ethereum/Solidity\n- Python, FastAPI or Django\n- Experience shipping 0-to-1 products\n\nNice to have:\n- Music industry experience\n- Previous founder experience\n- Claude API or LLM experience\n\nEquity: 5-15% depending on experience\nSalary: $150,000-$200,000 (negotiable for more equity)\n\nThis is a true co-founder role. You'll shape the company from day one.\nIndustry: Web3, Music, Blockchain\n        \"\"\",\n        \"salary_min\": 150000,\n        \"salary_max\": 200000,\n        \"remote\": True,\n    },\n    {\n        \"source\": \"lever\",\n        \"source_id\": \"lever-fixture-005\",\n        \"title\": \"AI Creative Director\",\n        \"company\": \"Digital Agency X\",\n        \"location\": \"New York, NY / Hybrid\",\n        \"url\": \"https://jobs.lever.co/agencyx/005\",\n        \"description\": \"\"\"\nLeading digital agency seeking an AI Creative Director to lead our new\nAI & Innovation practice.\n\nYou'll bridge the gap between cutting-edge AI technology and creative\nstorytelling for our Fortune 500 clients.\n\nRequirements:\n- 7+ years creative or technical experience\n- Deep understanding of generative AI tools\n- Strong portfolio of AI-powered creative work\n- Client-facing experience\n- Python/technical skills a plus\n\nResponsibilities:\n- Lead AI creative strategy for major brand clients\n- Build and grow the AI creative team\n- Develop new AI-powered creative services\n- Present to and advise C-suite clients\n\nCompensation: $200,000-$280,000 + bonus\nLocation: NYC office 3 days/week\n\nIndustry: Advertising, Creative, AI\n        \"\"\",\n        \"salary_min\": 200000,\n        \"salary_max\": 280000,\n        \"remote\": False,\n    },\n    {\n        \"source\": \"workday\",\n        \"source_id\": \"wd-fixture-006\",\n        \"title\": \"Director of Engineering - AI Platform\",\n        \"company\": \"Enterprise Tech Corp\",\n        \"location\": \"Austin, TX / Remote\",\n        \"url\": \"https://enterprise.wd5.myworkdayjobs.com/careers/job/006\",\n        \"description\": \"\"\"\nEnterprise Tech Corp is hiring a Director of Engineering to lead our\nAI Platform team.\n\nYou'll own the platform that powers AI features across all our products,\nserving millions of enterprise users.\n\nRequirements:\n- 12+ years software engineering\n- 5+ years managing engineering teams\n- Experience with ML infrastructure at scale\n- Java, Python, Kubernetes, AWS\n- Enterprise software experience\n\nTeam: 25 engineers across 4 teams\nBudget: $5M+ annual cloud spend under your ownership\n\nCompensation: $280,000-$350,000 + RSUs\nLocation: Austin HQ or remote US\n\nIndustry: Enterprise Software, AI, SaaS\n        \"\"\",\n        \"salary_min\": 280000,\n        \"salary_max\": 350000,\n        \"remote\": True,\n    },\n    {\n        \"source\": \"greenhouse\",\n        \"source_id\": \"gh-fixture-007\",\n        \"title\": \"Senior Staff Engineer - AI\",\n        \"company\": \"Music Streaming Co\",\n        \"location\": \"Los Angeles, CA / Remote\",\n        \"url\": \"https://boards.greenhouse.io/musicstreaming/jobs/007\",\n        \"description\": \"\"\"\nMusic Streaming Co is looking for a Senior Staff Engineer to lead our\nAI recommendation systems.\n\nYou'll work on the algorithms that power music discovery for 50M+ users.\n\nRequired:\n- Python, PyTorch/TensorFlow\n- Recommendation systems experience\n- 10+ years engineering experience\n- Distributed systems at scale\n\nNice to have:\n- Music domain expertise\n- PhD in ML/AI\n- Publications in RecSys\n\nImpact: Your work will directly shape what millions of people listen to.\n\nCompensation: $300,000-$380,000 + equity + bonus\nLocation: LA office or full remote\n\nIndustry: Music, Streaming, AI\n        \"\"\",\n        \"salary_min\": 300000,\n        \"salary_max\": 380000,\n        \"remote\": True,\n    },\n    {\n        \"source\": \"ashby\",\n        \"source_id\": \"ashby-fixture-008\",\n        \"title\": \"Founding Engineer\",\n        \"company\": \"AI Agent Startup\",\n        \"location\": \"Remote\",\n        \"url\": \"https://jobs.ashbyhq.com/aiagent/008\",\n        \"description\": \"\"\"\nWe're building autonomous AI agents that help knowledge workers.\n\nAs Founding Engineer #3, you'll shape the technical foundation and culture\nof the company.\n\nRequirements:\n- 5+ years software engineering\n- Python, FastAPI or similar\n- Claude API or OpenAI API experience\n- Strong product sense\n- Startup experience preferred\n\nWhat we offer:\n- Meaningful equity (1-3%)\n- Work directly with founders\n- Shape the product and company\n- Remote-first culture\n\nSalary: $180,000-$220,000 + equity\n\nIndustry: AI, SaaS, Productivity\n        \"\"\",\n        \"salary_min\": 180000,\n        \"salary_max\": 220000,\n        \"remote\": True,\n    },\n    {\n        \"source\": \"lever\",\n        \"source_id\": \"lever-fixture-009\",\n        \"title\": \"Junior Software Engineer\",\n        \"company\": \"BigCorp Bank\",\n        \"location\": \"New York, NY (On-site)\",\n        \"url\": \"https://jobs.lever.co/bigcorp/009\",\n        \"description\": \"\"\"\nEntry-level position for recent graduates.\n\nRequirements:\n- Bachelor's in CS or related\n- Java or Python basics\n- 0-2 years experience\n- On-site 5 days/week required\n\nSalary: $75,000-$95,000\n\nIndustry: Banking, Finance\n        \"\"\",\n        \"salary_min\": 75000,\n        \"salary_max\": 95000,\n        \"remote\": False,\n    },\n    {\n        \"source\": \"greenhouse\",\n        \"source_id\": \"gh-fixture-010\",\n        \"title\": \"Platform Engineer\",\n        \"company\": \"DevOps Startup\",\n        \"location\": \"Denver, CO / Remote\",\n        \"url\": \"https://boards.greenhouse.io/devops/jobs/010\",\n        \"description\": \"\"\"\nWe're building the next-gen developer platform.\n\nLooking for a Platform Engineer to help scale our infrastructure.\n\nRequired:\n- Kubernetes, Docker, Terraform\n- AWS or GCP\n- Python or Go\n- 5+ years experience\n\nCompensation: $180,000-$240,000 + equity\nLocation: Denver or remote\n\nIndustry: DevOps, Infrastructure, SaaS\n        \"\"\",\n        \"salary_min\": 180000,\n        \"salary_max\": 240000,\n        \"remote\": True,\n    },\n]\n\n\n# ─── Source Adapters ──────────────────────────────────────────────────────────\n\n\ndef _title_matches(title: str, target_titles: list[str]) -> bool:\n    \"\"\"Case-insensitive substring match of any target title against `title`.\"\"\"\n    if not target_titles:\n        return True\n    low = title.lower()\n    return any(t.lower() in low for t in target_titles)\n\n\ndef _strip_html(raw: str) -> str:\n    \"\"\"Unescape entities then strip HTML tags via BeautifulSoup.\"\"\"\n    if not raw:\n        return \"\"\n    try:\n        from bs4 import BeautifulSoup\n        return BeautifulSoup(html.unescape(raw), \"html.parser\").get_text(separator=\" \", strip=True)\n    except Exception:\n        return html.unescape(raw)\n\n\nclass _RateLimitedClient:\n    \"\"\"httpx.AsyncClient with per-host jitter to stay polite (~2 req/sec).\"\"\"\n\n    def __init__(self, client: httpx.AsyncClient):\n        self._client = client\n        self._sem = asyncio.Semaphore(PER_SOURCE_CONCURRENCY)\n\n    async def get(self, url: str, **kw) -> httpx.Response:\n        async with self._sem:\n            await asyncio.sleep(random.uniform(0.5, 2.0))\n            return await self._client.get(url, **kw)\n\n    async def post(self, url: str, **kw) -> httpx.Response:\n        async with self._sem:\n            await asyncio.sleep(random.uniform(0.5, 2.0))\n            return await self._client.post(url, **kw)\n\n\nclass GreenhouseAdapter:\n    \"\"\"Greenhouse public board adapter.\"\"\"\n\n    async def fetch(self, client: _RateLimitedClient, slugs: list[str], target_titles: list[str]) -> list[dict]:\n        async def _one(slug: str) -> list[dict]:\n            url = f\"https://boards.greenhouse.io/{slug}.json\"\n            try:\n                r = await client.get(url)\n                r.raise_for_status()\n                payload = r.json()\n            except Exception as exc:\n                logger.warning(\"crawler.greenhouse.fetch_failed\", slug=slug, error=str(exc))\n                return []\n            out: list[dict] = []\n            for job in payload.get(\"jobs\", []):\n                title = job.get(\"title\") or \"\"\n                if not _title_matches(title, target_titles):\n                    continue\n                loc = (job.get(\"location\") or {}).get(\"name\")\n                out.append({\n                    \"source\": \"greenhouse\",\n                    \"source_id\": f\"gh-{slug}-{job.get('id')}\",\n                    \"title\": title,\n                    \"company\": slug.replace(\"-\", \" \").title(),\n                    \"location\": loc,\n                    \"description\": _strip_html(job.get(\"content\") or \"\"),\n                    \"url\": job.get(\"absolute_url\"),\n                    \"posted_at\": job.get(\"updated_at\"),\n                })\n            logger.info(\"crawler.greenhouse.fetched\", slug=slug, total=len(payload.get(\"jobs\", [])), matched=len(out))\n            return out\n\n        results = await asyncio.gather(*[_one(s) for s in slugs], return_exceptions=True)\n        flat: list[dict] = []\n        for r in results:\n            if isinstance(r, list):\n                flat.extend(r)\n        return flat\n\n\nclass LeverAdapter:\n    \"\"\"Lever public postings adapter.\"\"\"\n\n    async def fetch(self, client: _RateLimitedClient, slugs: list[str], target_titles: list[str]) -> list[dict]:\n        async def _one(slug: str) -> list[dict]:\n            url = f\"https://api.lever.co/v0/postings/{slug}?mode=json\"\n            try:\n                r = await client.get(url)\n                r.raise_for_status()\n                postings = r.json()\n            except Exception as exc:\n                logger.warning(\"crawler.lever.fetch_failed\", slug=slug, error=str(exc))\n                return []\n            out: list[dict] = []\n            for p in postings:\n                title = p.get(\"text\") or \"\"\n                if not _title_matches(title, target_titles):\n                    continue\n                cats = p.get(\"categories\") or {}\n                created_ms = p.get(\"createdAt\")\n                posted_at = None\n                if isinstance(created_ms, (int, float)):\n                    try:\n                        posted_at = datetime.fromtimestamp(created_ms / 1000, tz=timezone.utc).isoformat()\n                    except Exception:\n                        posted_at = None\n                out.append({\n                    \"source\": \"lever\",\n                    \"source_id\": f\"lever-{slug}-{p.get('id')}\",\n                    \"title\": title,\n                    \"company\": slug.replace(\"-\", \" \").title(),\n                    \"location\": cats.get(\"location\"),\n                    \"description\": p.get(\"descriptionPlain\") or _strip_html(p.get(\"description\") or \"\"),\n                    \"url\": p.get(\"hostedUrl\"),\n                    \"posted_at\": posted_at,\n                })\n            logger.info(\"crawler.lever.fetched\", slug=slug, total=len(postings), matched=len(out))\n            return out\n\n        results = await asyncio.gather(*[_one(s) for s in slugs], return_exceptions=True)\n        flat: list[dict] = []\n        for r in results:\n            if isinstance(r, list):\n                flat.extend(r)\n        return flat\n\n\nclass AshbyAdapter:\n    \"\"\"Ashby public posting-api adapter.\"\"\"\n\n    async def fetch(self, client: _RateLimitedClient, slugs: list[str], target_titles: list[str]) -> list[dict]:\n        async def _one(slug: str) -> list[dict]:\n            url = f\"https://api.ashbyhq.com/posting-api/job-board/{slug}\"\n            try:\n                r = await client.post(url, json={\"includeCompensation\": True})\n                r.raise_for_status()\n                payload = r.json()\n            except Exception as exc:\n                logger.warning(\"crawler.ashby.fetch_failed\", slug=slug, error=str(exc))\n                return []\n            out: list[dict] = []\n            for job in payload.get(\"jobs\", []):\n                title = job.get(\"title\") or \"\"\n                if not _title_matches(title, target_titles):\n                    continue\n                comp = job.get(\"compensation\") or {}\n                out.append({\n                    \"source\": \"ashby\",\n                    \"source_id\": f\"ashby-{slug}-{job.get('id')}\",\n                    \"title\": title,\n                    \"company\": slug.replace(\"-\", \" \").title(),\n                    \"location\": job.get(\"location\"),\n                    \"description\": job.get(\"descriptionPlain\") or _strip_html(job.get(\"description\") or \"\"),\n                    \"url\": job.get(\"jobUrl\"),\n                    \"posted_at\": job.get(\"publishedDate\"),\n                    \"salary_min\": (comp.get(\"compensationTierSummary\") or {}).get(\"minValue\"),\n                    \"salary_max\": (comp.get(\"compensationTierSummary\") or {}).get(\"maxValue\"),\n                })\n            logger.info(\"crawler.ashby.fetched\", slug=slug, total=len(payload.get(\"jobs\", [])), matched=len(out))\n            return out\n\n        results = await asyncio.gather(*[_one(s) for s in slugs], return_exceptions=True)\n        flat: list[dict] = []\n        for r in results:\n            if isinstance(r, list):\n                flat.extend(r)\n        return flat\n\n\n# ─── CrawlerAgent ─────────────────────────────────────────────────────────────\n\n\nclass CrawlerAgent:\n    \"\"\"\n    Crawls public ATS boards against a SearchManifestSchema and returns a\n    deduplicated list of DiscoveredJobSchema rows.\n\n    Fans out across Greenhouse / Lever / Ashby adapters concurrently. Falls\n    back to fixture data only if all live adapters return zero rows.\n    Workday adapter is deferred (Playwright crawl, separate revision).\n    \"\"\"\n\n    SOURCES = [\"greenhouse\", \"lever\", \"ashby\", \"workday\"]\n\n    def __init__(self, candidate_id: UUID):\n        self._candidate_id = candidate_id\n\n    def _load_sources(self) -> dict:\n        try:\n            with open(SOURCES_YAML) as f:\n                return yaml.safe_load(f) or {}\n        except FileNotFoundError:\n            logger.error(\"crawler.sources_missing\", path=str(SOURCES_YAML))\n            return {}\n\n    async def run(self, manifest: SearchManifestSchema) -> list[DiscoveredJobSchema]:\n        \"\"\"\n        Execute a crawl run against the manifest.\n\n        Loads sources.yaml, fans out to each adapter in parallel, merges,\n        dedupes by url_hash, returns the populated list. Falls back to\n        fixture data only if all live adapters return zero rows.\n        \"\"\"\n        sources = self._load_sources()\n        logger.info(\n            \"crawler_agent.run_start\",\n            candidate_id=str(self._candidate_id),\n            target_titles=len(manifest.target_titles),\n            sources_loaded=list(sources.keys()),\n        )\n\n        async with httpx.AsyncClient(\n            timeout=HTTP_TIMEOUT,\n            headers={\"User-Agent\": USER_AGENT, \"Accept\": \"application/json\"},\n            follow_redirects=True,\n        ) as raw_client:\n            client = _RateLimitedClient(raw_client)\n            adapters_results = await asyncio.gather(\n                GreenhouseAdapter().fetch(client, sources.get(\"greenhouse\", []) or [], manifest.target_titles),\n                LeverAdapter().fetch(client, sources.get(\"lever\", []) or [], manifest.target_titles),\n                AshbyAdapter().fetch(client, sources.get(\"ashby\", []) or [], manifest.target_titles),\n                return_exceptions=True,\n            )\n\n        merged: list[dict] = []\n        for r in adapters_results:\n            if isinstance(r, list):\n                merged.extend(r)\n            else:\n                logger.warning(\"crawler.adapter_exception\", error=str(r))\n\n        # Dedupe by url_hash\n        seen: set[str] = set()\n        deduped: list[dict] = []\n        for j in merged:\n            url = j.get(\"url\") or \"\"\n            if not url:\n                continue\n            h = self.url_hash(url)\n            if h in seen:\n                continue\n            seen.add(h)\n            deduped.append(j)\n\n        logger.info(\n            \"crawler_agent.run_complete\",\n            candidate_id=str(self._candidate_id),\n            adapters_merged=len(merged),\n            after_dedup=len(deduped),\n        )\n\n        # Apply exclusions + convert to schema\n        results = self._apply_exclusions_and_convert(deduped, manifest)\n\n        # Offline fallback: only when EVERY live adapter returned empty\n        if not results:\n            logger.warning(\n                \"crawler.fallback_used\",\n                candidate_id=str(self._candidate_id),\n                reason=\"all_live_adapters_empty\",\n            )\n            return self._filter_fixtures(manifest)\n\n        return results\n\n    def _apply_exclusions_and_convert(\n        self, jobs: list[dict], manifest: SearchManifestSchema\n    ) -> list[DiscoveredJobSchema]:\n        \"\"\"Apply excluded_companies / excluded_industries and convert dicts to schema.\"\"\"\n        excluded_companies = {c.lower() for c in manifest.excluded_companies}\n        excluded_industries = {i.lower() for i in manifest.excluded_industries}\n\n        out: list[DiscoveredJobSchema] = []\n        for j in jobs:\n            company_low = (j.get(\"company\") or \"\").lower()\n            if any(exc in company_low for exc in excluded_companies):\n                continue\n            desc_low = (j.get(\"description\") or \"\").lower()\n            if any(exc in desc_low for exc in excluded_industries):\n                continue\n            posted_at: Optional[datetime] = None\n            if isinstance(j.get(\"posted_at\"), str):\n                try:\n                    posted_at = datetime.fromisoformat(j[\"posted_at\"].replace(\"Z\", \"+00:00\"))\n                except Exception:\n                    posted_at = None\n            out.append(DiscoveredJobSchema(\n                id=uuid4(),\n                source=j[\"source\"],\n                source_id=j[\"source_id\"],\n                title=j[\"title\"],\n                company=j[\"company\"],\n                location=j.get(\"location\"),\n                description=j.get(\"description\"),\n                url=j[\"url\"],\n                posted_at=posted_at,\n                salary_min=j.get(\"salary_min\"),\n                salary_max=j.get(\"salary_max\"),\n                remote=bool(j.get(\"remote\")) or \"remote\" in (j.get(\"location\") or \"\").lower(),\n                crawled_at=datetime.now(timezone.utc),\n            ))\n        return out\n\n    def _filter_fixtures(\n        self, manifest: SearchManifestSchema\n    ) -> list[DiscoveredJobSchema]:\n        \"\"\"\n        Filter fixture jobs based on the search manifest.\n\n        Applies:\n          - Title matching (case-insensitive substring)\n          - Company exclusions\n          - Industry exclusions (checked against description)\n\n        Returns deterministic results for testing.\n        \"\"\"\n        results: list[DiscoveredJobSchema] = []\n        excluded_companies = {c.lower() for c in manifest.excluded_companies}\n        excluded_industries = {i.lower() for i in manifest.excluded_industries}\n        target_keywords = {kw.lower() for kw in manifest.keywords}\n        target_titles = {t.lower() for t in manifest.target_titles}\n\n        for job_data in _FALLBACK_JOBS:\n            company_lower = job_data[\"company\"].lower()\n            title_lower = job_data[\"title\"].lower()\n            desc_lower = job_data.get(\"description\", \"\").lower()\n\n            # Skip excluded companies\n            if any(exc in company_lower for exc in excluded_companies):\n                continue\n\n            # Skip excluded industries (check description)\n            if any(exc in desc_lower for exc in excluded_industries):\n                continue\n\n            # Match by title or keywords\n            title_match = any(t in title_lower for t in target_titles)\n            keyword_match = any(\n                kw in desc_lower or kw in title_lower for kw in target_keywords\n            )\n\n            if title_match or keyword_match:\n                results.append(\n                    DiscoveredJobSchema(\n                        id=uuid4(),\n                        source=job_data[\"source\"],\n                        source_id=job_data[\"source_id\"],\n                        title=job_data[\"title\"],\n                        company=job_data[\"company\"],\n                        location=job_data.get(\"location\"),\n                        description=job_data.get(\"description\"),\n                        url=job_data[\"url\"],\n                        salary_min=job_data.get(\"salary_min\"),\n                        salary_max=job_data.get(\"salary_max\"),\n                        remote=job_data.get(\"remote\", False),\n                        crawled_at=datetime.now(timezone.utc),\n                    )\n                )\n\n        return results\n\n    @staticmethod\n    def url_hash(url: str) -> str:\n        \"\"\"Deterministic hash for deduplication against the discovered_jobs table.\"\"\"\n        return hashlib.sha256(url.strip().lower().encode()).hexdigest()\n","numLines":754,"startLine":1,"totalLines":754}}}}
