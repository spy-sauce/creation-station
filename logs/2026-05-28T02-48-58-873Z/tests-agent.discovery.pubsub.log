{"t":"2026-05-28T02:56:23.734Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GUyUfv6axzpGCsxmgwNsJ3","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Discovery Orchestrator — coordinates the full daily discovery run.\n     6→\n     7→This is the entry point for both the Celery cron job and the manual API trigger.\n     8→\n     9→Flow:\n    10→  load_candidate(candidate_id)\n    11→    → identity_profiler.build_profile()\n    12→    → archetype_generator.expand()\n    13→    → crawler_agent.run(manifest)           ← currently stubbed\n    14→    → relevance_scorer.score_batch(jobs)\n    15→    → digest_builder.compile(scored_jobs)\n    16→    → emit DIGEST_READY\n    17→\n    18→Concurrency:\n    19→  - Scoring runs with bounded concurrency (CRAWL_CONCURRENCY semaphore)\n    20→  - Digest build follows after all scoring is complete\n    21→\n    22→Status machine:\n    23→  QUEUED → RUNNING → COMPLETED\n    24→                   → FAILED\n    25→\"\"\"\n    26→\n    27→import asyncio\n    28→import json\n    29→from datetime import date, datetime, timezone\n    30→from uuid import UUID\n    31→\n    32→import redis.asyncio as aioredis\n    33→import structlog\n    34→from anthropic import AsyncAnthropic\n    35→from sqlalchemy import select\n    36→from sqlalchemy.ext.asyncio import AsyncSession\n    37→\n    38→from backend.config import settings\n    39→from backend.agents.discovery.schemas import (\n    40→    CandidateSchema,\n    41→    DailyDigestSchema,\n    42→    ScoredJobSchema,\n    43→)\n    44→from backend.agents.discovery.identity_profiler import IdentityProfiler\n    45→from backend.agents.discovery.archetype_generator import ArchetypeGenerator\n    46→from backend.agents.discovery.crawler_agent import CrawlerAgent\n    47→from backend.agents.discovery.relevance_scorer import RelevanceScorer\n    48→from backend.agents.discovery.digest_builder import DigestBuilder\n    49→from backend.models.discovery import Candidate as CandidateORM, CrawlRun\n    50→\n    51→logger = structlog.get_logger(__name__)\n    52→\n    53→_STATUS_CHANNEL = \"agent.status.discovery\"\n    54→\n    55→\n    56→class DiscoveryOrchestrator:\n    57→    \"\"\"\n    58→    Coordinates the full Discovery Engine pipeline for a single candidate.\n    59→\n    60→    Designed to run once per candidate per day via Celery cron,\n    61→    or on-demand via the API trigger endpoint.\n    62→    \"\"\"\n    63→\n    64→    def __init__(self, db: AsyncSession, redis_client: aioredis.Redis):\n    65→        \"\"\"\n    66→        Initialize the DiscoveryOrchestrator.\n    67→\n    68→        Args:\n    69→            db: Async SQLAlchemy session\n    70→            redis_client: Async Redis client for caching and pub/sub\n    71→        \"\"\"\n    72→        self._db = db\n    73→        self._redis = redis_client\n    74→        self._claude = AsyncAnthropic(api_key=settings.anthropic_api_key)\n    75→\n    76→        self._profiler = IdentityProfiler(redis_client, self._claude)\n    77→        self._archetype_gen = ArchetypeGenerator()\n    78→        self._scorer = RelevanceScorer(self._claude)\n    79→        self._digest_builder = DigestBuilder(redis_client, db)\n    80→\n    81→    async def run(\n    82→        self,\n    83→        candidate_id: UUID,\n    84→        dry_run: bool = False,\n    85→    ) -> DailyDigestSchema:\n    86→        \"\"\"\n    87→        Execute a full daily discovery run for a candidate.\n    88→\n    89→        Args:\n    90→            candidate_id: UUID of the candidate to run for\n    91→            dry_run: If True, don't write to DB or publish events\n    92→\n    93→        Returns:\n    94→            DailyDigestSchema with the full ranked digest\n    95→        \"\"\"\n    96→        crawl_run = await self._start_run(candidate_id, dry_run)\n    97→        log = logger.bind(candidate_id=str(candidate_id), dry_run=dry_run)\n    98→\n    99→        try:\n   100→            # 1. Load candidate\n   101→            candidate = await self._load_candidate(candidate_id)\n   102→            log.info(\"orchestrator.candidate_loaded\", name=candidate.name)\n   103→            await self._publish_status(candidate_id, \"CANDIDATE_LOADED\")\n   104→\n   105→            # 2. Build identity profile (cached 24h)\n   106→            profile = await self._profiler.build_profile(candidate)\n   107→            log.info(\n   108→                \"orchestrator.profile_built\",\n   109→                archetypes=len(profile.archetypes),\n   110→                level=profile.leadership_level,\n   111→            )\n   112→            await self._publish_status(candidate_id, \"PROFILE_BUILT\")\n   113→\n   114→            # 3. Expand archetypes into search manifest\n   115→            excluded = {\n   116→                \"titles\": [],\n   117→                \"companies\": candidate.excluded_companies or [],\n   118→                \"industries\": candidate.excluded_industries or [],\n   119→            }\n   120→            manifest = self._archetype_gen.expand(profile, excluded)\n   121→            log.info(\n   122→                \"orchestrator.manifest_built\",\n   123→                target_titles=len(manifest.target_titles),\n   124→                keywords=len(manifest.keywords),\n   125→            )\n   126→            await self._publish_status(candidate_id, \"MANIFEST_BUILT\")\n   127→\n   128→            # 4. Crawl across all four sources\n   129→            crawler = CrawlerAgent(candidate_id)\n   130→            raw_jobs = await crawler.run(manifest)\n   131→            log.info(\"orchestrator.crawl_complete\", jobs_found=len(raw_jobs))\n   132→            await self._publish_status(candidate_id, \"CRAWL_COMPLETE\")\n   133→\n   134→            # 5. Score with bounded concurrency\n   135→            semaphore = asyncio.Semaphore(settings.crawl_concurrency)  # noqa: F841 — reserved for per-job-scoring path\n   136→\n   137→            async def score_with_semaphore(job):  # noqa: F841 — reserved for per-job-scoring path\n   138→                async with semaphore:\n   139→                    return job\n   140→\n   141→            # Fan out scoring — respect the semaphore so we don't hammer Claude\n   142→            scored_jobs = await self._scorer.score_batch(\n   143→                raw_jobs,\n   144→                profile,\n   145→                candidate_id,\n   146→                min_score=settings.min_score,\n   147→            )\n   148→            log.info(\n   149→                \"orchestrator.scoring_complete\",\n   150→                passed=len(scored_jobs),\n   151→                filtered=len(raw_jobs) - len(scored_jobs),\n   152→            )\n   153→            await self._publish_status(candidate_id, \"SCORING_COMPLETE\")\n   154→\n   155→            # 6. Build and publish digest\n   156→            if not dry_run:\n   157→                digest = await self._digest_builder.compile(\n   158→                    candidate_id=candidate_id,\n   159→                    scored_jobs=scored_jobs,\n   160→                    total_discovered=len(raw_jobs),\n   161→                )\n   162→            else:\n   163→                digest = self._build_dry_run_digest(\n   164→                    candidate_id, scored_jobs, len(raw_jobs)\n   165→                )\n   166→\n   167→            await self._complete_run(\n   168→                crawl_run, len(raw_jobs), len(scored_jobs), dry_run\n   169→            )\n   170→            log.info(\n   171→                \"orchestrator.run_complete\",\n   172→                top_picks=len(digest.top_picks),\n   173→                hot_picks=len(digest.hot_picks),\n   174→            )\n   175→            await self._publish_status(candidate_id, \"RUN_COMPLETE\")\n   176→            return digest\n   177→\n   178→        except Exception as e:\n   179→            log.error(\"orchestrator.run_failed\", error=str(e))\n   180→            await self._publish_status(candidate_id, \"RUN_FAILED\")\n   181→            await self._fail_run(crawl_run, str(e), dry_run)\n   182→            raise\n   183→\n   184→    async def _load_candidate(self, candidate_id: UUID) -> CandidateSchema:\n   185→        \"\"\"Load candidate from PostgreSQL and convert to schema.\"\"\"\n   186→        result = await self._db.execute(\n   187→            select(CandidateORM).where(CandidateORM.id == candidate_id)\n   188→        )\n   189→        orm = result.scalar_one_or_none()\n   190→        if not orm:\n   191→            raise ValueError(f\"Candidate {candidate_id} not found\")\n   192→        return CandidateSchema.model_validate(orm)\n   193→\n   194→    async def _start_run(self, candidate_id: UUID, dry_run: bool) -> CrawlRun | None:\n   195→        \"\"\"Create a CrawlRun record and return it (None in dry_run mode).\"\"\"\n   196→        if dry_run:\n   197→            return None\n   198→        run = CrawlRun(candidate_id=candidate_id, status=\"RUNNING\")\n   199→        self._db.add(run)\n   200→        await self._db.commit()\n   201→        await self._db.refresh(run)\n   202→        return run\n   203→\n   204→    async def _complete_run(\n   205→        self, run: CrawlRun | None, discovered: int, scored: int, dry_run: bool\n   206→    ) -> None:\n   207→        \"\"\"Mark the CrawlRun as COMPLETED.\"\"\"\n   208→        if dry_run or run is None:\n   209→            return\n   210→        run.status = \"COMPLETED\"\n   211→        run.completed_at = datetime.now(timezone.utc)\n   212→        run.jobs_discovered = discovered\n   213→        run.jobs_scored = scored\n   214→        await self._db.commit()\n   215→\n   216→    async def _fail_run(\n   217→        self, run: CrawlRun | None, error: str, dry_run: bool\n   218→    ) -> None:\n   219→        \"\"\"Mark the CrawlRun as FAILED with error log.\"\"\"\n   220→        if dry_run or run is None:\n   221→            return\n   222→        run.status = \"FAILED\"\n   223→        run.completed_at = datetime.now(timezone.utc)\n   224→        run.error_log = error\n   225→        await self._db.commit()\n   226→\n   227→    def _build_dry_run_digest(\n   228→        self,\n   229→        candidate_id: UUID,\n   230→        scored_jobs: list[ScoredJobSchema],\n   231→        total_discovered: int,\n   232→    ) -> DailyDigestSchema:\n   233→        \"\"\"Build an in-memory digest without DB writes — for dry_run mode.\"\"\"\n   234→        return DailyDigestSchema(\n   235→            candidate_id=candidate_id,\n   236→            run_date=date.today().isoformat(),\n   237→            total_jobs_discovered=total_discovered,\n   238→            total_jobs_scored=len(scored_jobs),\n   239→            top_picks=[],\n   240→            hot_picks=[],\n   241→            new_companies=[],\n   242→        )\n   243→\n   244→    async def _publish_status(self, candidate_id: UUID, status: str) -> None:\n   245→        \"\"\"Publish discovery pipeline status event to Redis pub/sub.\"\"\"\n   246→        payload = json.dumps(\n   247→            {\n   248→                \"event\": \"DISCOVERY_STATUS\",\n   249→                \"candidate_id\": str(candidate_id),\n   250→                \"status\": status,\n   251→            }\n   252→        )\n   253→        await self._redis.publish(_STATUS_CHANNEL, payload)\n   254→        logger.info(\n   255→            \"orchestrator.status_published\",\n   256→            channel=_STATUS_CHANNEL,\n   257→            status=status,\n   258→        )\n   259→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"f2750489-d8d6-41f5-b42f-4d2a4cab3a05","uuid":"05ce2913-5931-43ab-ad18-c2d07f8e31be","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/agents/discovery/orchestrator.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nDiscovery Orchestrator — coordinates the full daily discovery run.\n\nThis is the entry point for both the Celery cron job and the manual API trigger.\n\nFlow:\n  load_candidate(candidate_id)\n    → identity_profiler.build_profile()\n    → archetype_generator.expand()\n    → crawler_agent.run(manifest)           ← currently stubbed\n    → relevance_scorer.score_batch(jobs)\n    → digest_builder.compile(scored_jobs)\n    → emit DIGEST_READY\n\nConcurrency:\n  - Scoring runs with bounded concurrency (CRAWL_CONCURRENCY semaphore)\n  - Digest build follows after all scoring is complete\n\nStatus machine:\n  QUEUED → RUNNING → COMPLETED\n                   → FAILED\n\"\"\"\n\nimport asyncio\nimport json\nfrom datetime import date, datetime, timezone\nfrom uuid import UUID\n\nimport redis.asyncio as aioredis\nimport structlog\nfrom anthropic import AsyncAnthropic\nfrom sqlalchemy import select\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom backend.config import settings\nfrom backend.agents.discovery.schemas import (\n    CandidateSchema,\n    DailyDigestSchema,\n    ScoredJobSchema,\n)\nfrom backend.agents.discovery.identity_profiler import IdentityProfiler\nfrom backend.agents.discovery.archetype_generator import ArchetypeGenerator\nfrom backend.agents.discovery.crawler_agent import CrawlerAgent\nfrom backend.agents.discovery.relevance_scorer import RelevanceScorer\nfrom backend.agents.discovery.digest_builder import DigestBuilder\nfrom backend.models.discovery import Candidate as CandidateORM, CrawlRun\n\nlogger = structlog.get_logger(__name__)\n\n_STATUS_CHANNEL = \"agent.status.discovery\"\n\n\nclass DiscoveryOrchestrator:\n    \"\"\"\n    Coordinates the full Discovery Engine pipeline for a single candidate.\n\n    Designed to run once per candidate per day via Celery cron,\n    or on-demand via the API trigger endpoint.\n    \"\"\"\n\n    def __init__(self, db: AsyncSession, redis_client: aioredis.Redis):\n        \"\"\"\n        Initialize the DiscoveryOrchestrator.\n\n        Args:\n            db: Async SQLAlchemy session\n            redis_client: Async Redis client for caching and pub/sub\n        \"\"\"\n        self._db = db\n        self._redis = redis_client\n        self._claude = AsyncAnthropic(api_key=settings.anthropic_api_key)\n\n        self._profiler = IdentityProfiler(redis_client, self._claude)\n        self._archetype_gen = ArchetypeGenerator()\n        self._scorer = RelevanceScorer(self._claude)\n        self._digest_builder = DigestBuilder(redis_client, db)\n\n    async def run(\n        self,\n        candidate_id: UUID,\n        dry_run: bool = False,\n    ) -> DailyDigestSchema:\n        \"\"\"\n        Execute a full daily discovery run for a candidate.\n\n        Args:\n            candidate_id: UUID of the candidate to run for\n            dry_run: If True, don't write to DB or publish events\n\n        Returns:\n            DailyDigestSchema with the full ranked digest\n        \"\"\"\n        crawl_run = await self._start_run(candidate_id, dry_run)\n        log = logger.bind(candidate_id=str(candidate_id), dry_run=dry_run)\n\n        try:\n            # 1. Load candidate\n            candidate = await self._load_candidate(candidate_id)\n            log.info(\"orchestrator.candidate_loaded\", name=candidate.name)\n            await self._publish_status(candidate_id, \"CANDIDATE_LOADED\")\n\n            # 2. Build identity profile (cached 24h)\n            profile = await self._profiler.build_profile(candidate)\n            log.info(\n                \"orchestrator.profile_built\",\n                archetypes=len(profile.archetypes),\n                level=profile.leadership_level,\n            )\n            await self._publish_status(candidate_id, \"PROFILE_BUILT\")\n\n            # 3. Expand archetypes into search manifest\n            excluded = {\n                \"titles\": [],\n                \"companies\": candidate.excluded_companies or [],\n                \"industries\": candidate.excluded_industries or [],\n            }\n            manifest = self._archetype_gen.expand(profile, excluded)\n            log.info(\n                \"orchestrator.manifest_built\",\n                target_titles=len(manifest.target_titles),\n                keywords=len(manifest.keywords),\n            )\n            await self._publish_status(candidate_id, \"MANIFEST_BUILT\")\n\n            # 4. Crawl across all four sources\n            crawler = CrawlerAgent(candidate_id)\n            raw_jobs = await crawler.run(manifest)\n            log.info(\"orchestrator.crawl_complete\", jobs_found=len(raw_jobs))\n            await self._publish_status(candidate_id, \"CRAWL_COMPLETE\")\n\n            # 5. Score with bounded concurrency\n            semaphore = asyncio.Semaphore(settings.crawl_concurrency)  # noqa: F841 — reserved for per-job-scoring path\n\n            async def score_with_semaphore(job):  # noqa: F841 — reserved for per-job-scoring path\n                async with semaphore:\n                    return job\n\n            # Fan out scoring — respect the semaphore so we don't hammer Claude\n            scored_jobs = await self._scorer.score_batch(\n                raw_jobs,\n                profile,\n                candidate_id,\n                min_score=settings.min_score,\n            )\n            log.info(\n                \"orchestrator.scoring_complete\",\n                passed=len(scored_jobs),\n                filtered=len(raw_jobs) - len(scored_jobs),\n            )\n            await self._publish_status(candidate_id, \"SCORING_COMPLETE\")\n\n            # 6. Build and publish digest\n            if not dry_run:\n                digest = await self._digest_builder.compile(\n                    candidate_id=candidate_id,\n                    scored_jobs=scored_jobs,\n                    total_discovered=len(raw_jobs),\n                )\n            else:\n                digest = self._build_dry_run_digest(\n                    candidate_id, scored_jobs, len(raw_jobs)\n                )\n\n            await self._complete_run(\n                crawl_run, len(raw_jobs), len(scored_jobs), dry_run\n            )\n            log.info(\n                \"orchestrator.run_complete\",\n                top_picks=len(digest.top_picks),\n                hot_picks=len(digest.hot_picks),\n            )\n            await self._publish_status(candidate_id, \"RUN_COMPLETE\")\n            return digest\n\n        except Exception as e:\n            log.error(\"orchestrator.run_failed\", error=str(e))\n            await self._publish_status(candidate_id, \"RUN_FAILED\")\n            await self._fail_run(crawl_run, str(e), dry_run)\n            raise\n\n    async def _load_candidate(self, candidate_id: UUID) -> CandidateSchema:\n        \"\"\"Load candidate from PostgreSQL and convert to schema.\"\"\"\n        result = await self._db.execute(\n            select(CandidateORM).where(CandidateORM.id == candidate_id)\n        )\n        orm = result.scalar_one_or_none()\n        if not orm:\n            raise ValueError(f\"Candidate {candidate_id} not found\")\n        return CandidateSchema.model_validate(orm)\n\n    async def _start_run(self, candidate_id: UUID, dry_run: bool) -> CrawlRun | None:\n        \"\"\"Create a CrawlRun record and return it (None in dry_run mode).\"\"\"\n        if dry_run:\n            return None\n        run = CrawlRun(candidate_id=candidate_id, status=\"RUNNING\")\n        self._db.add(run)\n        await self._db.commit()\n        await self._db.refresh(run)\n        return run\n\n    async def _complete_run(\n        self, run: CrawlRun | None, discovered: int, scored: int, dry_run: bool\n    ) -> None:\n        \"\"\"Mark the CrawlRun as COMPLETED.\"\"\"\n        if dry_run or run is None:\n            return\n        run.status = \"COMPLETED\"\n        run.completed_at = datetime.now(timezone.utc)\n        run.jobs_discovered = discovered\n        run.jobs_scored = scored\n        await self._db.commit()\n\n    async def _fail_run(\n        self, run: CrawlRun | None, error: str, dry_run: bool\n    ) -> None:\n        \"\"\"Mark the CrawlRun as FAILED with error log.\"\"\"\n        if dry_run or run is None:\n            return\n        run.status = \"FAILED\"\n        run.completed_at = datetime.now(timezone.utc)\n        run.error_log = error\n        await self._db.commit()\n\n    def _build_dry_run_digest(\n        self,\n        candidate_id: UUID,\n        scored_jobs: list[ScoredJobSchema],\n        total_discovered: int,\n    ) -> DailyDigestSchema:\n        \"\"\"Build an in-memory digest without DB writes — for dry_run mode.\"\"\"\n        return DailyDigestSchema(\n            candidate_id=candidate_id,\n            run_date=date.today().isoformat(),\n            total_jobs_discovered=total_discovered,\n            total_jobs_scored=len(scored_jobs),\n            top_picks=[],\n            hot_picks=[],\n            new_companies=[],\n        )\n\n    async def _publish_status(self, candidate_id: UUID, status: str) -> None:\n        \"\"\"Publish discovery pipeline status event to Redis pub/sub.\"\"\"\n        payload = json.dumps(\n            {\n                \"event\": \"DISCOVERY_STATUS\",\n                \"candidate_id\": str(candidate_id),\n                \"status\": status,\n            }\n        )\n        await self._redis.publish(_STATUS_CHANNEL, payload)\n        logger.info(\n            \"orchestrator.status_published\",\n            channel=_STATUS_CHANNEL,\n            status=status,\n        )\n","numLines":259,"startLine":1,"totalLines":259}}}}
