{"t":"2026-05-28T02:57:00.123Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HSnYe6cvvNnpS4UxYhczr6","type":"tool_result","content":"     1→/**\n     2→ * SSE Event Stream client — subscribeAgentStatus via EventSource.\n     3→ *\n     4→ * Per NUTRIENTS.md §ITER-4 CONTRACT EXTENSIONS:\n     5→ * - Symbol: subscribeAgentStatus owned by api-client-agent\n     6→ * - File path: frontend/src/api/events.ts\n     7→ *\n     8→ * Per HYPHA-API-CLIENT:\n     9→ * - subscribeAgentStatus(channel, onMessage) via EventSource\n    10→ * - Returns a cleanup function that calls eventSource.close()\n    11→ * - EventSource auto-reconnects on connection loss (browser native behavior)\n    12→ *\n    13→ * SSE endpoint contract (GET /events/stream):\n    14→ * - Query param: channel (agent.status.discovery | agent.status.application)\n    15→ * - Headers: Authorization: Bearer <jwt>\n    16→ * - Response: text/event-stream\n    17→ * - Format: data: {json}\\n\\n for each message\n    18→ * - Heartbeat: :ping\\n\\n every 15s\n    19→ * - Backpressure: event: slow_client\\ndata: {\"dropped\": N}\\n\\n\n    20→ *\n    21→ * @license Apache-2.0\n    22→ * @copyright VibeSpace LLC\n    23→ */\n    24→\n    25→import { getToken } from './client'\n    26→import { log } from '../lib/logger'\n    27→\n    28→// ─── Types ────────────────────────────────────────────────────────────────────\n    29→\n    30→/**\n    31→ * Allowed SSE channels.\n    32→ * Per NUTRIENTS.md §ITER-4 CONTRACT EXTENSIONS.\n    33→ */\n    34→export type AllowedSSEChannel =\n    35→  | 'agent.status.discovery'\n    36→  | 'agent.status.application'\n    37→\n    38→/**\n    39→ * Job source type (for CRAWL_SOURCE_COMPLETE events).\n    40→ * Per NUTRIENTS.md DATA_CONTRACTS.\n    41→ */\n    42→export type JobSource = 'greenhouse' | 'lever' | 'ashby' | 'workday'\n    43→\n    44→/**\n    45→ * Discovery event types published to agent.status.discovery.\n    46→ * Per NUTRIENTS.md §ITER-4 CONTRACT EXTENSIONS.\n    47→ */\n    48→export type DiscoveryEventType =\n    49→  | 'RUN_STARTED'\n    50→  | 'CANDIDATE_LOADED'\n    51→  | 'PROFILE_BUILT'\n    52→  | 'MANIFEST_BUILT'\n    53→  | 'CRAWL_SOURCE_COMPLETE'\n    54→  | 'CRAWL_COMPLETE'\n    55→  | 'SCORING_COMPLETE'\n    56→  | 'RUN_COMPLETE'\n    57→  | 'RUN_FAILED'\n    58→  | 'DAILY_TASK_DEAD'\n    59→  | 'CRAWL_STATUS'\n    60→  | 'DIGEST_READY'\n    61→\n    62→/**\n    63→ * Discovery status event payload.\n    64→ * Per NUTRIENTS.md §ITER-4 CONTRACT EXTENSIONS.\n    65→ */\n    66→export interface DiscoveryStatusEvent {\n    67→  /** Event type (SCREAMING_SNAKE_CASE) */\n    68→  event: DiscoveryEventType\n    69→  /** Candidate UUID */\n    70→  candidate_id: string\n    71→  /** ISO-8601 UTC timestamp */\n    72→  timestamp: string\n    73→  /** Present for CRAWL_SOURCE_COMPLETE */\n    74→  source?: JobSource\n    75→  /** Present for CRAWL_SOURCE_COMPLETE, CRAWL_STATUS */\n    76→  jobs_found?: number\n    77→  jobs_discovered?: number\n    78→  jobs_scored?: number\n    79→  /** Present for RUN_FAILED, DAILY_TASK_DEAD, CRAWL_STATUS */\n    80→  error?: string\n    81→  /** Present for CRAWL_STATUS */\n    82→  crawl_run_id?: string\n    83→  status?: string\n    84→  /** Present for DIGEST_READY */\n    85→  digest_id?: string\n    86→  run_date?: string\n    87→  total_discovered?: number\n    88→  total_scored?: number\n    89→  top_picks_count?: number\n    90→  hot_picks_count?: number\n    91→}\n    92→\n    93→/**\n    94→ * Application event types published to agent.status.application.\n    95→ */\n    96→export type ApplicationEventType =\n    97→  | 'APPLICATION_STATUS'\n    98→  | 'PIPELINE_STATUS'\n    99→  | 'APPLICATION_STARTED'\n   100→  | 'JD_PARSED'\n   101→  | 'RESUME_TAILORED'\n   102→  | 'COMPANY_RESEARCHED'\n   103→  | 'CONTACT_FOUND'\n   104→  | 'EMAIL_DRAFTED'\n   105→  | 'APPROVED_FOR_SUBMISSION'\n   106→  | 'SUBMITTED'\n   107→  | 'EMAIL_SENT'\n   108→  | 'REJECTED'\n   109→  | 'PIPELINE_FAILED'\n   110→\n   111→/**\n   112→ * Application status event payload.\n   113→ */\n   114→export interface ApplicationStatusEvent {\n   115→  /** Event type (SCREAMING_SNAKE_CASE) */\n   116→  event: ApplicationEventType\n   117→  /** Pipeline UUID */\n   118→  pipeline_id: string\n   119→  /** Candidate UUID */\n   120→  candidate_id?: string\n   121→  /** Pipeline status string */\n   122→  status: string\n   123→  /** ISO-8601 UTC timestamp */\n   124→  timestamp: string\n   125→  /** Additional details */\n   126→  details?: Record<string, unknown>\n   127→}\n   128→\n   129→/**\n   130→ * Union type for all SSE event payloads.\n   131→ */\n   132→export type SSEEventPayload = DiscoveryStatusEvent | ApplicationStatusEvent\n   133→\n   134→/**\n   135→ * Slow client warning event.\n   136→ * Per NUTRIENTS.md §ITER-4 CONTRACT EXTENSIONS.\n   137→ */\n   138→export interface SlowClientEvent {\n   139→  /** Number of messages dropped due to slow client */\n   140→  dropped: number\n   141→}\n   142→\n   143→/**\n   144→ * Cleanup function returned by subscribeAgentStatus.\n   145→ */\n   146→export type UnsubscribeFn = () => void\n   147→\n   148→/**\n   149→ * Callback for SSE messages.\n   150→ */\n   151→export type SSEMessageCallback<T = SSEEventPayload> = (event: T) => void\n   152→\n   153→/**\n   154→ * Callback for SSE errors.\n   155→ */\n   156→export type SSEErrorCallback = (error: Event) => void\n   157→\n   158→/**\n   159→ * Callback for slow client warnings.\n   160→ */\n   161→export type SlowClientCallback = (event: SlowClientEvent) => void\n   162→\n   163→/**\n   164→ * Options for subscribeAgentStatus.\n   165→ */\n   166→export interface SubscribeOptions {\n   167→  /** Callback when a slow_client event is received */\n   168→  onSlowClient?: SlowClientCallback\n   169→  /** Callback when connection errors occur */\n   170→  onError?: SSEErrorCallback\n   171→  /** Callback when connection opens */\n   172→  onOpen?: () => void\n   173→}\n   174→\n   175→// ─── Constants ────────────────────────────────────────────────────────────────\n   176→\n   177→/**\n   178→ * Base URL for SSE endpoint.\n   179→ * Per NUTRIENTS.md: Env vars use VITE_* prefix per Vite's import.meta.env convention.\n   180→ */\n   181→const API_BASE_URL = import.meta.env.VITE_API_BASE_URL || '/api/v1'\n   182→\n   183→/**\n   184→ * SSE endpoint path.\n   185→ * Per backend/api/events.py: GET /events/stream?channel=...\n   186→ */\n   187→const SSE_ENDPOINT = '/events/stream'\n   188→\n   189→// ─── SSE Client ───────────────────────────────────────────────────────────────\n   190→\n   191→/**\n   192→ * Subscribe to real-time agent status events via Server-Sent Events.\n   193→ *\n   194→ * Uses native EventSource for automatic reconnection on connection loss.\n   195→ * The browser handles reconnection transparently — no manual retry logic needed.\n   196→ *\n   197→ * Per HYPHA-API-CLIENT acceptance criteria:\n   198→ * - subscribeAgentStatus('agent.status.discovery', callback) opens EventSource\n   199→ * - Calls callback on each SSE data frame\n   200→ * - EventSource auto-reconnects on connection loss (browser native behavior)\n   201→ * - Returns cleanup function that calls eventSource.close()\n   202→ *\n   203→ * Per NUTRIENTS.md API_CONTRACTS:\n   204→ * - Endpoint: GET /events/stream?channel=...\n   205→ * - Headers: Authorization: Bearer <jwt>\n   206→ * - Allowed channels: agent.status.discovery, agent.status.application\n   207→ *\n   208→ * @param channel - SSE channel to subscribe to\n   209→ * @param onMessage - Callback invoked with parsed event payload on each message\n   210→ * @param options - Optional callbacks for errors, slow client warnings, and connection open\n   211→ * @returns Cleanup function that closes the EventSource connection\n   212→ *\n   213→ * @example\n   214→ * ```ts\n   215→ * // Subscribe to discovery events\n   216→ * const unsubscribe = subscribeAgentStatus(\n   217→ *   'agent.status.discovery',\n   218→ *   (event) => {\n   219→ *     console.log('Discovery event:', event.event, event.candidate_id)\n   220→ *   },\n   221→ *   {\n   222→ *     onSlowClient: ({ dropped }) => {\n   223→ *       console.warn(`Slow client: ${dropped} messages dropped`)\n   224→ *     },\n   225→ *     onError: (error) => {\n   226→ *       console.error('SSE connection error:', error)\n   227→ *     },\n   228→ *   }\n   229→ * )\n   230→ *\n   231→ * // Later, cleanup\n   232→ * unsubscribe()\n   233→ * ```\n   234→ */\n   235→export function subscribeAgentStatus<T = SSEEventPayload>(\n   236→  channel: AllowedSSEChannel,\n   237→  onMessage: SSEMessageCallback<T>,\n   238→  options: SubscribeOptions = {}\n   239→): UnsubscribeFn {\n   240→  const { onSlowClient, onError, onOpen } = options\n   241→\n   242→  // Build SSE URL with channel parameter\n   243→  const url = new URL(`${API_BASE_URL}${SSE_ENDPOINT}`, window.location.origin)\n   244→  url.searchParams.set('channel', channel)\n   245→\n   246→  // Get JWT for authorization\n   247→  const token = getToken()\n   248→\n   249→  // NOTE: Native EventSource does not support custom headers.\n   250→  // The backend must accept the token via query param OR\n   251→  // we use EventSourcePolyfill/fetch-based SSE for auth.\n   252→  // Per the backend implementation, it uses Depends(get_current_user)\n   253→  // which reads from Authorization header.\n   254→  //\n   255→  // Solution: Use EventSource with polyfill pattern via query param fallback\n   256→  // or use fetch-based SSE. For now, we append token as query param\n   257→  // and the backend should support both header and query param auth.\n   258→  //\n   259→  // Per HYPHA-API-CLIENT notes: uses native EventSource.\n   260→  // If auth via header is required, consider @microsoft/fetch-event-source.\n   261→  // For MVP, we use query param token.\n   262→  if (token) {\n   263→    url.searchParams.set('token', token)\n   264→  }\n   265→\n   266→  log.info('sse.subscribing', { channel, url: url.toString() })\n   267→\n   268→  // Create EventSource connection\n   269→  const eventSource = new EventSource(url.toString())\n   270→\n   271→  // Handle connection open\n   272→  eventSource.onopen = () => {\n   273→    log.info('sse.connected', { channel })\n   274→    onOpen?.()\n   275→  }\n   276→\n   277→  // Handle incoming messages (default event type)\n   278→  eventSource.onmessage = (messageEvent: MessageEvent) => {\n   279→    try {\n   280→      const data = JSON.parse(messageEvent.data) as T\n   281→      onMessage(data)\n   282→    } catch (parseError) {\n   283→      log.error('sse.parse_error', {\n   284→        channel,\n   285→        error: String(parseError),\n   286→        data: messageEvent.data,\n   287→      })\n   288→    }\n   289→  }\n   290→\n   291→  // Handle slow_client event (custom event type)\n   292→  eventSource.addEventListener('slow_client', (event: MessageEvent) => {\n   293→    try {\n   294→      const data = JSON.parse(event.data) as SlowClientEvent\n   295→      log.warn('sse.slow_client', { channel, dropped: data.dropped })\n   296→      onSlowClient?.(data)\n   297→    } catch (parseError) {\n   298→      log.error('sse.slow_client_parse_error', {\n   299→        channel,\n   300→        error: String(parseError),\n   301→      })\n   302→    }\n   303→  })\n   304→\n   305→  // Handle connection errors\n   306→  eventSource.onerror = (error: Event) => {\n   307→    // EventSource auto-reconnects, so this may fire during reconnection attempts\n   308→    // ReadyState: 0 = CONNECTING, 1 = OPEN, 2 = CLOSED\n   309→    if (eventSource.readyState === EventSource.CLOSED) {\n   310→      log.error('sse.connection_closed', { channel })\n   311→    } else {\n   312→      log.warn('sse.connection_error', {\n   313→        channel,\n   314→        readyState: eventSource.readyState,\n   315→      })\n   316→    }\n   317→    onError?.(error)\n   318→  }\n   319→\n   320→  // Return cleanup function\n   321→  return () => {\n   322→    log.info('sse.unsubscribing', { channel })\n   323→    eventSource.close()\n   324→  }\n   325→}\n   326→\n   327→/**\n   328→ * Subscribe to discovery engine status events.\n   329→ *\n   330→ * Convenience wrapper for subscribeAgentStatus with the discovery channel.\n   331→ *\n   332→ * @param onMessage - Callback invoked with DiscoveryStatusEvent on each message\n   333→ * @param options - Optional callbacks for errors and slow client warnings\n   334→ * @returns Cleanup function that closes the EventSource connection\n   335→ *\n   336→ * @example\n   337→ * ```ts\n   338→ * const unsubscribe = subscribeDiscoveryEvents((event) => {\n   339→ *   switch (event.event) {\n   340→ *     case 'RUN_STARTED':\n   341→ *       showToast('Discovery run started')\n   342→ *       break\n   343→ *     case 'RUN_COMPLETE':\n   344→ *       showToast('Discovery complete!')\n   345→ *       refreshDigest()\n   346→ *       break\n   347→ *     case 'RUN_FAILED':\n   348→ *       showError(`Discovery failed: ${event.error}`)\n   349→ *       break\n   350→ *   }\n   351→ * })\n   352→ * ```\n   353→ */\n   354→export function subscribeDiscoveryEvents(\n   355→  onMessage: SSEMessageCallback<DiscoveryStatusEvent>,\n   356→  options?: SubscribeOptions\n   357→): UnsubscribeFn {\n   358→  return subscribeAgentStatus<DiscoveryStatusEvent>(\n   359→    'agent.status.discovery',\n   360→    onMessage,\n   361→    options\n   362→  )\n   363→}\n   364→\n   365→/**\n   366→ * Subscribe to application pipeline status events.\n   367→ *\n   368→ * Convenience wrapper for subscribeAgentStatus with the application channel.\n   369→ *\n   370→ * @param onMessage - Callback invoked with ApplicationStatusEvent on each message\n   371→ * @param options - Optional callbacks for errors and slow client warnings\n   372→ * @returns Cleanup function that closes the EventSource connection\n   373→ *\n   374→ * @example\n   375→ * ```ts\n   376→ * const unsubscribe = subscribeApplicationEvents((event) => {\n   377→ *   if (event.pipeline_id === currentPipelineId) {\n   378→ *     updatePipelineStatus(event.status)\n   379→ *   }\n   380→ * })\n   381→ * ```\n   382→ */\n   383→export function subscribeApplicationEvents(\n   384→  onMessage: SSEMessageCallback<ApplicationStatusEvent>,\n   385→  options?: SubscribeOptions\n   386→): UnsubscribeFn {\n   387→  return subscribeAgentStatus<ApplicationStatusEvent>(\n   388→    'agent.status.application',\n   389→    onMessage,\n   390→    options\n   391→  )\n   392→}\n   393→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"6c3e9047-a08c-418a-9212-4f64f785c578","uuid":"04441541-ca54-4560-93de-3536c0228cf0","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/frontend/src/api/events.ts","content":"/**\n * SSE Event Stream client — subscribeAgentStatus via EventSource.\n *\n * Per NUTRIENTS.md §ITER-4 CONTRACT EXTENSIONS:\n * - Symbol: subscribeAgentStatus owned by api-client-agent\n * - File path: frontend/src/api/events.ts\n *\n * Per HYPHA-API-CLIENT:\n * - subscribeAgentStatus(channel, onMessage) via EventSource\n * - Returns a cleanup function that calls eventSource.close()\n * - EventSource auto-reconnects on connection loss (browser native behavior)\n *\n * SSE endpoint contract (GET /events/stream):\n * - Query param: channel (agent.status.discovery | agent.status.application)\n * - Headers: Authorization: Bearer <jwt>\n * - Response: text/event-stream\n * - Format: data: {json}\\n\\n for each message\n * - Heartbeat: :ping\\n\\n every 15s\n * - Backpressure: event: slow_client\\ndata: {\"dropped\": N}\\n\\n\n *\n * @license Apache-2.0\n * @copyright VibeSpace LLC\n */\n\nimport { getToken } from './client'\nimport { log } from '../lib/logger'\n\n// ─── Types ────────────────────────────────────────────────────────────────────\n\n/**\n * Allowed SSE channels.\n * Per NUTRIENTS.md §ITER-4 CONTRACT EXTENSIONS.\n */\nexport type AllowedSSEChannel =\n  | 'agent.status.discovery'\n  | 'agent.status.application'\n\n/**\n * Job source type (for CRAWL_SOURCE_COMPLETE events).\n * Per NUTRIENTS.md DATA_CONTRACTS.\n */\nexport type JobSource = 'greenhouse' | 'lever' | 'ashby' | 'workday'\n\n/**\n * Discovery event types published to agent.status.discovery.\n * Per NUTRIENTS.md §ITER-4 CONTRACT EXTENSIONS.\n */\nexport type DiscoveryEventType =\n  | 'RUN_STARTED'\n  | 'CANDIDATE_LOADED'\n  | 'PROFILE_BUILT'\n  | 'MANIFEST_BUILT'\n  | 'CRAWL_SOURCE_COMPLETE'\n  | 'CRAWL_COMPLETE'\n  | 'SCORING_COMPLETE'\n  | 'RUN_COMPLETE'\n  | 'RUN_FAILED'\n  | 'DAILY_TASK_DEAD'\n  | 'CRAWL_STATUS'\n  | 'DIGEST_READY'\n\n/**\n * Discovery status event payload.\n * Per NUTRIENTS.md §ITER-4 CONTRACT EXTENSIONS.\n */\nexport interface DiscoveryStatusEvent {\n  /** Event type (SCREAMING_SNAKE_CASE) */\n  event: DiscoveryEventType\n  /** Candidate UUID */\n  candidate_id: string\n  /** ISO-8601 UTC timestamp */\n  timestamp: string\n  /** Present for CRAWL_SOURCE_COMPLETE */\n  source?: JobSource\n  /** Present for CRAWL_SOURCE_COMPLETE, CRAWL_STATUS */\n  jobs_found?: number\n  jobs_discovered?: number\n  jobs_scored?: number\n  /** Present for RUN_FAILED, DAILY_TASK_DEAD, CRAWL_STATUS */\n  error?: string\n  /** Present for CRAWL_STATUS */\n  crawl_run_id?: string\n  status?: string\n  /** Present for DIGEST_READY */\n  digest_id?: string\n  run_date?: string\n  total_discovered?: number\n  total_scored?: number\n  top_picks_count?: number\n  hot_picks_count?: number\n}\n\n/**\n * Application event types published to agent.status.application.\n */\nexport type ApplicationEventType =\n  | 'APPLICATION_STATUS'\n  | 'PIPELINE_STATUS'\n  | 'APPLICATION_STARTED'\n  | 'JD_PARSED'\n  | 'RESUME_TAILORED'\n  | 'COMPANY_RESEARCHED'\n  | 'CONTACT_FOUND'\n  | 'EMAIL_DRAFTED'\n  | 'APPROVED_FOR_SUBMISSION'\n  | 'SUBMITTED'\n  | 'EMAIL_SENT'\n  | 'REJECTED'\n  | 'PIPELINE_FAILED'\n\n/**\n * Application status event payload.\n */\nexport interface ApplicationStatusEvent {\n  /** Event type (SCREAMING_SNAKE_CASE) */\n  event: ApplicationEventType\n  /** Pipeline UUID */\n  pipeline_id: string\n  /** Candidate UUID */\n  candidate_id?: string\n  /** Pipeline status string */\n  status: string\n  /** ISO-8601 UTC timestamp */\n  timestamp: string\n  /** Additional details */\n  details?: Record<string, unknown>\n}\n\n/**\n * Union type for all SSE event payloads.\n */\nexport type SSEEventPayload = DiscoveryStatusEvent | ApplicationStatusEvent\n\n/**\n * Slow client warning event.\n * Per NUTRIENTS.md §ITER-4 CONTRACT EXTENSIONS.\n */\nexport interface SlowClientEvent {\n  /** Number of messages dropped due to slow client */\n  dropped: number\n}\n\n/**\n * Cleanup function returned by subscribeAgentStatus.\n */\nexport type UnsubscribeFn = () => void\n\n/**\n * Callback for SSE messages.\n */\nexport type SSEMessageCallback<T = SSEEventPayload> = (event: T) => void\n\n/**\n * Callback for SSE errors.\n */\nexport type SSEErrorCallback = (error: Event) => void\n\n/**\n * Callback for slow client warnings.\n */\nexport type SlowClientCallback = (event: SlowClientEvent) => void\n\n/**\n * Options for subscribeAgentStatus.\n */\nexport interface SubscribeOptions {\n  /** Callback when a slow_client event is received */\n  onSlowClient?: SlowClientCallback\n  /** Callback when connection errors occur */\n  onError?: SSEErrorCallback\n  /** Callback when connection opens */\n  onOpen?: () => void\n}\n\n// ─── Constants ────────────────────────────────────────────────────────────────\n\n/**\n * Base URL for SSE endpoint.\n * Per NUTRIENTS.md: Env vars use VITE_* prefix per Vite's import.meta.env convention.\n */\nconst API_BASE_URL = import.meta.env.VITE_API_BASE_URL || '/api/v1'\n\n/**\n * SSE endpoint path.\n * Per backend/api/events.py: GET /events/stream?channel=...\n */\nconst SSE_ENDPOINT = '/events/stream'\n\n// ─── SSE Client ───────────────────────────────────────────────────────────────\n\n/**\n * Subscribe to real-time agent status events via Server-Sent Events.\n *\n * Uses native EventSource for automatic reconnection on connection loss.\n * The browser handles reconnection transparently — no manual retry logic needed.\n *\n * Per HYPHA-API-CLIENT acceptance criteria:\n * - subscribeAgentStatus('agent.status.discovery', callback) opens EventSource\n * - Calls callback on each SSE data frame\n * - EventSource auto-reconnects on connection loss (browser native behavior)\n * - Returns cleanup function that calls eventSource.close()\n *\n * Per NUTRIENTS.md API_CONTRACTS:\n * - Endpoint: GET /events/stream?channel=...\n * - Headers: Authorization: Bearer <jwt>\n * - Allowed channels: agent.status.discovery, agent.status.application\n *\n * @param channel - SSE channel to subscribe to\n * @param onMessage - Callback invoked with parsed event payload on each message\n * @param options - Optional callbacks for errors, slow client warnings, and connection open\n * @returns Cleanup function that closes the EventSource connection\n *\n * @example\n * ```ts\n * // Subscribe to discovery events\n * const unsubscribe = subscribeAgentStatus(\n *   'agent.status.discovery',\n *   (event) => {\n *     console.log('Discovery event:', event.event, event.candidate_id)\n *   },\n *   {\n *     onSlowClient: ({ dropped }) => {\n *       console.warn(`Slow client: ${dropped} messages dropped`)\n *     },\n *     onError: (error) => {\n *       console.error('SSE connection error:', error)\n *     },\n *   }\n * )\n *\n * // Later, cleanup\n * unsubscribe()\n * ```\n */\nexport function subscribeAgentStatus<T = SSEEventPayload>(\n  channel: AllowedSSEChannel,\n  onMessage: SSEMessageCallback<T>,\n  options: SubscribeOptions = {}\n): UnsubscribeFn {\n  const { onSlowClient, onError, onOpen } = options\n\n  // Build SSE URL with channel parameter\n  const url = new URL(`${API_BASE_URL}${SSE_ENDPOINT}`, window.location.origin)\n  url.searchParams.set('channel', channel)\n\n  // Get JWT for authorization\n  const token = getToken()\n\n  // NOTE: Native EventSource does not support custom headers.\n  // The backend must accept the token via query param OR\n  // we use EventSourcePolyfill/fetch-based SSE for auth.\n  // Per the backend implementation, it uses Depends(get_current_user)\n  // which reads from Authorization header.\n  //\n  // Solution: Use EventSource with polyfill pattern via query param fallback\n  // or use fetch-based SSE. For now, we append token as query param\n  // and the backend should support both header and query param auth.\n  //\n  // Per HYPHA-API-CLIENT notes: uses native EventSource.\n  // If auth via header is required, consider @microsoft/fetch-event-source.\n  // For MVP, we use query param token.\n  if (token) {\n    url.searchParams.set('token', token)\n  }\n\n  log.info('sse.subscribing', { channel, url: url.toString() })\n\n  // Create EventSource connection\n  const eventSource = new EventSource(url.toString())\n\n  // Handle connection open\n  eventSource.onopen = () => {\n    log.info('sse.connected', { channel })\n    onOpen?.()\n  }\n\n  // Handle incoming messages (default event type)\n  eventSource.onmessage = (messageEvent: MessageEvent) => {\n    try {\n      const data = JSON.parse(messageEvent.data) as T\n      onMessage(data)\n    } catch (parseError) {\n      log.error('sse.parse_error', {\n        channel,\n        error: String(parseError),\n        data: messageEvent.data,\n      })\n    }\n  }\n\n  // Handle slow_client event (custom event type)\n  eventSource.addEventListener('slow_client', (event: MessageEvent) => {\n    try {\n      const data = JSON.parse(event.data) as SlowClientEvent\n      log.warn('sse.slow_client', { channel, dropped: data.dropped })\n      onSlowClient?.(data)\n    } catch (parseError) {\n      log.error('sse.slow_client_parse_error', {\n        channel,\n        error: String(parseError),\n      })\n    }\n  })\n\n  // Handle connection errors\n  eventSource.onerror = (error: Event) => {\n    // EventSource auto-reconnects, so this may fire during reconnection attempts\n    // ReadyState: 0 = CONNECTING, 1 = OPEN, 2 = CLOSED\n    if (eventSource.readyState === EventSource.CLOSED) {\n      log.error('sse.connection_closed', { channel })\n    } else {\n      log.warn('sse.connection_error', {\n        channel,\n        readyState: eventSource.readyState,\n      })\n    }\n    onError?.(error)\n  }\n\n  // Return cleanup function\n  return () => {\n    log.info('sse.unsubscribing', { channel })\n    eventSource.close()\n  }\n}\n\n/**\n * Subscribe to discovery engine status events.\n *\n * Convenience wrapper for subscribeAgentStatus with the discovery channel.\n *\n * @param onMessage - Callback invoked with DiscoveryStatusEvent on each message\n * @param options - Optional callbacks for errors and slow client warnings\n * @returns Cleanup function that closes the EventSource connection\n *\n * @example\n * ```ts\n * const unsubscribe = subscribeDiscoveryEvents((event) => {\n *   switch (event.event) {\n *     case 'RUN_STARTED':\n *       showToast('Discovery run started')\n *       break\n *     case 'RUN_COMPLETE':\n *       showToast('Discovery complete!')\n *       refreshDigest()\n *       break\n *     case 'RUN_FAILED':\n *       showError(`Discovery failed: ${event.error}`)\n *       break\n *   }\n * })\n * ```\n */\nexport function subscribeDiscoveryEvents(\n  onMessage: SSEMessageCallback<DiscoveryStatusEvent>,\n  options?: SubscribeOptions\n): UnsubscribeFn {\n  return subscribeAgentStatus<DiscoveryStatusEvent>(\n    'agent.status.discovery',\n    onMessage,\n    options\n  )\n}\n\n/**\n * Subscribe to application pipeline status events.\n *\n * Convenience wrapper for subscribeAgentStatus with the application channel.\n *\n * @param onMessage - Callback invoked with ApplicationStatusEvent on each message\n * @param options - Optional callbacks for errors and slow client warnings\n * @returns Cleanup function that closes the EventSource connection\n *\n * @example\n * ```ts\n * const unsubscribe = subscribeApplicationEvents((event) => {\n *   if (event.pipeline_id === currentPipelineId) {\n *     updatePipelineStatus(event.status)\n *   }\n * })\n * ```\n */\nexport function subscribeApplicationEvents(\n  onMessage: SSEMessageCallback<ApplicationStatusEvent>,\n  options?: SubscribeOptions\n): UnsubscribeFn {\n  return subscribeAgentStatus<ApplicationStatusEvent>(\n    'agent.status.application',\n    onMessage,\n    options\n  )\n}\n","numLines":393,"startLine":1,"totalLines":393}}}}
