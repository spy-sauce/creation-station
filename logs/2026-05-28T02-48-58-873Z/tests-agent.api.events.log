{"t":"2026-05-28T02:58:43.758Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Wu4HuYnwyjf9mG1gvHHJu1","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→SSE Event Stream — real-time agent status streaming.\n     6→\n     7→GET /events/stream?channel=agent.status.discovery\n     8→GET /events/stream?channel=agent.status.application\n     9→\n    10→Streams Redis pub/sub events to the frontend via Server-Sent Events.\n    11→Contract: HYPHA-API-STREAMING.md + NUTRIENTS.md § API_CONTRACTS (iter-4 additions)\n    12→\n    13→SSE format:\n    14→  - data: {json}\\\\n\\\\n for each message\n    15→  - :ping\\\\n\\\\n every 15s for connection keepalive\n    16→  - event: slow_client\\\\ndata: {\"dropped\": N}\\\\n\\\\n on backpressure\n    17→\n    18→Channel allowlist:\n    19→  - agent.status.discovery\n    20→  - agent.status.application\n    21→\n    22→Exports:\n    23→  - router: FastAPI APIRouter with /stream endpoint\n    24→  - SSESubscriber: Redis pub/sub subscriber class with channel allowlist\n    25→  - ALLOWED_CHANNELS: Frozenset of allowed channel names\n    26→\"\"\"\n    27→\n    28→from __future__ import annotations\n    29→\n    30→__all__ = [\n    31→    \"router\",\n    32→    \"SSESubscriber\",\n    33→    \"ALLOWED_CHANNELS\",\n    34→    \"HEARTBEAT_INTERVAL_SECONDS\",\n    35→    \"MAX_QUEUE_SIZE\",\n    36→]\n    37→\n    38→import asyncio\n    39→from typing import AsyncGenerator\n    40→\n    41→import redis.asyncio as aioredis\n    42→import structlog\n    43→from fastapi import APIRouter, Depends, HTTPException, Query\n    44→from fastapi.responses import StreamingResponse\n    45→\n    46→from backend.api.auth import get_current_user\n    47→from backend.database import get_redis\n    48→from backend.models.auth import User\n    49→from backend.observability.events import PubSubChannel\n    50→\n    51→logger = structlog.get_logger(__name__)\n    52→\n    53→router = APIRouter()\n    54→\n    55→# ─── Constants ────────────────────────────────────────────────────────────────\n    56→\n    57→# Allowed SSE channels (frozen contract from NUTRIENTS.md)\n    58→ALLOWED_CHANNELS: frozenset[str] = frozenset({\n    59→    PubSubChannel.DISCOVERY.value,    # agent.status.discovery\n    60→    PubSubChannel.APPLICATION.value,  # agent.status.application\n    61→})\n    62→\n    63→# Heartbeat interval in seconds\n    64→HEARTBEAT_INTERVAL_SECONDS: float = 15.0\n    65→\n    66→# Backpressure threshold — drop oldest messages if queue exceeds this\n    67→MAX_QUEUE_SIZE: int = 100\n    68→\n    69→\n    70→# ─── SSE Subscriber ───────────────────────────────────────────────────────────\n    71→\n    72→\n    73→class SSESubscriber:\n    74→    \"\"\"\n    75→    Redis pub/sub subscriber with channel allowlist for SSE streaming.\n    76→\n    77→    This class encapsulates the Redis subscription lifecycle:\n    78→      - Validates channels against the frozen allowlist\n    79→      - Subscribes to the Redis pub/sub channel\n    80→      - Buffers messages in an async queue with backpressure handling\n    81→      - Provides an async generator for SSE frame emission\n    82→\n    83→    Contract: NUTRIENTS.md § C. Symbol Ownership Matrix (iter-4 additions)\n    84→\n    85→    Attributes:\n    86→        redis_client: Async Redis client for pub/sub operations\n    87→        channel: Validated Redis channel to subscribe to\n    88→        user_id: Authenticated user ID for logging context\n    89→        queue: Internal message buffer with backpressure handling\n    90→        dropped_count: Counter for messages dropped due to slow client\n    91→\n    92→    Example:\n    93→        >>> subscriber = SSESubscriber(redis_client, \"agent.status.discovery\", user_id)\n    94→        >>> async for frame in subscriber.stream():\n    95→        ...     yield frame\n    96→    \"\"\"\n    97→\n    98→    def __init__(\n    99→        self,\n   100→        redis_client: aioredis.Redis,\n   101→        channel: str,\n   102→        user_id: str,\n   103→    ) -> None:\n   104→        \"\"\"\n   105→        Initialize an SSE subscriber for a Redis pub/sub channel.\n   106→\n   107→        Args:\n   108→            redis_client: Async Redis client for pub/sub subscription\n   109→            channel: Redis channel to subscribe to (must be in ALLOWED_CHANNELS)\n   110→            user_id: Authenticated user ID (for logging context)\n   111→\n   112→        Raises:\n   113→            ValueError: If channel is not in the allowlist\n   114→        \"\"\"\n   115→        if channel not in ALLOWED_CHANNELS:\n   116→            allowed_list = \", \".join(sorted(ALLOWED_CHANNELS))\n   117→            raise ValueError(f\"Invalid channel. Allowed: {allowed_list}\")\n   118→\n   119→        self.redis_client = redis_client\n   120→        self.channel = channel\n   121→        self.user_id = user_id\n   122→        self._pubsub: aioredis.client.PubSub | None = None\n   123→        self._message_queue: asyncio.Queue[str] = asyncio.Queue()\n   124→        self._dropped_count: int = 0\n   125→        self._reader_task: asyncio.Task | None = None\n   126→\n   127→    async def _reader(self) -> None:\n   128→        \"\"\"\n   129→        Background task that reads from Redis pub/sub and pushes to queue.\n   130→\n   131→        Handles backpressure by dropping oldest messages when queue is full.\n   132→        This prevents memory exhaustion when clients fall behind.\n   133→        \"\"\"\n   134→        try:\n   135→            self._pubsub = self.redis_client.pubsub()\n   136→            await self._pubsub.subscribe(self.channel)\n   137→\n   138→            async for message in self._pubsub.listen():\n   139→                if message[\"type\"] == \"message\":\n   140→                    data = message[\"data\"]\n   141→\n   142→                    # Backpressure: drop oldest messages if queue is full\n   143→                    while self._message_queue.qsize() >= MAX_QUEUE_SIZE:\n   144→                        try:\n   145→                            self._message_queue.get_nowait()\n   146→                            self._dropped_count += 1\n   147→                        except asyncio.QueueEmpty:\n   148→                            break\n   149→\n   150→                    await self._message_queue.put(data)\n   151→\n   152→        except asyncio.CancelledError:\n   153→            pass\n   154→        except Exception as exc:\n   155→            logger.error(\n   156→                \"sse.subscriber_reader_error\",\n   157→                channel=self.channel,\n   158→                user_id=self.user_id,\n   159→                error=str(exc),\n   160→            )\n   161→\n   162→    async def stream(self) -> AsyncGenerator[str, None]:\n   163→        \"\"\"\n   164→        Async generator that yields SSE frames from the subscription.\n   165→\n   166→        Yields:\n   167→            SSE-formatted strings:\n   168→              - data: {json}\\\\n\\\\n for each message\n   169→              - :ping\\\\n\\\\n every 15s for keepalive\n   170→              - event: slow_client\\\\ndata: {\"dropped\": N}\\\\n\\\\n on backpressure\n   171→\n   172→        The generator handles cleanup on cancellation or error, ensuring\n   173→        the Redis subscription is properly closed.\n   174→        \"\"\"\n   175→        logger.info(\n   176→            \"sse.subscriber_started\",\n   177→            channel=self.channel,\n   178→            user_id=self.user_id,\n   179→        )\n   180→\n   181→        # Start the background reader\n   182→        self._reader_task = asyncio.create_task(self._reader())\n   183→\n   184→        try:\n   185→            while True:\n   186→                try:\n   187→                    # Wait for message with timeout (for heartbeat)\n   188→                    message = await asyncio.wait_for(\n   189→                        self._message_queue.get(),\n   190→                        timeout=HEARTBEAT_INTERVAL_SECONDS,\n   191→                    )\n   192→\n   193→                    # Emit slow_client warning if messages were dropped\n   194→                    if self._dropped_count > 0:\n   195→                        yield f\"event: slow_client\\ndata: {{\\\"dropped\\\": {self._dropped_count}}}\\n\\n\"\n   196→                        logger.warning(\n   197→                            \"sse.slow_client\",\n   198→                            channel=self.channel,\n   199→                            user_id=self.user_id,\n   200→                            dropped=self._dropped_count,\n   201→                        )\n   202→                        self._dropped_count = 0\n   203→\n   204→                    # Emit the actual message\n   205→                    yield f\"data: {message}\\n\\n\"\n   206→\n   207→                except asyncio.TimeoutError:\n   208→                    # No message within heartbeat interval — send keepalive\n   209→                    yield \":ping\\n\\n\"\n   210→\n   211→        except asyncio.CancelledError:\n   212→            logger.info(\n   213→                \"sse.subscriber_cancelled\",\n   214→                channel=self.channel,\n   215→                user_id=self.user_id,\n   216→            )\n   217→        except Exception as exc:\n   218→            logger.error(\n   219→                \"sse.subscriber_error\",\n   220→                channel=self.channel,\n   221→                user_id=self.user_id,\n   222→                error=str(exc),\n   223→            )\n   224→        finally:\n   225→            await self._cleanup()\n   226→\n   227→    async def _cleanup(self) -> None:\n   228→        \"\"\"Clean up resources: cancel reader task and close subscription.\"\"\"\n   229→        if self._reader_task:\n   230→            self._reader_task.cancel()\n   231→            try:\n   232→                await self._reader_task\n   233→            except asyncio.CancelledError:\n   234→                pass\n   235→\n   236→        if self._pubsub:\n   237→            try:\n   238→                await self._pubsub.unsubscribe(self.channel)\n   239→                await self._pubsub.close()\n   240→            except Exception as exc:\n   241→                logger.warning(\n   242→                    \"sse.subscriber_cleanup_error\",\n   243→                    channel=self.channel,\n   244→                    error=str(exc),\n   245→                )\n   246→\n   247→        logger.info(\n   248→            \"sse.subscriber_closed\",\n   249→            channel=self.channel,\n   250→            user_id=self.user_id,\n   251→        )\n   252→\n   253→\n   254→# ─── SSE Generator (legacy wrapper) ───────────────────────────────────────────\n   255→\n   256→\n   257→async def sse_event_generator(\n   258→    redis_client: aioredis.Redis,\n   259→    channel: str,\n   260→    user_id: str,\n   261→) -> AsyncGenerator[str, None]:\n   262→    \"\"\"\n   263→    Generate SSE frames from Redis pub/sub messages.\n   264→\n   265→    Args:\n   266→        redis_client: Async Redis client for pub/sub subscription\n   267→        channel: Redis channel to subscribe to\n   268→        user_id: Authenticated user ID (for logging)\n   269→\n   270→    Yields:\n   271→        SSE-formatted strings (data: {json}\\n\\n or :ping\\n\\n)\n   272→\n   273→    Contract:\n   274→        - Each message yields: data: {json}\\n\\n\n   275→        - Heartbeat every 15s: :ping\\n\\n\n   276→        - Backpressure: if queue > 100, drop oldest and emit slow_client event\n   277→    \"\"\"\n   278→    pubsub = redis_client.pubsub()\n   279→    message_queue: asyncio.Queue[str] = asyncio.Queue()\n   280→    dropped_count: int = 0\n   281→\n   282→    logger.info(\n   283→        \"sse.connection_started\",\n   284→        channel=channel,\n   285→        user_id=user_id,\n   286→    )\n   287→\n   288→    async def reader_task() -> None:\n   289→        \"\"\"\n   290→        Background task that reads from Redis pub/sub and pushes to queue.\n   291→\n   292→        Handles backpressure by dropping oldest messages when queue is full.\n   293→        \"\"\"\n   294→        nonlocal dropped_count\n   295→\n   296→        try:\n   297→            await pubsub.subscribe(channel)\n   298→            async for message in pubsub.listen():\n   299→                if message[\"type\"] == \"message\":\n   300→                    data = message[\"data\"]\n   301→\n   302→                    # Backpressure check\n   303→                    while message_queue.qsize() >= MAX_QUEUE_SIZE:\n   304→                        try:\n   305→                            message_queue.get_nowait()\n   306→                            dropped_count += 1\n   307→                        except asyncio.QueueEmpty:\n   308→                            break\n   309→\n   310→                    await message_queue.put(data)\n   311→        except asyncio.CancelledError:\n   312→            pass\n   313→        except Exception as exc:\n   314→            logger.error(\n   315→                \"sse.reader_error\",\n   316→                channel=channel,\n   317→                user_id=user_id,\n   318→                error=str(exc),\n   319→            )\n   320→\n   321→    # Start the background reader\n   322→    reader = asyncio.create_task(reader_task())\n   323→\n   324→    try:\n   325→        while True:\n   326→            try:\n   327→                # Wait for message with timeout (for heartbeat)\n   328→                message = await asyncio.wait_for(\n   329→                    message_queue.get(),\n   330→                    timeout=HEARTBEAT_INTERVAL_SECONDS,\n   331→                )\n   332→\n   333→                # Emit slow_client warning if messages were dropped\n   334→                if dropped_count > 0:\n   335→                    yield f\"event: slow_client\\ndata: {{\\\"dropped\\\": {dropped_count}}}\\n\\n\"\n   336→                    logger.warning(\n   337→                        \"sse.slow_client\",\n   338→                        channel=channel,\n   339→                        user_id=user_id,\n   340→                        dropped=dropped_count,\n   341→                    )\n   342→                    dropped_count = 0\n   343→\n   344→                # Emit the actual message\n   345→                yield f\"data: {message}\\n\\n\"\n   346→\n   347→            except asyncio.TimeoutError:\n   348→                # No message within heartbeat interval — send keepalive\n   349→                yield \":ping\\n\\n\"\n   350→\n   351→    except asyncio.CancelledError:\n   352→        logger.info(\n   353→            \"sse.connection_cancelled\",\n   354→            channel=channel,\n   355→            user_id=user_id,\n   356→        )\n   357→    except Exception as exc:\n   358→        logger.error(\n   359→            \"sse.generator_error\",\n   360→            channel=channel,\n   361→            user_id=user_id,\n   362→            error=str(exc),\n   363→        )\n   364→    finally:\n   365→        # Cleanup: cancel reader and unsubscribe\n   366→        reader.cancel()\n   367→        try:\n   368→            await reader\n   369→        except asyncio.CancelledError:\n   370→            pass\n   371→\n   372→        try:\n   373→            await pubsub.unsubscribe(channel)\n   374→            await pubsub.close()\n   375→        except Exception as exc:\n   376→            logger.warning(\n   377→                \"sse.cleanup_error\",\n   378→                channel=channel,\n   379→                error=str(exc),\n   380→            )\n   381→\n   382→        logger.info(\n   383→            \"sse.connection_closed\",\n   384→            channel=channel,\n   385→            user_id=user_id,\n   386→        )\n   387→\n   388→\n   389→# ─── Endpoint ─────────────────────────────────────────────────────────────────\n   390→\n   391→\n   392→@router.get(\"/stream\")\n   393→async def event_stream(\n   394→    channel: str = Query(\n   395→        ...,\n   396→        description=\"Redis pub/sub channel to subscribe to\",\n   397→        examples=[\"agent.status.discovery\", \"agent.status.application\"],\n   398→    ),\n   399→    current_user: User = Depends(get_current_user),\n   400→    redis_client: aioredis.Redis = Depends(get_redis),\n   401→) -> StreamingResponse:\n   402→    \"\"\"\n   403→    Stream real-time agent status events via Server-Sent Events.\n   404→\n   405→    Args:\n   406→        channel: Redis pub/sub channel to subscribe to.\n   407→            Allowed: agent.status.discovery, agent.status.application\n   408→\n   409→    Returns:\n   410→        StreamingResponse with Content-Type: text/event-stream\n   411→\n   412→    Raises:\n   413→        400: Invalid channel (not in allowlist)\n   414→        401: Not authenticated (missing or invalid JWT)\n   415→\n   416→    Contract: NUTRIENTS.md § API_CONTRACTS → GET /events/stream\n   417→    \"\"\"\n   418→    # Validate channel against allowlist (also validated in SSESubscriber)\n   419→    if channel not in ALLOWED_CHANNELS:\n   420→        allowed_list = \", \".join(sorted(ALLOWED_CHANNELS))\n   421→        raise HTTPException(\n   422→            status_code=400,\n   423→            detail=f\"Invalid channel. Allowed: {allowed_list}\",\n   424→        )\n   425→\n   426→    logger.info(\n   427→        \"sse.stream_requested\",\n   428→        channel=channel,\n   429→        user_id=str(current_user.id),\n   430→    )\n   431→\n   432→    # Create subscriber with channel allowlist validation\n   433→    subscriber = SSESubscriber(\n   434→        redis_client=redis_client,\n   435→        channel=channel,\n   436→        user_id=str(current_user.id),\n   437→    )\n   438→\n   439→    return StreamingResponse(\n   440→        subscriber.stream(),\n   441→        media_type=\"text/event-stream\",\n   442→        headers={\n   443→            \"Cache-Control\": \"no-cache\",\n   444→            \"Connection\": \"keep-alive\",\n   445→            \"X-Accel-Buffering\": \"no\",  # Disable nginx buffering\n   446→        },\n   447→    )\n   448→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"ef3e1c9a-082e-4b26-be4b-f026a2179071","uuid":"d8bef1b0-f193-48e4-b0a5-1e1f3f023d8e","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/api/events.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nSSE Event Stream — real-time agent status streaming.\n\nGET /events/stream?channel=agent.status.discovery\nGET /events/stream?channel=agent.status.application\n\nStreams Redis pub/sub events to the frontend via Server-Sent Events.\nContract: HYPHA-API-STREAMING.md + NUTRIENTS.md § API_CONTRACTS (iter-4 additions)\n\nSSE format:\n  - data: {json}\\\\n\\\\n for each message\n  - :ping\\\\n\\\\n every 15s for connection keepalive\n  - event: slow_client\\\\ndata: {\"dropped\": N}\\\\n\\\\n on backpressure\n\nChannel allowlist:\n  - agent.status.discovery\n  - agent.status.application\n\nExports:\n  - router: FastAPI APIRouter with /stream endpoint\n  - SSESubscriber: Redis pub/sub subscriber class with channel allowlist\n  - ALLOWED_CHANNELS: Frozenset of allowed channel names\n\"\"\"\n\nfrom __future__ import annotations\n\n__all__ = [\n    \"router\",\n    \"SSESubscriber\",\n    \"ALLOWED_CHANNELS\",\n    \"HEARTBEAT_INTERVAL_SECONDS\",\n    \"MAX_QUEUE_SIZE\",\n]\n\nimport asyncio\nfrom typing import AsyncGenerator\n\nimport redis.asyncio as aioredis\nimport structlog\nfrom fastapi import APIRouter, Depends, HTTPException, Query\nfrom fastapi.responses import StreamingResponse\n\nfrom backend.api.auth import get_current_user\nfrom backend.database import get_redis\nfrom backend.models.auth import User\nfrom backend.observability.events import PubSubChannel\n\nlogger = structlog.get_logger(__name__)\n\nrouter = APIRouter()\n\n# ─── Constants ────────────────────────────────────────────────────────────────\n\n# Allowed SSE channels (frozen contract from NUTRIENTS.md)\nALLOWED_CHANNELS: frozenset[str] = frozenset({\n    PubSubChannel.DISCOVERY.value,    # agent.status.discovery\n    PubSubChannel.APPLICATION.value,  # agent.status.application\n})\n\n# Heartbeat interval in seconds\nHEARTBEAT_INTERVAL_SECONDS: float = 15.0\n\n# Backpressure threshold — drop oldest messages if queue exceeds this\nMAX_QUEUE_SIZE: int = 100\n\n\n# ─── SSE Subscriber ───────────────────────────────────────────────────────────\n\n\nclass SSESubscriber:\n    \"\"\"\n    Redis pub/sub subscriber with channel allowlist for SSE streaming.\n\n    This class encapsulates the Redis subscription lifecycle:\n      - Validates channels against the frozen allowlist\n      - Subscribes to the Redis pub/sub channel\n      - Buffers messages in an async queue with backpressure handling\n      - Provides an async generator for SSE frame emission\n\n    Contract: NUTRIENTS.md § C. Symbol Ownership Matrix (iter-4 additions)\n\n    Attributes:\n        redis_client: Async Redis client for pub/sub operations\n        channel: Validated Redis channel to subscribe to\n        user_id: Authenticated user ID for logging context\n        queue: Internal message buffer with backpressure handling\n        dropped_count: Counter for messages dropped due to slow client\n\n    Example:\n        >>> subscriber = SSESubscriber(redis_client, \"agent.status.discovery\", user_id)\n        >>> async for frame in subscriber.stream():\n        ...     yield frame\n    \"\"\"\n\n    def __init__(\n        self,\n        redis_client: aioredis.Redis,\n        channel: str,\n        user_id: str,\n    ) -> None:\n        \"\"\"\n        Initialize an SSE subscriber for a Redis pub/sub channel.\n\n        Args:\n            redis_client: Async Redis client for pub/sub subscription\n            channel: Redis channel to subscribe to (must be in ALLOWED_CHANNELS)\n            user_id: Authenticated user ID (for logging context)\n\n        Raises:\n            ValueError: If channel is not in the allowlist\n        \"\"\"\n        if channel not in ALLOWED_CHANNELS:\n            allowed_list = \", \".join(sorted(ALLOWED_CHANNELS))\n            raise ValueError(f\"Invalid channel. Allowed: {allowed_list}\")\n\n        self.redis_client = redis_client\n        self.channel = channel\n        self.user_id = user_id\n        self._pubsub: aioredis.client.PubSub | None = None\n        self._message_queue: asyncio.Queue[str] = asyncio.Queue()\n        self._dropped_count: int = 0\n        self._reader_task: asyncio.Task | None = None\n\n    async def _reader(self) -> None:\n        \"\"\"\n        Background task that reads from Redis pub/sub and pushes to queue.\n\n        Handles backpressure by dropping oldest messages when queue is full.\n        This prevents memory exhaustion when clients fall behind.\n        \"\"\"\n        try:\n            self._pubsub = self.redis_client.pubsub()\n            await self._pubsub.subscribe(self.channel)\n\n            async for message in self._pubsub.listen():\n                if message[\"type\"] == \"message\":\n                    data = message[\"data\"]\n\n                    # Backpressure: drop oldest messages if queue is full\n                    while self._message_queue.qsize() >= MAX_QUEUE_SIZE:\n                        try:\n                            self._message_queue.get_nowait()\n                            self._dropped_count += 1\n                        except asyncio.QueueEmpty:\n                            break\n\n                    await self._message_queue.put(data)\n\n        except asyncio.CancelledError:\n            pass\n        except Exception as exc:\n            logger.error(\n                \"sse.subscriber_reader_error\",\n                channel=self.channel,\n                user_id=self.user_id,\n                error=str(exc),\n            )\n\n    async def stream(self) -> AsyncGenerator[str, None]:\n        \"\"\"\n        Async generator that yields SSE frames from the subscription.\n\n        Yields:\n            SSE-formatted strings:\n              - data: {json}\\\\n\\\\n for each message\n              - :ping\\\\n\\\\n every 15s for keepalive\n              - event: slow_client\\\\ndata: {\"dropped\": N}\\\\n\\\\n on backpressure\n\n        The generator handles cleanup on cancellation or error, ensuring\n        the Redis subscription is properly closed.\n        \"\"\"\n        logger.info(\n            \"sse.subscriber_started\",\n            channel=self.channel,\n            user_id=self.user_id,\n        )\n\n        # Start the background reader\n        self._reader_task = asyncio.create_task(self._reader())\n\n        try:\n            while True:\n                try:\n                    # Wait for message with timeout (for heartbeat)\n                    message = await asyncio.wait_for(\n                        self._message_queue.get(),\n                        timeout=HEARTBEAT_INTERVAL_SECONDS,\n                    )\n\n                    # Emit slow_client warning if messages were dropped\n                    if self._dropped_count > 0:\n                        yield f\"event: slow_client\\ndata: {{\\\"dropped\\\": {self._dropped_count}}}\\n\\n\"\n                        logger.warning(\n                            \"sse.slow_client\",\n                            channel=self.channel,\n                            user_id=self.user_id,\n                            dropped=self._dropped_count,\n                        )\n                        self._dropped_count = 0\n\n                    # Emit the actual message\n                    yield f\"data: {message}\\n\\n\"\n\n                except asyncio.TimeoutError:\n                    # No message within heartbeat interval — send keepalive\n                    yield \":ping\\n\\n\"\n\n        except asyncio.CancelledError:\n            logger.info(\n                \"sse.subscriber_cancelled\",\n                channel=self.channel,\n                user_id=self.user_id,\n            )\n        except Exception as exc:\n            logger.error(\n                \"sse.subscriber_error\",\n                channel=self.channel,\n                user_id=self.user_id,\n                error=str(exc),\n            )\n        finally:\n            await self._cleanup()\n\n    async def _cleanup(self) -> None:\n        \"\"\"Clean up resources: cancel reader task and close subscription.\"\"\"\n        if self._reader_task:\n            self._reader_task.cancel()\n            try:\n                await self._reader_task\n            except asyncio.CancelledError:\n                pass\n\n        if self._pubsub:\n            try:\n                await self._pubsub.unsubscribe(self.channel)\n                await self._pubsub.close()\n            except Exception as exc:\n                logger.warning(\n                    \"sse.subscriber_cleanup_error\",\n                    channel=self.channel,\n                    error=str(exc),\n                )\n\n        logger.info(\n            \"sse.subscriber_closed\",\n            channel=self.channel,\n            user_id=self.user_id,\n        )\n\n\n# ─── SSE Generator (legacy wrapper) ───────────────────────────────────────────\n\n\nasync def sse_event_generator(\n    redis_client: aioredis.Redis,\n    channel: str,\n    user_id: str,\n) -> AsyncGenerator[str, None]:\n    \"\"\"\n    Generate SSE frames from Redis pub/sub messages.\n\n    Args:\n        redis_client: Async Redis client for pub/sub subscription\n        channel: Redis channel to subscribe to\n        user_id: Authenticated user ID (for logging)\n\n    Yields:\n        SSE-formatted strings (data: {json}\\n\\n or :ping\\n\\n)\n\n    Contract:\n        - Each message yields: data: {json}\\n\\n\n        - Heartbeat every 15s: :ping\\n\\n\n        - Backpressure: if queue > 100, drop oldest and emit slow_client event\n    \"\"\"\n    pubsub = redis_client.pubsub()\n    message_queue: asyncio.Queue[str] = asyncio.Queue()\n    dropped_count: int = 0\n\n    logger.info(\n        \"sse.connection_started\",\n        channel=channel,\n        user_id=user_id,\n    )\n\n    async def reader_task() -> None:\n        \"\"\"\n        Background task that reads from Redis pub/sub and pushes to queue.\n\n        Handles backpressure by dropping oldest messages when queue is full.\n        \"\"\"\n        nonlocal dropped_count\n\n        try:\n            await pubsub.subscribe(channel)\n            async for message in pubsub.listen():\n                if message[\"type\"] == \"message\":\n                    data = message[\"data\"]\n\n                    # Backpressure check\n                    while message_queue.qsize() >= MAX_QUEUE_SIZE:\n                        try:\n                            message_queue.get_nowait()\n                            dropped_count += 1\n                        except asyncio.QueueEmpty:\n                            break\n\n                    await message_queue.put(data)\n        except asyncio.CancelledError:\n            pass\n        except Exception as exc:\n            logger.error(\n                \"sse.reader_error\",\n                channel=channel,\n                user_id=user_id,\n                error=str(exc),\n            )\n\n    # Start the background reader\n    reader = asyncio.create_task(reader_task())\n\n    try:\n        while True:\n            try:\n                # Wait for message with timeout (for heartbeat)\n                message = await asyncio.wait_for(\n                    message_queue.get(),\n                    timeout=HEARTBEAT_INTERVAL_SECONDS,\n                )\n\n                # Emit slow_client warning if messages were dropped\n                if dropped_count > 0:\n                    yield f\"event: slow_client\\ndata: {{\\\"dropped\\\": {dropped_count}}}\\n\\n\"\n                    logger.warning(\n                        \"sse.slow_client\",\n                        channel=channel,\n                        user_id=user_id,\n                        dropped=dropped_count,\n                    )\n                    dropped_count = 0\n\n                # Emit the actual message\n                yield f\"data: {message}\\n\\n\"\n\n            except asyncio.TimeoutError:\n                # No message within heartbeat interval — send keepalive\n                yield \":ping\\n\\n\"\n\n    except asyncio.CancelledError:\n        logger.info(\n            \"sse.connection_cancelled\",\n            channel=channel,\n            user_id=user_id,\n        )\n    except Exception as exc:\n        logger.error(\n            \"sse.generator_error\",\n            channel=channel,\n            user_id=user_id,\n            error=str(exc),\n        )\n    finally:\n        # Cleanup: cancel reader and unsubscribe\n        reader.cancel()\n        try:\n            await reader\n        except asyncio.CancelledError:\n            pass\n\n        try:\n            await pubsub.unsubscribe(channel)\n            await pubsub.close()\n        except Exception as exc:\n            logger.warning(\n                \"sse.cleanup_error\",\n                channel=channel,\n                error=str(exc),\n            )\n\n        logger.info(\n            \"sse.connection_closed\",\n            channel=channel,\n            user_id=user_id,\n        )\n\n\n# ─── Endpoint ─────────────────────────────────────────────────────────────────\n\n\n@router.get(\"/stream\")\nasync def event_stream(\n    channel: str = Query(\n        ...,\n        description=\"Redis pub/sub channel to subscribe to\",\n        examples=[\"agent.status.discovery\", \"agent.status.application\"],\n    ),\n    current_user: User = Depends(get_current_user),\n    redis_client: aioredis.Redis = Depends(get_redis),\n) -> StreamingResponse:\n    \"\"\"\n    Stream real-time agent status events via Server-Sent Events.\n\n    Args:\n        channel: Redis pub/sub channel to subscribe to.\n            Allowed: agent.status.discovery, agent.status.application\n\n    Returns:\n        StreamingResponse with Content-Type: text/event-stream\n\n    Raises:\n        400: Invalid channel (not in allowlist)\n        401: Not authenticated (missing or invalid JWT)\n\n    Contract: NUTRIENTS.md § API_CONTRACTS → GET /events/stream\n    \"\"\"\n    # Validate channel against allowlist (also validated in SSESubscriber)\n    if channel not in ALLOWED_CHANNELS:\n        allowed_list = \", \".join(sorted(ALLOWED_CHANNELS))\n        raise HTTPException(\n            status_code=400,\n            detail=f\"Invalid channel. Allowed: {allowed_list}\",\n        )\n\n    logger.info(\n        \"sse.stream_requested\",\n        channel=channel,\n        user_id=str(current_user.id),\n    )\n\n    # Create subscriber with channel allowlist validation\n    subscriber = SSESubscriber(\n        redis_client=redis_client,\n        channel=channel,\n        user_id=str(current_user.id),\n    )\n\n    return StreamingResponse(\n        subscriber.stream(),\n        media_type=\"text/event-stream\",\n        headers={\n            \"Cache-Control\": \"no-cache\",\n            \"Connection\": \"keep-alive\",\n            \"X-Accel-Buffering\": \"no\",  # Disable nginx buffering\n        },\n    )\n","numLines":448,"startLine":1,"totalLines":448}}}}
{"t":"2026-05-28T02:58:43.765Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RjKF1ZKp8HNEUyGQ6fFSRA","type":"tool_result","content":"     1→import pytest\n     2→import pytest_asyncio\n     3→from httpx import AsyncClient, ASGITransport\n     4→from backend.main import app\n     5→\n     6→\n     7→@pytest_asyncio.fixture\n     8→async def client():\n     9→    async with AsyncClient(\n    10→        transport=ASGITransport(app=app), base_url=\"http://test\"\n    11→    ) as ac:\n    12→        yield ac\n    13→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"ef3e1c9a-082e-4b26-be4b-f026a2179071","uuid":"d8f638ef-48a2-4746-9ccc-62308173a39f","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/tests/conftest.py","content":"import pytest\nimport pytest_asyncio\nfrom httpx import AsyncClient, ASGITransport\nfrom backend.main import app\n\n\n@pytest_asyncio.fixture\nasync def client():\n    async with AsyncClient(\n        transport=ASGITransport(app=app), base_url=\"http://test\"\n    ) as ac:\n        yield ac\n","numLines":13,"startLine":1,"totalLines":13}}}}
{"t":"2026-05-28T02:58:43.772Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Uds7VAZQRDKMXAYJjfxNKk","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Authentication API — passwordless magic link flow.\n     6→\n     7→POST  /auth/request-link     → request a magic login link\n     8→POST  /auth/verify            → verify magic link token, return JWT\n     9→GET   /auth/me                → get current authenticated user\n    10→\"\"\"\n    11→\n    12→import uuid\n    13→import secrets\n    14→from datetime import datetime, timedelta, timezone\n    15→\n    16→import jwt\n    17→import resend\n    18→import structlog\n    19→from fastapi import APIRouter, Depends, HTTPException, Request\n    20→from fastapi.security import HTTPBearer, HTTPAuthorizationCredentials\n    21→from pydantic import BaseModel, EmailStr\n    22→from sqlalchemy import select\n    23→from sqlalchemy.ext.asyncio import AsyncSession\n    24→\n    25→from backend.config import settings\n    26→from backend.database import get_db\n    27→from backend.models.auth import User, MagicLink\n    28→\n    29→logger = structlog.get_logger(__name__)\n    30→router = APIRouter()\n    31→security = HTTPBearer(auto_error=False)\n    32→\n    33→\n    34→# ─── PII Redaction ────────────────────────────────────────────────────────────\n    35→\n    36→def redact_email(email: str) -> str:\n    37→    \"\"\"Redact email for safe logging. e.g. 'spy@seanyoung.biz' → 's**@s***.biz'\"\"\"\n    38→    if not email or \"@\" not in email:\n    39→        return \"[redacted]\"\n    40→    local, domain = email.split(\"@\", 1)\n    41→    domain_parts = domain.rsplit(\".\", 1)\n    42→    redacted_local = local[0] + \"**\" if local else \"**\"\n    43→    if len(domain_parts) == 2:\n    44→        redacted_domain = domain_parts[0][0] + \"***.\" + domain_parts[1]\n    45→    else:\n    46→        redacted_domain = \"***\"\n    47→    return f\"{redacted_local}@{redacted_domain}\"\n    48→\n    49→\n    50→# ─── Schemas ─────────────────────────────────────────────────────────────────\n    51→\n    52→class RequestLinkPayload(BaseModel):\n    53→    \"\"\"Payload to request a magic link.\"\"\"\n    54→    email: EmailStr\n    55→\n    56→\n    57→class RequestLinkResponse(BaseModel):\n    58→    \"\"\"Response after requesting a magic link.\"\"\"\n    59→    message: str\n    60→    # In dev mode, we return the magic link directly so you can click it\n    61→    magic_link: str | None = None\n    62→    token: str | None = None\n    63→\n    64→\n    65→class VerifyTokenPayload(BaseModel):\n    66→    \"\"\"Payload to verify a magic link token.\"\"\"\n    67→    token: str\n    68→\n    69→\n    70→class AuthResponse(BaseModel):\n    71→    \"\"\"Response with JWT access token.\"\"\"\n    72→    access_token: str\n    73→    token_type: str = \"bearer\"\n    74→    user_id: str\n    75→    email: str\n    76→    is_onboarded: bool\n    77→\n    78→\n    79→class UserResponse(BaseModel):\n    80→    \"\"\"Current user info.\"\"\"\n    81→    id: str\n    82→    email: str\n    83→    name: str | None\n    84→    is_onboarded: bool\n    85→    candidate_id: str | None\n    86→    created_at: str\n    87→\n    88→\n    89→# ─── JWT Helpers ─────────────────────────────────────────────────────────────\n    90→\n    91→def create_jwt(user_id: uuid.UUID, email: str) -> str:\n    92→    \"\"\"Create a JWT access token for an authenticated user.\"\"\"\n    93→    payload = {\n    94→        \"sub\": str(user_id),\n    95→        \"email\": email,\n    96→        \"iat\": datetime.now(timezone.utc),\n    97→        \"exp\": datetime.now(timezone.utc) + timedelta(days=7),\n    98→    }\n    99→    return jwt.encode(payload, settings.jwt_secret, algorithm=\"HS256\")\n   100→\n   101→\n   102→def decode_jwt(token: str) -> dict:\n   103→    \"\"\"Decode and validate a JWT token.\"\"\"\n   104→    try:\n   105→        return jwt.decode(token, settings.jwt_secret, algorithms=[\"HS256\"])\n   106→    except jwt.ExpiredSignatureError:\n   107→        raise HTTPException(status_code=401, detail=\"Token expired\")\n   108→    except jwt.InvalidTokenError:\n   109→        raise HTTPException(status_code=401, detail=\"Invalid token\")\n   110→\n   111→\n   112→# ─── Resend Email ─────────────────────────────────────────────────────────────\n   113→\n   114→async def send_magic_link_email(email: str, magic_link_url: str) -> bool:\n   115→    \"\"\"\n   116→    Send magic link email via Resend.\n   117→\n   118→    Returns True if email was sent successfully, False otherwise.\n   119→    Falls back gracefully if Resend is not configured.\n   120→    \"\"\"\n   121→    if not settings.resend_api_key:\n   122→        logger.warning(\n   123→            \"auth.resend_not_configured\",\n   124→            email_redacted=redact_email(email),\n   125→            message=\"Resend API key not set, email not sent\",\n   126→        )\n   127→        return False\n   128→\n   129→    resend.api_key = settings.resend_api_key\n   130→\n   131→    try:\n   132→        resend.Emails.send({\n   133→            \"from\": settings.resend_from_email,\n   134→            \"to\": email,\n   135→            \"subject\": \"Your Talent Agent Login Link\",\n   136→            \"html\": f\"\"\"\n   137→            <div style=\"font-family: 'DM Sans', -apple-system, sans-serif; max-width: 600px; margin: 0 auto; padding: 40px 20px; background-color: #0A0A0A; color: #FAFAFA;\">\n   138→                <h1 style=\"font-family: 'Playfair Display', Georgia, serif; color: #C9A227; font-size: 28px; margin-bottom: 24px;\">\n   139→                    Talent Agent\n   140→                </h1>\n   141→                <p style=\"font-size: 16px; line-height: 1.6; margin-bottom: 24px;\">\n   142→                    Click the button below to sign in to your account. This link expires in {settings.magic_link_expiry_minutes} minutes.\n   143→                </p>\n   144→                <a href=\"{magic_link_url}\" style=\"display: inline-block; background-color: #C9A227; color: #0A0A0A; padding: 14px 28px; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px;\">\n   145→                    Sign In\n   146→                </a>\n   147→                <p style=\"font-size: 14px; color: #737373; margin-top: 32px; line-height: 1.6;\">\n   148→                    If you didn't request this link, you can safely ignore this email.\n   149→                </p>\n   150→                <hr style=\"border: none; border-top: 1px solid rgba(255,255,255,0.08); margin: 32px 0;\">\n   151→                <p style=\"font-size: 12px; color: #737373;\">\n   152→                    VibeSpace LLC · The Dot Connects\n   153→                </p>\n   154→            </div>\n   155→            \"\"\",\n   156→        })\n   157→        logger.info(\n   158→            \"auth.email_sent\",\n   159→            email_redacted=redact_email(email),\n   160→        )\n   161→        return True\n   162→    except Exception as e:\n   163→        logger.error(\n   164→            \"auth.email_send_failed\",\n   165→            email_redacted=redact_email(email),\n   166→            error=str(e),\n   167→        )\n   168→        return False\n   169→\n   170→\n   171→# ─── Auth Dependency ─────────────────────────────────────────────────────────\n   172→\n   173→async def get_current_user(\n   174→    credentials: HTTPAuthorizationCredentials | None = Depends(security),\n   175→    db: AsyncSession = Depends(get_db),\n   176→) -> User:\n   177→    \"\"\"FastAPI dependency that returns the current authenticated user.\"\"\"\n   178→    if credentials is None:\n   179→        raise HTTPException(status_code=401, detail=\"Not authenticated\")\n   180→\n   181→    payload = decode_jwt(credentials.credentials)\n   182→    user_id = payload.get(\"sub\")\n   183→    if not user_id:\n   184→        raise HTTPException(status_code=401, detail=\"Invalid token payload\")\n   185→\n   186→    result = await db.execute(\n   187→        select(User).where(User.id == uuid.UUID(user_id))\n   188→    )\n   189→    user = result.scalar_one_or_none()\n   190→    if not user or not user.is_active:\n   191→        raise HTTPException(status_code=401, detail=\"User not found or inactive\")\n   192→\n   193→    return user\n   194→\n   195→\n   196→# ─── Endpoints ───────────────────────────────────────────────────────────────\n   197→\n   198→@router.post(\"/request-link\", response_model=RequestLinkResponse)\n   199→async def request_magic_link(\n   200→    payload: RequestLinkPayload,\n   201→    request: Request,\n   202→    db: AsyncSession = Depends(get_db),\n   203→):\n   204→    \"\"\"\n   205→    Request a magic login link. Creates user if they don't exist.\n   206→\n   207→    In dev mode (DEBUG=true), returns the magic link directly in the response\n   208→    so you can click it without needing email infrastructure.\n   209→    In production, sends the link via Resend email service.\n   210→    \"\"\"\n   211→    email = payload.email.lower().strip()\n   212→    email_redacted = redact_email(email)\n   213→\n   214→    # Find or create user\n   215→    result = await db.execute(select(User).where(User.email == email))\n   216→    user = result.scalar_one_or_none()\n   217→\n   218→    if not user:\n   219→        user = User(email=email)\n   220→        db.add(user)\n   221→        await db.flush()\n   222→        logger.info(\n   223→            \"auth.user_created\",\n   224→            email_redacted=email_redacted,\n   225→            user_id=str(user.id),\n   226→        )\n   227→\n   228→    # Generate magic link token\n   229→    token = secrets.token_urlsafe(48)\n   230→    expires_at = datetime.now(timezone.utc) + timedelta(minutes=settings.magic_link_expiry_minutes)\n   231→\n   232→    magic_link_record = MagicLink(\n   233→        user_id=user.id,\n   234→        token=token,\n   235→        expires_at=expires_at,\n   236→    )\n   237→    db.add(magic_link_record)\n   238→    await db.commit()\n   239→\n   240→    # Build the magic link URL using frontend origin\n   241→    origin = request.headers.get(\"origin\", \"http://localhost:5173\")\n   242→    magic_link_url = f\"{origin}/auth/verify?token={token}\"\n   243→\n   244→    logger.info(\n   245→        \"auth.magic_link_created\",\n   246→        email_redacted=email_redacted,\n   247→        expires_at=expires_at.isoformat(),\n   248→    )\n   249→\n   250→    if settings.debug:\n   251→        # Dev mode: return link directly for easy testing\n   252→        return RequestLinkResponse(\n   253→            message=\"Magic link created. Click to log in.\",\n   254→            magic_link=magic_link_url,\n   255→            token=token,\n   256→        )\n   257→    else:\n   258→        # Production: send email via Resend\n   259→        email_sent = await send_magic_link_email(email, magic_link_url)\n   260→        if email_sent:\n   261→            return RequestLinkResponse(\n   262→                message=\"Check your email for a login link.\",\n   263→            )\n   264→        else:\n   265→            # Graceful degradation if email fails\n   266→            logger.warning(\n   267→                \"auth.email_fallback\",\n   268→                email_redacted=email_redacted,\n   269→                message=\"Email service unavailable\",\n   270→            )\n   271→            return RequestLinkResponse(\n   272→                message=\"Check your email for a login link.\",\n   273→            )\n   274→\n   275→\n   276→@router.post(\"/verify\", response_model=AuthResponse)\n   277→async def verify_magic_link(\n   278→    payload: VerifyTokenPayload,\n   279→    db: AsyncSession = Depends(get_db),\n   280→):\n   281→    \"\"\"\n   282→    Verify a magic link token and return a JWT access token.\n   283→\n   284→    The magic link token is single-use and time-limited.\n   285→    \"\"\"\n   286→    result = await db.execute(\n   287→        select(MagicLink).where(MagicLink.token == payload.token)\n   288→    )\n   289→    magic_link = result.scalar_one_or_none()\n   290→\n   291→    if not magic_link:\n   292→        raise HTTPException(status_code=401, detail=\"Invalid or expired link\")\n   293→\n   294→    if magic_link.is_used:\n   295→        raise HTTPException(status_code=401, detail=\"This link has already been used\")\n   296→\n   297→    if magic_link.expires_at.replace(tzinfo=timezone.utc) < datetime.now(timezone.utc):\n   298→        raise HTTPException(status_code=401, detail=\"This link has expired\")\n   299→\n   300→    # Mark as used\n   301→    magic_link.is_used = True\n   302→\n   303→    # Get the user\n   304→    user_result = await db.execute(\n   305→        select(User).where(User.id == magic_link.user_id)\n   306→    )\n   307→    user = user_result.scalar_one_or_none()\n   308→    if not user:\n   309→        raise HTTPException(status_code=401, detail=\"User not found\")\n   310→\n   311→    # Update last login\n   312→    user.last_login_at = datetime.now(timezone.utc)\n   313→    await db.commit()\n   314→\n   315→    # Issue JWT\n   316→    access_token = create_jwt(user.id, user.email)\n   317→\n   318→    logger.info(\n   319→        \"auth.login_success\",\n   320→        email_redacted=redact_email(user.email),\n   321→        user_id=str(user.id),\n   322→    )\n   323→\n   324→    return AuthResponse(\n   325→        access_token=access_token,\n   326→        user_id=str(user.id),\n   327→        email=user.email,\n   328→        is_onboarded=user.is_onboarded,\n   329→    )\n   330→\n   331→\n   332→@router.get(\"/me\", response_model=UserResponse)\n   333→async def get_me(\n   334→    current_user: User = Depends(get_current_user),\n   335→):\n   336→    \"\"\"Get the current authenticated user's info.\"\"\"\n   337→    return UserResponse(\n   338→        id=str(current_user.id),\n   339→        email=current_user.email,\n   340→        name=current_user.name,\n   341→        is_onboarded=current_user.is_onboarded,\n   342→        candidate_id=str(current_user.candidate_id) if current_user.candidate_id else None,\n   343→        created_at=current_user.created_at.isoformat(),\n   344→    )\n   345→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"ef3e1c9a-082e-4b26-be4b-f026a2179071","uuid":"1c10ffd1-9c78-45b6-82c4-e19775e76618","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/api/auth.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nAuthentication API — passwordless magic link flow.\n\nPOST  /auth/request-link     → request a magic login link\nPOST  /auth/verify            → verify magic link token, return JWT\nGET   /auth/me                → get current authenticated user\n\"\"\"\n\nimport uuid\nimport secrets\nfrom datetime import datetime, timedelta, timezone\n\nimport jwt\nimport resend\nimport structlog\nfrom fastapi import APIRouter, Depends, HTTPException, Request\nfrom fastapi.security import HTTPBearer, HTTPAuthorizationCredentials\nfrom pydantic import BaseModel, EmailStr\nfrom sqlalchemy import select\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom backend.config import settings\nfrom backend.database import get_db\nfrom backend.models.auth import User, MagicLink\n\nlogger = structlog.get_logger(__name__)\nrouter = APIRouter()\nsecurity = HTTPBearer(auto_error=False)\n\n\n# ─── PII Redaction ────────────────────────────────────────────────────────────\n\ndef redact_email(email: str) -> str:\n    \"\"\"Redact email for safe logging. e.g. 'spy@seanyoung.biz' → 's**@s***.biz'\"\"\"\n    if not email or \"@\" not in email:\n        return \"[redacted]\"\n    local, domain = email.split(\"@\", 1)\n    domain_parts = domain.rsplit(\".\", 1)\n    redacted_local = local[0] + \"**\" if local else \"**\"\n    if len(domain_parts) == 2:\n        redacted_domain = domain_parts[0][0] + \"***.\" + domain_parts[1]\n    else:\n        redacted_domain = \"***\"\n    return f\"{redacted_local}@{redacted_domain}\"\n\n\n# ─── Schemas ─────────────────────────────────────────────────────────────────\n\nclass RequestLinkPayload(BaseModel):\n    \"\"\"Payload to request a magic link.\"\"\"\n    email: EmailStr\n\n\nclass RequestLinkResponse(BaseModel):\n    \"\"\"Response after requesting a magic link.\"\"\"\n    message: str\n    # In dev mode, we return the magic link directly so you can click it\n    magic_link: str | None = None\n    token: str | None = None\n\n\nclass VerifyTokenPayload(BaseModel):\n    \"\"\"Payload to verify a magic link token.\"\"\"\n    token: str\n\n\nclass AuthResponse(BaseModel):\n    \"\"\"Response with JWT access token.\"\"\"\n    access_token: str\n    token_type: str = \"bearer\"\n    user_id: str\n    email: str\n    is_onboarded: bool\n\n\nclass UserResponse(BaseModel):\n    \"\"\"Current user info.\"\"\"\n    id: str\n    email: str\n    name: str | None\n    is_onboarded: bool\n    candidate_id: str | None\n    created_at: str\n\n\n# ─── JWT Helpers ─────────────────────────────────────────────────────────────\n\ndef create_jwt(user_id: uuid.UUID, email: str) -> str:\n    \"\"\"Create a JWT access token for an authenticated user.\"\"\"\n    payload = {\n        \"sub\": str(user_id),\n        \"email\": email,\n        \"iat\": datetime.now(timezone.utc),\n        \"exp\": datetime.now(timezone.utc) + timedelta(days=7),\n    }\n    return jwt.encode(payload, settings.jwt_secret, algorithm=\"HS256\")\n\n\ndef decode_jwt(token: str) -> dict:\n    \"\"\"Decode and validate a JWT token.\"\"\"\n    try:\n        return jwt.decode(token, settings.jwt_secret, algorithms=[\"HS256\"])\n    except jwt.ExpiredSignatureError:\n        raise HTTPException(status_code=401, detail=\"Token expired\")\n    except jwt.InvalidTokenError:\n        raise HTTPException(status_code=401, detail=\"Invalid token\")\n\n\n# ─── Resend Email ─────────────────────────────────────────────────────────────\n\nasync def send_magic_link_email(email: str, magic_link_url: str) -> bool:\n    \"\"\"\n    Send magic link email via Resend.\n\n    Returns True if email was sent successfully, False otherwise.\n    Falls back gracefully if Resend is not configured.\n    \"\"\"\n    if not settings.resend_api_key:\n        logger.warning(\n            \"auth.resend_not_configured\",\n            email_redacted=redact_email(email),\n            message=\"Resend API key not set, email not sent\",\n        )\n        return False\n\n    resend.api_key = settings.resend_api_key\n\n    try:\n        resend.Emails.send({\n            \"from\": settings.resend_from_email,\n            \"to\": email,\n            \"subject\": \"Your Talent Agent Login Link\",\n            \"html\": f\"\"\"\n            <div style=\"font-family: 'DM Sans', -apple-system, sans-serif; max-width: 600px; margin: 0 auto; padding: 40px 20px; background-color: #0A0A0A; color: #FAFAFA;\">\n                <h1 style=\"font-family: 'Playfair Display', Georgia, serif; color: #C9A227; font-size: 28px; margin-bottom: 24px;\">\n                    Talent Agent\n                </h1>\n                <p style=\"font-size: 16px; line-height: 1.6; margin-bottom: 24px;\">\n                    Click the button below to sign in to your account. This link expires in {settings.magic_link_expiry_minutes} minutes.\n                </p>\n                <a href=\"{magic_link_url}\" style=\"display: inline-block; background-color: #C9A227; color: #0A0A0A; padding: 14px 28px; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px;\">\n                    Sign In\n                </a>\n                <p style=\"font-size: 14px; color: #737373; margin-top: 32px; line-height: 1.6;\">\n                    If you didn't request this link, you can safely ignore this email.\n                </p>\n                <hr style=\"border: none; border-top: 1px solid rgba(255,255,255,0.08); margin: 32px 0;\">\n                <p style=\"font-size: 12px; color: #737373;\">\n                    VibeSpace LLC · The Dot Connects\n                </p>\n            </div>\n            \"\"\",\n        })\n        logger.info(\n            \"auth.email_sent\",\n            email_redacted=redact_email(email),\n        )\n        return True\n    except Exception as e:\n        logger.error(\n            \"auth.email_send_failed\",\n            email_redacted=redact_email(email),\n            error=str(e),\n        )\n        return False\n\n\n# ─── Auth Dependency ─────────────────────────────────────────────────────────\n\nasync def get_current_user(\n    credentials: HTTPAuthorizationCredentials | None = Depends(security),\n    db: AsyncSession = Depends(get_db),\n) -> User:\n    \"\"\"FastAPI dependency that returns the current authenticated user.\"\"\"\n    if credentials is None:\n        raise HTTPException(status_code=401, detail=\"Not authenticated\")\n\n    payload = decode_jwt(credentials.credentials)\n    user_id = payload.get(\"sub\")\n    if not user_id:\n        raise HTTPException(status_code=401, detail=\"Invalid token payload\")\n\n    result = await db.execute(\n        select(User).where(User.id == uuid.UUID(user_id))\n    )\n    user = result.scalar_one_or_none()\n    if not user or not user.is_active:\n        raise HTTPException(status_code=401, detail=\"User not found or inactive\")\n\n    return user\n\n\n# ─── Endpoints ───────────────────────────────────────────────────────────────\n\n@router.post(\"/request-link\", response_model=RequestLinkResponse)\nasync def request_magic_link(\n    payload: RequestLinkPayload,\n    request: Request,\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"\n    Request a magic login link. Creates user if they don't exist.\n\n    In dev mode (DEBUG=true), returns the magic link directly in the response\n    so you can click it without needing email infrastructure.\n    In production, sends the link via Resend email service.\n    \"\"\"\n    email = payload.email.lower().strip()\n    email_redacted = redact_email(email)\n\n    # Find or create user\n    result = await db.execute(select(User).where(User.email == email))\n    user = result.scalar_one_or_none()\n\n    if not user:\n        user = User(email=email)\n        db.add(user)\n        await db.flush()\n        logger.info(\n            \"auth.user_created\",\n            email_redacted=email_redacted,\n            user_id=str(user.id),\n        )\n\n    # Generate magic link token\n    token = secrets.token_urlsafe(48)\n    expires_at = datetime.now(timezone.utc) + timedelta(minutes=settings.magic_link_expiry_minutes)\n\n    magic_link_record = MagicLink(\n        user_id=user.id,\n        token=token,\n        expires_at=expires_at,\n    )\n    db.add(magic_link_record)\n    await db.commit()\n\n    # Build the magic link URL using frontend origin\n    origin = request.headers.get(\"origin\", \"http://localhost:5173\")\n    magic_link_url = f\"{origin}/auth/verify?token={token}\"\n\n    logger.info(\n        \"auth.magic_link_created\",\n        email_redacted=email_redacted,\n        expires_at=expires_at.isoformat(),\n    )\n\n    if settings.debug:\n        # Dev mode: return link directly for easy testing\n        return RequestLinkResponse(\n            message=\"Magic link created. Click to log in.\",\n            magic_link=magic_link_url,\n            token=token,\n        )\n    else:\n        # Production: send email via Resend\n        email_sent = await send_magic_link_email(email, magic_link_url)\n        if email_sent:\n            return RequestLinkResponse(\n                message=\"Check your email for a login link.\",\n            )\n        else:\n            # Graceful degradation if email fails\n            logger.warning(\n                \"auth.email_fallback\",\n                email_redacted=email_redacted,\n                message=\"Email service unavailable\",\n            )\n            return RequestLinkResponse(\n                message=\"Check your email for a login link.\",\n            )\n\n\n@router.post(\"/verify\", response_model=AuthResponse)\nasync def verify_magic_link(\n    payload: VerifyTokenPayload,\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"\n    Verify a magic link token and return a JWT access token.\n\n    The magic link token is single-use and time-limited.\n    \"\"\"\n    result = await db.execute(\n        select(MagicLink).where(MagicLink.token == payload.token)\n    )\n    magic_link = result.scalar_one_or_none()\n\n    if not magic_link:\n        raise HTTPException(status_code=401, detail=\"Invalid or expired link\")\n\n    if magic_link.is_used:\n        raise HTTPException(status_code=401, detail=\"This link has already been used\")\n\n    if magic_link.expires_at.replace(tzinfo=timezone.utc) < datetime.now(timezone.utc):\n        raise HTTPException(status_code=401, detail=\"This link has expired\")\n\n    # Mark as used\n    magic_link.is_used = True\n\n    # Get the user\n    user_result = await db.execute(\n        select(User).where(User.id == magic_link.user_id)\n    )\n    user = user_result.scalar_one_or_none()\n    if not user:\n        raise HTTPException(status_code=401, detail=\"User not found\")\n\n    # Update last login\n    user.last_login_at = datetime.now(timezone.utc)\n    await db.commit()\n\n    # Issue JWT\n    access_token = create_jwt(user.id, user.email)\n\n    logger.info(\n        \"auth.login_success\",\n        email_redacted=redact_email(user.email),\n        user_id=str(user.id),\n    )\n\n    return AuthResponse(\n        access_token=access_token,\n        user_id=str(user.id),\n        email=user.email,\n        is_onboarded=user.is_onboarded,\n    )\n\n\n@router.get(\"/me\", response_model=UserResponse)\nasync def get_me(\n    current_user: User = Depends(get_current_user),\n):\n    \"\"\"Get the current authenticated user's info.\"\"\"\n    return UserResponse(\n        id=str(current_user.id),\n        email=current_user.email,\n        name=current_user.name,\n        is_onboarded=current_user.is_onboarded,\n        candidate_id=str(current_user.candidate_id) if current_user.candidate_id else None,\n        created_at=current_user.created_at.isoformat(),\n    )\n","numLines":345,"startLine":1,"totalLines":345}}}}
