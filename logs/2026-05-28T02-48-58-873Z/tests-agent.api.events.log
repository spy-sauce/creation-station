     - apply-agent\n      - scheduler-agent\n    capabilities:\n      - postgresql\n      - sqlalchemy\n      - alembic\n      - pydantic\n    sub_agents:\n      - id: data-agent.migrations.init\n        scope: backend/migrations/001_init.sql — extensions, candidates table baseline\n      - id: data-agent.migrations.discovery\n        scope: backend/migrations/002_discovery.sql — discovered_jobs, scored_jobs,\n          daily_digests, crawl_runs per HYPHA-SCHEMA-CORE\n      - id: data-agent.migrations.application\n        scope: backend/migrations/003_application.sql — applications,\n          application_events, outreach_messages, contacts\n      - id: data-agent.migrations.auth\n        scope: backend/migrations/004_auth.sql — magic_link_tokens, sessions\n      - id: data-agent.models.base\n        scope: backend/models/__init__.py + base Declarative class with UUID PK +\n          created_at/updated_at mixins\n      - id: data-agent.models.discovery\n        scope: backend/models/discovery.py — Candidate, DiscoveredJob, ScoredJob,\n          DailyDigest, CrawlRun ORM\n      - id: data-agent.models.application\n        scope: backend/models/application.py — Application, ApplicationEvent,\n          OutreachMessage, Contact ORM\n      - id: data-agent.models.auth\n        scope: backend/models/auth.py — MagicLinkToken, Session ORM\n      - id: data-agent.schemas.discovery\n        scope: backend/agents/discovery/schemas.py — Pydantic v2 schemas for all\n          discovery contracts\n      - id: data-agent.schemas.application\n        scope: backend/agents/application/schemas.py — Pydantic v2 schemas for\n          application contracts\n  - id: design-agent\n    scope: Design tokens, Top Shelf editorial, CSS custom properties, typography,\n      StatusBadge, StatCard\n    branch: feat/design-agent\n    blocked_by: []\n    blocks:\n      - frontend-agent\n    capabilities:\n      - tailwind\n      - css-tokens\n      - design-system\n    sub_agents:\n      - id: design-agent.tokens.palette\n        scope: frontend/src/design/tokens.css — Top Shelf palette as CSS custom\n          properties (--ink, --paper, --gold, severity colors)\n      - id: design-agent.tokens.typography\n        scope: frontend/src/design/typography.css — font stacks + scale + line-heights\n      - id: design-agent.tokens.spacing\n        scope: frontend/src/design/spacing.css — 4px-based spacing scale + radius tokens\n      - id: design-agent.primitives.status-badge\n        scope: frontend/src/components/StatusBadge.tsx — variant prop per agent\n          lifecycle state, identity-color border\n      - id: design-agent.primitives.stat-card\n        scope: frontend/src/components/StatCard.tsx — title + value + delta + sparkline\n          slot\n      - id: design-agent.docs.cheatsheet\n        scope: frontend/src/design/CHEATSHEET.md — token names, usage rules, do/don't\n      - id: design-agent.docs.reference\n        scope: frontend/src/design/REFERENCE.md — full token table + component gallery\n  - id: auth-agent\n    scope: JWT issuance, magic-link flow, Resend integration, get_current_user\n      dependency\n    branch: feat/auth-agent\n    blocked_by:\n      - data-agent\n    blocks:\n      - api-agent\n      - frontend-agent\n      - api-streaming-agent\n    capabilities:\n      - jwt\n      - resend\n      - fastapi-deps\n    sub_agents:\n      - id: auth-agent.magic-link.request\n        scope: backend/api/auth.py POST /auth/magic-link — issue token, send via Resend,\n          rate-limit 3/hour/email\n      - id: auth-agent.magic-link.verify\n        scope: backend/api/auth.py POST /auth/verify — validate token, mint JWT, return\n          session cookie\n      - id: auth-agent.magic-link.resend\n        scope: backend/api/auth.py POST /auth/resend — invalidate prior token, issue new\n      - id: auth-agent.jwt.issue\n        scope: backend/auth/jwt.py issue_jwt(candidate_id, ttl_hours=24) — HS256, signed\n          with settings.jwt_secret\n      - id: auth-agent.jwt.validate\n        scope: backend/auth/jwt.py validate_jwt(token) — raise on expired/invalid\n      - id: auth-agent.jwt.current-user\n        scope: backend/auth/deps.py get_current_user FastAPI dependency — reads cookie\n          or Authorization header, loads Candidate\n  - id: obs-agent\n    scope: \"Observability: structlog config, PII redaction, Redis pub/sub taxonomy,\n      CRM events, health endpoint\"\n    branch: feat/obs-agent\n    blocked_by:\n      - data-agent\n    blocks:\n      - api-agent\n      - discover-agent\n      - apply-agent\n      - api-streaming-agent\n    capabilities:\n      - structlog\n      - redis-pubsub\n      - logging\n    sub_agents:\n      - id: obs-agent.logging.config\n        scope: backend/obs/logging.py — structlog config, JSON renderer in prod, console\n          in dev, request-id correlation\n      - id: obs-agent.logging.pii-redact\n        scope: backend/obs/redact.py — processor that scrubs emails, phones, resumes,\n          tokens before log emission\n      - id: obs-agent.pubsub.taxonomy\n        scope: backend/obs/events.py — channel constants + payload schemas\n          (agent.status.{name}, digest.ready, application.event)\n      - id: obs-agent.pubsub.publisher\n        scope: backend/obs/publisher.py — publish_event(channel, payload) async helper\n          with retry + dead-letter logging\n  - id: apply-agent\n    scope: \"Application engine: JD parser, resume tailor, company intel, contact\n      finder, outreach composer, auto-apply\"\n    branch: feat/apply-agent\n    blocked_by:\n      - data-agent\n      - obs-agent\n      - discover-agent\n    blocks:\n      - agents-agent\n    capabilities:\n      - anthropic-sdk\n      - playwright\n      - pydantic\n    sub_agents:\n      - id: apply-agent.jd-parser\n        scope: backend/agents/application/jd_parser.py — Claude extracts requirements,\n          responsibilities, comp signal from raw_description\n      - id: apply-agent.resume-tailor\n        scope: backend/agents/application/resume_tailor.py — emphasize matching\n          experience without fabricating skills\n      - id: apply-agent.company-intel\n        scope: backend/agents/application/company_intel.py — Claude + web fetch for\n          mission, recent news, funding signal\n      - id: apply-agent.contact-finder\n        scope: backend/agents/application/contact_finder.py — LinkedIn/Hunter pivot to\n          recruiter or hiring manager\n      - id: apply-agent.outreach.composer\n        scope: backend/agents/application/outreach_composer.py — personalized opener +\n          value pitch + call to action\n      - id: apply-agent.auto-apply.greenhouse\n        scope: backend/agents/application/auto_apply.py Greenhouse path — uses\n          ats_selectors.yaml for field mapping\n      - id: apply-agent.auto-apply.lever\n        scope: backend/agents/application/auto_apply.py Lever path — split single 'name'\n          into first/last\n      - id: apply-agent.auto-apply.ashby\n        scope: backend/agents/application/auto_apply.py Ashby path — _systemfield_name\n          combined-name handling\n      - id: apply-agent.auto-apply.workday\n        scope: backend/agents/application/auto_apply.py Workday path — multi-step\n          continuation, account creation flow, file upload\n      - id: apply-agent.orchestrator\n        scope: backend/agents/application/orchestrator.py — ApplicationOrchestrator\n          wires all sub-agents + Application state machine +\n          agent.status.application pub/sub\n  - id: agents-agent\n    scope: \"AgentManager: Claude tool_use agentic loop, sub-agent registry, pipeline\n      dispatcher, execution records\"\n    branch: feat/agents-agent\n    blocked_by:\n      - apply-agent\n    blocks:\n      - api-agent\n    capabilities:\n      - anthropic-sdk\n      - tool-use\n      - redis-pubsub\n    sub_agents:\n      - id: agents-agent.registry.defaults\n        scope: backend/agents/manager/registry.py — default sub-agent registry mapping\n          {discover, apply, score, compose} → handler\n      - id: agents-agent.runner.execute\n        scope: backend/agents/manager/runner.py — Claude tool_use agentic loop, max-iter\n          guard, structured result envelope\n      - id: agents-agent.runner.retry\n        scope: backend/agents/manager/retry.py — exponential backoff retry policy with\n          dead-letter logging on terminal failure\n      - id: agents-agent.dispatcher.pipeline\n        scope: backend/agents/manager/dispatcher.py — multi-step pipeline orchestration\n          across registered handlers\n  - id: api-agent\n    scope: FastAPI app, routers, middleware, health endpoint, CORS, database wiring\n    branch: feat/api-agent\n    blocked_by:\n      - data-agent\n      - auth-agent\n      - obs-agent\n      - agents-agent\n    blocks:\n      - frontend-agent\n      - infra-agent\n      - api-client-agent\n      - api-streaming-agent\n    capabilities:\n      - fastapi\n      - pydantic\n      - sqlalchemy\n      - uvicorn\n    sub_agents:\n      - id: api-agent.core.main\n        scope: backend/main.py — FastAPI app factory, router registration, lifespan (db\n          + redis init)\n      - id: api-agent.core.config\n        scope: backend/config.py — Pydantic Settings, env loading, secret resolution\n      - id: api-agent.core.database\n        scope: backend/database.py — async SQLAlchemy engine, session factory, redis\n          client factory, get_db dependency\n      - id: api-agent.routers.discovery\n        scope: backend/api/discovery.py — GET /digest/today, POST /discovery/run, GET\n          /jobs/{id}\n      - id: api-agent.routers.application\n        scope: backend/api/application.py — POST /applications, GET /applications, POST\n          /applications/{id}/approve, POST /applications/{id}/reject\n      - id: api-agent.routers.review\n        scope: backend/api/review.py — GET /review/queue, POST /review/{id}/decision\n      - id: api-agent.onboarding.resume-profile\n        scope: backend/api/onboarding.py — POST /onboarding/resume upload + profile\n          build + initial archetype expansion\n      - id: api-agent.health.endpoint\n        scope: backend/api/health.py — GET /health, GET /readiness with db + redis\n          probes\n  - id: frontend-agent\n    scope: React 19 + Vite 8 frontend, UI primitives, routing, auth context, pages\n    branch: feat/frontend-agent\n    blocked_by:\n      - design-agent\n      - api-agent\n    blocks:\n      - infra-agent\n      - api-client-agent\n    capabilities:\n      - react\n      - vite\n      - tailwind\n      - lucide-react\n      - react-router-dom\n    sub_agents:\n      - id: frontend-agent.primitives.button\n        scope: frontend/src/components/ui/Button.tsx — variant + size + loading state\n      - id: frontend-agent.primitives.input\n        scope: frontend/src/components/ui/Input.tsx — labeled, error state, helper text\n      - id: frontend-agent.primitives.card\n        scope: frontend/src/components/ui/Card.tsx — header/body/footer composition\n      - id: frontend-agent.primitives.dialog\n        scope: frontend/src/components/ui/Dialog.tsx — accessible modal with backdrop +\n          Escape close\n      - id: frontend-agent.layout.sidebar\n        scope: frontend/src/layout/Sidebar.tsx — nav links, active state, brand seal\n      - id: frontend-agent.layout.dashboard\n        scope: frontend/src/layout/DashboardLayout.tsx — sidebar + topbar + content slot\n          + auth guard\n      - id: frontend-agent.auth-flow.login\n        scope: frontend/src/pages/Login.tsx — magic-link request form\n      - id: frontend-agent.auth-flow.verify\n        scope: frontend/src/pages/Verify.tsx — token-in-url handler, JWT storage,\n          redirect\n      - id: frontend-agent.auth-flow.context\n        scope: frontend/src/auth/AuthContext.tsx — provider, useAuth hook, refresh logic\n      - id: frontend-agent.onboarding.wizard\n        scope: frontend/src/pages/Onboarding.tsx — resume upload → profile preview →\n          confirmation\n      - id: frontend-agent.dashboard.overview\n        scope: frontend/src/pages/Overview.tsx — today's digest, hot picks, agent\n          activity\n      - id: frontend-agent.dashboard.pipeline\n        scope: frontend/src/pages/Pipeline.tsx — kanban of applications across stages\n      - id: frontend-agent.dashboard.analytics\n        scope: frontend/src/pages/Analytics.tsx — funnel, conversion, source breakdown\n      - id: frontend-agent.review-queue.list\n        scope: frontend/src/pages/ReviewQueue.tsx — list of pending approvals with quick\n          actions\n      - id: frontend-agent.review-queue.detail\n        scope: frontend/src/pages/ReviewDetail.tsx — full artifact panes (JD, tailored\n          resume, outreach, contact) + approve/reject\n  - id: discover-agent\n    scope: \"Discovery engine: identity profiler, archetype generator, multi-source\n      crawler, relevance scorer, digest builder, pub/sub gap closure\"\n    branch: feat/discover-agent\n    blocked_by:\n      - data-agent\n      - obs-agent\n    blocks:\n      - apply-agent\n      - scheduler-agent\n      - api-streaming-agent\n    capabilities:\n      - anthropic-sdk\n      - httpx\n      - playwright\n      - redis\n      - redis-pubsub\n    sub_agents:\n      - id: discover-agent.identity.profiler\n        scope: backend/agents/discovery/identity_profiler.py — Claude-driven\n          IdentityProfile builder + 24h Redis cache\n      - id: discover-agent.archetype.generator\n        scope: backend/agents/discovery/archetype_generator.py — IdentityProfile →\n          SearchManifest expansion with exclusions\n      - id: discover-agent.crawler.greenhouse\n        scope: backend/agents/discovery/crawler_agent.py GreenhouseAdapter — httpx\n          async, boards.greenhouse.io/{slug}.json\n      - id: discover-agent.crawler.lever\n        scope: backend/agents/discovery/crawler_agent.py LeverAdapter — httpx async,\n          api.lever.co/v0/postings/{slug}\n      - id: discover-agent.crawler.ashby\n        scope: backend/agents/discovery/crawler_agent.py AshbyAdapter — httpx async,\n          api.ashbyhq.com/posting-api/job-board/{slug}\n      - id: discover-agent.crawler.workday\n        scope: backend/agents/discovery/crawler_agent.py WorkdayAdapter — playwright\n          async, {tenant}.wd1.myworkdayjobs.com/{board}\n      - id: discover-agent.scorer.relevance\n        scope: backend/agents/discovery/relevance_scorer.py — 6-dimension weighted\n          scoring + is_hot threshold\n      - id: discover-agent.digest.builder\n        scope: backend/agents/discovery/digest_builder.py — compile DailyDigest from\n          scored jobs\n      - id: discover-agent.orchestrator\n        scope: backend/agents/discovery/orchestrator.py — DiscoveryOrchestrator.run\n          wires all 5 sub-agents + CrawlRun state + agent.status.discovery\n          pub/sub\n      - id: discover-agent.pubsub\n        scope: backend/agents/discovery/orchestrator.py _publish_status helper — emit\n          events to agent.status.discovery channel per pattern from\n          application/orchestrator.py\n  - id: infra-agent\n    scope: Docker, docker-compose, AWS ECS Fargate, Digital Dash pipeline, deploy\n      scripts, Celery containers\n    branch: feat/infra-agent\n    blocked_by:\n      - api-agent\n      - frontend-agent\n      - scheduler-agent\n    blocks: []\n    capabilities:\n      - docker\n      - ecs\n      - ecr\n      - alb\n      - digital-dash\n      - celery\n    sub_agents:\n      - id: infra-agent.docker.backend\n        scope: backend/Dockerfile — python:3.12-slim, requirements caching, non-root\n          user\n        artifact: deploy/Dockerfile.backend\n      - id: infra-agent.docker.frontend\n        scope: frontend/Dockerfile — node build stage + nginx serve stage\n        artifact: deploy/Dockerfile.frontend\n      - id: infra-agent.docker.compose\n        scope: docker-compose.yml — postgres + redis + backend + frontend +\n          celery-worker + celery-beat with healthchecks\n        artifact: docker-compose.yml\n      - id: infra-agent.ecs.task-defs\n        scope: deploy/ecs-task-def-backend.json + ecs-task-def-frontend.json +\n          ecs-task-def-celery-worker.json + ecs-task-def-celery-beat.json\n        artifact: deploy/ecs-task-def-*.json\n      - id: infra-agent.ecs.bootstrap\n        scope: deploy/setup-aws.sh — one-time VPC, ALB, ECR, ECS cluster, RDS,\n          ElastiCache + Celery IAM role\n        artifact: deploy/setup-aws.sh\n      - id: infra-agent.pipeline.digital-dash\n        scope: digital-dash-pipeline.yml — build, test, push, deploy stages with\n          approval gate + deploy-celery stage\n        artifact: .github/workflows/digital-dash-pipeline.yml\n  - id: scheduler-agent\n    scope: \"Celery beat wiring: app factory, daily discovery task, beat schedule,\n      retry policy\"\n    branch: feat/scheduler-agent\n    blocked_by:\n      - data-agent\n      - discover-agent\n    blocks:\n      - infra-agent\n    capabilities:\n      - celery\n      - redis\n      - asyncio\n    sub_agents:\n      - id: scheduler-agent.app\n        scope: backend/scheduler/celery_app.py — Celery app factory reading broker URL\n          from settings.redis_url\n      - id: scheduler-agent.tasks\n        scope: backend/scheduler/tasks.py — daily_discovery_task(candidate_id) wrapping\n          async orchestrator.run\n      - id: scheduler-agent.beat\n        scope: backend/scheduler/beat.py — Beat schedule 07:00 America/New_York,\n          iterates active candidates\n      - id: scheduler-agent.retry\n        scope: backend/scheduler/tasks.py — exponential backoff 60s/300s/900s,\n          dead-letter to crawl_runs.error_log\n  - id: api-streaming-agent\n    scope: SSE event stream endpoint for real-time agent status streaming\n    branch: feat/api-streaming-agent\n    blocked_by:\n      - api-agent\n      - auth-agent\n      - obs-agent\n      - discover-agent\n    blocks:\n      - api-client-agent\n    capabilities:\n      - fastapi\n      - sse\n      - redis-pubsub\n    sub_agents:\n      - id: api-streaming-agent.events\n        scope: backend/api/events.py — GET /events/stream?channel=... SSE endpoint\n      - id: api-streaming-agent.subscriber\n        scope: backend/api/events.py — Redis pub/sub subscriber with channel allowlist\n      - id: api-streaming-agent.heartbeat\n        scope: backend/api/events.py — :ping every 15s for connection loss detection\n      - id: api-streaming-agent.backpressure\n        scope: backend/api/events.py — drop >100 messages behind, emit slow_client event\n  - id: api-client-agent\n    scope: \"Frontend API client wiring: fetch wrapper, auth token injection, page\n      data integration\"\n    branch: feat/api-client-agent\n    blocked_by:\n      - api-agent\n      - frontend-agent\n      - api-streaming-agent\n    blocks:\n      - tests-agent\n    capabilities:\n      - typescript\n      - fetch\n      - eventsource\n    sub_agents:\n      - id: api-client-agent.client\n        scope: frontend/src/api/client.ts — single apiClient instance, base URL from\n          VITE_API_BASE_URL\n      - id: api-client-agent.auth\n        scope: frontend/src/api/auth.ts — requestMagicLink, verifyToken, refreshSession,\n          JWT in localStorage\n      - id: api-client-agent.discovery\n        scope: frontend/src/api/discovery.ts — getTodayDigest, triggerDiscoveryRun,\n          getJob\n      - id: api-client-agent.applications\n        scope: frontend/src/api/applications.ts — listApplications, approveApplication,\n          rejectApplication\n      - id: api-client-agent.events\n        scope: frontend/src/api/events.ts — subscribeAgentStatus(channel, onMessage) via\n          EventSource\n      - id: api-client-agent.error-handling\n        scope: frontend/src/api/client.ts — 401 → invalidate JWT, redirect to /login,\n          toast\n      - id: api-client-agent.page-wiring\n        scope: Re-wire Overview.tsx, Pipeline.tsx, Analytics.tsx, ReviewQueue.tsx,\n          ReviewDetail.tsx to use apiClient\n  - id: tests-agent\n    scope: pytest and vitest test suites for all iter-4 biomes\n    branch: feat/tests-agent\n    blocked_by:\n      - discover-agent\n      - scheduler-agent\n      - api-streaming-agent\n      - api-client-agent\n    blocks: []\n    capabilities:\n      - pytest\n      - vitest\n      - fakeredis\n    sub_agents:\n      - id: tests-agent.discovery.pubsub\n        scope: tests/discovery/test_orchestrator_pubsub.py — fake Redis, verify 8+ event\n          sequence\n      - id: tests-agent.scheduler.daily\n        scope: tests/scheduler/test_daily_task.py — mock orchestrator, verify crawl_runs\n          creation\n      - id: tests-agent.api.events\n        scope: tests/api/test_events_stream.py — TestClient streaming, verify SSE frames\n          + heartbeat\n      - id: tests-agent.api.review\n        scope: tests/api/test_review_approve.py — full integration approve flow\n      - id: tests-agent.frontend.client\n        scope: frontend/src/api/__tests__/client.test.ts — vitest, mock fetch, 401\n          handling\nmerge_order:\n  - data-agent\n  - design-agent\n  - auth-agent\n  - obs-agent\n  - discover-agent\n  - apply-agent\n  - agents-agent\n  - api-agent\n  - scheduler-agent\n  - api-streaming-agent\n  - frontend-agent\n  - api-client-agent\n  - infra-agent\n  - tests-agent\ntimeline:\n  parallel_phases:\n    - hours: 0-1\n      active:\n        - data-agent\n        - design-agent\n      description: Wave 1 — foundations with zero cross-biome deps. Schemas + models +\n        design tokens land first so every downstream biome consumes frozen\n        contracts.\n    - hours: 1-3\n      active:\n        - auth-agent\n        - obs-agent\n      description: Wave 2 — core services depending only on data. Auth + observability\n        wire on top of the schema, both consumed by every engine below.\n    - hours: 3-5\n      active:\n        - discover-agent\n      description: Wave 3a — Discovery engine with pub/sub gap closure. Must publish\n        events on agent.status.discovery channel.\n    - hours: 5-7\n      active:\n        - scheduler-agent\n        - api-streaming-agent\n      description: Wave 3b — Scheduler and streaming in parallel. Scheduler consumes\n        discover-agent, streaming consumes obs-agent.\n    - hours: 7-8\n      active:\n        - apply-agent\n      description: Wave 4 — Application engine, blocked by discover-agent.\n    - hours: 8-9\n      active:\n        - agents-agent\n      description: Wave 5 — AgentManager wrapper over the engines.\n    - hours: 9-11\n      active:\n        - api-agent\n        - frontend-agent\n      description: Wave 6 — Surfaces. API + frontend land in parallel.\n    - hours: 11-12\n      active:\n        - api-client-agent\n      description: Wave 7 — Frontend API wiring, blocked by api-agent + api-streaming-agent.\n    - hours: 12-13\n      active:\n        - infra-agent\n      description: Wave 8 — Deploy. Docker + ECS + Digital Dash pipeline with Celery\n        containers.\n    - hours: 13-14\n      active:\n        - tests-agent\n      description: Wave 9 — Test sweep across all iter-4 biomes.\nbudget:\n  maxUsd: 100\n","numLines":693,"startLine":1,"totalLines":693}}}}
{"t":"2026-05-28T02:58:13.587Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YbMTzKKtaFHMDy5Y3cuGNS","type":"tool_result","content":"     1→# NUTRIENTS.md — Talent Agent Frozen Contracts\n     2→\n     3→> Frozen contract surface for the Talent Agent organism.\n     4→> Stack: `nextjs-fastapi-supabase` (fallback — real stack is React 19 + Vite 8 + FastAPI + PostgreSQL)\n     5→> Security tier: `startup`\n     6→\n     7→---\n     8→\n     9→## CONTRACT APPENDIX (verbatim → NUTRIENTS.md)\n    10→\n    11→This appendix is the frozen contract surface for any organism on the nextjs-fastapi-supabase stack. It exists to block the contract-drift class of failure: missing runtime deps, component prop drift, inconsistent styling, ad-hoc icon usage, and duplicate exports.\n    12→\n    13→> The mycelium planner MUST copy every subsection below verbatim into the matching section of NUTRIENTS.md. No paraphrasing. No placeholders. No `#TODO`. Sections C and E are partly verbatim (universal rules) and partly planner-generated (organism-specific rows the planner appends from the agent decomposition). Leaves reading NUTRIENTS treat these as frozen contracts — amendments only via FRUIT_READY contract-amendment line, never silent edits.\n    14→\n    15→### A. Dependency Manifest\n    16→\n    17→Single source of truth for runtime deps. Default owner is `frontend-agent` (web) or `api-agent` (Python). A biome that needs a package not on this list MUST emit `+dep:<pkg>@<ver> reason:<one-line>` on its FRUIT_READY line, or the orchestrator rejects the harvest.\n    18→\n    19→**Frontend (Next.js 14, App Router):**\n    20→- next@^14.2.0 — owner: frontend-agent\n    21→- react@^18.3.0 — owner: frontend-agent\n    22→- react-dom@^18.3.0 — owner: frontend-agent\n    23→- typescript@^5.4.0 — owner: frontend-agent\n    24→- @supabase/supabase-js@^2.39.0 — owner: frontend-agent\n    25→- @supabase/ssr@^0.1.0 — owner: frontend-agent\n    26→- tailwindcss@^3.4.0 — owner: frontend-agent\n    27→- class-variance-authority@^0.7.0 — owner: frontend-agent\n    28→- clsx@^2.1.0 — owner: frontend-agent\n    29→- tailwind-merge@^2.2.0 — owner: frontend-agent\n    30→- lucide-react@^0.330.0 — owner: frontend-agent\n    31→- @radix-ui/react-* — owner: frontend-agent (per-component pin in package.json)\n    32→- stripe@^14.0.0 — owner: payments-agent\n    33→- @stripe/stripe-js@^3.0.0 — owner: payments-agent\n    34→\n    35→**Backend (FastAPI, Python 3.11+):**\n    36→- fastapi>=0.110 — owner: api-agent\n    37→- uvicorn[standard]>=0.27 — owner: api-agent\n    38→- pydantic>=2.6 — owner: api-agent\n    39→- supabase>=2.4 — owner: api-agent\n    40→- python-jose[cryptography]>=3.3 — owner: auth-agent\n    41→- stripe>=8.0 — owner: payments-agent\n    42→- httpx>=0.26 — owner: api-agent\n    43→\n    44→Frontend is locked to Next.js App Router (NOT Pages Router). Backend is locked to FastAPI (NOT Express, NOT Flask).\n    45→\n    46→### B. Component Prop Contracts (TypeScript, frozen)\n    47→\n    48→Full TS interfaces for every shared primitive in `components/ui/`. Frozen: leaves cannot add, remove, or rename props. The frontend-agent biome MUST ship exactly these signatures. If a consumer biome needs a prop not listed, it amends the contract via FRUIT_READY contract-amendment line — never inlines a workaround.\n    49→\n    50→```ts\n    51→import type { ButtonHTMLAttributes, InputHTMLAttributes, HTMLAttributes, ReactNode } from 'react';\n    52→import type { LucideIcon } from 'lucide-react';\n    53→\n    54→export type Variant = 'default' | 'primary' | 'secondary' | 'ghost' | 'destructive' | 'outline';\n    55→export type Size = 'sm' | 'md' | 'lg';\n    56→\n    57→export interface ButtonProps extends ButtonHTMLAttributes<HTMLButtonElement> {\n    58→  children: ReactNode;\n    59→  variant?: Variant;\n    60→  size?: Size;\n    61→  loading?: boolean;\n    62→  fullWidth?: boolean;\n    63→  leftIcon?: LucideIcon;\n    64→  rightIcon?: LucideIcon;\n    65→  asChild?: boolean;\n    66→}\n    67→\n    68→export interface InputProps extends InputHTMLAttributes<HTMLInputElement> {\n    69→  label?: string;\n    70→  helperText?: string;\n    71→  error?: string;\n    72→  leftIcon?: LucideIcon;\n    73→  rightIcon?: LucideIcon;\n    74→}\n    75→\n    76→export interface CardProps extends HTMLAttributes<HTMLDivElement> {\n    77→  children: ReactNode;\n    78→  variant?: 'default' | 'elevated' | 'outlined' | 'flat';\n    79→  padding?: 'none' | 'sm' | 'md' | 'lg';\n    80→}\n    81→\n    82→export interface AvatarProps {\n    83→  src?: string;\n    84→  alt?: string;\n    85→  fallback?: string;  // initials\n    86→  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';\n    87→  shape?: 'circle' | 'square';\n    88→  className?: string;\n    89→}\n    90→\n    91→export interface BadgeProps {\n    92→  children: ReactNode;\n    93→  variant?: 'default' | 'primary' | 'success' | 'warning' | 'destructive';\n    94→  size?: 'sm' | 'md';\n    95→  className?: string;\n    96→}\n    97→\n    98→export interface SpinnerProps {\n    99→  size?: 'sm' | 'md' | 'lg';\n   100→  className?: string;\n   101→}\n   102→\n   103→export interface DialogProps {\n   104→  open: boolean;\n   105→  onOpenChange: (open: boolean) => void;\n   106→  children: ReactNode;\n   107→}\n   108→```\n   109→\n   110→### C. Symbol Ownership Matrix (baseline rows — planner appends organism rows)\n   111→\n   112→Every shared symbol has exactly ONE owner biome. No biome exports a symbol another biome has claimed. If a biome needs a symbol it does not own, it imports — never re-declares.\n   113→\n   114→The rows below are stack-universal — they exist in every nextjs-fastapi-supabase organism. The planner MUST append organism-specific rows below this baseline (entity types, hooks, page-level components) derived from the brief.\n   115→\n   116→| Symbol | Owner biome | File path |\n   117→|---|---|---|\n   118→| `createServerClient`, `createBrowserClient` | frontend-agent | `lib/supabase.ts` |\n   119→| `Button`, `ButtonProps` | frontend-agent | `components/ui/button.tsx` |\n   120→| `Input`, `InputProps` | frontend-agent | `components/ui/input.tsx` |\n   121→| `Card`, `CardProps` | frontend-agent | `components/ui/card.tsx` |\n   122→| `Avatar`, `AvatarProps` | frontend-agent | `components/ui/avatar.tsx` |\n   123→| `Badge`, `BadgeProps` | frontend-agent | `components/ui/badge.tsx` |\n   124→| `Dialog`, `DialogProps` | frontend-agent | `components/ui/dialog.tsx` |\n   125→| `Spinner`, `SpinnerProps` | frontend-agent | `components/ui/spinner.tsx` |\n   126→| `cn` (className merge) | frontend-agent | `lib/utils.ts` |\n   127→| `Variant`, `Size` | frontend-agent | `components/ui/types.ts` |\n   128→| `Settings` (Pydantic) | api-agent | `api/config.py` |\n   129→| `get_supabase_client` | api-agent | `api/lib/supabase.py` |\n   130→| `SessionUser` (Pydantic) | auth-agent | `api/auth/models.py` |\n   131→| `get_current_user` (FastAPI dependency) | auth-agent | `api/auth/deps.py` |\n   132→\n   133→### D. Barrel File Ownership\n   134→\n   135→Module ownership is enforced at the directory level. A biome may not write to a directory it does not own. Cross-biome imports go through public re-export points; never reach into a biome's internals.\n   136→\n   137→| Path | Owner biome | Allowed exports |\n   138→|---|---|---|\n   139→| `components/ui/` | frontend-agent | All UI primitives. Other biomes import via `@/components/ui/<name>`. |\n   140→| `components/<domain>/` | (per-biome) | Domain-specific components owned by the biome named `<domain>`. |\n   141→| `lib/` | frontend-agent | Cross-cutting utilities (supabase clients, cn, formatters). |\n   142→| `hooks/` | frontend-agent | Re-exports from each biome's hook tree. |\n   143→| `types/` | frontend-agent | Sole source of truth for domain entity types. |\n   144→| `app/` | frontend-agent | Next.js routes. Other biomes provide page-level components consumed by route segments. |\n   145→| `api/` | api-agent | FastAPI app + per-domain routers. Each domain biome contributes `api/<domain>/router.py`. |\n   146→| `api/auth/` | auth-agent | All auth-related Python modules. |\n   147→| `api/lib/` | api-agent | Shared Python utilities (DB, logging, settings). |\n   148→\n   149→Cardinal rule: a symbol appears in EXACTLY ONE module. Domain enums live in `types/`, NOT in component files.\n   150→\n   151→### E. Allow-listed Identifiers (universal rules — planner appends organism enums and route map)\n   152→\n   153→**Icons.** All icons MUST be `LucideIcon` from `lucide-react`. NEVER import from other icon libraries. NEVER inline SVGs in component code (use a static asset under `public/` if a custom glyph is needed and reference it via `<Image src=... />`).\n   154→\n   155→```tsx\n   156→import { Check, X, Loader2 } from 'lucide-react';\n   157→<Check className=\"h-4 w-4\" />\n   158→```\n   159→\n   160→**Brand glyphs.** Brand logos (Google, GitHub, Stripe, etc.) live as SVG components in `components/brand/`, owned by frontend-agent. NEVER reference brand logos through Lucide.\n   161→\n   162→**Domain enums.** Every domain enum (status, role, type, etc.) is owned by frontend-agent for the TS side (`types/`) and by the corresponding api-agent biome for the Python side (`api/<domain>/models.py`). Both sides MUST stay in sync; the contract amendment process covers both edits.\n   163→\n   164→**Route names.** Next.js App Router uses file-based routing — route paths are file paths under `app/`. The planner appends the full route map below from the brief's page inventory. Cross-route navigation uses typed `Link href` literals or a `routes` constant exported from `lib/routes.ts`. Biomes do NOT inline route strings.\n   165→\n   166→### F. Style System Rules\n   167→\n   168→1. **NEVER hardcode hex colors in component code.** All colors come from Tailwind tokens defined in `tailwind.config.ts`. Theme tokens live in CSS variables. Rationale: hardcoded hex defeats the token system and prevents theme switching.\n   169→\n   170→   ```tsx\n   171→   // GOOD\n   172→   <div className=\"bg-primary text-primary-foreground\" />\n   173→   // BAD\n   174→   <div style={{ backgroundColor: '#7C5CFF' }} />\n   175→   ```\n   176→\n   177→2. **Conditional className composition uses `cn` from `lib/utils.ts`** (clsx + tailwind-merge). Never inline string concatenation.\n   178→\n   179→   ```tsx\n   180→   // GOOD\n   181→   <div className={cn('base-classes', active && 'bg-primary', disabled && 'opacity-50')} />\n   182→   // BAD\n   183→   <div className={`base-classes ${active ? 'bg-primary' : ''}`} />\n   184→   ```\n   185→\n   186→3. **Class-Variance-Authority (cva) for primitive variants.** Every primitive that exposes a `variant` or `size` prop MUST implement them via `cva`. NEVER ad-hoc switch statements over variant strings.\n   187→\n   188→4. **Server Components by default; Client Components only when needed.** Add `'use client'` only when the component uses state, effects, browser APIs, or event handlers. Rationale: Server Component default keeps bundle size down and aligns with App Router conventions.\n   189→\n   190→5. **TypeScript strict mode.** No `any`. No `@ts-ignore` (use `@ts-expect-error` with a comment explaining why, or fix the type). No `as` casts on shared primitives.\n   191→\n   192→6. **API responses are typed end-to-end.** FastAPI Pydantic models on the backend; matching TS interfaces on the frontend. NEVER consume an API response without a type. The api-agent biome owns the source-of-truth Pydantic models; frontend-agent owns the TS mirrors.\n   193→\n   194→### G. Screen Ownership Matrix (universal rules — planner appends per-route table)\n   195→\n   196→Next.js App Router uses file-based routing — there is no central RootNavigator to stub. Each route is a directory under `app/` with a `page.tsx` (and optionally `layout.tsx`, `loading.tsx`, `error.tsx`).\n   197→\n   198→**Universal wiring rules:**\n   199→\n   200→1. **Every route in the brief's route inventory MUST have a real `page.tsx` file.** Stubbing pages with `export default function Page() { return null; }` is FORBIDDEN — it produces the same black-screen failure mode as React Native's PlaceholderScreen anti-pattern. Either ship a real page or ship a visible placeholder showing the route name and \"Page pending\" copy.\n   201→\n   202→2. **Each domain biome owns its own `app/<domain>/` subtree.** `frontend-agent` owns `app/(marketing)/`, layout files, and root-level files (`app/layout.tsx`, `app/page.tsx`); domain biomes own everything under their domain segment.\n   203→\n   204→3. **Server vs client components**: routes default to Server Components. `'use client'` is required only when state, effects, or browser APIs are needed.\n   205→\n   206→**Required table format** (planner generates from the brief's route inventory):\n   207→\n   208→| Route | Owner biome | File path | Type |\n   209→|---|---|---|---|\n   210→| `/` | frontend-agent | `app/page.tsx` | server |\n   211→| `/login` | auth-agent | `app/(auth)/login/page.tsx` | client |\n   212→| `/dashboard` | frontend-agent | `app/dashboard/page.tsx` | server |\n   213→| ... (every route in the brief) | ... | ... | ... |\n   214→\n   215→**Anti-pattern (FORBIDDEN):** empty pages returning `null`. If a page's logic isn't yet shipped, render a visible placeholder with the route path and a \"Page pending\" message on the theme background.\n   216→\n   217→### H. Security Rules\n   218→\n   219→Section H is the security contract surface for the nextjs-fastapi-supabase stack. Initial baseline — will tighten on first cultivation. Rules tagged with tiers: `[demo]` everywhere, `[startup]` startup+regulated, `[regulated]` regulated only, `[always-block]` blocks at every tier.\n   220→\n   221→#### H.1 Secret Management\n   222→\n   223→##### H.1.1 No hardcoded secrets in committed code [always-block]\n   224→Rule: No real API keys, tokens, or credentials in committed source. Exempt:\n   225→  literals containing `placeholder` matching demo-stub patterns.\n   226→Audit: `grep -rEn 'sk_live_|sk_test_|eyJ[A-Za-z0-9]{30,}|service_role|AKIA[0-9A-Z]{16}' src/ api/` excluding lines containing `placeholder` returns zero.\n   227→Violation: freeze-block at all tiers.\n   228→\n   229→##### H.1.2 .env gitignored [demo]\n   230→Rule: `.env`, `.env.local`, `.env.production` listed in `.gitignore`. Only `.env.example` (no real values) committed.\n   231→Audit: parse `.gitignore`; `git ls-files` for .env* returns at most `.env.example`.\n   232→Violation: demo=advisory, startup+=freeze-block.\n   233→\n   234→##### H.1.3 Server secrets never in client bundle [always-block]\n   235→Rule: Next.js client code (under `app/` or `components/` consumed by client components) MUST NOT reference secrets without `NEXT_PUBLIC_` prefix. Server-only secrets (no prefix) used only in Server Components, Server Actions, Route Handlers, or under `api/` (FastAPI).\n   236→Audit: in `'use client'`-annotated files, grep for env var references not starting with `NEXT_PUBLIC_`; must return zero.\n   237→Violation: freeze-block at all tiers.\n   238→\n   239→#### H.2 Auth Flows\n   240→\n   241→##### H.2.1 Sessions in httpOnly cookies, never localStorage [demo]\n   242→Rule: Auth tokens persisted as httpOnly + Secure + SameSite=Strict cookies. `localStorage`, `sessionStorage` for sessions are forbidden.\n   243→Audit: grep `localStorage.setItem` and `sessionStorage.setItem` in src/ near auth/session/token identifiers.\n   244→Violation: demo=advisory, startup+=freeze-block.\n   245→\n   246→#### H.3 Database (RLS)\n   247→\n   248→##### H.3.1 Every Supabase table has RLS enabled [always-block]\n   249→Rule: Every `CREATE TABLE` in migrations is followed by `ENABLE ROW LEVEL SECURITY` in the same file.\n   250→Audit: regex parse SQL migrations.\n   251→Violation: freeze-block at all tiers.\n   252→\n   253→#### H.4 PII Handling\n   254→\n   255→##### H.4.1 PII categories defined [demo]\n   256→Rule: NUTRIENTS.md §H.4 defines PII vocabulary (default: email, phone, address, payment, legal name, location, national IDs).\n   257→Audit: contract-vs-contract via audit prompt.\n   258→Violation: demo=advisory, startup+=freeze-block.\n   259→\n   260→##### H.4.2 No PII in logs [demo]\n   261→Rule: `console.log`, `console.error`, server logger calls, and `Sentry.captureException` MUST NOT include PII identifiers.\n   262→Audit: regex grep for log calls containing PII identifier names.\n   263→Violation: demo=advisory, startup+=freeze-block.\n   264→\n   265→(Other rules — H.2.2/H.2.3, H.3.2-5, H.4.3-5 — refine on first cultivation.)\n   266→\n   267→---\n   268→\n   269→## STACK-CANON OVERRIDE (Talent Agent specific)\n   270→\n   271→**The verbatim contract appendix Section H above is partially NEGATED for this organism.**\n   272→\n   273→This repo uses `--stack nextjs-fastapi-supabase` because no `fastapi-postgres` preset exists. The preset's rules conflict with this repo's actual stack. When the preset and this override conflict, **this override wins — always.**\n   274→\n   275→### Negated Rules (do NOT enforce)\n   276→\n   277→- **H.1.3 (`NEXT_PUBLIC_` prefix)** — NEGATED. This repo uses **React 19 + Vite 8**, NOT Next.js. Env vars use `VITE_*` prefix per Vite's `import.meta.env` convention.\n   278→\n   279→- **H.2.1 (httpOnly cookies)** — NEGATED. JWT storage is **localStorage** per iter-2's resolved decision. `AuthContext` reads/writes localStorage directly, sets `Bearer` header in `lib/api.js`.\n   280→\n   281→- **H.3.1 (Supabase RLS)** — NEGATED. This repo uses **raw PostgreSQL 15 via SQLAlchemy 2.0 async + Alembic**. No Supabase, no RLS policies.\n   282→\n   283→### Positive Stack Canon\n   284→\n   285→| Layer | Actual Stack |\n   286→|---|---|\n   287→| Frontend | React 19 · Vite 8 · Tailwind 4 · lucide-react · react-router-dom 7 |\n   288→| Backend | FastAPI · Python 3.12 · Pydantic v2 · SQLAlchemy 2.0 async · Alembic |\n   289→| Database | PostgreSQL 15 raw, via SQLAlchemy async engine |\n   290→| Auth | JWT HS256, 7d, stored in localStorage, sent as `Authorization: Bearer <token>` |\n   291→| Storage | Local FS (dev) / S3 (prod future) |\n   292→| Env vars | `VITE_*` for frontend, unprefixed for backend |\n   293→\n   294→---\n   295→\n   296→## ORGANISM-SPECIFIC EXTENSIONS\n   297→\n   298→### C. Symbol Ownership Matrix (organism rows)\n   299→\n   300→| Symbol | Owner biome | File path |\n   301→|---|---|---|\n   302→| `Candidate`, `CandidateSchema` | data-agent | `backend/models/discovery.py`, `backend/agents/discovery/schemas.py` |\n   303→| `DiscoveredJob`, `DiscoveredJobSchema` | data-agent | `backend/models/discovery.py`, `backend/agents/discovery/schemas.py` |\n   304→| `ScoredJob`, `ScoredJobSchema` | data-agent | `backend/models/discovery.py`, `backend/agents/discovery/schemas.py` |\n   305→| `DailyDigest`, `DailyDigestSchema` | data-agent | `backend/models/discovery.py`, `backend/agents/discovery/schemas.py` |\n   306→| `CrawlRun` | data-agent | `backend/models/discovery.py` |\n   307→| `ParsedJD`, `ParsedJDSchema` | data-agent | `backend/models/application.py`, `backend/agents/application/schemas.py` |\n   308→| `TailoredResume`, `TailoredResumeSchema` | data-agent | `backend/models/application.py`, `backend/agents/application/schemas.py` |\n   309→| `CompanyIntel`, `CompanyIntelSchema` | data-agent | `backend/models/application.py`, `backend/agents/application/schemas.py` |\n   310→| `Contact`, `ContactSchema` | data-agent | `backend/models/application.py`, `backend/agents/application/schemas.py` |\n   311→| `ApplicationPipeline`, `ApplicationPipelineSchema` | data-agent | `backend/models/application.py`, `backend/agents/application/schemas.py` |\n   312→| `CRMEvent` | data-agent | `backend/models/application.py` |\n   313→| `User`, `MagicLink` | data-agent | `backend/models/auth.py` |\n   314→| `IdentityProfileSchema` | data-agent | `backend/agents/discovery/schemas.py` |\n   315→| `SearchManifestSchema` | data-agent | `backend/agents/discovery/schemas.py` |\n   316→| `ScoreBreakdown` | data-agent | `backend/agents/discovery/schemas.py` |\n   317→| `OutreachEmailSchema` | data-agent | `backend/agents/application/schemas.py` |\n   318→| `AuthContext` | frontend-agent | `frontend/src/context/AuthContext.jsx` |\n   319→| `DashboardLayout` | frontend-agent | `frontend/src/layouts/DashboardLayout.jsx` |\n   320→| `Sidebar` | frontend-agent | `frontend/src/components/Sidebar.jsx` |\n   321→| `TopBar` | frontend-agent | `frontend/src/components/TopBar.jsx` |\n   322→| `StatCard` | frontend-agent | `frontend/src/components/StatCard.jsx` |\n   323→| `StatusBadge` | frontend-agent | `frontend/src/components/StatusBadge.jsx` |\n   324→| `api` (client) | frontend-agent | `frontend/src/lib/api.js` |\n   325→| `routes` | frontend-agent | `frontend/src/lib/routes.js` |\n   326→| `IdentityProfiler` | discover-agent | `backend/agents/discovery/identity_profiler.py` |\n   327→| `ArchetypeGenerator` | discover-agent | `backend/agents/discovery/archetype_generator.py` |\n   328→| `CrawlerAgent` | discover-agent | `backend/agents/discovery/crawler_agent.py` |\n   329→| `RelevanceScorer` | discover-agent | `backend/agents/discovery/relevance_scorer.py` |\n   330→| `DigestBuilder` | discover-agent | `backend/agents/discovery/digest_builder.py` |\n   331→| `DiscoveryOrchestrator` | discover-agent | `backend/agents/discovery/orchestrator.py` |\n   332→| `JDParser` | apply-agent | `backend/agents/application/jd_parser.py` |\n   333→| `ResumeTailor` | apply-agent | `backend/agents/application/resume_tailor.py` |\n   334→| `CompanyIntelAgent` | apply-agent | `backend/agents/application/company_intel.py` |\n   335→| `ContactFinder` | apply-agent | `backend/agents/application/contact_finder.py` |\n   336→| `OutreachComposer` | apply-agent | `backend/agents/application/outreach_composer.py` |\n   337→| `AutoApplyAgent` | apply-agent | `backend/agents/application/auto_apply.py` |\n   338→| `CRM` | apply-agent | `backend/agents/application/crm.py` |\n   339→| `ApplicationOrchestrator` | apply-agent | `backend/agents/application/orchestrator.py` |\n   340→| `AgentManager` | agents-agent | `backend/agents/application/agent_manager.py` |\n   341→| `SubAgentRegistry` | agents-agent | `backend/agents/application/agent_manager.py` |\n   342→| `SubAgentRunner` | agents-agent | `backend/agents/application/agent_manager.py` |\n   343→| `PipelineDispatcher` | agents-agent | `backend/agents/application/agent_manager.py` |\n   344→| `get_current_user` | auth-agent | `backend/api/auth.py` |\n   345→\n   346→### E. Allow-listed Identifiers (organism extension)\n   347→\n   348→#### Domain Enums\n   349→\n   350→```typescript\n   351→// Job source enum\n   352→export type JobSource = 'greenhouse' | 'lever' | 'ashby' | 'workday';\n   353→\n   354→// Crawl run status\n   355→export type CrawlRunStatus = 'QUEUED' | 'RUNNING' | 'COMPLETED' | 'FAILED';\n   356→\n   357→// Application pipeline status (state machine)\n   358→export type ApplicationPipelineStatus =\n   359→  | 'QUEUED'\n   360→  | 'PARSING'\n   361→  | 'TAILORING'\n   362→  | 'RESEARCHING'\n   363→  | 'COMPOSING'\n   364→  | 'AWAITING_REVIEW'\n   365→  | 'APPROVED'\n   366→  | 'REJECTED'\n   367→  | 'SUBMITTED'\n   368→  | 'SENT'\n   369→  | 'TRACKED'\n   370→  | 'FAILED'\n   371→  | 'REQUIRES_MANUAL';\n   372→\n   373→// Agent status (lifecycle)\n   374→export type AgentStatus =\n   375→  | 'QUEUED'\n   376→  | 'DISPATCHED'\n   377→  | 'RUNNING'\n   378→  | 'COMPLETED'\n   379→  | 'FAILED'\n   380→  | 'RETRYING'\n   381→  | 'DEAD';\n   382→\n   383→// Contact confidence\n   384→export type ContactConfidence = 'HIGH' | 'MEDIUM' | 'LOW';\n   385→\n   386→// Remote preference\n   387→export type RemotePreference = 'remote_only' | 'hybrid' | 'onsite' | 'flexible';\n   388→\n   389→// Outreach status\n   390→export type OutreachStatus = 'DRAFT' | 'SENT' | 'BOUNCED' | 'REPLIED';\n   391→```\n   392→\n   393→#### Route Map (React Router DOM, NOT Next.js App Router)\n   394→\n   395→This organism uses React Router DOM with `react-router-dom@7`, NOT Next.js App Router. Routes are defined in `frontend/src/App.jsx`.\n   396→\n   397→```typescript\n   398→// Route definitions (for lib/routes.js)\n   399→export const routes = {\n   400→  landing: '/',\n   401→  login: '/login',\n   402→  verifyAuth: '/auth/verify',\n   403→  onboarding: '/onboarding',\n   404→  overview: '/overview',\n   405→  candidates: '/candidates',\n   406→  pipeline: '/pipeline',\n   407→  reviewQueue: '/review-queue',\n   408→  analytics: '/analytics',\n   409→  settings: '/settings',\n   410→} as const;\n   411→\n   412→export type RouteName = keyof typeof routes;\n   413→```\n   414→\n   415→### G. Screen Ownership Matrix (organism routes)\n   416→\n   417→**Note:** This organism uses React Router DOM (`react-router-dom@7`), NOT Next.js App Router. Routes are file-based under `frontend/src/pages/`.\n   418→\n   419→| Route | Owner biome | File path | Type |\n   420→|---|---|---|---|\n   421→| `/` | frontend-agent | `frontend/src/pages/Landing.jsx` | client |\n   422→| `/login` | frontend-agent | `frontend/src/pages/Login.jsx` | client |\n   423→| `/auth/verify` | frontend-agent | `frontend/src/pages/VerifyAuth.jsx` | client |\n   424→| `/onboarding` | frontend-agent | `frontend/src/pages/Onboarding.jsx` | client |\n   425→| `/overview` | frontend-agent | `frontend/src/pages/Overview.jsx` | client |\n   426→| `/candidates` | frontend-agent | `frontend/src/pages/Candidates.jsx` | client |\n   427→| `/pipeline` | frontend-agent | `frontend/src/pages/Pipeline.jsx` | client |\n   428→| `/review-queue` | frontend-agent | `frontend/src/pages/ReviewQueue.jsx` | client |\n   429→| `/analytics` | frontend-agent | `frontend/src/pages/Analytics.jsx` | client |\n   430→| `/settings` | frontend-agent | `frontend/src/pages/Settings.jsx` | client |\n   431→\n   432→---\n   433→\n   434→## DATA_CONTRACTS\n   435→\n   436→Full TypeScript interfaces for every domain entity. These mirror the Pydantic schemas in `backend/agents/*/schemas.py`.\n   437→\n   438→```typescript\n   439→// === Discovery Domain ===\n   440→\n   441→export interface Candidate {\n   442→  id: string; // UUID\n   443→  name: string;\n   444→  email: string;\n   445→  resume_text: string;\n   446→  linkedin_url: string | null;\n   447→  github_url: string | null;\n   448→  personal_context: string | null;\n   449→  target_locations: string[];\n   450→  remote_preference: RemotePreference;\n   451→  min_compensation: number | null;\n   452→  excluded_companies: string[];\n   453→  excluded_industries: string[];\n   454→  created_at: string; // ISO 8601\n   455→  updated_at: string; // ISO 8601\n   456→}\n   457→\n   458→export interface IdentityProfile {\n   459→  archetypes: string[];\n   460→  leadership_level: 'IC' | 'Lead' | 'Manager' | 'Director' | 'VP' | 'C-Level';\n   461→  technical_skills: string[];\n   462→  soft_skills: string[];\n   463→  industry_experience: string[];\n   464→  notable_achievements: string[];\n   465→  career_trajectory: string;\n   466→  ideal_role_description: string;\n   467→  signals: Record<string, string>;\n   468→}\n   469→\n   470→export interface SearchManifest {\n   471→  target_titles: string[];\n   472→  keywords: string[];\n   473→  excluded_titles: string[];\n   474→  excluded_companies: string[];\n   475→  excluded_industries: string[];\n   476→  location_filters: string[];\n   477→  remote_preference: RemotePreference;\n   478→  min_compensation: number | null;\n   479→}\n   480→\n   481→export interface DiscoveredJob {\n   482→  id: string; // UUID\n   483→  source: JobSource;\n   484→  source_id: string;\n   485→  title: string;\n   486→  company: string;\n   487→  location: string;\n   488→  description: string;\n   489→  url: string;\n   490→  posted_at: string | null; // ISO 8601\n   491→  salary_min: number | null;\n   492→  salary_max: number | null;\n   493→  remote: boolean;\n   494→  crawled_at: string; // ISO 8601\n   495→}\n   496→\n   497→export interface ScoreBreakdown {\n   498→  technical_match: number; // 0-100\n   499→  level_match: number; // 0-100\n   500→  culture_match: number; // 0-100\n   501→  industry_match: number; // 0-100\n   502→  growth_potential: number; // 0-100\n   503→  compensation_match: number; // 0-100\n   504→}\n   505→\n   506→export interface ScoredJob {\n   507→  id: string; // UUID\n   508→  discovered_job_id: string; // FK\n   509→  candidate_id: string; // FK\n   510→  score_breakdown: ScoreBreakdown;\n   511→  composite_score: number; // 0-100\n   512→  is_hot: boolean;\n   513→  reasoning: string;\n   514→  scored_at: string; // ISO 8601\n   515→}\n   516→\n   517→export interface DailyDigest {\n   518→  id: string; // UUID\n   519→  candidate_id: string; // FK\n   520→  run_date: string; // YYYY-MM-DD\n   521→  top_picks: ScoredJob[];\n   522→  hot_picks: ScoredJob[];\n   523→  new_companies: string[];\n   524→  total_jobs_discovered: number;\n   525→  total_jobs_scored: number;\n   526→  created_at: string; // ISO 8601\n   527→}\n   528→\n   529→export interface CrawlRun {\n   530→  id: string; // UUID\n   531→  candidate_id: string; // FK\n   532→  status: CrawlRunStatus;\n   533→  jobs_discovered: number;\n   534→  jobs_scored: number;\n   535→  started_at: string; // ISO 8601\n   536→  completed_at: string | null; // ISO 8601\n   537→  error_log: string | null;\n   538→}\n   539→\n   540→// === Application Domain ===\n   541→\n   542→export interface ParsedJD {\n   543→  id: string; // UUID\n   544→  job_id: string; // FK to discovered_jobs\n   545→  required_skills: string[];\n   546→  preferred_skills: string[];\n   547→  seniority_level: string;\n   548→  tech_stack: string[];\n   549→  culture_signals: string[];\n   550→  tone: string;\n   551→  pain_points: string[];\n   552→  compensation_range: string | null;\n   553→  red_flags: string[];\n   554→  application_instructions: string | null;\n   555→  parsed_at: string; // ISO 8601\n   556→}\n   557→\n   558→export interface TailoredResume {\n   559→  id: string; // UUID\n   560→  pipeline_id: string; // FK\n   561→  original_text: string;\n   562→  tailored_text: string;\n   563→  change_log: string[];\n   564→  gap_analysis: string;\n   565→  created_at: string; // ISO 8601\n   566→}\n   567→\n   568→export interface CompanyIntel {\n   569→  id: string; // UUID\n   570→  pipeline_id: string; // FK\n   571→  company_name: string;\n   572→  about: string;\n   573→  recent_news: string[];\n   574→  tech_stack: string[];\n   575→  engineering_culture: string;\n   576→  growth_stage: string;\n   577→  team_size: string | null;\n   578→  notable_facts: string[];\n   579→  researched_at: string; // ISO 8601\n   580→}\n   581→\n   582→export interface Contact {\n   583→  id: string; // UUID\n   584→  pipeline_id: string; // FK\n   585→  name: string;\n   586→  title: string;\n   587→  email: string;\n   588→  linkedin_url: string | null;\n   589→  confidence: ContactConfidence;\n   590→  fallback_email: string | null;\n   591→  source: string;\n   592→  found_at: string; // ISO 8601\n   593→}\n   594→\n   595→export interface OutreachEmail {\n   596→  id: string; // UUID\n   597→  pipeline_id: string; // FK\n   598→  subject_lines: string[]; // 3 variants\n   599→  body: string; // 150-200 words\n   600→  status: OutreachStatus;\n   601→  created_at: string; // ISO 8601\n   602→}\n   603→\n   604→export interface ApplicationPipeline {\n   605→  id: string; // UUID\n   606→  candidate_id: string; // FK\n   607→  job_id: string; // FK to scored_jobs\n   608→  status: ApplicationPipelineStatus;\n   609→  parsed_jd: ParsedJD | null;\n   610→  tailored_resume: TailoredResume | null;\n   611→  company_intel: CompanyIntel | null;\n   612→  contact: Contact | null;\n   613→  outreach_email: OutreachEmail | null;\n   614→  approval_timestamp: string | null; // ISO 8601\n   615→  submitted_at: string | null; // ISO 8601\n   616→  screenshots: string[]; // paths to screenshot files\n   617→  created_at: string; // ISO 8601\n   618→  updated_at: string; // ISO 8601\n   619→}\n   620→\n   621→export interface CRMEvent {\n   622→  id: string; // UUID\n   623→  pipeline_id: string; // FK\n   624→  event_type: string; // SCREAMING_SNAKE_CASE\n   625→  payload: Record<string, unknown>;\n   626→  created_at: string; // ISO 8601\n   627→}\n   628→\n   629→// === Auth Domain ===\n   630→\n   631→export interface User {\n   632→  id: string; // UUID\n   633→  email: string;\n   634→  name: string | null;\n   635→  is_active: boolean;\n   636→  is_onboarded: boolean;\n   637→  candidate_id: string | null; // FK\n   638→  last_login_at: string | null; // ISO 8601\n   639→  created_at: string; // ISO 8601\n   640→  updated_at: string; // ISO 8601\n   641→}\n   642→\n   643→export interface MagicLink {\n   644→  id: string; // UUID\n   645→  user_id: string; // FK\n   646→  token: string; // 48-byte URL-safe\n   647→  expires_at: string; // ISO 8601\n   648→  is_used: boolean;\n   649→  created_at: string; // ISO 8601\n   650→}\n   651→\n   652→// === Agent Execution ===\n   653→\n   654→export interface AgentExecutionRecord {\n   655→  execution_id: string; // UUID\n   656→  agent_name: string;\n   657→  pipeline_id: string;\n   658→  status: AgentStatus;\n   659→  input_payload: Record<string, unknown>;\n   660→  output_payload: Record<string, unknown> | null;\n   661→  error: string | null;\n   662→  attempt: number;\n   663→  started_at: string; // ISO 8601\n   664→  completed_at: string | null; // ISO 8601\n   665→  duration_ms: number | null;\n   666→  token_usage: {\n   667→    prompt_tokens: number;\n   668→    completion_tokens: number;\n   669→    total_tokens: number;\n   670→  } | null;\n   671→}\n   672→```\n   673→\n   674→---\n   675→\n   676→## DESIGN_TOKENS\n   677→\n   678→**Variant:** Top Shelf — Editorial Consulting (gold-on-black, seanyoung.biz-derived)\n   679→\n   680→### Color Palette\n   681→\n   682→```css\n   683→:root {\n   684→  /* Primary palette */\n   685→  --gold: #C9A227;\n   686→  --gold-dim: rgba(201, 162, 39, 0.7);\n   687→  --gold-faint: rgba(201, 162, 39, 0.15);\n   688→\n   689→  /* Backgrounds */\n   690→  --bg-primary: #0A0A0A;\n   691→  --bg-secondary: #141414;\n   692→  --bg-tertiary: #1A1A1A;\n   693→  --bg-elevated: #1F1F1F;\n   694→\n   695→  /* Text */\n   696→  --text-primary: #FAFAFA;\n   697→  --text-secondary: #A3A3A3;\n   698→  --text-muted: #737373;\n   699→\n   700→  /* Borders */\n   701→  --border: rgba(255, 255, 255, 0.08);\n   702→  --border-hover: rgba(255, 255, 255, 0.15);\n   703→\n   704→  /* Status colors */\n   705→  --status-success: #22C55E;\n   706→  --status-warning: #EAB308;\n   707→  --status-error: #EF4444;\n   708→  --status-info: #3B82F6;\n   709→  --status-pending: #A855F7;\n   710→  --status-hot: #F97316;\n   711→\n   712→  /* Semantic */\n   713→  --accent: var(--gold);\n   714→  --accent-hover: #D4AF37;\n   715→  --destructive: #DC2626;\n   716→  --destructive-hover: #B91C1C;\n   717→}\n   718→```\n   719→\n   720→### Typography Scale\n   721→\n   722→```css\n   723→:root {\n   724→  /* Font families */\n   725→  --font-serif: 'Playfair Display', Georgia, serif;\n   726→  --font-sans: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;\n   727→  --font-mono: 'DM Mono', 'Fira Code', monospace;\n   728→\n   729→  /* Font sizes */\n   730→  --text-xs: 0.75rem;    /* 12px */\n   731→  --text-sm: 0.875rem;   /* 14px */\n   732→  --text-base: 1rem;     /* 16px */\n   733→  --text-lg: 1.125rem;   /* 18px */\n   734→  --text-xl: 1.25rem;    /* 20px */\n   735→  --text-2xl: 1.5rem;    /* 24px */\n   736→  --text-3xl: 1.875rem;  /* 30px */\n   737→  --text-4xl: 2.25rem;   /* 36px */\n   738→  --text-5xl: 3rem;      /* 48px */\n   739→\n   740→  /* Line heights */\n   741→  --leading-tight: 1.25;\n   742→  --leading-normal: 1.5;\n   743→  --leading-relaxed: 1.75;\n   744→\n   745→  /* Font weights */\n   746→  --font-normal: 400;\n   747→  --font-medium: 500;\n   748→  --font-semibold: 600;\n   749→  --font-bold: 700;\n   750→}\n   751→```\n   752→\n   753→### Typography Utility Classes\n   754→\n   755→```css\n   756→/* Page headings — Playfair Display bold */\n   757→.t-serif-bold {\n   758→  font-family: var(--font-serif);\n   759→  font-weight: var(--font-bold);\n   760→  font-size: var(--text-5xl);\n   761→  line-height: var(--leading-tight);\n   762→  color: var(--text-primary);\n   763→}\n   764→\n   765→/* Section headings — Playfair Display regular */\n   766→.t-serif {\n   767→  font-family: var(--font-serif);\n   768→  font-weight: var(--font-normal);\n   769→  font-size: var(--text-2xl);\n   770→  line-height: var(--leading-tight);\n   771→  color: var(--text-primary);\n   772→}\n   773→\n   774→/* Labels — DM Sans uppercase tracking */\n   775→.t-label {\n   776→  font-family: var(--font-sans);\n   777→  font-weight: var(--font-medium);\n   778→  font-size: var(--text-xs);\n   779→  line-height: var(--leading-normal);\n   780→  letter-spacing: 0.1em;\n   781→  text-transform: uppercase;\n   782→  color: var(--text-secondary);\n   783→}\n   784→\n   785→/* Gold accent labels */\n   786→.t-label-gold {\n   787→  font-family: var(--font-sans);\n   788→  font-weight: var(--font-medium);\n   789→  font-size: var(--text-xs);\n   790→  line-height: var(--leading-normal);\n   791→  letter-spacing: 0.1em;\n   792→  text-transform: uppercase;\n   793→  color: var(--gold);\n   794→}\n   795→\n   796→/* Body text — DM Sans */\n   797→.t-body {\n   798→  font-family: var(--font-sans);\n   799→  font-weight: var(--font-normal);\n   800→  font-size: var(--text-base);\n   801→  line-height: var(--leading-relaxed);\n   802→  color: var(--text-primary);\n   803→}\n   804→\n   805→/* Mono / code */\n   806→.t-mono {\n   807→  font-family: var(--font-mono);\n   808→  font-size: var(--text-sm);\n   809→  line-height: var(--leading-normal);\n   810→}\n   811→```\n   812→\n   813→### Spacing Scale\n   814→\n   815→```css\n   816→:root {\n   817→  --space-0: 0;\n   818→  --space-1: 0.25rem;   /* 4px */\n   819→  --space-2: 0.5rem;    /* 8px */\n   820→  --space-3: 0.75rem;   /* 12px */\n   821→  --space-4: 1rem;      /* 16px */\n   822→  --space-5: 1.25rem;   /* 20px */\n   823→  --space-6: 1.5rem;    /* 24px */\n   824→  --space-8: 2rem;      /* 32px */\n   825→  --space-10: 2.5rem;   /* 40px */\n   826→  --space-12: 3rem;     /* 48px */\n   827→  --space-16: 4rem;     /* 64px */\n   828→  --space-20: 5rem;     /* 80px */\n   829→  --space-24: 6rem;     /* 96px */\n   830→}\n   831→```\n   832→\n   833→### Border Radii\n   834→\n   835→```css\n   836→:root {\n   837→  --radius-none: 0;\n   838→  --radius-sm: 0.125rem;  /* 2px */\n   839→  --radius-md: 0.375rem;  /* 6px */\n   840→  --radius-lg: 0.5rem;    /* 8px */\n   841→  --radius-xl: 0.75rem;   /* 12px */\n   842→  --radius-full: 9999px;\n   843→}\n   844→```\n   845→\n   846→### Shadows\n   847→\n   848→```css\n   849→:root {\n   850→  /* Minimal shadows — editorial aesthetic prefers border over shadow */\n   851→  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.4);\n   852→  --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.4);\n   853→  --shadow-lg: 0 10px 15px rgba(0, 0, 0, 0.5);\n   854→\n   855→  /* Glow effects for accent elements */\n   856→  --glow-gold: 0 0 20px rgba(201, 162, 39, 0.3);\n   857→}\n   858→```\n   859→\n   860→### Motion / Transitions\n   861→\n   862→```css\n   863→:root {\n   864→  /* Durations */\n   865→  --duration-fast: 150ms;\n   866→  --duration-normal: 200ms;\n   867→  --duration-slow: 300ms;\n   868→\n   869→  /* Easing */\n   870→  --ease-default: cubic-bezier(0.4, 0, 0.2, 1);\n   871→  --ease-in: cubic-bezier(0.4, 0, 1, 1);\n   872→  --ease-out: cubic-bezier(0, 0, 0.2, 1);\n   873→  --ease-bounce: cubic-bezier(0.68, -0.55, 0.265, 1.55);\n   874→}\n   875→\n   876→/* Standard transition shorthand */\n   877→.transition-default {\n   878→  transition: all var(--duration-normal) var(--ease-default);\n   879→}\n   880→```\n   881→\n   882→### Scrollbar Treatment\n   883→\n   884→```css\n   885→/* Webkit scrollbars */\n   886→::-webkit-scrollbar {\n   887→  width: 8px;\n   888→  height: 8px;\n   889→}\n   890→\n   891→::-webkit-scrollbar-track {\n   892→  background: var(--bg-secondary);\n   893→}\n   894→\n   895→::-webkit-scrollbar-thumb {\n   896→  background: var(--border);\n   897→  border-radius: var(--radius-full);\n   898→}\n   899→\n   900→::-webkit-scrollbar-thumb:hover {\n   901→  background: var(--border-hover);\n   902→}\n   903→```\n   904→\n   905→### Selection Treatment\n   906→\n   907→```css\n   908→::selection {\n   909→  background: var(--gold-faint);\n   910→  color: var(--gold);\n   911→}\n   912→```\n   913→\n   914→---\n   915→\n   916→## API_CONTRACTS\n   917→\n   918→Full request/response shapes per endpoint.\n   919→\n   920→### Auth Endpoints\n   921→\n   922→#### POST /api/v1/auth/request-link\n   923→\n   924→Request magic link for email.\n   925→\n   926→```typescript\n   927→// Request\n   928→interface RequestLinkRequest {\n   929→  email: string;\n   930→}\n   931→\n   932→// Response (200)\n   933→interface RequestLinkResponse {\n   934→  message: string;\n   935→  magic_link?: string; // Only in DEBUG=true\n   936→  token?: string; // Only in DEBUG=true\n   937→}\n   938→```\n   939→\n   940→#### POST /api/v1/auth/verify\n   941→\n   942→Verify magic link token, return JWT.\n   943→\n   944→```typescript\n   945→// Request\n   946→interface VerifyRequest {\n   947→  token: string;\n   948→}\n   949→\n   950→// Response (200)\n   951→interface VerifyResponse {\n   952→  access_token: string;\n   953→  token_type: 'bearer';\n   954→  user_id: string;\n   955→  email: string;\n   956→  is_onboarded: boolean;\n   957→}\n   958→\n   959→// Error responses\n   960→// 401: \"This link has already been used\"\n   961→// 401: \"This link has expired\"\n   962→// 401: \"Invalid or expired link\"\n   963→```\n   964→\n   965→#### GET /api/v1/auth/me\n   966→\n   967→Get current authenticated user.\n   968→\n   969→```typescript\n   970→// Headers: Authorization: Bearer <jwt>\n   971→\n   972→// Response (200)\n   973→interface MeResponse {\n   974→  id: string;\n   975→  email: string;\n   976→  name: string | null;\n   977→  is_onboarded: boolean;\n   978→  candidate_id: string | null;\n   979→  created_at: string;\n   980→}\n   981→\n   982→// Error responses\n   983→// 401: \"Not authenticated\"\n   984→// 401: \"Token expired\"\n   985→// 401: \"User not found or inactive\"\n   986→```\n   987→\n   988→### Onboarding Endpoints\n   989→\n   990→#### POST /api/v1/onboarding/resume\n   991→\n   992→Upload resume PDF (multipart).\n   993→\n   994→```typescript\n   995→// Request: multipart/form-data\n   996→// Field: file (PDF, max 10MB)\n   997→\n   998→// Response (200)\n   999→interface ResumeUploadResponse {\n  1000→  message: string;\n  1001→  candidate_id: string;\n  1002→  text_length: number;\n  1003→  preview: string; // First 500 chars\n  1004→}\n  1005→\n  1006→// Error responses\n  1007→// 422: \"Only PDF files are accepted...\"\n  1008→// 422: \"File too large. Max 10MB.\"\n  1009→// 422: \"Could not extract any text from the PDF\"\n  1010→```\n  1011→\n  1012→#### POST /api/v1/onboarding/profile\n  1013→\n  1014→Save candidate profile.\n  1015→\n  1016→```typescript\n  1017→// Request\n  1018→interface ProfileRequest {\n  1019→  name: string;\n  1020→  linkedin_url?: string;\n  1021→  github_url?: string;\n  1022→  personal_context?: string;\n  1023→  target_locations?: string[];\n  1024→  remote_preference?: RemotePreference; // default: 'flexible'\n  1025→  min_compensation?: number;\n  1026→  excluded_companies?: string[];\n  1027→  excluded_industries?: string[];\n  1028→}\n  1029→\n  1030→// Response (200)\n  1031→interface ProfileResponse {\n  1032→  message: string;\n  1033→  candidate_id: string;\n  1034→  is_onboarded: boolean;\n  1035→}\n  1036→\n  1037→// Error responses\n  1038→// 400: \"Please upload your resume first...\"\n  1039→```\n  1040→\n  1041→#### GET /api/v1/onboarding/status\n  1042→\n  1043→Get onboarding completeness.\n  1044→\n  1045→```typescript\n  1046→// Response (200)\n  1047→interface OnboardingStatusResponse {\n  1048→  is_onboarded: boolean;\n  1049→  has_resume: boolean;\n  1050→  has_profile: boolean;\n  1051→  candidate_id?: string;\n  1052→}\n  1053→```\n  1054→\n  1055→### Discovery Endpoints\n  1056→\n  1057→#### POST /api/v1/discovery/trigger\n  1058→\n  1059→Trigger discovery run for candidate.\n  1060→\n  1061→```typescript\n  1062→// Request\n  1063→interface TriggerDiscoveryRequest {\n  1064→  candidate_id: string;\n  1065→  dry_run?: boolean; // default: false\n  1066→}\n  1067→\n  1068→// Response (200)\n  1069→interface TriggerDiscoveryResponse {\n  1070→  crawl_run_id: string;\n  1071→  status: CrawlRunStatus;\n  1072→  message: string;\n  1073→}\n  1074→```\n  1075→\n  1076→#### GET /api/v1/discovery/digest/{digest_id}\n  1077→\n  1078→Get daily digest by ID.\n  1079→\n  1080→```typescript\n  1081→// Response (200)\n  1082→interface GetDigestResponse {\n  1083→  digest: DailyDigest;\n  1084→}\n  1085→\n  1086→// Error responses\n  1087→// 404: \"Digest not found\"\n  1088→```\n  1089→\n  1090→### Application Endpoints\n  1091→\n  1092→#### POST /api/v1/application/start\n  1093→\n  1094→Start application pipeline for a job.\n  1095→\n  1096→```typescript\n  1097→// Request\n  1098→interface StartApplicationRequest {\n  1099→  job_id: string; // scored_job ID\n  1100→  candidate_id: string;\n  1101→}\n  1102→\n  1103→// Response (200)\n  1104→interface StartApplicationResponse {\n  1105→  pipeline: ApplicationPipeline;\n  1106→}\n  1107→```\n  1108→\n  1109→#### POST /api/v1/application/submit/{pipeline_id}\n  1110→\n  1111→Submit approved application.\n  1112→\n  1113→```typescript\n  1114→// Response (200)\n  1115→interface SubmitApplicationResponse {\n  1116→  pipeline_id: string;\n  1117→  status: ApplicationPipelineStatus;\n  1118→  message: string;\n  1119→}\n  1120→\n  1121→// Error responses\n  1122→// 400: \"Pipeline must be APPROVED before submission\"\n  1123→// 404: \"Pipeline not found\"\n  1124→```\n  1125→\n  1126→#### GET /api/v1/application/list\n  1127→\n  1128→List application pipelines.\n  1129→\n  1130→```typescript\n  1131→// Query params\n  1132→interface ListApplicationsQuery {\n  1133→  candidate_id?: string;\n  1134→  status?: ApplicationPipelineStatus;\n  1135→  limit?: number; // default: 50\n  1136→  offset?: number; // default: 0\n  1137→}\n  1138→\n  1139→// Response (200)\n  1140→interface ListApplicationsResponse {\n  1141→  pipelines: ApplicationPipeline[];\n  1142→  total: number;\n  1143→}\n  1144→```\n  1145→\n  1146→#### GET /api/v1/application/{pipeline_id}\n  1147→\n  1148→Get pipeline details.\n  1149→\n  1150→```typescript\n  1151→// Response (200)\n  1152→interface GetPipelineResponse {\n  1153→  pipeline: ApplicationPipeline;\n  1154→}\n  1155→\n  1156→// Error responses\n  1157→// 404: \"Pipeline not found\"\n  1158→```\n  1159→\n  1160→### Review Endpoints\n  1161→\n  1162→#### GET /api/v1/review/queue\n  1163→\n  1164→Get pipelines awaiting review.\n  1165→\n  1166→```typescript\n  1167→// Query params\n  1168→interface ReviewQueueQuery {\n  1169→  candidate_id?: string;\n  1170→}\n  1171→\n  1172→// Response (200)\n  1173→interface ReviewQueueResponse {\n  1174→  pipelines: ApplicationPipeline[]; // status = AWAITING_REVIEW\n  1175→}\n  1176→```\n  1177→\n  1178→#### POST /api/v1/review/{pipeline_id}/approve\n  1179→\n  1180→Approve pipeline for submission.\n  1181→\n  1182→```typescript\n  1183→// Response (200)\n  1184→interface ApproveResponse {\n  1185→  pipeline_id: string;\n  1186→  status: 'APPROVED';\n  1187→  approval_timestamp: string;\n  1188→  message: string;\n  1189→}\n  1190→\n  1191→// Error responses\n  1192→// 404: \"Pipeline not found\"\n  1193→// 400: \"Pipeline is not awaiting review\"\n  1194→```\n  1195→\n  1196→#### POST /api/v1/review/{pipeline_id}/reject\n  1197→\n  1198→Reject pipeline.\n  1199→\n  1200→```typescript\n  1201→// Request\n  1202→interface RejectRequest {\n  1203→  reason?: string;\n  1204→}\n  1205→\n  1206→// Response (200)\n  1207→interface RejectResponse {\n  1208→  pipeline_id: string;\n  1209→  status: 'REJECTED';\n  1210→  message: string;\n  1211→}\n  1212→\n  1213→// Error responses\n  1214→// 404: \"Pipeline not found\"\n  1215→// 400: \"Pipeline is not awaiting review\"\n  1216→```\n  1217→\n  1218→### Health Endpoint\n  1219→\n  1220→#### GET /health\n  1221→\n  1222→Service health check.\n  1223→\n  1224→```typescript\n  1225→// Response (200)\n  1226→interface HealthResponse {\n  1227→  status: 'ok';\n  1228→  version: string; // semver\n  1229→  git_sha: string;\n  1230→  redis: 'ok' | 'down';\n  1231→  db: 'ok' | 'down';\n  1232→}\n  1233→```\n  1234→\n  1235→---\n  1236→\n  1237→## H.4 PII Vocabulary (organism-specific)\n  1238→\n  1239→PII categories that MUST be redacted from logs:\n  1240→\n  1241→- `email` — candidate email, contact email, user email\n  1242→- `phone` — any phone numbers\n  1243→- `legal_name` — full legal name if distinct from display name\n  1244→- `resume_text` — full resume content\n  1245→- `personal_context` — candidate personal context field\n  1246→- `linkedin_url` — LinkedIn profile URL\n  1247→- `github_url` — GitHub profile URL\n  1248→- `address` — physical addresses\n  1249→- `compensation` — salary/compensation details\n  1250→\n  1251→---\n  1252→\n  1253→## ITER-4 CONTRACT EXTENSIONS\n  1254→\n  1255→### C. Symbol Ownership Matrix (iter-4 additions)\n  1256→\n  1257→| Symbol | Owner biome | File path |\n  1258→|---|---|---|\n  1259→| `celery_app` | scheduler-agent | `backend/scheduler/celery_app.py` |\n  1260→| `daily_discovery_task` | scheduler-agent | `backend/scheduler/tasks.py` |\n  1261→| `beat_schedule` | scheduler-agent | `backend/scheduler/beat.py` |\n  1262→| `events_router` | api-streaming-agent | `backend/api/events.py` |\n  1263→| `SSESubscriber` | api-streaming-agent | `backend/api/events.py` |\n  1264→| `apiClient` | api-client-agent | `frontend/src/api/client.ts` |\n  1265→| `requestMagicLink`, `verifyToken`, `refreshSession` | api-client-agent | `frontend/src/api/auth.ts` |\n  1266→| `getTodayDigest`, `triggerDiscoveryRun`, `getJob` | api-client-agent | `frontend/src/api/discovery.ts` |\n  1267→| `listApplications`, `approveApplication`, `rejectApplication` | api-client-agent | `frontend/src/api/applications.ts` |\n  1268→| `subscribeAgentStatus` | api-client-agent | `frontend/src/api/events.ts` |\n  1269→| `TalentAgentApiError` | api-client-agent | `frontend/src/api/client.ts` |\n  1270→| `_publish_status` | discover-agent | `backend/agents/discovery/orchestrator.py` |\n  1271→\n  1272→### E. Allow-listed Identifiers (iter-4 additions)\n  1273→\n  1274→#### Discovery Event Types\n  1275→\n  1276→```typescript\n  1277→// Events published to agent.status.discovery\n  1278→export type DiscoveryEventType =\n  1279→  | 'RUN_STARTED'\n  1280→  | 'CANDIDATE_LOADED'\n  1281→  | 'PROFILE_BUILT'\n  1282→  | 'MANIFEST_BUILT'\n  1283→  | 'CRAWL_SOURCE_COMPLETE'  // includes {source, jobs_found}\n  1284→  | 'CRAWL_COMPLETE'\n  1285→  | 'SCORING_COMPLETE'\n  1286→  | 'RUN_COMPLETE'\n  1287→  | 'RUN_FAILED'\n  1288→  | 'DAILY_TASK_DEAD';  // from scheduler on terminal failure\n  1289→\n  1290→// Discovery status event payload\n  1291→export interface DiscoveryStatusEvent {\n  1292→  candidate_id: string;\n  1293→  event: DiscoveryEventType;\n  1294→  ts: string;  // ISO-8601 UTC\n  1295→  source?: JobSource;  // present for CRAWL_SOURCE_COMPLETE\n  1296→  jobs_found?: number;  // present for CRAWL_SOURCE_COMPLETE\n  1297→  error?: string;  // present for RUN_FAILED, DAILY_TASK_DEAD\n  1298→}\n  1299→```\n  1300→\n  1301→#### SSE Event Stream\n  1302→\n  1303→```typescript\n  1304→// Allowed channels for SSE streaming\n  1305→export type AllowedSSEChannel =\n  1306→  | 'agent.status.discovery'\n  1307→  | 'agent.status.application';\n  1308→\n  1309→// Slow client warning event\n  1310→export interface SlowClientEvent {\n  1311→  dropped: number;\n  1312→}\n  1313→```\n  1314→\n  1315→#### Celery Task IDs\n  1316→\n  1317→```typescript\n  1318→// Daily discovery task ID format (for idempotency)\n  1319→// Pattern: discovery-{candidate_id}-{YYYY-MM-DD}\n  1320→export type DailyDiscoveryTaskId = `discovery-${string}-${string}`;\n  1321→```\n  1322→\n  1323→### API_CONTRACTS (iter-4 additions)\n  1324→\n  1325→#### SSE Event Stream Endpoint\n  1326→\n  1327→##### GET /events/stream\n  1328→\n  1329→Stream real-time agent status events via Server-Sent Events.\n  1330→\n  1331→```typescript\n  1332→// Query params\n  1333→interface EventStreamQuery {\n  1334→  channel: AllowedSSEChannel;\n  1335→}\n  1336→\n  1337→// Headers required\n  1338→// Authorization: Bearer <jwt>\n  1339→\n  1340→// Response: text/event-stream\n  1341→// Each message is: data: {json}\\n\\n\n  1342→// Heartbeat every 15s: :ping\\n\\n\n  1343→// On backpressure: event: slow_client\\ndata: {\"dropped\": N}\\n\\n\n  1344→\n  1345→// Error responses\n  1346→// 400: \"Invalid channel. Allowed: agent.status.discovery, agent.status.application\"\n  1347→// 401: \"Not authenticated\"\n  1348→```\n  1349→\n  1350→### DATA_CONTRACTS (iter-4 additions)\n  1351→\n  1352→```typescript\n  1353→// === Scheduler Domain ===\n  1354→\n  1355→export interface CeleryTaskRecord {\n  1356→  task_id: string;  // DailyDiscoveryTaskId format\n  1357→  candidate_id: string;\n  1358→  status: 'PENDING' | 'STARTED' | 'RETRY' | 'SUCCESS' | 'FAILURE';\n  1359→  retries: number;\n  1360→  started_at: string | null;  // ISO 8601\n  1361→  completed_at: string | null;  // ISO 8601\n  1362→  error_log: string | null;\n  1363→}\n  1364→\n  1365→// === API Client Domain ===\n  1366→\n  1367→export interface TalentAgentApiErrorData {\n  1368→  status: number;  // HTTP status code\n  1369→  code: string;  // Backend error code if present\n  1370→  message: string;  // User-facing message\n  1371→}\n  1372→\n  1373→// API client configuration\n  1374→export interface ApiClientConfig {\n  1375→  baseUrl: string;  // from VITE_API_BASE_URL\n  1376→  storageKey: 'talent-agent-jwt';\n  1377→}\n  1378→```\n  1379→\n  1380→### Iter-4 Dependency Additions\n  1381→\n  1382→**Backend (requirements.txt):**\n  1383→- celery>=5.3 — owner: scheduler-agent\n  1384→- fakeredis>=2.20 — owner: tests-agent (dev only)\n  1385→\n  1386→**Frontend (package.json devDependencies):**\n  1387→- vitest>=1.0 — owner: tests-agent\n  1388→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"ef3e1c9a-082e-4b26-be4b-f026a2179071","uuid":"74e49fa7-fac8-4206-85ff-606b4b3f0add","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/NUTRIENTS.md","content":"# NUTRIENTS.md — Talent Agent Frozen Contracts\n\n> Frozen contract surface for the Talent Agent organism.\n> Stack: `nextjs-fastapi-supabase` (fallback — real stack is React 19 + Vite 8 + FastAPI + PostgreSQL)\n> Security tier: `startup`\n\n---\n\n## CONTRACT APPENDIX (verbatim → NUTRIENTS.md)\n\nThis appendix is the frozen contract surface for any organism on the nextjs-fastapi-supabase stack. It exists to block the contract-drift class of failure: missing runtime deps, component prop drift, inconsistent styling, ad-hoc icon usage, and duplicate exports.\n\n> The mycelium planner MUST copy every subsection below verbatim into the matching section of NUTRIENTS.md. No paraphrasing. No placeholders. No `#TODO`. Sections C and E are partly verbatim (universal rules) and partly planner-generated (organism-specific rows the planner appends from the agent decomposition). Leaves reading NUTRIENTS treat these as frozen contracts — amendments only via FRUIT_READY contract-amendment line, never silent edits.\n\n### A. Dependency Manifest\n\nSingle source of truth for runtime deps. Default owner is `frontend-agent` (web) or `api-agent` (Python). A biome that needs a package not on this list MUST emit `+dep:<pkg>@<ver> reason:<one-line>` on its FRUIT_READY line, or the orchestrator rejects the harvest.\n\n**Frontend (Next.js 14, App Router):**\n- next@^14.2.0 — owner: frontend-agent\n- react@^18.3.0 — owner: frontend-agent\n- react-dom@^18.3.0 — owner: frontend-agent\n- typescript@^5.4.0 — owner: frontend-agent\n- @supabase/supabase-js@^2.39.0 — owner: frontend-agent\n- @supabase/ssr@^0.1.0 — owner: frontend-agent\n- tailwindcss@^3.4.0 — owner: frontend-agent\n- class-variance-authority@^0.7.0 — owner: frontend-agent\n- clsx@^2.1.0 — owner: frontend-agent\n- tailwind-merge@^2.2.0 — owner: frontend-agent\n- lucide-react@^0.330.0 — owner: frontend-agent\n- @radix-ui/react-* — owner: frontend-agent (per-component pin in package.json)\n- stripe@^14.0.0 — owner: payments-agent\n- @stripe/stripe-js@^3.0.0 — owner: payments-agent\n\n**Backend (FastAPI, Python 3.11+):**\n- fastapi>=0.110 — owner: api-agent\n- uvicorn[standard]>=0.27 — owner: api-agent\n- pydantic>=2.6 — owner: api-agent\n- supabase>=2.4 — owner: api-agent\n- python-jose[cryptography]>=3.3 — owner: auth-agent\n- stripe>=8.0 — owner: payments-agent\n- httpx>=0.26 — owner: api-agent\n\nFrontend is locked to Next.js App Router (NOT Pages Router). Backend is locked to FastAPI (NOT Express, NOT Flask).\n\n### B. Component Prop Contracts (TypeScript, frozen)\n\nFull TS interfaces for every shared primitive in `components/ui/`. Frozen: leaves cannot add, remove, or rename props. The frontend-agent biome MUST ship exactly these signatures. If a consumer biome needs a prop not listed, it amends the contract via FRUIT_READY contract-amendment line — never inlines a workaround.\n\n```ts\nimport type { ButtonHTMLAttributes, InputHTMLAttributes, HTMLAttributes, ReactNode } from 'react';\nimport type { LucideIcon } from 'lucide-react';\n\nexport type Variant = 'default' | 'primary' | 'secondary' | 'ghost' | 'destructive' | 'outline';\nexport type Size = 'sm' | 'md' | 'lg';\n\nexport interface ButtonProps extends ButtonHTMLAttributes<HTMLButtonElement> {\n  children: ReactNode;\n  variant?: Variant;\n  size?: Size;\n  loading?: boolean;\n  fullWidth?: boolean;\n  leftIcon?: LucideIcon;\n  rightIcon?: LucideIcon;\n  asChild?: boolean;\n}\n\nexport interface InputProps extends InputHTMLAttributes<HTMLInputElement> {\n  label?: string;\n  helperText?: string;\n  error?: string;\n  leftIcon?: LucideIcon;\n  rightIcon?: LucideIcon;\n}\n\nexport interface CardProps extends HTMLAttributes<HTMLDivElement> {\n  children: ReactNode;\n  variant?: 'default' | 'elevated' | 'outlined' | 'flat';\n  padding?: 'none' | 'sm' | 'md' | 'lg';\n}\n\nexport interface AvatarProps {\n  src?: string;\n  alt?: string;\n  fallback?: string;  // initials\n  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';\n  shape?: 'circle' | 'square';\n  className?: string;\n}\n\nexport interface BadgeProps {\n  children: ReactNode;\n  variant?: 'default' | 'primary' | 'success' | 'warning' | 'destructive';\n  size?: 'sm' | 'md';\n  className?: string;\n}\n\nexport interface SpinnerProps {\n  size?: 'sm' | 'md' | 'lg';\n  className?: string;\n}\n\nexport interface DialogProps {\n  open: boolean;\n  onOpenChange: (open: boolean) => void;\n  children: ReactNode;\n}\n```\n\n### C. Symbol Ownership Matrix (baseline rows — planner appends organism rows)\n\nEvery shared symbol has exactly ONE owner biome. No biome exports a symbol another biome has claimed. If a biome needs a symbol it does not own, it imports — never re-declares.\n\nThe rows below are stack-universal — they exist in every nextjs-fastapi-supabase organism. The planner MUST append organism-specific rows below this baseline (entity types, hooks, page-level components) derived from the brief.\n\n| Symbol | Owner biome | File path |\n|---|---|---|\n| `createServerClient`, `createBrowserClient` | frontend-agent | `lib/supabase.ts` |\n| `Button`, `ButtonProps` | frontend-agent | `components/ui/button.tsx` |\n| `Input`, `InputProps` | frontend-agent | `components/ui/input.tsx` |\n| `Card`, `CardProps` | frontend-agent | `components/ui/card.tsx` |\n| `Avatar`, `AvatarProps` | frontend-agent | `components/ui/avatar.tsx` |\n| `Badge`, `BadgeProps` | frontend-agent | `components/ui/badge.tsx` |\n| `Dialog`, `DialogProps` | frontend-agent | `components/ui/dialog.tsx` |\n| `Spinner`, `SpinnerProps` | frontend-agent | `components/ui/spinner.tsx` |\n| `cn` (className merge) | frontend-agent | `lib/utils.ts` |\n| `Variant`, `Size` | frontend-agent | `components/ui/types.ts` |\n| `Settings` (Pydantic) | api-agent | `api/config.py` |\n| `get_supabase_client` | api-agent | `api/lib/supabase.py` |\n| `SessionUser` (Pydantic) | auth-agent | `api/auth/models.py` |\n| `get_current_user` (FastAPI dependency) | auth-agent | `api/auth/deps.py` |\n\n### D. Barrel File Ownership\n\nModule ownership is enforced at the directory level. A biome may not write to a directory it does not own. Cross-biome imports go through public re-export points; never reach into a biome's internals.\n\n| Path | Owner biome | Allowed exports |\n|---|---|---|\n| `components/ui/` | frontend-agent | All UI primitives. Other biomes import via `@/components/ui/<name>`. |\n| `components/<domain>/` | (per-biome) | Domain-specific components owned by the biome named `<domain>`. |\n| `lib/` | frontend-agent | Cross-cutting utilities (supabase clients, cn, formatters). |\n| `hooks/` | frontend-agent | Re-exports from each biome's hook tree. |\n| `types/` | frontend-agent | Sole source of truth for domain entity types. |\n| `app/` | frontend-agent | Next.js routes. Other biomes provide page-level components consumed by route segments. |\n| `api/` | api-agent | FastAPI app + per-domain routers. Each domain biome contributes `api/<domain>/router.py`. |\n| `api/auth/` | auth-agent | All auth-related Python modules. |\n| `api/lib/` | api-agent | Shared Python utilities (DB, logging, settings). |\n\nCardinal rule: a symbol appears in EXACTLY ONE module. Domain enums live in `types/`, NOT in component files.\n\n### E. Allow-listed Identifiers (universal rules — planner appends organism enums and route map)\n\n**Icons.** All icons MUST be `LucideIcon` from `lucide-react`. NEVER import from other icon libraries. NEVER inline SVGs in component code (use a static asset under `public/` if a custom glyph is needed and reference it via `<Image src=... />`).\n\n```tsx\nimport { Check, X, Loader2 } from 'lucide-react';\n<Check className=\"h-4 w-4\" />\n```\n\n**Brand glyphs.** Brand logos (Google, GitHub, Stripe, etc.) live as SVG components in `components/brand/`, owned by frontend-agent. NEVER reference brand logos through Lucide.\n\n**Domain enums.** Every domain enum (status, role, type, etc.) is owned by frontend-agent for the TS side (`types/`) and by the corresponding api-agent biome for the Python side (`api/<domain>/models.py`). Both sides MUST stay in sync; the contract amendment process covers both edits.\n\n**Route names.** Next.js App Router uses file-based routing — route paths are file paths under `app/`. The planner appends the full route map below from the brief's page inventory. Cross-route navigation uses typed `Link href` literals or a `routes` constant exported from `lib/routes.ts`. Biomes do NOT inline route strings.\n\n### F. Style System Rules\n\n1. **NEVER hardcode hex colors in component code.** All colors come from Tailwind tokens defined in `tailwind.config.ts`. Theme tokens live in CSS variables. Rationale: hardcoded hex defeats the token system and prevents theme switching.\n\n   ```tsx\n   // GOOD\n   <div className=\"bg-primary text-primary-foreground\" />\n   // BAD\n   <div style={{ backgroundColor: '#7C5CFF' }} />\n   ```\n\n2. **Conditional className composition uses `cn` from `lib/utils.ts`** (clsx + tailwind-merge). Never inline string concatenation.\n\n   ```tsx\n   // GOOD\n   <div className={cn('base-classes', active && 'bg-primary', disabled && 'opacity-50')} />\n   // BAD\n   <div className={`base-classes ${active ? 'bg-primary' : ''}`} />\n   ```\n\n3. **Class-Variance-Authority (cva) for primitive variants.** Every primitive that exposes a `variant` or `size` prop MUST implement them via `cva`. NEVER ad-hoc switch statements over variant strings.\n\n4. **Server Components by default; Client Components only when needed.** Add `'use client'` only when the component uses state, effects, browser APIs, or event handlers. Rationale: Server Component default keeps bundle size down and aligns with App Router conventions.\n\n5. **TypeScript strict mode.** No `any`. No `@ts-ignore` (use `@ts-expect-error` with a comment explaining why, or fix the type). No `as` casts on shared primitives.\n\n6. **API responses are typed end-to-end.** FastAPI Pydantic models on the backend; matching TS interfaces on the frontend. NEVER consume an API response without a type. The api-agent biome owns the source-of-truth Pydantic models; frontend-agent owns the TS mirrors.\n\n### G. Screen Ownership Matrix (universal rules — planner appends per-route table)\n\nNext.js App Router uses file-based routing — there is no central RootNavigator to stub. Each route is a directory under `app/` with a `page.tsx` (and optionally `layout.tsx`, `loading.tsx`, `error.tsx`).\n\n**Universal wiring rules:**\n\n1. **Every route in the brief's route inventory MUST have a real `page.tsx` file.** Stubbing pages with `export default function Page() { return null; }` is FORBIDDEN — it produces the same black-screen failure mode as React Native's PlaceholderScreen anti-pattern. Either ship a real page or ship a visible placeholder showing the route name and \"Page pending\" copy.\n\n2. **Each domain biome owns its own `app/<domain>/` subtree.** `frontend-agent` owns `app/(marketing)/`, layout files, and root-level files (`app/layout.tsx`, `app/page.tsx`); domain biomes own everything under their domain segment.\n\n3. **Server vs client components**: routes default to Server Components. `'use client'` is required only when state, effects, or browser APIs are needed.\n\n**Required table format** (planner generates from the brief's route inventory):\n\n| Route | Owner biome | File path | Type |\n|---|---|---|---|\n| `/` | frontend-agent | `app/page.tsx` | server |\n| `/login` | auth-agent | `app/(auth)/login/page.tsx` | client |\n| `/dashboard` | frontend-agent | `app/dashboard/page.tsx` | server |\n| ... (every route in the brief) | ... | ... | ... |\n\n**Anti-pattern (FORBIDDEN):** empty pages returning `null`. If a page's logic isn't yet shipped, render a visible placeholder with the route path and a \"Page pending\" message on the theme background.\n\n### H. Security Rules\n\nSection H is the security contract surface for the nextjs-fastapi-supabase stack. Initial baseline — will tighten on first cultivation. Rules tagged with tiers: `[demo]` everywhere, `[startup]` startup+regulated, `[regulated]` regulated only, `[always-block]` blocks at every tier.\n\n#### H.1 Secret Management\n\n##### H.1.1 No hardcoded secrets in committed code [always-block]\nRule: No real API keys, tokens, or credentials in committed source. Exempt:\n  literals containing `placeholder` matching demo-stub patterns.\nAudit: `grep -rEn 'sk_live_|sk_test_|eyJ[A-Za-z0-9]{30,}|service_role|AKIA[0-9A-Z]{16}' src/ api/` excluding lines containing `placeholder` returns zero.\nViolation: freeze-block at all tiers.\n\n##### H.1.2 .env gitignored [demo]\nRule: `.env`, `.env.local`, `.env.production` listed in `.gitignore`. Only `.env.example` (no real values) committed.\nAudit: parse `.gitignore`; `git ls-files` for .env* returns at most `.env.example`.\nViolation: demo=advisory, startup+=freeze-block.\n\n##### H.1.3 Server secrets never in client bundle [always-block]\nRule: Next.js client code (under `app/` or `components/` consumed by client components) MUST NOT reference secrets without `NEXT_PUBLIC_` prefix. Server-only secrets (no prefix) used only in Server Components, Server Actions, Route Handlers, or under `api/` (FastAPI).\nAudit: in `'use client'`-annotated files, grep for env var references not starting with `NEXT_PUBLIC_`; must return zero.\nViolation: freeze-block at all tiers.\n\n#### H.2 Auth Flows\n\n##### H.2.1 Sessions in httpOnly cookies, never localStorage [demo]\nRule: Auth tokens persisted as httpOnly + Secure + SameSite=Strict cookies. `localStorage`, `sessionStorage` for sessions are forbidden.\nAudit: grep `localStorage.setItem` and `sessionStorage.setItem` in src/ near auth/session/token identifiers.\nViolation: demo=advisory, startup+=freeze-block.\n\n#### H.3 Database (RLS)\n\n##### H.3.1 Every Supabase table has RLS enabled [always-block]\nRule: Every `CREATE TABLE` in migrations is followed by `ENABLE ROW LEVEL SECURITY` in the same file.\nAudit: regex parse SQL migrations.\nViolation: freeze-block at all tiers.\n\n#### H.4 PII Handling\n\n##### H.4.1 PII categories defined [demo]\nRule: NUTRIENTS.md §H.4 defines PII vocabulary (default: email, phone, address, payment, legal name, location, national IDs).\nAudit: contract-vs-contract via audit prompt.\nViolation: demo=advisory, startup+=freeze-block.\n\n##### H.4.2 No PII in logs [demo]\nRule: `console.log`, `console.error`, server logger calls, and `Sentry.captureException` MUST NOT include PII identifiers.\nAudit: regex grep for log calls containing PII identifier names.\nViolation: demo=advisory, startup+=freeze-block.\n\n(Other rules — H.2.2/H.2.3, H.3.2-5, H.4.3-5 — refine on first cultivation.)\n\n---\n\n## STACK-CANON OVERRIDE (Talent Agent specific)\n\n**The verbatim contract appendix Section H above is partially NEGATED for this organism.**\n\nThis repo uses `--stack nextjs-fastapi-supabase` because no `fastapi-postgres` preset exists. The preset's rules conflict with this repo's actual stack. When the preset and this override conflict, **this override wins — always.**\n\n### Negated Rules (do NOT enforce)\n\n- **H.1.3 (`NEXT_PUBLIC_` prefix)** — NEGATED. This repo uses **React 19 + Vite 8**, NOT Next.js. Env vars use `VITE_*` prefix per Vite's `import.meta.env` convention.\n\n- **H.2.1 (httpOnly cookies)** — NEGATED. JWT storage is **localStorage** per iter-2's resolved decision. `AuthContext` reads/writes localStorage directly, sets `Bearer` header in `lib/api.js`.\n\n- **H.3.1 (Supabase RLS)** — NEGATED. This repo uses **raw PostgreSQL 15 via SQLAlchemy 2.0 async + Alembic**. No Supabase, no RLS policies.\n\n### Positive Stack Canon\n\n| Layer | Actual Stack |\n|---|---|\n| Frontend | React 19 · Vite 8 · Tailwind 4 · lucide-react · react-router-dom 7 |\n| Backend | FastAPI · Python 3.12 · Pydantic v2 · SQLAlchemy 2.0 async · Alembic |\n| Database | PostgreSQL 15 raw, via SQLAlchemy async engine |\n| Auth | JWT HS256, 7d, stored in localStorage, sent as `Authorization: Bearer <token>` |\n| Storage | Local FS (dev) / S3 (prod future) |\n| Env vars | `VITE_*` for frontend, unprefixed for backend |\n\n---\n\n## ORGANISM-SPECIFIC EXTENSIONS\n\n### C. Symbol Ownership Matrix (organism rows)\n\n| Symbol | Owner biome | File path |\n|---|---|---|\n| `Candidate`, `CandidateSchema` | data-agent | `backend/models/discovery.py`, `backend/agents/discovery/schemas.py` |\n| `DiscoveredJob`, `DiscoveredJobSchema` | data-agent | `backend/models/discovery.py`, `backend/agents/discovery/schemas.py` |\n| `ScoredJob`, `ScoredJobSchema` | data-agent | `backend/models/discovery.py`, `backend/agents/discovery/schemas.py` |\n| `DailyDigest`, `DailyDigestSchema` | data-agent | `backend/models/discovery.py`, `backend/agents/discovery/schemas.py` |\n| `CrawlRun` | data-agent | `backend/models/discovery.py` |\n| `ParsedJD`, `ParsedJDSchema` | data-agent | `backend/models/application.py`, `backend/agents/application/schemas.py` |\n| `TailoredResume`, `TailoredResumeSchema` | data-agent | `backend/models/application.py`, `backend/agents/application/schemas.py` |\n| `CompanyIntel`, `CompanyIntelSchema` | data-agent | `backend/models/application.py`, `backend/agents/application/schemas.py` |\n| `Contact`, `ContactSchema` | data-agent | `backend/models/application.py`, `backend/agents/application/schemas.py` |\n| `ApplicationPipeline`, `ApplicationPipelineSchema` | data-agent | `backend/models/application.py`, `backend/agents/application/schemas.py` |\n| `CRMEvent` | data-agent | `backend/models/application.py` |\n| `User`, `MagicLink` | data-agent | `backend/models/auth.py` |\n| `IdentityProfileSchema` | data-agent | `backend/agents/discovery/schemas.py` |\n| `SearchManifestSchema` | data-agent | `backend/agents/discovery/schemas.py` |\n| `ScoreBreakdown` | data-agent | `backend/agents/discovery/schemas.py` |\n| `OutreachEmailSchema` | data-agent | `backend/agents/application/schemas.py` |\n| `AuthContext` | frontend-agent | `frontend/src/context/AuthContext.jsx` |\n| `DashboardLayout` | frontend-agent | `frontend/src/layouts/DashboardLayout.jsx` |\n| `Sidebar` | frontend-agent | `frontend/src/components/Sidebar.jsx` |\n| `TopBar` | frontend-agent | `frontend/src/components/TopBar.jsx` |\n| `StatCard` | frontend-agent | `frontend/src/components/StatCard.jsx` |\n| `StatusBadge` | frontend-agent | `frontend/src/components/StatusBadge.jsx` |\n| `api` (client) | frontend-agent | `frontend/src/lib/api.js` |\n| `routes` | frontend-agent | `frontend/src/lib/routes.js` |\n| `IdentityProfiler` | discover-agent | `backend/agents/discovery/identity_profiler.py` |\n| `ArchetypeGenerator` | discover-agent | `backend/agents/discovery/archetype_generator.py` |\n| `CrawlerAgent` | discover-agent | `backend/agents/discovery/crawler_agent.py` |\n| `RelevanceScorer` | discover-agent | `backend/agents/discovery/relevance_scorer.py` |\n| `DigestBuilder` | discover-agent | `backend/agents/discovery/digest_builder.py` |\n| `DiscoveryOrchestrator` | discover-agent | `backend/agents/discovery/orchestrator.py` |\n| `JDParser` | apply-agent | `backend/agents/application/jd_parser.py` |\n| `ResumeTailor` | apply-agent | `backend/agents/application/resume_tailor.py` |\n| `CompanyIntelAgent` | apply-agent | `backend/agents/application/company_intel.py` |\n| `ContactFinder` | apply-agent | `backend/agents/application/contact_finder.py` |\n| `OutreachComposer` | apply-agent | `backend/agents/application/outreach_composer.py` |\n| `AutoApplyAgent` | apply-agent | `backend/agents/application/auto_apply.py` |\n| `CRM` | apply-agent | `backend/agents/application/crm.py` |\n| `ApplicationOrchestrator` | apply-agent | `backend/agents/application/orchestrator.py` |\n| `AgentManager` | agents-agent | `backend/agents/application/agent_manager.py` |\n| `SubAgentRegistry` | agents-agent | `backend/agents/application/agent_manager.py` |\n| `SubAgentRunner` | agents-agent | `backend/agents/application/agent_manager.py` |\n| `PipelineDispatcher` | agents-agent | `backend/agents/application/agent_manager.py` |\n| `get_current_user` | auth-agent | `backend/api/auth.py` |\n\n### E. Allow-listed Identifiers (organism extension)\n\n#### Domain Enums\n\n```typescript\n// Job source enum\nexport type JobSource = 'greenhouse' | 'lever' | 'ashby' | 'workday';\n\n// Crawl run status\nexport type CrawlRunStatus = 'QUEUED' | 'RUNNING' | 'COMPLETED' | 'FAILED';\n\n// Application pipeline status (state machine)\nexport type ApplicationPipelineStatus =\n  | 'QUEUED'\n  | 'PARSING'\n  | 'TAILORING'\n  | 'RESEARCHING'\n  | 'COMPOSING'\n  | 'AWAITING_REVIEW'\n  | 'APPROVED'\n  | 'REJECTED'\n  | 'SUBMITTED'\n  | 'SENT'\n  | 'TRACKED'\n  | 'FAILED'\n  | 'REQUIRES_MANUAL';\n\n// Agent status (lifecycle)\nexport type AgentStatus =\n  | 'QUEUED'\n  | 'DISPATCHED'\n  | 'RUNNING'\n  | 'COMPLETED'\n  | 'FAILED'\n  | 'RETRYING'\n  | 'DEAD';\n\n// Contact confidence\nexport type ContactConfidence = 'HIGH' | 'MEDIUM' | 'LOW';\n\n// Remote preference\nexport type RemotePreference = 'remote_only' | 'hybrid' | 'onsite' | 'flexible';\n\n// Outreach status\nexport type OutreachStatus = 'DRAFT' | 'SENT' | 'BOUNCED' | 'REPLIED';\n```\n\n#### Route Map (React Router DOM, NOT Next.js App Router)\n\nThis organism uses React Router DOM with `react-router-dom@7`, NOT Next.js App Router. Routes are defined in `frontend/src/App.jsx`.\n\n```typescript\n// Route definitions (for lib/routes.js)\nexport const routes = {\n  landing: '/',\n  login: '/login',\n  verifyAuth: '/auth/verify',\n  onboarding: '/onboarding',\n  overview: '/overview',\n  candidates: '/candidates',\n  pipeline: '/pipeline',\n  reviewQueue: '/review-queue',\n  analytics: '/analytics',\n  settings: '/settings',\n} as const;\n\nexport type RouteName = keyof typeof routes;\n```\n\n### G. Screen Ownership Matrix (organism routes)\n\n**Note:** This organism uses React Router DOM (`react-router-dom@7`), NOT Next.js App Router. Routes are file-based under `frontend/src/pages/`.\n\n| Route | Owner biome | File path | Type |\n|---|---|---|---|\n| `/` | frontend-agent | `frontend/src/pages/Landing.jsx` | client |\n| `/login` | frontend-agent | `frontend/src/pages/Login.jsx` | client |\n| `/auth/verify` | frontend-agent | `frontend/src/pages/VerifyAuth.jsx` | client |\n| `/onboarding` | frontend-agent | `frontend/src/pages/Onboarding.jsx` | client |\n| `/overview` | frontend-agent | `frontend/src/pages/Overview.jsx` | client |\n| `/candidates` | frontend-agent | `frontend/src/pages/Candidates.jsx` | client |\n| `/pipeline` | frontend-agent | `frontend/src/pages/Pipeline.jsx` | client |\n| `/review-queue` | frontend-agent | `frontend/src/pages/ReviewQueue.jsx` | client |\n| `/analytics` | frontend-agent | `frontend/src/pages/Analytics.jsx` | client |\n| `/settings` | frontend-agent | `frontend/src/pages/Settings.jsx` | client |\n\n---\n\n## DATA_CONTRACTS\n\nFull TypeScript interfaces for every domain entity. These mirror the Pydantic schemas in `backend/agents/*/schemas.py`.\n\n```typescript\n// === Discovery Domain ===\n\nexport interface Candidate {\n  id: string; // UUID\n  name: string;\n  email: string;\n  resume_text: string;\n  linkedin_url: string | null;\n  github_url: string | null;\n  personal_context: string | null;\n  target_locations: string[];\n  remote_preference: RemotePreference;\n  min_compensation: number | null;\n  excluded_companies: string[];\n  excluded_industries: string[];\n  created_at: string; // ISO 8601\n  updated_at: string; // ISO 8601\n}\n\nexport interface IdentityProfile {\n  archetypes: string[];\n  leadership_level: 'IC' | 'Lead' | 'Manager' | 'Director' | 'VP' | 'C-Level';\n  technical_skills: string[];\n  soft_skills: string[];\n  industry_experience: string[];\n  notable_achievements: string[];\n  career_trajectory: string;\n  ideal_role_description: string;\n  signals: Record<string, string>;\n}\n\nexport interface SearchManifest {\n  target_titles: string[];\n  keywords: string[];\n  excluded_titles: string[];\n  excluded_companies: string[];\n  excluded_industries: string[];\n  location_filters: string[];\n  remote_preference: RemotePreference;\n  min_compensation: number | null;\n}\n\nexport interface DiscoveredJob {\n  id: string; // UUID\n  source: JobSource;\n  source_id: string;\n  title: string;\n  company: string;\n  location: string;\n  description: string;\n  url: string;\n  posted_at: string | null; // ISO 8601\n  salary_min: number | null;\n  salary_max: number | null;\n  remote: boolean;\n  crawled_at: string; // ISO 8601\n}\n\nexport interface ScoreBreakdown {\n  technical_match: number; // 0-100\n  level_match: number; // 0-100\n  culture_match: number; // 0-100\n  industry_match: number; // 0-100\n  growth_potential: number; // 0-100\n  compensation_match: number; // 0-100\n}\n\nexport interface ScoredJob {\n  id: string; // UUID\n  discovered_job_id: string; // FK\n  candidate_id: string; // FK\n  score_breakdown: ScoreBreakdown;\n  composite_score: number; // 0-100\n  is_hot: boolean;\n  reasoning: string;\n  scored_at: string; // ISO 8601\n}\n\nexport interface DailyDigest {\n  id: string; // UUID\n  candidate_id: string; // FK\n  run_date: string; // YYYY-MM-DD\n  top_picks: ScoredJob[];\n  hot_picks: ScoredJob[];\n  new_companies: string[];\n  total_jobs_discovered: number;\n  total_jobs_scored: number;\n  created_at: string; // ISO 8601\n}\n\nexport interface CrawlRun {\n  id: string; // UUID\n  candidate_id: string; // FK\n  status: CrawlRunStatus;\n  jobs_discovered: number;\n  jobs_scored: number;\n  started_at: string; // ISO 8601\n  completed_at: string | null; // ISO 8601\n  error_log: string | null;\n}\n\n// === Application Domain ===\n\nexport interface ParsedJD {\n  id: string; // UUID\n  job_id: string; // FK to discovered_jobs\n  required_skills: string[];\n  preferred_skills: string[];\n  seniority_level: string;\n  tech_stack: string[];\n  culture_signals: string[];\n  tone: string;\n  pain_points: string[];\n  compensation_range: string | null;\n  red_flags: string[];\n  application_instructions: string | null;\n  parsed_at: string; // ISO 8601\n}\n\nexport interface TailoredResume {\n  id: string; // UUID\n  pipeline_id: string; // FK\n  original_text: string;\n  tailored_text: string;\n  change_log: string[];\n  gap_analysis: string;\n  created_at: string; // ISO 8601\n}\n\nexport interface CompanyIntel {\n  id: string; // UUID\n  pipeline_id: string; // FK\n  company_name: string;\n  about: string;\n  recent_news: string[];\n  tech_stack: string[];\n  engineering_culture: string;\n  growth_stage: string;\n  team_size: string | null;\n  notable_facts: string[];\n  researched_at: string; // ISO 8601\n}\n\nexport interface Contact {\n  id: string; // UUID\n  pipeline_id: string; // FK\n  name: string;\n  title: string;\n  email: string;\n  linkedin_url: string | null;\n  confidence: ContactConfidence;\n  fallback_email: string | null;\n  source: string;\n  found_at: string; // ISO 8601\n}\n\nexport interface OutreachEmail {\n  id: string; // UUID\n  pipeline_id: string; // FK\n  subject_lines: string[]; // 3 variants\n  body: string; // 150-200 words\n  status: OutreachStatus;\n  created_at: string; // ISO 8601\n}\n\nexport interface ApplicationPipeline {\n  id: string; // UUID\n  candidate_id: string; // FK\n  job_id: string; // FK to scored_jobs\n  status: ApplicationPipelineStatus;\n  parsed_jd: ParsedJD | null;\n  tailored_resume: TailoredResume | null;\n  company_intel: CompanyIntel | null;\n  contact: Contact | null;\n  outreach_email: OutreachEmail | null;\n  approval_timestamp: string | null; // ISO 8601\n  submitted_at: string | null; // ISO 8601\n  screenshots: string[]; // paths to screenshot files\n  created_at: string; // ISO 8601\n  updated_at: string; // ISO 8601\n}\n\nexport interface CRMEvent {\n  id: string; // UUID\n  pipeline_id: string; // FK\n  event_type: string; // SCREAMING_SNAKE_CASE\n  payload: Record<string, unknown>;\n  created_at: string; // ISO 8601\n}\n\n// === Auth Domain ===\n\nexport interface User {\n  id: string; // UUID\n  email: string;\n  name: string | null;\n  is_active: boolean;\n  is_onboarded: boolean;\n  candidate_id: string | null; // FK\n  last_login_at: string | null; // ISO 8601\n  created_at: string; // ISO 8601\n  updated_at: string; // ISO 8601\n}\n\nexport interface MagicLink {\n  id: string; // UUID\n  user_id: string; // FK\n  token: string; // 48-byte URL-safe\n  expires_at: string; // ISO 8601\n  is_used: boolean;\n  created_at: string; // ISO 8601\n}\n\n// === Agent Execution ===\n\nexport interface AgentExecutionRecord {\n  execution_id: string; // UUID\n  agent_name: string;\n  pipeline_id: string;\n  status: AgentStatus;\n  input_payload: Record<string, unknown>;\n  output_payload: Record<string, unknown> | null;\n  error: string | null;\n  attempt: number;\n  started_at: string; // ISO 8601\n  completed_at: string | null; // ISO 8601\n  duration_ms: number | null;\n  token_usage: {\n    prompt_tokens: number;\n    completion_tokens: number;\n    total_tokens: number;\n  } | null;\n}\n```\n\n---\n\n## DESIGN_TOKENS\n\n**Variant:** Top Shelf — Editorial Consulting (gold-on-black, seanyoung.biz-derived)\n\n### Color Palette\n\n```css\n:root {\n  /* Primary palette */\n  --gold: #C9A227;\n  --gold-dim: rgba(201, 162, 39, 0.7);\n  --gold-faint: rgba(201, 162, 39, 0.15);\n\n  /* Backgrounds */\n  --bg-primary: #0A0A0A;\n  --bg-secondary: #141414;\n  --bg-tertiary: #1A1A1A;\n  --bg-elevated: #1F1F1F;\n\n  /* Text */\n  --text-primary: #FAFAFA;\n  --text-secondary: #A3A3A3;\n  --text-muted: #737373;\n\n  /* Borders */\n  --border: rgba(255, 255, 255, 0.08);\n  --border-hover: rgba(255, 255, 255, 0.15);\n\n  /* Status colors */\n  --status-success: #22C55E;\n  --status-warning: #EAB308;\n  --status-error: #EF4444;\n  --status-info: #3B82F6;\n  --status-pending: #A855F7;\n  --status-hot: #F97316;\n\n  /* Semantic */\n  --accent: var(--gold);\n  --accent-hover: #D4AF37;\n  --destructive: #DC2626;\n  --destructive-hover: #B91C1C;\n}\n```\n\n### Typography Scale\n\n```css\n:root {\n  /* Font families */\n  --font-serif: 'Playfair Display', Georgia, serif;\n  --font-sans: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;\n  --font-mono: 'DM Mono', 'Fira Code', monospace;\n\n  /* Font sizes */\n  --text-xs: 0.75rem;    /* 12px */\n  --text-sm: 0.875rem;   /* 14px */\n  --text-base: 1rem;     /* 16px */\n  --text-lg: 1.125rem;   /* 18px */\n  --text-xl: 1.25rem;    /* 20px */\n  --text-2xl: 1.5rem;    /* 24px */\n  --text-3xl: 1.875rem;  /* 30px */\n  --text-4xl: 2.25rem;   /* 36px */\n  --text-5xl: 3rem;      /* 48px */\n\n  /* Line heights */\n  --leading-tight: 1.25;\n  --leading-normal: 1.5;\n  --leading-relaxed: 1.75;\n\n  /* Font weights */\n  --font-normal: 400;\n  --font-medium: 500;\n  --font-semibold: 600;\n  --font-bold: 700;\n}\n```\n\n### Typography Utility Classes\n\n```css\n/* Page headings — Playfair Display bold */\n.t-serif-bold {\n  font-family: var(--font-serif);\n  font-weight: var(--font-bold);\n  font-size: var(--text-5xl);\n  line-height: var(--leading-tight);\n  color: var(--text-primary);\n}\n\n/* Section headings — Playfair Display regular */\n.t-serif {\n  font-family: var(--font-serif);\n  font-weight: var(--font-normal);\n  font-size: var(--text-2xl);\n  line-height: var(--leading-tight);\n  color: var(--text-primary);\n}\n\n/* Labels — DM Sans uppercase tracking */\n.t-label {\n  font-family: var(--font-sans);\n  font-weight: var(--font-medium);\n  font-size: var(--text-xs);\n  line-height: var(--leading-normal);\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  color: var(--text-secondary);\n}\n\n/* Gold accent labels */\n.t-label-gold {\n  font-family: var(--font-sans);\n  font-weight: var(--font-medium);\n  font-size: var(--text-xs);\n  line-height: var(--leading-normal);\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  color: var(--gold);\n}\n\n/* Body text — DM Sans */\n.t-body {\n  font-family: var(--font-sans);\n  font-weight: var(--font-normal);\n  font-size: var(--text-base);\n  line-height: var(--leading-relaxed);\n  color: var(--text-primary);\n}\n\n/* Mono / code */\n.t-mono {\n  font-family: var(--font-mono);\n  font-size: var(--text-sm);\n  line-height: var(--leading-normal);\n}\n```\n\n### Spacing Scale\n\n```css\n:root {\n  --space-0: 0;\n  --space-1: 0.25rem;   /* 4px */\n  --space-2: 0.5rem;    /* 8px */\n  --space-3: 0.75rem;   /* 12px */\n  --space-4: 1rem;      /* 16px */\n  --space-5: 1.25rem;   /* 20px */\n  --space-6: 1.5rem;    /* 24px */\n  --space-8: 2rem;      /* 32px */\n  --space-10: 2.5rem;   /* 40px */\n  --space-12: 3rem;     /* 48px */\n  --space-16: 4rem;     /* 64px */\n  --space-20: 5rem;     /* 80px */\n  --space-24: 6rem;     /* 96px */\n}\n```\n\n### Border Radii\n\n```css\n:root {\n  --radius-none: 0;\n  --radius-sm: 0.125rem;  /* 2px */\n  --radius-md: 0.375rem;  /* 6px */\n  --radius-lg: 0.5rem;    /* 8px */\n  --radius-xl: 0.75rem;   /* 12px */\n  --radius-full: 9999px;\n}\n```\n\n### Shadows\n\n```css\n:root {\n  /* Minimal shadows — editorial aesthetic prefers border over shadow */\n  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.4);\n  --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.4);\n  --shadow-lg: 0 10px 15px rgba(0, 0, 0, 0.5);\n\n  /* Glow effects for accent elements */\n  --glow-gold: 0 0 20px rgba(201, 162, 39, 0.3);\n}\n```\n\n### Motion / Transitions\n\n```css\n:root {\n  /* Durations */\n  --duration-fast: 150ms;\n  --duration-normal: 200ms;\n  --duration-slow: 300ms;\n\n  /* Easing */\n  --ease-default: cubic-bezier(0.4, 0, 0.2, 1);\n  --ease-in: cubic-bezier(0.4, 0, 1, 1);\n  --ease-out: cubic-bezier(0, 0, 0.2, 1);\n  --ease-bounce: cubic-bezier(0.68, -0.55, 0.265, 1.55);\n}\n\n/* Standard transition shorthand */\n.transition-default {\n  transition: all var(--duration-normal) var(--ease-default);\n}\n```\n\n### Scrollbar Treatment\n\n```css\n/* Webkit scrollbars */\n::-webkit-scrollbar {\n  width: 8px;\n  height: 8px;\n}\n\n::-webkit-scrollbar-track {\n  background: var(--bg-secondary);\n}\n\n::-webkit-scrollbar-thumb {\n  background: var(--border);\n  border-radius: var(--radius-full);\n}\n\n::-webkit-scrollbar-thumb:hover {\n  background: var(--border-hover);\n}\n```\n\n### Selection Treatment\n\n```css\n::selection {\n  background: var(--gold-faint);\n  color: var(--gold);\n}\n```\n\n---\n\n## API_CONTRACTS\n\nFull request/response shapes per endpoint.\n\n### Auth Endpoints\n\n#### POST /api/v1/auth/request-link\n\nRequest magic link for email.\n\n```typescript\n// Request\ninterface RequestLinkRequest {\n  email: string;\n}\n\n// Response (200)\ninterface RequestLinkResponse {\n  message: string;\n  magic_link?: string; // Only in DEBUG=true\n  token?: string; // Only in DEBUG=true\n}\n```\n\n#### POST /api/v1/auth/verify\n\nVerify magic link token, return JWT.\n\n```typescript\n// Request\ninterface VerifyRequest {\n  token: string;\n}\n\n// Response (200)\ninterface VerifyResponse {\n  access_token: string;\n  token_type: 'bearer';\n  user_id: string;\n  email: string;\n  is_onboarded: boolean;\n}\n\n// Error responses\n// 401: \"This link has already been used\"\n// 401: \"This link has expired\"\n// 401: \"Invalid or expired link\"\n```\n\n#### GET /api/v1/auth/me\n\nGet current authenticated user.\n\n```typescript\n// Headers: Authorization: Bearer <jwt>\n\n// Response (200)\ninterface MeResponse {\n  id: string;\n  email: string;\n  name: string | null;\n  is_onboarded: boolean;\n  candidate_id: string | null;\n  created_at: string;\n}\n\n// Error responses\n// 401: \"Not authenticated\"\n// 401: \"Token expired\"\n// 401: \"User not found or inactive\"\n```\n\n### Onboarding Endpoints\n\n#### POST /api/v1/onboarding/resume\n\nUpload resume PDF (multipart).\n\n```typescript\n// Request: multipart/form-data\n// Field: file (PDF, max 10MB)\n\n// Response (200)\ninterface ResumeUploadResponse {\n  message: string;\n  candidate_id: string;\n  text_length: number;\n  preview: string; // First 500 chars\n}\n\n// Error responses\n// 422: \"Only PDF files are accepted...\"\n// 422: \"File too large. Max 10MB.\"\n// 422: \"Could not extract any text from the PDF\"\n```\n\n#### POST /api/v1/onboarding/profile\n\nSave candidate profile.\n\n```typescript\n// Request\ninterface ProfileRequest {\n  name: string;\n  linkedin_url?: string;\n  github_url?: string;\n  personal_context?: string;\n  target_locations?: string[];\n  remote_preference?: RemotePreference; // default: 'flexible'\n  min_compensation?: number;\n  excluded_companies?: string[];\n  excluded_industries?: string[];\n}\n\n// Response (200)\ninterface ProfileResponse {\n  message: string;\n  candidate_id: string;\n  is_onboarded: boolean;\n}\n\n// Error responses\n// 400: \"Please upload your resume first...\"\n```\n\n#### GET /api/v1/onboarding/status\n\nGet onboarding completeness.\n\n```typescript\n// Response (200)\ninterface OnboardingStatusResponse {\n  is_onboarded: boolean;\n  has_resume: boolean;\n  has_profile: boolean;\n  candidate_id?: string;\n}\n```\n\n### Discovery Endpoints\n\n#### POST /api/v1/discovery/trigger\n\nTrigger discovery run for candidate.\n\n```typescript\n// Request\ninterface TriggerDiscoveryRequest {\n  candidate_id: string;\n  dry_run?: boolean; // default: false\n}\n\n// Response (200)\ninterface TriggerDiscoveryResponse {\n  crawl_run_id: string;\n  status: CrawlRunStatus;\n  message: string;\n}\n```\n\n#### GET /api/v1/discovery/digest/{digest_id}\n\nGet daily digest by ID.\n\n```typescript\n// Response (200)\ninterface GetDigestResponse {\n  digest: DailyDigest;\n}\n\n// Error responses\n// 404: \"Digest not found\"\n```\n\n### Application Endpoints\n\n#### POST /api/v1/application/start\n\nStart application pipeline for a job.\n\n```typescript\n// Request\ninterface StartApplicationRequest {\n  job_id: string; // scored_job ID\n  candidate_id: string;\n}\n\n// Response (200)\ninterface StartApplicationResponse {\n  pipeline: ApplicationPipeline;\n}\n```\n\n#### POST /api/v1/application/submit/{pipeline_id}\n\nSubmit approved application.\n\n```typescript\n// Response (200)\ninterface SubmitApplicationResponse {\n  pipeline_id: string;\n  status: ApplicationPipelineStatus;\n  message: string;\n}\n\n// Error responses\n// 400: \"Pipeline must be APPROVED before submission\"\n// 404: \"Pipeline not found\"\n```\n\n#### GET /api/v1/application/list\n\nList application pipelines.\n\n```typescript\n// Query params\ninterface ListApplicationsQuery {\n  candidate_id?: string;\n  status?: ApplicationPipelineStatus;\n  limit?: number; // default: 50\n  offset?: number; // default: 0\n}\n\n// Response (200)\ninterface ListApplicationsResponse {\n  pipelines: ApplicationPipeline[];\n  total: number;\n}\n```\n\n#### GET /api/v1/application/{pipeline_id}\n\nGet pipeline details.\n\n```typescript\n// Response (200)\ninterface GetPipelineResponse {\n  pipeline: ApplicationPipeline;\n}\n\n// Error responses\n// 404: \"Pipeline not found\"\n```\n\n### Review Endpoints\n\n#### GET /api/v1/review/queue\n\nGet pipelines awaiting review.\n\n```typescript\n// Query params\ninterface ReviewQueueQuery {\n  candidate_id?: string;\n}\n\n// Response (200)\ninterface ReviewQueueResponse {\n  pipelines: ApplicationPipeline[]; // status = AWAITING_REVIEW\n}\n```\n\n#### POST /api/v1/review/{pipeline_id}/approve\n\nApprove pipeline for submission.\n\n```typescript\n// Response (200)\ninterface ApproveResponse {\n  pipeline_id: string;\n  status: 'APPROVED';\n  approval_timestamp: string;\n  message: string;\n}\n\n// Error responses\n// 404: \"Pipeline not found\"\n// 400: \"Pipeline is not awaiting review\"\n```\n\n#### POST /api/v1/review/{pipeline_id}/reject\n\nReject pipeline.\n\n```typescript\n// Request\ninterface RejectRequest {\n  reason?: string;\n}\n\n// Response (200)\ninterface RejectResponse {\n  pipeline_id: string;\n  status: 'REJECTED';\n  message: string;\n}\n\n// Error responses\n// 404: \"Pipeline not found\"\n// 400: \"Pipeline is not awaiting review\"\n```\n\n### Health Endpoint\n\n#### GET /health\n\nService health check.\n\n```typescript\n// Response (200)\ninterface HealthResponse {\n  status: 'ok';\n  version: string; // semver\n  git_sha: string;\n  redis: 'ok' | 'down';\n  db: 'ok' | 'down';\n}\n```\n\n---\n\n## H.4 PII Vocabulary (organism-specific)\n\nPII categories that MUST be redacted from logs:\n\n- `email` — candidate email, contact email, user email\n- `phone` — any phone numbers\n- `legal_name` — full legal name if distinct from display name\n- `resume_text` — full resume content\n- `personal_context` — candidate personal context field\n- `linkedin_url` — LinkedIn profile URL\n- `github_url` — GitHub profile URL\n- `address` — physical addresses\n- `compensation` — salary/compensation details\n\n---\n\n## ITER-4 CONTRACT EXTENSIONS\n\n### C. Symbol Ownership Matrix (iter-4 additions)\n\n| Symbol | Owner biome | File path |\n|---|---|---|\n| `celery_app` | scheduler-agent | `backend/scheduler/celery_app.py` |\n| `daily_discovery_task` | scheduler-agent | `backend/scheduler/tasks.py` |\n| `beat_schedule` | scheduler-agent | `backend/scheduler/beat.py` |\n| `events_router` | api-streaming-agent | `backend/api/events.py` |\n| `SSESubscriber` | api-streaming-agent | `backend/api/events.py` |\n| `apiClient` | api-client-agent | `frontend/src/api/client.ts` |\n| `requestMagicLink`, `verifyToken`, `refreshSession` | api-client-agent | `frontend/src/api/auth.ts` |\n| `getTodayDigest`, `triggerDiscoveryRun`, `getJob` | api-client-agent | `frontend/src/api/discovery.ts` |\n| `listApplications`, `approveApplication`, `rejectApplication` | api-client-agent | `frontend/src/api/applications.ts` |\n| `subscribeAgentStatus` | api-client-agent | `frontend/src/api/events.ts` |\n| `TalentAgentApiError` | api-client-agent | `frontend/src/api/client.ts` |\n| `_publish_status` | discover-agent | `backend/agents/discovery/orchestrator.py` |\n\n### E. Allow-listed Identifiers (iter-4 additions)\n\n#### Discovery Event Types\n\n```typescript\n// Events published to agent.status.discovery\nexport type DiscoveryEventType =\n  | 'RUN_STARTED'\n  | 'CANDIDATE_LOADED'\n  | 'PROFILE_BUILT'\n  | 'MANIFEST_BUILT'\n  | 'CRAWL_SOURCE_COMPLETE'  // includes {source, jobs_found}\n  | 'CRAWL_COMPLETE'\n  | 'SCORING_COMPLETE'\n  | 'RUN_COMPLETE'\n  | 'RUN_FAILED'\n  | 'DAILY_TASK_DEAD';  // from scheduler on terminal failure\n\n// Discovery status event payload\nexport interface DiscoveryStatusEvent {\n  candidate_id: string;\n  event: DiscoveryEventType;\n  ts: string;  // ISO-8601 UTC\n  source?: JobSource;  // present for CRAWL_SOURCE_COMPLETE\n  jobs_found?: number;  // present for CRAWL_SOURCE_COMPLETE\n  error?: string;  // present for RUN_FAILED, DAILY_TASK_DEAD\n}\n```\n\n#### SSE Event Stream\n\n```typescript\n// Allowed channels for SSE streaming\nexport type AllowedSSEChannel =\n  | 'agent.status.discovery'\n  | 'agent.status.application';\n\n// Slow client warning event\nexport interface SlowClientEvent {\n  dropped: number;\n}\n```\n\n#### Celery Task IDs\n\n```typescript\n// Daily discovery task ID format (for idempotency)\n// Pattern: discovery-{candidate_id}-{YYYY-MM-DD}\nexport type DailyDiscoveryTaskId = `discovery-${string}-${string}`;\n```\n\n### API_CONTRACTS (iter-4 additions)\n\n#### SSE Event Stream Endpoint\n\n##### GET /events/stream\n\nStream real-time agent status events via Server-Sent Events.\n\n```typescript\n// Query params\ninterface EventStreamQuery {\n  channel: AllowedSSEChannel;\n}\n\n// Headers required\n// Authorization: Bearer <jwt>\n\n// Response: text/event-stream\n// Each message is: data: {json}\\n\\n\n// Heartbeat every 15s: :ping\\n\\n\n// On backpressure: event: slow_client\\ndata: {\"dropped\": N}\\n\\n\n\n// Error responses\n// 400: \"Invalid channel. Allowed: agent.status.discovery, agent.status.application\"\n// 401: \"Not authenticated\"\n```\n\n### DATA_CONTRACTS (iter-4 additions)\n\n```typescript\n// === Scheduler Domain ===\n\nexport interface CeleryTaskRecord {\n  task_id: string;  // DailyDiscoveryTaskId format\n  candidate_id: string;\n  status: 'PENDING' | 'STARTED' | 'RETRY' | 'SUCCESS' | 'FAILURE';\n  retries: number;\n  started_at: string | null;  // ISO 8601\n  completed_at: string | null;  // ISO 8601\n  error_log: string | null;\n}\n\n// === API Client Domain ===\n\nexport interface TalentAgentApiErrorData {\n  status: number;  // HTTP status code\n  code: string;  // Backend error code if present\n  message: string;  // User-facing message\n}\n\n// API client configuration\nexport interface ApiClientConfig {\n  baseUrl: string;  // from VITE_API_BASE_URL\n  storageKey: 'talent-agent-jwt';\n}\n```\n\n### Iter-4 Dependency Additions\n\n**Backend (requirements.txt):**\n- celery>=5.3 — owner: scheduler-agent\n- fakeredis>=2.20 — owner: tests-agent (dev only)\n\n**Frontend (package.json devDependencies):**\n- vitest>=1.0 — owner: tests-agent\n","numLines":1388,"startLine":1,"totalLines":1388}}}}
