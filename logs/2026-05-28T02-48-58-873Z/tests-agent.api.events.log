{"t":"2026-05-28T02:58:52.316Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Fra8xd2MKGRdwxrRqGEJqK","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→from typing import Optional\n     5→\n     6→import redis.asyncio as aioredis\n     7→from sqlalchemy.ext.asyncio import create_async_engine, AsyncSession, async_sessionmaker\n     8→from sqlalchemy.orm import DeclarativeBase\n     9→from backend.config import settings\n    10→\n    11→engine = create_async_engine(\n    12→    settings.database_url,\n    13→    echo=settings.debug,\n    14→    pool_pre_ping=True,\n    15→    pool_size=10,\n    16→    max_overflow=20,\n    17→)\n    18→\n    19→AsyncSessionLocal = async_sessionmaker(\n    20→    engine,\n    21→    class_=AsyncSession,\n    22→    expire_on_commit=False,\n    23→)\n    24→\n    25→\n    26→class Base(DeclarativeBase):\n    27→    pass\n    28→\n    29→\n    30→async def get_db():\n    31→    \"\"\"\n    32→    FastAPI dependency that yields an async database session.\n    33→\n    34→    Automatically rolls back on exception to prevent partial commits.\n    35→    Contract: HYPHA-API.md Acceptance Criteria\n    36→    \"\"\"\n    37→    async with AsyncSessionLocal() as session:\n    38→        try:\n    39→            yield session\n    40→        except Exception:\n    41→            await session.rollback()\n    42→            raise\n    43→\n    44→\n    45→# ─── Redis Client ─────────────────────────────────────────────────────────────\n    46→\n    47→# Global Redis client — initialized lazily or at startup via lifespan\n    48→_redis_client: Optional[aioredis.Redis] = None\n    49→\n    50→\n    51→def set_redis_client(client: aioredis.Redis) -> None:\n    52→    \"\"\"Set the global Redis client (called from app lifespan).\"\"\"\n    53→    global _redis_client\n    54→    _redis_client = client\n    55→\n    56→\n    57→async def get_redis() -> aioredis.Redis:\n    58→    \"\"\"\n    59→    FastAPI dependency that returns the global Redis client.\n    60→\n    61→    The client is initialized at app startup via lifespan.\n    62→    Falls back to lazy initialization if not set.\n    63→    \"\"\"\n    64→    global _redis_client\n    65→    if _redis_client is None:\n    66→        _redis_client = aioredis.from_url(\n    67→            settings.redis_url,\n    68→            encoding=\"utf-8\",\n    69→            decode_responses=True,\n    70→        )\n    71→    return _redis_client\n    72→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"ef3e1c9a-082e-4b26-be4b-f026a2179071","uuid":"062526c6-bb62-414b-9a3c-974597c6c83e","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/database.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\nfrom typing import Optional\n\nimport redis.asyncio as aioredis\nfrom sqlalchemy.ext.asyncio import create_async_engine, AsyncSession, async_sessionmaker\nfrom sqlalchemy.orm import DeclarativeBase\nfrom backend.config import settings\n\nengine = create_async_engine(\n    settings.database_url,\n    echo=settings.debug,\n    pool_pre_ping=True,\n    pool_size=10,\n    max_overflow=20,\n)\n\nAsyncSessionLocal = async_sessionmaker(\n    engine,\n    class_=AsyncSession,\n    expire_on_commit=False,\n)\n\n\nclass Base(DeclarativeBase):\n    pass\n\n\nasync def get_db():\n    \"\"\"\n    FastAPI dependency that yields an async database session.\n\n    Automatically rolls back on exception to prevent partial commits.\n    Contract: HYPHA-API.md Acceptance Criteria\n    \"\"\"\n    async with AsyncSessionLocal() as session:\n        try:\n            yield session\n        except Exception:\n            await session.rollback()\n            raise\n\n\n# ─── Redis Client ─────────────────────────────────────────────────────────────\n\n# Global Redis client — initialized lazily or at startup via lifespan\n_redis_client: Optional[aioredis.Redis] = None\n\n\ndef set_redis_client(client: aioredis.Redis) -> None:\n    \"\"\"Set the global Redis client (called from app lifespan).\"\"\"\n    global _redis_client\n    _redis_client = client\n\n\nasync def get_redis() -> aioredis.Redis:\n    \"\"\"\n    FastAPI dependency that returns the global Redis client.\n\n    The client is initialized at app startup via lifespan.\n    Falls back to lazy initialization if not set.\n    \"\"\"\n    global _redis_client\n    if _redis_client is None:\n        _redis_client = aioredis.from_url(\n            settings.redis_url,\n            encoding=\"utf-8\",\n            decode_responses=True,\n        )\n    return _redis_client\n","numLines":72,"startLine":1,"totalLines":72}}}}
{"t":"2026-05-28T02:58:52.326Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PL7UAt5WRbvzxszZJV6k8W","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Redis pub/sub event taxonomy and CRM event types.\n     6→\n     7→Channel taxonomy from HYPHA-OBSERVABILITY.md:\n     8→  - agent.status.discovery    — Discovery Engine events (crawl, scoring, digest)\n     9→  - agent.status.application  — Application Engine events (pipeline status)\n    10→  - agent.status.subagent     — Sub-agent execution events (tool_use loop)\n    11→\n    12→Event payload rules:\n    13→  - Every payload is JSON with an `event` field (SCREAMING_SNAKE_CASE)\n    14→  - Payloads include pipeline_id, candidate_id, timestamps\n    15→  - No PII in event payloads — use IDs for reference\n    16→\n    17→CRM event types from crm.py docstring + HYPHA-OBSERVABILITY.md:\n    18→  - APPLICATION_STARTED\n    19→  - JD_PARSED\n    20→  - RESUME_TAILORED\n    21→  - COMPANY_RESEARCHED\n    22→  - CONTACT_FOUND\n    23→  - EMAIL_DRAFTED\n    24→  - APPROVED_FOR_SUBMISSION\n    25→  - SUBMITTED\n    26→  - EMAIL_SENT\n    27→  - EMAIL_OPENED\n    28→  - RESPONDED\n    29→  - INTERVIEW_SCHEDULED\n    30→  - OFFER_RECEIVED\n    31→  - REJECTED\n    32→  - PLACED\n    33→  - PIPELINE_FAILED\n    34→\"\"\"\n    35→\n    36→from __future__ import annotations\n    37→\n    38→import json\n    39→from datetime import datetime, timezone\n    40→from enum import Enum\n    41→from typing import Any, Optional\n    42→from uuid import UUID\n    43→\n    44→import redis.asyncio as aioredis\n    45→from pydantic import BaseModel, Field\n    46→\n    47→import structlog\n    48→\n    49→logger = structlog.get_logger(__name__)\n    50→\n    51→\n    52→# ─── Pub/Sub Channels ────────────────────────────────────────────────────────\n    53→\n    54→\n    55→class PubSubChannel(str, Enum):\n    56→    \"\"\"\n    57→    Canonical Redis pub/sub channels.\n    58→\n    59→    These are the ONLY allowed channels for agent status events.\n    60→    Any new channel must be added here and documented in HYPHA-OBSERVABILITY.md.\n    61→    \"\"\"\n    62→\n    63→    # Discovery Engine events\n    64→    DISCOVERY = \"agent.status.discovery\"\n    65→\n    66→    # Application Engine events (pipeline level)\n    67→    APPLICATION = \"agent.status.application\"\n    68→\n    69→    # Sub-agent execution events (Claude tool_use loop)\n    70→    SUBAGENT = \"agent.status.subagent\"\n    71→\n    72→\n    73→# ─── CRM Event Types ─────────────────────────────────────────────────────────\n    74→\n    75→\n    76→class CRMEventType(str, Enum):\n    77→    \"\"\"\n    78→    Canonical CRM event types for the application pipeline.\n    79→\n    80→    These events form the auditable timeline for each application.\n    81→    New event types must be added here — no ad-hoc strings in code.\n    82→    \"\"\"\n    83→\n    84→    # Pipeline lifecycle\n    85→    APPLICATION_STARTED = \"APPLICATION_STARTED\"\n    86→    PIPELINE_FAILED = \"PIPELINE_FAILED\"\n    87→\n    88→    # Processing stages\n    89→    JD_PARSED = \"JD_PARSED\"\n    90→    RESUME_TAILORED = \"RESUME_TAILORED\"\n    91→    COMPANY_RESEARCHED = \"COMPANY_RESEARCHED\"\n    92→    CONTACT_FOUND = \"CONTACT_FOUND\"\n    93→    EMAIL_DRAFTED = \"EMAIL_DRAFTED\"\n    94→\n    95→    # Review + submission\n    96→    APPROVED_FOR_SUBMISSION = \"APPROVED_FOR_SUBMISSION\"\n    97→    REJECTED = \"REJECTED\"\n    98→    SUBMITTED = \"SUBMITTED\"\n    99→    EMAIL_SENT = \"EMAIL_SENT\"\n   100→\n   101→    # Tracking (post-submission)\n   102→    EMAIL_OPENED = \"EMAIL_OPENED\"\n   103→    RESPONDED = \"RESPONDED\"\n   104→    INTERVIEW_SCHEDULED = \"INTERVIEW_SCHEDULED\"\n   105→    OFFER_RECEIVED = \"OFFER_RECEIVED\"\n   106→    PLACED = \"PLACED\"\n   107→\n   108→\n   109→# ─── Event Payload Schemas ───────────────────────────────────────────────────\n   110→\n   111→\n   112→class BaseEvent(BaseModel):\n   113→    \"\"\"Base schema for all pub/sub events.\"\"\"\n   114→\n   115→    event: str = Field(..., description=\"Event type in SCREAMING_SNAKE_CASE\")\n   116→    timestamp: str = Field(\n   117→        default_factory=lambda: datetime.now(timezone.utc).isoformat(),\n   118→        description=\"ISO 8601 timestamp\",\n   119→    )\n   120→\n   121→    class Config:\n   122→        extra = \"allow\"\n   123→\n   124→\n   125→class AgentStatusEvent(BaseEvent):\n   126→    \"\"\"\n   127→    Application pipeline status event.\n   128→\n   129→    Published to: agent.status.application\n   130→    \"\"\"\n   131→\n   132→    event: str = \"APPLICATION_STATUS\"\n   133→    pipeline_id: str\n   134→    candidate_id: str\n   135→    status: str\n   136→\n   137→\n   138→class PipelineStatusEvent(BaseEvent):\n   139→    \"\"\"\n   140→    Pipeline-level status event (used by PipelineDispatcher).\n   141→\n   142→    Published to: agent.status.application\n   143→    \"\"\"\n   144→\n   145→    event: str = \"PIPELINE_STATUS\"\n   146→    pipeline_id: str\n   147→    status: str\n   148→    details: dict[str, Any] = Field(default_factory=dict)\n   149→\n   150→\n   151→class SubAgentStatusEvent(BaseEvent):\n   152→    \"\"\"\n   153→    Sub-agent execution status event.\n   154→\n   155→    Published to: agent.status.subagent\n   156→    \"\"\"\n   157→\n   158→    event: str = \"SUBAGENT_STATUS\"\n   159→    execution_id: str\n   160→    agent_name: str\n   161→    pipeline_id: str\n   162→    status: str\n   163→    attempt: int = 1\n   164→    duration_ms: Optional[int] = None\n   165→\n   166→\n   167→class DigestReadyEvent(BaseEvent):\n   168→    \"\"\"\n   169→    Discovery digest completion event.\n   170→\n   171→    Published to: agent.status.discovery\n   172→    \"\"\"\n   173→\n   174→    event: str = \"DIGEST_READY\"\n   175→    digest_id: str\n   176→    candidate_id: str\n   177→    run_date: str\n   178→    total_discovered: int\n   179→    total_scored: int\n   180→    top_picks_count: int\n   181→    hot_picks_count: int\n   182→\n   183→\n   184→class CrawlStatusEvent(BaseEvent):\n   185→    \"\"\"\n   186→    Crawl run status event.\n   187→\n   188→    Published to: agent.status.discovery\n   189→    \"\"\"\n   190→\n   191→    event: str = \"CRAWL_STATUS\"\n   192→    crawl_run_id: str\n   193→    candidate_id: str\n   194→    status: str  # QUEUED, RUNNING, COMPLETED, FAILED\n   195→    jobs_discovered: Optional[int] = None\n   196→    jobs_scored: Optional[int] = None\n   197→    error: Optional[str] = None\n   198→\n   199→\n   200→# ─── Event Publisher ─────────────────────────────────────────────────────────\n   201→\n   202→\n   203→async def publish_event(\n   204→    redis_client: aioredis.Redis,\n   205→    channel: PubSubChannel | str,\n   206→    event: BaseEvent | dict[str, Any],\n   207→) -> int:\n   208→    \"\"\"\n   209→    Publish an event to a Redis pub/sub channel.\n   210→\n   211→    Args:\n   212→        redis_client: Async Redis client\n   213→        channel: Target pub/sub channel (use PubSubChannel enum)\n   214→        event: Event payload (Pydantic model or dict)\n   215→\n   216→    Returns:\n   217→        Number of subscribers that received the message\n   218→    \"\"\"\n   219→    # Normalize channel to string\n   220→    channel_str = channel.value if isinstance(channel, PubSubChannel) else channel\n   221→\n   222→    # Serialize event\n   223→    if isinstance(event, BaseModel):\n   224→        payload = event.model_dump_json()\n   225→    else:\n   226→        payload = json.dumps(event, default=str)\n   227→\n   228→    # Publish\n   229→    subscriber_count = await redis_client.publish(channel_str, payload)\n   230→\n   231→    logger.debug(\n   232→        \"pubsub.event_published\",\n   233→        channel=channel_str,\n   234→        event_type=event.event if isinstance(event, BaseEvent) else event.get(\"event\"),\n   235→        subscribers=subscriber_count,\n   236→    )\n   237→\n   238→    return subscriber_count\n   239→\n   240→\n   241→# ─── Convenience Publishers ──────────────────────────────────────────────────\n   242→\n   243→\n   244→async def publish_application_status(\n   245→    redis_client: aioredis.Redis,\n   246→    pipeline_id: UUID,\n   247→    candidate_id: UUID,\n   248→    status: str,\n   249→) -> int:\n   250→    \"\"\"Publish an application pipeline status update.\"\"\"\n   251→    event = AgentStatusEvent(\n   252→        pipeline_id=str(pipeline_id),\n   253→        candidate_id=str(candidate_id),\n   254→        status=status,\n   255→    )\n   256→    return await publish_event(redis_client, PubSubChannel.APPLICATION, event)\n   257→\n   258→\n   259→async def publish_subagent_status(\n   260→    redis_client: aioredis.Redis,\n   261→    execution_id: UUID,\n   262→    agent_name: str,\n   263→    pipeline_id: UUID,\n   264→    status: str,\n   265→    attempt: int = 1,\n   266→    duration_ms: Optional[int] = None,\n   267→) -> int:\n   268→    \"\"\"Publish a sub-agent execution status update.\"\"\"\n   269→    event = SubAgentStatusEvent(\n   270→        execution_id=str(execution_id),\n   271→        agent_name=agent_name,\n   272→        pipeline_id=str(pipeline_id),\n   273→        status=status,\n   274→        attempt=attempt,\n   275→        duration_ms=duration_ms,\n   276→    )\n   277→    return await publish_event(redis_client, PubSubChannel.SUBAGENT, event)\n   278→\n   279→\n   280→async def publish_digest_ready(\n   281→    redis_client: aioredis.Redis,\n   282→    digest_id: UUID,\n   283→    candidate_id: UUID,\n   284→    run_date: str,\n   285→    total_discovered: int,\n   286→    total_scored: int,\n   287→    top_picks_count: int,\n   288→    hot_picks_count: int,\n   289→) -> int:\n   290→    \"\"\"Publish a digest completion event.\"\"\"\n   291→    event = DigestReadyEvent(\n   292→        digest_id=str(digest_id),\n   293→        candidate_id=str(candidate_id),\n   294→        run_date=run_date,\n   295→        total_discovered=total_discovered,\n   296→        total_scored=total_scored,\n   297→        top_picks_count=top_picks_count,\n   298→        hot_picks_count=hot_picks_count,\n   299→    )\n   300→    return await publish_event(redis_client, PubSubChannel.DISCOVERY, event)\n   301→\n   302→\n   303→async def publish_crawl_status(\n   304→    redis_client: aioredis.Redis,\n   305→    crawl_run_id: UUID,\n   306→    candidate_id: UUID,\n   307→    status: str,\n   308→    jobs_discovered: Optional[int] = None,\n   309→    jobs_scored: Optional[int] = None,\n   310→    error: Optional[str] = None,\n   311→) -> int:\n   312→    \"\"\"Publish a crawl run status update.\"\"\"\n   313→    event = CrawlStatusEvent(\n   314→        crawl_run_id=str(crawl_run_id),\n   315→        candidate_id=str(candidate_id),\n   316→        status=status,\n   317→        jobs_discovered=jobs_discovered,\n   318→        jobs_scored=jobs_scored,\n   319→        error=error,\n   320→    )\n   321→    return await publish_event(redis_client, PubSubChannel.DISCOVERY, event)\n   322→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"ef3e1c9a-082e-4b26-be4b-f026a2179071","uuid":"ec1bd24a-d235-4489-8ac8-9a9ffb6c17dc","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/observability/events.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nRedis pub/sub event taxonomy and CRM event types.\n\nChannel taxonomy from HYPHA-OBSERVABILITY.md:\n  - agent.status.discovery    — Discovery Engine events (crawl, scoring, digest)\n  - agent.status.application  — Application Engine events (pipeline status)\n  - agent.status.subagent     — Sub-agent execution events (tool_use loop)\n\nEvent payload rules:\n  - Every payload is JSON with an `event` field (SCREAMING_SNAKE_CASE)\n  - Payloads include pipeline_id, candidate_id, timestamps\n  - No PII in event payloads — use IDs for reference\n\nCRM event types from crm.py docstring + HYPHA-OBSERVABILITY.md:\n  - APPLICATION_STARTED\n  - JD_PARSED\n  - RESUME_TAILORED\n  - COMPANY_RESEARCHED\n  - CONTACT_FOUND\n  - EMAIL_DRAFTED\n  - APPROVED_FOR_SUBMISSION\n  - SUBMITTED\n  - EMAIL_SENT\n  - EMAIL_OPENED\n  - RESPONDED\n  - INTERVIEW_SCHEDULED\n  - OFFER_RECEIVED\n  - REJECTED\n  - PLACED\n  - PIPELINE_FAILED\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nfrom datetime import datetime, timezone\nfrom enum import Enum\nfrom typing import Any, Optional\nfrom uuid import UUID\n\nimport redis.asyncio as aioredis\nfrom pydantic import BaseModel, Field\n\nimport structlog\n\nlogger = structlog.get_logger(__name__)\n\n\n# ─── Pub/Sub Channels ────────────────────────────────────────────────────────\n\n\nclass PubSubChannel(str, Enum):\n    \"\"\"\n    Canonical Redis pub/sub channels.\n\n    These are the ONLY allowed channels for agent status events.\n    Any new channel must be added here and documented in HYPHA-OBSERVABILITY.md.\n    \"\"\"\n\n    # Discovery Engine events\n    DISCOVERY = \"agent.status.discovery\"\n\n    # Application Engine events (pipeline level)\n    APPLICATION = \"agent.status.application\"\n\n    # Sub-agent execution events (Claude tool_use loop)\n    SUBAGENT = \"agent.status.subagent\"\n\n\n# ─── CRM Event Types ─────────────────────────────────────────────────────────\n\n\nclass CRMEventType(str, Enum):\n    \"\"\"\n    Canonical CRM event types for the application pipeline.\n\n    These events form the auditable timeline for each application.\n    New event types must be added here — no ad-hoc strings in code.\n    \"\"\"\n\n    # Pipeline lifecycle\n    APPLICATION_STARTED = \"APPLICATION_STARTED\"\n    PIPELINE_FAILED = \"PIPELINE_FAILED\"\n\n    # Processing stages\n    JD_PARSED = \"JD_PARSED\"\n    RESUME_TAILORED = \"RESUME_TAILORED\"\n    COMPANY_RESEARCHED = \"COMPANY_RESEARCHED\"\n    CONTACT_FOUND = \"CONTACT_FOUND\"\n    EMAIL_DRAFTED = \"EMAIL_DRAFTED\"\n\n    # Review + submission\n    APPROVED_FOR_SUBMISSION = \"APPROVED_FOR_SUBMISSION\"\n    REJECTED = \"REJECTED\"\n    SUBMITTED = \"SUBMITTED\"\n    EMAIL_SENT = \"EMAIL_SENT\"\n\n    # Tracking (post-submission)\n    EMAIL_OPENED = \"EMAIL_OPENED\"\n    RESPONDED = \"RESPONDED\"\n    INTERVIEW_SCHEDULED = \"INTERVIEW_SCHEDULED\"\n    OFFER_RECEIVED = \"OFFER_RECEIVED\"\n    PLACED = \"PLACED\"\n\n\n# ─── Event Payload Schemas ───────────────────────────────────────────────────\n\n\nclass BaseEvent(BaseModel):\n    \"\"\"Base schema for all pub/sub events.\"\"\"\n\n    event: str = Field(..., description=\"Event type in SCREAMING_SNAKE_CASE\")\n    timestamp: str = Field(\n        default_factory=lambda: datetime.now(timezone.utc).isoformat(),\n        description=\"ISO 8601 timestamp\",\n    )\n\n    class Config:\n        extra = \"allow\"\n\n\nclass AgentStatusEvent(BaseEvent):\n    \"\"\"\n    Application pipeline status event.\n\n    Published to: agent.status.application\n    \"\"\"\n\n    event: str = \"APPLICATION_STATUS\"\n    pipeline_id: str\n    candidate_id: str\n    status: str\n\n\nclass PipelineStatusEvent(BaseEvent):\n    \"\"\"\n    Pipeline-level status event (used by PipelineDispatcher).\n\n    Published to: agent.status.application\n    \"\"\"\n\n    event: str = \"PIPELINE_STATUS\"\n    pipeline_id: str\n    status: str\n    details: dict[str, Any] = Field(default_factory=dict)\n\n\nclass SubAgentStatusEvent(BaseEvent):\n    \"\"\"\n    Sub-agent execution status event.\n\n    Published to: agent.status.subagent\n    \"\"\"\n\n    event: str = \"SUBAGENT_STATUS\"\n    execution_id: str\n    agent_name: str\n    pipeline_id: str\n    status: str\n    attempt: int = 1\n    duration_ms: Optional[int] = None\n\n\nclass DigestReadyEvent(BaseEvent):\n    \"\"\"\n    Discovery digest completion event.\n\n    Published to: agent.status.discovery\n    \"\"\"\n\n    event: str = \"DIGEST_READY\"\n    digest_id: str\n    candidate_id: str\n    run_date: str\n    total_discovered: int\n    total_scored: int\n    top_picks_count: int\n    hot_picks_count: int\n\n\nclass CrawlStatusEvent(BaseEvent):\n    \"\"\"\n    Crawl run status event.\n\n    Published to: agent.status.discovery\n    \"\"\"\n\n    event: str = \"CRAWL_STATUS\"\n    crawl_run_id: str\n    candidate_id: str\n    status: str  # QUEUED, RUNNING, COMPLETED, FAILED\n    jobs_discovered: Optional[int] = None\n    jobs_scored: Optional[int] = None\n    error: Optional[str] = None\n\n\n# ─── Event Publisher ─────────────────────────────────────────────────────────\n\n\nasync def publish_event(\n    redis_client: aioredis.Redis,\n    channel: PubSubChannel | str,\n    event: BaseEvent | dict[str, Any],\n) -> int:\n    \"\"\"\n    Publish an event to a Redis pub/sub channel.\n\n    Args:\n        redis_client: Async Redis client\n        channel: Target pub/sub channel (use PubSubChannel enum)\n        event: Event payload (Pydantic model or dict)\n\n    Returns:\n        Number of subscribers that received the message\n    \"\"\"\n    # Normalize channel to string\n    channel_str = channel.value if isinstance(channel, PubSubChannel) else channel\n\n    # Serialize event\n    if isinstance(event, BaseModel):\n        payload = event.model_dump_json()\n    else:\n        payload = json.dumps(event, default=str)\n\n    # Publish\n    subscriber_count = await redis_client.publish(channel_str, payload)\n\n    logger.debug(\n        \"pubsub.event_published\",\n        channel=channel_str,\n        event_type=event.event if isinstance(event, BaseEvent) else event.get(\"event\"),\n        subscribers=subscriber_count,\n    )\n\n    return subscriber_count\n\n\n# ─── Convenience Publishers ──────────────────────────────────────────────────\n\n\nasync def publish_application_status(\n    redis_client: aioredis.Redis,\n    pipeline_id: UUID,\n    candidate_id: UUID,\n    status: str,\n) -> int:\n    \"\"\"Publish an application pipeline status update.\"\"\"\n    event = AgentStatusEvent(\n        pipeline_id=str(pipeline_id),\n        candidate_id=str(candidate_id),\n        status=status,\n    )\n    return await publish_event(redis_client, PubSubChannel.APPLICATION, event)\n\n\nasync def publish_subagent_status(\n    redis_client: aioredis.Redis,\n    execution_id: UUID,\n    agent_name: str,\n    pipeline_id: UUID,\n    status: str,\n    attempt: int = 1,\n    duration_ms: Optional[int] = None,\n) -> int:\n    \"\"\"Publish a sub-agent execution status update.\"\"\"\n    event = SubAgentStatusEvent(\n        execution_id=str(execution_id),\n        agent_name=agent_name,\n        pipeline_id=str(pipeline_id),\n        status=status,\n        attempt=attempt,\n        duration_ms=duration_ms,\n    )\n    return await publish_event(redis_client, PubSubChannel.SUBAGENT, event)\n\n\nasync def publish_digest_ready(\n    redis_client: aioredis.Redis,\n    digest_id: UUID,\n    candidate_id: UUID,\n    run_date: str,\n    total_discovered: int,\n    total_scored: int,\n    top_picks_count: int,\n    hot_picks_count: int,\n) -> int:\n    \"\"\"Publish a digest completion event.\"\"\"\n    event = DigestReadyEvent(\n        digest_id=str(digest_id),\n        candidate_id=str(candidate_id),\n        run_date=run_date,\n        total_discovered=total_discovered,\n        total_scored=total_scored,\n        top_picks_count=top_picks_count,\n        hot_picks_count=hot_picks_count,\n    )\n    return await publish_event(redis_client, PubSubChannel.DISCOVERY, event)\n\n\nasync def publish_crawl_status(\n    redis_client: aioredis.Redis,\n    crawl_run_id: UUID,\n    candidate_id: UUID,\n    status: str,\n    jobs_discovered: Optional[int] = None,\n    jobs_scored: Optional[int] = None,\n    error: Optional[str] = None,\n) -> int:\n    \"\"\"Publish a crawl run status update.\"\"\"\n    event = CrawlStatusEvent(\n        crawl_run_id=str(crawl_run_id),\n        candidate_id=str(candidate_id),\n        status=status,\n        jobs_discovered=jobs_discovered,\n        jobs_scored=jobs_scored,\n        error=error,\n    )\n    return await publish_event(redis_client, PubSubChannel.DISCOVERY, event)\n","numLines":322,"startLine":1,"totalLines":322}}}}
