{"t":"2026-05-28T03:02:20.039Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AJmQ5HhUN5kCfcaRVHtQDG","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→SSE Event Stream endpoint tests.\n     6→\n     7→Tests for GET /events/stream — Server-Sent Events for real-time agent status.\n     8→\n     9→Contract:\n    10→  - HYPHA-TESTS.md § tests-agent.api.events\n    11→  - HYPHA-API-STREAMING.md acceptance criteria\n    12→  - NUTRIENTS.md § API_CONTRACTS (iter-4 additions)\n    13→\n    14→Coverage:\n    15→  - TestClient streaming response\n    16→  - SSE frame format (data: {json}\\\\n\\\\n)\n    17→  - Heartbeat (:ping\\\\n\\\\n within 16s)\n    18→  - 401 on missing/invalid auth\n    19→  - Channel allowlist validation (400 on invalid channel)\n    20→  - Message delivery from Redis pub/sub\n    21→\"\"\"\n    22→\n    23→from __future__ import annotations\n    24→\n    25→import asyncio\n    26→import json\n    27→import uuid\n    28→from datetime import datetime, timedelta, timezone\n    29→from typing import AsyncGenerator, Generator\n    30→from unittest.mock import AsyncMock, patch\n    31→\n    32→import fakeredis.aioredis\n    33→import jwt\n    34→import pytest\n    35→import pytest_asyncio\n    36→from fastapi import FastAPI\n    37→from fastapi.testclient import TestClient\n    38→from httpx import ASGITransport, AsyncClient\n    39→from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker, create_async_engine\n    40→from sqlalchemy.pool import StaticPool\n    41→\n    42→from backend.api.events import (\n    43→    ALLOWED_CHANNELS,\n    44→    HEARTBEAT_INTERVAL_SECONDS,\n    45→    MAX_QUEUE_SIZE,\n    46→    SSESubscriber,\n    47→    router as events_router,\n    48→)\n    49→from backend.config import settings\n    50→from backend.database import Base, get_db, get_redis, set_redis_client\n    51→from backend.models.auth import User\n    52→from backend.observability.events import PubSubChannel\n    53→\n    54→\n    55→# ─── Test Database Setup ─────────────────────────────────────────────────────\n    56→\n    57→# Use SQLite for testing (async via aiosqlite)\n    58→TEST_DATABASE_URL = \"sqlite+aiosqlite:///:memory:\"\n    59→\n    60→test_engine = create_async_engine(\n    61→    TEST_DATABASE_URL,\n    62→    connect_args={\"check_same_thread\": False},\n    63→    poolclass=StaticPool,\n    64→)\n    65→\n    66→TestAsyncSessionLocal = async_sessionmaker(\n    67→    test_engine,\n    68→    class_=AsyncSession,\n    69→    expire_on_commit=False,\n    70→)\n    71→\n    72→\n    73→async def override_get_db() -> AsyncGenerator[AsyncSession, None]:\n    74→    \"\"\"Override get_db dependency for tests.\"\"\"\n    75→    async with TestAsyncSessionLocal() as session:\n    76→        yield session\n    77→\n    78→\n    79→# ─── Fixtures ────────────────────────────────────────────────────────────────\n    80→\n    81→\n    82→@pytest_asyncio.fixture\n    83→async def test_db():\n    84→    \"\"\"Create test database tables and yield a session.\"\"\"\n    85→    async with test_engine.begin() as conn:\n    86→        await conn.run_sync(Base.metadata.create_all)\n    87→\n    88→    async with TestAsyncSessionLocal() as session:\n    89→        yield session\n    90→\n    91→    async with test_engine.begin() as conn:\n    92→        await conn.run_sync(Base.metadata.drop_all)\n    93→\n    94→\n    95→@pytest.fixture\n    96→def fake_redis():\n    97→    \"\"\"Create a fake Redis client for testing.\"\"\"\n    98→    return fakeredis.aioredis.FakeRedis(decode_responses=True)\n    99→\n   100→\n   101→@pytest_asyncio.fixture\n   102→async def test_user(test_db: AsyncSession) -> User:\n   103→    \"\"\"Create a test user and return it.\"\"\"\n   104→    user = User(\n   105→        id=uuid.uuid4(),\n   106→        email=\"test@example.com\",\n   107→        name=\"Test User\",\n   108→        is_active=True,\n   109→        is_onboarded=True,\n   110→    )\n   111→    test_db.add(user)\n   112→    await test_db.commit()\n   113→    await test_db.refresh(user)\n   114→    return user\n   115→\n   116→\n   117→@pytest.fixture\n   118→def valid_jwt(test_user: User) -> str:\n   119→    \"\"\"Generate a valid JWT for the test user.\"\"\"\n   120→    payload = {\n   121→        \"sub\": str(test_user.id),\n   122→        \"email\": test_user.email,\n   123→        \"iat\": datetime.now(timezone.utc),\n   124→        \"exp\": datetime.now(timezone.utc) + timedelta(days=1),\n   125→    }\n   126→    return jwt.encode(payload, settings.jwt_secret, algorithm=\"HS256\")\n   127→\n   128→\n   129→@pytest.fixture\n   130→def expired_jwt(test_user: User) -> str:\n   131→    \"\"\"Generate an expired JWT for testing.\"\"\"\n   132→    payload = {\n   133→        \"sub\": str(test_user.id),\n   134→        \"email\": test_user.email,\n   135→        \"iat\": datetime.now(timezone.utc) - timedelta(days=10),\n   136→        \"exp\": datetime.now(timezone.utc) - timedelta(days=1),\n   137→    }\n   138→    return jwt.encode(payload, settings.jwt_secret, algorithm=\"HS256\")\n   139→\n   140→\n   141→@pytest.fixture\n   142→def app_with_overrides(test_db: AsyncSession, fake_redis) -> FastAPI:\n   143→    \"\"\"Create a FastAPI app with test dependency overrides.\"\"\"\n   144→    from backend.main import app\n   145→\n   146→    # Override dependencies\n   147→    app.dependency_overrides[get_db] = lambda: test_db\n   148→    app.dependency_overrides[get_redis] = lambda: fake_redis\n   149→\n   150→    # Set the fake Redis as the global client\n   151→    set_redis_client(fake_redis)\n   152→\n   153→    yield app\n   154→\n   155→    # Clean up overrides\n   156→    app.dependency_overrides.clear()\n   157→\n   158→\n   159→@pytest.fixture\n   160→def test_client(app_with_overrides: FastAPI) -> Generator[TestClient, None, None]:\n   161→    \"\"\"Create a TestClient for the app.\"\"\"\n   162→    with TestClient(app_with_overrides) as client:\n   163→        yield client\n   164→\n   165→\n   166→# ─── SSESubscriber Unit Tests ────────────────────────────────────────────────\n   167→\n   168→\n   169→class TestSSESubscriberValidation:\n   170→    \"\"\"Test SSESubscriber channel validation.\"\"\"\n   171→\n   172→    def test_valid_discovery_channel(self, fake_redis):\n   173→        \"\"\"Valid discovery channel should not raise.\"\"\"\n   174→        subscriber = SSESubscriber(\n   175→            redis_client=fake_redis,\n   176→            channel=PubSubChannel.DISCOVERY.value,\n   177→            user_id=\"test-user-123\",\n   178→        )\n   179→        assert subscriber.channel == \"agent.status.discovery\"\n   180→\n   181→    def test_valid_application_channel(self, fake_redis):\n   182→        \"\"\"Valid application channel should not raise.\"\"\"\n   183→        subscriber = SSESubscriber(\n   184→            redis_client=fake_redis,\n   185→            channel=PubSubChannel.APPLICATION.value,\n   186→            user_id=\"test-user-123\",\n   187→        )\n   188→        assert subscriber.channel == \"agent.status.application\"\n   189→\n   190→    def test_invalid_channel_raises_value_error(self, fake_redis):\n   191→        \"\"\"Invalid channel should raise ValueError.\"\"\"\n   192→        with pytest.raises(ValueError, match=\"Invalid channel\"):\n   193→            SSESubscriber(\n   194→                redis_client=fake_redis,\n   195→                channel=\"invalid.channel\",\n   196→                user_id=\"test-user-123\",\n   197→            )\n   198→\n   199→    def test_invalid_channel_error_lists_allowed(self, fake_redis):\n   200→        \"\"\"Error message should list allowed channels.\"\"\"\n   201→        with pytest.raises(ValueError) as exc_info:\n   202→            SSESubscriber(\n   203→                redis_client=fake_redis,\n   204→                channel=\"bad.channel\",\n   205→                user_id=\"test-user-123\",\n   206→            )\n   207→        error_message = str(exc_info.value)\n   208→        assert \"agent.status.application\" in error_message\n   209→        assert \"agent.status.discovery\" in error_message\n   210→\n   211→\n   212→# ─── Endpoint Integration Tests ──────────────────────────────────────────────\n   213→\n   214→\n   215→class TestEventStreamAuth:\n   216→    \"\"\"Test authentication requirements for /events/stream.\"\"\"\n   217→\n   218→    def test_missing_auth_returns_401(self, test_client: TestClient):\n   219→        \"\"\"Request without Authorization header should return 401.\"\"\"\n   220→        response = test_client.get(\n   221→            \"/events/stream\",\n   222→            params={\"channel\": \"agent.status.discovery\"},\n   223→        )\n   224→        assert response.status_code == 401\n   225→        assert \"Not authenticated\" in response.json().get(\"detail\", \"\")\n   226→\n   227→    def test_invalid_token_returns_401(self, test_client: TestClient):\n   228→        \"\"\"Request with invalid JWT should return 401.\"\"\"\n   229→        response = test_client.get(\n   230→            \"/events/stream\",\n   231→            params={\"channel\": \"agent.status.discovery\"},\n   232→            headers={\"Authorization\": \"Bearer invalid-token-xyz\"},\n   233→        )\n   234→        assert response.status_code == 401\n   235→\n   236→    def test_expired_token_returns_401(\n   237→        self, test_client: TestClient, expired_jwt: str\n   238→    ):\n   239→        \"\"\"Request with expired JWT should return 401.\"\"\"\n   240→        response = test_client.get(\n   241→            \"/events/stream\",\n   242→            params={\"channel\": \"agent.status.discovery\"},\n   243→            headers={\"Authorization\": f\"Bearer {expired_jwt}\"},\n   244→        )\n   245→        assert response.status_code == 401\n   246→        assert \"expired\" in response.json().get(\"detail\", \"\").lower()\n   247→\n   248→\n   249→class TestEventStreamChannelValidation:\n   250→    \"\"\"Test channel allowlist validation.\"\"\"\n   251→\n   252→    def test_invalid_channel_returns_400(\n   253→        self, test_client: TestClient, valid_jwt: str\n   254→    ):\n   255→        \"\"\"Request with invalid channel should return 400.\"\"\"\n   256→        response = test_client.get(\n   257→            \"/events/stream\",\n   258→            params={\"channel\": \"invalid.channel\"},\n   259→            headers={\"Authorization\": f\"Bearer {valid_jwt}\"},\n   260→        )\n   261→        assert response.status_code == 400\n   262→        detail = response.json().get(\"detail\", \"\")\n   263→        assert \"Invalid channel\" in detail\n   264→        assert \"agent.status.discovery\" in detail\n   265→        assert \"agent.status.application\" in detail\n   266→\n   267→    def test_missing_channel_param_returns_422(\n   268→        self, test_client: TestClient, valid_jwt: str\n   269→    ):\n   270→        \"\"\"Request without channel parameter should return 422 (validation error).\"\"\"\n   271→        response = test_client.get(\n   272→            \"/events/stream\",\n   273→            headers={\"Authorization\": f\"Bearer {valid_jwt}\"},\n   274→        )\n   275→        assert response.status_code == 422\n   276→\n   277→\n   278→class TestEventStreamSSEFormat:\n   279→    \"\"\"Test SSE frame format and streaming behavior.\"\"\"\n   280→\n   281→    @pytest.mark.asyncio\n   282→    async def test_stream_returns_event_stream_content_type(\n   283→        self, app_with_overrides: FastAPI, valid_jwt: str, fake_redis\n   284→    ):\n   285→        \"\"\"\n   286→        Response should have Content-Type: text/event-stream.\n   287→\n   288→        This test verifies the SSE endpoint returns the correct media type\n   289→        for Server-Sent Events streaming.\n   290→        \"\"\"\n   291→        async with AsyncClient(\n   292→            transport=ASGITransport(app=app_with_overrides),\n   293→            base_url=\"http://test\",\n   294→        ) as client:\n   295→            # Use a short timeout since we just need headers\n   296→            async def fetch_headers():\n   297→                async with client.stream(\n   298→                    \"GET\",\n   299→                    \"/events/stream\",\n   300→                    params={\"channel\": \"agent.status.discovery\"},\n   301→                    headers={\"Authorization\": f\"Bearer {valid_jwt}\"},\n   302→                ) as response:\n   303→                    return response.headers\n   304→\n   305→            try:\n   306→                headers = await asyncio.wait_for(fetch_headers(), timeout=2.0)\n   307→                assert headers.get(\"content-type\") == \"text/event-stream; charset=utf-8\"\n   308→                assert headers.get(\"cache-control\") == \"no-cache\"\n   309→            except asyncio.TimeoutError:\n   310→                # Stream didn't return headers in time — check we got the connection\n   311→                pass\n   312→\n   313→    @pytest.mark.asyncio\n   314→    async def test_published_message_appears_as_sse_frame(\n   315→        self, app_with_overrides: FastAPI, valid_jwt: str, fake_redis\n   316→    ):\n   317→        \"\"\"\n   318→        Messages published to Redis should appear as SSE data frames.\n   319→\n   320→        SSE frame format: data: {json}\\\\n\\\\n\n   321→        \"\"\"\n   322→        received_frames: list[str] = []\n   323→        test_event = {\n   324→            \"event\": \"TEST_EVENT\",\n   325→            \"candidate_id\": \"test-candidate-123\",\n   326→            \"ts\": datetime.now(timezone.utc).isoformat(),\n   327→        }\n   328→\n   329→        async def stream_reader():\n   330→            \"\"\"Read SSE frames from the stream.\"\"\"\n   331→            async with AsyncClient(\n   332→                transport=ASGITransport(app=app_with_overrides),\n   333→                base_url=\"http://test\",\n   334→            ) as client:\n   335→                async with client.stream(\n   336→                    \"GET\",\n   337→                    \"/events/stream\",\n   338→                    params={\"channel\": \"agent.status.discovery\"},\n   339→                    headers={\"Authorization\": f\"Bearer {valid_jwt}\"},\n   340→                ) as response:\n   341→                    # Collect frames until we get our test event or timeout\n   342→                    async for line in response.aiter_lines():\n   343→                        received_frames.append(line)\n   344→                        if \"TEST_EVENT\" in line:\n   345→                            return\n   346→\n   347→        async def publish_after_delay():\n   348→            \"\"\"Publish test event after a brief delay for stream to connect.\"\"\"\n   349→            await asyncio.sleep(0.3)\n   350→            await fake_redis.publish(\n   351→                PubSubChannel.DISCOVERY.value,\n   352→                json.dumps(test_event),\n   353→            )\n   354→\n   355→        # Run stream reader and publisher concurrently with timeout\n   356→        try:\n   357→            await asyncio.wait_for(\n   358→                asyncio.gather(stream_reader(), publish_after_delay()),\n   359→                timeout=5.0,\n   360→            )\n   361→        except asyncio.TimeoutError:\n   362→            pass  # Timeout is expected after receiving the event\n   363→\n   364→        # Verify we received the event as an SSE data frame\n   365→        data_frames = [f for f in received_frames if f.startswith(\"data:\")]\n   366→        assert len(data_frames) > 0, f\"No data frames received. Got: {received_frames}\"\n   367→\n   368→        # Find our test event\n   369→        test_event_found = any(\"TEST_EVENT\" in frame for frame in data_frames)\n   370→        assert test_event_found, f\"Test event not found in frames: {data_frames}\"\n   371→\n   372→\n   373→class TestEventStreamHeartbeat:\n   374→    \"\"\"Test heartbeat (:ping) behavior.\"\"\"\n   375→\n   376→    @pytest.mark.asyncio\n   377→    async def test_heartbeat_within_interval(\n   378→        self, app_with_overrides: FastAPI, valid_jwt: str, fake_redis\n   379→    ):\n   380→        \"\"\"\n   381→        Heartbeat (:ping) should be sent within HEARTBEAT_INTERVAL_SECONDS.\n   382→\n   383→        HYPHA-TESTS.md requires heartbeat within 16s.\n   384→        HYPHA-API-STREAMING.md specifies 15s heartbeat interval.\n   385→        \"\"\"\n   386→        received_frames: list[str] = []\n   387→        ping_received = asyncio.Event()\n   388→\n   389→        async def stream_reader():\n   390→            \"\"\"Read SSE frames and signal when ping received.\"\"\"\n   391→            async with AsyncClient(\n   392→                transport=ASGITransport(app=app_with_overrides),\n   393→                base_url=\"http://test\",\n   394→            ) as client:\n   395→                async with client.stream(\n   396→                    \"GET\",\n   397→                    \"/events/stream\",\n   398→                    params={\"channel\": \"agent.status.discovery\"},\n   399→                    headers={\"Authorization\": f\"Bearer {valid_jwt}\"},\n   400→                ) as response:\n   401→                    async for line in response.aiter_lines():\n   402→                        received_frames.append(line)\n   403→                        if line == \":ping\":\n   404→                            ping_received.set()\n   405→                            return\n   406→\n   407→        try:\n   408→            # Wait for heartbeat with margin above 15s interval\n   409→            await asyncio.wait_for(stream_reader(), timeout=16.0)\n   410→        except asyncio.TimeoutError:\n   411→            pytest.fail(\n   412→                f\"No heartbeat received within 16s. Frames: {received_frames}\"\n   413→            )\n   414→\n   415→        assert ping_received.is_set(), \"Heartbeat ping not received\"\n   416→\n   417→\n   418→class TestAllowedChannels:\n   419→    \"\"\"Test that ALLOWED_CHANNELS matches the contract.\"\"\"\n   420→\n   421→    def test_allowed_channels_matches_contract(self):\n   422→        \"\"\"\n   423→        ALLOWED_CHANNELS should match NUTRIENTS.md contract.\n   424→\n   425→        Contract: agent.status.discovery, agent.status.application\n   426→        \"\"\"\n   427→        assert \"agent.status.discovery\" in ALLOWED_CHANNELS\n   428→        assert \"agent.status.application\" in ALLOWED_CHANNELS\n   429→        assert len(ALLOWED_CHANNELS) == 2\n   430→\n   431→\n   432→class TestConstants:\n   433→    \"\"\"Test that constants match the contract.\"\"\"\n   434→\n   435→    def test_heartbeat_interval_is_15_seconds(self):\n   436→        \"\"\"Heartbeat interval should be 15 seconds per HYPHA-API-STREAMING.md.\"\"\"\n   437→        assert HEARTBEAT_INTERVAL_SECONDS == 15.0\n   438→\n   439→    def test_max_queue_size_is_100(self):\n   440→        \"\"\"Max queue size should be 100 per HYPHA-API-STREAMING.md.\"\"\"\n   441→        assert MAX_QUEUE_SIZE == 100\n   442→\n   443→\n   444→# ─── Backpressure Tests ──────────────────────────────────────────────────────\n   445→\n   446→\n   447→class TestBackpressure:\n   448→    \"\"\"Test backpressure handling for slow clients.\"\"\"\n   449→\n   450→    @pytest.mark.asyncio\n   451→    async def test_subscriber_drops_messages_when_queue_full(self, fake_redis):\n   452→        \"\"\"\n   453→        When message queue exceeds MAX_QUEUE_SIZE, oldest messages should be dropped.\n   454→\n   455→        Contract: HYPHA-API-STREAMING.md — drop >100 messages behind, emit slow_client event\n   456→        \"\"\"\n   457→        subscriber = SSESubscriber(\n   458→            redis_client=fake_redis,\n   459→            channel=PubSubChannel.DISCOVERY.value,\n   460→            user_id=\"test-user-123\",\n   461→        )\n   462→\n   463→        # Manually fill the queue beyond capacity\n   464→        for i in range(MAX_QUEUE_SIZE + 10):\n   465→            await subscriber._message_queue.put(f\"message-{i}\")\n   466→\n   467→        # Queue should be at max capacity, not over\n   468→        # (backpressure logic runs in _reader, not on put)\n   469→        assert subscriber._message_queue.qsize() == MAX_QUEUE_SIZE + 10\n   470→\n   471→        # Cleanup\n   472→        await subscriber._cleanup()\n   473→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"ef3e1c9a-082e-4b26-be4b-f026a2179071","uuid":"81ac2d0f-73d8-448d-83da-e5af02aedfc1","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/tests/api/test_events_stream.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nSSE Event Stream endpoint tests.\n\nTests for GET /events/stream — Server-Sent Events for real-time agent status.\n\nContract:\n  - HYPHA-TESTS.md § tests-agent.api.events\n  - HYPHA-API-STREAMING.md acceptance criteria\n  - NUTRIENTS.md § API_CONTRACTS (iter-4 additions)\n\nCoverage:\n  - TestClient streaming response\n  - SSE frame format (data: {json}\\\\n\\\\n)\n  - Heartbeat (:ping\\\\n\\\\n within 16s)\n  - 401 on missing/invalid auth\n  - Channel allowlist validation (400 on invalid channel)\n  - Message delivery from Redis pub/sub\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport json\nimport uuid\nfrom datetime import datetime, timedelta, timezone\nfrom typing import AsyncGenerator, Generator\nfrom unittest.mock import AsyncMock, patch\n\nimport fakeredis.aioredis\nimport jwt\nimport pytest\nimport pytest_asyncio\nfrom fastapi import FastAPI\nfrom fastapi.testclient import TestClient\nfrom httpx import ASGITransport, AsyncClient\nfrom sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker, create_async_engine\nfrom sqlalchemy.pool import StaticPool\n\nfrom backend.api.events import (\n    ALLOWED_CHANNELS,\n    HEARTBEAT_INTERVAL_SECONDS,\n    MAX_QUEUE_SIZE,\n    SSESubscriber,\n    router as events_router,\n)\nfrom backend.config import settings\nfrom backend.database import Base, get_db, get_redis, set_redis_client\nfrom backend.models.auth import User\nfrom backend.observability.events import PubSubChannel\n\n\n# ─── Test Database Setup ─────────────────────────────────────────────────────\n\n# Use SQLite for testing (async via aiosqlite)\nTEST_DATABASE_URL = \"sqlite+aiosqlite:///:memory:\"\n\ntest_engine = create_async_engine(\n    TEST_DATABASE_URL,\n    connect_args={\"check_same_thread\": False},\n    poolclass=StaticPool,\n)\n\nTestAsyncSessionLocal = async_sessionmaker(\n    test_engine,\n    class_=AsyncSession,\n    expire_on_commit=False,\n)\n\n\nasync def override_get_db() -> AsyncGenerator[AsyncSession, None]:\n    \"\"\"Override get_db dependency for tests.\"\"\"\n    async with TestAsyncSessionLocal() as session:\n        yield session\n\n\n# ─── Fixtures ────────────────────────────────────────────────────────────────\n\n\n@pytest_asyncio.fixture\nasync def test_db():\n    \"\"\"Create test database tables and yield a session.\"\"\"\n    async with test_engine.begin() as conn:\n        await conn.run_sync(Base.metadata.create_all)\n\n    async with TestAsyncSessionLocal() as session:\n        yield session\n\n    async with test_engine.begin() as conn:\n        await conn.run_sync(Base.metadata.drop_all)\n\n\n@pytest.fixture\ndef fake_redis():\n    \"\"\"Create a fake Redis client for testing.\"\"\"\n    return fakeredis.aioredis.FakeRedis(decode_responses=True)\n\n\n@pytest_asyncio.fixture\nasync def test_user(test_db: AsyncSession) -> User:\n    \"\"\"Create a test user and return it.\"\"\"\n    user = User(\n        id=uuid.uuid4(),\n        email=\"test@example.com\",\n        name=\"Test User\",\n        is_active=True,\n        is_onboarded=True,\n    )\n    test_db.add(user)\n    await test_db.commit()\n    await test_db.refresh(user)\n    return user\n\n\n@pytest.fixture\ndef valid_jwt(test_user: User) -> str:\n    \"\"\"Generate a valid JWT for the test user.\"\"\"\n    payload = {\n        \"sub\": str(test_user.id),\n        \"email\": test_user.email,\n        \"iat\": datetime.now(timezone.utc),\n        \"exp\": datetime.now(timezone.utc) + timedelta(days=1),\n    }\n    return jwt.encode(payload, settings.jwt_secret, algorithm=\"HS256\")\n\n\n@pytest.fixture\ndef expired_jwt(test_user: User) -> str:\n    \"\"\"Generate an expired JWT for testing.\"\"\"\n    payload = {\n        \"sub\": str(test_user.id),\n        \"email\": test_user.email,\n        \"iat\": datetime.now(timezone.utc) - timedelta(days=10),\n        \"exp\": datetime.now(timezone.utc) - timedelta(days=1),\n    }\n    return jwt.encode(payload, settings.jwt_secret, algorithm=\"HS256\")\n\n\n@pytest.fixture\ndef app_with_overrides(test_db: AsyncSession, fake_redis) -> FastAPI:\n    \"\"\"Create a FastAPI app with test dependency overrides.\"\"\"\n    from backend.main import app\n\n    # Override dependencies\n    app.dependency_overrides[get_db] = lambda: test_db\n    app.dependency_overrides[get_redis] = lambda: fake_redis\n\n    # Set the fake Redis as the global client\n    set_redis_client(fake_redis)\n\n    yield app\n\n    # Clean up overrides\n    app.dependency_overrides.clear()\n\n\n@pytest.fixture\ndef test_client(app_with_overrides: FastAPI) -> Generator[TestClient, None, None]:\n    \"\"\"Create a TestClient for the app.\"\"\"\n    with TestClient(app_with_overrides) as client:\n        yield client\n\n\n# ─── SSESubscriber Unit Tests ────────────────────────────────────────────────\n\n\nclass TestSSESubscriberValidation:\n    \"\"\"Test SSESubscriber channel validation.\"\"\"\n\n    def test_valid_discovery_channel(self, fake_redis):\n        \"\"\"Valid discovery channel should not raise.\"\"\"\n        subscriber = SSESubscriber(\n            redis_client=fake_redis,\n            channel=PubSubChannel.DISCOVERY.value,\n            user_id=\"test-user-123\",\n        )\n        assert subscriber.channel == \"agent.status.discovery\"\n\n    def test_valid_application_channel(self, fake_redis):\n        \"\"\"Valid application channel should not raise.\"\"\"\n        subscriber = SSESubscriber(\n            redis_client=fake_redis,\n            channel=PubSubChannel.APPLICATION.value,\n            user_id=\"test-user-123\",\n        )\n        assert subscriber.channel == \"agent.status.application\"\n\n    def test_invalid_channel_raises_value_error(self, fake_redis):\n        \"\"\"Invalid channel should raise ValueError.\"\"\"\n        with pytest.raises(ValueError, match=\"Invalid channel\"):\n            SSESubscriber(\n                redis_client=fake_redis,\n                channel=\"invalid.channel\",\n                user_id=\"test-user-123\",\n            )\n\n    def test_invalid_channel_error_lists_allowed(self, fake_redis):\n        \"\"\"Error message should list allowed channels.\"\"\"\n        with pytest.raises(ValueError) as exc_info:\n            SSESubscriber(\n                redis_client=fake_redis,\n                channel=\"bad.channel\",\n                user_id=\"test-user-123\",\n            )\n        error_message = str(exc_info.value)\n        assert \"agent.status.application\" in error_message\n        assert \"agent.status.discovery\" in error_message\n\n\n# ─── Endpoint Integration Tests ──────────────────────────────────────────────\n\n\nclass TestEventStreamAuth:\n    \"\"\"Test authentication requirements for /events/stream.\"\"\"\n\n    def test_missing_auth_returns_401(self, test_client: TestClient):\n        \"\"\"Request without Authorization header should return 401.\"\"\"\n        response = test_client.get(\n            \"/events/stream\",\n            params={\"channel\": \"agent.status.discovery\"},\n        )\n        assert response.status_code == 401\n        assert \"Not authenticated\" in response.json().get(\"detail\", \"\")\n\n    def test_invalid_token_returns_401(self, test_client: TestClient):\n        \"\"\"Request with invalid JWT should return 401.\"\"\"\n        response = test_client.get(\n            \"/events/stream\",\n            params={\"channel\": \"agent.status.discovery\"},\n            headers={\"Authorization\": \"Bearer invalid-token-xyz\"},\n        )\n        assert response.status_code == 401\n\n    def test_expired_token_returns_401(\n        self, test_client: TestClient, expired_jwt: str\n    ):\n        \"\"\"Request with expired JWT should return 401.\"\"\"\n        response = test_client.get(\n            \"/events/stream\",\n            params={\"channel\": \"agent.status.discovery\"},\n            headers={\"Authorization\": f\"Bearer {expired_jwt}\"},\n        )\n        assert response.status_code == 401\n        assert \"expired\" in response.json().get(\"detail\", \"\").lower()\n\n\nclass TestEventStreamChannelValidation:\n    \"\"\"Test channel allowlist validation.\"\"\"\n\n    def test_invalid_channel_returns_400(\n        self, test_client: TestClient, valid_jwt: str\n    ):\n        \"\"\"Request with invalid channel should return 400.\"\"\"\n        response = test_client.get(\n            \"/events/stream\",\n            params={\"channel\": \"invalid.channel\"},\n            headers={\"Authorization\": f\"Bearer {valid_jwt}\"},\n        )\n        assert response.status_code == 400\n        detail = response.json().get(\"detail\", \"\")\n        assert \"Invalid channel\" in detail\n        assert \"agent.status.discovery\" in detail\n        assert \"agent.status.application\" in detail\n\n    def test_missing_channel_param_returns_422(\n        self, test_client: TestClient, valid_jwt: str\n    ):\n        \"\"\"Request without channel parameter should return 422 (validation error).\"\"\"\n        response = test_client.get(\n            \"/events/stream\",\n            headers={\"Authorization\": f\"Bearer {valid_jwt}\"},\n        )\n        assert response.status_code == 422\n\n\nclass TestEventStreamSSEFormat:\n    \"\"\"Test SSE frame format and streaming behavior.\"\"\"\n\n    @pytest.mark.asyncio\n    async def test_stream_returns_event_stream_content_type(\n        self, app_with_overrides: FastAPI, valid_jwt: str, fake_redis\n    ):\n        \"\"\"\n        Response should have Content-Type: text/event-stream.\n\n        This test verifies the SSE endpoint returns the correct media type\n        for Server-Sent Events streaming.\n        \"\"\"\n        async with AsyncClient(\n            transport=ASGITransport(app=app_with_overrides),\n            base_url=\"http://test\",\n        ) as client:\n            # Use a short timeout since we just need headers\n            async def fetch_headers():\n                async with client.stream(\n                    \"GET\",\n                    \"/events/stream\",\n                    params={\"channel\": \"agent.status.discovery\"},\n                    headers={\"Authorization\": f\"Bearer {valid_jwt}\"},\n                ) as response:\n                    return response.headers\n\n            try:\n                headers = await asyncio.wait_for(fetch_headers(), timeout=2.0)\n                assert headers.get(\"content-type\") == \"text/event-stream; charset=utf-8\"\n                assert headers.get(\"cache-control\") == \"no-cache\"\n            except asyncio.TimeoutError:\n                # Stream didn't return headers in time — check we got the connection\n                pass\n\n    @pytest.mark.asyncio\n    async def test_published_message_appears_as_sse_frame(\n        self, app_with_overrides: FastAPI, valid_jwt: str, fake_redis\n    ):\n        \"\"\"\n        Messages published to Redis should appear as SSE data frames.\n\n        SSE frame format: data: {json}\\\\n\\\\n\n        \"\"\"\n        received_frames: list[str] = []\n        test_event = {\n            \"event\": \"TEST_EVENT\",\n            \"candidate_id\": \"test-candidate-123\",\n            \"ts\": datetime.now(timezone.utc).isoformat(),\n        }\n\n        async def stream_reader():\n            \"\"\"Read SSE frames from the stream.\"\"\"\n            async with AsyncClient(\n                transport=ASGITransport(app=app_with_overrides),\n                base_url=\"http://test\",\n            ) as client:\n                async with client.stream(\n                    \"GET\",\n                    \"/events/stream\",\n                    params={\"channel\": \"agent.status.discovery\"},\n                    headers={\"Authorization\": f\"Bearer {valid_jwt}\"},\n                ) as response:\n                    # Collect frames until we get our test event or timeout\n                    async for line in response.aiter_lines():\n                        received_frames.append(line)\n                        if \"TEST_EVENT\" in line:\n                            return\n\n        async def publish_after_delay():\n            \"\"\"Publish test event after a brief delay for stream to connect.\"\"\"\n            await asyncio.sleep(0.3)\n            await fake_redis.publish(\n                PubSubChannel.DISCOVERY.value,\n                json.dumps(test_event),\n            )\n\n        # Run stream reader and publisher concurrently with timeout\n        try:\n            await asyncio.wait_for(\n                asyncio.gather(stream_reader(), publish_after_delay()),\n                timeout=5.0,\n            )\n        except asyncio.TimeoutError:\n            pass  # Timeout is expected after receiving the event\n\n        # Verify we received the event as an SSE data frame\n        data_frames = [f for f in received_frames if f.startswith(\"data:\")]\n        assert len(data_frames) > 0, f\"No data frames received. Got: {received_frames}\"\n\n        # Find our test event\n        test_event_found = any(\"TEST_EVENT\" in frame for frame in data_frames)\n        assert test_event_found, f\"Test event not found in frames: {data_frames}\"\n\n\nclass TestEventStreamHeartbeat:\n    \"\"\"Test heartbeat (:ping) behavior.\"\"\"\n\n    @pytest.mark.asyncio\n    async def test_heartbeat_within_interval(\n        self, app_with_overrides: FastAPI, valid_jwt: str, fake_redis\n    ):\n        \"\"\"\n        Heartbeat (:ping) should be sent within HEARTBEAT_INTERVAL_SECONDS.\n\n        HYPHA-TESTS.md requires heartbeat within 16s.\n        HYPHA-API-STREAMING.md specifies 15s heartbeat interval.\n        \"\"\"\n        received_frames: list[str] = []\n        ping_received = asyncio.Event()\n\n        async def stream_reader():\n            \"\"\"Read SSE frames and signal when ping received.\"\"\"\n            async with AsyncClient(\n                transport=ASGITransport(app=app_with_overrides),\n                base_url=\"http://test\",\n            ) as client:\n                async with client.stream(\n                    \"GET\",\n                    \"/events/stream\",\n                    params={\"channel\": \"agent.status.discovery\"},\n                    headers={\"Authorization\": f\"Bearer {valid_jwt}\"},\n                ) as response:\n                    async for line in response.aiter_lines():\n                        received_frames.append(line)\n                        if line == \":ping\":\n                            ping_received.set()\n                            return\n\n        try:\n            # Wait for heartbeat with margin above 15s interval\n            await asyncio.wait_for(stream_reader(), timeout=16.0)\n        except asyncio.TimeoutError:\n            pytest.fail(\n                f\"No heartbeat received within 16s. Frames: {received_frames}\"\n            )\n\n        assert ping_received.is_set(), \"Heartbeat ping not received\"\n\n\nclass TestAllowedChannels:\n    \"\"\"Test that ALLOWED_CHANNELS matches the contract.\"\"\"\n\n    def test_allowed_channels_matches_contract(self):\n        \"\"\"\n        ALLOWED_CHANNELS should match NUTRIENTS.md contract.\n\n        Contract: agent.status.discovery, agent.status.application\n        \"\"\"\n        assert \"agent.status.discovery\" in ALLOWED_CHANNELS\n        assert \"agent.status.application\" in ALLOWED_CHANNELS\n        assert len(ALLOWED_CHANNELS) == 2\n\n\nclass TestConstants:\n    \"\"\"Test that constants match the contract.\"\"\"\n\n    def test_heartbeat_interval_is_15_seconds(self):\n        \"\"\"Heartbeat interval should be 15 seconds per HYPHA-API-STREAMING.md.\"\"\"\n        assert HEARTBEAT_INTERVAL_SECONDS == 15.0\n\n    def test_max_queue_size_is_100(self):\n        \"\"\"Max queue size should be 100 per HYPHA-API-STREAMING.md.\"\"\"\n        assert MAX_QUEUE_SIZE == 100\n\n\n# ─── Backpressure Tests ──────────────────────────────────────────────────────\n\n\nclass TestBackpressure:\n    \"\"\"Test backpressure handling for slow clients.\"\"\"\n\n    @pytest.mark.asyncio\n    async def test_subscriber_drops_messages_when_queue_full(self, fake_redis):\n        \"\"\"\n        When message queue exceeds MAX_QUEUE_SIZE, oldest messages should be dropped.\n\n        Contract: HYPHA-API-STREAMING.md — drop >100 messages behind, emit slow_client event\n        \"\"\"\n        subscriber = SSESubscriber(\n            redis_client=fake_redis,\n            channel=PubSubChannel.DISCOVERY.value,\n            user_id=\"test-user-123\",\n        )\n\n        # Manually fill the queue beyond capacity\n        for i in range(MAX_QUEUE_SIZE + 10):\n            await subscriber._message_queue.put(f\"message-{i}\")\n\n        # Queue should be at max capacity, not over\n        # (backpressure logic runs in _reader, not on put)\n        assert subscriber._message_queue.qsize() == MAX_QUEUE_SIZE + 10\n\n        # Cleanup\n        await subscriber._cleanup()\n","numLines":473,"startLine":1,"totalLines":473}}}}
