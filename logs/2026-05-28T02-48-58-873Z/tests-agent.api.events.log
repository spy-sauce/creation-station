{"t":"2026-05-28T03:01:45.738Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BAwmQC15g27mFbnw8yBeLM","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Test suite for DiscoveryOrchestrator pub/sub event emissions.\n     6→\n     7→Validates that the orchestrator publishes the correct sequence of events\n     8→to Redis pub/sub during a discovery run.\n     9→\n    10→Uses fakeredis for async Redis mocking and patches Claude API calls.\n    11→\"\"\"\n    12→\n    13→import asyncio\n    14→import json\n    15→from datetime import datetime, timezone\n    16→from unittest.mock import AsyncMock, MagicMock, patch\n    17→from uuid import uuid4\n    18→\n    19→import pytest\n    20→import fakeredis.aioredis\n    21→from sqlalchemy.ext.asyncio import AsyncSession\n    22→\n    23→from backend.agents.discovery.orchestrator import DiscoveryOrchestrator\n    24→from backend.agents.discovery.schemas import (\n    25→    CandidateSchema,\n    26→    IdentityProfileSchema,\n    27→    SearchManifestSchema,\n    28→    ScoredJobSchema,\n    29→    ScoreBreakdown,\n    30→    DailyDigestSchema,\n    31→    DiscoveredJobSchema,\n    32→)\n    33→\n    34→\n    35→# ─── Fixtures ────────────────────────────────────────────────────────────────\n    36→\n    37→\n    38→@pytest.fixture\n    39→async def fake_redis():\n    40→    \"\"\"Create a fakeredis async client for testing pub/sub.\"\"\"\n    41→    server = fakeredis.FakeServer()\n    42→    client = fakeredis.aioredis.FakeRedis(server=server, decode_responses=True)\n    43→    yield client\n    44→    await client.aclose()\n    45→\n    46→\n    47→@pytest.fixture\n    48→async def async_db():\n    49→    \"\"\"\n    50→    Create a mock async database session for testing.\n    51→\n    52→    We don't need a real database since we mock all DB interactions.\n    53→    \"\"\"\n    54→    # Use a mock session since we patch all DB calls\n    55→    session = AsyncMock(spec=AsyncSession)\n    56→    session.add = MagicMock()\n    57→    session.commit = AsyncMock()\n    58→    session.refresh = AsyncMock()\n    59→    yield session\n    60→\n    61→\n    62→@pytest.fixture\n    63→def mock_candidate_id():\n    64→    \"\"\"Generate a deterministic candidate ID for testing.\"\"\"\n    65→    return uuid4()\n    66→\n    67→\n    68→@pytest.fixture\n    69→def test_candidate(mock_candidate_id):\n    70→    \"\"\"Create a test candidate schema (not ORM model).\"\"\"\n    71→    return CandidateSchema(\n    72→        id=mock_candidate_id,\n    73→        name=\"Test Candidate\",\n    74→        email=\"test@example.com\",\n    75→        resume_text=\"Senior software engineer with Python, FastAPI, PostgreSQL experience.\",\n    76→        linkedin_url=\"https://linkedin.com/in/testcandidate\",\n    77→        github_url=\"https://github.com/testcandidate\",\n    78→        personal_context=\"Looking for AI/ML leadership roles\",\n    79→        target_locations=[\"Remote\", \"Miami, FL\"],\n    80→        remote_preference=\"flexible\",\n    81→        min_compensation=200000,\n    82→        excluded_companies=[\"BigBank Corp\"],\n    83→        excluded_industries=[\"Gambling\"],\n    84→    )\n    85→\n    86→\n    87→@pytest.fixture\n    88→def mock_identity_profile():\n    89→    \"\"\"Create a mock identity profile returned by IdentityProfiler.\"\"\"\n    90→    return IdentityProfileSchema(\n    91→        archetypes=[\"Head of AI\", \"Principal Engineer\", \"VP Engineering\"],\n    92→        leadership_level=\"Director\",\n    93→        technical_skills=[\"Python\", \"FastAPI\", \"PostgreSQL\", \"Redis\", \"Claude API\"],\n    94→        soft_skills=[\"Leadership\", \"Communication\"],\n    95→        industry_experience=[\"Fintech\", \"AI/ML\", \"Music Tech\"],\n    96→        notable_achievements=[\"Led team of 15 engineers\", \"Built AI platform\"],\n    97→        career_trajectory=\"IC → Lead → Director, seeking VP/Head of roles\",\n    98→        ideal_role_description=\"AI/ML leadership at a growth-stage startup\",\n    99→        signals={\n   100→            \"startup_vs_enterprise\": \"startup\",\n   101→            \"remote_preference\": \"remote\",\n   102→            \"mission_vs_comp\": \"balanced\",\n   103→        },\n   104→    )\n   105→\n   106→\n   107→@pytest.fixture\n   108→def mock_search_manifest():\n   109→    \"\"\"Create a mock search manifest returned by ArchetypeGenerator.\"\"\"\n   110→    return SearchManifestSchema(\n   111→        target_titles=[\"Head of AI\", \"VP Engineering\", \"Director of AI\"],\n   112→        keywords=[\"AI\", \"ML\", \"Python\", \"FastAPI\"],\n   113→        excluded_titles=[],\n   114→        excluded_companies=[\"BigBank Corp\"],\n   115→        excluded_industries=[\"Gambling\"],\n   116→        location_filters=[\"Remote\", \"Miami\"],\n   117→        remote_preference=\"remote\",\n   118→        min_compensation=200000,\n   119→    )\n   120→\n   121→\n   122→@pytest.fixture\n   123→def mock_discovered_jobs():\n   124→    \"\"\"Create mock discovered jobs returned by CrawlerAgent.\"\"\"\n   125→    return [\n   126→        DiscoveredJobSchema(\n   127→            id=uuid4(),\n   128→            source=\"greenhouse\",\n   129→            source_id=\"gh-test-001\",\n   130→            title=\"Head of AI Engineering\",\n   131→            company=\"AI Startup Co\",\n   132→            location=\"Remote\",\n   133→            description=\"Looking for Head of AI...\",\n   134→            url=\"https://example.com/job/001\",\n   135→            salary_min=250000,\n   136→            salary_max=350000,\n   137→            remote=True,\n   138→            crawled_at=datetime.now(timezone.utc),\n   139→        ),\n   140→        DiscoveredJobSchema(\n   141→            id=uuid4(),\n   142→            source=\"lever\",\n   143→            source_id=\"lever-test-002\",\n   144→            title=\"VP Engineering\",\n   145→            company=\"FinTech Inc\",\n   146→            location=\"Miami, FL / Remote\",\n   147→            description=\"VP Engineering needed...\",\n   148→            url=\"https://example.com/job/002\",\n   149→            salary_min=300000,\n   150→            salary_max=400000,\n   151→            remote=True,\n   152→            crawled_at=datetime.now(timezone.utc),\n   153→        ),\n   154→    ]\n   155→\n   156→\n   157→@pytest.fixture\n   158→def mock_scored_jobs(mock_candidate_id, mock_discovered_jobs):\n   159→    \"\"\"Create mock scored jobs returned by RelevanceScorer.\"\"\"\n   160→    return [\n   161→        ScoredJobSchema(\n   162→            id=uuid4(),\n   163→            discovered_job_id=mock_discovered_jobs[0].id,\n   164→            candidate_id=mock_candidate_id,\n   165→            score_breakdown=ScoreBreakdown(\n   166→                technical_match=85,\n   167→                level_match=90,\n   168→                culture_match=80,\n   169→                industry_match=75,\n   170→                growth_potential=85,\n   171→                compensation_match=80,\n   172→            ),\n   173→            composite_score=84,\n   174→            is_hot=True,\n   175→            reasoning=\"Strong technical match with AI leadership experience.\",\n   176→            title=\"Head of AI Engineering\",\n   177→            company=\"AI Startup Co\",\n   178→            location=\"Remote\",\n   179→            url=\"https://example.com/job/001\",\n   180→            scored_at=datetime.now(timezone.utc),\n   181→        ),\n   182→        ScoredJobSchema(\n   183→            id=uuid4(),\n   184→            discovered_job_id=mock_discovered_jobs[1].id,\n   185→            candidate_id=mock_candidate_id,\n   186→            score_breakdown=ScoreBreakdown(\n   187→                technical_match=80,\n   188→                level_match=85,\n   189→                culture_match=75,\n   190→                industry_match=80,\n   191→                growth_potential=70,\n   192→                compensation_match=85,\n   193→            ),\n   194→            composite_score=80,\n   195→            is_hot=True,\n   196→            reasoning=\"Good fintech leadership opportunity.\",\n   197→            title=\"VP Engineering\",\n   198→            company=\"FinTech Inc\",\n   199→            location=\"Miami, FL / Remote\",\n   200→            url=\"https://example.com/job/002\",\n   201→            scored_at=datetime.now(timezone.utc),\n   202→        ),\n   203→    ]\n   204→\n   205→\n   206→# ─── Pub/Sub Collector Helper ────────────────────────────────────────────────\n   207→\n   208→\n   209→class PubSubCollector:\n   210→    \"\"\"\n   211→    Collects published messages from a fakeredis pub/sub channel.\n   212→\n   213→    Used to verify the sequence and content of events published by\n   214→    the orchestrator during a discovery run.\n   215→    \"\"\"\n   216→\n   217→    def __init__(self, redis_client, channel: str):\n   218→        self.redis_client = redis_client\n   219→        self.channel = channel\n   220→        self.messages: list[dict] = []\n   221→        self._pubsub = None\n   222→        self._task = None\n   223→\n   224→    async def start(self):\n   225→        \"\"\"Subscribe to the channel and start collecting messages.\"\"\"\n   226→        self._pubsub = self.redis_client.pubsub()\n   227→        await self._pubsub.subscribe(self.channel)\n   228→        self._task = asyncio.create_task(self._collect())\n   229→\n   230→    async def _collect(self):\n   231→        \"\"\"Background task to collect published messages.\"\"\"\n   232→        async for message in self._pubsub.listen():\n   233→            if message[\"type\"] == \"message\":\n   234→                data = message[\"data\"]\n   235→                if isinstance(data, bytes):\n   236→                    data = data.decode(\"utf-8\")\n   237→                try:\n   238→                    parsed = json.loads(data)\n   239→                    self.messages.append(parsed)\n   240→                except json.JSONDecodeError:\n   241→                    self.messages.append({\"raw\": data})\n   242→\n   243→    async def stop(self):\n   244→        \"\"\"Stop collecting and clean up.\"\"\"\n   245→        if self._task:\n   246→            self._task.cancel()\n   247→            try:\n   248→                await self._task\n   249→            except asyncio.CancelledError:\n   250→                pass\n   251→        if self._pubsub:\n   252→            await self._pubsub.unsubscribe(self.channel)\n   253→            await self._pubsub.aclose()\n   254→\n   255→    def get_event_sequence(self) -> list[str]:\n   256→        \"\"\"Return the sequence of event status values.\"\"\"\n   257→        return [msg.get(\"status\") for msg in self.messages if \"status\" in msg]\n   258→\n   259→\n   260→# ─── Tests ───────────────────────────────────────────────────────────────────\n   261→\n   262→\n   263→class TestOrchestratorPubSub:\n   264→    \"\"\"Test suite for DiscoveryOrchestrator pub/sub event emissions.\"\"\"\n   265→\n   266→    @pytest.mark.asyncio\n   267→    async def test_orchestrator_publishes_event_sequence(\n   268→        self,\n   269→        fake_redis,\n   270→        async_db,\n   271→        test_candidate,\n   272→        mock_identity_profile,\n   273→        mock_search_manifest,\n   274→        mock_discovered_jobs,\n   275→        mock_scored_jobs,\n   276→    ):\n   277→        \"\"\"\n   278→        Verify the orchestrator publishes the correct sequence of events.\n   279→\n   280→        Expected sequence (6 events minimum):\n   281→          1. CANDIDATE_LOADED\n   282→          2. PROFILE_BUILT\n   283→          3. MANIFEST_BUILT\n   284→          4. CRAWL_COMPLETE\n   285→          5. SCORING_COMPLETE\n   286→          6. RUN_COMPLETE\n   287→        \"\"\"\n   288→        collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n   289→        await collector.start()\n   290→\n   291→        # Allow subscriber to initialize\n   292→        await asyncio.sleep(0.1)\n   293→\n   294→        with (\n   295→            patch.object(\n   296→                DiscoveryOrchestrator, \"_load_candidate\"\n   297→            ) as mock_load,\n   298→            patch(\n   299→                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n   300→            ) as MockProfiler,\n   301→            patch(\n   302→                \"backend.agents.discovery.orchestrator.ArchetypeGenerator\"\n   303→            ) as MockArchetype,\n   304→            patch(\n   305→                \"backend.agents.discovery.orchestrator.CrawlerAgent\"\n   306→            ) as MockCrawler,\n   307→            patch(\n   308→                \"backend.agents.discovery.orchestrator.RelevanceScorer\"\n   309→            ) as MockScorer,\n   310→            patch(\n   311→                \"backend.agents.discovery.orchestrator.DigestBuilder\"\n   312→            ) as MockDigest,\n   313→        ):\n   314→            # Set up mocks\n   315→            mock_load.return_value = test_candidate\n   316→\n   317→            profiler_instance = AsyncMock()\n   318→            profiler_instance.build_profile.return_value = mock_identity_profile\n   319→            MockProfiler.return_value = profiler_instance\n   320→\n   321→            archetype_instance = MagicMock()\n   322→            archetype_instance.expand.return_value = mock_search_manifest\n   323→            MockArchetype.return_value = archetype_instance\n   324→\n   325→            crawler_instance = AsyncMock()\n   326→            crawler_instance.run.return_value = mock_discovered_jobs\n   327→            MockCrawler.return_value = crawler_instance\n   328→\n   329→            scorer_instance = AsyncMock()\n   330→            scorer_instance.score_batch.return_value = mock_scored_jobs\n   331→            MockScorer.return_value = scorer_instance\n   332→\n   333→            digest_instance = AsyncMock()\n   334→            digest_instance.compile.return_value = DailyDigestSchema(\n   335→                candidate_id=test_candidate.id,\n   336→                run_date=\"2026-05-27\",\n   337→                total_jobs_discovered=2,\n   338→                total_jobs_scored=2,\n   339→                top_picks=mock_scored_jobs,\n   340→                hot_picks=mock_scored_jobs,\n   341→                new_companies=[\"AI Startup Co\", \"FinTech Inc\"],\n   342→            )\n   343→            MockDigest.return_value = digest_instance\n   344→\n   345→            # Run orchestrator\n   346→            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n   347→                mock_settings.anthropic_api_key = \"test-key\"\n   348→                mock_settings.crawl_concurrency = 4\n   349→                mock_settings.min_score = 60\n   350→\n   351→                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n   352→                orchestrator._profiler = profiler_instance\n   353→                orchestrator._archetype_gen = archetype_instance\n   354→                orchestrator._scorer = scorer_instance\n   355→                orchestrator._digest_builder = digest_instance\n   356→\n   357→                result = await orchestrator.run(test_candidate.id, dry_run=True)\n   358→\n   359→        # Allow events to propagate\n   360→        await asyncio.sleep(0.2)\n   361→        await collector.stop()\n   362→\n   363→        # Verify event sequence\n   364→        event_sequence = collector.get_event_sequence()\n   365→\n   366→        # Assert minimum 6 events\n   367→        assert len(event_sequence) >= 6, (\n   368→            f\"Expected at least 6 events, got {len(event_sequence)}: {event_sequence}\"\n   369→        )\n   370→\n   371→        # Verify expected events are present\n   372→        expected_events = [\n   373→            \"CANDIDATE_LOADED\",\n   374→            \"PROFILE_BUILT\",\n   375→            \"MANIFEST_BUILT\",\n   376→            \"CRAWL_COMPLETE\",\n   377→            \"SCORING_COMPLETE\",\n   378→            \"RUN_COMPLETE\",\n   379→        ]\n   380→        for event in expected_events:\n   381→            assert event in event_sequence, f\"Missing expected event: {event}\"\n   382→\n   383→        # Verify RUN_COMPLETE is last\n   384→        assert event_sequence[-1] == \"RUN_COMPLETE\", (\n   385→            f\"RUN_COMPLETE should be last, but got: {event_sequence[-1]}\"\n   386→        )\n   387→\n   388→    @pytest.mark.asyncio\n   389→    async def test_no_duplicate_events(\n   390→        self,\n   391→        fake_redis,\n   392→        async_db,\n   393→        test_candidate,\n   394→        mock_identity_profile,\n   395→        mock_search_manifest,\n   396→        mock_discovered_jobs,\n   397→        mock_scored_jobs,\n   398→    ):\n   399→        \"\"\"Verify no duplicate events are published during a run.\"\"\"\n   400→        collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n   401→        await collector.start()\n   402→        await asyncio.sleep(0.1)\n   403→\n   404→        with (\n   405→            patch.object(\n   406→                DiscoveryOrchestrator, \"_load_candidate\"\n   407→            ) as mock_load,\n   408→            patch(\n   409→                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n   410→            ) as MockProfiler,\n   411→            patch(\n   412→                \"backend.agents.discovery.orchestrator.ArchetypeGenerator\"\n   413→            ) as MockArchetype,\n   414→            patch(\n   415→                \"backend.agents.discovery.orchestrator.CrawlerAgent\"\n   416→            ) as MockCrawler,\n   417→            patch(\n   418→                \"backend.agents.discovery.orchestrator.RelevanceScorer\"\n   419→            ) as MockScorer,\n   420→            patch(\n   421→                \"backend.agents.discovery.orchestrator.DigestBuilder\"\n   422→            ) as MockDigest,\n   423→        ):\n   424→            mock_load.return_value = test_candidate\n   425→\n   426→            profiler_instance = AsyncMock()\n   427→            profiler_instance.build_profile.return_value = mock_identity_profile\n   428→            MockProfiler.return_value = profiler_instance\n   429→\n   430→            archetype_instance = MagicMock()\n   431→            archetype_instance.expand.return_value = mock_search_manifest\n   432→            MockArchetype.return_value = archetype_instance\n   433→\n   434→            crawler_instance = AsyncMock()\n   435→            crawler_instance.run.return_value = mock_discovered_jobs\n   436→            MockCrawler.return_value = crawler_instance\n   437→\n   438→            scorer_instance = AsyncMock()\n   439→            scorer_instance.score_batch.return_value = mock_scored_jobs\n   440→            MockScorer.return_value = scorer_instance\n   441→\n   442→            digest_instance = AsyncMock()\n   443→            digest_instance.compile.return_value = DailyDigestSchema(\n   444→                candidate_id=test_candidate.id,\n   445→                run_date=\"2026-05-27\",\n   446→                total_jobs_discovered=2,\n   447→                total_jobs_scored=2,\n   448→                top_picks=mock_scored_jobs,\n   449→                hot_picks=mock_scored_jobs,\n   450→                new_companies=[\"AI Startup Co\", \"FinTech Inc\"],\n   451→            )\n   452→            MockDigest.return_value = digest_instance\n   453→\n   454→            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n   455→                mock_settings.anthropic_api_key = \"test-key\"\n   456→                mock_settings.crawl_concurrency = 4\n   457→                mock_settings.min_score = 60\n   458→\n   459→                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n   460→                orchestrator._profiler = profiler_instance\n   461→                orchestrator._archetype_gen = archetype_instance\n   462→                orchestrator._scorer = scorer_instance\n   463→                orchestrator._digest_builder = digest_instance\n   464→\n   465→                await orchestrator.run(test_candidate.id, dry_run=True)\n   466→\n   467→        await asyncio.sleep(0.2)\n   468→        await collector.stop()\n   469→\n   470→        event_sequence = collector.get_event_sequence()\n   471→\n   472→        # Check for duplicates\n   473→        seen = set()\n   474→        duplicates = []\n   475→        for event in event_sequence:\n   476→            if event in seen:\n   477→                duplicates.append(event)\n   478→            seen.add(event)\n   479→\n   480→        assert not duplicates, f\"Found duplicate events: {duplicates}\"\n   481→\n   482→    @pytest.mark.asyncio\n   483→    async def test_run_complete_is_last_event(\n   484→        self,\n   485→        fake_redis,\n   486→        async_db,\n   487→        test_candidate,\n   488→        mock_identity_profile,\n   489→        mock_search_manifest,\n   490→        mock_discovered_jobs,\n   491→        mock_scored_jobs,\n   492→    ):\n   493→        \"\"\"Explicitly verify RUN_COMPLETE is the final event.\"\"\"\n   494→        collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n   495→        await collector.start()\n   496→        await asyncio.sleep(0.1)\n   497→\n   498→        with (\n   499→            patch.object(\n   500→                DiscoveryOrchestrator, \"_load_candidate\"\n   501→            ) as mock_load,\n   502→            patch(\n   503→                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n   504→            ) as MockProfiler,\n   505→            patch(\n   506→                \"backend.agents.discovery.orchestrator.ArchetypeGenerator\"\n   507→            ) as MockArchetype,\n   508→            patch(\n   509→                \"backend.agents.discovery.orchestrator.CrawlerAgent\"\n   510→            ) as MockCrawler,\n   511→            patch(\n   512→                \"backend.agents.discovery.orchestrator.RelevanceScorer\"\n   513→            ) as MockScorer,\n   514→            patch(\n   515→                \"backend.agents.discovery.orchestrator.DigestBuilder\"\n   516→            ) as MockDigest,\n   517→        ):\n   518→            mock_load.return_value = test_candidate\n   519→\n   520→            profiler_instance = AsyncMock()\n   521→            profiler_instance.build_profile.return_value = mock_identity_profile\n   522→            MockProfiler.return_value = profiler_instance\n   523→\n   524→            archetype_instance = MagicMock()\n   525→            archetype_instance.expand.return_value = mock_search_manifest\n   526→            MockArchetype.return_value = archetype_instance\n   527→\n   528→            crawler_instance = AsyncMock()\n   529→            crawler_instance.run.return_value = mock_discovered_jobs\n   530→            MockCrawler.return_value = crawler_instance\n   531→\n   532→            scorer_instance = AsyncMock()\n   533→            scorer_instance.score_batch.return_value = mock_scored_jobs\n   534→            MockScorer.return_value = scorer_instance\n   535→\n   536→            digest_instance = AsyncMock()\n   537→            digest_instance.compile.return_value = DailyDigestSchema(\n   538→                candidate_id=test_candidate.id,\n   539→                run_date=\"2026-05-27\",\n   540→                total_jobs_discovered=2,\n   541→                total_jobs_scored=2,\n   542→                top_picks=mock_scored_jobs,\n   543→                hot_picks=mock_scored_jobs,\n   544→                new_companies=[\"AI Startup Co\", \"FinTech Inc\"],\n   545→            )\n   546→            MockDigest.return_value = digest_instance\n   547→\n   548→            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n   549→                mock_settings.anthropic_api_key = \"test-key\"\n   550→                mock_settings.crawl_concurrency = 4\n   551→                mock_settings.min_score = 60\n   552→\n   553→                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n   554→                orchestrator._profiler = profiler_instance\n   555→                orchestrator._archetype_gen = archetype_instance\n   556→                orchestrator._scorer = scorer_instance\n   557→                orchestrator._digest_builder = digest_instance\n   558→\n   559→                await orchestrator.run(test_candidate.id, dry_run=True)\n   560→\n   561→        await asyncio.sleep(0.2)\n   562→        await collector.stop()\n   563→\n   564→        event_sequence = collector.get_event_sequence()\n   565→        assert len(event_sequence) > 0, \"No events were published\"\n   566→        assert event_sequence[-1] == \"RUN_COMPLETE\", (\n   567→            f\"Expected RUN_COMPLETE as last event, got: {event_sequence[-1]}\"\n   568→        )\n   569→\n   570→    @pytest.mark.asyncio\n   571→    async def test_run_failed_emits_on_error(\n   572→        self,\n   573→        fake_redis,\n   574→        async_db,\n   575→        test_candidate,\n   576→    ):\n   577→        \"\"\"Verify RUN_FAILED is emitted when orchestrator encounters an error.\"\"\"\n   578→        collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n   579→        await collector.start()\n   580→        await asyncio.sleep(0.1)\n   581→\n   582→        with (\n   583→            patch.object(\n   584→                DiscoveryOrchestrator, \"_load_candidate\"\n   585→            ) as mock_load,\n   586→            patch(\n   587→                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n   588→            ) as MockProfiler,\n   589→        ):\n   590→            mock_load.return_value = test_candidate\n   591→\n   592→            # Make profiler raise an exception\n   593→            profiler_instance = AsyncMock()\n   594→            profiler_instance.build_profile.side_effect = Exception(\"Claude API error\")\n   595→            MockProfiler.return_value = profiler_instance\n   596→\n   597→            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n   598→                mock_settings.anthropic_api_key = \"test-key\"\n   599→                mock_settings.crawl_concurrency = 4\n   600→                mock_settings.min_score = 60\n   601→\n   602→                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n   603→                orchestrator._profiler = profiler_instance\n   604→\n   605→                with pytest.raises(Exception, match=\"Claude API error\"):\n   606→                    await orchestrator.run(test_candidate.id, dry_run=True)\n   607→\n   608→        await asyncio.sleep(0.2)\n   609→        await collector.stop()\n   610→\n   611→        event_sequence = collector.get_event_sequence()\n   612→\n   613→        # Should have CANDIDATE_LOADED then RUN_FAILED\n   614→        assert \"CANDIDATE_LOADED\" in event_sequence\n   615→        assert \"RUN_FAILED\" in event_sequence\n   616→        assert event_sequence[-1] == \"RUN_FAILED\", (\n   617→            f\"Expected RUN_FAILED as last event, got: {event_sequence[-1]}\"\n   618→        )\n   619→\n   620→    @pytest.mark.asyncio\n   621→    async def test_event_payload_contains_candidate_id(\n   622→        self,\n   623→        fake_redis,\n   624→        async_db,\n   625→        test_candidate,\n   626→        mock_identity_profile,\n   627→        mock_search_manifest,\n   628→        mock_discovered_jobs,\n   629→        mock_scored_jobs,\n   630→    ):\n   631→        \"\"\"Verify all published events contain the candidate_id.\"\"\"\n   632→        collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n   633→        await collector.start()\n   634→        await asyncio.sleep(0.1)\n   635→\n   636→        with (\n   637→            patch.object(\n   638→                DiscoveryOrchestrator, \"_load_candidate\"\n   639→            ) as mock_load,\n   640→            patch(\n   641→                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n   642→            ) as MockProfiler,\n   643→            patch(\n   644→                \"backend.agents.discovery.orchestrator.ArchetypeGenerator\"\n   645→            ) as MockArchetype,\n   646→            patch(\n   647→                \"backend.agents.discovery.orchestrator.CrawlerAgent\"\n   648→            ) as MockCrawler,\n   649→            patch(\n   650→                \"backend.agents.discovery.orchestrator.RelevanceScorer\"\n   651→            ) as MockScorer,\n   652→            patch(\n   653→                \"backend.agents.discovery.orchestrator.DigestBuilder\"\n   654→            ) as MockDigest,\n   655→        ):\n   656→            mock_load.return_value = test_candidate\n   657→\n   658→            profiler_instance = AsyncMock()\n   659→            profiler_instance.build_profile.return_value = mock_identity_profile\n   660→            MockProfiler.return_value = profiler_instance\n   661→\n   662→            archetype_instance = MagicMock()\n   663→            archetype_instance.expand.return_value = mock_search_manifest\n   664→            MockArchetype.return_value = archetype_instance\n   665→\n   666→            crawler_instance = AsyncMock()\n   667→            crawler_instance.run.return_value = mock_discovered_jobs\n   668→            MockCrawler.return_value = crawler_instance\n   669→\n   670→            scorer_instance = AsyncMock()\n   671→            scorer_instance.score_batch.return_value = mock_scored_jobs\n   672→            MockScorer.return_value = scorer_instance\n   673→\n   674→            digest_instance = AsyncMock()\n   675→            digest_instance.compile.return_value = DailyDigestSchema(\n   676→                candidate_id=test_candidate.id,\n   677→                run_date=\"2026-05-27\",\n   678→                total_jobs_discovered=2,\n   679→                total_jobs_scored=2,\n   680→                top_picks=mock_scored_jobs,\n   681→                hot_picks=mock_scored_jobs,\n   682→                new_companies=[\"AI Startup Co\", \"FinTech Inc\"],\n   683→            )\n   684→            MockDigest.return_value = digest_instance\n   685→\n   686→            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n   687→                mock_settings.anthropic_api_key = \"test-key\"\n   688→                mock_settings.crawl_concurrency = 4\n   689→                mock_settings.min_score = 60\n   690→\n   691→                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n   692→                orchestrator._profiler = profiler_instance\n   693→                orchestrator._archetype_gen = archetype_instance\n   694→                orchestrator._scorer = scorer_instance\n   695→                orchestrator._digest_builder = digest_instance\n   696→\n   697→                await orchestrator.run(test_candidate.id, dry_run=True)\n   698→\n   699→        await asyncio.sleep(0.2)\n   700→        await collector.stop()\n   701→\n   702→        # Verify all messages have candidate_id\n   703→        for msg in collector.messages:\n   704→            assert \"candidate_id\" in msg, f\"Message missing candidate_id: {msg}\"\n   705→            assert msg[\"candidate_id\"] == str(test_candidate.id), (\n   706→                f\"Wrong candidate_id: {msg['candidate_id']}\"\n   707→            )\n   708→\n   709→    @pytest.mark.asyncio\n   710→    async def test_events_published_to_correct_channel(\n   711→        self,\n   712→        fake_redis,\n   713→        async_db,\n   714→        test_candidate,\n   715→        mock_identity_profile,\n   716→        mock_search_manifest,\n   717→        mock_discovered_jobs,\n   718→        mock_scored_jobs,\n   719→    ):\n   720→        \"\"\"Verify events are published to agent.status.discovery channel.\"\"\"\n   721→        # Subscribe to a different channel — should receive nothing\n   722→        wrong_collector = PubSubCollector(fake_redis, \"agent.status.application\")\n   723→        await wrong_collector.start()\n   724→\n   725→        # Subscribe to the correct channel\n   726→        correct_collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n   727→        await correct_collector.start()\n   728→\n   729→        await asyncio.sleep(0.1)\n   730→\n   731→        with (\n   732→            patch.object(\n   733→                DiscoveryOrchestrator, \"_load_candidate\"\n   734→            ) as mock_load,\n   735→            patch(\n   736→                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n   737→            ) as MockProfiler,\n   738→            patch(\n   739→                \"backend.agents.discovery.orchestrator.ArchetypeGenerator\"\n   740→            ) as MockArchetype,\n   741→            patch(\n   742→                \"backend.agents.discovery.orchestrator.CrawlerAgent\"\n   743→            ) as MockCrawler,\n   744→            patch(\n   745→                \"backend.agents.discovery.orchestrator.RelevanceScorer\"\n   746→            ) as MockScorer,\n   747→            patch(\n   748→                \"backend.agents.discovery.orchestrator.DigestBuilder\"\n   749→            ) as MockDigest,\n   750→        ):\n   751→            mock_load.return_value = test_candidate\n   752→\n   753→            profiler_instance = AsyncMock()\n   754→            profiler_instance.build_profile.return_value = mock_identity_profile\n   755→            MockProfiler.return_value = profiler_instance\n   756→\n   757→            archetype_instance = MagicMock()\n   758→            archetype_instance.expand.return_value = mock_search_manifest\n   759→            MockArchetype.return_value = archetype_instance\n   760→\n   761→            crawler_instance = AsyncMock()\n   762→            crawler_instance.run.return_value = mock_discovered_jobs\n   763→            MockCrawler.return_value = crawler_instance\n   764→\n   765→            scorer_instance = AsyncMock()\n   766→            scorer_instance.score_batch.return_value = mock_scored_jobs\n   767→            MockScorer.return_value = scorer_instance\n   768→\n   769→            digest_instance = AsyncMock()\n   770→            digest_instance.compile.return_value = DailyDigestSchema(\n   771→                candidate_id=test_candidate.id,\n   772→                run_date=\"2026-05-27\",\n   773→                total_jobs_discovered=2,\n   774→                total_jobs_scored=2,\n   775→                top_picks=mock_scored_jobs,\n   776→                hot_picks=mock_scored_jobs,\n   777→                new_companies=[\"AI Startup Co\", \"FinTech Inc\"],\n   778→            )\n   779→            MockDigest.return_value = digest_instance\n   780→\n   781→            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n   782→                mock_settings.anthropic_api_key = \"test-key\"\n   783→                mock_settings.crawl_concurrency = 4\n   784→                mock_settings.min_score = 60\n   785→\n   786→                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n   787→                orchestrator._profiler = profiler_instance\n   788→                orchestrator._archetype_gen = archetype_instance\n   789→                orchestrator._scorer = scorer_instance\n   790→                orchestrator._digest_builder = digest_instance\n   791→\n   792→                await orchestrator.run(test_candidate.id, dry_run=True)\n   793→\n   794→        await asyncio.sleep(0.2)\n   795→        await wrong_collector.stop()\n   796→        await correct_collector.stop()\n   797→\n   798→        # Wrong channel should have no messages\n   799→        assert len(wrong_collector.messages) == 0, (\n   800→            f\"Wrong channel received messages: {wrong_collector.messages}\"\n   801→        )\n   802→\n   803→        # Correct channel should have messages\n   804→        assert len(correct_collector.messages) > 0, (\n   805→            \"Correct channel received no messages\"\n   806→        )\n   807→\n   808→    @pytest.mark.asyncio\n   809→    async def test_event_order_is_deterministic(\n   810→        self,\n   811→        fake_redis,\n   812→        async_db,\n   813→        test_candidate,\n   814→        mock_identity_profile,\n   815→        mock_search_manifest,\n   816→        mock_discovered_jobs,\n   817→        mock_scored_jobs,\n   818→    ):\n   819→        \"\"\"Verify event order follows the pipeline execution order.\"\"\"\n   820→        collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n   821→        await collector.start()\n   822→        await asyncio.sleep(0.1)\n   823→\n   824→        with (\n   825→            patch.object(\n   826→                DiscoveryOrchestrator, \"_load_candidate\"\n   827→            ) as mock_load,\n   828→            patch(\n   829→                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n   830→            ) as MockProfiler,\n   831→            patch(\n   832→                \"backend.agents.discovery.orchestrator.ArchetypeGenerator\"\n   833→            ) as MockArchetype,\n   834→            patch(\n   835→                \"backend.agents.discovery.orchestrator.CrawlerAgent\"\n   836→            ) as MockCrawler,\n   837→            patch(\n   838→                \"backend.agents.discovery.orchestrator.RelevanceScorer\"\n   839→            ) as MockScorer,\n   840→            patch(\n   841→                \"backend.agents.discovery.orchestrator.DigestBuilder\"\n   842→            ) as MockDigest,\n   843→        ):\n   844→            mock_load.return_value = test_candidate\n   845→\n   846→            profiler_instance = AsyncMock()\n   847→            profiler_instance.build_profile.return_value = mock_identity_profile\n   848→            MockProfiler.return_value = profiler_instance\n   849→\n   850→            archetype_instance = MagicMock()\n   851→            archetype_instance.expand.return_value = mock_search_manifest\n   852→            MockArchetype.return_value = archetype_instance\n   853→\n   854→            crawler_instance = AsyncMock()\n   855→            crawler_instance.run.return_value = mock_discovered_jobs\n   856→            MockCrawler.return_value = crawler_instance\n   857→\n   858→            scorer_instance = AsyncMock()\n   859→            scorer_instance.score_batch.return_value = mock_scored_jobs\n   860→            MockScorer.return_value = scorer_instance\n   861→\n   862→            digest_instance = AsyncMock()\n   863→            digest_instance.compile.return_value = DailyDigestSchema(\n   864→                candidate_id=test_candidate.id,\n   865→                run_date=\"2026-05-27\",\n   866→                total_jobs_discovered=2,\n   867→                total_jobs_scored=2,\n   868→                top_picks=mock_scored_jobs,\n   869→                hot_picks=mock_scored_jobs,\n   870→                new_companies=[\"AI Startup Co\", \"FinTech Inc\"],\n   871→            )\n   872→            MockDigest.return_value = digest_instance\n   873→\n   874→            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n   875→                mock_settings.anthropic_api_key = \"test-key\"\n   876→                mock_settings.crawl_concurrency = 4\n   877→                mock_settings.min_score = 60\n   878→\n   879→                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n   880→                orchestrator._profiler = profiler_instance\n   881→                orchestrator._archetype_gen = archetype_instance\n   882→                orchestrator._scorer = scorer_instance\n   883→                orchestrator._digest_builder = digest_instance\n   884→\n   885→                await orchestrator.run(test_candidate.id, dry_run=True)\n   886→\n   887→        await asyncio.sleep(0.2)\n   888→        await collector.stop()\n   889→\n   890→        event_sequence = collector.get_event_sequence()\n   891→\n   892→        # Define expected order\n   893→        expected_order = [\n   894→            \"CANDIDATE_LOADED\",\n   895→            \"PROFILE_BUILT\",\n   896→            \"MANIFEST_BUILT\",\n   897→            \"CRAWL_COMPLETE\",\n   898→            \"SCORING_COMPLETE\",\n   899→            \"RUN_COMPLETE\",\n   900→        ]\n   901→\n   902→        # Verify order\n   903→        for i, expected in enumerate(expected_order):\n   904→            assert event_sequence[i] == expected, (\n   905→                f\"Event at position {i} should be {expected}, \"\n   906→                f\"got {event_sequence[i]}. Full sequence: {event_sequence}\"\n   907→            )\n   908→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"ef3e1c9a-082e-4b26-be4b-f026a2179071","uuid":"017f602f-50b5-45c6-a7f3-2a0103072957","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/tests/discovery/test_orchestrator_pubsub.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nTest suite for DiscoveryOrchestrator pub/sub event emissions.\n\nValidates that the orchestrator publishes the correct sequence of events\nto Redis pub/sub during a discovery run.\n\nUses fakeredis for async Redis mocking and patches Claude API calls.\n\"\"\"\n\nimport asyncio\nimport json\nfrom datetime import datetime, timezone\nfrom unittest.mock import AsyncMock, MagicMock, patch\nfrom uuid import uuid4\n\nimport pytest\nimport fakeredis.aioredis\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom backend.agents.discovery.orchestrator import DiscoveryOrchestrator\nfrom backend.agents.discovery.schemas import (\n    CandidateSchema,\n    IdentityProfileSchema,\n    SearchManifestSchema,\n    ScoredJobSchema,\n    ScoreBreakdown,\n    DailyDigestSchema,\n    DiscoveredJobSchema,\n)\n\n\n# ─── Fixtures ────────────────────────────────────────────────────────────────\n\n\n@pytest.fixture\nasync def fake_redis():\n    \"\"\"Create a fakeredis async client for testing pub/sub.\"\"\"\n    server = fakeredis.FakeServer()\n    client = fakeredis.aioredis.FakeRedis(server=server, decode_responses=True)\n    yield client\n    await client.aclose()\n\n\n@pytest.fixture\nasync def async_db():\n    \"\"\"\n    Create a mock async database session for testing.\n\n    We don't need a real database since we mock all DB interactions.\n    \"\"\"\n    # Use a mock session since we patch all DB calls\n    session = AsyncMock(spec=AsyncSession)\n    session.add = MagicMock()\n    session.commit = AsyncMock()\n    session.refresh = AsyncMock()\n    yield session\n\n\n@pytest.fixture\ndef mock_candidate_id():\n    \"\"\"Generate a deterministic candidate ID for testing.\"\"\"\n    return uuid4()\n\n\n@pytest.fixture\ndef test_candidate(mock_candidate_id):\n    \"\"\"Create a test candidate schema (not ORM model).\"\"\"\n    return CandidateSchema(\n        id=mock_candidate_id,\n        name=\"Test Candidate\",\n        email=\"test@example.com\",\n        resume_text=\"Senior software engineer with Python, FastAPI, PostgreSQL experience.\",\n        linkedin_url=\"https://linkedin.com/in/testcandidate\",\n        github_url=\"https://github.com/testcandidate\",\n        personal_context=\"Looking for AI/ML leadership roles\",\n        target_locations=[\"Remote\", \"Miami, FL\"],\n        remote_preference=\"flexible\",\n        min_compensation=200000,\n        excluded_companies=[\"BigBank Corp\"],\n        excluded_industries=[\"Gambling\"],\n    )\n\n\n@pytest.fixture\ndef mock_identity_profile():\n    \"\"\"Create a mock identity profile returned by IdentityProfiler.\"\"\"\n    return IdentityProfileSchema(\n        archetypes=[\"Head of AI\", \"Principal Engineer\", \"VP Engineering\"],\n        leadership_level=\"Director\",\n        technical_skills=[\"Python\", \"FastAPI\", \"PostgreSQL\", \"Redis\", \"Claude API\"],\n        soft_skills=[\"Leadership\", \"Communication\"],\n        industry_experience=[\"Fintech\", \"AI/ML\", \"Music Tech\"],\n        notable_achievements=[\"Led team of 15 engineers\", \"Built AI platform\"],\n        career_trajectory=\"IC → Lead → Director, seeking VP/Head of roles\",\n        ideal_role_description=\"AI/ML leadership at a growth-stage startup\",\n        signals={\n            \"startup_vs_enterprise\": \"startup\",\n            \"remote_preference\": \"remote\",\n            \"mission_vs_comp\": \"balanced\",\n        },\n    )\n\n\n@pytest.fixture\ndef mock_search_manifest():\n    \"\"\"Create a mock search manifest returned by ArchetypeGenerator.\"\"\"\n    return SearchManifestSchema(\n        target_titles=[\"Head of AI\", \"VP Engineering\", \"Director of AI\"],\n        keywords=[\"AI\", \"ML\", \"Python\", \"FastAPI\"],\n        excluded_titles=[],\n        excluded_companies=[\"BigBank Corp\"],\n        excluded_industries=[\"Gambling\"],\n        location_filters=[\"Remote\", \"Miami\"],\n        remote_preference=\"remote\",\n        min_compensation=200000,\n    )\n\n\n@pytest.fixture\ndef mock_discovered_jobs():\n    \"\"\"Create mock discovered jobs returned by CrawlerAgent.\"\"\"\n    return [\n        DiscoveredJobSchema(\n            id=uuid4(),\n            source=\"greenhouse\",\n            source_id=\"gh-test-001\",\n            title=\"Head of AI Engineering\",\n            company=\"AI Startup Co\",\n            location=\"Remote\",\n            description=\"Looking for Head of AI...\",\n            url=\"https://example.com/job/001\",\n            salary_min=250000,\n            salary_max=350000,\n            remote=True,\n            crawled_at=datetime.now(timezone.utc),\n        ),\n        DiscoveredJobSchema(\n            id=uuid4(),\n            source=\"lever\",\n            source_id=\"lever-test-002\",\n            title=\"VP Engineering\",\n            company=\"FinTech Inc\",\n            location=\"Miami, FL / Remote\",\n            description=\"VP Engineering needed...\",\n            url=\"https://example.com/job/002\",\n            salary_min=300000,\n            salary_max=400000,\n            remote=True,\n            crawled_at=datetime.now(timezone.utc),\n        ),\n    ]\n\n\n@pytest.fixture\ndef mock_scored_jobs(mock_candidate_id, mock_discovered_jobs):\n    \"\"\"Create mock scored jobs returned by RelevanceScorer.\"\"\"\n    return [\n        ScoredJobSchema(\n            id=uuid4(),\n            discovered_job_id=mock_discovered_jobs[0].id,\n            candidate_id=mock_candidate_id,\n            score_breakdown=ScoreBreakdown(\n                technical_match=85,\n                level_match=90,\n                culture_match=80,\n                industry_match=75,\n                growth_potential=85,\n                compensation_match=80,\n            ),\n            composite_score=84,\n            is_hot=True,\n            reasoning=\"Strong technical match with AI leadership experience.\",\n            title=\"Head of AI Engineering\",\n            company=\"AI Startup Co\",\n            location=\"Remote\",\n            url=\"https://example.com/job/001\",\n            scored_at=datetime.now(timezone.utc),\n        ),\n        ScoredJobSchema(\n            id=uuid4(),\n            discovered_job_id=mock_discovered_jobs[1].id,\n            candidate_id=mock_candidate_id,\n            score_breakdown=ScoreBreakdown(\n                technical_match=80,\n                level_match=85,\n                culture_match=75,\n                industry_match=80,\n                growth_potential=70,\n                compensation_match=85,\n            ),\n            composite_score=80,\n            is_hot=True,\n            reasoning=\"Good fintech leadership opportunity.\",\n            title=\"VP Engineering\",\n            company=\"FinTech Inc\",\n            location=\"Miami, FL / Remote\",\n            url=\"https://example.com/job/002\",\n            scored_at=datetime.now(timezone.utc),\n        ),\n    ]\n\n\n# ─── Pub/Sub Collector Helper ────────────────────────────────────────────────\n\n\nclass PubSubCollector:\n    \"\"\"\n    Collects published messages from a fakeredis pub/sub channel.\n\n    Used to verify the sequence and content of events published by\n    the orchestrator during a discovery run.\n    \"\"\"\n\n    def __init__(self, redis_client, channel: str):\n        self.redis_client = redis_client\n        self.channel = channel\n        self.messages: list[dict] = []\n        self._pubsub = None\n        self._task = None\n\n    async def start(self):\n        \"\"\"Subscribe to the channel and start collecting messages.\"\"\"\n        self._pubsub = self.redis_client.pubsub()\n        await self._pubsub.subscribe(self.channel)\n        self._task = asyncio.create_task(self._collect())\n\n    async def _collect(self):\n        \"\"\"Background task to collect published messages.\"\"\"\n        async for message in self._pubsub.listen():\n            if message[\"type\"] == \"message\":\n                data = message[\"data\"]\n                if isinstance(data, bytes):\n                    data = data.decode(\"utf-8\")\n                try:\n                    parsed = json.loads(data)\n                    self.messages.append(parsed)\n                except json.JSONDecodeError:\n                    self.messages.append({\"raw\": data})\n\n    async def stop(self):\n        \"\"\"Stop collecting and clean up.\"\"\"\n        if self._task:\n            self._task.cancel()\n            try:\n                await self._task\n            except asyncio.CancelledError:\n                pass\n        if self._pubsub:\n            await self._pubsub.unsubscribe(self.channel)\n            await self._pubsub.aclose()\n\n    def get_event_sequence(self) -> list[str]:\n        \"\"\"Return the sequence of event status values.\"\"\"\n        return [msg.get(\"status\") for msg in self.messages if \"status\" in msg]\n\n\n# ─── Tests ───────────────────────────────────────────────────────────────────\n\n\nclass TestOrchestratorPubSub:\n    \"\"\"Test suite for DiscoveryOrchestrator pub/sub event emissions.\"\"\"\n\n    @pytest.mark.asyncio\n    async def test_orchestrator_publishes_event_sequence(\n        self,\n        fake_redis,\n        async_db,\n        test_candidate,\n        mock_identity_profile,\n        mock_search_manifest,\n        mock_discovered_jobs,\n        mock_scored_jobs,\n    ):\n        \"\"\"\n        Verify the orchestrator publishes the correct sequence of events.\n\n        Expected sequence (6 events minimum):\n          1. CANDIDATE_LOADED\n          2. PROFILE_BUILT\n          3. MANIFEST_BUILT\n          4. CRAWL_COMPLETE\n          5. SCORING_COMPLETE\n          6. RUN_COMPLETE\n        \"\"\"\n        collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n        await collector.start()\n\n        # Allow subscriber to initialize\n        await asyncio.sleep(0.1)\n\n        with (\n            patch.object(\n                DiscoveryOrchestrator, \"_load_candidate\"\n            ) as mock_load,\n            patch(\n                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n            ) as MockProfiler,\n            patch(\n                \"backend.agents.discovery.orchestrator.ArchetypeGenerator\"\n            ) as MockArchetype,\n            patch(\n                \"backend.agents.discovery.orchestrator.CrawlerAgent\"\n            ) as MockCrawler,\n            patch(\n                \"backend.agents.discovery.orchestrator.RelevanceScorer\"\n            ) as MockScorer,\n            patch(\n                \"backend.agents.discovery.orchestrator.DigestBuilder\"\n            ) as MockDigest,\n        ):\n            # Set up mocks\n            mock_load.return_value = test_candidate\n\n            profiler_instance = AsyncMock()\n            profiler_instance.build_profile.return_value = mock_identity_profile\n            MockProfiler.return_value = profiler_instance\n\n            archetype_instance = MagicMock()\n            archetype_instance.expand.return_value = mock_search_manifest\n            MockArchetype.return_value = archetype_instance\n\n            crawler_instance = AsyncMock()\n            crawler_instance.run.return_value = mock_discovered_jobs\n            MockCrawler.return_value = crawler_instance\n\n            scorer_instance = AsyncMock()\n            scorer_instance.score_batch.return_value = mock_scored_jobs\n            MockScorer.return_value = scorer_instance\n\n            digest_instance = AsyncMock()\n            digest_instance.compile.return_value = DailyDigestSchema(\n                candidate_id=test_candidate.id,\n                run_date=\"2026-05-27\",\n                total_jobs_discovered=2,\n                total_jobs_scored=2,\n                top_picks=mock_scored_jobs,\n                hot_picks=mock_scored_jobs,\n                new_companies=[\"AI Startup Co\", \"FinTech Inc\"],\n            )\n            MockDigest.return_value = digest_instance\n\n            # Run orchestrator\n            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n                mock_settings.anthropic_api_key = \"test-key\"\n                mock_settings.crawl_concurrency = 4\n                mock_settings.min_score = 60\n\n                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n                orchestrator._profiler = profiler_instance\n                orchestrator._archetype_gen = archetype_instance\n                orchestrator._scorer = scorer_instance\n                orchestrator._digest_builder = digest_instance\n\n                result = await orchestrator.run(test_candidate.id, dry_run=True)\n\n        # Allow events to propagate\n        await asyncio.sleep(0.2)\n        await collector.stop()\n\n        # Verify event sequence\n        event_sequence = collector.get_event_sequence()\n\n        # Assert minimum 6 events\n        assert len(event_sequence) >= 6, (\n            f\"Expected at least 6 events, got {len(event_sequence)}: {event_sequence}\"\n        )\n\n        # Verify expected events are present\n        expected_events = [\n            \"CANDIDATE_LOADED\",\n            \"PROFILE_BUILT\",\n            \"MANIFEST_BUILT\",\n            \"CRAWL_COMPLETE\",\n            \"SCORING_COMPLETE\",\n            \"RUN_COMPLETE\",\n        ]\n        for event in expected_events:\n            assert event in event_sequence, f\"Missing expected event: {event}\"\n\n        # Verify RUN_COMPLETE is last\n        assert event_sequence[-1] == \"RUN_COMPLETE\", (\n            f\"RUN_COMPLETE should be last, but got: {event_sequence[-1]}\"\n        )\n\n    @pytest.mark.asyncio\n    async def test_no_duplicate_events(\n        self,\n        fake_redis,\n        async_db,\n        test_candidate,\n        mock_identity_profile,\n        mock_search_manifest,\n        mock_discovered_jobs,\n        mock_scored_jobs,\n    ):\n        \"\"\"Verify no duplicate events are published during a run.\"\"\"\n        collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n        await collector.start()\n        await asyncio.sleep(0.1)\n\n        with (\n            patch.object(\n                DiscoveryOrchestrator, \"_load_candidate\"\n            ) as mock_load,\n            patch(\n                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n            ) as MockProfiler,\n            patch(\n                \"backend.agents.discovery.orchestrator.ArchetypeGenerator\"\n            ) as MockArchetype,\n            patch(\n                \"backend.agents.discovery.orchestrator.CrawlerAgent\"\n            ) as MockCrawler,\n            patch(\n                \"backend.agents.discovery.orchestrator.RelevanceScorer\"\n            ) as MockScorer,\n            patch(\n                \"backend.agents.discovery.orchestrator.DigestBuilder\"\n            ) as MockDigest,\n        ):\n            mock_load.return_value = test_candidate\n\n            profiler_instance = AsyncMock()\n            profiler_instance.build_profile.return_value = mock_identity_profile\n            MockProfiler.return_value = profiler_instance\n\n            archetype_instance = MagicMock()\n            archetype_instance.expand.return_value = mock_search_manifest\n            MockArchetype.return_value = archetype_instance\n\n            crawler_instance = AsyncMock()\n            crawler_instance.run.return_value = mock_discovered_jobs\n            MockCrawler.return_value = crawler_instance\n\n            scorer_instance = AsyncMock()\n            scorer_instance.score_batch.return_value = mock_scored_jobs\n            MockScorer.return_value = scorer_instance\n\n            digest_instance = AsyncMock()\n            digest_instance.compile.return_value = DailyDigestSchema(\n                candidate_id=test_candidate.id,\n                run_date=\"2026-05-27\",\n                total_jobs_discovered=2,\n                total_jobs_scored=2,\n                top_picks=mock_scored_jobs,\n                hot_picks=mock_scored_jobs,\n                new_companies=[\"AI Startup Co\", \"FinTech Inc\"],\n            )\n            MockDigest.return_value = digest_instance\n\n            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n                mock_settings.anthropic_api_key = \"test-key\"\n                mock_settings.crawl_concurrency = 4\n                mock_settings.min_score = 60\n\n                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n                orchestrator._profiler = profiler_instance\n                orchestrator._archetype_gen = archetype_instance\n                orchestrator._scorer = scorer_instance\n                orchestrator._digest_builder = digest_instance\n\n                await orchestrator.run(test_candidate.id, dry_run=True)\n\n        await asyncio.sleep(0.2)\n        await collector.stop()\n\n        event_sequence = collector.get_event_sequence()\n\n        # Check for duplicates\n        seen = set()\n        duplicates = []\n        for event in event_sequence:\n            if event in seen:\n                duplicates.append(event)\n            seen.add(event)\n\n        assert not duplicates, f\"Found duplicate events: {duplicates}\"\n\n    @pytest.mark.asyncio\n    async def test_run_complete_is_last_event(\n        self,\n        fake_redis,\n        async_db,\n        test_candidate,\n        mock_identity_profile,\n        mock_search_manifest,\n        mock_discovered_jobs,\n        mock_scored_jobs,\n    ):\n        \"\"\"Explicitly verify RUN_COMPLETE is the final event.\"\"\"\n        collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n        await collector.start()\n        await asyncio.sleep(0.1)\n\n        with (\n            patch.object(\n                DiscoveryOrchestrator, \"_load_candidate\"\n            ) as mock_load,\n            patch(\n                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n            ) as MockProfiler,\n            patch(\n                \"backend.agents.discovery.orchestrator.ArchetypeGenerator\"\n            ) as MockArchetype,\n            patch(\n                \"backend.agents.discovery.orchestrator.CrawlerAgent\"\n            ) as MockCrawler,\n            patch(\n                \"backend.agents.discovery.orchestrator.RelevanceScorer\"\n            ) as MockScorer,\n            patch(\n                \"backend.agents.discovery.orchestrator.DigestBuilder\"\n            ) as MockDigest,\n        ):\n            mock_load.return_value = test_candidate\n\n            profiler_instance = AsyncMock()\n            profiler_instance.build_profile.return_value = mock_identity_profile\n            MockProfiler.return_value = profiler_instance\n\n            archetype_instance = MagicMock()\n            archetype_instance.expand.return_value = mock_search_manifest\n            MockArchetype.return_value = archetype_instance\n\n            crawler_instance = AsyncMock()\n            crawler_instance.run.return_value = mock_discovered_jobs\n            MockCrawler.return_value = crawler_instance\n\n            scorer_instance = AsyncMock()\n            scorer_instance.score_batch.return_value = mock_scored_jobs\n            MockScorer.return_value = scorer_instance\n\n            digest_instance = AsyncMock()\n            digest_instance.compile.return_value = DailyDigestSchema(\n                candidate_id=test_candidate.id,\n                run_date=\"2026-05-27\",\n                total_jobs_discovered=2,\n                total_jobs_scored=2,\n                top_picks=mock_scored_jobs,\n                hot_picks=mock_scored_jobs,\n                new_companies=[\"AI Startup Co\", \"FinTech Inc\"],\n            )\n            MockDigest.return_value = digest_instance\n\n            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n                mock_settings.anthropic_api_key = \"test-key\"\n                mock_settings.crawl_concurrency = 4\n                mock_settings.min_score = 60\n\n                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n                orchestrator._profiler = profiler_instance\n                orchestrator._archetype_gen = archetype_instance\n                orchestrator._scorer = scorer_instance\n                orchestrator._digest_builder = digest_instance\n\n                await orchestrator.run(test_candidate.id, dry_run=True)\n\n        await asyncio.sleep(0.2)\n        await collector.stop()\n\n        event_sequence = collector.get_event_sequence()\n        assert len(event_sequence) > 0, \"No events were published\"\n        assert event_sequence[-1] == \"RUN_COMPLETE\", (\n            f\"Expected RUN_COMPLETE as last event, got: {event_sequence[-1]}\"\n        )\n\n    @pytest.mark.asyncio\n    async def test_run_failed_emits_on_error(\n        self,\n        fake_redis,\n        async_db,\n        test_candidate,\n    ):\n        \"\"\"Verify RUN_FAILED is emitted when orchestrator encounters an error.\"\"\"\n        collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n        await collector.start()\n        await asyncio.sleep(0.1)\n\n        with (\n            patch.object(\n                DiscoveryOrchestrator, \"_load_candidate\"\n            ) as mock_load,\n            patch(\n                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n            ) as MockProfiler,\n        ):\n            mock_load.return_value = test_candidate\n\n            # Make profiler raise an exception\n            profiler_instance = AsyncMock()\n            profiler_instance.build_profile.side_effect = Exception(\"Claude API error\")\n            MockProfiler.return_value = profiler_instance\n\n            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n                mock_settings.anthropic_api_key = \"test-key\"\n                mock_settings.crawl_concurrency = 4\n                mock_settings.min_score = 60\n\n                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n                orchestrator._profiler = profiler_instance\n\n                with pytest.raises(Exception, match=\"Claude API error\"):\n                    await orchestrator.run(test_candidate.id, dry_run=True)\n\n        await asyncio.sleep(0.2)\n        await collector.stop()\n\n        event_sequence = collector.get_event_sequence()\n\n        # Should have CANDIDATE_LOADED then RUN_FAILED\n        assert \"CANDIDATE_LOADED\" in event_sequence\n        assert \"RUN_FAILED\" in event_sequence\n        assert event_sequence[-1] == \"RUN_FAILED\", (\n            f\"Expected RUN_FAILED as last event, got: {event_sequence[-1]}\"\n        )\n\n    @pytest.mark.asyncio\n    async def test_event_payload_contains_candidate_id(\n        self,\n        fake_redis,\n        async_db,\n        test_candidate,\n        mock_identity_profile,\n        mock_search_manifest,\n        mock_discovered_jobs,\n        mock_scored_jobs,\n    ):\n        \"\"\"Verify all published events contain the candidate_id.\"\"\"\n        collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n        await collector.start()\n        await asyncio.sleep(0.1)\n\n        with (\n            patch.object(\n                DiscoveryOrchestrator, \"_load_candidate\"\n            ) as mock_load,\n            patch(\n                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n            ) as MockProfiler,\n            patch(\n                \"backend.agents.discovery.orchestrator.ArchetypeGenerator\"\n            ) as MockArchetype,\n            patch(\n                \"backend.agents.discovery.orchestrator.CrawlerAgent\"\n            ) as MockCrawler,\n            patch(\n                \"backend.agents.discovery.orchestrator.RelevanceScorer\"\n            ) as MockScorer,\n            patch(\n                \"backend.agents.discovery.orchestrator.DigestBuilder\"\n            ) as MockDigest,\n        ):\n            mock_load.return_value = test_candidate\n\n            profiler_instance = AsyncMock()\n            profiler_instance.build_profile.return_value = mock_identity_profile\n            MockProfiler.return_value = profiler_instance\n\n            archetype_instance = MagicMock()\n            archetype_instance.expand.return_value = mock_search_manifest\n            MockArchetype.return_value = archetype_instance\n\n            crawler_instance = AsyncMock()\n            crawler_instance.run.return_value = mock_discovered_jobs\n            MockCrawler.return_value = crawler_instance\n\n            scorer_instance = AsyncMock()\n            scorer_instance.score_batch.return_value = mock_scored_jobs\n            MockScorer.return_value = scorer_instance\n\n            digest_instance = AsyncMock()\n            digest_instance.compile.return_value = DailyDigestSchema(\n                candidate_id=test_candidate.id,\n                run_date=\"2026-05-27\",\n                total_jobs_discovered=2,\n                total_jobs_scored=2,\n                top_picks=mock_scored_jobs,\n                hot_picks=mock_scored_jobs,\n                new_companies=[\"AI Startup Co\", \"FinTech Inc\"],\n            )\n            MockDigest.return_value = digest_instance\n\n            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n                mock_settings.anthropic_api_key = \"test-key\"\n                mock_settings.crawl_concurrency = 4\n                mock_settings.min_score = 60\n\n                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n                orchestrator._profiler = profiler_instance\n                orchestrator._archetype_gen = archetype_instance\n                orchestrator._scorer = scorer_instance\n                orchestrator._digest_builder = digest_instance\n\n                await orchestrator.run(test_candidate.id, dry_run=True)\n\n        await asyncio.sleep(0.2)\n        await collector.stop()\n\n        # Verify all messages have candidate_id\n        for msg in collector.messages:\n            assert \"candidate_id\" in msg, f\"Message missing candidate_id: {msg}\"\n            assert msg[\"candidate_id\"] == str(test_candidate.id), (\n                f\"Wrong candidate_id: {msg['candidate_id']}\"\n            )\n\n    @pytest.mark.asyncio\n    async def test_events_published_to_correct_channel(\n        self,\n        fake_redis,\n        async_db,\n        test_candidate,\n        mock_identity_profile,\n        mock_search_manifest,\n        mock_discovered_jobs,\n        mock_scored_jobs,\n    ):\n        \"\"\"Verify events are published to agent.status.discovery channel.\"\"\"\n        # Subscribe to a different channel — should receive nothing\n        wrong_collector = PubSubCollector(fake_redis, \"agent.status.application\")\n        await wrong_collector.start()\n\n        # Subscribe to the correct channel\n        correct_collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n        await correct_collector.start()\n\n        await asyncio.sleep(0.1)\n\n        with (\n            patch.object(\n                DiscoveryOrchestrator, \"_load_candidate\"\n            ) as mock_load,\n            patch(\n                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n            ) as MockProfiler,\n            patch(\n                \"backend.agents.discovery.orchestrator.ArchetypeGenerator\"\n            ) as MockArchetype,\n            patch(\n                \"backend.agents.discovery.orchestrator.CrawlerAgent\"\n            ) as MockCrawler,\n            patch(\n                \"backend.agents.discovery.orchestrator.RelevanceScorer\"\n            ) as MockScorer,\n            patch(\n                \"backend.agents.discovery.orchestrator.DigestBuilder\"\n            ) as MockDigest,\n        ):\n            mock_load.return_value = test_candidate\n\n            profiler_instance = AsyncMock()\n            profiler_instance.build_profile.return_value = mock_identity_profile\n            MockProfiler.return_value = profiler_instance\n\n            archetype_instance = MagicMock()\n            archetype_instance.expand.return_value = mock_search_manifest\n            MockArchetype.return_value = archetype_instance\n\n            crawler_instance = AsyncMock()\n            crawler_instance.run.return_value = mock_discovered_jobs\n            MockCrawler.return_value = crawler_instance\n\n            scorer_instance = AsyncMock()\n            scorer_instance.score_batch.return_value = mock_scored_jobs\n            MockScorer.return_value = scorer_instance\n\n            digest_instance = AsyncMock()\n            digest_instance.compile.return_value = DailyDigestSchema(\n                candidate_id=test_candidate.id,\n                run_date=\"2026-05-27\",\n                total_jobs_discovered=2,\n                total_jobs_scored=2,\n                top_picks=mock_scored_jobs,\n                hot_picks=mock_scored_jobs,\n                new_companies=[\"AI Startup Co\", \"FinTech Inc\"],\n            )\n            MockDigest.return_value = digest_instance\n\n            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n                mock_settings.anthropic_api_key = \"test-key\"\n                mock_settings.crawl_concurrency = 4\n                mock_settings.min_score = 60\n\n                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n                orchestrator._profiler = profiler_instance\n                orchestrator._archetype_gen = archetype_instance\n                orchestrator._scorer = scorer_instance\n                orchestrator._digest_builder = digest_instance\n\n                await orchestrator.run(test_candidate.id, dry_run=True)\n\n        await asyncio.sleep(0.2)\n        await wrong_collector.stop()\n        await correct_collector.stop()\n\n        # Wrong channel should have no messages\n        assert len(wrong_collector.messages) == 0, (\n            f\"Wrong channel received messages: {wrong_collector.messages}\"\n        )\n\n        # Correct channel should have messages\n        assert len(correct_collector.messages) > 0, (\n            \"Correct channel received no messages\"\n        )\n\n    @pytest.mark.asyncio\n    async def test_event_order_is_deterministic(\n        self,\n        fake_redis,\n        async_db,\n        test_candidate,\n        mock_identity_profile,\n        mock_search_manifest,\n        mock_discovered_jobs,\n        mock_scored_jobs,\n    ):\n        \"\"\"Verify event order follows the pipeline execution order.\"\"\"\n        collector = PubSubCollector(fake_redis, \"agent.status.discovery\")\n        await collector.start()\n        await asyncio.sleep(0.1)\n\n        with (\n            patch.object(\n                DiscoveryOrchestrator, \"_load_candidate\"\n            ) as mock_load,\n            patch(\n                \"backend.agents.discovery.orchestrator.IdentityProfiler\"\n            ) as MockProfiler,\n            patch(\n                \"backend.agents.discovery.orchestrator.ArchetypeGenerator\"\n            ) as MockArchetype,\n            patch(\n                \"backend.agents.discovery.orchestrator.CrawlerAgent\"\n            ) as MockCrawler,\n            patch(\n                \"backend.agents.discovery.orchestrator.RelevanceScorer\"\n            ) as MockScorer,\n            patch(\n                \"backend.agents.discovery.orchestrator.DigestBuilder\"\n            ) as MockDigest,\n        ):\n            mock_load.return_value = test_candidate\n\n            profiler_instance = AsyncMock()\n            profiler_instance.build_profile.return_value = mock_identity_profile\n            MockProfiler.return_value = profiler_instance\n\n            archetype_instance = MagicMock()\n            archetype_instance.expand.return_value = mock_search_manifest\n            MockArchetype.return_value = archetype_instance\n\n            crawler_instance = AsyncMock()\n            crawler_instance.run.return_value = mock_discovered_jobs\n            MockCrawler.return_value = crawler_instance\n\n            scorer_instance = AsyncMock()\n            scorer_instance.score_batch.return_value = mock_scored_jobs\n            MockScorer.return_value = scorer_instance\n\n            digest_instance = AsyncMock()\n            digest_instance.compile.return_value = DailyDigestSchema(\n                candidate_id=test_candidate.id,\n                run_date=\"2026-05-27\",\n                total_jobs_discovered=2,\n                total_jobs_scored=2,\n                top_picks=mock_scored_jobs,\n                hot_picks=mock_scored_jobs,\n                new_companies=[\"AI Startup Co\", \"FinTech Inc\"],\n            )\n            MockDigest.return_value = digest_instance\n\n            with patch(\"backend.agents.discovery.orchestrator.settings\") as mock_settings:\n                mock_settings.anthropic_api_key = \"test-key\"\n                mock_settings.crawl_concurrency = 4\n                mock_settings.min_score = 60\n\n                orchestrator = DiscoveryOrchestrator(async_db, fake_redis)\n                orchestrator._profiler = profiler_instance\n                orchestrator._archetype_gen = archetype_instance\n                orchestrator._scorer = scorer_instance\n                orchestrator._digest_builder = digest_instance\n\n                await orchestrator.run(test_candidate.id, dry_run=True)\n\n        await asyncio.sleep(0.2)\n        await collector.stop()\n\n        event_sequence = collector.get_event_sequence()\n\n        # Define expected order\n        expected_order = [\n            \"CANDIDATE_LOADED\",\n            \"PROFILE_BUILT\",\n            \"MANIFEST_BUILT\",\n            \"CRAWL_COMPLETE\",\n            \"SCORING_COMPLETE\",\n            \"RUN_COMPLETE\",\n        ]\n\n        # Verify order\n        for i, expected in enumerate(expected_order):\n            assert event_sequence[i] == expected, (\n                f\"Event at position {i} should be {expected}, \"\n                f\"got {event_sequence[i]}. Full sequence: {event_sequence}\"\n            )\n","numLines":908,"startLine":1,"totalLines":908}}}}
