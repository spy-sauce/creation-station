{"t":"2026-05-28T02:56:15.502Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016MVkEFwm9WxneaMZwPJuWB","type":"tool_result","content":"     1→import { useState, useEffect } from 'react'\n     2→import { Users, Briefcase, Send, TrendingUp, Zap, Clock, Rocket } from 'lucide-react'\n     3→import StatCard from '../components/StatCard'\n     4→import StatusBadge from '../components/StatusBadge'\n     5→import { useAuth } from '../context/AuthContext'\n     6→import { getDiscoveryStats, triggerDiscoveryRun } from '../lib/api'\n     7→\n     8→const agents = [\n     9→  { name: 'Discovery Engine', status: 'idle' },\n    10→  { name: 'Application Engine', status: 'idle' },\n    11→  { name: 'Contact Finder', status: 'idle' },\n    12→  { name: 'Outreach Composer', status: 'idle' },\n    13→]\n    14→\n    15→export default function Overview() {\n    16→  const { user } = useAuth()\n    17→  const [stats, setStats] = useState(null)\n    18→  const [runTriggered, setRunTriggered] = useState(false)\n    19→  const [triggerLoading, setTriggerLoading] = useState(false)\n    20→\n    21→  useEffect(() => {\n    22→    if (user?.candidate_id) {\n    23→      getDiscoveryStats(user.candidate_id).then(setStats).catch(() => {})\n    24→    }\n    25→  }, [user?.candidate_id])\n    26→\n    27→  const handleTriggerRun = async () => {\n    28→    if (!user?.candidate_id) return\n    29→    setTriggerLoading(true)\n    30→    try { await triggerDiscoveryRun(user.candidate_id, true); setRunTriggered(true) }\n    31→    catch {} finally { setTriggerLoading(false) }\n    32→  }\n    33→\n    34→  const displayStats = [\n    35→    { label: 'Active Candidates', value: '1', change: 0, icon: Users },\n    36→    { label: 'Roles Discovered', value: stats ? String(stats.total_discovered) : '0', change: 0, icon: Briefcase },\n    37→    { label: 'Applications Sent', value: '0', change: 0, icon: Send },\n    38→    { label: 'Discovery Runs', value: stats ? String(stats.total_runs) : '0', change: 0, icon: TrendingUp },\n    39→  ]\n    40→\n    41→  return (\n    42→    <div className=\"fade-in\" style={{ maxWidth: 1100 }}>\n    43→      {/* Welcome */}\n    44→      {user && (\n    45→        <div className=\"card-hover\" style={{ background: 'var(--off-black)', border: '1px solid var(--border)', padding: '32px 36px', marginBottom: 32 }}>\n    46→          <div style={{ display: 'flex', alignItems: 'flex-start', justifyContent: 'space-between', gap: 24 }}>\n    47→            <div>\n    48→              <p className=\"t-label-gold\" style={{ marginBottom: 8 }}>Welcome back</p>\n    49→              <h2 className=\"t-serif\" style={{ fontSize: 24, marginBottom: 8 }}>{user.name || 'there'}</h2>\n    50→              <p className=\"t-body\">\n    51→                {stats?.total_runs > 0\n    52→                  ? `Your agent has completed ${stats.total_runs} discovery runs and found ${stats.total_discovered} roles.`\n    53→                  : 'Your AI talent agent is ready. Trigger a discovery run to start finding opportunities.'}\n    54→              </p>\n    55→            </div>\n    56→            {user.candidate_id && !runTriggered && (\n    57→              <button onClick={handleTriggerRun} disabled={triggerLoading} className=\"btn-primary\" style={{ flexShrink: 0, display: 'flex', alignItems: 'center', gap: 8 }}>\n    58→                <Rocket style={{ width: 14, height: 14 }} />\n    59→                {triggerLoading ? 'Starting...' : 'Run Discovery'}\n    60→              </button>\n    61→            )}\n    62→            {runTriggered && (\n    63→              <span className=\"t-label-gold\" style={{ display: 'flex', alignItems: 'center', gap: 8, flexShrink: 0 }}>\n    64→                <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--gold)\" strokeWidth=\"2\" style={{ width: 14, height: 14 }}><path d=\"M20 6 9 17l-5-5\" /></svg>\n    65→                Discovery started\n    66