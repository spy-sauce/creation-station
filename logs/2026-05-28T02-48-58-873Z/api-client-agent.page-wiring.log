{"t":"2026-05-28T02:56:54.274Z","event":"sdk_msg","msg":{"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_01DSqUQK6aPWd3N6fuPSHo9W","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01GAse5ZQTsjjSTZfBYtdaaP","name":"Write","input":{"file_path":"/Users/spy/mfautomations/repos/creation-station/reverse-search/frontend/src/lib/logger.ts","content":"/**\n * Frontend logging utility for Talent Agent.\n * Per CLAUDE.md: No console.log — use structured logging utility.\n *\n * @license Apache-2.0\n * @copyright VibeSpace LLC\n */\n\ntype LogLevel = 'debug' | 'info' | 'warn' | 'error'\n\ninterface LogContext {\n  [key: string]: unknown\n}\n\n/**\n * Structured logger for frontend.\n * In production, this could be wired to a log aggregation service.\n * For now, it wraps console methods with structured output.\n */\nclass Logger {\n  private isDev = import.meta.env.DEV\n\n  private format(level: LogLevel, event: string, context?: LogContext): string {\n    const timestamp = new Date().toISOString()\n    const contextStr = context ? ` ${JSON.stringify(context)}` : ''\n    return `[${timestamp}] ${level.toUpperCase()} ${event}${contextStr}`\n  }\n\n  debug(event: string, context?: LogContext): void {\n    if (this.isDev) {\n      // eslint-disable-next-line no-console\n      console.debug(this.format('debug', event, context))\n    }\n  }\n\n  info(event: string, context?: LogContext): void {\n    if (this.isDev) {\n      // eslint-disable-next-line no-console\n      console.info(this.format('info', event, context))\n    }\n  }\n\n  warn(event: string, context?: LogContext): void {\n    // eslint-disable-next-line no-console\n    console.warn(this.format('warn', event, context))\n  }\n\n  error(event: string, context?: LogContext): void {\n    // eslint-disable-next-line no-console\n    console.error(this.format('error', event, context))\n  }\n}\n\n/**\n * Singleton logger instance.\n */\nexport const log = new Logger()\n\nexport default log\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":2060,"cache_read_input_tokens":89621,"cache_creation":{"ephemeral_5m_input_tokens":2060,"ephemeral_1h_input_tokens":0},"output_tokens":34,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"303fccaa-54a4-4459-b632-16d777db1b8d","uuid":"4a707ef9-9545-419e-8787-a961db2f57c4"}}
