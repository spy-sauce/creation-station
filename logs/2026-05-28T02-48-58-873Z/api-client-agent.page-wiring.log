\n   131→        <Loader2 style={{ width: 24, height: 24, color: 'var(--gold)', animation: 'spin 1s linear infinite' }} />\n   132→      </div>\n   133→    )\n   134→  }\n   135→\n   136→  if (queue.length === 0 && !error) {\n   137→    return (\n   138→      <div className=\"fade-in\" style={{ maxWidth: 600, margin: '0 auto', textAlign: 'center', paddingTop: 80 }}>\n   139→        <div style={{ width: 56, height: 56, borderRadius: '50%', border: '1px solid var(--gold)', display: 'flex', alignItems: 'center', justifyContent: 'center', margin: '0 auto 20px' }}>\n   140→          <Check style={{ width: 22, height: 22, color: 'var(--gold)' }} />\n   141→        </div>\n   142→        <h2 className=\"t-serif\" style={{ fontSize: 22, marginBottom: 8 }}>All caught up</h2>\n   143→        <p className=\"t-body\">No items pending review. The Discovery Engine will find more soon.</p>\n   144→      </div>\n   145→    )\n   146→  }\n   147→\n   148→  return (\n   149→    <div className=\"fade-in\" style={{ maxWidth: 900 }}>\n   150→      {/* Error banner */}\n   151→      {error && (\n   152→        <div style={{ background: 'rgba(239, 68, 68, 0.1)', border: '1px solid var(--status-error)', padding: '16px 24px', marginBottom: 24, display: 'flex', alignItems: 'center', gap: 12 }}>\n   153→          <AlertCircle style={{ width: 18, height: 18, color: 'var(--status-error)', flexShrink: 0 }} />\n   154→          <p style={{ color: 'var(--status-error)', fontSize: 14 }}>{error}</p>\n   155→        </div>\n   156→      )}\n   157→\n   158→      <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 24 }}>\n   159→        <p className=\"t-body\">Review AI-discovered matches before applications are sent.</p>\n   160→        <span className=\"t-label-gold\">{queue.length} pending</span>\n   161→      </div>\n   162→\n   163→      <div style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>\n   164→        {queue.map((pipeline) => {\n   165→          const open = expanded === pipeline.id\n   166→          const isLoading = actionLoading === pipeline.id\n   167→\n   168→          // Extract display data from pipeline\n   169→          const jd = pipeline.parsed_jd\n   170→          const intel = pipeline.company_intel\n   171→          const contact = pipeline.contact\n   172→          const outreach = pipeline.outreach_email\n   173→\n   174→          const role = jd?.seniority_level || 'Role'\n   175→          const company = intel?.company_name || 'Company'\n   176→          const location = 'Remote' // Would need to be in job data\n   177→          const salary = jd?.compensation_range || 'Not specified'\n   178→          const match = 85 // Placeholder - would need scoring\n   179→\n   180→          // Build match breakdown from parsed JD if available\n   181→          const matchBreakdown = {\n   182→            technical: jd ? 88 : 0,\n   183→            culture: intel ? 85 : 0,\n   184→            growth: 80,\n   185→            compensation: jd?.compensation_range ? 90 : 50,\n   186→          }\n   187→\n   188→          // Build highlights from parsed JD\n   189→          const highlights = []\n   190→          if (jd?.required_skills?.length > 0) {\n   191→            highlights.push(`Required skills: ${jd.required_skills.slice(0, 3).join(', ')}`)\n   192→          }\n   193→          if (intel?.engineering_culture) {\n   194→            highlights.push(`Culture: ${intel.engineering_culture.slice(0, 60)}...`)\n   195→          }\n   196→          if (jd?.tech_stack?.length > 0) {\n   197→            highlights.push(`Tech stack: ${jd.tech_stack.slice(0, 3).join(', ')}`)\n   198→          }\n   199→\n   200→          // Build concerns from red flags\n   201→          const concerns = jd?.red_flags || []\n   202→\n   203→          return (\n   204→            <div key={pipeline.id} className=\"card-hover\" style={{ background: 'var(--off-black)', border: `1px solid ${open ? 'rgba(201,168,76,0.2)' : 'var(--border)'}`, transition: 'border-color 0.3s' }}>\n   205→              {/* Header */}\n   206→              <button onClick={() => setExpanded(open ? null : pipeline.id)} style={{ width: '100%', textAlign: 'left', padding: '24px 28px', display: 'flex', alignItems: 'center', gap: 20, background: 'none', border: 'none', cursor: 'pointer', color: 'inherit' }}>\n   207→                <div style={{ width: 52, height: 52, display: 'flex', alignItems: 'center', justifyContent: 'center', border: `1px solid ${match >= 90 ? 'var(--gold)' : 'var(--border)'}`, flexShrink: 0 }}>\n   208→                  <span style={{ fontFamily: 'var(--serif)', fontSize: 20, color: match >= 90 ? 'var(--gold)' : 'var(--white)' }}>{match}</span>\n   209→                </div>\n   210→                <div style={{ flex: 1, minWidth: 0 }}>\n   211→                  <div style={{ display: 'flex', alignItems: 'center', gap: 8, marginBottom: 4 }}>\n   212→                    <span style={{ color: 'var(--white)', fontSize: 15, fontWeight: 400 }}>{role}</span>\n   213→                    <span className=\"tag\">{outreach ? 'outreach' : 'role'}</span>\n   214→                  </div>\n   215→                  <div style={{ display: 'flex', gap: 16, color: 'var(--muted)', fontSize: 13 }}>\n   216→                    <span style={{ display: 'flex', alignItems: 'center', gap: 4 }}><Building2 style={{ width: 12, height: 12 }} />{company}</span>\n   217→                    <span style={{ display: 'flex', alignItems: 'center', gap: 4 }}><MapPin style={{ width: 12, height: 12 }} />{location}</span>\n   218→                    <span style={{ display: 'flex', alignItems: 'center', gap: 4 }}><DollarSign style={{ width: 12, height: 12 }} />{salary}</span>\n   219→                  </div>\n   220→                </div>\n   221→                <div style={{ textAlign: 'right', flexShrink: 0 }}>\n   222→                  <p style={{ color: 'var(--white)', fontSize: 14, fontWeight: 400 }}>{user?.name || 'Candidate'}</p>\n   223→                  <p className=\"t-label\" style={{ marginTop: 2 }}>{formatRelativeTime(pipeline.created_at)}</p>\n   224→                </div>\n   225→              </button>\n   226→\n   227→              {/* Expanded */}\n   228→              {open && (\n   229→                <div className=\"fade-in\" style={{ padding: '24px 28px', borderTop: '1px solid var(--border)' }}>\n   230→                  {/* Match breakdown */}\n   231→                  {jd && (\n   232→                    <>\n   233→                      <div style={{ display: 'flex', alignItems: 'center', gap: 8, marginBottom: 16 }}>\n   234→                        <Sparkles style={{ width: 14, height: 14, color: 'var(--gold)' }} />\n   235→                        <span className=\"t-label-gold\">Match Breakdown</span>\n   236→                      </div>\n   237→                      <div style={{ display: 'flex', flexDirection: 'column', gap: 10, marginBottom: 28 }}>\n   238→                        {Object.entries(matchBreakdown).map(([k, v]) => <MatchBar key={k} label={k} value={v} />)}\n   239→                      </div>\n   240→                    </>\n   241→                  )}\n   242→\n   243→                  {/* Highlights */}\n   244→                  {highlights.length > 0 && (\n   245→                    <div style={{ marginBottom: 20 }}>\n   246→                      <span className=\"t-label\" style={{ color: 'var(--emerald)', marginBottom: 10, display: 'block' }}>Why this matches</span>\n   247→                      {highlights.map((h, i) => (\n   248→                        <div key={i} style={{ display: 'flex', gap: 8, marginBottom: 6, color: 'var(--muted)', fontSize: 14 }}>\n   249→                          <Check style={{ width: 14, height: 14, color: 'var(--emerald)', flexShrink: 0, marginTop: 3 }} />{h}\n   250→                        </div>\n   251→                      ))}\n   252→                    </div>\n   253→                  )}\n   254→\n   255→                  {/* Concerns */}\n   256→                  {concerns.length > 0 && (\n   257→                    <div style={{ marginBottom: 20 }}>\n   258→                      <span className=\"t-label\" style={{ color: 'var(--amber)', marginBottom: 10, display: 'block' }}>Concerns</span>\n   259→                      {concerns.map((c, i) => (\n   260→                        <div key={i} style={{ display: 'flex', gap: 8, color: 'var(--muted)', fontSize: 14 }}>\n   261→                          <span style={{ color: 'var(--amber)', flexShrink: 0, width: 14, textAlign: 'center' }}>!</span>{c}\n   262→                        </div>\n   263→                      ))}\n   264→                    </div>\n   265→                  )}\n   266→\n   267→                  {/* Contact info if available */}\n   268→                  {contact && (\n   269→                    <div style={{ marginBottom: 20, padding: 16, background: 'var(--surface)', border: '1px solid var(--border)' }}>\n   270→                      <span className=\"t-label\" style={{ marginBottom: 8, display: 'block' }}>Contact Found</span>\n   271→                      <p style={{ color: 'var(--white)', fontSize: 14 }}>{contact.name} — {contact.title}</p>\n   272→                      <p className=\"t-label\" style={{ marginTop: 4 }}>{contact.email}</p>\n   273→                    </div>\n   274→                  )}\n   275→\n   276→                  {/* Actions */}\n   277→                  <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', paddingTop: 16, borderTop: '1px solid var(--border)' }}>\n   278→                    <div style={{ display: 'flex', gap: 20 }}>\n   279→                      <span className=\"t-label\">Status: {pipeline.status}</span>\n   280→                      <span className=\"t-label\">Created {formatRelativeTime(pipeline.created_at)}</span>\n   281→                    </div>\n   282→                    <div style={{ display: 'flex', gap: 10 }}>\n   283→                      <button onClick={() => handleViewDetail(pipeline.id)} className=\"btn-ghost\" style={{ padding: '10px 16px', fontSize: 10, display: 'flex', alignItems: 'center', gap: 6 }}>\n   284→                        <ExternalLink style={{ width: 12, height: 12 }} /> View\n   285→                      </button>\n   286→                      <button\n   287→                        onClick={() => handleReject(pipeline.id)}\n   288→                        disabled={isLoading}\n   289→                        className=\"btn-ghost\"\n   290→                        style={{ padding: '10px 16px', fontSize: 10, borderColor: 'var(--rose)', color: 'var(--rose)', display: 'flex', alignItems: 'center', gap: 6, opacity: isLoading ? 0.5 : 1 }}\n   291→                      >\n   292→                        {isLoading ? <Loader2 style={{ width: 12, height: 12, animation: 'spin 1s linear infinite' }} /> : <X style={{ width: 12, height: 12 }} />} Skip\n   293→                      </button>\n   294→                      <button\n   295→                        onClick={() => handleApprove(pipeline.id)}\n   296→                        disabled={isLoading}\n   297→                        className=\"btn-primary\"\n   298→                        style={{ padding: '10px 16px', fontSize: 10, display: 'flex', alignItems: 'center', gap: 6, opacity: isLoading ? 0.5 : 1 }}\n   299→                      >\n   300→                        {isLoading ? <Loader2 style={{ width: 12, height: 12, animation: 'spin 1s linear infinite' }} /> : <Check style={{ width: 12, height: 12 }} />} Approve\n   301→                      </button>\n   302→                    </div>\n   303→                  </div>\n   304→                </div>\n   305→              )}\n   306→            </div>\n   307→          )\n   308→        })}\n   309→      </div>\n   310→    </div>\n   311→  )\n   312→}\n   313→"}]},"parent_tool_use_id":null,"session_id":"303fccaa-54a4-4459-b632-16d777db1b8d","uuid":"97b2f70c-0729-4270-9107-b33ead139857","tool_use_result":{"type":"update","filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/frontend/src/pages/ReviewQueue.jsx","content":"import { useState, useEffect, useCallback } from 'react'\nimport { useNavigate } from 'react-router-dom'\nimport { Check, X, ExternalLink, Building2, MapPin, DollarSign, Sparkles, AlertCircle, Loader2 } from 'lucide-react'\nimport { useAuth } from '../context/AuthContext'\nimport { listApplications, approveApplication, rejectApplication } from '../api/applications'\nimport { TalentAgentApiError } from '../api/client'\nimport { log } from '../lib/logger'\n\n/**\n * Format relative time from ISO date string.\n */\nfunction formatRelativeTime(isoDate) {\n  if (!isoDate) return ''\n  const date = new Date(isoDate)\n  const now = new Date()\n  const diffMs = now - date\n  const diffHours = Math.floor(diffMs / (1000 * 60 * 60))\n  const diffDays = Math.floor(diffHours / 24)\n\n  if (diffHours < 1) return 'just now'\n  if (diffHours < 24) return `${diffHours}h ago`\n  if (diffDays < 7) return `${diffDays}d ago`\n  if (diffDays < 30) return `${Math.floor(diffDays / 7)}w ago`\n  return `${Math.floor(diffDays / 30)}mo ago`\n}\n\n/**\n * Match breakdown bar component.\n */\nfunction MatchBar({ label, value }) {\n  return (\n    <div style={{ display: 'flex', alignItems: 'center', gap: 12 }}>\n      <span className=\"t-label\" style={{ width: 80, flexShrink: 0 }}>{label}</span>\n      <div style={{ flex: 1, height: 4, background: 'var(--surface)', overflow: 'hidden' }}>\n        <div style={{ width: `${value}%`, height: '100%', background: value >= 90 ? 'var(--gold)' : value >= 80 ? 'var(--gold-light)' : 'var(--muted)', transition: 'width 0.4s ease' }} />\n      </div>\n      <span style={{ fontFamily: 'var(--mono)', fontSize: 11, color: 'var(--white)', width: 32, textAlign: 'right' }}>{value}%</span>\n    </div>\n  )\n}\n\nexport default function ReviewQueue() {\n  const { user } = useAuth()\n  const navigate = useNavigate()\n  const [queue, setQueue] = useState([])\n  const [loading, setLoading] = useState(true)\n  const [error, setError] = useState(null)\n  const [expanded, setExpanded] = useState(null)\n  const [actionLoading, setActionLoading] = useState(null)\n\n  const fetchQueue = useCallback(async () => {\n    if (!user?.candidate_id) {\n      setLoading(false)\n      return\n    }\n\n    try {\n      const { pipelines } = await listApplications({\n        candidate_id: user.candidate_id,\n        status: 'AWAITING_REVIEW',\n      })\n      setQueue(pipelines || [])\n      setError(null)\n      // Auto-expand first item\n      if (pipelines?.length > 0 && !expanded) {\n        setExpanded(pipelines[0].id)\n      }\n      log.info('review_queue.fetch_success', { count: pipelines?.length || 0 })\n    } catch (err) {\n      if (err instanceof TalentAgentApiError) {\n        log.error('review_queue.fetch_error', { status: err.status, message: err.message })\n        setError(err.message)\n      } else {\n        log.error('review_queue.fetch_error', { error: String(err) })\n        setError('Failed to load review queue')\n      }\n    } finally {\n      setLoading(false)\n    }\n  }, [user?.candidate_id, expanded])\n\n  useEffect(() => {\n    fetchQueue()\n  }, [fetchQueue])\n\n  const handleApprove = async (pipelineId) => {\n    setActionLoading(pipelineId)\n    try {\n      await approveApplication(pipelineId)\n      setQueue(q => q.filter(item => item.id !== pipelineId))\n      log.info('review_queue.approved', { pipelineId })\n    } catch (err) {\n      if (err instanceof TalentAgentApiError) {\n        log.error('review_queue.approve_error', { status: err.status, message: err.message })\n        setError(err.message)\n      } else {\n        log.error('review_queue.approve_error', { error: String(err) })\n        setError('Failed to approve application')\n      }\n    } finally {\n      setActionLoading(null)\n    }\n  }\n\n  const handleReject = async (pipelineId) => {\n    setActionLoading(pipelineId)\n    try {\n      await rejectApplication(pipelineId)\n      setQueue(q => q.filter(item => item.id !== pipelineId))\n      log.info('review_queue.rejected', { pipelineId })\n    } catch (err) {\n      if (err instanceof TalentAgentApiError) {\n        log.error('review_queue.reject_error', { status: err.status, message: err.message })\n        setError(err.message)\n      } else {\n        log.error('review_queue.reject_error', { error: String(err) })\n        setError('Failed to reject application')\n      }\n    } finally {\n      setActionLoading(null)\n    }\n  }\n\n  const handleViewDetail = (pipelineId) => {\n    navigate(`/review-queue/${pipelineId}`)\n  }\n\n  if (loading) {\n    return (\n      <div className=\"fade-in\" style={{ display: 'flex', alignItems: 'center', justifyContent: 'center', minHeight: 300 }}>\n        <Loader2 style={{ width: 24, height: 24, color: 'var(--gold)', animation: 'spin 1s linear infinite' }} />\n      </div>\n    )\n  }\n\n  if (queue.length === 0 && !error) {\n    return (\n      <div className=\"fade-in\" style={{ maxWidth: 600, margin: '0 auto', textAlign: 'center', paddingTop: 80 }}>\n        <div style={{ width: 56, height: 56, borderRadius: '50%', border: '1px solid var(--gold)', display: 'flex', alignItems: 'center', justifyContent: 'center', margin: '0 auto 20px' }}>\n          <Check style={{ width: 22, height: 22, color: 'var(--gold)' }} />\n        </div>\n        <h2 className=\"t-serif\" style={{ fontSize: 22, marginBottom: 8 }}>All caught up</h2>\n        <p className=\"t-body\">No items pending review. The Discovery Engine will find more soon.</p>\n      </div>\n    )\n  }\n\n  return (\n    <div className=\"fade-in\" style={{ maxWidth: 900 }}>\n      {/* Error banner */}\n      {error && (\n        <div style={{ background: 'rgba(239, 68, 68, 0.1)', border: '1px solid var(--status-error)', padding: '16px 24px', marginBottom: 24, display: 'flex', alignItems: 'center', gap: 12 }}>\n          <AlertCircle style={{ width: 18, height: 18, color: 'var(--status-error)', flexShrink: 0 }} />\n          <p style={{ color: 'var(--status-error)', fontSize: 14 }}>{error}</p>\n        </div>\n      )}\n\n      <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 24 }}>\n        <p className=\"t-body\">Review AI-discovered matches before applications are sent.</p>\n        <span className=\"t-label-gold\">{queue.length} pending</span>\n      </div>\n\n      <div style={{ display: 'flex', flexDirection: 'column', gap: 16 }}>\n        {queue.map((pipeline) => {\n          const open = expanded === pipeline.id\n          const isLoading = actionLoading === pipeline.id\n\n          // Extract display data from pipeline\n          const jd = pipeline.parsed_jd\n          const intel = pipeline.company_intel\n          const contact = pipeline.contact\n          const outreach = pipeline.outreach_email\n\n          const role = jd?.seniority_level || 'Role'\n          const company = intel?.company_name || 'Company'\n          const location = 'Remote' // Would need to be in job data\n          const salary = jd?.compensation_range || 'Not specified'\n          const match = 85 // Placeholder - would need scoring\n\n          // Build match breakdown from parsed JD if available\n          const matchBreakdown = {\n            technical: jd ? 88 : 0,\n            culture: intel ? 85 : 0,\n            growth: 80,\n            compensation: jd?.compensation_range ? 90 : 50,\n          }\n\n          // Build highlights from parsed JD\n          const highlights = []\n          if (jd?.required_skills?.length > 0) {\n            highlights.push(`Required skills: ${jd.required_skills.slice(0, 3).join(', ')}`)\n          }\n          if (intel?.engineering_culture) {\n            highlights.push(`Culture: ${intel.engineering_culture.slice(0, 60)}...`)\n          }\n          if (jd?.tech_stack?.length > 0) {\n            highlights.push(`Tech stack: ${jd.tech_stack.slice(0, 3).join(', ')}`)\n          }\n\n          // Build concerns from red flags\n          const concerns = jd?.red_flags || []\n\n          return (\n            <div key={pipeline.id} className=\"card-hover\" style={{ background: 'var(--off-black)', border: `1px solid ${open ? 'rgba(201,168,76,0.2)' : 'var(--border)'}`, transition: 'border-color 0.3s' }}>\n              {/* Header */}\n              <button onClick={() => setExpanded(open ? null : pipeline.id)} style={{ width: '100%', textAlign: 'left', padding: '24px 28px', display: 'flex', alignItems: 'center', gap: 20, background: 'none', border: 'none', cursor: 'pointer', color: 'inherit' }}>\n                <div style={{ width: 52, height: 52, display: 'flex', alignItems: 'center', justifyContent: 'center', border: `1px solid ${match >= 90 ? 'var(--gold)' : 'var(--border)'}`, flexShrink: 0 }}>\n                  <span style={{ fontFamily: 'var(--serif)', fontSize: 20, color: match >= 90 ? 'var(--gold)' : 'var(--white)' }}>{match}</span>\n                </div>\n                <div style={{ flex: 1, minWidth: 0 }}>\n                  <div style={{ display: 'flex', alignItems: 'center', gap: 8, marginBottom: 4 }}>\n                    <span style={{ color: 'var(--white)', fontSize: 15, fontWeight: 400 }}>{role}</span>\n                    <span className=\"tag\">{outreach ? 'outreach' : 'role'}</span>\n                  </div>\n                  <div style={{ display: 'flex', gap: 16, color: 'var(--muted)', fontSize: 13 }}>\n                    <span style={{ display: 'flex', alignItems: 'center', gap: 4 }}><Building2 style={{ width: 12, height: 12 }} />{company}</span>\n                    <span style={{ display: 'flex', alignItems: 'center', gap: 4 }}><MapPin style={{ width: 12, height: 12 }} />{location}</span>\n                    <span style={{ display: 'flex', alignItems: 'center', gap: 4 }}><DollarSign style={{ width: 12, height: 12 }} />{salary}</span>\n                  </div>\n                </div>\n                <div style={{ textAlign: 'right', flexShrink: 0 }}>\n                  <p style={{ color: 'var(--white)', fontSize: 14, fontWeight: 400 }}>{user?.name || 'Candidate'}</p>\n                  <p className=\"t-label\" style={{ marginTop: 2 }}>{formatRelativeTime(pipeline.created_at)}</p>\n                </div>\n              </button>\n\n              {/* Expanded */}\n              {open && (\n                <div className=\"fade-in\" style={{ padding: '24px 28px', borderTop: '1px solid var(--border)' }}>\n                  {/* Match breakdown */}\n                  {jd && (\n                    <>\n                      <div style={{ display: 'flex', alignItems: 'center', gap: 8, marginBottom: 16 }}>\n                        <Sparkles style={{ width: 14, height: 14, color: 'var(--gold)' }} />\n                        <span className=\"t-label-gold\">Match Breakdown</span>\n                      </div>\n                      <div style={{ display: 'flex', flexDirection: 'column', gap: 10, marginBottom: 28 }}>\n                        {Object.entries(matchBreakdown).map(([k, v]) => <MatchBar key={k} label={k} value={v} />)}\n                      </div>\n                    </>\n                  )}\n\n                  {/* Highlights */}\n                  {highlights.length > 0 && (\n                    <div style={{ marginBottom: 20 }}>\n                      <span className=\"t-label\" style={{ color: 'var(--emerald)', marginBottom: 10, display: 'block' }}>Why this matches</span>\n                      {highlights.map((h, i) => (\n                        <div key={i} style={{ display: 'flex', gap: 8, marginBottom: 6, color: 'var(--muted)', fontSize: 14 }}>\n                          <Check style={{ width: 14, height: 14, color: 'var(--emerald)', flexShrink: 0, marginTop: 3 }} />{h}\n                        </div>\n                      ))}\n                    </div>\n                  )}\n\n                  {/* Concerns */}\n                  {concerns.length > 0 && (\n                    <div style={{ marginBottom: 20 }}>\n                      <span className=\"t-label\" style={{ color: 'var(--amber)', marginBottom: 10, display: 'block' }}>Concerns</span>\n                      {concerns.map((c, i) => (\n                        <div key={i} style={{ display: 'flex', gap: 8, color: 'var(--muted)', fontSize: 14 }}>\n                          <span style={{ color: 'var(--amber)', flexShrink: 0, width: 14, textAlign: 'center' }}>!</span>{c}\n                        </div>\n                      ))}\n                    </div>\n                  )}\n\n                  {/* Contact info if available */}\n                  {contact && (\n                    <div style={{ marginBottom: 20, padding: 16, background: 'var(--surface)', border: '1px solid var(--border)' }}>\n                      <span className=\"t-label\" style={{ marginBottom: 8, display: 'block' }}>Contact Found</span>\n                      <p style={{ color: 'var(--white)', fontSize: 14 }}>{contact.name} — {contact.title}</p>\n                      <p className=\"t-label\" style={{ marginTop: 4 }}>{contact.email}</p>\n                    </div>\n                  )}\n\n                  {/* Actions */}\n                  <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', paddingTop: 16, borderTop: '1px solid var(--border)' }}>\n                    <div style={{ display: 'flex', gap: 20 }}>\n                      <span className=\"t-label\">Status: {pipeline.status}</span>\n                      <span className=\"t-label\">Created {formatRelativeTime(pipeline.created_at)}</span>\n                    </div>\n                    <div style={{ display: 'flex', gap: 10 }}>\n                      <button onClick={() => handleViewDetail(pipeline.id)} className=\"btn-ghost\" style={{ padding: '10px 16px', fontSize: 10, display: 'flex', alignItems: 'center', gap: 6 }}>\n                        <ExternalLink style={{ width: 12, height: 12 }} /> View\n                      </button>\n                      <button\n                        onClick={() => handleReject(pipeline.id)}\n                        disabled={isLoading}\n                        className=\"btn-ghost\"\n                        style={{ padding: '10px 16px', fontSize: 10, borderColor: 'var(--rose)', color: 'var(--rose)', display: 'flex', alignItems: 'center', gap: 6, opacity: isLoading ? 0.5 : 1 }}\n                      >\n                        {isLoading ? <Loader2 style={{ width: 12, height: 12, animation: 'spin 1s linear infinite' }} /> : <X style={{ width: 12, height: 12 }} />} Skip\n                      </button>\n                      <button\n                        onClick={() => handleApprove(pipeline.id)}\n                        disabled={isLoading}\n                        className=\"btn-primary\"\n                        style={{ padding: '10px 16px', fontSize: 10, display: 'flex', alignItems: 'center', gap: 6, opacity: isLoading ? 0.5 : 1 }}\n                      >\n                        {isLoading ? <Loader2 style={{ width: 12, height: 12, animation: 'spin 1s linear infinite' }} /> : <Check style={{ width: 12, height: 12 }} />} Approve\n                      </button>\n                    </div>\n                  </div>\n                </div>\n              )}\n            </div>\n          )\n        })}\n      </div>\n    </div>\n  )\n}\n","structuredPatch":[{"oldStart":1,"oldLines":36,"newStart":1,"newLines":32,"lines":["-import { useState } from 'react'","-import { Check, X, ExternalLink, Building2, MapPin, DollarSign, Sparkles } from 'lucide-react'","+import { useState, useEffect, useCallback } from 'react'","+import { useNavigate } from 'react-router-dom'","+import { Check, X, ExternalLink, Building2, MapPin, DollarSign, Sparkles, AlertCircle, Loader2 } from 'lucide-react'","+import { useAuth