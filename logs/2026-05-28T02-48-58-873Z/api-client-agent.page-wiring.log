', type: 'outreach',","-  },","-]","+/**","+ * Format relative time from ISO date string.","+ */","+function formatRelativeTime(isoDate) {","+  if (!isoDate) return ''","+  const date = new Date(isoDate)","+  const now = new Date()","+  const diffMs = now - date","+  const diffHours = Math.floor(diffMs / (1000 * 60 * 60))","+  const diffDays = Math.floor(diffHours / 24)"," ","+  if (diffHours < 1) return 'just now'","+  if (diffHours < 24) return `${diffHours}h ago`","+  if (diffDays < 7) return `${diffDays}d ago`","+  if (diffDays < 30) return `${Math.floor(diffDays / 7)}w ago`","+  return `${Math.floor(diffDays / 30)}mo ago`","+}","+","+/**","+ * Match breakdown bar component.","+ */"," function MatchBar({ label, value }) {","   return (","     <div style={{ display: 'flex', alignItems: 'center', gap: 12 }}>"]},{"oldStart":44,"oldLines":13,"newStart":40,"newLines":101,"lines":[" }"," "," export default function ReviewQueue() {","-  const [queue, setQueue] = useState(mockQueue)","-  const [expanded, setExpanded] = useState(queue[0]?.id || null)","+  const { user } = useAuth()","+  const navigate = useNavigate()","+  const [queue, setQueue] = useState([])","+  const [loading, setLoading] = useState(true)","+  const [error, setError] = useState(null)","+  const [expanded, setExpanded] = useState(null)","+  const [actionLoading, setActionLoading] = useState(null)"," ","-  const remove = (id) => setQueue(q => q.filter(item => item.id !== id))","+  const fetchQueue = useCallback(async () => {","+    if (!user?.candidate_id) {","+      setLoading(false)","+      return","+    }"," ","-  if (queue.length === 0) {","+    try {","+      const { pipelines } = await listApplications({","+        candidate_id: user.candidate_id,","+        status: 'AWAITING_REVIEW',","+      })","+      setQueue(pipelines || [])","+      setError(null)","+      // Auto-expand first item","+      if (pipelines?.length > 0 && !expanded) {","+        setExpanded(pipelines[0].id)","+      }","+   