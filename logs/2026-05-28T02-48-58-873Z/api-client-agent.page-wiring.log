loper tooling — built internal platform', 'Open source valued — 2K+ GitHub stars', 'Fully remote matches pref'],\n    29→    concerns: ['Smaller company — candidate prefers larger orgs'],\n    30→    source: 'Company website', discovered: '5h ago', type: 'outreach',\n    31→  },\n    32→]\n    33→\n    34→function MatchBar({ label, value }) {\n    35→  return (\n    36→    <div style={{ display: 'flex', alignItems: 'center', gap: 12 }}>\n    37→      <span className=\"t-label\" style={{ width: 80, flexShrink: 0 }}>{label}</span>\n    38→      <div style={{ flex: 1, height: 4, background: 'var(--surface)', overflow: 'hidden' }}>\n    39→        <div style={{ width: `${value}%`, height: '100%', background: value >= 90 ? 'var(--gold)' : value >= 80 ? 'var(--gold-light)' : 'var(--muted)', transition: 'width 0.4s ease' }} />\n    40→      </div>\n    41→      <span style={{ fontFamily: 'var(--mono)', fontSize: 11, color: 'var(--white)', width: 32, textAlign: 'right' }}>{value}%</span>\n    42→    </div>\n    43→  )\n    44→}\n    45→\n    46→export default function ReviewQueue() {\n    47→  const [queue, setQueue] = useState(mockQueue)\n    48→  const [expanded, setExpanded] = useState(queue[0]?.id || null)\n    49→\n    50→  const remove = (id) => setQueue(q => q.filter(item => item.id !== id))\n    51→\n    52→  if (queue.length === 0) {\n    53→    return (\n    54→      <div className=\"fade-in\" style={{ maxWidth: 600, margin: '0 auto', textAlign: 'center', paddingTop: 80 }}>\n    55→        <div style={{ width: 56, height: 56, borderRadius: '50%', border: '1px solid var(--gold)', display: 'flex', alignItems: 'center', justifyContent: 'center', margin: '0 auto 20px' }}>\n    56→          <Check style={{ width: 22, height: 22, color: 'var(--gold)' }} />\n    57→        </div>\n    58→        <h2 className=\"t-serif\" style={{ fontSize: 22, marginBottom: 8 }}>All caught up</h2>\n    59→        <p className=\"t-body\">No items pending review. The Discovery Engine will 