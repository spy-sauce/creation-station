{"t":"2026-05-28T02:53:56.488Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QEtpsW6Tesxy6EWu3isbqj","type":"tool_result","content":"     1→/**\n     2→ * API client for Talent Agent backend.\n     3→ * Single apiClient instance with auth header injection and error normalization.\n     4→ *\n     5→ * Per NUTRIENTS.md §ITER-4 CONTRACT EXTENSIONS:\n     6→ * - Symbol: apiClient owned by api-client-agent\n     7→ * - Symbol: TalentAgentApiError owned by api-client-agent\n     8→ * - JWT storage key: talent-agent-jwt\n     9→ * - Base URL: VITE_API_BASE_URL\n    10→ *\n    11→ * @license Apache-2.0\n    12→ * @copyright VibeSpace LLC\n    13→ */\n    14→\n    15→import { routes } from '../lib/routes'\n    16→\n    17→// ─── Constants ────────────────────────────────────────────────────────────────\n    18→\n    19→/**\n    20→ * Storage key for JWT in localStorage.\n    21→ * Per NUTRIENTS.md DATA_CONTRACTS: storageKey: 'talent-agent-jwt'\n    22→ */\n    23→const JWT_STORAGE_KEY = 'talent-agent-jwt'\n    24→\n    25→/**\n    26→ * Base URL for API requests.\n    27→ * Per NUTRIENTS.md: Env vars use VITE_* prefix per Vite's import.meta.env convention.\n    28→ */\n    29→const API_BASE_URL = import.meta.env.VITE_API_BASE_URL || '/api/v1'\n    30→\n    31→// ─── Types ────────────────────────────────────────────────────────────────────\n    32→\n    33→/**\n    34→ * Error data structure for API errors.\n    35→ * Per NUTRIENTS.md DATA_CONTRACTS §API Client Domain.\n    36→ */\n    37→export interface TalentAgentApiErrorData {\n    38→  /** HTTP status code */\n    39→  status: number\n    40→  /** Backend error code if present */\n    41→  code: string\n    42→  /** User-facing message */\n    43→  message: string\n    44→}\n    45→\n    46→/**\n    47→ * Request options for API client.\n    48→ */\n    49→interface ApiRequestOptions extends Omit<RequestInit, 'body'> {\n    50→  /** Request body — will be JSON.stringify'd unless FormData */\n    51→  body?: unknown\n    52→  /** Skip auth header injection */\n    53→  skipAuth?: boolean\n    54→}\n    55→\n    56→// ─── Error Class ──────────────────────────────────────────────────────────────\n    57→\n    58→/**\n    59→ * Custom error class for API errors.\n    60→ * Per HYPHA-API-CLIENT: includes status, code, message.\n    61→ */\n    62→export class TalentAgentApiError extends Error {\n    63→  public readonly status: number\n    64→  public readonly code: string\n    65→\n    66→  constructor(data: TalentAgentApiErrorData) {\n    67→    super(data.message)\n    68→    this.name = 'TalentAgentApiError'\n    69→    this.status = data.status\n    70→    this.code = data.code\n    71→  }\n    72→\n    73→  /**\n    74→   * Get error data as plain object.\n    75→   */\n    76→  toJSON(): TalentAgentApiErrorData {\n    77→    return {\n    78→      status: this.status,\n    79→      code: this.code,\n    80→      message: this.message,\n    81→    }\n    82→  }\n    83→}\n    84→\n    85→// ─── JWT Helpers ──────────────────────────────────────────────────────────────\n    86→\n    87→/**\n    88→ * Get the stored JWT token.\n    89→ */\n    90→export function getToken(): string | null {\n    91→  return localStorage.getItem(JWT_STORAGE_KEY)\n    92→}\n    93→\n    94→/**\n    95→ * Store a JWT token.\n    96→ */\n    97→export function setToken(token: string): void {\n    98→  localStorage.setItem(JWT_STORAGE_KEY, token)\n    99→}\n   100→\n   101→/**\n   102→ * Clear stored JWT.\n   103→ * Per HYPHA-API-CLIENT: 401 handling invalidates JWT.\n   104→ */\n   105→export function clearToken(): void {\n   106→  localStorage.removeItem(JWT_STORAGE_KEY)\n   107→}\n   108→\n   109→// ─── API Client ───────────────────────────────────────────────────────────────\n   110→\n   111→/**\n   112→ * Single API client instance for all backend requests.\n   113→ * Per NUTRIENTS.md: All API calls go through this client.\n   114→ */\n   115→export const apiClient = {\n   116→  /**\n   117→   * Get the base URL for API requests.\n   118→   */\n   119→  get baseUrl(): string {\n   120→    return API_BASE_URL\n   121→  },\n   122→\n   123→  /**\n   124→   * Make an authenticated request to the API.\n   125→   *\n   126→   * Features:\n   127→   * - Auto-injects Authorization: Bearer header if JWT exists\n   128→   * - Handles 401 by invalidating JWT and redirecting to /login\n   129→   * - Normalizes errors to TalentAgentApiError\n   130→   * - Handles FormData bodies correctly (no JSON.stringify, no Content-Type)\n   131→   *\n   132→   * @param path - API path (e.g., '/auth/me')\n   133→   * @param options - Request options\n   134→   * @returns Parsed JSON response\n   135→   * @throws TalentAgentApiError on API errors\n   136→   */\n   137→  async request<T>(path: string, options: ApiRequestOptions = {}): Promise<T> {\n   138→    const { body, skipAuth = false, ...fetchOptions } = options\n   139→\n   140→    // Build headers\n   141→    const headers = new Headers(fetchOptions.headers)\n   142→\n   143→    // Inject auth header if token exists and not skipped\n   144→    if (!skipAuth) {\n   145→      const token = getToken()\n   146→      if (token) {\n   147→        headers.set('Authorization', `Bearer ${token}`)\n   148→      }\n   149→    }\n   150→\n   151→    // Prepare body\n   152→    let requestBody: BodyInit | undefined\n   153→\n   154→    if (body !== undefined) {\n   155→      if (body instanceof FormData) {\n   156→        // FormData: browser sets Content-Type with boundary\n   157→        requestBody = body\n   158→      } else {\n   159→        // JSON body\n   160→        headers.set('Content-Type', 'application/json')\n   161→        requestBody = JSON.stringify(body)\n   162→      }\n   163→    }\n   164→\n   165→    // Make request\n   166→    const url = `${API_BASE_URL}${path}`\n   167→    let response: Response\n   168→\n   169→    try {\n   170→      response = await fetch(url, {\n   171→        ...fetchOptions,\n   172→        headers,\n   173→        body: requestBody,\n   174→      })\n   175→    } catch (error) {\n   176→      // Network error (backend down, CORS, etc.)\n   177→      throw new TalentAgentApiError({\n   178→        status: 0,\n   179→        code: 'NETWORK_ERROR',\n   180→        message: 'Unable to connect to server. Please check your connection.',\n   181→      })\n   182→    }\n   183→\n   184→    // Handle 401 — invalidate JWT, redirect to login\n   185→    if (response.status === 401) {\n   186→      clearToken()\n   187→      // Redirect to login\n   188→      window.location.href = routes.login\n   189→      throw new TalentAgentApiError({\n   190→        status: 401,\n   191→        code: 'UNAUTHORIZED',\n   192→        message: 'Session expired. Please log in again.',\n   193→      })\n   194→    }\n   195→\n   196→    // Handle error responses\n   197→    if (!response.ok) {\n   198→      let errorData: { detail?: string; code?: string } = {}\n   199→      try {\n   200→        errorData = await response.json()\n   201→      } catch {\n   202→        // Response body is not JSON\n   203→      }\n   204→\n   205→      throw new TalentAgentApiError({\n   206→        status: response.status,\n   207→        code: errorData.code || `HTTP_${response.status}`,\n   208→        message: errorData.detail || `Request failed with status ${response.status}`,\n   209→      })\n   210→    }\n   211→\n   212→    // Parse successful response\n   213→    // Handle 204 No Content\n   214→    if (response.status === 204) {\n   215→      return undefined as T\n   216→    }\n   217→\n   218→    return response.json()\n   219→  },\n   220→\n   221→  /**\n   222→   * GET request shorthand.\n   223→   */\n   224→  async get<T>(path: string, options?: Omit<ApiRequestOptions, 'method' | 'body'>): Promise<T> {\n   225→    return this.request<T>(path, { ...options, method: 'GET' })\n   226→  },\n   227→\n   228→  /**\n   229→   * POST request shorthand.\n   230→   */\n   231→  async post<T>(path: string, body?: unknown, options?: Omit<ApiRequestOptions, 'method' | 'body'>): Promise<T> {\n   232→    return this.request<T>(path, { ...options, method: 'POST', body })\n   233→  },\n   234→\n   235→  /**\n   236→   * PUT request shorthand.\n   237→   */\n   238→  async put<T>(path: string, body?: unknown, options?: Omit<ApiRequestOptions, 'method' | 'body'>): Promise<T> {\n   239→    return this.request<T>(path, { ...options, method: 'PUT', body })\n   240→  },\n   241→\n   242→  /**\n   243→   * DELETE request shorthand.\n   244→   */\n   245→  async delete<T>(path: string, options?: Omit<ApiRequestOptions, 'method' | 'body'>): Promise<T> {\n   246→    return this.request<T>(path, { ...options, method: 'DELETE' })\n   247→  },\n   248→\n   249→  /**\n   250→   * PATCH request shorthand.\n   251→   */\n   252→  async patch<T>(path: string, body?: unknown, options?: Omit<ApiRequestOptions, 'method' | 'body'>): Promise<T> {\n   253→    return this.request<T>(path, { ...options, method: 'PATCH', body })\n   254→  },\n   255→}\n   256→\n   257→// ─── Default Export ───────────────────────────────────────────────────────────\n   258→\n   259→export default apiClient\n   260→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"b8d8d05c-20df-4d2f-a950-47ef33f8a5eb","uuid":"91dc29a7-159e-456b-8ffd-3979e2bc9782","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/frontend/src/api/client.ts","content":"/**\n * API client for Talent Agent backend.\n * Single apiClient instance with auth header injection and error normalization.\n *\n * Per NUTRIENTS.md §ITER-4 CONTRACT EXTENSIONS:\n * - Symbol: apiClient owned by api-client-agent\n * - Symbol: TalentAgentApiError owned by api-client-agent\n * - JWT storage key: talent-agent-jwt\n * - Base URL: VITE_API_BASE_URL\n *\n * @license Apache-2.0\n * @copyright VibeSpace LLC\n */\n\nimport { routes } from '../lib/routes'\n\n// ─── Constants ────────────────────────────────────────────────────────────────\n\n/**\n * Storage key for JWT in localStorage.\n * Per NUTRIENTS.md DATA_CONTRACTS: storageKey: 'talent-agent-jwt'\n */\nconst JWT_STORAGE_KEY = 'talent-agent-jwt'\n\n/**\n * Base URL for API requests.\n * Per NUTRIENTS.md: Env vars use VITE_* prefix per Vite's import.meta.env convention.\n */\nconst API_BASE_URL = import.meta.env.VITE_API_BASE_URL || '/api/v1'\n\n// ─── Types ────────────────────────────────────────────────────────────────────\n\n/**\n * Error data structure for API errors.\n * Per NUTRIENTS.md DATA_CONTRACTS §API Client Domain.\n */\nexport interface TalentAgentApiErrorData {\n  /** HTTP status code */\n  status: number\n  /** Backend error code if present */\n  code: string\n  /** User-facing message */\n  message: string\n}\n\n/**\n * Request options for API client.\n */\ninterface ApiRequestOptions extends Omit<RequestInit, 'body'> {\n  /** Request body — will be JSON.stringify'd unless FormData */\n  body?: unknown\n  /** Skip auth header injection */\n  skipAuth?: boolean\n}\n\n// ─── Error Class ──────────────────────────────────────────────────────────────\n\n/**\n * Custom error class for API errors.\n * Per HYPHA-API-CLIENT: includes status, code, message.\n */\nexport class TalentAgentApiError extends Error {\n  public readonly status: number\n  public readonly code: string\n\n  constructor(data: TalentAgentApiErrorData) {\n    super(data.message)\n    this.name = 'TalentAgentApiError'\n    this.status = data.status\n    this.code = data.code\n  }\n\n  /**\n   * Get error data as plain object.\n   */\n  toJSON(): TalentAgentApiErrorData {\n    return {\n      status: this.status,\n      code: this.code,\n      message: this.message,\n    }\n  }\n}\n\n// ─── JWT Helpers ──────────────────────────────────────────────────────────────\n\n/**\n * Get the stored JWT token.\n */\nexport function getToken(): string | null {\n  return localStorage.getItem(JWT_STORAGE_KEY)\n}\n\n/**\n * Store a JWT token.\n */\nexport function setToken(token: string): void {\n  localStorage.setItem(JWT_STORAGE_KEY, token)\n}\n\n/**\n * Clear stored JWT.\n * Per HYPHA-API-CLIENT: 401 handling invalidates JWT.\n */\nexport function clearToken(): void {\n  localStorage.removeItem(JWT_STORAGE_KEY)\n}\n\n// ─── API Client ───────────────────────────────────────────────────────────────\n\n/**\n * Single API client instance for all backend requests.\n * Per NUTRIENTS.md: All API calls go through this client.\n */\nexport const apiClient = {\n  /**\n   * Get the base URL for API requests.\n   */\n  get baseUrl(): string {\n    return API_BASE_URL\n  },\n\n  /**\n   * Make an authenticated request to the API.\n   *\n   * Features:\n   * - Auto-injects Authorization: Bearer header if JWT exists\n   * - Handles 401 by invalidating JWT and redirecting to /login\n   * - Normalizes errors to TalentAgentApiError\n   * - Handles FormData bodies correctly (no JSON.stringify, no Content-Type)\n   *\n   * @param path - API path (e.g., '/auth/me')\n   * @param options - Request options\n   * @returns Parsed JSON response\n   * @throws TalentAgentApiError on API errors\n   */\n  async request<T>(path: string, options: ApiRequestOptions = {}): Promise<T> {\n    const { body, skipAuth = false, ...fetchOptions } = options\n\n    // Build headers\n    const headers = new Headers(fetchOptions.headers)\n\n    // Inject auth header if token exists and not skipped\n    if (!skipAuth) {\n      const token = getToken()\n      if (token) {\n        headers.set('Authorization', `Bearer ${token}`)\n      }\n    }\n\n    // Prepare body\n    let requestBody: BodyInit | undefined\n\n    if (body !== undefined) {\n      if (body instanceof FormData) {\n        // FormData: browser sets Content-Type with boundary\n        requestBody = body\n      } else {\n        // JSON body\n        headers.set('Content-Type', 'application/json')\n        requestBody = JSON.stringify(body)\n      }\n    }\n\n    // Make request\n    const url = `${API_BASE_URL}${path}`\n    let response: Response\n\n    try {\n      response = await fetch(url, {\n        ...fetchOptions,\n        headers,\n        body: requestBody,\n      })\n    } catch (error) {\n      // Network error (backend down, CORS, etc.)\n      throw new TalentAgentApiError({\n        status: 0,\n        code: 'NETWORK_ERROR',\n        message: 'Unable to connect to server. Please check your connection.',\n      })\n    }\n\n    // Handle 401 — invalidate JWT, redirect to login\n    if (response.status === 401) {\n      clearToken()\n      // Redirect to login\n      window.location.href = routes.login\n      throw new TalentAgentApiError({\n        status: 401,\n        code: 'UNAUTHORIZED',\n        message: 'Session expired. Please log in again.',\n      })\n    }\n\n    // Handle error responses\n    if (!response.ok) {\n      let errorData: { detail?: string; code?: string } = {}\n      try {\n        errorData = await response.json()\n      } catch {\n        // Response body is not JSON\n      }\n\n      throw new TalentAgentApiError({\n        status: response.status,\n        code: errorData.code || `HTTP_${response.status}`,\n        message: errorData.detail || `Request failed with status ${response.status}`,\n      })\n    }\n\n    // Parse successful response\n    // Handle 204 No Content\n    if (response.status === 204) {\n      return undefined as T\n    }\n\n    return response.json()\n  },\n\n  /**\n   * GET request shorthand.\n   */\n  async get<T>(path: string, options?: Omit<ApiRequestOptions, 'method' | 'body'>): Promise<T> {\n    return this.request<T>(path, { ...options, method: 'GET' })\n  },\n\n  /**\n   * POST request shorthand.\n   */\n  async post<T>(path: string, body?: unknown, options?: Omit<ApiRequestOptions, 'method' | 'body'>): Promise<T> {\n    return this.request<T>(path, { ...options, method: 'POST', body })\n  },\n\n  /**\n   * PUT request shorthand.\n   */\n  async put<T>(path: string, body?: unknown, options?: Omit<ApiRequestOptions, 'method' | 'body'>): Promise<T> {\n    return this.request<T>(path, { ...options, method: 'PUT', body })\n  },\n\n  /**\n   * DELETE request shorthand.\n   */\n  async delete<T>(path: string, options?: Omit<ApiRequestOptions, 'method' | 'body'>): Promise<T> {\n    return this.request<T>(path, { ...options, method: 'DELETE' })\n  },\n\n  /**\n   * PATCH request shorthand.\n   */\n  async patch<T>(path: string, body?: unknown, options?: Omit<ApiRequestOptions, 'method' | 'body'>): Promise<T> {\n    return this.request<T>(path, { ...options, method: 'PATCH', body })\n  },\n}\n\n// ─── Default Export ───────────────────────────────────────────────────────────\n\nexport default apiClient\n","numLines":260,"startLine":1,"totalLines":260}}}}
