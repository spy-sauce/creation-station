tr] = Field(default_factory=list)\n    96→    excluded_industries: list[str] = Field(default_factory=list)\n    97→    location_filters: list[str] = Field(default_factory=list)\n    98→    remote_preference: str = \"flexible\"\n    99→    min_compensation: Optional[int] = None\n   100→\n   101→\n   102→# ─── Discovered Job ───────────────────────────────────────────────────────────\n   103→\n   104→\n   105→class DiscoveredJobSchema(BaseModel):\n   106→    \"\"\"\n   107→    Raw job data from a crawl — before scoring.\n   108→\n   109→    Matches NUTRIENTS.md DATA_CONTRACTS.DiscoveredJob.\n   110→    \"\"\"\n   111→\n   112→    model_config = ConfigDict(from_attributes=True)\n   113→\n   114→    id: Optional[UUID] = None\n   115→    source: str\n   116→    source_id: str\n   117→    title: str\n   118→    company: str\n   119→    location: Optional[str] = None\n   120→    description: Optional[str] = None\n   121→    url: str\n   122→    posted_at: Optional[datetime] = None\n   123→    salary_min: Optional[int] = None\n   124→    salary_max: Optional[int] = None\n   125→    remote: bool = False\n   126→    crawled_at: Optional[datetime] = None\n   127→\n   128→\n   129→# ─── Score Breakdown ─────────────────────────────────────────────────────────\n   130→\n   131→\n   132→class ScoreBreakdown(BaseModel):\n   133→    \"\"\"\n   134→    Dimension-level score breakdown (0-100 per dimension).\n   135→\n   136→    Matches NUTRIENTS.md DATA_CONTRACTS.ScoreBreakdown.\n   137→    \"\"\"\n   138→\n   139→    model_config = ConfigDict(from_attributes=True)\n   140→\n   141→    technical_match: int = Field(ge=0, le=100)\n   142→    level_match: int = Field(ge=0, le=100)\n   143→    culture_match: int = Field(ge=0, le=100)\n   144→    industry_match: int = Field(ge=0, le=100)\n   145→    growth_potential: int = Field(ge=0, le=100)\n   146→    compensation_match: int = Field(ge=0, le=100)\n   147→\n   148→    @computed_field\n   149→    @property\n   150→    def composite(self)