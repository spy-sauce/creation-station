{"t":"2026-05-20T21:27:34.860Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015EPDe3jx4ftaUfS9xPPKdf","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Relevance Scorer — scores each discovered job against the candidate's identity profile.\n     6→\n     7→Scoring dimensions (each 0–100):\n     8→  technical_match   30%  — skills overlap between JD and candidate profile\n     9→  level_match       20%  — seniority alignment (penalise over AND under)\n    10→  culture_match     15%  — startup/enterprise, remote, mission alignment\n    11→  industry_match    15%  — domain expertise alignment\n    12→  growth_potential  10%  — does this expand the candidate's trajectory?\n    13→  compensation_match 10% — estimated band vs candidate target\n    14→\n    15→Claude parses the JD. Math runs locally. Claude writes 2-sentence reasoning.\n    16→\"\"\"\n    17→\n    18→import json\n    19→import re\n    20→from datetime import datetime, timezone\n    21→from uuid import UUID, uuid4\n    22→\n    23→import structlog\n    24→from anthropic import AsyncAnthropic\n    25→from tenacity import retry, stop_after_attempt, wait_exponential\n    26→\n    27→from backend.agents.discovery.schemas import (\n    28→    IdentityProfileSchema,\n    29→    DiscoveredJobSchema,\n    30→    ScoredJobSchema,\n    31→    ScoreBreakdown,\n    32→)\n    33→\n    34→logger = structlog.get_logger(__name__)\n    35→\n    36→# Seniority levels for level_match scoring — lower index = more junior\n    37→_SENIORITY_LADDER = [\n    38→    \"intern\",\n    39→    \"junior\",\n    40→    \"associate\",\n    41→    \"mid\",\n    42→    \"senior\",\n    43→    \"staff\",\n    44→    \"principal\",\n    45→    \"lead\",\n    46→    \"manager\",\n    47→    \"director\",\n    48→    \"vp\",\n    49→    \"svp\",\n    50→    \"head\",\n    51→    \"cto\",\n    52→    \"coo\",\n    53→    \"ceo\",\n    54→    \"founder\",\n    55→    \"exec\",\n    56→    \"c-level\",\n    57→]\n    58→\n    59→_LEADERSHIP_TO_LADDER = {\n    60→    \"IC\": \"senior\",\n    61→    \"Lead\": \"lead\",\n    62→    \"Manager\": \"manager\",\n    63→    \"Director\": \"director\",\n    64→    \"VP\": \"vp\",\n    65→    \"C-Level\": \"cto\",\n    66→}\n    67→\n    68→\n    69→class RelevanceScorer:\n    70→    \"\"\"\n    71→    Scores discovered jobs against a candidate's identity profile.\n    72→\n    73→    Uses Claude to parse JD requirements and generate reasoning.\n    74→    Scoring math runs locally — no LLM needed for the numbers.\n    75→    \"\"\"\n    76→\n    77→    def __init__(self, anthropic_client: AsyncAnthropic):\n    78→        \"\"\"\n    79→        Initialize the RelevanceScorer.\n    80→\n    81→        Args:\n    82→            anthropic_client: Async Anthropic client for Claude API\n    83→        \"\"\"\n    84→        self._claude = anthropic_client\n    85→\n    86→    async def score_batch(\n    87→        self,\n    88→        jobs: list[DiscoveredJobSchema],\n    89→        profile: IdentityProfileSchema,\n    90→        candidate_id: UUID,\n    91→        min_score: int = 60,\n    92→    ) -> list[ScoredJobSchema]:\n    93→        \"\"\"\n    94→        Score a batch of discovered jobs, filtering out those below min_score.\n    95→\n    96→        Args:\n    97→            jobs: Raw discovered jobs to score\n    98→            profile: Candidate identity profile\n    99→            candidate_id: Candidate UUID for scored job records\n   100→            min_score: Jobs below this composite score are discarded\n   101→\n   102→        Returns:\n   103→            Sorted list of ScoredJobSchema, highest composite first\n   104→        \"\"\"\n   105→        logger.info(\n   106→            \"relevance_scorer.batch_start\",\n   107→            job_count=len(jobs),\n   108→            min_score=min_score,\n   109→        )\n   110→\n   111→        scored: list[ScoredJobSchema] = []\n   112→        for job in jobs:\n   113→            try:\n   114→                result = await self.score_job(job, profile, candidate_id)\n   115→                if result.composite_score >= min_score:\n   116→                    scored.append(result)\n   117→            except Exception as e:\n   118→                logger.error(\n   119→                    \"relevance_scorer.job_error\",\n   120→                    job_url=job.url,\n   121→                    error=str(e),\n   122→                )\n   123→\n   124→        scored.sort(key=lambda s: s.composite_score, reverse=True)\n   125→        logger.info(\n   126→            \"relevance_scorer.batch_complete\",\n   127→            scored=len(scored),\n   128→            filtered_out=len(jobs) - len(scored),\n   129→        )\n   130→        return scored\n   131→\n   132→    async def score_job(\n   133→        self,\n   134→        job: DiscoveredJobSchema,\n   135→        profile: IdentityProfileSchema,\n   136→        candidate_id: UUID,\n   137→    ) -> ScoredJobSchema:\n   138→        \"\"\"\n   139→        Score a single job against the identity profile.\n   140→\n   141→        Args:\n   142→            job: Discovered job\n   143→            profile: Candidate identity profile\n   144→            candidate_id: Candidate UUID\n   145→\n   146→        Returns:\n   147→            ScoredJobSchema with full breakdown and reasoning\n   148→        \"\"\"\n   149→        parsed_jd = await self._parse_jd(job)\n   150→        scores = self._compute_scores(parsed_jd, profile, job)\n   151→        composite = scores.composite\n   152→        is_hot = composite >= 80\n   153→        reasoning = await self._generate_reasoning(job, profile, scores, composite)\n   154→\n   155→        return ScoredJobSchema(\n   156→            id=uuid4(),\n   157→            discovered_job_id=job.id or uuid4(),\n   158→            candidate_id=candidate_id,\n   159→            score_breakdown=scores,\n   160→            composite_score=composite,\n   161→            is_hot=is_hot,\n   162→            reasoning=reasoning,\n   163→            scored_at=datetime.now(timezone.utc),\n   164→            # Denormalized job fields for digest display\n   165→            title=job.title,\n   166→            company=job.company,\n   167→            location=job.location,\n   168→            url=job.url,\n   169→        )\n   170→\n   171→    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n   172→    async def _parse_jd(self, job: DiscoveredJobSchema) -> dict:\n   173→        \"\"\"Use Claude to extract structured requirements from a job description.\"\"\"\n   174→        if not job.description:\n   175→            return {}\n   176→\n   177→        prompt = f\"\"\"Extract structured data from this job description. Return ONLY valid JSON, no markdown:\n   178→\n   179→Job Title: {job.title}\n   180→Company: {job.company}\n   181→Location: {job.location or \"Not specified\"}\n   182→\n   183→Description:\n   184→{job.description[:3000]}\n   185→\n   186→Return this exact JSON structure:\n   187→{{\n   188→  \"required_skills\": [\"<skill1>\", \"<skill2>\"],\n   189→  \"preferred_skills\": [\"<skill1>\"],\n   190→  \"seniority_level\": \"<intern|junior|mid|senior|staff|principal|lead|manager|director|vp|head|exec>\",\n   191→  \"remote_type\": \"<remote|hybrid|onsite|flexible>\",\n   192→  \"industries\": [\"<industry1>\"],\n   193→  \"comp_mentioned\": \"<salary string or null>\",\n   194→  \"culture_signals\": {{\n   195→    \"startup_vs_enterprise\": \"<startup|enterprise|both>\",\n   196→    \"mission_driven\": true\n   197→  }},\n   198→  \"growth_indicators\": [\"<indicator1>\"]\n   199→}}\"\"\"\n   200→\n   201→        response = await self._claude.messages.create(\n   202→            model=\"claude-sonnet-4-20250514\",\n   203→            max_tokens=1024,\n   204→            messages=[{\"role\": \"user\", \"content\": prompt}],\n   205→        )\n   206→\n   207→        raw = response.content[0].text.strip()\n   208→        try:\n   209→            return json.loads(raw)\n   210→        except json.JSONDecodeError:\n   211→            match = re.search(r\"\\{.*\\}\", raw, re.DOTALL)\n   212→            return json.loads(match.group()) if match else {}\n   213→\n   214→    def _compute_scores(\n   215→        self,\n   216→        parsed_jd: dict,\n   217→        profile: IdentityProfileSchema,\n   218→        job: DiscoveredJobSchema,\n   219→    ) -> ScoreBreakdown:\n   220→        \"\"\"Compute all six scoring dimensions locally.\"\"\"\n   221→        return ScoreBreakdown(\n   222→            technical_match=self._score_technical(parsed_jd, profile),\n   223→            level_match=self._score_level(parsed_jd, profile),\n   224→            culture_match=self._score_culture(parsed_jd, profile, job),\n   225→            industry_match=self._score_industry(parsed_jd, profile),\n   226→            growth_potential=self._score_growth(parsed_jd, profile),\n   227→            compensation_match=self._score_compensation(parsed_jd, profile),\n   228→        )\n   229→\n   230→    def _score_technical(\n   231→        self, parsed_jd: dict, profile: IdentityProfileSchema\n   232→    ) -> int:\n   233→        \"\"\"Score based on skills overlap between JD requirements and candidate skills.\"\"\"\n   234→        required = {s.lower() for s in parsed_jd.get(\"required_skills\", [])}\n   235→        preferred = {s.lower() for s in parsed_jd.get(\"preferred_skills\", [])}\n   236→        candidate_skills = {s.lower() for s in profile.technical_skills}\n   237→\n   238→        if not required:\n   239→            return 60  # No requirements listed — neutral score\n   240→\n   241→        required_hits = len(required & candidate_skills)\n   242→        preferred_hits = len(preferred & candidate_skills)\n   243→\n   244→        required_ratio = required_hits / len(required) if required else 0\n   245→        preferred_bonus = min(20, preferred_hits * 4) if preferred else 0\n   246→\n   247→        base = int(required_ratio * 80)\n   248→        return min(100, base + preferred_bonus)\n   249→\n   250→    def _score_level(self, parsed_jd: dict, profile: IdentityProfileSchema) -> int:\n   251→        \"\"\"Score seniority alignment — penalise both under and over.\"\"\"\n   252→        jd_level = parsed_jd.get(\"seniority_level\", \"\").lower()\n   253→        candidate_level = _LEADERSHIP_TO_LADDER.get(\n   254→            profile.leadership_level, \"senior\"\n   255→        )\n   256→\n   257→        try:\n   258→            jd_idx = _SENIORITY_LADDER.index(jd_level)\n   259→        except ValueError:\n   260→            return 70  # Unknown level — generous neutral\n   261→\n   262→        try:\n   263→            candidate_idx = _SENIORITY_LADDER.index(candidate_level)\n   264→        except ValueError:\n   265→            return 70\n   266→\n   267→        diff = abs(jd_idx - candidate_idx)\n   268→        if diff == 0:\n   269→            return 100\n   270→        elif diff == 1:\n   271→            return 80\n   272→        elif diff == 2:\n   273→            return 55\n   274→        elif diff == 3:\n   275→            return 30\n   276→        else:\n   277→            return 10\n   278→\n   279→    def _score_culture(\n   280→        self,\n   281→        parsed_jd: dict,\n   282→        profile: IdentityProfileSchema,\n   283→        job: DiscoveredJobSchema,\n   284→    ) -> int:\n   285→        \"\"\"Score culture alignment: startup/enterprise + remote preference.\"\"\"\n   286→        score = 60  # default neutral\n   287→\n   288→        # Startup vs enterprise alignment\n   289→        jd_type = parsed_jd.get(\"culture_signals\", {}).get(\n   290→            \"startup_vs_enterprise\", \"\"\n   291→        )\n   292→        candidate_pref = profile.signals.get(\"startup_vs_enterprise\", \"both\")\n   293→        if jd_type and candidate_pref != \"both\":\n   294→            if jd_type == candidate_pref:\n   295→                score += 20\n   296→            else:\n   297→                score -= 20\n   298→\n   299→        # Remote alignment\n   300→        jd_remote = parsed_jd.get(\"remote_type\", \"\")\n   301→        candidate_remote = profile.signals.get(\"remote_preference\", \"flexible\")\n   302→        if jd_remote and candidate_remote != \"flexible\":\n   303→            if jd_remote == candidate_remote:\n   304→                score += 20\n   305→            elif jd_remote == \"onsite\" and candidate_remote == \"remote\":\n   306→                score -= 30\n   307→            else:\n   308→                score -= 10\n   309→\n   310→        return max(0, min(100, score))\n   311→\n   312→    def _score_industry(\n   313→        self, parsed_jd: dict, profile: IdentityProfileSchema\n   314→    ) -> int:\n   315→        \"\"\"Score how well the job's industries align with the candidate's domain expertise.\"\"\"\n   316→        jd_industries = {i.lower() for i in parsed_jd.get(\"industries\", [])}\n   317→        candidate_domains = {d.lower() for d in profile.industry_experience}\n   318→\n   319→        if not jd_industries:\n   320→            return 60\n   321→\n   322→        overlap = len(jd_industries & candidate_domains)\n   323→        if overlap >= 2:\n   324→            return 100\n   325→        elif overlap == 1:\n   326→            return 75\n   327→        else:\n   328→            return 35\n   329→\n   330→    def _score_growth(\n   331→        self, parsed_jd: dict, profile: IdentityProfileSchema\n   332→    ) -> int:\n   333→        \"\"\"Score whether this role expands the candidate's trajectory.\"\"\"\n   334→        indicators = parsed_jd.get(\"growth_indicators\", [])\n   335→        growth_keywords = {\n   336→            \"build from scratch\",\n   337→            \"greenfield\",\n   338→            \"founding\",\n   339→            \"new team\",\n   340→            \"technical strategy\",\n   341→            \"shape the\",\n   342→            \"lead the\",\n   343→            \"define the\",\n   344→            \"architect\",\n   345→            \"platform\",\n   346→            \"0 to 1\",\n   347→        }\n   348→\n   349→        indicator_text = \" \".join(indicators).lower()\n   350→        matches = sum(1 for kw in growth_keywords if kw in indicator_text)\n   351→\n   352→        if matches >= 3:\n   353→            return 90\n   354→        elif matches >= 1:\n   355→            return 70\n   356→        else:\n   357→            return 50\n   358→\n   359→    def _score_compensation(\n   360→        self, parsed_jd: dict, profile: IdentityProfileSchema\n   361→    ) -> int:\n   362→        \"\"\"Score comp alignment — generous when comp isn't mentioned.\"\"\"\n   363→        comp_str = parsed_jd.get(\"comp_mentioned\")\n   364→        if not comp_str:\n   365→            return 75  # No comp listed is common for senior/exec roles\n   366→\n   367→        # Extract numbers from comp string\n   368→        numbers = re.findall(r\"\\d[\\d,]*\", comp_str.replace(\",\", \"\"))\n   369→        if not numbers:\n   370→            return 70\n   371→\n   372→        amounts = [int(n) for n in numbers if len(n) <= 7]  # filter out noise\n   373→        if not amounts:\n   374→            return 70\n   375→\n   376→        # Without candidate min, return neutral\n   377→        return 75\n   378→\n   379→    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n   380→    async def _generate_reasoning(\n   381→        self,\n   382→        job: DiscoveredJobSchema,\n   383→        profile: IdentityProfileSchema,\n   384→        scores: ScoreBreakdown,\n   385→        composite: int,\n   386→    ) -> str:\n   387→        \"\"\"Generate a 2-sentence human-readable reasoning string via Claude.\"\"\"\n   388→        prompt = f\"\"\"You are writing a brief explanation for why a job matches a candidate in a talent agent digest.\n   389→\n   390→Candidate archetypes: {\", \".join(profile.archetypes[:5])}\n   391→Job: {job.title} at {job.company} ({job.location or \"location TBD\"})\n   392→Composite score: {composite}/100\n   393→\n   394→Score breakdown:\n   395→- Technical match: {scores.technical_match}/100\n   396→- Level match: {scores.level_match}/100\n   397→- Culture match: {scores.culture_match}/100\n   398→- Industry match: {scores.industry_match}/100\n   399→- Growth potential: {scores.growth_potential}/100\n   400→- Compensation match: {scores.compensation_match}/100\n   401→\n   402→Write exactly 2 sentences: one sentence on why this is a strong match, one on the key consideration or risk.\n   403→Be specific. Do not use filler phrases like \"This role offers\" or \"This position presents\". Start with the substance.\n   404→Return only the 2 sentences, no other text.\"\"\"\n   405→\n   406→        response = await self._claude.messages.create(\n   407→            model=\"claude-sonnet-4-20250514\",\n   408→            max_tokens=200,\n   409→            messages=[{\"role\": \"user\", \"content\": prompt}],\n   410→        )\n   411→        return response.content[0].text.strip()\n   412→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"5f3115d2-23da-4ef5-8305-ddd25a86d8c7","uuid":"dcdc2d9b-c9b7-40af-82a4-f53de8f2473a","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/discovery/relevance_scorer.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nRelevance Scorer — scores each discovered job against the candidate's identity profile.\n\nScoring dimensions (each 0–100):\n  technical_match   30%  — skills overlap between JD and candidate profile\n  level_match       20%  — seniority alignment (penalise over AND under)\n  culture_match     15%  — startup/enterprise, remote, mission alignment\n  industry_match    15%  — domain expertise alignment\n  growth_potential  10%  — does this expand the candidate's trajectory?\n  compensation_match 10% — estimated band vs candidate target\n\nClaude parses the JD. Math runs locally. Claude writes 2-sentence reasoning.\n\"\"\"\n\nimport json\nimport re\nfrom datetime import datetime, timezone\nfrom uuid import UUID, uuid4\n\nimport structlog\nfrom anthropic import AsyncAnthropic\nfrom tenacity import retry, stop_after_attempt, wait_exponential\n\nfrom backend.agents.discovery.schemas import (\n    IdentityProfileSchema,\n    DiscoveredJobSchema,\n    ScoredJobSchema,\n    ScoreBreakdown,\n)\n\nlogger = structlog.get_logger(__name__)\n\n# Seniority levels for level_match scoring — lower index = more junior\n_SENIORITY_LADDER = [\n    \"intern\",\n    \"junior\",\n    \"associate\",\n    \"mid\",\n    \"senior\",\n    \"staff\",\n    \"principal\",\n    \"lead\",\n    \"manager\",\n    \"director\",\n    \"vp\",\n    \"svp\",\n    \"head\",\n    \"cto\",\n    \"coo\",\n    \"ceo\",\n    \"founder\",\n    \"exec\",\n    \"c-level\",\n]\n\n_LEADERSHIP_TO_LADDER = {\n    \"IC\": \"senior\",\n    \"Lead\": \"lead\",\n    \"Manager\": \"manager\",\n    \"Director\": \"director\",\n    \"VP\": \"vp\",\n    \"C-Level\": \"cto\",\n}\n\n\nclass RelevanceScorer:\n    \"\"\"\n    Scores discovered jobs against a candidate's identity profile.\n\n    Uses Claude to parse JD requirements and generate reasoning.\n    Scoring math runs locally — no LLM needed for the numbers.\n    \"\"\"\n\n    def __init__(self, anthropic_client: AsyncAnthropic):\n        \"\"\"\n        Initialize the RelevanceScorer.\n\n        Args:\n            anthropic_client: Async Anthropic client for Claude API\n        \"\"\"\n        self._claude = anthropic_client\n\n    async def score_batch(\n        self,\n        jobs: list[DiscoveredJobSchema],\n        profile: IdentityProfileSchema,\n        candidate_id: UUID,\n        min_score: int = 60,\n    ) -> list[ScoredJobSchema]:\n        \"\"\"\n        Score a batch of discovered jobs, filtering out those below min_score.\n\n        Args:\n            jobs: Raw discovered jobs to score\n            profile: Candidate identity profile\n            candidate_id: Candidate UUID for scored job records\n            min_score: Jobs below this composite score are discarded\n\n        Returns:\n            Sorted list of ScoredJobSchema, highest composite first\n        \"\"\"\n        logger.info(\n            \"relevance_scorer.batch_start\",\n            job_count=len(jobs),\n            min_score=min_score,\n        )\n\n        scored: list[ScoredJobSchema] = []\n        for job in jobs:\n            try:\n                result = await self.score_job(job, profile, candidate_id)\n                if result.composite_score >= min_score:\n                    scored.append(result)\n            except Exception as e:\n                logger.error(\n                    \"relevance_scorer.job_error\",\n                    job_url=job.url,\n                    error=str(e),\n                )\n\n        scored.sort(key=lambda s: s.composite_score, reverse=True)\n        logger.info(\n            \"relevance_scorer.batch_complete\",\n            scored=len(scored),\n            filtered_out=len(jobs) - len(scored),\n        )\n        return scored\n\n    async def score_job(\n        self,\n        job: DiscoveredJobSchema,\n        profile: IdentityProfileSchema,\n        candidate_id: UUID,\n    ) -> ScoredJobSchema:\n        \"\"\"\n        Score a single job against the identity profile.\n\n        Args:\n            job: Discovered job\n            profile: Candidate identity profile\n            candidate_id: Candidate UUID\n\n        Returns:\n            ScoredJobSchema with full breakdown and reasoning\n        \"\"\"\n        parsed_jd = await self._parse_jd(job)\n        scores = self._compute_scores(parsed_jd, profile, job)\n        composite = scores.composite\n        is_hot = composite >= 80\n        reasoning = await self._generate_reasoning(job, profile, scores, composite)\n\n        return ScoredJobSchema(\n            id=uuid4(),\n            discovered_job_id=job.id or uuid4(),\n            candidate_id=candidate_id,\n            score_breakdown=scores,\n            composite_score=composite,\n            is_hot=is_hot,\n            reasoning=reasoning,\n            scored_at=datetime.now(timezone.utc),\n            # Denormalized job fields for digest display\n            title=job.title,\n            company=job.company,\n            location=job.location,\n            url=job.url,\n        )\n\n    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n    async def _parse_jd(self, job: DiscoveredJobSchema) -> dict:\n        \"\"\"Use Claude to extract structured requirements from a job description.\"\"\"\n        if not job.description:\n            return {}\n\n        prompt = f\"\"\"Extract structured data from this job description. Return ONLY valid JSON, no markdown:\n\nJob Title: {job.title}\nCompany: {job.company}\nLocation: {job.location or \"Not specified\"}\n\nDescription:\n{job.description[:3000]}\n\nReturn this exact JSON structure:\n{{\n  \"required_skills\": [\"<skill1>\", \"<skill2>\"],\n  \"preferred_skills\": [\"<skill1>\"],\n  \"seniority_level\": \"<intern|junior|mid|senior|staff|principal|lead|manager|director|vp|head|exec>\",\n  \"remote_type\": \"<remote|hybrid|onsite|flexible>\",\n  \"industries\": [\"<industry1>\"],\n  \"comp_mentioned\": \"<salary string or null>\",\n  \"culture_signals\": {{\n    \"startup_vs_enterprise\": \"<startup|enterprise|both>\",\n    \"mission_driven\": true\n  }},\n  \"growth_indicators\": [\"<indicator1>\"]\n}}\"\"\"\n\n        response = await self._claude.messages.create(\n            model=\"claude-sonnet-4-20250514\",\n            max_tokens=1024,\n            messages=[{\"role\": \"user\", \"content\": prompt}],\n        )\n\n        raw = response.content[0].text.strip()\n        try:\n            return json.loads(raw)\n        except json.JSONDecodeError:\n            match = re.search(r\"\\{.*\\}\", raw, re.DOTALL)\n            return json.loads(match.group()) if match else {}\n\n    def _compute_scores(\n        self,\n        parsed_jd: dict,\n        profile: IdentityProfileSchema,\n        job: DiscoveredJobSchema,\n    ) -> ScoreBreakdown:\n        \"\"\"Compute all six scoring dimensions locally.\"\"\"\n        return ScoreBreakdown(\n            technical_match=self._score_technical(parsed_jd, profile),\n            level_match=self._score_level(parsed_jd, profile),\n            culture_match=self._score_culture(parsed_jd, profile, job),\n            industry_match=self._score_industry(parsed_jd, profile),\n            growth_potential=self._score_growth(parsed_jd, profile),\n            compensation_match=self._score_compensation(parsed_jd, profile),\n        )\n\n    def _score_technical(\n        self, parsed_jd: dict, profile: IdentityProfileSchema\n    ) -> int:\n        \"\"\"Score based on skills overlap between JD requirements and candidate skills.\"\"\"\n        required = {s.lower() for s in parsed_jd.get(\"required_skills\", [])}\n        preferred = {s.lower() for s in parsed_jd.get(\"preferred_skills\", [])}\n        candidate_skills = {s.lower() for s in profile.technical_skills}\n\n        if not required:\n            return 60  # No requirements listed — neutral score\n\n        required_hits = len(required & candidate_skills)\n        preferred_hits = len(preferred & candidate_skills)\n\n        required_ratio = required_hits / len(required) if required else 0\n        preferred_bonus = min(20, preferred_hits * 4) if preferred else 0\n\n        base = int(required_ratio * 80)\n        return min(100, base + preferred_bonus)\n\n    def _score_level(self, parsed_jd: dict, profile: IdentityProfileSchema) -> int:\n        \"\"\"Score seniority alignment — penalise both under and over.\"\"\"\n        jd_level = parsed_jd.get(\"seniority_level\", \"\").lower()\n        candidate_level = _LEADERSHIP_TO_LADDER.get(\n            profile.leadership_level, \"senior\"\n        )\n\n        try:\n            jd_idx = _SENIORITY_LADDER.index(jd_level)\n        except ValueError:\n            return 70  # Unknown level — generous neutral\n\n        try:\n            candidate_idx = _SENIORITY_LADDER.index(candidate_level)\n        except ValueError:\n            return 70\n\n        diff = abs(jd_idx - candidate_idx)\n        if diff == 0:\n            return 100\n        elif diff == 1:\n            return 80\n        elif diff == 2:\n            return 55\n        elif diff == 3:\n            return 30\n        else:\n            return 10\n\n    def _score_culture(\n        self,\n        parsed_jd: dict,\n        profile: IdentityProfileSchema,\n        job: DiscoveredJobSchema,\n    ) -> int:\n        \"\"\"Score culture alignment: startup/enterprise + remote preference.\"\"\"\n        score = 60  # default neutral\n\n        # Startup vs enterprise alignment\n        jd_type = parsed_jd.get(\"culture_signals\", {}).get(\n            \"startup_vs_enterprise\", \"\"\n        )\n        candidate_pref = profile.signals.get(\"startup_vs_enterprise\", \"both\")\n        if jd_type and candidate_pref != \"both\":\n            if jd_type == candidate_pref:\n                score += 20\n            else:\n                score -= 20\n\n        # Remote alignment\n        jd_remote = parsed_jd.get(\"remote_type\", \"\")\n        candidate_remote = profile.signals.get(\"remote_preference\", \"flexible\")\n        if jd_remote and candidate_remote != \"flexible\":\n            if jd_remote == candidate_remote:\n                score += 20\n            elif jd_remote == \"onsite\" and candidate_remote == \"remote\":\n                score -= 30\n            else:\n                score -= 10\n\n        return max(0, min(100, score))\n\n    def _score_industry(\n        self, parsed_jd: dict, profile: IdentityProfileSchema\n    ) -> int:\n        \"\"\"Score how well the job's industries align with the candidate's domain expertise.\"\"\"\n        jd_industries = {i.lower() for i in parsed_jd.get(\"industries\", [])}\n        candidate_domains = {d.lower() for d in profile.industry_experience}\n\n        if not jd_industries:\n            return 60\n\n        overlap = len(jd_industries & candidate_domains)\n        if overlap >= 2:\n            return 100\n        elif overlap == 1:\n            return 75\n        else:\n            return 35\n\n    def _score_growth(\n        self, parsed_jd: dict, profile: IdentityProfileSchema\n    ) -> int:\n        \"\"\"Score whether this role expands the candidate's trajectory.\"\"\"\n        indicators = parsed_jd.get(\"growth_indicators\", [])\n        growth_keywords = {\n            \"build from scratch\",\n            \"greenfield\",\n            \"founding\",\n            \"new team\",\n            \"technical strategy\",\n            \"shape the\",\n            \"lead the\",\n            \"define the\",\n            \"architect\",\n            \"platform\",\n            \"0 to 1\",\n        }\n\n        indicator_text = \" \".join(indicators).lower()\n        matches = sum(1 for kw in growth_keywords if kw in indicator_text)\n\n        if matches >= 3:\n            return 90\n        elif matches >= 1:\n            return 70\n        else:\n            return 50\n\n    def _score_compensation(\n        self, parsed_jd: dict, profile: IdentityProfileSchema\n    ) -> int:\n        \"\"\"Score comp alignment — generous when comp isn't mentioned.\"\"\"\n        comp_str = parsed_jd.get(\"comp_mentioned\")\n        if not comp_str:\n            return 75  # No comp listed is common for senior/exec roles\n\n        # Extract numbers from comp string\n        numbers = re.findall(r\"\\d[\\d,]*\", comp_str.replace(\",\", \"\"))\n        if not numbers:\n            return 70\n\n        amounts = [int(n) for n in numbers if len(n) <= 7]  # filter out noise\n        if not amounts:\n            return 70\n\n        # Without candidate min, return neutral\n        return 75\n\n    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n    async def _generate_reasoning(\n        self,\n        job: DiscoveredJobSchema,\n        profile: IdentityProfileSchema,\n        scores: ScoreBreakdown,\n        composite: int,\n    ) -> str:\n        \"\"\"Generate a 2-sentence human-readable reasoning string via Claude.\"\"\"\n        prompt = f\"\"\"You are writing a brief explanation for why a job matches a candidate in a talent agent digest.\n\nCandidate archetypes: {\", \".join(profile.archetypes[:5])}\nJob: {job.title} at {job.company} ({job.location or \"location TBD\"})\nComposite score: {composite}/100\n\nScore breakdown:\n- Technical match: {scores.technical_match}/100\n- Level match: {scores.level_match}/100\n- Culture match: {scores.culture_match}/100\n- Industry match: {scores.industry_match}/100\n- Growth potential: {scores.growth_potential}/100\n- Compensation match: {scores.compensation_match}/100\n\nWrite exactly 2 sentences: one sentence on why this is a strong match, one on the key consideration or risk.\nBe specific. Do not use filler phrases like \"This role offers\" or \"This position presents\". Start with the substance.\nReturn only the 2 sentences, no other text.\"\"\"\n\n        response = await self._claude.messages.create(\n            model=\"claude-sonnet-4-20250514\",\n            max_tokens=200,\n            messages=[{\"role\": \"user\", \"content\": prompt}],\n        )\n        return response.content[0].text.strip()\n","numLines":412,"startLine":1,"totalLines":412}}}}
{"t":"2026-05-20T21:27:34.869Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JrPxKeydqx2auJmqA86tQV","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Daily Digest Builder — assembles the ranked digest from scored jobs.\n     6→\n     7→Flow:\n     8→  1. Receive scored jobs from RelevanceScorer\n     9→  2. Separate HOT picks (80+) from top picks\n    10→  3. Identify new companies not seen in previous digests\n    11→  4. Persist digest to PostgreSQL\n    12→  5. Publish DIGEST_READY event to Redis pub/sub\n    13→\"\"\"\n    14→\n    15→import json\n    16→from datetime import date\n    17→from uuid import UUID\n    18→\n    19→import redis.asyncio as aioredis\n    20→import structlog\n    21→from sqlalchemy.ext.asyncio import AsyncSession\n    22→\n    23→from backend.agents.discovery.schemas import (\n    24→    ScoredJobSchema,\n    25→    DailyDigestSchema,\n    26→)\n    27→from backend.models.discovery import DailyDigest as DailyDigestORM\n    28→\n    29→logger = structlog.get_logger(__name__)\n    30→\n    31→_DIGEST_READY_CHANNEL = \"agent.status.digest\"\n    32→_SEEN_COMPANIES_KEY = \"seen_companies:{candidate_id}\"\n    33→_SEEN_COMPANIES_TTL = 86_400 * 30  # 30 days\n    34→\n    35→\n    36→class DigestBuilder:\n    37→    \"\"\"\n    38→    Compiles scored jobs into a daily digest, persists it, and fires the DIGEST_READY event.\n    39→    \"\"\"\n    40→\n    41→    def __init__(\n    42→        self,\n    43→        redis_client: aioredis.Redis,\n    44→        db: AsyncSession,\n    45→    ):\n    46→        \"\"\"\n    47→        Initialize the DigestBuilder.\n    48→\n    49→        Args:\n    50→            redis_client: Async Redis client for caching and pub/sub\n    51→            db: Async SQLAlchemy session for persistence\n    52→        \"\"\"\n    53→        self._redis = redis_client\n    54→        self._db = db\n    55→\n    56→    async def compile(\n    57→        self,\n    58→        candidate_id: UUID,\n    59→        scored_jobs: list[ScoredJobSchema],\n    60→        total_discovered: int,\n    61→    ) -> DailyDigestSchema:\n    62→        \"\"\"\n    63→        Build the full daily digest from scored jobs.\n    64→\n    65→        Args:\n    66→            candidate_id: Candidate this digest belongs to\n    67→            scored_jobs: All jobs that passed MIN_SCORE, sorted descending by composite\n    68→            total_discovered: Raw count before scoring/filtering\n    69→\n    70→        Returns:\n    71→            DailyDigestSchema ready for the Review Dashboard\n    72→        \"\"\"\n    73→        today = date.today().isoformat()\n    74→        logger.info(\n    75→            \"digest_builder.compiling\",\n    76→            candidate_id=str(candidate_id),\n    77→            scored_jobs=len(scored_jobs),\n    78→            run_date=today,\n    79→        )\n    80→\n    81→        hot_picks = [s for s in scored_jobs if s.is_hot]\n    82→        top_picks = scored_jobs[:10]\n    83→        new_companies = await self._find_new_companies(candidate_id, scored_jobs)\n    84→\n    85→        digest = DailyDigestSchema(\n    86→            candidate_id=candidate_id,\n    87→            run_date=today,\n    88→            total_jobs_discovered=total_discovered,\n    89→            total_jobs_scored=len(scored_jobs),\n    90→            top_picks=top_picks,\n    91→            hot_picks=hot_picks,\n    92→            new_companies=new_companies,\n    93→        )\n    94→\n    95→        await self._persist(digest)\n    96→        await self._publish_ready_event(candidate_id, digest)\n    97→\n    98→        logger.info(\n    99→            \"digest_builder.complete\",\n   100→            candidate_id=str(candidate_id),\n   101→            top_picks=len(top_picks),\n   102→            hot_picks=len(hot_picks),\n   103→            new_companies=len(new_companies),\n   104→        )\n   105→        return digest\n   106→\n   107→    async def _find_new_companies(\n   108→        self, candidate_id: UUID, scored_jobs: list[ScoredJobSchema]\n   109→    ) -> list[str]:\n   110→        \"\"\"\n   111→        Return companies appearing in today's digest that weren't in recent digests.\n   112→\n   113→        Uses a Redis set as a rolling 30-day seen-companies tracker.\n   114→        \"\"\"\n   115→        key = _SEEN_COMPANIES_KEY.format(candidate_id=str(candidate_id))\n   116→        today_companies = list({s.company for s in scored_jobs})\n   117→\n   118→        # Identify new ones\n   119→        seen_raw = await self._redis.smembers(key)\n   120→        seen = {c.decode() if isinstance(c, bytes) else c for c in seen_raw}\n   121→        new_companies = [c for c in today_companies if c not in seen]\n   122→\n   123→        # Update the seen set\n   124→        if today_companies:\n   125→            await self._redis.sadd(key, *today_companies)\n   126→            await self._redis.expire(key, _SEEN_COMPANIES_TTL)\n   127→\n   128→        return new_companies\n   129→\n   130→    async def _persist(self, digest: DailyDigestSchema) -> None:\n   131→        \"\"\"Persist the digest to PostgreSQL.\"\"\"\n   132→        orm = DailyDigestORM(\n   133→            candidate_id=digest.candidate_id,\n   134→            run_date=date.fromisoformat(digest.run_date),\n   135→            total_jobs_discovered=digest.total_jobs_discovered,\n   136→            total_jobs_scored=digest.total_jobs_scored,\n   137→            top_picks=[p.model_dump(mode=\"json\") for p in digest.top_picks],\n   138→            hot_picks=[p.model_dump(mode=\"json\") for p in digest.hot_picks],\n   139→            new_companies=digest.new_companies,\n   140→        )\n   141→        self._db.add(orm)\n   142→        await self._db.commit()\n   143→        logger.info(\"digest_builder.persisted\", candidate_id=str(digest.candidate_id))\n   144→\n   145→    async def _publish_ready_event(\n   146→        self, candidate_id: UUID, digest: DailyDigestSchema\n   147→    ) -> None:\n   148→        \"\"\"Publish DIGEST_READY event to Redis pub/sub for dashboard notification.\"\"\"\n   149→        payload = json.dumps(\n   150→            {\n   151→                \"event\": \"DIGEST_READY\",\n   152→                \"candidate_id\": str(candidate_id),\n   153→                \"run_date\": digest.run_date,\n   154→                \"total_scored\": digest.total_jobs_scored,\n   155→                \"hot_count\": len(digest.hot_picks),\n   156→                \"top_score\": (\n   157→                    digest.top_picks[0].composite_score if digest.top_picks else 0\n   158→                ),\n   159→            }\n   160→        )\n   161→        await self._redis.publish(_DIGEST_READY_CHANNEL, payload)\n   162→        logger.info(\n   163→            \"digest_builder.event_published\",\n   164→            channel=_DIGEST_READY_CHANNEL,\n   165→            candidate_id=str(candidate_id),\n   166→        )\n   167→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"5f3115d2-23da-4ef5-8305-ddd25a86d8c7","uuid":"040d9c4a-f7ff-478f-874c-5787e591e12e","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/discovery/digest_builder.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nDaily Digest Builder — assembles the ranked digest from scored jobs.\n\nFlow:\n  1. Receive scored jobs from RelevanceScorer\n  2. Separate HOT picks (80+) from top picks\n  3. Identify new companies not seen in previous digests\n  4. Persist digest to PostgreSQL\n  5. Publish DIGEST_READY event to Redis pub/sub\n\"\"\"\n\nimport json\nfrom datetime import date\nfrom uuid import UUID\n\nimport redis.asyncio as aioredis\nimport structlog\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom backend.agents.discovery.schemas import (\n    ScoredJobSchema,\n    DailyDigestSchema,\n)\nfrom backend.models.discovery import DailyDigest as DailyDigestORM\n\nlogger = structlog.get_logger(__name__)\n\n_DIGEST_READY_CHANNEL = \"agent.status.digest\"\n_SEEN_COMPANIES_KEY = \"seen_companies:{candidate_id}\"\n_SEEN_COMPANIES_TTL = 86_400 * 30  # 30 days\n\n\nclass DigestBuilder:\n    \"\"\"\n    Compiles scored jobs into a daily digest, persists it, and fires the DIGEST_READY event.\n    \"\"\"\n\n    def __init__(\n        self,\n        redis_client: aioredis.Redis,\n        db: AsyncSession,\n    ):\n        \"\"\"\n        Initialize the DigestBuilder.\n\n        Args:\n            redis_client: Async Redis client for caching and pub/sub\n            db: Async SQLAlchemy session for persistence\n        \"\"\"\n        self._redis = redis_client\n        self._db = db\n\n    async def compile(\n        self,\n        candidate_id: UUID,\n        scored_jobs: list[ScoredJobSchema],\n        total_discovered: int,\n    ) -> DailyDigestSchema:\n        \"\"\"\n        Build the full daily digest from scored jobs.\n\n        Args:\n            candidate_id: Candidate this digest belongs to\n            scored_jobs: All jobs that passed MIN_SCORE, sorted descending by composite\n            total_discovered: Raw count before scoring/filtering\n\n        Returns:\n            DailyDigestSchema ready for the Review Dashboard\n        \"\"\"\n        today = date.today().isoformat()\n        logger.info(\n            \"digest_builder.compiling\",\n            candidate_id=str(candidate_id),\n            scored_jobs=len(scored_jobs),\n            run_date=today,\n        )\n\n        hot_picks = [s for s in scored_jobs if s.is_hot]\n        top_picks = scored_jobs[:10]\n        new_companies = await self._find_new_companies(candidate_id, scored_jobs)\n\n        digest = DailyDigestSchema(\n            candidate_id=candidate_id,\n            run_date=today,\n            total_jobs_discovered=total_discovered,\n            total_jobs_scored=len(scored_jobs),\n            top_picks=top_picks,\n            hot_picks=hot_picks,\n            new_companies=new_companies,\n        )\n\n        await self._persist(digest)\n        await self._publish_ready_event(candidate_id, digest)\n\n        logger.info(\n            \"digest_builder.complete\",\n            candidate_id=str(candidate_id),\n            top_picks=len(top_picks),\n            hot_picks=len(hot_picks),\n            new_companies=len(new_companies),\n        )\n        return digest\n\n    async def _find_new_companies(\n        self, candidate_id: UUID, scored_jobs: list[ScoredJobSchema]\n    ) -> list[str]:\n        \"\"\"\n        Return companies appearing in today's digest that weren't in recent digests.\n\n        Uses a Redis set as a rolling 30-day seen-companies tracker.\n        \"\"\"\n        key = _SEEN_COMPANIES_KEY.format(candidate_id=str(candidate_id))\n        today_companies = list({s.company for s in scored_jobs})\n\n        # Identify new ones\n        seen_raw = await self._redis.smembers(key)\n        seen = {c.decode() if isinstance(c, bytes) else c for c in seen_raw}\n        new_companies = [c for c in today_companies if c not in seen]\n\n        # Update the seen set\n        if today_companies:\n            await self._redis.sadd(key, *today_companies)\n            await self._redis.expire(key, _SEEN_COMPANIES_TTL)\n\n        return new_companies\n\n    async def _persist(self, digest: DailyDigestSchema) -> None:\n        \"\"\"Persist the digest to PostgreSQL.\"\"\"\n        orm = DailyDigestORM(\n            candidate_id=digest.candidate_id,\n            run_date=date.fromisoformat(digest.run_date),\n            total_jobs_discovered=digest.total_jobs_discovered,\n            total_jobs_scored=digest.total_jobs_scored,\n            top_picks=[p.model_dump(mode=\"json\") for p in digest.top_picks],\n            hot_picks=[p.model_dump(mode=\"json\") for p in digest.hot_picks],\n            new_companies=digest.new_companies,\n        )\n        self._db.add(orm)\n        await self._db.commit()\n        logger.info(\"digest_builder.persisted\", candidate_id=str(digest.candidate_id))\n\n    async def _publish_ready_event(\n        self, candidate_id: UUID, digest: DailyDigestSchema\n    ) -> None:\n        \"\"\"Publish DIGEST_READY event to Redis pub/sub for dashboard notification.\"\"\"\n        payload = json.dumps(\n            {\n                \"event\": \"DIGEST_READY\",\n                \"candidate_id\": str(candidate_id),\n                \"run_date\": digest.run_date,\n                \"total_scored\": digest.total_jobs_scored,\n                \"hot_count\": len(digest.hot_picks),\n                \"top_score\": (\n                    digest.top_picks[0].composite_score if digest.top_picks else 0\n                ),\n            }\n        )\n        await self._redis.publish(_DIGEST_READY_CHANNEL, payload)\n        logger.info(\n            \"digest_builder.event_published\",\n            channel=_DIGEST_READY_CHANNEL,\n            candidate_id=str(candidate_id),\n        )\n","numLines":167,"startLine":1,"totalLines":167}}}}
{"t":"2026-05-20T21:27:34.877Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y8w8iTVTrz8vrHjRvPNVXi","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Discovery Orchestrator — coordinates the full daily discovery run.\n     6→\n     7→This is the entry point for both the Celery cron job and the manual API trigger.\n     8→\n     9→Flow:\n    10→  load_candidate(candidate_id)\n    11→    → identity_profiler.build_profile()\n    12→    → archetype_generator.expand()\n    13→    → crawler_agent.run(manifest)           ← currently stubbed\n    14→    → relevance_scorer.score_batch(jobs)\n    15→    → digest_builder.compile(scored_jobs)\n    16→    → emit DIGEST_READY\n    17→\n    18→Concurrency:\n    19→  - Scoring runs with bounded concurrency (CRAWL_CONCURRENCY semaphore)\n    20→  - Digest build follows after all scoring is complete\n    21→\n    22→Status machine:\n    23→  QUEUED → RUNNING → COMPLETED\n    24→                   → FAILED\n    25→\"\"\"\n    26→\n    27→import asyncio\n    28→import json\n    29→from datetime import date, datetime, timezone\n    30→from uuid import UUID\n    31→\n    32→import redis.asyncio as aioredis\n    33→import structlog\n    34→from anthropic import AsyncAnthropic\n    35→from sqlalchemy import select\n    36→from sqlalchemy.ext.asyncio import AsyncSession\n    37→\n    38→from backend.config import settings\n    39→from backend.agents.discovery.schemas import (\n    40→    CandidateSchema,\n    41→    DailyDigestSchema,\n    42→    ScoredJobSchema,\n    43→)\n    44→from backend.agents.discovery.identity_profiler import IdentityProfiler\n    45→from backend.agents.discovery.archetype_generator import ArchetypeGenerator\n    46→from backend.agents.discovery.crawler_agent import CrawlerAgent\n    47→from backend.agents.discovery.relevance_scorer import RelevanceScorer\n    48→from backend.agents.discovery.digest_builder import DigestBuilder\n    49→from backend.models.discovery import Candidate as CandidateORM, CrawlRun\n    50→\n    51→logger = structlog.get_logger(__name__)\n    52→\n    53→_STATUS_CHANNEL = \"agent.status.discovery\"\n    54→\n    55→\n    56→class DiscoveryOrchestrator:\n    57→    \"\"\"\n    58→    Coordinates the full Discovery Engine pipeline for a single candidate.\n    59→\n    60→    Designed to run once per candidate per day via Celery cron,\n    61→    or on-demand via the API trigger endpoint.\n    62→    \"\"\"\n    63→\n    64→    def __init__(self, db: AsyncSession, redis_client: aioredis.Redis):\n    65→        \"\"\"\n    66→        Initialize the DiscoveryOrchestrator.\n    67→\n    68→        Args:\n    69→            db: Async SQLAlchemy session\n    70→            redis_client: Async Redis client for caching and pub/sub\n    71→        \"\"\"\n    72→        self._db = db\n    73→        self._redis = redis_client\n    74→        self._claude = AsyncAnthropic(api_key=settings.anthropic_api_key)\n    75→\n    76→        self._profiler = IdentityProfiler(redis_client, self._claude)\n    77→        self._archetype_gen = ArchetypeGenerator()\n    78→        self._scorer = RelevanceScorer(self._claude)\n    79→        self._digest_builder = DigestBuilder(redis_client, db)\n    80→\n    81→    async def run(\n    82→        self,\n    83→        candidate_id: UUID,\n    84→        dry_run: bool = False,\n    85→    ) -> DailyDigestSchema:\n    86→        \"\"\"\n    87→        Execute a full daily discovery run for a candidate.\n    88→\n    89→        Args:\n    90→            candidate_id: UUID of the candidate to run for\n    91→            dry_run: If True, don't write to DB or publish events\n    92→\n    93→        Returns:\n    94→            DailyDigestSchema with the full ranked digest\n    95→        \"\"\"\n    96→        crawl_run = await self._start_run(candidate_id, dry_run)\n    97→        log = logger.bind(candidate_id=str(candidate_id), dry_run=dry_run)\n    98→\n    99→        try:\n   100→            # 1. Load candidate\n   101→            candidate = await self._load_candidate(candidate_id)\n   102→            log.info(\"orchestrator.candidate_loaded\", name=candidate.name)\n   103→            await self._publish_status(candidate_id, \"CANDIDATE_LOADED\")\n   104→\n   105→            # 2. Build identity profile (cached 24h)\n   106→            profile = await self._profiler.build_profile(candidate)\n   107→            log.info(\n   108→                \"orchestrator.profile_built\",\n   109→                archetypes=len(profile.archetypes),\n   110→                level=profile.leadership_level,\n   111→            )\n   112→            await self._publish_status(candidate_id, \"PROFILE_BUILT\")\n   113→\n   114→            # 3. Expand archetypes into search manifest\n   115→            excluded = {\n   116→                \"titles\": [],\n   117→                \"companies\": candidate.excluded_companies or [],\n   118→                \"industries\": candidate.excluded_industries or [],\n   119→            }\n   120→            manifest = self._archetype_gen.expand(profile, excluded)\n   121→            log.info(\n   122→                \"orchestrator.manifest_built\",\n   123→                target_titles=len(manifest.target_titles),\n   124→                keywords=len(manifest.keywords),\n   125→            )\n   126→            await self._publish_status(candidate_id, \"MANIFEST_BUILT\")\n   127→\n   128→            # 4. Crawl (currently stubbed — Phase 1B)\n   129→            crawler = CrawlerAgent(candidate_id)\n   130→            raw_jobs = await crawler.run(manifest)\n   131→            log.info(\"orchestrator.crawl_complete\", jobs_found=len(raw_jobs))\n   132→            await self._publish_status(candidate_id, \"CRAWL_COMPLETE\")\n   133→\n   134→            # 5. Score with bounded concurrency\n   135→            semaphore = asyncio.Semaphore(settings.crawl_concurrency)\n   136→\n   137→            async def score_with_semaphore(job):\n   138→                async with semaphore:\n   139→                    return job\n   140→\n   141→            # Fan out scoring — respect the semaphore so we don't hammer Claude\n   142→            scored_jobs = await self._scorer.score_batch(\n   143→                raw_jobs,\n   144→                profile,\n   145→                candidate_id,\n   146→                min_score=settings.min_score,\n   147→            )\n   148→            log.info(\n   149→                \"orchestrator.scoring_complete\",\n   150→                passed=len(scored_jobs),\n   151→                filtered=len(raw_jobs) - len(scored_jobs),\n   152→            )\n   153→            await self._publish_status(candidate_id, \"SCORING_COMPLETE\")\n   154→\n   155→            # 6. Build and publish digest\n   156→            if not dry_run:\n   157→                digest = await self._digest_builder.compile(\n   158→                    candidate_id=candidate_id,\n   159→                    scored_jobs=scored_jobs,\n   160→                    total_discovered=len(raw_jobs),\n   161→                )\n   162→            else:\n   163→                digest = self._build_dry_run_digest(\n   164→                    candidate_id, scored_jobs, len(raw_jobs)\n   165→                )\n   166→\n   167→            await self._complete_run(\n   168→                crawl_run, len(raw_jobs), len(scored_jobs), dry_run\n   169→            )\n   170→            log.info(\n   171→                \"orchestrator.run_complete\",\n   172→                top_picks=len(digest.top_picks),\n   173→                hot_picks=len(digest.hot_picks),\n   174→            )\n   175→            await self._publish_status(candidate_id, \"RUN_COMPLETE\")\n   176→            return digest\n   177→\n   178→        except Exception as e:\n   179→            log.error(\"orchestrator.run_failed\", error=str(e))\n   180→            await self._publish_status(candidate_id, \"RUN_FAILED\")\n   181→            await self._fail_run(crawl_run, str(e), dry_run)\n   182→            raise\n   183→\n   184→    async def _load_candidate(self, candidate_id: UUID) -> CandidateSchema:\n   185→        \"\"\"Load candidate from PostgreSQL and convert to schema.\"\"\"\n   186→        result = await self._db.execute(\n   187→            select(CandidateORM).where(CandidateORM.id == candidate_id)\n   188→        )\n   189→        orm = result.scalar_one_or_none()\n   190→        if not orm:\n   191→            raise ValueError(f\"Candidate {candidate_id} not found\")\n   192→        return CandidateSchema.model_validate(orm)\n   193→\n   194→    async def _start_run(self, candidate_id: UUID, dry_run: bool) -> CrawlRun | None:\n   195→        \"\"\"Create a CrawlRun record and return it (None in dry_run mode).\"\"\"\n   196→        if dry_run:\n   197→            return None\n   198→        run = CrawlRun(candidate_id=candidate_id, status=\"RUNNING\")\n   199→        self._db.add(run)\n   200→        await self._db.commit()\n   201→        await self._db.refresh(run)\n   202→        return run\n   203→\n   204→    async def _complete_run(\n   205→        self, run: CrawlRun | None, discovered: int, scored: int, dry_run: bool\n   206→    ) -> None:\n   207→        \"\"\"Mark the CrawlRun as COMPLETED.\"\"\"\n   208→        if dry_run or run is None:\n   209→            return\n   210→        run.status = \"COMPLETED\"\n   211→        run.completed_at = datetime.now(timezone.utc)\n   212→        run.jobs_discovered = discovered\n   213→        run.jobs_scored = scored\n   214→        await self._db.commit()\n   215→\n   216→    async def _fail_run(\n   217→        self, run: CrawlRun | None, error: str, dry_run: bool\n   218→    ) -> None:\n   219→        \"\"\"Mark the CrawlRun as FAILED with error log.\"\"\"\n   220→        if dry_run or run is None:\n   221→            return\n   222→        run.status = \"FAILED\"\n   223→        run.completed_at = datetime.now(timezone.utc)\n   224→        run.error_log = error\n   225→        await self._db.commit()\n   226→\n   227→    def _build_dry_run_digest(\n   228→        self,\n   229→        candidate_id: UUID,\n   230→        scored_jobs: list[ScoredJobSchema],\n   231→        total_discovered: int,\n   232→    ) -> DailyDigestSchema:\n   233→        \"\"\"Build an in-memory digest without DB writes — for dry_run mode.\"\"\"\n   234→        return DailyDigestSchema(\n   235→            candidate_id=candidate_id,\n   236→            run_date=date.today().isoformat(),\n   237→            total_jobs_discovered=total_discovered,\n   238→            total_jobs_scored=len(scored_jobs),\n   239→            top_picks=[],\n   240→            hot_picks=[],\n   241→            new_companies=[],\n   242→        )\n   243→\n   244→    async def _publish_status(self, candidate_id: UUID, status: str) -> None:\n   245→        \"\"\"Publish discovery pipeline status event to Redis pub/sub.\"\"\"\n   246→        payload = json.dumps(\n   247→            {\n   248→                \"event\": \"DISCOVERY_STATUS\",\n   249→                \"candidate_id\": str(candidate_id),\n   250→                \"status\": status,\n   251→            }\n   252→        )\n   253→        await self._redis.publish(_STATUS_CHANNEL, payload)\n   254→        logger.info(\n   255→            \"orchestrator.status_published\",\n   256→            channel=_STATUS_CHANNEL,\n   257→            status=status,\n   258→        )\n   259→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"5f3115d2-23da-4ef5-8305-ddd25a86d8c7","uuid":"408484c1-96fc-41f7-98a5-f70be0cfcaa0","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/discovery/orchestrator.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nDiscovery Orchestrator — coordinates the full daily discovery run.\n\nThis is the entry point for both the Celery cron job and the manual API trigger.\n\nFlow:\n  load_candidate(candidate_id)\n    → identity_profiler.build_profile()\n    → archetype_generator.expand()\n    → crawler_agent.run(manifest)           ← currently stubbed\n    → relevance_scorer.score_batch(jobs)\n    → digest_builder.compile(scored_jobs)\n    → emit DIGEST_READY\n\nConcurrency:\n  - Scoring runs with bounded concurrency (CRAWL_CONCURRENCY semaphore)\n  - Digest build follows after all scoring is complete\n\nStatus machine:\n  QUEUED → RUNNING → COMPLETED\n                   → FAILED\n\"\"\"\n\nimport asyncio\nimport json\nfrom datetime import date, datetime, timezone\nfrom uuid import UUID\n\nimport redis.asyncio as aioredis\nimport structlog\nfrom anthropic import AsyncAnthropic\nfrom sqlalchemy import select\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom backend.config import settings\nfrom backend.agents.discovery.schemas import (\n    CandidateSchema,\n    DailyDigestSchema,\n    ScoredJobSchema,\n)\nfrom backend.agents.discovery.identity_profiler import IdentityProfiler\nfrom backend.agents.discovery.archetype_generator import ArchetypeGenerator\nfrom backend.agents.discovery.crawler_agent import CrawlerAgent\nfrom backend.agents.discovery.relevance_scorer import RelevanceScorer\nfrom backend.agents.discovery.digest_builder import DigestBuilder\nfrom backend.models.discovery import Candidate as CandidateORM, CrawlRun\n\nlogger = structlog.get_logger(__name__)\n\n_STATUS_CHANNEL = \"agent.status.discovery\"\n\n\nclass DiscoveryOrchestrator:\n    \"\"\"\n    Coordinates the full Discovery Engine pipeline for a single candidate.\n\n    Designed to run once per candidate per day via Celery cron,\n    or on-demand via the API trigger endpoint.\n    \"\"\"\n\n    def __init__(self, db: AsyncSession, redis_client: aioredis.Redis):\n        \"\"\"\n        Initialize the DiscoveryOrchestrator.\n\n        Args:\n            db: Async SQLAlchemy session\n            redis_client: Async Redis client for caching and pub/sub\n        \"\"\"\n        self._db = db\n        self._redis = redis_client\n        self._claude = AsyncAnthropic(api_key=settings.anthropic_api_key)\n\n        self._profiler = IdentityProfiler(redis_client, self._claude)\n        self._archetype_gen = ArchetypeGenerator()\n        self._scorer = RelevanceScorer(self._claude)\n        self._digest_builder = DigestBuilder(redis_client, db)\n\n    async def run(\n        self,\n        candidate_id: UUID,\n        dry_run: bool = False,\n    ) -> DailyDigestSchema:\n        \"\"\"\n        Execute a full daily discovery run for a candidate.\n\n        Args:\n            candidate_id: UUID of the candidate to run for\n            dry_run: If True, don't write to DB or publish events\n\n        Returns:\n            DailyDigestSchema with the full ranked digest\n        \"\"\"\n        crawl_run = await self._start_run(candidate_id, dry_run)\n        log = logger.bind(candidate_id=str(candidate_id), dry_run=dry_run)\n\n        try:\n            # 1. Load candidate\n            candidate = await self._load_candidate(candidate_id)\n            log.info(\"orchestrator.candidate_loaded\", name=candidate.name)\n            await self._publish_status(candidate_id, \"CANDIDATE_LOADED\")\n\n            # 2. Build identity profile (cached 24h)\n            profile = await self._profiler.build_profile(candidate)\n            log.info(\n                \"orchestrator.profile_built\",\n                archetypes=len(profile.archetypes),\n                level=profile.leadership_level,\n            )\n            await self._publish_status(candidate_id, \"PROFILE_BUILT\")\n\n            # 3. Expand archetypes into search manifest\n            excluded = {\n                \"titles\": [],\n                \"companies\": candidate.excluded_companies or [],\n                \"industries\": candidate.excluded_industries or [],\n            }\n            manifest = self._archetype_gen.expand(profile, excluded)\n            log.info(\n                \"orchestrator.manifest_built\",\n                target_titles=len(manifest.target_titles),\n                keywords=len(manifest.keywords),\n            )\n            await self._publish_status(candidate_id, \"MANIFEST_BUILT\")\n\n            # 4. Crawl (currently stubbed — Phase 1B)\n            crawler = CrawlerAgent(candidate_id)\n            raw_jobs = await crawler.run(manifest)\n            log.info(\"orchestrator.crawl_complete\", jobs_found=len(raw_jobs))\n            await self._publish_status(candidate_id, \"CRAWL_COMPLETE\")\n\n            # 5. Score with bounded concurrency\n            semaphore = asyncio.Semaphore(settings.crawl_concurrency)\n\n            async def score_with_semaphore(job):\n                async with semaphore:\n                    return job\n\n            # Fan out scoring — respect the semaphore so we don't hammer Claude\n            scored_jobs = await self._scorer.score_batch(\n                raw_jobs,\n                profile,\n                candidate_id,\n                min_score=settings.min_score,\n            )\n            log.info(\n                \"orchestrator.scoring_complete\",\n                passed=len(scored_jobs),\n                filtered=len(raw_jobs) - len(scored_jobs),\n            )\n            await self._publish_status(candidate_id, \"SCORING_COMPLETE\")\n\n            # 6. Build and publish digest\n            if not dry_run:\n                digest = await self._digest_builder.compile(\n                    candidate_id=candidate_id,\n                    scored_jobs=scored_jobs,\n                    total_discovered=len(raw_jobs),\n                )\n            else:\n                digest = self._build_dry_run_digest(\n                    candidate_id, scored_jobs, len(raw_jobs)\n                )\n\n            await self._complete_run(\n                crawl_run, len(raw_jobs), len(scored_jobs), dry_run\n            )\n            log.info(\n                \"orchestrator.run_complete\",\n                top_picks=len(digest.top_picks),\n                hot_picks=len(digest.hot_picks),\n            )\n            await self._publish_status(candidate_id, \"RUN_COMPLETE\")\n            return digest\n\n        except Exception as e:\n            log.error(\"orchestrator.run_failed\", error=str(e))\n            await self._publish_status(candidate_id, \"RUN_FAILED\")\n            await self._fail_run(crawl_run, str(e), dry_run)\n            raise\n\n    async def _load_candidate(self, candidate_id: UUID) -> CandidateSchema:\n        \"\"\"Load candidate from PostgreSQL and convert to schema.\"\"\"\n        result = await self._db.execute(\n            select(CandidateORM).where(CandidateORM.id == candidate_id)\n        )\n        orm = result.scalar_one_or_none()\n        if not orm:\n            raise ValueError(f\"Candidate {candidate_id} not found\")\n        return CandidateSchema.model_validate(orm)\n\n    async def _start_run(self, candidate_id: UUID, dry_run: bool) -> CrawlRun | None:\n        \"\"\"Create a CrawlRun record and return it (None in dry_run mode).\"\"\"\n        if dry_run:\n            return None\n        run = CrawlRun(candidate_id=candidate_id, status=\"RUNNING\")\n        self._db.add(run)\n        await self._db.commit()\n        await self._db.refresh(run)\n        return run\n\n    async def _complete_run(\n        self, run: CrawlRun | None, discovered: int, scored: int, dry_run: bool\n    ) -> None:\n        \"\"\"Mark the CrawlRun as COMPLETED.\"\"\"\n        if dry_run or run is None:\n            return\n        run.status = \"COMPLETED\"\n        run.completed_at = datetime.now(timezone.utc)\n        run.jobs_discovered = discovered\n        run.jobs_scored = scored\n        await self._db.commit()\n\n    async def _fail_run(\n        self, run: CrawlRun | None, error: str, dry_run: bool\n    ) -> None:\n        \"\"\"Mark the CrawlRun as FAILED with error log.\"\"\"\n        if dry_run or run is None:\n            return\n        run.status = \"FAILED\"\n        run.completed_at = datetime.now(timezone.utc)\n        run.error_log = error\n        await self._db.commit()\n\n    def _build_dry_run_digest(\n        self,\n        candidate_id: UUID,\n        scored_jobs: list[ScoredJobSchema],\n        total_discovered: int,\n    ) -> DailyDigestSchema:\n        \"\"\"Build an in-memory digest without DB writes — for dry_run mode.\"\"\"\n        return DailyDigestSchema(\n            candidate_id=candidate_id,\n            run_date=date.today().isoformat(),\n            total_jobs_discovered=total_discovered,\n            total_jobs_scored=len(scored_jobs),\n            top_picks=[],\n            hot_picks=[],\n            new_companies=[],\n        )\n\n    async def _publish_status(self, candidate_id: UUID, status: str) -> None:\n        \"\"\"Publish discovery pipeline status event to Redis pub/sub.\"\"\"\n        payload = json.dumps(\n            {\n                \"event\": \"DISCOVERY_STATUS\",\n                \"candidate_id\": str(candidate_id),\n                \"status\": status,\n            }\n        )\n        await self._redis.publish(_STATUS_CHANNEL, payload)\n        logger.info(\n            \"orchestrator.status_published\",\n            channel=_STATUS_CHANNEL,\n            status=status,\n        )\n","numLines":259,"startLine":1,"totalLines":259}}}}
