{"t":"2026-05-20T21:30:16.664Z","event":"sdk_msg","msg":{"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_01TstoKdHpbgSqAaSFAFtz6n","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01ACAnLZZXHga7GrCwZJxvGM","name":"Write","input":{"file_path":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/discovery/sources.yaml","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n#\n# Curated company slugs for the CrawlerAgent multi-source job board crawler.\n#\n# Phase 1A: Not consumed — CrawlerAgent returns fixtures.\n# Phase 1B: CrawlerAgent loads this file and fans out to each adapter.\n#\n# Format:\n#   greenhouse: list of Greenhouse board slugs (boards.greenhouse.io/{slug}.json)\n#   lever: list of Lever company slugs (api.lever.co/v0/postings/{slug})\n#   ashby: list of Ashby board slugs (api.ashbyhq.com/posting-api/job-board/{slug})\n#   workday: list of {tenant, board} pairs (tenant.wd*.myworkdayjobs.com/board)\n#\n# Selection criteria:\n#   - Companies known to hire for AI/ML engineering roles\n#   - Companies in music/creator economy space\n#   - Well-funded startups (Series A+) with active hiring\n#   - Enterprise companies with known AI divisions\n#   - No companies on the candidate's excluded_companies list (filtered at runtime)\n\n---\n\ngreenhouse:\n  # AI/ML focused companies\n  - anthropic\n  - openai\n  - perplexity-ai\n  - cohere\n  - character-ai\n  - stability-ai\n  - runway\n  - midjourney\n  - databricks\n  - anyscale\n  # Music/Creator economy\n  - spotify\n  - soundcloud\n  - splice\n  - bandlab\n  - audiomack\n  - distrokid\n  - amuse\n  - landr\n  - endel\n  # Fintech\n  - stripe\n  - square\n  - plaid\n  - mercury\n  - ramp\n  - brex\n  - moderntreasury\n  # High-growth startups\n  - notion\n  - figma\n  - linear\n  - vercel\n  - retool\n  - supabase\n  - neon\n  - railway\n  - render\n  - fly\n\nlever:\n  # AI/ML companies\n  - scale-ai\n  - labelbox\n  - weights-biases\n  - modal\n  - replicate\n  - huggingface\n  # Music/Creator tools\n  - splice\n  - landr\n  - output\n  - native-instruments\n  # Enterprise AI\n  - datadog\n  - newrelic\n  - elastic\n  - confluent\n  # Startups\n  - linear\n  - arc\n  - raycast\n  - warp\n  - codeium\n\nashby:\n  # AI-first companies\n  - anthropic\n  - inflection\n  - character\n  - replit\n  - cursor\n  # Infra/Platform\n  - vercel\n  - railway\n  - neon\n  - planetscale\n  - convex\n  # Creator economy\n  - beehiiv\n  - maven\n  - loom\n  - descript\n\nworkday:\n  # Enterprise companies with AI divisions\n  - tenant: apple\n    board: external\n  - tenant: google\n    board: jobs\n  - tenant: meta\n    board: careers\n  - tenant: amazon\n    board: jobs\n  - tenant: netflix\n    board: jobs\n  - tenant: salesforce\n    board: careers\n  - tenant: adobe\n    board: external\n  - tenant: nvidia\n    board: careers\n  - tenant: intel\n    board: jobs\n  - tenant: microsoft\n    board: careers\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":331,"cache_read_input_tokens":93870,"cache_creation":{"ephemeral_5m_input_tokens":331,"ephemeral_1h_input_tokens":0},"output_tokens":965,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"5f3115d2-23da-4ef5-8305-ddd25a86d8c7","uuid":"26f686b6-2d6c-4583-a5c1-88d657be52ac"}}
