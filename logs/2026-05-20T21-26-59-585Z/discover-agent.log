{"t":"2026-05-20T21:27:39.441Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XZ7pUhsYba6KbZqVTH7pTy","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→SQLAlchemy ORM models for the Discovery Engine.\n     6→\n     7→Tables:\n     8→  - candidates: Job seeker profiles with resume, preferences, exclusions\n     9→  - discovered_jobs: Raw jobs from crawler sources\n    10→  - scored_jobs: Jobs scored against candidate profile (6-dim)\n    11→  - daily_digests: Compiled digest per candidate per day\n    12→  - crawl_runs: Crawler execution tracking\n    13→\"\"\"\n    14→\n    15→import uuid\n    16→from datetime import datetime, date\n    17→from typing import Optional\n    18→\n    19→from sqlalchemy import (\n    20→    String, Text, Integer, Boolean, Date, DateTime,\n    21→    ForeignKey, CheckConstraint, func, Enum,\n    22→)\n    23→from sqlalchemy.orm import Mapped, mapped_column, relationship\n    24→from sqlalchemy.dialects.postgresql import UUID, ARRAY, JSONB\n    25→import enum\n    26→\n    27→from backend.database import Base\n    28→\n    29→\n    30→# ─── Enums ───────────────────────────────────────────────────────────────────\n    31→\n    32→class JobSource(str, enum.Enum):\n    33→    \"\"\"ATS platforms supported by the crawler.\"\"\"\n    34→    GREENHOUSE = \"greenhouse\"\n    35→    LEVER = \"lever\"\n    36→    ASHBY = \"ashby\"\n    37→    WORKDAY = \"workday\"\n    38→\n    39→\n    40→class RemotePreference(str, enum.Enum):\n    41→    \"\"\"Candidate remote work preference.\"\"\"\n    42→    REMOTE_ONLY = \"remote_only\"\n    43→    HYBRID = \"hybrid\"\n    44→    ONSITE = \"onsite\"\n    45→    FLEXIBLE = \"flexible\"\n    46→\n    47→\n    48→class CrawlRunStatus(str, enum.Enum):\n    49→    \"\"\"Status of a crawl run.\"\"\"\n    50→    QUEUED = \"QUEUED\"\n    51→    RUNNING = \"RUNNING\"\n    52→    COMPLETED = \"COMPLETED\"\n    53→    FAILED = \"FAILED\"\n    54→\n    55→\n    56→# ─── Candidate ───────────────────────────────────────────────────────────────\n    57→\n    58→class Candidate(Base):\n    59→    \"\"\"A candidate being managed by the Talent Agent system.\"\"\"\n    60→\n    61→    __tablename__ = \"candidates\"\n    62→\n    63→    id: Mapped[uuid.UUID] = mapped_column(\n    64→        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n    65→    )\n    66→    name: Mapped[str] = mapped_column(String(255), nullable=False)\n    67→    email: Mapped[str] = mapped_column(String(255), unique=True, nullable=False)\n    68→    resume_text: Mapped[Optional[str]] = mapped_column(Text)\n    69→    linkedin_url: Mapped[Optional[str]] = mapped_column(String(500))\n    70→    github_url: Mapped[Optional[str]] = mapped_column(String(500))\n    71→    personal_context: Mapped[Optional[str]] = mapped_column(Text)\n    72→    target_locations: Mapped[list[str]] = mapped_column(\n    73→        ARRAY(String), server_default=\"{}\", nullable=False\n    74→    )\n    75→    remote_preference: Mapped[RemotePreference] = mapped_column(\n    76→        Enum(RemotePreference, name=\"remote_preference\", create_type=False),\n    77→        server_default=\"flexible\",\n    78→        nullable=False,\n    79→    )\n    80→    min_compensation: Mapped[Optional[int]] = mapped_column(Integer)\n    81→    excluded_companies: Mapped[list[str]] = mapped_column(\n    82→        ARRAY(String), server_default=\"{}\", nullable=False\n    83→    )\n    84→    excluded_industries: Mapped[list[str]] = mapped_column(\n    85→        ARRAY(String), server_default=\"{}\", nullable=False\n    86→    )\n    87→    created_at: Mapped[datetime] = mapped_column(\n    88→        DateTime(timezone=True), server_default=func.now(), nullable=False\n    89→    )\n    90→    updated_at: Mapped[datetime] = mapped_column(\n    91→        DateTime(timezone=True), server_default=func.now(), onupdate=func.now(), nullable=False\n    92→    )\n    93→\n    94→    # Relationships\n    95→    crawl_runs: Mapped[list[\"CrawlRun\"]] = relationship(\n    96→        back_populates=\"candidate\", cascade=\"all, delete-orphan\"\n    97→    )\n    98→    daily_digests: Mapped[list[\"DailyDigest\"]] = relationship(\n    99→        back_populates=\"candidate\", cascade=\"all, delete-orphan\"\n   100→    )\n   101→    scored_jobs: Mapped[list[\"ScoredJob\"]] = relationship(\n   102→        back_populates=\"candidate\", cascade=\"all, delete-orphan\"\n   103→    )\n   104→\n   105→\n   106→# ─── Discovered Job ──────────────────────────────────────────────────────────\n   107→\n   108→class DiscoveredJob(Base):\n   109→    \"\"\"A raw job posting discovered during a crawl run.\"\"\"\n   110→\n   111→    __tablename__ = \"discovered_jobs\"\n   112→\n   113→    id: Mapped[uuid.UUID] = mapped_column(\n   114→        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n   115→    )\n   116→    source: Mapped[JobSource] = mapped_column(\n   117→        Enum(JobSource, name=\"job_source\", create_type=False), nullable=False\n   118→    )\n   119→    source_id: Mapped[str] = mapped_column(String(255), nullable=False)\n   120→    title: Mapped[str] = mapped_column(String(500), nullable=False)\n   121→    company: Mapped[str] = mapped_column(String(255), nullable=False)\n   122→    location: Mapped[Optional[str]] = mapped_column(String(255))\n   123→    description: Mapped[Optional[str]] = mapped_column(Text)\n   124→    url: Mapped[str] = mapped_column(String(1000), nullable=False)\n   125→    posted_at: Mapped[Optional[datetime]] = mapped_column(DateTime(timezone=True))\n   126→    salary_min: Mapped[Optional[int]] = mapped_column(Integer)\n   127→    salary_max: Mapped[Optional[int]] = mapped_column(Integer)\n   128→    remote: Mapped[bool] = mapped_column(Boolean, server_default=\"false\", nullable=False)\n   129→    crawled_at: Mapped[datetime] = mapped_column(\n   130→        DateTime(timezone=True), server_default=func.now(), nullable=False\n   131→    )\n   132→    created_at: Mapped[datetime] = mapped_column(\n   133→        DateTime(timezone=True), server_default=func.now(), nullable=False\n   134→    )\n   135→    updated_at: Mapped[datetime] = mapped_column(\n   136→        DateTime(timezone=True), server_default=func.now(), onupdate=func.now(), nullable=False\n   137→    )\n   138→\n   139→    # Relationships\n   140→    scored_job: Mapped[Optional[\"ScoredJob\"]] = relationship(\n   141→        back_populates=\"discovered_job\", uselist=False\n   142→    )\n   143→\n   144→    __table_args__ = (\n   145→        # Unique constraint on source + source_id\n   146→        {\"extend_existing\": True},\n   147→    )\n   148→\n   149→\n   150→# ─── Scored Job ──────────────────────────────────────────────────────────────\n   151→\n   152→class ScoredJob(Base):\n   153→    \"\"\"Scoring breakdown for a discovered job against a candidate's identity profile.\"\"\"\n   154→\n   155→    __tablename__ = \"scored_jobs\"\n   156→\n   157→    id: Mapped[uuid.UUID] = mapped_column(\n   158→        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n   159→    )\n   160→    discovered_job_id: Mapped[uuid.UUID] = mapped_column(\n   161→        ForeignKey(\"discovered_jobs.id\", ondelete=\"CASCADE\"), nullable=False\n   162→    )\n   163→    candidate_id: Mapped[uuid.UUID] = mapped_column(\n   164→        ForeignKey(\"candidates.id\", ondelete=\"CASCADE\"), nullable=False\n   165→    )\n   166→    technical_match: Mapped[int] = mapped_column(Integer, nullable=False)\n   167→    level_match: Mapped[int] = mapped_column(Integer, nullable=False)\n   168→    culture_match: Mapped[int] = mapped_column(Integer, nullable=False)\n   169→    industry_match: Mapped[int] = mapped_column(Integer, nullable=False)\n   170→    growth_potential: Mapped[int] = mapped_column(Integer, nullable=False)\n   171→    compensation_matc