awler_agent.py AshbyAdapter — httpx async,\n          api.ashbyhq.com/posting-api/job-board/{slug}\n      - id: discover-agent.crawler.workday\n        scope: backend/agents/discovery/crawler_agent.py WorkdayAdapter — playwright\n          async, {tenant}.wd1.myworkdayjobs.com/{board}\n      - id: discover-agent.scorer.relevance\n        scope: backend/agents/discovery/relevance_scorer.py — 6-dimension weighted\n          scoring + is_hot threshold\n      - id: discover-agent.digest.builder\n        scope: backend/agents/discovery/digest_builder.py — compile DailyDigest from\n          scored jobs\n      - id: discover-agent.orchestrator\n        scope: backend/agents/discovery/orchestrator.py — DiscoveryOrchestrator.run\n          wires all 5 sub-agents + CrawlRun state + agent.status.discovery\n          pub/sub\n      - id: discover-agent.pubsub\n        scope: backend/agents/discovery/orchestrator.py _publish_status helper — emit\n          events to agent.status.discovery channel per pattern from\n          application/orchestrator.py\n  - id: infra-agent\n    scope: Docker, docker-compose, AWS ECS Fargate, Digital Dash pipeline, deploy\n      scripts, Celery containers\n    branch: feat/infra-agent\n    blocked_by:\n      - api-agent\n      - frontend-agent\n      - scheduler-agent\n    blocks: []\n    capabilities:\n      - docker\n      - ecs\n      - ecr\n      - alb\n      - digital-dash\n      - celery\n    sub_agents:\n      - id: infra-agent.docker.backend\n        scope: backend/Dockerfile — python:3.12-slim, requirements caching, non-root\n          user\n        artifact: deploy/Dockerfile.backend\n      - id: infra-agent.docker.frontend\n        scope: frontend/Dockerfile — node build stage + nginx serve stage\n        artifact: deploy/Dockerfile.frontend\n      - id: infra-agent.docker.compose\n        scope: docker-compose.yml — postgres + redis + backend + frontend +\n          celery-worker + celery-beat with healthchecks\n        artifact: docker-compose.yml\n      - id: infra-agent.ecs.task-defs\n        scope: deploy/ecs-task-def-backend.json + ecs-task-def-frontend.json +\n          ecs-task-def-celery-worker.json + ecs-task-def-celery-beat.json\n        artifact: deploy/ecs-task-def-*.json\n      - id: infra-agent.ecs.bootstrap\n        scope: deploy/setup-aws.sh — one-time VPC, ALB, ECR, ECS cluster, RDS,\n          ElastiCache + Celery IAM role\n        artifact: deploy/setup-aws.sh\n      - id: infra-agent.pipeline.digital-dash\n        scope: digital-dash-pipeline.yml — build, test, push, deploy stages with\n          approval gate + deploy-celery stage\n        artifact: .github/workflows/digital-dash-pipeline.yml\n  - id: scheduler-agent\n    scope: \"Celery beat wiring: app factory, daily discovery task, beat schedule,\n      retry policy\"\n    branch: feat/scheduler-agent\n    blocked_by:\n      - data-agent\n      - discover-agent\n    blocks:\n      - infra-agent\n    capabilities:\n      - celery\n      - redis\n      - asyncio\n    sub_agents:\n      - id: scheduler-agent.app\n        scope: backend/scheduler/celery_app.py — Celery app factory reading broker URL\n          from settings.redis_url\n      - id: scheduler-agent.tasks\n        scope: backend/scheduler/tasks.py — daily_discovery_task(candidate_id) wrapping\n          async orchestrator.run\n      - id: scheduler-agent.beat\n        scope: backend/scheduler/beat.py — Beat schedule 07:00 America/New_York,\n          iterates active candidates\n      - id: scheduler-agent.retry\n        scope: backend/scheduler/tasks.py — exponential backoff 60s/300s/900s,\n          dead-letter to crawl_runs.error_log\n  - id: api-streaming-agent\n    scope: SSE event stream endpoint for real-time agent status streaming\n    branch: feat/api-streaming-agent\n    blocked_by:\n      - api-agent\n      - auth-agent\n      - obs-agent\n      - discover-agent\n    blocks:\n      - api-client-agent\n    capabilities:\n      - fastapi\n      - sse\n      - redis-pubsub\n    sub_agents:\n      - id: api-streaming-agent.events\n        scope: backend/api/events.py — GET /events/stream?channel=... SSE endpoint\n      - id: api-streaming-agent.subscriber\n        scope: backend/api/events.py — Redis pub/sub subscriber with channel allowlist\n      - id: api-streaming-agent.heartbeat\n        scope: backend/api/events.py — :ping every 15s for connection loss detection\n      - id: api-streaming-agent.backpressure\n        scope: backend/api/events.py — drop >100 messages behind, emit slow_client event\n  - id: api-client-agent\n    scope: \"Frontend API client wiring: fetch wrapper, auth token injection, page\n      data integration\"\n    branch: feat/api-client-agent\n    blocked_by:\n      - api-agent\n      - frontend-agent\n      - api-streaming-agent\n    blocks:\n      - tests-agent\n    capabilities:\n      - typescript\n      - fetch\n      - eventsource\n    sub_agents:\n      - id: api-client-agent.client\n        scope: frontend/src/api/client.ts — single apiClient instance, base URL from\n          VITE_API_BASE_URL\n      - id: api-client-agent.auth\n        scope: frontend/src/api/auth.ts — requestMagicLink, verifyToken, refreshSession,\n          JWT in localStorage\n      - id: api-client-agent.discovery\n        scope: frontend/src/api/discovery.ts — getTodayDigest, triggerDiscoveryRun,\n          getJob\n      - id: api-client-agent.applications\n        scope: frontend/src/api/applications.ts — listApplications, approveApplication,\n          rejectApplication\n      - id: api-client-agent.events\n        scope: frontend/src/api/events.ts — subscribeAgentStatus(channel, onMessage) via\n          EventSource\n      - id: api-client-agent.error-handling\n        scope: frontend/src/api/client.ts — 401 → invalidate JWT, redirect to /login,\n          toast\n      - id: api-client-agent.page-wiring\n        scope: Re-wire Overview.tsx, Pipeline.tsx, Analytics.tsx, ReviewQueue.tsx,\n          ReviewDetail.tsx to use apiClient\n  - id: tests-agent\n    scope: pytest and vitest test suites for all iter-4 biomes\n    branch: feat/tests-agent\n    blocked_by:\n      - discover-agent\n      - scheduler-agent\n      - api-streaming-agent\n      - api-client-agent\n    blocks: []\n    capabilities:\n      - pytest\n      - vitest\n      - fakeredis\n    sub_agents:\n      - id: tests-agent.discovery.pubsub\n        scope: tests/discovery/test_orchestrator_pubsub.py — fake Redis, verify 8+ event\n          sequence\n      - id: tests-agent.scheduler.daily\n        scope: tests/scheduler/test_daily_task.py — mock orchestrator, verify crawl_runs\n          creation\n      - id: tests-agent.api.events\n        scope: tests/api/test_events_stream.py — TestClient streaming, verify SSE frames\n          + heartbeat\n      - id: tests-agent.api.review\n        scope: tests/api/test_review_approve.py — full integration approve flow\n      - id: tests-agent.frontend.client\n        scope: frontend/src/api/__tests__/client.test.ts — vitest, mock fetch, 401\n          handling\n  - id: synthetics-fixtures-agent\n    scope: Synthetic candidate fixtures, JD fixtures, baseline scaffolding, seeder\n      for deterministic test data\n    branch: feat/synthetics-fixtures-agent\n    blocked_by: []\n    blocks:\n      - synthetics-scoring-agent\n      - synthetics-crawler-agent\n    capabilities:\n      - pydantic\n      - pyyaml\n      - uuid5\n    sub_agents:\n      - id: synthetics-fixtures-agent.candidates\n        scope: synthetics/fixtures/candidates.yaml — 3 synthetic candidates with full\n          resume text + identity context\n      - id: synthetics-fixtures-agent.jobs\n        scope: synthetics/fixtures/jobs/ — 12 JD markdown files with expected_hot +\n          expected_score_band frontmatter\n      - id: synthetics-fixtures-agent.baselines\n        scope: synthetics/fixtures/baselines/ — gitignored scaffold for baseline\n          fingerprints\n      - id: synthetics-fixtures-agent.seeder\n        scope: synthetics/fixtures/seeder.py — idempotent loader that upserts synthetic\n          candidates into Postgres on backend boot\n  - id: synthetics-scoring-agent\n    scope: Deterministic scoring drift detection via fingerprinting and diffing\n      against accepted baselines\n    branch: feat/synthetics-scoring-agent\n    blocked_by:\n      - synthetics-fixtures-agent\n    blocks: []\n    capabilities:\n      - anthropic-sdk\n      - pydantic\n      - structlog\n    sub_agents:\n      - id: synthetics-scoring-agent.runner\n        scope: backend/synthetics/scoring_runner.py — ScoringSyntheticRunner.run_suite()\n          iterates synthetic candidates × JDs\n      - id: synthetics-scoring-agent.fingerprint\n        scope: backend/synthetics/fingerprint.py — compute_fingerprint(digest, contract)\n          produces stable JSON per candidate\n      - id: synthetics-scoring-agent.diff\n        scope: backend/synthetics/diff.py — diff_against_baseline(fingerprint, baseline,\n          contract) returns DriftReport\n      - id: synthetics-scoring-agent.cli\n        scope: backend/synthetics/cli.py — python -m backend.synthetics run\n          --suite=scoring\n      - id: synthetics-scoring-agent.cache-verification\n        scope: backend/synthetics/scoring_runner.py — verify cache_creation_input_tokens\n          == 0 on subsequent runs\n  - id: synthetics-crawler-agent\n    scope: Upstream health monitoring with state machine alerts for consecutive\n      failures\n    branch: feat/synthetics-crawler-agent\n    blocked_by:\n      - synthetics-fixtures-agent\n    blocks: []\n    capabilities:\n      - httpx\n      - redis-pubsub\n      - structlog\n    sub_agents:\n      - id: synthetics-crawler-agent.runner\n        scope: backend/synthetics/crawler_health.py — CrawlerHealthRunner.run_suite()\n          hits known-good slugs per source\n      - id: synthetics-crawler-agent.schemas\n        scope: backend/synthetics/expected_schema_v1.json — expected top-level shape for\n          Greenhouse/Lever/Ashby\n      - id: synthetics-crawler-agent.state-machine\n        scope: synthetics/state.json — consecutive_failures tracking with 3-strike alert\n          threshold\n      - id: synthetics-crawler-agent.beat-extension\n        scope: backend/synthetics/beat_schedule.py — hourly Celery beat entry for\n          crawler health, registered additively\nmerge_order:\n  - data-agent\n  - design-agent\n  - auth-agent\n  - obs-agent\n  - discover-agent\n  - apply-agent\n  - agents-agent\n  - api-agent\n  - scheduler-agent\n  - api-streaming-agent\n  - frontend-agent\n  - api-client-agent\n  - infra-agent\n  - tests-agent\n  - synthetics-fixtures-agent\n  - synthetics-scoring-agent\n  - synthetics-crawler-agent\ntimeline:\n  parallel_phases:\n    - hours: 0-1\n      active:\n        - data-agent\n        - design-agent\n      description: Wave 1 — foundations with zero cross-biome deps. Schemas + models +\n        design tokens land first so every downstream biome consumes frozen\n        contracts.\n    - hours: 1-3\n      active:\n        - auth-agent\n        - obs-agent\n      description: Wave 2 — core services depending only on data. Auth + observability\n        wire on top of the schema, both consumed by every engine below.\n    - hours: 3-5\n      active:\n        - discover-agent\n      description: Wave 3a — Discovery engine with pub/sub gap closure. Must publish\n        events on agent.status.discovery channel.\n    - hours: 5-7\n      active:\n        - scheduler-agent\n        - api-streaming-agent\n      description: Wave 3b — Scheduler and streaming in parallel. Scheduler consumes\n        discover-agent, streaming consumes obs-agent.\n    - hours: 7-8\n      active:\n        - apply-agent\n      description: Wave 4 — Application engine, blocked by discover-agent.\n    - hours: 8-9\n      active:\n        - agents-agent\n      description: Wave 5 — AgentManager wrapper over the engines.\n    - hours: 9-11\n      active:\n        - api-agent\n        - frontend-agent\n      description: Wave 6 — Surfaces. API + frontend land in parallel.\n    - hours: 11-12\n      active:\n        - api-client-agent\n      description: Wave 7 — Frontend API wiring, blocked by api-agent + api-streaming-agent.\n    - hours: 12-13\n      active:\n        - infra-agent\n      description: Wave 8 — Deploy. Docker + ECS + Digital Dash pipeline with Celery\n        containers.\n    - hours: 13-14\n      active:\n        - tests-agent\n      description: Wave 9 — Test sweep across all iter-4 biomes.\n    - hours: 14-15\n      active:\n        - synthetics-fixtures-agent\n      description: Wave 10 — Fixtures land first. Synthetic candidates + JDs + seeder.\n    - hours: 15-17\n      active:\n        - synthetics-scoring-agent\n        - synthetics-crawler-agent\n      description: Wave 11 — Scoring + crawler health run in parallel, both consume\n        fixtures.\nbudget:\n  maxUsd: 100\n","numLines":804,"startLine":1,"totalLines":804}}}}
