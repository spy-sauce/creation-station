{"t":"2026-05-28T03:42:36.033Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012n7qbTGEnpWh9y1yuj8jjs","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Scoring Synthetic Runner — iterates synthetic candidates × JD fixtures.\n     6→\n     7→Executes the RelevanceScorer against synthetic candidates with cache-aware\n     8→instrumentation. Tracks cache hit/miss rates from Claude API responses.\n     9→\n    10→The scorer module (RelevanceScorer) is FROZEN. To enforce the cache contract\n    11→(NUTRIENTS.md §I.5), this runner wraps Claude API calls with cache_control\n    12→headers by providing a wrapper client that intercepts and augments requests.\n    13→\n    14→Contract: NUTRIENTS.md §I.2-I.5, HYPHA-SYNTHETICS-SCORING.md\n    15→Owner: synthetics-scoring-agent.runner\n    16→\"\"\"\n    17→\n    18→from __future__ import annotations\n    19→\n    20→import json\n    21→import re\n    22→import uuid\n    23→from dataclasses import dataclass, field\n    24→from datetime import datetime, timezone\n    25→from pathlib import Path\n    26→from typing import Optional\n    27→\n    28→import redis.asyncio as aioredis\n    29→import structlog\n    30→import yaml\n    31→from anthropic import AsyncAnthropic\n    32→from pydantic import BaseModel, Field\n    33→from sqlalchemy import text\n    34→from sqlalchemy.ext.asyncio import AsyncSession\n    35→\n    36→from backend.agents.discovery.identity_profiler import IdentityProfiler\n    37→from backend.agents.discovery.relevance_scorer import RelevanceScorer\n    38→from backend.agents.discovery.schemas import (\n    39→    CandidateSchema,\n    40→    DiscoveredJobSchema,\n    41→    IdentityProfileSchema,\n    42→    ScoredJobSchema,\n    43→)\n    44→\n    45→logger = structlog.get_logger(__name__)\n    46→\n    47→\n    48→# ─── Cache Statistics ────────────────────────────────────────────────────────\n    49→\n    50→\n    51→@dataclass\n    52→class CacheStats:\n    53→    \"\"\"Tracks cache hit/miss statistics for Claude API calls.\"\"\"\n    54→\n    55→    total_calls: int = 0\n    56→    cache_creation_tokens: int = 0\n    57→    cache_read_tokens: int = 0\n    58→\n    59→    @property\n    60→    def cache_hits(self) -> int:\n    61→        \"\"\"Number of calls that hit the cache.\"\"\"\n    62→        # A cache hit is when cache_read_input_tokens > 0\n    63→        return self._hit_count\n    64→\n    65→    @property\n    66→    def cache_misses(self) -> int:\n    67→        \"\"\"Number of calls that missed the cache.\"\"\"\n    68→        return self.total_calls - self._hit_count\n    69→\n    70→    @property\n    71→    def cache_hit_rate(self) -> float:\n    72→        \"\"\"Cache hit rate as a ratio 0.0-1.0.\"\"\"\n    73→        if self.total_calls == 0:\n    74→            return 0.0\n    75→        return self._hit_count / self.total_calls\n    76→\n    77→    _hit_count: int = field(default=0, init=False)\n    78→\n    79→    def record_call(\n    80→        self,\n    81→        cache_creation_input_tokens: int,\n    82→        cache_read_input_tokens: int,\n    83→    ) -> None:\n    84→        \"\"\"Record a Claude API call's cache statistics.\"\"\"\n    85→        self.total_calls += 1\n    86→        self.cache_creation_tokens += cache_creation_input_tokens\n    87→        self.cache_read_tokens += cache_read_input_tokens\n    88→        if cache_read_input_tokens > 0:\n    89→            self._hit_count += 1\n    90→\n    91→\n    92→# ─── JD Fixture Loading ──────────────────────────────────────────────────────\n    93→\n    94→\n    95→class JDFixture(BaseModel):\n    96→    \"\"\"A JD fixture loaded from synthetics/fixtures/jobs/.\"\"\"\n    97→\n    98→    filename: str\n    99→    target_candidate: str\n   100→    expected_hot: bool\n   101→    expected_score_band: str  # low | mid | high\n   102→    source: str\n   103→    title: str\n   104→    company: str\n   105→    location: Optional[str] = None\n   106→    description: str\n   107→    url: str = \"\"\n   108→\n   109→\n   110→def load_jd_fixtures(fixtures_dir: Path) -> list[JDFixture]:\n   111→    \"\"\"\n   112→    Load all JD fixtures from the jobs directory.\n   113→\n   114→    Each fixture is a markdown file with YAML frontmatter.\n   115→\n   116→    Args:\n   117→        fixtures_dir: Path to synthetics/fixtures/jobs/\n   118→\n   119→    Returns:\n   120→        List of JDFixture objects\n   121→    \"\"\"\n   122→    fixtures: list[JDFixture] = []\n   123→    jobs_dir = fixtures_dir / \"jobs\"\n   124→\n   125→    if not jobs_dir.exists():\n   126→        logger.warning(\"jd_fixtures.dir_not_found\", path=str(jobs_dir))\n   127→        return fixtures\n   128→\n   129→    for md_file in jobs_dir.glob(\"*.md\"):\n   130→        try:\n   131→            fixture = _parse_jd_fixture(md_file)\n   132→            fixtures.append(fixture)\n   133→            logger.debug(\n   134→                \"jd_fixtures.loaded\",\n   135→                filename=md_file.name,\n   136→                target=fixture.target_candidate,\n   137→            )\n   138→        except Exception as e:\n   139→            logger.error(\n   140→                \"jd_fixtures.parse_error\",\n   141→                filename=md_file.name,\n   142→                error=str(e),\n   143→            )\n   144→\n   145→    logger.info(\"jd_fixtures.loaded_all\", count=len(fixtures))\n   146→    return fixtures\n   147→\n   148→\n   149→def _parse_jd_fixture(path: Path) -> JDFixture:\n   150→    \"\"\"Parse a single JD fixture markdown file with YAML frontmatter.\"\"\"\n   151→    content = path.read_text()\n   152→\n   153→    # Split frontmatter from body\n   154→    if not content.startswith(\"---\"):\n   155→        raise ValueError(f\"No YAML frontmatter in {path.name}\")\n   156→\n   157→    parts = content.split(\"---\", 2)\n   158→    if len(parts) < 3:\n   159→        raise ValueError(f\"Invalid frontmatter format in {path.name}\")\n   160→\n   161→    frontmatter = yaml.safe_load(parts[1])\n   162→    body = parts[2].strip()\n   163→\n   164→    return JDFixture(\n   165→        filename=path.name,\n   166→        target_candidate=frontmatter[\"target_candidate\"],\n   167→        expected_hot=frontmatter[\"expected_hot\"],\n   168→        expected_score_band=frontmatter[\"expected_score_band\"],\n   169→        source=frontmatter.get(\"source\", \"greenhouse\"),\n   170→        title=frontmatter.get(\"title\", \"Unknown Title\"),\n   171→        company=frontmatter.get(\"company\", \"Unknown Company\"),\n   172→        location=frontmatter.get(\"location\"),\n   173→        description=body,\n   174→        url=frontmatter.get(\"url\", f\"https://example.com/jobs/{path.stem}\"),\n   175→    )\n   176→\n   177→\n   178→# ─── Synthetic Candidate Loading ─────────────────────────────────────────────\n   179→\n   180→\n   181→async def load_synthetic_candidates(\n   182→    session: AsyncSession,\n   183→) -> list[CandidateSchema]:\n   184→    \"\"\"\n   185→    Load synthetic candidates from the database.\n   186→\n   187→    Synthetic candidates are identified by UUIDv5 markers matching\n   188→    the pattern: id::text LIKE '00000000-%'\n   189→\n   190→    Contract: NUTRIENTS.md §I.1\n   191→\n   192→    Args:\n   193→        session: Async SQLAlchemy session\n   194→\n   195→    Returns:\n   196→        List of CandidateSchema for synthetic candidates\n   197→    \"\"\"\n   198→    # Query candidates with synthetic UUID pattern\n   199→    result = await session.execute(\n   200→        text(\"\"\"\n   201→            SELECT\n   202→                id, name, email, resume_text, linkedin_url, github_url,\n   203→                personal_context, target_locations, remote_preference,\n   204→                min_compensation, excluded_companies, excluded_industries,\n   205→                created_at, updated_at\n   206→            FROM candidates\n   207→            WHERE id::text LIKE '00000000-%'\n   208→            ORDER BY name\n   209→        \"\"\")\n   210→    )\n   211→\n   212→    candidates: list[CandidateSchema] = []\n   213→    for row in result.fetchall():\n   214→        candidates.append(\n   215→            CandidateSchema(\n   216→                id=row.id,\n   217→                name=row.name,\n   218→                email=row.email,\n   219→                resume_text=row.resume_text or \"\",\n   220→                linkedin_url=row.linkedin_url,\n   221→                github_url=row.github_url,\n   222→                personal_context=row.personal_context,\n   223→                target_locations=list(row.target_locations or []),\n   224→                remote_preference=row.remote_preference or \"flexible\",\n   225→                min_compensation=row.min_compensation,\n   226→                excluded_companies=list(row.excluded_companies or []),\n   227→                excluded_industries=list(row.excluded_industries or []),\n   228→                created_at=row.created_at,\n   229→                updated_at=row.updated_at,\n   230→            )\n   231→        )\n   232→\n   233→    logger.info(\n   234→        \"synthetic_candidates.loaded\",\n   235→        count=len(candidates),\n   236→        ids=[str(c.id) for c in candidates],\n   237→    )\n   238→    return candidates\n   239→\n   240→\n   241→# ─── Cache-Aware Claude Wrapper ──────────────────────────────────────────────\n   242→\n   243→\n   244→class CacheAwareAnthropic:\n   245→    \"\"\"\n   246→    Wrapper around AsyncAnthropic that enforces cache_control headers.\n   247→\n   248→    The RelevanceScorer is FROZEN and doesn't set cache_control.\n   249→    This wrapper intercepts message creation and adds the required\n   250→    cache_control headers per NUTRIENTS.md §I.5.\n   251→    \"\"\"\n   252→\n   253→    def __init__(\n   254→        self,\n   255→        client: AsyncAnthropic,\n   256→        cache_stats: CacheStats,\n   257→        candidate_identity: str,\n   258→    ):\n   259→        \"\"\"\n   260→        Initialize the cache-aware wrapper.\n   261→\n   262→        Args:\n   263→            client: The underlying AsyncAnthropic client\n   264→            cache_stats: CacheStats object to record metrics\n   265→            candidate_identity: Candidate identity text to cache\n   266→        \"\"\"\n   267→        self._client = client\n   268→        self._cache_stats = cache_stats\n   269→        self._candidate_identity = candidate_identity\n   270→        self.messages = _CacheAwareMessages(self)\n   271→\n   272→\n   273→class _CacheAwareMessages:\n   274→    \"\"\"Wraps the messages API to add cache_control.\"\"\"\n   275→\n   276→    def __init__(self, wrapper: CacheAwareAnthropic):\n   277→        self._wrapper = wrapper\n   278→\n   279→    async def create(self, **kwargs) -> object:\n   280→        \"\"\"\n   281→        Create a message with cache_control headers.\n   282→\n   283→        Transforms the messages to include cache_control on system prompt\n   284→        and candidate identity per NUTRIENTS.md §I.5.\n   285→        \"\"\"\n   286→        # Extract original messages\n   287→        messages = kwargs.get(\"messages\", [])\n   288→\n   289→        # Transform to use cache_control\n   290→        transformed_messages = []\n   291→        for msg in messages:\n   292→            if msg.get(\"role\") == \"user\":\n   293→                content = msg.get(\"content\", \"\")\n   294→                if isinstance(content, str):\n   295→                    # Split into cacheable parts\n   296→                    transformed_messages.append(\n   297→                        {\n   298→                            \"role\": \"user\",\n   299→                            \"content\": [\n   300→                                {\n   301→                                    \"type\": \"text\",\n   302→                                    \"text\": self._wrapper._candidate_identity,\n   303→                                    \"cache_control\": {\"type\": \"ephemeral\"},\n   304→                                },\n   305→                                {\n   306→                                    \"type\": \"text\",\n   307→                                    \"text\": content,\n   308→                                },\n   309→                            ],\n   310→                        }\n   311→                    )\n   312→                else:\n   313→                    # Already structured, just pass through\n   314→                    transformed_messages.append(msg)\n   315→            else:\n   316→                transformed_messages.append(msg)\n   317→\n   318→        # Add system prompt with cache_control\n   319→        system_content = [\n   320→            {\n   321→                \"type\": \"text\",\n   322→                \"text\": (\n   323→                    \"You are a talent agent scoring jobs against candidate profiles. \"\n   324→                    \"Return structured JSON responses.\"\n   325→                ),\n   326→                \"cache_control\": {\"type\": \"ephemeral\"},\n   327→            }\n   328→        ]\n   329→\n   330→        # Make the request\n   331→        kwargs[\"messages\"] = transformed_messages\n   332→        kwargs[\"system\"] = system_content\n   333→\n   334→        response = await self._wrapper._client.messages.create(**kwargs)\n   335→\n   336→        # Record cache statistics\n   337→        usage = response.usage\n   338→        cache_creation = getattr(usage, \"cache_creation_input_tokens\", 0) or 0\n   339→        cache_read = getattr(usage, \"cache_read_input_tokens\", 0) or 0\n   340→\n   341→        self._wrapper._cache_stats.record_call(cache_creation, cache_read)\n   342→\n   343→        logger.debug(\n   344→            \"cache_aware.request_complete\",\n   345→            cache_creation_tokens=cache_creation,\n   346→            cache_read_tokens=cache_read,\n   347→            total_calls=self._wrapper._cache_stats.total_calls,\n   348→        )\n   349→\n   350→        return response\n   351→\n   352→\n   353→# ─── Scored Result ───────────────────────────────────────────────────────────\n   354→\n   355→\n   356→class ScoredResult(BaseModel):\n   357→    \"\"\"Result of scoring a single candidate × JD pair.\"\"\"\n   358→\n   359→    candidate_id: str\n   360→    candidate_name: str\n   361→    jd_filename: str\n   362→    scored_job: Optional[ScoredJobSchema] = None\n   363→    expected_hot: bool\n   364→    expected_score_band: str\n   365→    actual_hot: bool = False\n   366→    actual_score: int = 0\n   367→    error: Optional[str] = None\n   368→\n   369→\n   370→class CandidateScoringResult(BaseModel):\n   371→    \"\"\"All scoring results for a single candidate.\"\"\"\n   372→\n   373→    candidate_id: str\n   374→    candidate_name: str\n   375→    profile: Optional[IdentityProfileSchema] = None\n   376→    scored_results: list[ScoredResult] = Field(default_factory=list)\n   377→    cache_stats: dict = Field(default_factory=dict)\n   378→    error: Optional[str] = None\n   379→\n   380→\n   381→# ─── Scoring Runner ──────────────────────────────────────────────────────────\n   382→\n   383→\n   384→class ScoringSyntheticRunner:\n   385→    \"\"\"\n   386→    Iterates synthetic candidates × JD fixtures for drift detection.\n   387→\n   388→    This runner:\n   389→    1. Loads synthetic candidates from the database\n   390→    2. Loads JD fixtures from synthetics/fixtures/jobs/\n   391→    3. For each candidate × JD pair, scores via RelevanceScorer\n   392→    4. Tracks cache hit/miss from Claude API responses\n   393→    5. Returns structured results for fingerprinting\n   394→\n   395→    Contract: NUTRIENTS.md §I.2-I.5, HYPHA-SYNTHETICS-SCORING.md\n   396→    \"\"\"\n   397→\n   398→    def __init__(\n   399→        self,\n   400→        session: AsyncSession,\n   401→        redis_client: aioredis.Redis,\n   402→        anthropic_client: AsyncAnthropic,\n   403→        fixtures_dir: Optional[Path] = None,\n   404→    ):\n   405→        \"\"\"\n   406→        Initialize the ScoringSyntheticRunner.\n   407→\n   408→        Args:\n   409→            session: Async SQLAlchemy session for database access\n   410→            redis_client: Async Redis client for caching\n   411→            anthropic_client: Async Anthropic client for Claude API\n   412→            fixtures_dir: Path to synthetics/fixtures/ (default: auto-detect)\n   413→        \"\"\"\n   414→        self._session = session\n   415→        self._redis = redis_client\n   416→        self._anthropic = anthropic_client\n   417→\n   418→        # Auto-detect fixtures directory if not provided\n   419→        if fixtures_dir is None:\n   420→            self._fixtures_dir = Path(__file__).parent.parent.parent / \"synthetics\" / \"fixtures\"\n   421→        else:\n   422→            self._fixtures_dir = fixtures_dir\n   423→\n   424→        self._run_id = str(uuid.uuid4())\n   425→\n   426→    async def run_suite(self) -> dict:\n   427→        \"\"\"\n   428→        Execute the full scoring suite.\n   429→\n   430→        Iterates all synthetic candidates × applicable JD fixtures,\n   431→        scoring each pair and collecting results.\n   432→\n   433→        Returns:\n   434→            dict with:\n   435→                - run_id: UUID of this run\n   436→                - started_at: ISO timestamp\n   437→                - completed_at: ISO timestamp\n   438→                - candidates: list of CandidateScoringResult\n   439→                - overall_cache_stats: aggregated cache statistics\n   440→        \"\"\"\n   441→        started_at = datetime.now(timezone.utc)\n   442→\n   443→        logger.info(\n   444→            \"scoring_runner.suite_start\",\n   445→            run_id=self._run_id,\n   446→            fixtures_dir=str(self._fixtures_dir),\n   447→        )\n   448→\n   449→        # Load synthetic candidates\n   450→        candidates = await load_synthetic_candidates(self._session)\n   451→        if not candidates:\n   452→            logger.warning(\"scoring_runner.no_candidates\")\n   453→            return {\n   454→                \"run_id\": self._run_id,\n   455→                \"started_at\": started_at.isoformat(),\n   456→                \"completed_at\": datetime.now(timezone.utc).isoformat(),\n   457→                \"candidates\": [],\n   458→                \"overall_cache_stats\": {\"total_calls\": 0, \"cache_hit_rate\": 0.0},\n   459→            }\n   460→\n   461→        # Load JD fixtures\n   462→        jd_fixtures = load_jd_fixtures(self._fixtures_dir)\n   463→        if not jd_fixtures:\n   464→            logger.warning(\"scoring_runner.no_fixtures\")\n   465→            return {\n   466→                \"run_id\": self._run_id,\n   467→                \"started_at\": started_at.isoformat(),\n   468→                \"completed_at\": datetime.now(timezone.utc).isoformat(),\n   469→                \"candidates\": [],\n   470→                \"overall_cache_stats\": {\"total_calls\": 0, \"cache_hit_rate\": 0.0},\n   471→            }\n   472→\n   473→        # Build mapping of candidate slug to JD fixtures\n   474→        candidate_slug_map = self._build_candidate_slug_map(candidates)\n   475→\n   476→        # Process each candidate\n   477→        all_results: list[CandidateScoringResult] = []\n   478→        overall_cache_stats = CacheStats()\n   479→\n   480→        for candidate in candidates:\n   481→            result = await self._score_candidate(\n   482→                candidate,\n   483→                jd_fixtures,\n   484→                candidate_slug_map,\n   485→                overall_cache_stats,\n   486→            )\n   487→            all_results.append(result)\n   488→\n   489→        completed_at = datetime.now(timezone.utc)\n   490→\n   491→        logger.info(\n   492→            \"scoring_runner.suite_complete\",\n   493→            run_id=self._run_id,\n   494→            candidates_processed=len(all_results),\n   495→            total_claude_calls=overall_cache_stats.total_calls,\n   496→            cache_hit_rate=round(overall_cache_stats.cache_hit_rate, 4),\n   497→            duration_seconds=(completed_at - started_at).total_seconds(),\n   498→        )\n   499→\n   500→        return {\n   501→            \"run_id\": self._run_id,\n   502→            \"started_at\": started_at.isoformat(),\n   503→            \"completed_at\": completed_at.isoformat(),\n   504→            \"candidates\": [r.model_dump() for r in all_results],\n   505→            \"overall_cache_stats\": {\n   506→                \"total_calls\": overall_cache_stats.total_calls,\n   507→                \"cache_hits\": overall_cache_stats.cache_hits,\n   508→                \"cache_misses\": overall_cache_stats.cache_misses,\n   509→                \"cache_hit_rate\": round(overall_cache_stats.cache_hit_rate, 4),\n   510→                \"cache_creation_tokens\": overall_cache_stats.cache_creation_tokens,\n   511→                \"cache_read_tokens\": overall_cache_stats.cache_read_tokens,\n   512→            },\n   513→        }\n   514→\n   515→    def _build_candidate_slug_map(\n   516→        self,\n   517→        candidates: list[CandidateSchema],\n   518→    ) -> dict[str, CandidateSchema]:\n   519→        \"\"\"\n   520→        Build a mapping of synthetic slugs to candidates.\n   521→\n   522→        Derives the slug from the candidate's email prefix:\n   523→            jordan.chen.synthetic@... → synthetic-jr-engineer (from name pattern)\n   524→        \"\"\"\n   525→        slug_map: dict[str, CandidateSchema] = {}\n   526→\n   527→        for candidate in candidates:\n   528→            # Extract slug from email pattern or name\n   529→            email = candidate.email.lower()\n   530→\n   531→            if \"jordan\" in email or \"chen\" in email:\n   532→                slug_map[\"synthetic-jr-engineer\"] = candidate\n   533→            elif \"priya\" in email or \"ramanathan\" in email:\n   534→                slug_map[\"synthetic-senior-ml\"] = candidate\n   535→            elif \"marcus\" in email or \"thompson\" in email:\n   536→                slug_map[\"synthetic-mid-product\"] = candidate\n   537→            else:\n   538→                # Fallback: use email prefix\n   539→                prefix = email.split(\"@\")[0].replace(\".\", \"-\")\n   540→                slug_map[prefix] = candidate\n   541→\n   542→        logger.debug(\n   543→            \"candidate_slug_map.built\",\n   544→            slugs=list(slug_map.keys()),\n   545→        )\n   546→        return slug_map\n   547→\n   548→    async def _score_candidate(\n   549→        self,\n   550→        candidate: CandidateSchema,\n   551→        jd_fixtures: list[JDFixture],\n   552→        slug_map: dict[str, CandidateSchema],\n   553→        overall_cache_stats: CacheStats,\n   554→    ) -> CandidateScoringResult:\n   555→        \"\"\"\n   556→        Score all applicable JD fixtures for a single candidate.\n   557→\n   558→        Args:\n   559→            candidate: The synthetic candidate\n   560→            jd_fixtures: All JD fixtures\n   561→            slug_map: Mapping of slugs to candidates\n   562→            overall_cache_stats: Aggregated cache stats\n   563→\n   564→        Returns:\n   565→            CandidateScoringResult with all scoring results\n   566→        \"\"\"\n   567→        # Determine which slug this candidate maps to\n   568→        candidate_slug = None\n   569→        for slug, cand in slug_map.items():\n   570→            if cand.id == candidate.id:\n   571→                candidate_slug = slug\n   572→                break\n   573→\n   574→        if not candidate_slug:\n   575→            logger.warning(\n   576→                \"scoring_runner.unknown_slug\",\n   577→                candidate_id=str(candidate.id),\n   578→                candidate_name=candidate.name,\n   579→            )\n   580→            return CandidateScoringResult(\n   581→                candidate_id=str(candidate.id),\n   582→                candidate_name=candidate.name,\n   583→                error=\"Could not determine candidate slug\",\n   584→            )\n   585→\n   586→        # Filter JD fixtures for this candidate\n   587→        applicable_jds = [\n   588→            jd for jd in jd_fixtures if jd.target_candidate == candidate_slug\n   589→        ]\n   590→\n   591→        logger.info(\n   592→            \"scoring_runner.candidate_start\",\n   593→            candidate_id=str(candidate.id),\n   594→            candidate_name=candidate.name,\n   595→            slug=candidate_slug,\n   596→            applicable_jds=len(applicable_jds),\n   597→        )\n   598→\n   599→        # Build identity profile first\n   600→        candidate_identity = self._build_candidate_identity_text(candidate)\n   601→        cache_stats = CacheStats()\n   602→\n   603→        # Create cache-aware wrapper for this candidate\n   604→        cache_client = CacheAwareAnthropic(\n   605→            self._anthropic,\n   606→            cache_stats,\n   607→            candidate_identity,\n   608→        )\n   609→\n   610→        # Build profile via IdentityProfiler\n   611→        profiler = IdentityProfiler(self._redis, cache_client)\n   612→        try:\n   613→            profile = await profiler.build_profile(candidate)\n   614→        except Exception as e:\n   615→            logger.error(\n   616→                \"scoring_runner.profile_error\",\n   617→                candidate_id=str(candidate.id),\n   618→                error=str(e),\n   619→            )\n   620→            return CandidateScoringResult(\n   621→                candidate_id=str(candidate.id),\n   622→                candidate_name=candidate.name,\n   623→                error=f\"Failed to build profile: {e}\",\n   624→            )\n   625→\n   626→        # Create scorer with cache-aware client\n   627→        scorer = RelevanceScorer(cache_client)\n   628→\n   629→        # Score each applicable JD\n   630→        scored_results: list[ScoredResult] = []\n   631→\n   632→        for jd in applicable_jds:\n   633→            result = await self._score_single_jd(\n   634→                candidate,\n   635→                profile,\n   636→                jd,\n   637→                scorer,\n   638→            )\n   639→            scored_results.append(result)\n   640→\n   641→        # Aggregate cache stats into overall\n   642→        overall_cache_stats.total_calls += cache_stats.total_calls\n   643→        overall_cache_stats.cache_creation_tokens += cache_stats.cache_creation_tokens\n   644→        overall_cache_stats.cache_read_tokens += cache_stats.cache_read_tokens\n   645→        overall_cache_stats._hit_count += cache_stats._hit_count\n   646→\n   647→        logger.info(\n   648→            \"scoring_runner.candidate_complete\",\n   649→            candidate_id=str(candidate.id),\n   650→            scored_count=len(scored_results),\n   651→            cache_calls=cache_stats.total_calls,\n   652→            cache_hit_rate=round(cache_stats.cache_hit_rate, 4),\n   653→        )\n   654→\n   655→        return CandidateScoringResult(\n   656→            candidate_id=str(candidate.id),\n   657→            candidate_name=candidate.name,\n   658→            profile=profile,\n   659→            scored_results=scored_results,\n   660→            cache_stats={\n   661→                \"total_calls\": cache_stats.total_calls,\n   662→                \"cache_hits\": cache_stats.cache_hits,\n   663→                \"cache_misses\": cache_stats.cache_misses,\n   664→                \"cache_hit_rate\": round(cache_stats.cache_hit_rate, 4),\n   665→            },\n   666→        )\n   667→\n   668→    def _build_candidate_identity_text(self, candidate: CandidateSchema) -> str:\n   669→        \"\"\"\n   670→        Build the candidate identity text for caching.\n   671→\n   672→        This text is prepended to all Claude calls for this candidate\n   673→        and marked with cache_control.\n   674→        \"\"\"\n   675→        return f\"\"\"# CANDIDATE IDENTITY\n   676→\n   677→Name: {candidate.name}\n   678→Location: {\", \".join(candidate.target_locations) if candidate.target_locations else \"Flexible\"}\n   679→Remote Preference: {candidate.remote_preference}\n   680→Min Compensation: {candidate.min_compensation or \"Not specified\"}\n   681→Excluded Companies: {\", \".join(candidate.excluded_companies) if candidate.excluded_companies else \"None\"}\n   682→Excluded Industries: {\", \".join(candidate.excluded_industries) if candidate.excluded_industries else \"None\"}\n   683→\n   684→## Resume\n   685→{candidate.resume_text}\n   686→\n   687→## Personal Context\n   688→{candidate.personal_context or \"Not provided\"}\n   689→\"\"\"\n   690→\n   691→    async def _score_single_jd(\n   692→        self,\n   693→        candidate: CandidateSchema,\n   694→        profile: IdentityProfileSchema,\n   695→        jd: JDFixture,\n   696→        scorer: RelevanceScorer,\n   697→    ) -> ScoredResult:\n   698→        \"\"\"\n   699→        Score a single candidate × JD pair.\n   700→\n   701→        Args:\n   702→            candidate: The synthetic candidate\n   703→            profile: The candidate's identity profile\n   704→            jd: The JD fixture\n   705→            scorer: RelevanceScorer instance\n   706→\n   707→        Returns:\n   708→            ScoredResult with scoring details\n   709→        \"\"\"\n   710→        logger.debug(\n   711→            \"scoring_runner.scoring_jd\",\n   712→            candidate_id=str(candidate.id),\n   713→            jd_filename=jd.filename,\n   714→        )\n   715→\n   716→        # Convert JD fixture to DiscoveredJobSchema\n   717→        discovered_job = DiscoveredJobSchema(\n   718→            id=uuid.uuid5(uuid.NAMESPACE_DNS, f\"synthetic-jd-{jd.filename}\"),\n   719→            source=jd.source,\n   720→            source_id=f\"synthetic-{jd.filename}\",\n   721→            title=jd.title,\n   722→            company=jd.company,\n   723→            location=jd.location,\n   724→            description=jd.description,\n   725→            url=jd.url,\n   726→            posted_at=None,\n   727→            salary_min=None,\n   728→            salary_max=None,\n   729→            remote=False,\n   730→            crawled_at=datetime.now(timezone.utc),\n   731→        )\n   732→\n   733→        try:\n   734→            scored_job = await scorer.score_job(\n   735→                discovered_job,\n   736→                profile,\n   737→                candidate.id,\n   738→            )\n   739→\n   740→            return ScoredResult(\n   741→                candidate_id=str(candidate.id),\n   742→                candidate_name=candidate.name,\n   743→                jd_filename=jd.filename,\n   744→                scored_job=scored_job,\n   745→                expected_hot=jd.expected_hot,\n   746→                expected_score_band=jd.expected_score_band,\n   747→                actual_hot=scored_job.is_hot,\n   748→                actual_score=scored_job.composite_score,\n   749→            )\n   750→\n   751→        except Exception as e:\n   752→            logger.error(\n   753→                \"scoring_runner.score_error\",\n   754→                candidate_id=str(candidate.id),\n   755→                jd_filename=jd.filename,\n   756→                error=str(e),\n   757→            )\n   758→            return ScoredResult(\n   759→                candidate_id=str(candidate.id),\n   760→                candidate_name=candidate.name,\n   761→                jd_filename=jd.filename,\n   762→                expected_hot=jd.expected_hot,\n   763→                expected_score_band=jd.expected_score_band,\n   764→                error=str(e),\n   765→            )\n   766→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"dfca4b76-68a4-4108-9198-7112cd1e31a6","uuid":"0242c91f-3272-4277-a930-f296aa43341d","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/synthetics/scoring_runner.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nScoring Synthetic Runner — iterates synthetic candidates × JD fixtures.\n\nExecutes the RelevanceScorer against synthetic candidates with cache-aware\ninstrumentation. Tracks cache hit/miss rates from Claude API responses.\n\nThe scorer module (RelevanceScorer) is FROZEN. To enforce the cache contract\n(NUTRIENTS.md §I.5), this runner wraps Claude API calls with cache_control\nheaders by providing a wrapper client that intercepts and augments requests.\n\nContract: NUTRIENTS.md §I.2-I.5, HYPHA-SYNTHETICS-SCORING.md\nOwner: synthetics-scoring-agent.runner\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport re\nimport uuid\nfrom dataclasses import dataclass, field\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Optional\n\nimport redis.asyncio as aioredis\nimport structlog\nimport yaml\nfrom anthropic import AsyncAnthropic\nfrom pydantic import BaseModel, Field\nfrom sqlalchemy import text\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom backend.agents.discovery.identity_profiler import IdentityProfiler\nfrom backend.agents.discovery.relevance_scorer import RelevanceScorer\nfrom backend.agents.discovery.schemas import (\n    CandidateSchema,\n    DiscoveredJobSchema,\n    IdentityProfileSchema,\n    ScoredJobSchema,\n)\n\nlogger = structlog.get_logger(__name__)\n\n\n# ─── Cache Statistics ────────────────────────────────────────────────────────\n\n\n@dataclass\nclass CacheStats:\n    \"\"\"Tracks cache hit/miss statistics for Claude API calls.\"\"\"\n\n    total_calls: int = 0\n    cache_creation_tokens: int = 0\n    cache_read_tokens: int = 0\n\n    @property\n    def cache_hits(self) -> int:\n        \"\"\"Number of calls that hit the cache.\"\"\"\n        # A cache hit is when cache_read_input_tokens > 0\n        return self._hit_count\n\n    @property\n    def cache_misses(self) -> int:\n        \"\"\"Number of calls that missed the cache.\"\"\"\n        return self.total_calls - self._hit_count\n\n    @property\n    def cache_hit_rate(self) -> float:\n        \"\"\"Cache hit rate as a ratio 0.0-1.0.\"\"\"\n        if self.total_calls == 0:\n            return 0.0\n        return self._hit_count / self.total_calls\n\n    _hit_count: int = field(default=0, init=False)\n\n    def record_call(\n        self,\n        cache_creation_input_tokens: int,\n        cache_read_input_tokens: int,\n    ) -> None:\n        \"\"\"Record a Claude API call's cache statistics.\"\"\"\n        self.total_calls += 1\n        self.cache_creation_tokens += cache_creation_input_tokens\n        self.cache_read_tokens += cache_read_input_tokens\n        if cache_read_input_tokens > 0:\n            self._hit_count += 1\n\n\n# ─── JD Fixture Loading ──────────────────────────────────────────────────────\n\n\nclass JDFixture(BaseModel):\n    \"\"\"A JD fixture loaded from synthetics/fixtures/jobs/.\"\"\"\n\n    filename: str\n    target_candidate: str\n    expected_hot: bool\n    expected_score_band: str  # low | mid | high\n    source: str\n    title: str\n    company: str\n    location: Optional[str] = None\n    description: str\n    url: str = \"\"\n\n\ndef load_jd_fixtures(fixtures_dir: Path) -> list[JDFixture]:\n    \"\"\"\n    Load all JD fixtures from the jobs directory.\n\n    Each fixture is a markdown file with YAML frontmatter.\n\n    Args:\n        fixtures_dir: Path to synthetics/fixtures/jobs/\n\n    Returns:\n        List of JDFixture objects\n    \"\"\"\n    fixtures: list[JDFixture] = []\n    jobs_dir = fixtures_dir / \"jobs\"\n\n    if not jobs_dir.exists():\n        logger.warning(\"jd_fixtures.dir_not_found\", path=str(jobs_dir))\n        return fixtures\n\n    for md_file in jobs_dir.glob(\"*.md\"):\n        try:\n            fixture = _parse_jd_fixture(md_file)\n            fixtures.append(fixture)\n            logger.debug(\n                \"jd_fixtures.loaded\",\n                filename=md_file.name,\n                target=fixture.target_candidate,\n            )\n        except Exception as e:\n            logger.error(\n                \"jd_fixtures.parse_error\",\n                filename=md_file.name,\n                error=str(e),\n            )\n\n    logger.info(\"jd_fixtures.loaded_all\", count=len(fixtures))\n    return fixtures\n\n\ndef _parse_jd_fixture(path: Path) -> JDFixture:\n    \"\"\"Parse a single JD fixture markdown file with YAML frontmatter.\"\"\"\n    content = path.read_text()\n\n    # Split frontmatter from body\n    if not content.startswith(\"---\"):\n        raise ValueError(f\"No YAML frontmatter in {path.name}\")\n\n    parts = content.split(\"---\", 2)\n    if len(parts) < 3:\n        raise ValueError(f\"Invalid frontmatter format in {path.name}\")\n\n    frontmatter = yaml.safe_load(parts[1])\n    body = parts[2].strip()\n\n    return JDFixture(\n        filename=path.name,\n        target_candidate=frontmatter[\"target_candidate\"],\n        expected_hot=frontmatter[\"expected_hot\"],\n        expected_score_band=frontmatter[\"expected_score_band\"],\n        source=frontmatter.get(\"source\", \"greenhouse\"),\n        title=frontmatter.get(\"title\", \"Unknown Title\"),\n        company=frontmatter.get(\"company\", \"Unknown Company\"),\n        location=frontmatter.get(\"location\"),\n        description=body,\n        url=frontmatter.get(\"url\", f\"https://example.com/jobs/{path.stem}\"),\n    )\n\n\n# ─── Synthetic Candidate Loading ─────────────────────────────────────────────\n\n\nasync def load_synthetic_candidates(\n    session: AsyncSession,\n) -> list[CandidateSchema]:\n    \"\"\"\n    Load synthetic candidates from the database.\n\n    Synthetic candidates are identified by UUIDv5 markers matching\n    the pattern: id::text LIKE '00000000-%'\n\n    Contract: NUTRIENTS.md §I.1\n\n    Args:\n        session: Async SQLAlchemy session\n\n    Returns:\n        List of CandidateSchema for synthetic candidates\n    \"\"\"\n    # Query candidates with synthetic UUID pattern\n    result = await session.execute(\n        text(\"\"\"\n            SELECT\n                id, name, email, resume_text, linkedin_url, github_url,\n                personal_context, target_locations, remote_preference,\n                min_compensation, excluded_companies, excluded_industries,\n                created_at, updated_at\n            FROM candidates\n            WHERE id::text LIKE '00000000-%'\n            ORDER BY name\n        \"\"\")\n    )\n\n    candidates: list[CandidateSchema] = []\n    for row in result.fetchall():\n        candidates.append(\n            CandidateSchema(\n                id=row.id,\n                name=row.name,\n                email=row.email,\n                resume_text=row.resume_text or \"\",\n                linkedin_url=row.linkedin_url,\n                github_url=row.github_url,\n                personal_context=row.personal_context,\n                target_locations=list(row.target_locations or []),\n                remote_preference=row.remote_preference or \"flexible\",\n                min_compensation=row.min_compensation,\n                excluded_companies=list(row.excluded_companies or []),\n                excluded_industries=list(row.excluded_industries or []),\n                created_at=row.created_at,\n                updated_at=row.updated_at,\n            )\n        )\n\n    logger.info(\n        \"synthetic_candidates.loaded\",\n        count=len(candidates),\n        ids=[str(c.id) for c in candidates],\n    )\n    return candidates\n\n\n# ─── Cache-Aware Claude Wrapper ──────────────────────────────────────────────\n\n\nclass CacheAwareAnthropic:\n    \"\"\"\n    Wrapper around AsyncAnthropic that enforces cache_control headers.\n\n    The RelevanceScorer is FROZEN and doesn't set cache_control.\n    This wrapper intercepts message creation and adds the required\n    cache_control headers per NUTRIENTS.md §I.5.\n    \"\"\"\n\n    def __init__(\n        self,\n        client: AsyncAnthropic,\n        cache_stats: CacheStats,\n        candidate_identity: str,\n    ):\n        \"\"\"\n        Initialize the cache-aware wrapper.\n\n        Args:\n            client: The underlying AsyncAnthropic client\n            cache_stats: CacheStats object to record metrics\n            candidate_identity: Candidate identity text to cache\n        \"\"\"\n        self._client = client\n        self._cache_stats = cache_stats\n        self._candidate_identity = candidate_identity\n        self.messages = _CacheAwareMessages(self)\n\n\nclass _CacheAwareMessages:\n    \"\"\"Wraps the messages API to add cache_control.\"\"\"\n\n    def __init__(self, wrapper: CacheAwareAnthropic):\n        self._wrapper = wrapper\n\n    async def create(self, **kwargs) -> object:\n        \"\"\"\n        Create a message with cache_control headers.\n\n        Transforms the messages to include cache_control on system prompt\n        and candidate identity per NUTRIENTS.md §I.5.\n        \"\"\"\n        # Extract original messages\n        messages = kwargs.get(\"messages\", [])\n\n        # Transform to use cache_control\n        transformed_messages = []\n        for msg in messages:\n            if msg.get(\"role\") == \"user\":\n                content = msg.get(\"content\", \"\")\n                if isinstance(content, str):\n                    # Split into cacheable parts\n                    transformed_messages.append(\n                        {\n                            \"role\": \"user\",\n                            \"content\": [\n                                {\n                                    \"type\": \"text\",\n                                    \"text\": self._wrapper._candidate_identity,\n                                    \"cache_control\": {\"type\": \"ephemeral\"},\n                                },\n                                {\n                                    \"type\": \"text\",\n                                    \"text\": content,\n                                },\n                            ],\n                        }\n                    )\n                else:\n                    # Already structured, just pass through\n                    transformed_messages.append(msg)\n            else:\n                transformed_messages.append(msg)\n\n        # Add system prompt with cache_control\n        system_content = [\n            {\n                \"type\": \"text\",\n                \"text\": (\n                    \"You are a talent agent scoring jobs against candidate profiles. \"\n                    \"Return structured JSON responses.\"\n                ),\n                \"cache_control\": {\"type\": \"ephemeral\"},\n            }\n        ]\n\n        # Make the request\n        kwargs[\"messages\"] = transformed_messages\n        kwargs[\"system\"] = system_content\n\n        response = await self._wrapper._client.messages.create(**kwargs)\n\n        # Record cache statistics\n        usage = response.usage\n        cache_creation = getattr(usage, \"cache_creation_input_tokens\", 0) or 0\n        cache_read = getattr(usage, \"cache_read_input_tokens\", 0) or 0\n\n        self._wrapper._cache_stats.record_call(cache_creation, cache_read)\n\n        logger.debug(\n            \"cache_aware.request_complete\",\n            cache_creation_tokens=cache_creation,\n            cache_read_tokens=cache_read,\n            total_calls=self._wrapper._cache_stats.total_calls,\n        )\n\n        return response\n\n\n# ─── Scored Result ───────────────────────────────────────────────────────────\n\n\nclass ScoredResult(BaseModel):\n    \"\"\"Result of scoring a single candidate × JD pair.\"\"\"\n\n    candidate_id: str\n    candidate_name: str\n    jd_filename: str\n    scored_job: Optional[ScoredJobSchema] = None\n    expected_hot: bool\n    expected_score_band: str\n    actual_hot: bool = False\n    actual_score: int = 0\n    error: Optional[str] = None\n\n\nclass CandidateScoringResult(BaseModel):\n    \"\"\"All scoring results for a single candidate.\"\"\"\n\n    candidate_id: str\n    candidate_name: str\n    profile: Optional[IdentityProfileSchema] = None\n    scored_results: list[ScoredResult] = Field(default_factory=list)\n    cache_stats: dict = Field(default_factory=dict)\n    error: Optional[str] = None\n\n\n# ─── Scoring Runner ──────────────────────────────────────────────────────────\n\n\nclass ScoringSyntheticRunner:\n    \"\"\"\n    Iterates synthetic candidates × JD fixtures for drift detection.\n\n    This runner:\n    1. Loads synthetic candidates from the database\n    2. Loads JD fixtures from synthetics/fixtures/jobs/\n    3. For each candidate × JD pair, scores via RelevanceScorer\n    4. Tracks cache hit/miss from Claude API responses\n    5. Returns structured results for fingerprinting\n\n    Contract: NUTRIENTS.md §I.2-I.5, HYPHA-SYNTHETICS-SCORING.md\n    \"\"\"\n\n    def __init__(\n        self,\n        session: AsyncSession,\n        redis_client: aioredis.Redis,\n        anthropic_client: AsyncAnthropic,\n        fixtures_dir: Optional[Path] = None,\n    ):\n        \"\"\"\n        Initialize the ScoringSyntheticRunner.\n\n        Args:\n            session: Async SQLAlchemy session for database access\n            redis_client: Async Redis client for caching\n            anthropic_client: Async Anthropic client for Claude API\n            fixtures_dir: Path to synthetics/fixtures/ (default: auto-detect)\n        \"\"\"\n        self._session = session\n        self._redis = redis_client\n        self._anthropic = anthropic_client\n\n        # Auto-detect fixtures directory if not provided\n        if fixtures_dir is None:\n            self._fixtures_dir = Path(__file__).parent.parent.parent / \"synthetics\" / \"fixtures\"\n        else:\n            self._fixtures_dir = fixtures_dir\n\n        self._run_id = str(uuid.uuid4())\n\n    async def run_suite(self) -> dict:\n        \"\"\"\n        Execute the full scoring suite.\n\n        Iterates all synthetic candidates × applicable JD fixtures,\n        scoring each pair and collecting results.\n\n        Returns:\n            dict with:\n                - run_id: UUID of this run\n                - started_at: ISO timestamp\n                - completed_at: ISO timestamp\n                - candidates: list of CandidateScoringResult\n                - overall_cache_stats: aggregated cache statistics\n        \"\"\"\n        started_at = datetime.now(timezone.utc)\n\n        logger.info(\n            \"scoring_runner.suite_start\",\n            run_id=self._run_id,\n            fixtures_dir=str(self._fixtures_dir),\n        )\n\n        # Load synthetic candidates\n        candidates = await load_synthetic_candidates(self._session)\n        if not candidates:\n            logger.warning(\"scoring_runner.no_candidates\")\n            return {\n                \"run_id\": self._run_id,\n                \"started_at\": started_at.isoformat(),\n                \"completed_at\": datetime.now(timezone.utc).isoformat(),\n                \"candidates\": [],\n                \"overall_cache_stats\": {\"total_calls\": 0, \"cache_hit_rate\": 0.0},\n            }\n\n        # Load JD fixtures\n        jd_fixtures = load_jd_fixtures(self._fixtures_dir)\n        if not jd_fixtures:\n            logger.warning(\"scoring_runner.no_fixtures\")\n            return {\n                \"run_id\": self._run_id,\n                \"started_at\": started_at.isoformat(),\n                \"completed_at\": datetime.now(timezone.utc).isoformat(),\n                \"candidates\": [],\n                \"overall_cache_stats\": {\"total_calls\": 0, \"cache_hit_rate\": 0.0},\n            }\n\n        # Build mapping of candidate slug to JD fixtures\n        candidate_slug_map = self._build_candidate_slug_map(candidates)\n\n        # Process each candidate\n        all_results: list[CandidateScoringResult] = []\n        overall_cache_stats = CacheStats()\n\n        for candidate in candidates:\n            result = await self._score_candidate(\n                candidate,\n                jd_fixtures,\n                candidate_slug_map,\n                overall_cache_stats,\n            )\n            all_results.append(result)\n\n        completed_at = datetime.now(timezone.utc)\n\n        logger.info(\n            \"scoring_runner.suite_complete\",\n            run_id=self._run_id,\n            candidates_processed=len(all_results),\n            total_claude_calls=overall_cache_stats.total_calls,\n            cache_hit_rate=round(overall_cache_stats.cache_hit_rate, 4),\n            duration_seconds=(completed_at - started_at).total_seconds(),\n        )\n\n        return {\n            \"run_id\": self._run_id,\n            \"started_at\": started_at.isoformat(),\n            \"completed_at\": completed_at.isoformat(),\n            \"candidates\": [r.model_dump() for r in all_results],\n            \"overall_cache_stats\": {\n                \"total_calls\": overall_cache_stats.total_calls,\n                \"cache_hits\": overall_cache_stats.cache_hits,\n                \"cache_misses\": overall_cache_stats.cache_misses,\n                \"cache_hit_rate\": round(overall_cache_stats.cache_hit_rate, 4),\n                \"cache_creation_tokens\": overall_cache_stats.cache_creation_tokens,\n                \"cache_read_tokens\": overall_cache_stats.cache_read_tokens,\n            },\n        }\n\n    def _build_candidate_slug_map(\n        self,\n        candidates: list[CandidateSchema],\n    ) -> dict[str, CandidateSchema]:\n        \"\"\"\n        Build a mapping of synthetic slugs to candidates.\n\n        Derives the slug from the candidate's email prefix:\n            jordan.chen.synthetic@... → synthetic-jr-engineer (from name pattern)\n        \"\"\"\n        slug_map: dict[str, CandidateSchema] = {}\n\n        for candidate in candidates:\n            # Extract slug from email pattern or name\n            email = candidate.email.lower()\n\n            if \"jordan\" in email or \"chen\" in email:\n                slug_map[\"synthetic-jr-engineer\"] = candidate\n            elif \"priya\" in email or \"ramanathan\" in email:\n                slug_map[\"synthetic-senior-ml\"] = candidate\n            elif \"marcus\" in email or \"thompson\" in email:\n                slug_map[\"synthetic-mid-product\"] = candidate\n            else:\n                # Fallback: use email prefix\n                prefix = email.split(\"@\")[0].replace(\".\", \"-\")\n                slug_map[prefix] = candidate\n\n        logger.debug(\n            \"candidate_slug_map.built\",\n            slugs=list(slug_map.keys()),\n        )\n        return slug_map\n\n    async def _score_candidate(\n        self,\n        candidate: CandidateSchema,\n        jd_fixtures: list[JDFixture],\n        slug_map: dict[str, CandidateSchema],\n        overall_cache_stats: CacheStats,\n    ) -> CandidateScoringResult:\n        \"\"\"\n        Score all applicable JD fixtures for a single candidate.\n\n        Args:\n            candidate: The synthetic candidate\n            jd_fixtures: All JD fixtures\n            slug_map: Mapping of slugs to candidates\n            overall_cache_stats: Aggregated cache stats\n\n        Returns:\n            CandidateScoringResult with all scoring results\n        \"\"\"\n        # Determine which slug this candidate maps to\n        candidate_slug = None\n        for slug, cand in slug_map.items():\n            if cand.id == candidate.id:\n                candidate_slug = slug\n                break\n\n        if not candidate_slug:\n            logger.warning(\n                \"scoring_runner.unknown_slug\",\n                candidate_id=str(candidate.id),\n                candidate_name=candidate.name,\n            )\n            return CandidateScoringResult(\n                candidate_id=str(candidate.id),\n                candidate_name=candidate.name,\n                error=\"Could not determine candidate slug\",\n            )\n\n        # Filter JD fixtures for this candidate\n        applicable_jds = [\n            jd for jd in jd_fixtures if jd.target_candidate == candidate_slug\n        ]\n\n        logger.info(\n            \"scoring_runner.candidate_start\",\n            candidate_id=str(candidate.id),\n            candidate_name=candidate.name,\n            slug=candidate_slug,\n            applicable_jds=len(applicable_jds),\n        )\n\n        # Build identity profile first\n        candidate_identity = self._build_candidate_identity_text(candidate)\n        cache_stats = CacheStats()\n\n        # Create cache-aware wrapper for this candidate\n        cache_client = CacheAwareAnthropic(\n            self._anthropic,\n            cache_stats,\n            candidate_identity,\n        )\n\n        # Build profile via IdentityProfiler\n        profiler = IdentityProfiler(self._redis, cache_client)\n        try:\n            profile = await profiler.build_profile(candidate)\n        except Exception as e:\n            logger.error(\n                \"scoring_runner.profile_error\",\n                candidate_id=str(candidate.id),\n                error=str(e),\n            )\n            return CandidateScoringResult(\n                candidate_id=str(candidate.id),\n                candidate_name=candidate.name,\n                error=f\"Failed to build profile: {e}\",\n            )\n\n        # Create scorer with cache-aware client\n        scorer = RelevanceScorer(cache_client)\n\n        # Score each applicable JD\n        scored_results: list[ScoredResult] = []\n\n        for jd in applicable_jds:\n            result = await self._score_single_jd(\n                candidate,\n                profile,\n                jd,\n                scorer,\n            )\n            scored_results.append(result)\n\n        # Aggregate cache stats into overall\n        overall_cache_stats.total_calls += cache_stats.total_calls\n        overall_cache_stats.cache_creation_tokens += cache_stats.cache_creation_tokens\n        overall_cache_stats.cache_read_tokens += cache_stats.cache_read_tokens\n        overall_cache_stats._hit_count += cache_stats._hit_count\n\n        logger.info(\n            \"scoring_runner.candidate_complete\",\n            candidate_id=str(candidate.id),\n            scored_count=len(scored_results),\n            cache_calls=cache_stats.total_calls,\n            cache_hit_rate=round(cache_stats.cache_hit_rate, 4),\n        )\n\n        return CandidateScoringResult(\n            candidate_id=str(candidate.id),\n            candidate_name=candidate.name,\n            profile=profile,\n            scored_results=scored_results,\n            cache_stats={\n                \"total_calls\": cache_stats.total_calls,\n                \"cache_hits\": cache_stats.cache_hits,\n                \"cache_misses\": cache_stats.cache_misses,\n                \"cache_hit_rate\": round(cache_stats.cache_hit_rate, 4),\n            },\n        )\n\n    def _build_candidate_identity_text(self, candidate: CandidateSchema) -> str:\n        \"\"\"\n        Build the candidate identity text for caching.\n\n        This text is prepended to all Claude calls for this candidate\n        and marked with cache_control.\n        \"\"\"\n        return f\"\"\"# CANDIDATE IDENTITY\n\nName: {candidate.name}\nLocation: {\", \".join(candidate.target_locations) if candidate.target_locations else \"Flexible\"}\nRemote Preference: {candidate.remote_preference}\nMin Compensation: {candidate.min_compensation or \"Not specified\"}\nExcluded Companies: {\", \".join(candidate.excluded_companies) if candidate.excluded_companies else \"None\"}\nExcluded Industries: {\", \".join(candidate.excluded_industries) if candidate.excluded_industries else \"None\"}\n\n## Resume\n{candidate.resume_text}\n\n## Personal Context\n{candidate.personal_context or \"Not provided\"}\n\"\"\"\n\n    async def _score_single_jd(\n        self,\n        candidate: CandidateSchema,\n        profile: IdentityProfileSchema,\n        jd: JDFixture,\n        scorer: RelevanceScorer,\n    ) -> ScoredResult:\n        \"\"\"\n        Score a single candidate × JD pair.\n\n        Args:\n            candidate: The synthetic candidate\n            profile: The candidate's identity profile\n            jd: The JD fixture\n            scorer: RelevanceScorer instance\n\n        Returns:\n            ScoredResult with scoring details\n        \"\"\"\n        logger.debug(\n            \"scoring_runner.scoring_jd\",\n            candidate_id=str(candidate.id),\n            jd_filename=jd.filename,\n        )\n\n        # Convert JD fixture to DiscoveredJobSchema\n        discovered_job = DiscoveredJobSchema(\n            id=uuid.uuid5(uuid.NAMESPACE_DNS, f\"synthetic-jd-{jd.filename}\"),\n            source=jd.source,\n            source_id=f\"synthetic-{jd.filename}\",\n            title=jd.title,\n            company=jd.company,\n            location=jd.location,\n            description=jd.description,\n            url=jd.url,\n            posted_at=None,\n            salary_min=None,\n            salary_max=None,\n            remote=False,\n            crawled_at=datetime.now(timezone.utc),\n        )\n\n        try:\n            scored_job = await scorer.score_job(\n                discovered_job,\n                profile,\n                candidate.id,\n            )\n\n            return ScoredResult(\n                candidate_id=str(candidate.id),\n                candidate_name=candidate.name,\n                jd_filename=jd.filename,\n                scored_job=scored_job,\n                expected_hot=jd.expected_hot,\n                expected_score_band=jd.expected_score_band,\n                actual_hot=scored_job.is_hot,\n                actual_score=scored_job.composite_score,\n            )\n\n        except Exception as e:\n            logger.error(\n                \"scoring_runner.score_error\",\n                candidate_id=str(candidate.id),\n                jd_filename=jd.filename,\n                error=str(e),\n            )\n            return ScoredResult(\n                candidate_id=str(candidate.id),\n                candidate_name=candidate.name,\n                jd_filename=jd.filename,\n                expected_hot=jd.expected_hot,\n                expected_score_band=jd.expected_score_band,\n                error=str(e),\n            )\n","numLines":766,"startLine":1,"totalLines":766}}}}
