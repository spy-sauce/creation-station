{"t":"2026-05-28T03:48:20.941Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NHnaM4vaJz5P1adZDWqpYW","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Crawler Health Runner — upstream health monitoring for job board sources.\n     6→\n     7→Exercises live crawler endpoints (Greenhouse, Lever, Ashby) with lightweight\n     8→requests, tracks consecutive failures via a state machine, and alerts on\n     9→3-strike threshold.\n    10→\n    11→The runner hits known-good slugs per source to verify:\n    12→  1. HTTP connectivity\n    13→  2. Response schema matches expected shape\n    14→  3. At least 1 job returned (source is active)\n    15→\n    16→Workday is NOT checked hourly — Playwright is too expensive. Workday exercises\n    17→daily via the scoring suite.\n    18→\n    19→Contract: NUTRIENTS.md §I.6, HYPHA-SYNTHETICS-CRAWLER.md\n    20→Owner: synthetics-crawler-agent.runner\n    21→\"\"\"\n    22→\n    23→from __future__ import annotations\n    24→\n    25→import json\n    26→import uuid\n    27→from dataclasses import dataclass, field, asdict\n    28→from datetime import datetime, timezone\n    29→from pathlib import Path\n    30→from typing import Optional, Literal\n    31→\n    32→import httpx\n    33→import structlog\n    34→import redis.asyncio as aioredis\n    35→\n    36→logger = structlog.get_logger(__name__)\n    37→\n    38→# ─── Health Check Targets ─────────────────────────────────────────────────────\n    39→# Contract: HYPHA-SYNTHETICS-CRAWLER.md \"Health Check Targets\"\n    40→\n    41→HEALTH_TARGETS: dict[str, dict] = {\n    42→    \"greenhouse\": {\n    43→        \"slug\": \"anthropic\",\n    44→        \"url\": \"https://boards.greenhouse.io/anthropic.json\",\n    45→        \"method\": \"GET\",\n    46→    },\n    47→    \"lever\": {\n    48→        \"slug\": \"netflix\",\n    49→        \"url\": \"https://api.lever.co/v0/postings/netflix?limit=1\",\n    50→        \"method\": \"GET\",\n    51→    },\n    52→    \"ashby\": {\n    53→        \"slug\": \"posthog\",\n    54→        \"url\": \"https://api.ashbyhq.com/posting-api/job-board/posthog\",\n    55→        \"method\": \"GET\",\n    56→    },\n    57→}\n    58→\n    59→USER_AGENT = \"TalentAgent/1.0 (+https://github.com/example/talent-agent)\"\n    60→HTTP_TIMEOUT = 15.0\n    61→\n    62→# Paths\n    63→STATE_FILE_PATH = Path(__file__).parent.parent.parent / \"synthetics\" / \"state.json\"\n    64→RUNS_DIR = Path(__file__).parent.parent.parent / \"synthetics\" / \"runs\"\n    65→\n    66→\n    67→# ─── State Machine ────────────────────────────────────────────────────────────\n    68→# Contract: NUTRIENTS.md §I.6\n    69→\n    70→SourceName = Literal[\"greenhouse\", \"lever\", \"ashby\"]\n    71→StatusColor = Literal[\"green\", \"red\"]\n    72→\n    73→\n    74→@dataclass\n    75→class CrawlerHealthState:\n    76→    \"\"\"\n    77→    State for a single crawler source.\n    78→\n    79→    Tracks consecutive failures and status color per NUTRIENTS.md §I.6.\n    80→    \"\"\"\n    81→\n    82→    source: SourceName\n    83→    status: StatusColor = \"green\"\n    84→    consecutive_failures: int = 0\n    85→    last_success: Optional[str] = None  # ISO-8601\n    86→    last_failure: Optional[str] = None  # ISO-8601\n    87→    last_error: Optional[str] = None\n    88→\n    89→\n    90→@dataclass\n    91→class SourceCheckResult:\n    92→    \"\"\"Result of checking a single source.\"\"\"\n    93→\n    94→    source: SourceName\n    95→    status: Literal[\"success\", \"failed\"]\n    96→    latency_ms: int\n    97→    schema_match: bool\n    98→    sample_jobs: int\n    99→    error: Optional[str] = None\n   100→\n   101→\n   102→@dataclass\n   103→class StateTransition:\n   104→    \"\"\"Records a state transition for a source.\"\"\"\n   105→\n   106→    source: SourceName\n   107→    previous_status: StatusColor\n   108→    previous_failures: int\n   109→    new_status: StatusColor\n   110→    new_failures: int\n   111→    alert_fired: bool\n   112→\n   113→\n   114→# ─── State Persistence ────────────────────────────────────────────────────────\n   115→\n   116→\n   117→def _load_state() -> dict[str, CrawlerHealthState]:\n   118→    \"\"\"\n   119→    Load state from synthetics/state.json.\n   120→\n   121→    If the file doesn't exist, initialize with all sources green + zero failures.\n   122→    \"\"\"\n   123→    if not STATE_FILE_PATH.exists():\n   124→        logger.info(\"crawler_health.state_init\", path=str(STATE_FILE_PATH))\n   125→        return _default_state()\n   126→\n   127→    try:\n   128→        with open(STATE_FILE_PATH, \"r\") as f:\n   129→            data = json.load(f)\n   130→\n   131→        states: dict[str, CrawlerHealthState] = {}\n   132→        for source in HEALTH_TARGETS:\n   133→            source_data = data.get(source, {})\n   134→            states[source] = CrawlerHealthState(\n   135→                source=source,  # type: ignore\n   136→                status=source_data.get(\"status\", \"green\"),\n   137→                consecutive_failures=source_data.get(\"consecutive_failures\", 0),\n   138→                last_success=source_data.get(\"last_success\"),\n   139→                last_failure=source_data.get(\"last_failure\"),\n   140→                last_error=source_data.get(\"last_error\"),\n   141→            )\n   142→\n   143→        logger.debug(\"crawler_health.state_loaded\", sources=list(states.keys()))\n   144→        return states\n   145→\n   146→    except Exception as e:\n   147→        logger.error(\"crawler_health.state_load_error\", error=str(e))\n   148→        return _default_state()\n   149→\n   150→\n   151→def _default_state() -> dict[str, CrawlerHealthState]:\n   152→    \"\"\"Return default state with all sources green.\"\"\"\n   153→    return {\n   154→        source: CrawlerHealthState(source=source)  # type: ignore\n   155→        for source in HEALTH_TARGETS\n   156→    }\n   157→\n   158→\n   159→def _save_state(states: dict[str, CrawlerHealthState]) -> None:\n   160→    \"\"\"Persist state to synthetics/state.json.\"\"\"\n   161→    # Ensure directory exists\n   162→    STATE_FILE_PATH.parent.mkdir(parents=True, exist_ok=True)\n   163→\n   164→    data = {}\n   165→    for source, state in states.items():\n   166→        data[source] = {\n   167→            \"status\": state.status,\n   168→            \"consecutive_failures\": state.consecutive_failures,\n   169→            \"last_success\": state.last_success,\n   170→            \"last_failure\": state.last_failure,\n   171→            \"last_error\": state.last_error,\n   172→        }\n   173→\n   174→    with open(STATE_FILE_PATH, \"w\") as f:\n   175→        json.dump(data, f, indent=2)\n   176→\n   177→    logger.debug(\"crawler_health.state_saved\", path=str(STATE_FILE_PATH))\n   178→\n   179→\n   180→# ─── Schema Validation ────────────────────────────────────────────────────────\n   181→# Using simple checks instead of jsonschema to avoid new dependency\n   182→\n   183→\n   184→def _validate_greenhouse_schema(data: dict) -> tuple[bool, int]:\n   185→    \"\"\"\n   186→    Validate Greenhouse response schema.\n   187→\n   188→    Expected: {\"jobs\": [...]} with at least 1 job.\n   189→\n   190→    Returns:\n   191→        (schema_match, sample_jobs)\n   192→    \"\"\"\n   193→    if not isinstance(data, dict):\n   194→        return False, 0\n   195→    if \"jobs\" not in data:\n   196→        return False, 0\n   197→    jobs = data.get(\"jobs\")\n   198→    if not isinstance(jobs, list):\n   199→        return False, 0\n   200→    if len(jobs) < 1:\n   201→        return False, 0\n   202→    return True, len(jobs)\n   203→\n   204→\n   205→def _validate_lever_schema(data: list) -> tuple[bool, int]:\n   206→    \"\"\"\n   207→    Validate Lever response schema.\n   208→\n   209→    Expected: [{id, ...}, ...] array with at least 1 posting.\n   210→\n   211→    Returns:\n   212→        (schema_match, sample_jobs)\n   213→    \"\"\"\n   214→    if not isinstance(data, list):\n   215→        return False, 0\n   216→    if len(data) < 1:\n   217→        return False, 0\n   218→    # Check first item has 'id'\n   219→    if not isinstance(data[0], dict) or \"id\" not in data[0]:\n   220→        return False, 0\n   221→    return True, len(data)\n   222→\n   223→\n   224→def _validate_ashby_schema(data: dict) -> tuple[bool, int]:\n   225→    \"\"\"\n   226→    Validate Ashby response schema.\n   227→\n   228→    Expected: {\"jobs\": [...]} with at least 1 job.\n   229→\n   230→    Returns:\n   231→        (schema_match, sample_jobs)\n   232→    \"\"\"\n   233→    if not isinstance(data, dict):\n   234→        return False, 0\n   235→    if \"jobs\" not in data:\n   236→        return False, 0\n   237→    jobs = data.get(\"jobs\")\n   238→    if not isinstance(jobs, list):\n   239→        return False, 0\n   240→    if len(jobs) < 1:\n   241→        return False, 0\n   242→    return True, len(jobs)\n   243→\n   244→\n   245→def _validate_schema(source: SourceName, data) -> tuple[bool, int]:\n   246→    \"\"\"Route to the appropriate schema validator.\"\"\"\n   247→    if source == \"greenhouse\":\n   248→        return _validate_greenhouse_schema(data)\n   249→    elif source == \"lever\":\n   250→        return _validate_lever_schema(data)\n   251→    elif source == \"ashby\":\n   252→        return _validate_ashby_schema(data)\n   253→    else:\n   254→        return False, 0\n   255→\n   256→\n   257→# ─── Health Check Execution ───────────────────────────────────────────────────\n   258→\n   259→\n   260→async def _check_source(\n   261→    client: httpx.AsyncClient,\n   262→    source: SourceName,\n   263→) -> SourceCheckResult:\n   264→    \"\"\"\n   265→    Execute health check for a single source.\n   266→\n   267→    Args:\n   268→        client: httpx async client\n   269→        source: Source name (greenhouse, lever, ashby)\n   270→\n   271→    Returns:\n   272→        SourceCheckResult with status, latency, schema validation, etc.\n   273→    \"\"\"\n   274→    target = HEALTH_TARGETS[source]\n   275→    url = target[\"url\"]\n   276→    method = target[\"method\"]\n   277→\n   278→    start_time = datetime.now(timezone.utc)\n   279→\n   280→    try:\n   281→        if method == \"GET\":\n   282→            response = await client.get(url)\n   283→        else:\n   284→            response = await client.post(url)\n   285→\n   286→        latency_ms = int((datetime.now(timezone.utc) - start_time).total_seconds() * 1000)\n   287→\n   288→        response.raise_for_status()\n   289→        data = response.json()\n   290→\n   291→        schema_match, sample_jobs = _validate_schema(source, data)\n   292→\n   293→        if not schema_match:\n   294→            logger.warning(\n   295→                \"crawler_health.schema_mismatch\",\n   296→                source=source,\n   297→                url=url,\n   298→            )\n   299→            return SourceCheckResult(\n   300→                source=source,\n   301→                status=\"failed\",\n   302→                latency_ms=latency_ms,\n   303→                schema_match=False,\n   304→                sample_jobs=sample_jobs,\n   305→                error=\"Schema validation failed\",\n   306→            )\n   307→\n   308→        logger.info(\n   309→            \"crawler_health.source_success\",\n   310→            source=source,\n   311→            latency_ms=latency_ms,\n   312→            sample_jobs=sample_jobs,\n   313→        )\n   314→\n   315→        return SourceCheckResult(\n   316→            source=source,\n   317→            status=\"success\",\n   318→            latency_ms=latency_ms,\n   319→            schema_match=True,\n   320→            sample_jobs=sample_jobs,\n   321→        )\n   322→\n   323→    except httpx.HTTPStatusError as e:\n   324→        latency_ms = int((datetime.now(timezone.utc) - start_time).total_seconds() * 1000)\n   325→        error_msg = f\"HTTP {e.response.status_code}\"\n   326→\n   327→        logger.warning(\n   328→            \"crawler_health.http_error\",\n   329→            source=source,\n   330→            status_code=e.response.status_code,\n   331→            url=url,\n   332→        )\n   333→\n   334→        return SourceCheckResult(\n   335→            source=source,\n   336→            status=\"failed\",\n   337→            latency_ms=latency_ms,\n   338→            schema_match=False,\n   339→            sample_jobs=0,\n   340→            error=error_msg,\n   341→        )\n   342→\n   343→    except httpx.TimeoutException:\n   344→        latency_ms = int((datetime.now(timezone.utc) - start_time).total_seconds() * 1000)\n   345→\n   346→        logger.warning(\n   347→            \"crawler_health.timeout\",\n   348→            source=source,\n   349→            url=url,\n   350→            timeout_seconds=HTTP_TIMEOUT,\n   351→        )\n   352→\n   353→        return SourceCheckResult(\n   354→            source=source,\n   355→            status=\"failed\",\n   356→            latency_ms=latency_ms,\n   357→            schema_match=False,\n   358→            sample_jobs=0,\n   359→            error=f\"Timeout after {HTTP_TIMEOUT}s\",\n   360→        )\n   361→\n   362→    except Exception as e:\n   363→        latency_ms = int((datetime.now(timezone.utc) - start_time).total_seconds() * 1000)\n   364→        error_msg = str(e)\n   365→\n   366→        logger.error(\n   367→            \"crawler_health.unexpected_error\",\n   368→            source=source,\n   369→            url=url,\n   370→            error=error_msg,\n   371→        )\n   372→\n   373→        return SourceCheckResult(\n   374→            source=source,\n   375→            status=\"failed\",\n   376→            latency_ms=latency_ms,\n   377→            schema_match=False,\n   378→            sample_jobs=0,\n   379→            error=error_msg,\n   380→        )\n   381→\n   382→\n   383→# ─── State Machine Transitions ────────────────────────────────────────────────\n   384→\n   385→\n   386→def _apply_result_to_state(\n   387→    result: SourceCheckResult,\n   388→    state: CrawlerHealthState,\n   389→) -> tuple[CrawlerHealthState, StateTransition]:\n   390→    \"\"\"\n   391→    Apply a check result to the current state, returning new state + transition.\n   392→\n   393→    Transition rules from NUTRIENTS.md §I.6:\n   394→    - on_success: consecutive_failures = 0, status = 'green'\n   395→    - on_failure: consecutive_failures += 1, if >= 3 then status = 'red'\n   396→\n   397→    Args:\n   398→        result: SourceCheckResult from the health check\n   399→        state: Current CrawlerHealthState\n   400→\n   401→    Returns:\n   402→        (new_state, transition) tuple\n   403→    \"\"\"\n   404→    now = datetime.now(timezone.utc).isoformat()\n   405→\n   406→    previous_status = state.status\n   407→    previous_failures = state.consecutive_failures\n   408→    alert_fired = False\n   409→\n   410→    if result.status == \"success\":\n   411→        # Success case\n   412→        new_state = CrawlerHealthState(\n   413→            source=state.source,\n   414→            status=\"green\",\n   415→            consecutive_failures=0,\n   416→            last_success=now,\n   417→            last_failure=state.last_failure,\n   418→            last_error=None,\n   419→        )\n   420→\n   421→        # Recovery: was red, now green\n   422→        if previous_status == \"red\":\n   423→            alert_fired = True\n   424→            logger.info(\n   425→                \"crawler_health.recovery\",\n   426→                source=state.source,\n   427→                previous_failures=previous_failures,\n   428→            )\n   429→    else:\n   430→        # Failure case\n   431→        new_failures = state.consecutive_failures + 1\n   432→        new_status: StatusColor = state.status\n   433→\n   434→        # Transition to red at 3+ failures\n   435→        if new_failures >= 3 and previous_status != \"red\":\n   436→            new_status = \"red\"\n   437→            alert_fired = True\n   438→            logger.warning(\n   439→                \"crawler_health.alert_threshold\",\n   440→                source=state.source,\n   441→                consecutive_failures=new_failures,\n   442→                error=result.error,\n   443→            )\n   444→\n   445→        new_state = CrawlerHealthState(\n   446→            source=state.source,\n   447→            status=new_status,\n   448→            consecutive_failures=new_failures,\n   449→            last_success=state.last_success,\n   450→            last_failure=now,\n   451→            last_error=result.error,\n   452→        )\n   453→\n   454→    transition = StateTransition(\n   455→        source=state.source,\n   456→        previous_status=previous_status,\n   457→        previous_failures=previous_failures,\n   458→        new_status=new_state.status,\n   459→        new_failures=new_state.consecutive_failures,\n   460→        alert_fired=alert_fired,\n   461→    )\n   462→\n   463→    return new_state, transition\n   464→\n   465→\n   466→# ─── Event Publishing ─────────────────────────────────────────────────────────\n   467→\n   468→\n   469→async def _publish_event(\n   470→    redis_client: Optional[aioredis.Redis],\n   471→    source: SourceName,\n   472→    status: StatusColor,\n   473→    consecutive_failures: int,\n   474→    error: Optional[str] = None,\n   475→) -> None:\n   476→    \"\"\"\n   477→    Publish alert/recovery event to Redis pub/sub.\n   478→\n   479→    Channel: agent.status.synthetics.crawler\n   480→\n   481→    Args:\n   482→        redis_client: Async Redis client (may be None in tests)\n   483→        source: Source name\n   484→        status: 'red' (alert) or 'green' (recovery)\n   485→        consecutive_failures: Current failure count\n   486→        error: Error message (for alerts)\n   487→    \"\"\"\n   488→    if redis_client is None:\n   489→        logger.debug(\n   490→            \"crawler_health.pubsub_skip\",\n   491→            reason=\"no_redis_client\",\n   492→        )\n   493→        return\n   494→\n   495→    event = {\n   496→        \"source\": source,\n   497→        \"status\": status,\n   498→        \"consecutive_failures\": consecutive_failures,\n   499→        \"ts\": datetime.now(timezone.utc).isoformat(),\n   500→    }\n   501→\n   502→    if error and status == \"red\":\n   503→        event[\"error\"] = error\n   504→\n   505→    channel = \"agent.status.synthetics.crawler\"\n   506→\n   507→    try:\n   508→        await redis_client.publish(channel, json.dumps(event))\n   509→        logger.info(\n   510→            \"crawler_health.event_published\",\n   511→            channel=channel,\n   512→            source=source,\n   513→            status=status,\n   514→        )\n   515→    except Exception as e:\n   516→        logger.error(\n   517→            \"crawler_health.publish_failed\",\n   518→            channel=channel,\n   519→            error=str(e),\n   520→        )\n   521→\n   522→\n   523→# ─── Report Generation ────────────────────────────────────────────────────────\n   524→\n   525→\n   526→def _write_report(\n   527→    run_id: str,\n   528→    started_at: str,\n   529→    completed_at: str,\n   530→    results: list[SourceCheckResult],\n   531→    transitions: list[StateTransition],\n   532→) -> Path:\n   533→    \"\"\"\n   534→    Write the crawler health report to synthetics/runs/<ts>/crawler-report.json.\n   535→\n   536→    Returns:\n   537→        Path to the written report file.\n   538→    \"\"\"\n   539→    # Use timestamp-based directory like scoring runner\n   540→    ts = datetime.now(timezone.utc).strftime(\"%Y%m%d_%H%M%S\")\n   541→    run_dir = RUNS_DIR / ts\n   542→    run_dir.mkdir(parents=True, exist_ok=True)\n   543→\n   544→    report = {\n   545→        \"run_id\": run_id,\n   546→        \"suite\": \"crawler\",\n   547→        \"started_at\": started_at,\n   548→        \"completed_at\": completed_at,\n   549→        \"sources\": [\n   550→            {\n   551→                \"source\": r.source,\n   552→                \"status\": r.status,\n   553→                \"latency_ms\": r.latency_ms,\n   554→                \"schema_match\": r.schema_match,\n   555→                \"sample_jobs\": r.sample_jobs,\n   556→                \"error\": r.error,\n   557→            }\n   558→            for r in results\n   559→        ],\n   560→        \"state_transitions\": [\n   561→            {\n   562→                \"source\": t.source,\n   563→                \"previous_state\": {\n   564→                    \"status\": t.previous_status,\n   565→                    \"consecutive_failures\": t.previous_failures,\n   566→                },\n   567→                \"new_state\": {\n   568→                    \"status\": t.new_status,\n   569→                    \"consecutive_failures\": t.new_failures,\n   570→                },\n   571→                \"alert_fired\": t.alert_fired,\n   572→            }\n   573→            for t in transitions\n   574→        ],\n   575→    }\n   576→\n   577→    report_path = run_dir / \"crawler-report.json\"\n   578→    with open(report_path, \"w\") as f:\n   579→        json.dump(report, f, indent=2)\n   580→\n   581→    logger.info(\n   582→        \"crawler_health.report_written\",\n   583→        path=str(report_path),\n   584→        run_id=run_id,\n   585→    )\n   586→\n   587→    return report_path\n   588→\n   589→\n   590→# ─── CrawlerHealthRunner ──────────────────────────────────────────────────────\n   591→\n   592→\n   593→class CrawlerHealthRunner:\n   594→    \"\"\"\n   595→    Upstream health monitoring runner for job board sources.\n   596→\n   597→    Exercises live crawler endpoints (Greenhouse, Lever, Ashby) with lightweight\n   598→    requests, tracks consecutive failures via a state machine, and alerts on\n   599→    3-strike threshold.\n   600→\n   601→    Contract: NUTRIENTS.md §I.6, HYPHA-SYNTHETICS-CRAWLER.md\n   602→    \"\"\"\n   603→\n   604→    def __init__(\n   605→        self,\n   606→        redis_client: Optional[aioredis.Redis] = None,\n   607→    ):\n   608→        \"\"\"\n   609→        Initialize the CrawlerHealthRunner.\n   610→\n   611→        Args:\n   612→            redis_client: Async Redis client for pub/sub events (optional)\n   613→        \"\"\"\n   614→        self._redis = redis_client\n   615→        self._run_id = str(uuid.uuid4())\n   616→\n   617→    async def run_suite(self) -> dict:\n   618→        \"\"\"\n   619→        Execute the full crawler health suite.\n   620→\n   621→        Checks all sources (Greenhouse, Lever, Ashby), updates state,\n   622→        publishes alerts/recoveries, and writes a report.\n   623→\n   624→        Returns:\n   625→            dict with:\n   626→                - run_id: UUID of this run\n   627→                - started_at: ISO timestamp\n   628→                - completed_at: ISO timestamp\n   629→                - sources: list of source check results\n   630→                - state_transitions: list of state transitions\n   631→                - report_path: path to the written report\n   632→        \"\"\"\n   633→        started_at = datetime.now(timezone.utc)\n   634→\n   635→        logger.info(\n   636→            \"crawler_health.suite_start\",\n   637→            run_id=self._run_id,\n   638→            sources=list(HEALTH_TARGETS.keys()),\n   639→        )\n   640→\n   641→        # Load current state\n   642→        states = _load_state()\n   643→\n   644→        # Check each source\n   645→        results: list[SourceCheckResult] = []\n   646→        transitions: list[StateTransition] = []\n   647→        new_states: dict[str, CrawlerHealthState] = {}\n   648→\n   649→        async with httpx.AsyncClient(\n   650→            timeout=HTTP_TIMEOUT,\n   651→            headers={\n   652→                \"User-Agent\": USER_AGENT,\n   653→                \"Accept\": \"application/json\",\n   654→            },\n   655→            follow_redirects=True,\n   656→        ) as client:\n   657→            for source in HEALTH_TARGETS:\n   658→                source_name: SourceName = source  # type: ignore\n   659→\n   660→                result = await _check_source(client, source_name)\n   661→                results.append(result)\n   662→\n   663→                # Apply to state\n   664→                current_state = states.get(source, CrawlerHealthState(source=source_name))\n   665→                new_state, transition = _apply_result_to_state(result, current_state)\n   666→                new_states[source] = new_state\n   667→                transitions.append(transition)\n   668→\n   669→                # Publish event if alert fired\n   670→                if transition.alert_fired:\n   671→                    await _publish_event(\n   672→                        self._redis,\n   673→                        source_name,\n   674→                        new_state.status,\n   675→                        new_state.consecutive_failures,\n   676→                        new_state.last_error,\n   677→                    )\n   678→\n   679→        # Save updated state\n   680→        _save_state(new_states)\n   681→\n   682→        completed_at = datetime.now(timezone.utc)\n   683→\n   684→        # Write report\n   685→        report_path = _write_report(\n   686→            self._run_id,\n   687→            started_at.isoformat(),\n   688→            completed_at.isoformat(),\n   689→            results,\n   690→            transitions,\n   691→        )\n   692→\n   693→        logger.info(\n   694→            \"crawler_health.suite_complete\",\n   695→            run_id=self._run_id,\n   696→            duration_seconds=(completed_at - started_at).total_seconds(),\n   697→            sources_checked=len(results),\n   698→            alerts_fired=sum(1 for t in transitions if t.alert_fired),\n   699→        )\n   700→\n   701→        return {\n   702→            \"run_id\": self._run_id,\n   703→            \"started_at\": started_at.isoformat(),\n   704→            \"completed_at\": completed_at.isoformat(),\n   705→            \"sources\": [\n   706→                {\n   707→                    \"source\": r.source,\n   708→                    \"status\": r.status,\n   709→                    \"latency_ms\": r.latency_ms,\n   710→                    \"schema_match\": r.schema_match,\n   711→                    \"sample_jobs\": r.sample_jobs,\n   712→                    \"error\": r.error,\n   713→                }\n   714→                for r in results\n   715→            ],\n   716→            \"state_transitions\": [\n   717→                {\n   718→                    \"source\": t.source,\n   719→                    \"previous_status\": t.previous_status,\n   720→                    \"previous_failures\": t.previous_failures,\n   721→                    \"new_status\": t.new_status,\n   722→                    \"new_failures\": t.new_failures,\n   723→                    \"alert_fired\": t.alert_fired,\n   724→                }\n   725→                for t in transitions\n   726→            ],\n   727→            \"report_path\": str(report_path),\n   728→        }\n   729→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"652b4b3d-bcba-4c38-851d-efbb9fa0fa87","uuid":"3d3be121-7373-43fb-9e69-378473c4a456","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/synthetics/crawler_health.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nCrawler Health Runner — upstream health monitoring for job board sources.\n\nExercises live crawler endpoints (Greenhouse, Lever, Ashby) with lightweight\nrequests, tracks consecutive failures via a state machine, and alerts on\n3-strike threshold.\n\nThe runner hits known-good slugs per source to verify:\n  1. HTTP connectivity\n  2. Response schema matches expected shape\n  3. At least 1 job returned (source is active)\n\nWorkday is NOT checked hourly — Playwright is too expensive. Workday exercises\ndaily via the scoring suite.\n\nContract: NUTRIENTS.md §I.6, HYPHA-SYNTHETICS-CRAWLER.md\nOwner: synthetics-crawler-agent.runner\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport uuid\nfrom dataclasses import dataclass, field, asdict\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Optional, Literal\n\nimport httpx\nimport structlog\nimport redis.asyncio as aioredis\n\nlogger = structlog.get_logger(__name__)\n\n# ─── Health Check Targets ─────────────────────────────────────────────────────\n# Contract: HYPHA-SYNTHETICS-CRAWLER.md \"Health Check Targets\"\n\nHEALTH_TARGETS: dict[str, dict] = {\n    \"greenhouse\": {\n        \"slug\": \"anthropic\",\n        \"url\": \"https://boards.greenhouse.io/anthropic.json\",\n        \"method\": \"GET\",\n    },\n    \"lever\": {\n        \"slug\": \"netflix\",\n        \"url\": \"https://api.lever.co/v0/postings/netflix?limit=1\",\n        \"method\": \"GET\",\n    },\n    \"ashby\": {\n        \"slug\": \"posthog\",\n        \"url\": \"https://api.ashbyhq.com/posting-api/job-board/posthog\",\n        \"method\": \"GET\",\n    },\n}\n\nUSER_AGENT = \"TalentAgent/1.0 (+https://github.com/example/talent-agent)\"\nHTTP_TIMEOUT = 15.0\n\n# Paths\nSTATE_FILE_PATH = Path(__file__).parent.parent.parent / \"synthetics\" / \"state.json\"\nRUNS_DIR = Path(__file__).parent.parent.parent / \"synthetics\" / \"runs\"\n\n\n# ─── State Machine ────────────────────────────────────────────────────────────\n# Contract: NUTRIENTS.md §I.6\n\nSourceName = Literal[\"greenhouse\", \"lever\", \"ashby\"]\nStatusColor = Literal[\"green\", \"red\"]\n\n\n@dataclass\nclass CrawlerHealthState:\n    \"\"\"\n    State for a single crawler source.\n\n    Tracks consecutive failures and status color per NUTRIENTS.md §I.6.\n    \"\"\"\n\n    source: SourceName\n    status: StatusColor = \"green\"\n    consecutive_failures: int = 0\n    last_success: Optional[str] = None  # ISO-8601\n    last_failure: Optional[str] = None  # ISO-8601\n    last_error: Optional[str] = None\n\n\n@dataclass\nclass SourceCheckResult:\n    \"\"\"Result of checking a single source.\"\"\"\n\n    source: SourceName\n    status: Literal[\"success\", \"failed\"]\n    latency_ms: int\n    schema_match: bool\n    sample_jobs: int\n    error: Optional[str] = None\n\n\n@dataclass\nclass StateTransition:\n    \"\"\"Records a state transition for a source.\"\"\"\n\n    source: SourceName\n    previous_status: StatusColor\n    previous_failures: int\n    new_status: StatusColor\n    new_failures: int\n    alert_fired: bool\n\n\n# ─── State Persistence ────────────────────────────────────────────────────────\n\n\ndef _load_state() -> dict[str, CrawlerHealthState]:\n    \"\"\"\n    Load state from synthetics/state.json.\n\n    If the file doesn't exist, initialize with all sources green + zero failures.\n    \"\"\"\n    if not STATE_FILE_PATH.exists():\n        logger.info(\"crawler_health.state_init\", path=str(STATE_FILE_PATH))\n        return _default_state()\n\n    try:\n        with open(STATE_FILE_PATH, \"r\") as f:\n            data = json.load(f)\n\n        states: dict[str, CrawlerHealthState] = {}\n        for source in HEALTH_TARGETS:\n            source_data = data.get(source, {})\n            states[source] = CrawlerHealthState(\n                source=source,  # type: ignore\n                status=source_data.get(\"status\", \"green\"),\n                consecutive_failures=source_data.get(\"consecutive_failures\", 0),\n                last_success=source_data.get(\"last_success\"),\n                last_failure=source_data.get(\"last_failure\"),\n                last_error=source_data.get(\"last_error\"),\n            )\n\n        logger.debug(\"crawler_health.state_loaded\", sources=list(states.keys()))\n        return states\n\n    except Exception as e:\n        logger.error(\"crawler_health.state_load_error\", error=str(e))\n        return _default_state()\n\n\ndef _default_state() -> dict[str, CrawlerHealthState]:\n    \"\"\"Return default state with all sources green.\"\"\"\n    return {\n        source: CrawlerHealthState(source=source)  # type: ignore\n        for source in HEALTH_TARGETS\n    }\n\n\ndef _save_state(states: dict[str, CrawlerHealthState]) -> None:\n    \"\"\"Persist state to synthetics/state.json.\"\"\"\n    # Ensure directory exists\n    STATE_FILE_PATH.parent.mkdir(parents=True, exist_ok=True)\n\n    data = {}\n    for source, state in states.items():\n        data[source] = {\n            \"status\": state.status,\n            \"consecutive_failures\": state.consecutive_failures,\n            \"last_success\": state.last_success,\n            \"last_failure\": state.last_failure,\n            \"last_error\": state.last_error,\n        }\n\n    with open(STATE_FILE_PATH, \"w\") as f:\n        json.dump(data, f, indent=2)\n\n    logger.debug(\"crawler_health.state_saved\", path=str(STATE_FILE_PATH))\n\n\n# ─── Schema Validation ────────────────────────────────────────────────────────\n# Using simple checks instead of jsonschema to avoid new dependency\n\n\ndef _validate_greenhouse_schema(data: dict) -> tuple[bool, int]:\n    \"\"\"\n    Validate Greenhouse response schema.\n\n    Expected: {\"jobs\": [...]} with at least 1 job.\n\n    Returns:\n        (schema_match, sample_jobs)\n    \"\"\"\n    if not isinstance(data, dict):\n        return False, 0\n    if \"jobs\" not in data:\n        return False, 0\n    jobs = data.get(\"jobs\")\n    if not isinstance(jobs, list):\n        return False, 0\n    if len(jobs) < 1:\n        return False, 0\n    return True, len(jobs)\n\n\ndef _validate_lever_schema(data: list) -> tuple[bool, int]:\n    \"\"\"\n    Validate Lever response schema.\n\n    Expected: [{id, ...}, ...] array with at least 1 posting.\n\n    Returns:\n        (schema_match, sample_jobs)\n    \"\"\"\n    if not isinstance(data, list):\n        return False, 0\n    if len(data) < 1:\n        return False, 0\n    # Check first item has 'id'\n    if not isinstance(data[0], dict) or \"id\" not in data[0]:\n        return False, 0\n    return True, len(data)\n\n\ndef _validate_ashby_schema(data: dict) -> tuple[bool, int]:\n    \"\"\"\n    Validate Ashby response schema.\n\n    Expected: {\"jobs\": [...]} with at least 1 job.\n\n    Returns:\n        (schema_match, sample_jobs)\n    \"\"\"\n    if not isinstance(data, dict):\n        return False, 0\n    if \"jobs\" not in data:\n        return False, 0\n    jobs = data.get(\"jobs\")\n    if not isinstance(jobs, list):\n        return False, 0\n    if len(jobs) < 1:\n        return False, 0\n    return True, len(jobs)\n\n\ndef _validate_schema(source: SourceName, data) -> tuple[bool, int]:\n    \"\"\"Route to the appropriate schema validator.\"\"\"\n    if source == \"greenhouse\":\n        return _validate_greenhouse_schema(data)\n    elif source == \"lever\":\n        return _validate_lever_schema(data)\n    elif source == \"ashby\":\n        return _validate_ashby_schema(data)\n    else:\n        return False, 0\n\n\n# ─── Health Check Execution ───────────────────────────────────────────────────\n\n\nasync def _check_source(\n    client: httpx.AsyncClient,\n    source: SourceName,\n) -> SourceCheckResult:\n    \"\"\"\n    Execute health check for a single source.\n\n    Args:\n        client: httpx async client\n        source: Source name (greenhouse, lever, ashby)\n\n    Returns:\n        SourceCheckResult with status, latency, schema validation, etc.\n    \"\"\"\n    target = HEALTH_TARGETS[source]\n    url = target[\"url\"]\n    method = target[\"method\"]\n\n    start_time = datetime.now(timezone.utc)\n\n    try:\n        if method == \"GET\":\n            response = await client.get(url)\n        else:\n            response = await client.post(url)\n\n        latency_ms = int((datetime.now(timezone.utc) - start_time).total_seconds() * 1000)\n\n        response.raise_for_status()\n        data = response.json()\n\n        schema_match, sample_jobs = _validate_schema(source, data)\n\n        if not schema_match:\n            logger.warning(\n                \"crawler_health.schema_mismatch\",\n                source=source,\n                url=url,\n            )\n            return SourceCheckResult(\n                source=source,\n                status=\"failed\",\n                latency_ms=latency_ms,\n                schema_match=False,\n                sample_jobs=sample_jobs,\n                error=\"Schema validation failed\",\n            )\n\n        logger.info(\n            \"crawler_health.source_success\",\n            source=source,\n            latency_ms=latency_ms,\n            sample_jobs=sample_jobs,\n        )\n\n        return SourceCheckResult(\n            source=source,\n            status=\"success\",\n            latency_ms=latency_ms,\n            schema_match=True,\n            sample_jobs=sample_jobs,\n        )\n\n    except httpx.HTTPStatusError as e:\n        latency_ms = int((datetime.now(timezone.utc) - start_time).total_seconds() * 1000)\n        error_msg = f\"HTTP {e.response.status_code}\"\n\n        logger.warning(\n            \"crawler_health.http_error\",\n            source=source,\n            status_code=e.response.status_code,\n            url=url,\n        )\n\n        return SourceCheckResult(\n            source=source,\n            status=\"failed\",\n            latency_ms=latency_ms,\n            schema_match=False,\n            sample_jobs=0,\n            error=error_msg,\n        )\n\n    except httpx.TimeoutException:\n        latency_ms = int((datetime.now(timezone.utc) - start_time).total_seconds() * 1000)\n\n        logger.warning(\n            \"crawler_health.timeout\",\n            source=source,\n            url=url,\n            timeout_seconds=HTTP_TIMEOUT,\n        )\n\n        return SourceCheckResult(\n            source=source,\n            status=\"failed\",\n            latency_ms=latency_ms,\n            schema_match=False,\n            sample_jobs=0,\n            error=f\"Timeout after {HTTP_TIMEOUT}s\",\n        )\n\n    except Exception as e:\n        latency_ms = int((datetime.now(timezone.utc) - start_time).total_seconds() * 1000)\n        error_msg = str(e)\n\n        logger.error(\n            \"crawler_health.unexpected_error\",\n            source=source,\n            url=url,\n            error=error_msg,\n        )\n\n        return SourceCheckResult(\n            source=source,\n            status=\"failed\",\n            latency_ms=latency_ms,\n            schema_match=False,\n            sample_jobs=0,\n            error=error_msg,\n        )\n\n\n# ─── State Machine Transitions ────────────────────────────────────────────────\n\n\ndef _apply_result_to_state(\n    result: SourceCheckResult,\n    state: CrawlerHealthState,\n) -> tuple[CrawlerHealthState, StateTransition]:\n    \"\"\"\n    Apply a check result to the current state, returning new state + transition.\n\n    Transition rules from NUTRIENTS.md §I.6:\n    - on_success: consecutive_failures = 0, status = 'green'\n    - on_failure: consecutive_failures += 1, if >= 3 then status = 'red'\n\n    Args:\n        result: SourceCheckResult from the health check\n        state: Current CrawlerHealthState\n\n    Returns:\n        (new_state, transition) tuple\n    \"\"\"\n    now = datetime.now(timezone.utc).isoformat()\n\n    previous_status = state.status\n    previous_failures = state.consecutive_failures\n    alert_fired = False\n\n    if result.status == \"success\":\n        # Success case\n        new_state = CrawlerHealthState(\n            source=state.source,\n            status=\"green\",\n            consecutive_failures=0,\n            last_success=now,\n            last_failure=state.last_failure,\n            last_error=None,\n        )\n\n        # Recovery: was red, now green\n        if previous_status == \"red\":\n            alert_fired = True\n            logger.info(\n                \"crawler_health.recovery\",\n                source=state.source,\n                previous_failures=previous_failures,\n            )\n    else:\n        # Failure case\n        new_failures = state.consecutive_failures + 1\n        new_status: StatusColor = state.status\n\n        # Transition to red at 3+ failures\n        if new_failures >= 3 and previous_status != \"red\":\n            new_status = \"red\"\n            alert_fired = True\n            logger.warning(\n                \"crawler_health.alert_threshold\",\n                source=state.source,\n                consecutive_failures=new_failures,\n                error=result.error,\n            )\n\n        new_state = CrawlerHealthState(\n            source=state.source,\n            status=new_status,\n            consecutive_failures=new_failures,\n            last_success=state.last_success,\n            last_failure=now,\n            last_error=result.error,\n        )\n\n    transition = StateTransition(\n        source=state.source,\n        previous_status=previous_status,\n        previous_failures=previous_failures,\n        new_status=new_state.status,\n        new_failures=new_state.consecutive_failures,\n        alert_fired=alert_fired,\n    )\n\n    return new_state, transition\n\n\n# ─── Event Publishing ─────────────────────────────────────────────────────────\n\n\nasync def _publish_event(\n    redis_client: Optional[aioredis.Redis],\n    source: SourceName,\n    status: StatusColor,\n    consecutive_failures: int,\n    error: Optional[str] = None,\n) -> None:\n    \"\"\"\n    Publish alert/recovery event to Redis pub/sub.\n\n    Channel: agent.status.synthetics.crawler\n\n    Args:\n        redis_client: Async Redis client (may be None in tests)\n        source: Source name\n        status: 'red' (alert) or 'green' (recovery)\n        consecutive_failures: Current failure count\n        error: Error message (for alerts)\n    \"\"\"\n    if redis_client is None:\n        logger.debug(\n            \"crawler_health.pubsub_skip\",\n            reason=\"no_redis_client\",\n        )\n        return\n\n    event = {\n        \"source\": source,\n        \"status\": status,\n        \"consecutive_failures\": consecutive_failures,\n        \"ts\": datetime.now(timezone.utc).isoformat(),\n    }\n\n    if error and status == \"red\":\n        event[\"error\"] = error\n\n    channel = \"agent.status.synthetics.crawler\"\n\n    try:\n        await redis_client.publish(channel, json.dumps(event))\n        logger.info(\n            \"crawler_health.event_published\",\n            channel=channel,\n            source=source,\n            status=status,\n        )\n    except Exception as e:\n        logger.error(\n            \"crawler_health.publish_failed\",\n            channel=channel,\n            error=str(e),\n        )\n\n\n# ─── Report Generation ────────────────────────────────────────────────────────\n\n\ndef _write_report(\n    run_id: str,\n    started_at: str,\n    completed_at: str,\n    results: list[SourceCheckResult],\n    transitions: list[StateTransition],\n) -> Path:\n    \"\"\"\n    Write the crawler health report to synthetics/runs/<ts>/crawler-report.json.\n\n    Returns:\n        Path to the written report file.\n    \"\"\"\n    # Use timestamp-based directory like scoring runner\n    ts = datetime.now(timezone.utc).strftime(\"%Y%m%d_%H%M%S\")\n    run_dir = RUNS_DIR / ts\n    run_dir.mkdir(parents=True, exist_ok=True)\n\n    report = {\n        \"run_id\": run_id,\n        \"suite\": \"crawler\",\n        \"started_at\": started_at,\n        \"completed_at\": completed_at,\n        \"sources\": [\n            {\n                \"source\": r.source,\n                \"status\": r.status,\n                \"latency_ms\": r.latency_ms,\n                \"schema_match\": r.schema_match,\n                \"sample_jobs\": r.sample_jobs,\n                \"error\": r.error,\n            }\n            for r in results\n        ],\n        \"state_transitions\": [\n            {\n                \"source\": t.source,\n                \"previous_state\": {\n                    \"status\": t.previous_status,\n                    \"consecutive_failures\": t.previous_failures,\n                },\n                \"new_state\": {\n                    \"status\": t.new_status,\n                    \"consecutive_failures\": t.new_failures,\n                },\n                \"alert_fired\": t.alert_fired,\n            }\n            for t in transitions\n        ],\n    }\n\n    report_path = run_dir / \"crawler-report.json\"\n    with open(report_path, \"w\") as f:\n        json.dump(report, f, indent=2)\n\n    logger.info(\n        \"crawler_health.report_written\",\n        path=str(report_path),\n        run_id=run_id,\n    )\n\n    return report_path\n\n\n# ─── CrawlerHealthRunner ──────────────────────────────────────────────────────\n\n\nclass CrawlerHealthRunner:\n    \"\"\"\n    Upstream health monitoring runner for job board sources.\n\n    Exercises live crawler endpoints (Greenhouse, Lever, Ashby) with lightweight\n    requests, tracks consecutive failures via a state machine, and alerts on\n    3-strike threshold.\n\n    Contract: NUTRIENTS.md §I.6, HYPHA-SYNTHETICS-CRAWLER.md\n    \"\"\"\n\n    def __init__(\n        self,\n        redis_client: Optional[aioredis.Redis] = None,\n    ):\n        \"\"\"\n        Initialize the CrawlerHealthRunner.\n\n        Args:\n            redis_client: Async Redis client for pub/sub events (optional)\n        \"\"\"\n        self._redis = redis_client\n        self._run_id = str(uuid.uuid4())\n\n    async def run_suite(self) -> dict:\n        \"\"\"\n        Execute the full crawler health suite.\n\n        Checks all sources (Greenhouse, Lever, Ashby), updates state,\n        publishes alerts/recoveries, and writes a report.\n\n        Returns:\n            dict with:\n                - run_id: UUID of this run\n                - started_at: ISO timestamp\n                - completed_at: ISO timestamp\n                - sources: list of source check results\n                - state_transitions: list of state transitions\n                - report_path: path to the written report\n        \"\"\"\n        started_at = datetime.now(timezone.utc)\n\n        logger.info(\n            \"crawler_health.suite_start\",\n            run_id=self._run_id,\n            sources=list(HEALTH_TARGETS.keys()),\n        )\n\n        # Load current state\n        states = _load_state()\n\n        # Check each source\n        results: list[SourceCheckResult] = []\n        transitions: list[StateTransition] = []\n        new_states: dict[str, CrawlerHealthState] = {}\n\n        async with httpx.AsyncClient(\n            timeout=HTTP_TIMEOUT,\n            headers={\n                \"User-Agent\": USER_AGENT,\n                \"Accept\": \"application/json\",\n            },\n            follow_redirects=True,\n        ) as client:\n            for source in HEALTH_TARGETS:\n                source_name: SourceName = source  # type: ignore\n\n                result = await _check_source(client, source_name)\n                results.append(result)\n\n                # Apply to state\n                current_state = states.get(source, CrawlerHealthState(source=source_name))\n                new_state, transition = _apply_result_to_state(result, current_state)\n                new_states[source] = new_state\n                transitions.append(transition)\n\n                # Publish event if alert fired\n                if transition.alert_fired:\n                    await _publish_event(\n                        self._redis,\n                        source_name,\n                        new_state.status,\n                        new_state.consecutive_failures,\n                        new_state.last_error,\n                    )\n\n        # Save updated state\n        _save_state(new_states)\n\n        completed_at = datetime.now(timezone.utc)\n\n        # Write report\n        report_path = _write_report(\n            self._run_id,\n            started_at.isoformat(),\n            completed_at.isoformat(),\n            results,\n            transitions,\n        )\n\n        logger.info(\n            \"crawler_health.suite_complete\",\n            run_id=self._run_id,\n            duration_seconds=(completed_at - started_at).total_seconds(),\n            sources_checked=len(results),\n            alerts_fired=sum(1 for t in transitions if t.alert_fired),\n        )\n\n        return {\n            \"run_id\": self._run_id,\n            \"started_at\": started_at.isoformat(),\n            \"completed_at\": completed_at.isoformat(),\n            \"sources\": [\n                {\n                    \"source\": r.source,\n                    \"status\": r.status,\n                    \"latency_ms\": r.latency_ms,\n                    \"schema_match\": r.schema_match,\n                    \"sample_jobs\": r.sample_jobs,\n                    \"error\": r.error,\n                }\n                for r in results\n            ],\n            \"state_transitions\": [\n                {\n                    \"source\": t.source,\n                    \"previous_status\": t.previous_status,\n                    \"previous_failures\": t.previous_failures,\n                    \"new_status\": t.new_status,\n                    \"new_failures\": t.new_failures,\n                    \"alert_fired\": t.alert_fired,\n                }\n                for t in transitions\n            ],\n            \"report_path\": str(report_path),\n        }\n","numLines":729,"startLine":1,"totalLines":729}}}}
{"t":"2026-05-28T03:48:20.950Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011M6Mx2z8uWjrrhP8E6Hvik","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→CLI entry point for the synthetics scoring suite.\n     6→\n     7→Provides the command-line interface for running synthetic drift detection:\n     8→\n     9→    python -m backend.synthetics run --suite=scoring\n    10→\n    11→The CLI:\n    12→    1. Loads synthetic candidates from the database\n    13→    2. Loads JD fixtures from synthetics/fixtures/jobs/\n    14→    3. Runs the scoring suite against each candidate × JD pair\n    15→    4. Computes fingerprints and compares against baselines\n    16→    5. Writes a report to synthetics/runs/<ts>/scoring-report.json\n    17→    6. Publishes drift events if severity != green\n    18→\n    19→Contract: NUTRIENTS.md §I.2-I.7, HYPHA-SYNTHETICS-SCORING.md\n    20→Owner: synthetics-scoring-agent.cli\n    21→\"\"\"\n    22→\n    23→from __future__ import annotations\n    24→\n    25→import argparse\n    26→import asyncio\n    27→import json\n    28→import sys\n    29→from datetime import datetime, timezone\n    30→from pathlib import Path\n    31→from typing import Optional\n    32→\n    33→import structlog\n    34→\n    35→# Configure structlog before any logging happens\n    36→from backend.observability.logging import configure_logging\n    37→\n    38→configure_logging()\n    39→\n    40→logger = structlog.get_logger(__name__)\n    41→\n    42→\n    43→# ─── CLI Argument Parser ──────────────────────────────────────────────────────\n    44→\n    45→\n    46→def create_parser() -> argparse.ArgumentParser:\n    47→    \"\"\"\n    48→    Create the argument parser for the synthetics CLI.\n    49→\n    50→    Returns:\n    51→        Configured ArgumentParser\n    52→    \"\"\"\n    53→    parser = argparse.ArgumentParser(\n    54→        prog=\"python -m backend.synthetics\",\n    55→        description=\"Synthetics monitoring suite for Talent Agent\",\n    56→    )\n    57→\n    58→    subparsers = parser.add_subparsers(dest=\"command\", help=\"Available commands\")\n    59→\n    60→    # Run command\n    61→    run_parser = subparsers.add_parser(\n    62→        \"run\",\n    63→        help=\"Execute a synthetics test suite\",\n    64→    )\n    65→    run_parser.add_argument(\n    66→        \"--suite\",\n    67→        type=str,\n    68→        required=True,\n    69→        choices=[\"scoring\", \"crawler\"],\n    70→        help=\"Suite to run: 'scoring' for drift detection, 'crawler' for health checks\",\n    71→    )\n    72→    run_parser.add_argument(\n    73→        \"--output-dir\",\n    74→        type=str,\n    75→        default=None,\n    76→        help=\"Output directory for reports (default: synthetics/runs/<ts>/)\",\n    77→    )\n    78→    run_parser.add_argument(\n    79→        \"--no-publish\",\n    80→        action=\"store_true\",\n    81→        help=\"Skip publishing drift events to Redis\",\n    82→    )\n    83→    run_parser.add_argument(\n    84→        \"--verbose\",\n    85→        \"-v\",\n    86→        action=\"store_true\",\n    87→        help=\"Enable verbose output\",\n    88→    )\n    89→    run_parser.add_argument(\n    90→        \"--subsequent-run\",\n    91→        action=\"store_true\",\n    92→        help=(\n    93→            \"Mark this as a subsequent run for cache verification. \"\n    94→            \"Per NUTRIENTS.md §I.5, subsequent runs MUST have \"\n    95→            \"cache_creation_input_tokens == 0. If cache misses are detected, \"\n    96→            \"a cache_miss event is written to the report and logged at WARN level.\"\n    97→        ),\n    98→    )\n    99→\n   100→    return parser\n   101→\n   102→\n   103→# ─── Scoring Suite Runner ─────────────────────────────────────────────────────\n   104→\n   105→\n   106→async def run_scoring_suite(\n   107→    output_dir: Optional[str] = None,\n   108→    publish_events: bool = True,\n   109→    verbose: bool = False,\n   110→    is_subsequent_run: bool = False,\n   111→) -> int:\n   112→    \"\"\"\n   113→    Execute the scoring drift detection suite.\n   114→\n   115→    Flow:\n   116→        1. Initialize database and Redis connections\n   117→        2. Load synthetic candidates from database\n   118→        3. Load JD fixtures from synthetics/fixtures/jobs/\n   119→        4. For each candidate × JD pair, score via RelevanceScorer\n   120→        5. Compute fingerprints per candidate\n   121→        6. Load baselines and diff against them\n   122→        7. Write scoring-report.json to output directory\n   123→        8. Publish drift events if severity != green\n   124→\n   125→    Args:\n   126→        output_dir: Custom output directory (default: synthetics/runs/<ts>/)\n   127→        publish_events: Whether to publish drift events to Redis\n   128→        verbose: Enable verbose logging\n   129→        is_subsequent_run: Whether this is a subsequent run for cache verification\n   130→            Per NUTRIENTS.md §I.5, subsequent runs MUST have\n   131→            cache_creation_input_tokens == 0 (hit cache)\n   132→\n   133→    Returns:\n   134→        Exit code: 0 for success, 1 for hard failure\n   135→    \"\"\"\n   136→    from anthropic import AsyncAnthropic\n   137→    import redis.asyncio as aioredis\n   138→    from sqlalchemy.ext.asyncio import create_async_engine, async_sessionmaker, AsyncSession\n   139→\n   140→    from backend.config import settings\n   141→    from backend.synthetics.scoring_runner import ScoringSyntheticRunner\n   142→    from backend.synthetics.fingerprint import (\n   143→        compute_fingerprint,\n   144→        load_baseline,\n   145→        FingerprintContract,\n   146→    )\n   147→    from backend.synthetics.diff import diff_against_baseline, has_drift\n   148→\n   149→    # Determine output directory\n   150→    if output_dir is None:\n   151→        ts = datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H-%M-%SZ\")\n   152→        output_path = Path(__file__).parent.parent.parent / \"synthetics\" / \"runs\" / ts\n   153→    else:\n   154→        output_path = Path(output_dir)\n   155→\n   156→    output_path.mkdir(parents=True, exist_ok=True)\n   157→\n   158→    logger.info(\n   159→        \"scoring_suite.starting\",\n   160→        output_dir=str(output_path),\n   161→        publish_events=publish_events,\n   162→        is_subsequent_run=is_subsequent_run,\n   163→    )\n   164→\n   165→    # Initialize connections\n   166→    engine = create_async_engine(\n   167→        settings.database_url,\n   168→        echo=verbose,\n   169→        pool_pre_ping=True,\n   170→    )\n   171→    async_session = async_sessionmaker(\n   172→        engine,\n   173→        class_=AsyncSession,\n   174→        expire_on_commit=False,\n   175→    )\n   176→\n   177→    redis_client = aioredis.from_url(\n   178→        settings.redis_url,\n   179→        encoding=\"utf-8\",\n   180→        decode_responses=True,\n   181→    )\n   182→\n   183→    anthropic_client = AsyncAnthropic(api_key=settings.anthropic_api_key)\n   184→\n   185→    # Determine fixtures and baselines directories\n   186→    synthetics_dir = Path(__file__).parent.parent.parent / \"synthetics\"\n   187→    fixtures_dir = synthetics_dir / \"fixtures\"\n   188→    baselines_dir = fixtures_dir / \"baselines\"\n   189→\n   190→    try:\n   191→        async with async_session() as session:\n   192→            # Create runner and execute suite\n   193→            # Pass is_subsequent_run for cache contract verification (NUTRIENTS.md §I.5)\n   194→            runner = ScoringSyntheticRunner(\n   195→                session=session,\n   196→                redis_client=redis_client,\n   197→                anthropic_client=anthropic_client,\n   198→                fixtures_dir=fixtures_dir,\n   199→                is_subsequent_run=is_subsequent_run,\n   200→            )\n   201→\n   202→            suite_result = await runner.run_suite()\n   203→\n   204→        # Process results and compute fingerprints\n   205→        candidates_results = []\n   206→        overall_severity = \"green\"\n   207→        contract = FingerprintContract()\n   208→\n   209→        for candidate_result in suite_result.get(\"candidates\", []):\n   210→            candidate_id = candidate_result.get(\"candidate_id\")\n   211→\n   212→            # Compute fingerprint\n   213→            fingerprint = compute_fingerprint(\n   214→                candidate_result,\n   215→                contract=contract,\n   216→                baseline=None,  # We'll load baseline separately\n   217→            )\n   218→\n   219→            # Load baseline if exists\n   220→            baseline = load_baseline(str(baselines_dir), candidate_id)\n   221→\n   222→            # Diff against baseline\n   223→            drift_report = None\n   224→            if baseline is not None:\n   225→                drift_report = diff_against_baseline(fingerprint, baseline, contract)\n   226→\n   227→                # Update overall severity\n   228→                if drift_report.severity == \"red\":\n   229→                    overall_severity = \"red\"\n   230→                elif drift_report.severity == \"yellow\" and overall_severity == \"green\":\n   231→                    overall_severity = \"yellow\"\n   232→\n   233→                # Publish drift event if needed\n   234→                if publish_events and has_drift(drift_report):\n   235→                    await _publish_drift_event(redis_client, drift_report)\n   236→\n   237→            candidates_results.append({\n   238→                \"candidate_id\": candidate_id,\n   239→                \"fingerprint\": fingerprint.model_dump(),\n   240→                \"drift_report\": drift_report.model_dump() if drift_report else None,\n   241→                \"cache_stats\": candidate_result.get(\"cache_stats\", {}),\n   242→            })\n   243→\n   244→        # Build final report\n   245→        report = {\n   246→            \"run_id\": suite_result.get(\"run_id\"),\n   247→            \"suite\": \"scoring\",\n   248→            \"started_at\": suite_result.get(\"started_at\"),\n   249→            \"completed_at\": suite_result.get(\"completed_at\"),\n   250→            \"candidates\": candidates_results,\n   251→            \"overall_status\": overall_severity,\n   252→            \"overall_cache_stats\": suite_result.get(\"overall_cache_stats\", {}),\n   253→        }\n   254→\n   255→        # Write report to file\n   256→        report_path = output_path / \"scoring-report.json\"\n   257→        with open(report_path, \"w\") as f:\n   258→            json.dump(report, f, indent=2, default=str)\n   259→\n   260→        logger.info(\n   261→            \"scoring_suite.complete\",\n   262→            report_path=str(report_path),\n   263→            overall_severity=overall_severity,\n   264→            candidates_processed=len(candidates_results),\n   265→            cache_hit_rate=suite_result.get(\"overall_cache_stats\", {}).get(\"cache_hit_rate\", 0),\n   266→        )\n   267→\n   268→        # Log cache stats\n   269→        cache_stats = suite_result.get(\"overall_cache_stats\", {})\n   270→        if cache_stats.get(\"cache_hit_rate\", 0) < 0.9:\n   271→            logger.warning(\n   272→                \"scoring_suite.low_cache_hit_rate\",\n   273→                cache_hit_rate=cache_stats.get(\"cache_hit_rate\"),\n   274→                target_rate=0.9,\n   275→                cache_misses=cache_stats.get(\"cache_misses\"),\n   276→            )\n   277→\n   278→        return 0\n   279→\n   280→    except Exception as e:\n   281→        logger.error(\n   282→            \"scoring_suite.failed\",\n   283→            error=str(e),\n   284→            exc_info=True,\n   285→        )\n   286→        return 1\n   287→\n   288→    finally:\n   289→        # Cleanup connections\n   290→        await redis_client.aclose()\n   291→        await engine.dispose()\n   292→\n   293→\n   294→async def _publish_drift_event(\n   295→    redis_client,\n   296→    drift_report,\n   297→) -> None:\n   298→    \"\"\"\n   299→    Publish a drift event to Redis pub/sub.\n   300→\n   301→    Channel: agent.status.synthetics.drift\n   302→    Contract: NUTRIENTS.md §I.7\n   303→    \"\"\"\n   304→    from backend.observability.events import publish_event\n   305→\n   306→    event = {\n   307→        \"event\": \"SYNTHETICS_DRIFT\",\n   308→        \"candidate_id\": drift_report.candidate_id,\n   309→        \"run_id\": drift_report.run_id,\n   310→        \"severity\": drift_report.severity,\n   311→        \"violation_count\": len(drift_report.exact_violations) + len(drift_report.tolerance_violations),\n   312→        \"ts\": datetime.now(timezone.utc).isoformat(),\n   313→    }\n   314→\n   315→    try:\n   316→        await publish_event(\n   317→            redis_client,\n   318→            \"agent.status.synthetics.drift\",\n   319→            event,\n   320→        )\n   321→        logger.info(\n   322→            \"drift_event.published\",\n   323→            candidate_id=drift_report.candidate_id,\n   324→            severity=drift_report.severity,\n   325→        )\n   326→    except Exception as e:\n   327→        logger.error(\n   328→            \"drift_event.publish_failed\",\n   329→            error=str(e),\n   330→            candidate_id=drift_report.candidate_id,\n   331→        )\n   332→\n   333→\n   334→# ─── Main Entry Point ─────────────────────────────────────────────────────────\n   335→\n   336→\n   337→def main() -> int:\n   338→    \"\"\"\n   339→    Main entry point for the synthetics CLI.\n   340→\n   341→    Parses arguments and dispatches to the appropriate suite runner.\n   342→\n   343→    Returns:\n   344→        Exit code: 0 for success, 1 for failure\n   345→    \"\"\"\n   346→    parser = create_parser()\n   347→    args = parser.parse_args()\n   348→\n   349→    if args.command is None:\n   350→        parser.print_help()\n   351→        return 1\n   352→\n   353→    if args.command == \"run\":\n   354→        if args.suite == \"scoring\":\n   355→            return asyncio.run(\n   356→                run_scoring_suite(\n   357→                    output_dir=args.output_dir,\n   358→                    publish_events=not args.no_publish,\n   359→                    verbose=args.verbose,\n   360→                )\n   361→            )\n   362→        elif args.suite == \"crawler\":\n   363→            # Crawler suite is owned by synthetics-crawler-agent\n   364→            logger.error(\n   365→                \"cli.suite_not_implemented\",\n   366→                suite=args.suite,\n   367→                message=\"Crawler suite is owned by synthetics-crawler-agent\",\n   368→            )\n   369→            return 1\n   370→        else:\n   371→            logger.error(\"cli.unknown_suite\", suite=args.suite)\n   372→            return 1\n   373→\n   374→    return 0\n   375→\n   376→\n   377→if __name__ == \"__main__\":\n   378→    sys.exit(main())\n   379→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"652b4b3d-bcba-4c38-851d-efbb9fa0fa87","uuid":"91a8d5f2-2ed9-4f88-851e-bec3fbfbf7b4","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/synthetics/cli.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nCLI entry point for the synthetics scoring suite.\n\nProvides the command-line interface for running synthetic drift detection:\n\n    python -m backend.synthetics run --suite=scoring\n\nThe CLI:\n    1. Loads synthetic candidates from the database\n    2. Loads JD fixtures from synthetics/fixtures/jobs/\n    3. Runs the scoring suite against each candidate × JD pair\n    4. Computes fingerprints and compares against baselines\n    5. Writes a report to synthetics/runs/<ts>/scoring-report.json\n    6. Publishes drift events if severity != green\n\nContract: NUTRIENTS.md §I.2-I.7, HYPHA-SYNTHETICS-SCORING.md\nOwner: synthetics-scoring-agent.cli\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport asyncio\nimport json\nimport sys\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Optional\n\nimport structlog\n\n# Configure structlog before any logging happens\nfrom backend.observability.logging import configure_logging\n\nconfigure_logging()\n\nlogger = structlog.get_logger(__name__)\n\n\n# ─── CLI Argument Parser ──────────────────────────────────────────────────────\n\n\ndef create_parser() -> argparse.ArgumentParser:\n    \"\"\"\n    Create the argument parser for the synthetics CLI.\n\n    Returns:\n        Configured ArgumentParser\n    \"\"\"\n    parser = argparse.ArgumentParser(\n        prog=\"python -m backend.synthetics\",\n        description=\"Synthetics monitoring suite for Talent Agent\",\n    )\n\n    subparsers = parser.add_subparsers(dest=\"command\", help=\"Available commands\")\n\n    # Run command\n    run_parser = subparsers.add_parser(\n        \"run\",\n        help=\"Execute a synthetics test suite\",\n    )\n    run_parser.add_argument(\n        \"--suite\",\n        type=str,\n        required=True,\n        choices=[\"scoring\", \"crawler\"],\n        help=\"Suite to run: 'scoring' for drift detection, 'crawler' for health checks\",\n    )\n    run_parser.add_argument(\n        \"--output-dir\",\n        type=str,\n        default=None,\n        help=\"Output directory for reports (default: synthetics/runs/<ts>/)\",\n    )\n    run_parser.add_argument(\n        \"--no-publish\",\n        action=\"store_true\",\n        help=\"Skip publishing drift events to Redis\",\n    )\n    run_parser.add_argument(\n        \"--verbose\",\n        \"-v\",\n        action=\"store_true\",\n        help=\"Enable verbose output\",\n    )\n    run_parser.add_argument(\n        \"--subsequent-run\",\n        action=\"store_true\",\n        help=(\n            \"Mark this as a subsequent run for cache verification. \"\n            \"Per NUTRIENTS.md §I.5, subsequent runs MUST have \"\n            \"cache_creation_input_tokens == 0. If cache misses are detected, \"\n            \"a cache_miss event is written to the report and logged at WARN level.\"\n        ),\n    )\n\n    return parser\n\n\n# ─── Scoring Suite Runner ─────────────────────────────────────────────────────\n\n\nasync def run_scoring_suite(\n    output_dir: Optional[str] = None,\n    publish_events: bool = True,\n    verbose: bool = False,\n    is_subsequent_run: bool = False,\n) -> int:\n    \"\"\"\n    Execute the scoring drift detection suite.\n\n    Flow:\n        1. Initialize database and Redis connections\n        2. Load synthetic candidates from database\n        3. Load JD fixtures from synthetics/fixtures/jobs/\n        4. For each candidate × JD pair, score via RelevanceScorer\n        5. Compute fingerprints per candidate\n        6. Load baselines and diff against them\n        7. Write scoring-report.json to output directory\n        8. Publish drift events if severity != green\n\n    Args:\n        output_dir: Custom output directory (default: synthetics/runs/<ts>/)\n        publish_events: Whether to publish drift events to Redis\n        verbose: Enable verbose logging\n        is_subsequent_run: Whether this is a subsequent run for cache verification\n            Per NUTRIENTS.md §I.5, subsequent runs MUST have\n            cache_creation_input_tokens == 0 (hit cache)\n\n    Returns:\n        Exit code: 0 for success, 1 for hard failure\n    \"\"\"\n    from anthropic import AsyncAnthropic\n    import redis.asyncio as aioredis\n    from sqlalchemy.ext.asyncio import create_async_engine, async_sessionmaker, AsyncSession\n\n    from backend.config import settings\n    from backend.synthetics.scoring_runner import ScoringSyntheticRunner\n    from backend.synthetics.fingerprint import (\n        compute_fingerprint,\n        load_baseline,\n        FingerprintContract,\n    )\n    from backend.synthetics.diff import diff_against_baseline, has_drift\n\n    # Determine output directory\n    if output_dir is None:\n        ts = datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H-%M-%SZ\")\n        output_path = Path(__file__).parent.parent.parent / \"synthetics\" / \"runs\" / ts\n    else:\n        output_path = Path(output_dir)\n\n    output_path.mkdir(parents=True, exist_ok=True)\n\n    logger.info(\n        \"scoring_suite.starting\",\n        output_dir=str(output_path),\n        publish_events=publish_events,\n        is_subsequent_run=is_subsequent_run,\n    )\n\n    # Initialize connections\n    engine = create_async_engine(\n        settings.database_url,\n        echo=verbose,\n        pool_pre_ping=True,\n    )\n    async_session = async_sessionmaker(\n        engine,\n        class_=AsyncSession,\n        expire_on_commit=False,\n    )\n\n    redis_client = aioredis.from_url(\n        settings.redis_url,\n        encoding=\"utf-8\",\n        decode_responses=True,\n    )\n\n    anthropic_client = AsyncAnthropic(api_key=settings.anthropic_api_key)\n\n    # Determine fixtures and baselines directories\n    synthetics_dir = Path(__file__).parent.parent.parent / \"synthetics\"\n    fixtures_dir = synthetics_dir / \"fixtures\"\n    baselines_dir = fixtures_dir / \"baselines\"\n\n    try:\n        async with async_session() as session:\n            # Create runner and execute suite\n            # Pass is_subsequent_run for cache contract verification (NUTRIENTS.md §I.5)\n            runner = ScoringSyntheticRunner(\n                session=session,\n                redis_client=redis_client,\n                anthropic_client=anthropic_client,\n                fixtures_dir=fixtures_dir,\n                is_subsequent_run=is_subsequent_run,\n            )\n\n            suite_result = await runner.run_suite()\n\n        # Process results and compute fingerprints\n        candidates_results = []\n        overall_severity = \"green\"\n        contract = FingerprintContract()\n\n        for candidate_result in suite_result.get(\"candidates\", []):\n            candidate_id = candidate_result.get(\"candidate_id\")\n\n            # Compute fingerprint\n            fingerprint = compute_fingerprint(\n                candidate_result,\n                contract=contract,\n                baseline=None,  # We'll load baseline separately\n            )\n\n            # Load baseline if exists\n            baseline = load_baseline(str(baselines_dir), candidate_id)\n\n            # Diff against baseline\n            drift_report = None\n            if baseline is not None:\n                drift_report = diff_against_baseline(fingerprint, baseline, contract)\n\n                # Update overall severity\n                if drift_report.severity == \"red\":\n                    overall_severity = \"red\"\n                elif drift_report.severity == \"yellow\" and overall_severity == \"green\":\n                    overall_severity = \"yellow\"\n\n                # Publish drift event if needed\n                if publish_events and has_drift(drift_report):\n                    await _publish_drift_event(redis_client, drift_report)\n\n            candidates_results.append({\n                \"candidate_id\": candidate_id,\n                \"fingerprint\": fingerprint.model_dump(),\n                \"drift_report\": drift_report.model_dump() if drift_report else None,\n                \"cache_stats\": candidate_result.get(\"cache_stats\", {}),\n            })\n\n        # Build final report\n        report = {\n            \"run_id\": suite_result.get(\"run_id\"),\n            \"suite\": \"scoring\",\n            \"started_at\": suite_result.get(\"started_at\"),\n            \"completed_at\": suite_result.get(\"completed_at\"),\n            \"candidates\": candidates_results,\n            \"overall_status\": overall_severity,\n            \"overall_cache_stats\": suite_result.get(\"overall_cache_stats\", {}),\n        }\n\n        # Write report to file\n        report_path = output_path / \"scoring-report.json\"\n        with open(report_path, \"w\") as f:\n            json.dump(report, f, indent=2, default=str)\n\n        logger.info(\n            \"scoring_suite.complete\",\n            report_path=str(report_path),\n            overall_severity=overall_severity,\n            candidates_processed=len(candidates_results),\n            cache_hit_rate=suite_result.get(\"overall_cache_stats\", {}).get(\"cache_hit_rate\", 0),\n        )\n\n        # Log cache stats\n        cache_stats = suite_result.get(\"overall_cache_stats\", {})\n        if cache_stats.get(\"cache_hit_rate\", 0) < 0.9:\n            logger.warning(\n                \"scoring_suite.low_cache_hit_rate\",\n                cache_hit_rate=cache_stats.get(\"cache_hit_rate\"),\n                target_rate=0.9,\n                cache_misses=cache_stats.get(\"cache_misses\"),\n            )\n\n        return 0\n\n    except Exception as e:\n        logger.error(\n            \"scoring_suite.failed\",\n            error=str(e),\n            exc_info=True,\n        )\n        return 1\n\n    finally:\n        # Cleanup connections\n        await redis_client.aclose()\n        await engine.dispose()\n\n\nasync def _publish_drift_event(\n    redis_client,\n    drift_report,\n) -> None:\n    \"\"\"\n    Publish a drift event to Redis pub/sub.\n\n    Channel: agent.status.synthetics.drift\n    Contract: NUTRIENTS.md §I.7\n    \"\"\"\n    from backend.observability.events import publish_event\n\n    event = {\n        \"event\": \"SYNTHETICS_DRIFT\",\n        \"candidate_id\": drift_report.candidate_id,\n        \"run_id\": drift_report.run_id,\n        \"severity\": drift_report.severity,\n        \"violation_count\": len(drift_report.exact_violations) + len(drift_report.tolerance_violations),\n        \"ts\": datetime.now(timezone.utc).isoformat(),\n    }\n\n    try:\n        await publish_event(\n            redis_client,\n            \"agent.status.synthetics.drift\",\n            event,\n        )\n        logger.info(\n            \"drift_event.published\",\n            candidate_id=drift_report.candidate_id,\n            severity=drift_report.severity,\n        )\n    except Exception as e:\n        logger.error(\n            \"drift_event.publish_failed\",\n            error=str(e),\n            candidate_id=drift_report.candidate_id,\n        )\n\n\n# ─── Main Entry Point ─────────────────────────────────────────────────────────\n\n\ndef main() -> int:\n    \"\"\"\n    Main entry point for the synthetics CLI.\n\n    Parses arguments and dispatches to the appropriate suite runner.\n\n    Returns:\n        Exit code: 0 for success, 1 for failure\n    \"\"\"\n    parser = create_parser()\n    args = parser.parse_args()\n\n    if args.command is None:\n        parser.print_help()\n        return 1\n\n    if args.command == \"run\":\n        if args.suite == \"scoring\":\n            return asyncio.run(\n                run_scoring_suite(\n                    output_dir=args.output_dir,\n                    publish_events=not args.no_publish,\n                    verbose=args.verbose,\n                )\n            )\n        elif args.suite == \"crawler\":\n            # Crawler suite is owned by synthetics-crawler-agent\n            logger.error(\n                \"cli.suite_not_implemented\",\n                suite=args.suite,\n                message=\"Crawler suite is owned by synthetics-crawler-agent\",\n            )\n            return 1\n        else:\n            logger.error(\"cli.unknown_suite\", suite=args.suite)\n            return 1\n\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","numLines":379,"startLine":1,"totalLines":379}}}}
