{"t":"2026-05-28T04:00:19.498Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018ewqWeFhWNS2bGZv3YV5VQ","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→CLI entry point for the synthetics monitoring suites.\n     6→\n     7→Provides the command-line interface for running synthetic monitoring:\n     8→\n     9→    python -m backend.synthetics run --suite=scoring\n    10→    python -m backend.synthetics run --suite=crawler\n    11→\n    12→Scoring Suite (--suite=scoring):\n    13→    1. Loads synthetic candidates from the database\n    14→    2. Loads JD fixtures from synthetics/fixtures/jobs/\n    15→    3. Runs the scoring suite against each candidate × JD pair\n    16→    4. Computes fingerprints and compares against baselines\n    17→    5. Writes a report to synthetics/runs/<ts>/scoring-report.json\n    18→    6. Publishes drift events if severity != green\n    19→\n    20→Crawler Suite (--suite=crawler):\n    21→    1. Hits known-good slugs for Greenhouse, Lever, Ashby\n    22→    2. Validates response schemas\n    23→    3. Updates state machine in synthetics/state.json\n    24→    4. Publishes alert on 3 consecutive failures (red status)\n    25→    5. Publishes recovery when returning to green after red\n    26→    6. Writes a report to synthetics/runs/<ts>/crawler-report.json\n    27→\n    28→Contract: NUTRIENTS.md §I.2-I.7, HYPHA-SYNTHETICS-SCORING.md, HYPHA-SYNTHETICS-CRAWLER.md\n    29→Owner: synthetics-scoring-agent.cli, synthetics-crawler-agent.state-machine\n    30→\"\"\"\n    31→\n    32→from __future__ import annotations\n    33→\n    34→import argparse\n    35→import asyncio\n    36→import json\n    37→import sys\n    38→from datetime import datetime, timezone\n    39→from pathlib import Path\n    40→from typing import Optional\n    41→\n    42→import structlog\n    43→\n    44→# Configure structlog before any logging happens\n    45→from backend.observability.logging import configure_logging\n    46→\n    47→configure_logging()\n    48→\n    49→logger = structlog.get_logger(__name__)\n    50→\n    51→\n    52→# ─── CLI Argument Parser ──────────────────────────────────────────────────────\n    53→\n    54→\n    55→def create_parser() -> argparse.ArgumentParser:\n    56→    \"\"\"\n    57→    Create the argument parser for the synthetics CLI.\n    58→\n    59→    Returns:\n    60→        Configured ArgumentParser\n    61→    \"\"\"\n    62→    parser = argparse.ArgumentParser(\n    63→        prog=\"python -m backend.synthetics\",\n    64→        description=\"Synthetics monitoring suite for Talent Agent\",\n    65→    )\n    66→\n    67→    subparsers = parser.add_subparsers(dest=\"command\", help=\"Available commands\")\n    68→\n    69→    # Run command\n    70→    run_parser = subparsers.add_parser(\n    71→        \"run\",\n    72→        help=\"Execute a synthetics test suite\",\n    73→    )\n    74→    run_parser.add_argument(\n    75→        \"--suite\",\n    76→        type=str,\n    77→        required=True,\n    78→        choices=[\"scoring\", \"crawler\"],\n    79→        help=\"Suite to run: 'scoring' for drift detection, 'crawler' for health checks\",\n    80→    )\n    81→    run_parser.add_argument(\n    82→        \"--output-dir\",\n    83→        type=str,\n    84→        default=None,\n    85→        help=\"Output directory for reports (default: synthetics/runs/<ts>/)\",\n    86→    )\n    87→    run_parser.add_argument(\n    88→        \"--no-publish\",\n    89→        action=\"store_true\",\n    90→        help=\"Skip publishing drift events to Redis\",\n    91→    )\n    92→    run_parser.add_argument(\n    93→        \"--verbose\",\n    94→        \"-v\",\n    95→        action=\"store_true\",\n    96→        help=\"Enable verbose output\",\n    97→    )\n    98→    run_parser.add_argument(\n    99→        \"--subsequent-run\",\n   100→        action=\"store_true\",\n   101→        help=(\n   102→            \"Mark this as a subsequent run for cache verification. \"\n   103→            \"Per NUTRIENTS.md §I.5, subsequent runs MUST have \"\n   104→            \"cache_creation_input_tokens == 0. If cache misses are detected, \"\n   105→            \"a cache_miss event is written to the report and logged at WARN level.\"\n   106→        ),\n   107→    )\n   108→\n   109→    return parser\n   110→\n   111→\n   112→# ─── Scoring Suite Runner ─────────────────────────────────────────────────────\n   113→\n   114→\n   115→async def run_scoring_suite(\n   116→    output_dir: Optional[str] = None,\n   117→    publish_events: bool = True,\n   118→    verbose: bool = False,\n   119→    is_subsequent_run: bool = False,\n   120→) -> int:\n   121→    \"\"\"\n   122→    Execute the scoring drift detection suite.\n   123→\n   124→    Flow:\n   125→        1. Initialize database and Redis connections\n   126→        2. Load synthetic candidates from database\n   127→        3. Load JD fixtures from synthetics/fixtures/jobs/\n   128→        4. For each candidate × JD pair, score via RelevanceScorer\n   129→        5. Compute fingerprints per candidate\n   130→        6. Load baselines and diff against them\n   131→        7. Write scoring-report.json to output directory\n   132→        8. Publish drift events if severity != green\n   133→\n   134→    Args:\n   135→        output_dir: Custom output directory (default: synthetics/runs/<ts>/)\n   136→        publish_events: Whether to publish drift events to Redis\n   137→        verbose: Enable verbose logging\n   138→        is_subsequent_run: Whether this is a subsequent run for cache verification\n   139→            Per NUTRIENTS.md §I.5, subsequent runs MUST have\n   140→            cache_creation_input_tokens == 0 (hit cache)\n   141→\n   142→    Returns:\n   143→        Exit code: 0 for success, 1 for hard failure\n   144→    \"\"\"\n   145→    from anthropic import AsyncAnthropic\n   146→    import redis.asyncio as aioredis\n   147→    from sqlalchemy.ext.asyncio import create_async_engine, async_sessionmaker, AsyncSession\n   148→\n   149→    from backend.config import settings\n   150→    from backend.synthetics.scoring_runner import ScoringSyntheticRunner\n   151→    from backend.synthetics.fingerprint import (\n   152→        compute_fingerprint,\n   153→        load_baseline,\n   154→        FingerprintContract,\n   155→    )\n   156→    from backend.synthetics.diff import diff_against_baseline, has_drift\n   157→\n   158→    # Determine output directory\n   159→    if output_dir is None:\n   160→        ts = datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H-%M-%SZ\")\n   161→        output_path = Path(__file__).parent.parent.parent / \"synthetics\" / \"runs\" / ts\n   162→    else:\n   163→        output_path = Path(output_dir)\n   164→\n   165→    output_path.mkdir(parents=True, exist_ok=True)\n   166→\n   167→    logger.info(\n   168→        \"scoring_suite.starting\",\n   169→        output_dir=str(output_path),\n   170→        publish_events=publish_events,\n   171→        is_subsequent_run=is_subsequent_run,\n   172→    )\n   173→\n   174→    # Initialize connections\n   175→    engine = create_async_engine(\n   176→        settings.database_url,\n   177→        echo=verbose,\n   178→        pool_pre_ping=True,\n   179→    )\n   180→    async_session = async_sessionmaker(\n   181→        engine,\n   182→        class_=AsyncSession,\n   183→        expire_on_commit=False,\n   184→    )\n   185→\n   186→    redis_client = aioredis.from_url(\n   187→        settings.redis_url,\n   188→        encoding=\"utf-8\",\n   189→        decode_responses=True,\n   190→    )\n   191→\n   192→    anthropic_client = AsyncAnthropic(api_key=settings.anthropic_api_key)\n   193→\n   194→    # Determine fixtures and baselines directories\n   195→    synthetics_dir = Path(__file__).parent.parent.parent / \"synthetics\"\n   196→    fixtures_dir = synthetics_dir / \"fixtures\"\n   197→    baselines_dir = fixtures_dir / \"baselines\"\n   198→\n   199→    try:\n   200→        async with async_session() as session:\n   201→            # Create runner and execute suite\n   202→            # Pass is_subsequent_run for cache contract verification (NUTRIENTS.md §I.5)\n   203→            runner = ScoringSyntheticRunner(\n   204→                session=session,\n   205→                redis_client=redis_client,\n   206→                anthropic_client=anthropic_client,\n   207→                fixtures_dir=fixtures_dir,\n   208→                is_subsequent_run=is_subsequent_run,\n   209→            )\n   210→\n   211→            suite_result = await runner.run_suite()\n   212→\n   213→        # Process results and compute fingerprints\n   214→        candidates_results = []\n   215→        overall_severity = \"green\"\n   216→        contract = FingerprintContract()\n   217→\n   218→        for candidate_result in suite_result.get(\"candidates\", []):\n   219→            candidate_id = candidate_result.get(\"candidate_id\")\n   220→\n   221→            # Compute fingerprint\n   222→            fingerprint = compute_fingerprint(\n   223→                candidate_result,\n   224→                contract=contract,\n   225→                baseline=None,  # We'll load baseline separately\n   226→            )\n   227→\n   228→            # Load baseline if exists\n   229→            baseline = load_baseline(str(baselines_dir), candidate_id)\n   230→\n   231→            # Diff against baseline\n   232→            drift_report = None\n   233→            if baseline is not None:\n   234→                drift_report = diff_against_baseline(fingerprint, baseline, contract)\n   235→\n   236→                # Update overall severity\n   237→                if drift_report.severity == \"red\":\n   238→                    overall_severity = \"red\"\n   239→                elif drift_report.severity == \"yellow\" and overall_severity == \"green\":\n   240→                    overall_severity = \"yellow\"\n   241→\n   242→                # Publish drift event if needed\n   243→                if publish_events and has_drift(drift_report):\n   244→                    await _publish_drift_event(redis_client, drift_report)\n   245→\n   246→            candidates_results.append({\n   247→                \"candidate_id\": candidate_id,\n   248→                \"fingerprint\": fingerprint.model_dump(),\n   249→                \"drift_report\": drift_report.model_dump() if drift_report else None,\n   250→                \"cache_stats\": candidate_result.get(\"cache_stats\", {}),\n   251→            })\n   252→\n   253→        # Build final report (includes cache_verification per NUTRIENTS.md §I.5)\n   254→        cache_verification = suite_result.get(\"cache_verification\", {})\n   255→        report = {\n   256→            \"run_id\": suite_result.get(\"run_id\"),\n   257→            \"suite\": \"scoring\",\n   258→            \"started_at\": suite_result.get(\"started_at\"),\n   259→            \"completed_at\": suite_result.get(\"completed_at\"),\n   260→            \"candidates\": candidates_results,\n   261→            \"overall_status\": overall_severity,\n   262→            \"overall_cache_stats\": suite_result.get(\"overall_cache_stats\", {}),\n   263→            # Cache verification section (NUTRIENTS.md §I.5)\n   264→            \"cache_verification\": cache_verification,\n   265→        }\n   266→\n   267→        # Write report to file\n   268→        report_path = output_path / \"scoring-report.json\"\n   269→        with open(report_path, \"w\") as f:\n   270→            json.dump(report, f, indent=2, default=str)\n   271→\n   272→        # Log cache contract verification result (NUTRIENTS.md §I.5)\n   273→        if cache_verification.get(\"cache_contract_violated\", False):\n   274→            logger.warning(\n   275→                \"scoring_suite.cache_contract_violated\",\n   276→                is_subsequent_run=cache_verification.get(\"is_subsequent_run\"),\n   277→                cache_miss_event_count=len(cache_verification.get(\"cache_miss_events\", [])),\n   278→                message=\"Subsequent run had cache misses (cache_creation_input_tokens > 0)\",\n   279→            )\n   280→\n   281→        logger.info(\n   282→            \"scoring_suite.complete\",\n   283→            report_path=str(report_path),\n   284→            overall_severity=overall_severity,\n   285→            candidates_processed=len(candidates_results),\n   286→            cache_hit_rate=suite_result.get(\"overall_cache_stats\", {}).get(\"cache_hit_rate\", 0),\n   287→            cache_contract_violated=cache_verification.get(\"cache_contract_violated\", False),\n   288→        )\n   289→\n   290→        # Log cache stats\n   291→        cache_stats = suite_result.get(\"overall_cache_stats\", {})\n   292→        if cache_stats.get(\"cache_hit_rate\", 0) < 0.9:\n   293→            logger.warning(\n   294→                \"scoring_suite.low_cache_hit_rate\",\n   295→                cache_hit_rate=cache_stats.get(\"cache_hit_rate\"),\n   296→                target_rate=0.9,\n   297→                cache_misses=cache_stats.get(\"cache_misses\"),\n   298→            )\n   299→\n   300→        return 0\n   301→\n   302→    except Exception as e:\n   303→        logger.error(\n   304→            \"scoring_suite.failed\",\n   305→            error=str(e),\n   306→            exc_info=True,\n   307→        )\n   308→        return 1\n   309→\n   310→    finally:\n   311→        # Cleanup connections\n   312→        await redis_client.aclose()\n   313→        await engine.dispose()\n   314→\n   315→\n   316→# ─── Crawler Suite Runner ─────────────────────────────────────────────────────\n   317→\n   318→\n   319→async def run_crawler_suite(\n   320→    output_dir: Optional[str] = None,\n   321→    publish_events: bool = True,\n   322→    verbose: bool = False,\n   323→) -> int:\n   324→    \"\"\"\n   325→    Execute the crawler health monitoring suite.\n   326→\n   327→    Flow:\n   328→        1. Initialize Redis connection (optional, for pub/sub)\n   329→        2. Create CrawlerHealthRunner\n   330→        3. Run health checks against Greenhouse, Lever, Ashby\n   331→        4. Update state machine in synthetics/state.json\n   332→        5. Publish alert/recovery events on 3-strike threshold\n   333→        6. Write crawler-report.json to output directory\n   334→\n   335→    The state machine tracks consecutive_failures per source:\n   336→        - consecutive_failures < 3: status = 'green' (no alert)\n   337→        - consecutive_failures >= 3: status = 'red', publish alert\n   338→        - Success after failures: reset to 0, publish recovery if was red\n   339→\n   340→    Contract: NUTRIENTS.md §I.6, HYPHA-SYNTHETICS-CRAWLER.md\n   341→    Owner: synthetics-crawler-agent.state-machine\n   342→\n   343→    Args:\n   344→        output_dir: Custom output directory (default: synthetics/runs/<ts>/)\n   345→        publish_events: Whether to publish alert/recovery events to Redis\n   346→        verbose: Enable verbose logging\n   347→\n   348→    Returns:\n   349→        Exit code: 0 for success, 1 for hard failure\n   350→    \"\"\"\n   351→    import redis.asyncio as aioredis\n   352→\n   353→    from backend.config import settings\n   354→    from backend.synthetics.crawler_health import CrawlerHealthRunner\n   355→\n   356→    logger.info(\n   357→        \"crawler_suite.starting\",\n   358→        publish_events=publish_events,\n   359→        verbose=verbose,\n   360→    )\n   361→\n   362→    # Initialize Redis for pub/sub (optional)\n   363→    redis_client = None\n   364→    if publish_events:\n   365→        try:\n   366→            redis_client = aioredis.from_url(\n   367→                settings.redis_url,\n   368→                encoding=\"utf-8\",\n   369→                decode_responses=True,\n   370→            )\n   371→            logger.debug(\"crawler_suite.redis_connected\")\n   372→        except Exception as e:\n   373→            logger.warning(\n   374→                \"crawler_suite.redis_unavailable\",\n   375→                error=str(e),\n   376→                message=\"Continuing without pub/sub\",\n   377→            )\n   378→            redis_client = None\n   379→\n   380→    try:\n   381→        # Create and run the health check suite\n   382→        runner = CrawlerHealthRunner(redis_client=redis_client)\n   383→        result = await runner.run_suite()\n   384→\n   385→        # Log summary\n   386→        sources_checked = len(result.get(\"sources\", []))\n   387→        alerts_fired = sum(\n   388→            1 for t in result.get(\"state_transitions\", [])\n   389→            if t.get(\"alert_fired\", False)\n   390→        )\n   391→        all_green = all(\n   392→            s.get(\"status\") == \"success\"\n   393→            for s in result.get(\"sources\", [])\n   394→        )\n   395→\n   396→        logger.info(\n   397→            \"crawler_suite.complete\",\n   398→            run_id=result.get(\"run_id\"),\n   399→            report_path=result.get(\"report_path\"),\n   400→            sources_checked=sources_checked,\n   401→            alerts_fired=alerts_fired,\n   402→            all_green=all_green,\n   403→        )\n   404→\n   405→        return 0\n   406→\n   407→    except Exception as e:\n   408→        logger.error(\n   409→            \"crawler_suite.failed\",\n   410→            error=str(e),\n   411→            exc_info=True,\n   412→        )\n   413→        return 1\n   414→\n   415→    finally:\n   416→        # Cleanup Redis connection\n   417→        if redis_client is not None:\n   418→            try:\n   419→                await redis_client.aclose()\n   420→            except Exception:\n   421→                pass\n   422→\n   423→\n   424→async def _publish_drift_event(\n   425→    redis_client,\n   426→    drift_report,\n   427→) -> None:\n   428→    \"\"\"\n   429→    Publish a drift event to Redis pub/sub.\n   430→\n   431→    Channel: agent.status.synthetics.drift\n   432→    Contract: NUTRIENTS.md §I.7\n   433→    \"\"\"\n   434→    from backend.observability.events import publish_event\n   435→\n   436→    event = {\n   437→        \"event\": \"SYNTHETICS_DRIFT\",\n   438→        \"candidate_id\": drift_report.candidate_id,\n   439→        \"run_id\": drift_report.run_id,\n   440→        \"severity\": drift_report.severity,\n   441→        \"violation_count\": len(drift_report.exact_violations) + len(drift_report.tolerance_violations),\n   442→        \"ts\": datetime.now(timezone.utc).isoformat(),\n   443→    }\n   444→\n   445→    try:\n   446→        await publish_event(\n   447→            redis_client,\n   448→            \"agent.status.synthetics.drift\",\n   449→            event,\n   450→        )\n   451→        logger.info(\n   452→            \"drift_event.published\",\n   453→            candidate_id=drift_report.candidate_id,\n   454→            severity=drift_report.severity,\n   455→        )\n   456→    except Exception as e:\n   457→        logger.error(\n   458→            \"drift_event.publish_failed\",\n   459→            error=str(e),\n   460→            candidate_id=drift_report.candidate_id,\n   461→        )\n   462→\n   463→\n   464→# ─── Main Entry Point ─────────────────────────────────────────────────────────\n   465→\n   466→\n   467→def main() -> int:\n   468→    \"\"\"\n   469→    Main entry point for the synthetics CLI.\n   470→\n   471→    Parses arguments and dispatches to the appropriate suite runner.\n   472→\n   473→    Returns:\n   474→        Exit code: 0 for success, 1 for failure\n   475→    \"\"\"\n   476→    parser = create_parser()\n   477→    args = parser.parse_args()\n   478→\n   479→    if args.command is None:\n   480→        parser.print_help()\n   481→        return 1\n   482→\n   483→    if args.command == \"run\":\n   484→        if args.suite == \"scoring\":\n   485→            return asyncio.run(\n   486→                run_scoring_suite(\n   487→                    output_dir=args.output_dir,\n   488→                    publish_events=not args.no_publish,\n   489→                    verbose=args.verbose,\n   490→                    is_subsequent_run=getattr(args, \"subsequent_run\", False),\n   491→                )\n   492→            )\n   493→        elif args.suite == \"crawler\":\n   494→            return asyncio.run(\n   495→                run_crawler_suite(\n   496→                    output_dir=args.output_dir,\n   497→                    publish_events=not args.no_publish,\n   498→                    verbose=args.verbose,\n   499→                )\n   500→            )\n   501→        else:\n   502→            logger.error(\"cli.unknown_suite\", suite=args.suite)\n   503→            return 1\n   504→\n   505→    return 0\n   506→\n   507→\n   508→if __name__ == \"__main__\":\n   509→    sys.exit(main())\n   510→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"652b4b3d-bcba-4c38-851d-efbb9fa0fa87","uuid":"701bcf48-a9bb-484e-88a9-dcbd3b68d437","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/synthetics/cli.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nCLI entry point for the synthetics monitoring suites.\n\nProvides the command-line interface for running synthetic monitoring:\n\n    python -m backend.synthetics run --suite=scoring\n    python -m backend.synthetics run --suite=crawler\n\nScoring Suite (--suite=scoring):\n    1. Loads synthetic candidates from the database\n    2. Loads JD fixtures from synthetics/fixtures/jobs/\n    3. Runs the scoring suite against each candidate × JD pair\n    4. Computes fingerprints and compares against baselines\n    5. Writes a report to synthetics/runs/<ts>/scoring-report.json\n    6. Publishes drift events if severity != green\n\nCrawler Suite (--suite=crawler):\n    1. Hits known-good slugs for Greenhouse, Lever, Ashby\n    2. Validates response schemas\n    3. Updates state machine in synthetics/state.json\n    4. Publishes alert on 3 consecutive failures (red status)\n    5. Publishes recovery when returning to green after red\n    6. Writes a report to synthetics/runs/<ts>/crawler-report.json\n\nContract: NUTRIENTS.md §I.2-I.7, HYPHA-SYNTHETICS-SCORING.md, HYPHA-SYNTHETICS-CRAWLER.md\nOwner: synthetics-scoring-agent.cli, synthetics-crawler-agent.state-machine\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport asyncio\nimport json\nimport sys\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Optional\n\nimport structlog\n\n# Configure structlog before any logging happens\nfrom backend.observability.logging import configure_logging\n\nconfigure_logging()\n\nlogger = structlog.get_logger(__name__)\n\n\n# ─── CLI Argument Parser ──────────────────────────────────────────────────────\n\n\ndef create_parser() -> argparse.ArgumentParser:\n    \"\"\"\n    Create the argument parser for the synthetics CLI.\n\n    Returns:\n        Configured ArgumentParser\n    \"\"\"\n    parser = argparse.ArgumentParser(\n        prog=\"python -m backend.synthetics\",\n        description=\"Synthetics monitoring suite for Talent Agent\",\n    )\n\n    subparsers = parser.add_subparsers(dest=\"command\", help=\"Available commands\")\n\n    # Run command\n    run_parser = subparsers.add_parser(\n        \"run\",\n        help=\"Execute a synthetics test suite\",\n    )\n    run_parser.add_argument(\n        \"--suite\",\n        type=str,\n        required=True,\n        choices=[\"scoring\", \"crawler\"],\n        help=\"Suite to run: 'scoring' for drift detection, 'crawler' for health checks\",\n    )\n    run_parser.add_argument(\n        \"--output-dir\",\n        type=str,\n        default=None,\n        help=\"Output directory for reports (default: synthetics/runs/<ts>/)\",\n    )\n    run_parser.add_argument(\n        \"--no-publish\",\n        action=\"store_true\",\n        help=\"Skip publishing drift events to Redis\",\n    )\n    run_parser.add_argument(\n        \"--verbose\",\n        \"-v\",\n        action=\"store_true\",\n        help=\"Enable verbose output\",\n    )\n    run_parser.add_argument(\n        \"--subsequent-run\",\n        action=\"store_true\",\n        help=(\n            \"Mark this as a subsequent run for cache verification. \"\n            \"Per NUTRIENTS.md §I.5, subsequent runs MUST have \"\n            \"cache_creation_input_tokens == 0. If cache misses are detected, \"\n            \"a cache_miss event is written to the report and logged at WARN level.\"\n        ),\n    )\n\n    return parser\n\n\n# ─── Scoring Suite Runner ─────────────────────────────────────────────────────\n\n\nasync def run_scoring_suite(\n    output_dir: Optional[str] = None,\n    publish_events: bool = True,\n    verbose: bool = False,\n    is_subsequent_run: bool = False,\n) -> int:\n    \"\"\"\n    Execute the scoring drift detection suite.\n\n    Flow:\n        1. Initialize database and Redis connections\n        2. Load synthetic candidates from database\n        3. Load JD fixtures from synthetics/fixtures/jobs/\n        4. For each candidate × JD pair, score via RelevanceScorer\n        5. Compute fingerprints per candidate\n        6. Load baselines and diff against them\n        7. Write scoring-report.json to output directory\n        8. Publish drift events if severity != green\n\n    Args:\n        output_dir: Custom output directory (default: synthetics/runs/<ts>/)\n        publish_events: Whether to publish drift events to Redis\n        verbose: Enable verbose logging\n        is_subsequent_run: Whether this is a subsequent run for cache verification\n            Per NUTRIENTS.md §I.5, subsequent runs MUST have\n            cache_creation_input_tokens == 0 (hit cache)\n\n    Returns:\n        Exit code: 0 for success, 1 for hard failure\n    \"\"\"\n    from anthropic import AsyncAnthropic\n    import redis.asyncio as aioredis\n    from sqlalchemy.ext.asyncio import create_async_engine, async_sessionmaker, AsyncSession\n\n    from backend.config import settings\n    from backend.synthetics.scoring_runner import ScoringSyntheticRunner\n    from backend.synthetics.fingerprint import (\n        compute_fingerprint,\n        load_baseline,\n        FingerprintContract,\n    )\n    from backend.synthetics.diff import diff_against_baseline, has_drift\n\n    # Determine output directory\n    if output_dir is None:\n        ts = datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H-%M-%SZ\")\n        output_path = Path(__file__).parent.parent.parent / \"synthetics\" / \"runs\" / ts\n    else:\n        output_path = Path(output_dir)\n\n    output_path.mkdir(parents=True, exist_ok=True)\n\n    logger.info(\n        \"scoring_suite.starting\",\n        output_dir=str(output_path),\n        publish_events=publish_events,\n        is_subsequent_run=is_subsequent_run,\n    )\n\n    # Initialize connections\n    engine = create_async_engine(\n        settings.database_url,\n        echo=verbose,\n        pool_pre_ping=True,\n    )\n    async_session = async_sessionmaker(\n        engine,\n        class_=AsyncSession,\n        expire_on_commit=False,\n    )\n\n    redis_client = aioredis.from_url(\n        settings.redis_url,\n        encoding=\"utf-8\",\n        decode_responses=True,\n    )\n\n    anthropic_client = AsyncAnthropic(api_key=settings.anthropic_api_key)\n\n    # Determine fixtures and baselines directories\n    synthetics_dir = Path(__file__).parent.parent.parent / \"synthetics\"\n    fixtures_dir = synthetics_dir / \"fixtures\"\n    baselines_dir = fixtures_dir / \"baselines\"\n\n    try:\n        async with async_session() as session:\n            # Create runner and execute suite\n            # Pass is_subsequent_run for cache contract verification (NUTRIENTS.md §I.5)\n            runner = ScoringSyntheticRunner(\n                session=session,\n                redis_client=redis_client,\n                anthropic_client=anthropic_client,\n                fixtures_dir=fixtures_dir,\n                is_subsequent_run=is_subsequent_run,\n            )\n\n            suite_result = await runner.run_suite()\n\n        # Process results and compute fingerprints\n        candidates_results = []\n        overall_severity = \"green\"\n        contract = FingerprintContract()\n\n        for candidate_result in suite_result.get(\"candidates\", []):\n            candidate_id = candidate_result.get(\"candidate_id\")\n\n            # Compute fingerprint\n            fingerprint = compute_fingerprint(\n                candidate_result,\n                contract=contract,\n                baseline=None,  # We'll load baseline separately\n            )\n\n            # Load baseline if exists\n            baseline = load_baseline(str(baselines_dir), candidate_id)\n\n            # Diff against baseline\n            drift_report = None\n            if baseline is not None:\n                drift_report = diff_against_baseline(fingerprint, baseline, contract)\n\n                # Update overall severity\n                if drift_report.severity == \"red\":\n                    overall_severity = \"red\"\n                elif drift_report.severity == \"yellow\" and overall_severity == \"green\":\n                    overall_severity = \"yellow\"\n\n                # Publish drift event if needed\n                if publish_events and has_drift(drift_report):\n                    await _publish_drift_event(redis_client, drift_report)\n\n            candidates_results.append({\n                \"candidate_id\": candidate_id,\n                \"fingerprint\": fingerprint.model_dump(),\n                \"drift_report\": drift_report.model_dump() if drift_report else None,\n                \"cache_stats\": candidate_result.get(\"cache_stats\", {}),\n            })\n\n        # Build final report (includes cache_verification per NUTRIENTS.md §I.5)\n        cache_verification = suite_result.get(\"cache_verification\", {})\n        report = {\n            \"run_id\": suite_result.get(\"run_id\"),\n            \"suite\": \"scoring\",\n            \"started_at\": suite_result.get(\"started_at\"),\n            \"completed_at\": suite_result.get(\"completed_at\"),\n            \"candidates\": candidates_results,\n            \"overall_status\": overall_severity,\n            \"overall_cache_stats\": suite_result.get(\"overall_cache_stats\", {}),\n            # Cache verification section (NUTRIENTS.md §I.5)\n            \"cache_verification\": cache_verification,\n        }\n\n        # Write report to file\n        report_path = output_path / \"scoring-report.json\"\n        with open(report_path, \"w\") as f:\n            json.dump(report, f, indent=2, default=str)\n\n        # Log cache contract verification result (NUTRIENTS.md §I.5)\n        if cache_verification.get(\"cache_contract_violated\", False):\n            logger.warning(\n                \"scoring_suite.cache_contract_violated\",\n                is_subsequent_run=cache_verification.get(\"is_subsequent_run\"),\n                cache_miss_event_count=len(cache_verification.get(\"cache_miss_events\", [])),\n                message=\"Subsequent run had cache misses (cache_creation_input_tokens > 0)\",\n            )\n\n        logger.info(\n            \"scoring_suite.complete\",\n            report_path=str(report_path),\n            overall_severity=overall_severity,\n            candidates_processed=len(candidates_results),\n            cache_hit_rate=suite_result.get(\"overall_cache_stats\", {}).get(\"cache_hit_rate\", 0),\n            cache_contract_violated=cache_verification.get(\"cache_contract_violated\", False),\n        )\n\n        # Log cache stats\n        cache_stats = suite_result.get(\"overall_cache_stats\", {})\n        if cache_stats.get(\"cache_hit_rate\", 0) < 0.9:\n            logger.warning(\n                \"scoring_suite.low_cache_hit_rate\",\n                cache_hit_rate=cache_stats.get(\"cache_hit_rate\"),\n                target_rate=0.9,\n                cache_misses=cache_stats.get(\"cache_misses\"),\n            )\n\n        return 0\n\n    except Exception as e:\n        logger.error(\n            \"scoring_suite.failed\",\n            error=str(e),\n            exc_info=True,\n        )\n        return 1\n\n    finally:\n        # Cleanup connections\n        await redis_client.aclose()\n        await engine.dispose()\n\n\n# ─── Crawler Suite Runner ─────────────────────────────────────────────────────\n\n\nasync def run_crawler_suite(\n    output_dir: Optional[str] = None,\n    publish_events: bool = True,\n    verbose: bool = False,\n) -> int:\n    \"\"\"\n    Execute the crawler health monitoring suite.\n\n    Flow:\n        1. Initialize Redis connection (optional, for pub/sub)\n        2. Create CrawlerHealthRunner\n        3. Run health checks against Greenhouse, Lever, Ashby\n        4. Update state machine in synthetics/state.json\n        5. Publish alert/recovery events on 3-strike threshold\n        6. Write crawler-report.json to output directory\n\n    The state machine tracks consecutive_failures per source:\n        - consecutive_failures < 3: status = 'green' (no alert)\n        - consecutive_failures >= 3: status = 'red', publish alert\n        - Success after failures: reset to 0, publish recovery if was red\n\n    Contract: NUTRIENTS.md §I.6, HYPHA-SYNTHETICS-CRAWLER.md\n    Owner: synthetics-crawler-agent.state-machine\n\n    Args:\n        output_dir: Custom output directory (default: synthetics/runs/<ts>/)\n        publish_events: Whether to publish alert/recovery events to Redis\n        verbose: Enable verbose logging\n\n    Returns:\n        Exit code: 0 for success, 1 for hard failure\n    \"\"\"\n    import redis.asyncio as aioredis\n\n    from backend.config import settings\n    from backend.synthetics.crawler_health import CrawlerHealthRunner\n\n    logger.info(\n        \"crawler_suite.starting\",\n        publish_events=publish_events,\n        verbose=verbose,\n    )\n\n    # Initialize Redis for pub/sub (optional)\n    redis_client = None\n    if publish_events:\n        try:\n            redis_client = aioredis.from_url(\n                settings.redis_url,\n                encoding=\"utf-8\",\n                decode_responses=True,\n            )\n            logger.debug(\"crawler_suite.redis_connected\")\n        except Exception as e:\n            logger.warning(\n                \"crawler_suite.redis_unavailable\",\n                error=str(e),\n                message=\"Continuing without pub/sub\",\n            )\n            redis_client = None\n\n    try:\n        # Create and run the health check suite\n        runner = CrawlerHealthRunner(redis_client=redis_client)\n        result = await runner.run_suite()\n\n        # Log summary\n        sources_checked = len(result.get(\"sources\", []))\n        alerts_fired = sum(\n            1 for t in result.get(\"state_transitions\", [])\n            if t.get(\"alert_fired\", False)\n        )\n        all_green = all(\n            s.get(\"status\") == \"success\"\n            for s in result.get(\"sources\", [])\n        )\n\n        logger.info(\n            \"crawler_suite.complete\",\n            run_id=result.get(\"run_id\"),\n            report_path=result.get(\"report_path\"),\n            sources_checked=sources_checked,\n            alerts_fired=alerts_fired,\n            all_green=all_green,\n        )\n\n        return 0\n\n    except Exception as e:\n        logger.error(\n            \"crawler_suite.failed\",\n            error=str(e),\n            exc_info=True,\n        )\n        return 1\n\n    finally:\n        # Cleanup Redis connection\n        if redis_client is not None:\n            try:\n                await redis_client.aclose()\n            except Exception:\n                pass\n\n\nasync def _publish_drift_event(\n    redis_client,\n    drift_report,\n) -> None:\n    \"\"\"\n    Publish a drift event to Redis pub/sub.\n\n    Channel: agent.status.synthetics.drift\n    Contract: NUTRIENTS.md §I.7\n    \"\"\"\n    from backend.observability.events import publish_event\n\n    event = {\n        \"event\": \"SYNTHETICS_DRIFT\",\n        \"candidate_id\": drift_report.candidate_id,\n        \"run_id\": drift_report.run_id,\n        \"severity\": drift_report.severity,\n        \"violation_count\": len(drift_report.exact_violations) + len(drift_report.tolerance_violations),\n        \"ts\": datetime.now(timezone.utc).isoformat(),\n    }\n\n    try:\n        await publish_event(\n            redis_client,\n            \"agent.status.synthetics.drift\",\n            event,\n        )\n        logger.info(\n            \"drift_event.published\",\n            candidate_id=drift_report.candidate_id,\n            severity=drift_report.severity,\n        )\n    except Exception as e:\n        logger.error(\n            \"drift_event.publish_failed\",\n            error=str(e),\n            candidate_id=drift_report.candidate_id,\n        )\n\n\n# ─── Main Entry Point ─────────────────────────────────────────────────────────\n\n\ndef main() -> int:\n    \"\"\"\n    Main entry point for the synthetics CLI.\n\n    Parses arguments and dispatches to the appropriate suite runner.\n\n    Returns:\n        Exit code: 0 for success, 1 for failure\n    \"\"\"\n    parser = create_parser()\n    args = parser.parse_args()\n\n    if args.command is None:\n        parser.print_help()\n        return 1\n\n    if args.command == \"run\":\n        if args.suite == \"scoring\":\n            return asyncio.run(\n                run_scoring_suite(\n                    output_dir=args.output_dir,\n                    publish_events=not args.no_publish,\n                    verbose=args.verbose,\n                    is_subsequent_run=getattr(args, \"subsequent_run\", False),\n                )\n            )\n        elif args.suite == \"crawler\":\n            return asyncio.run(\n                run_crawler_suite(\n                    output_dir=args.output_dir,\n                    publish_events=not args.no_publish,\n                    verbose=args.verbose,\n                )\n            )\n        else:\n            logger.error(\"cli.unknown_suite\", suite=args.suite)\n            return 1\n\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","numLines":510,"startLine":1,"totalLines":510}}}}
