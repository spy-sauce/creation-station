15→  - path: hyphae/HYPHA-SCHEDULER.md\n   116→    frozen: true\n   117→    frozenAt: 2026-05-28T03:38:05.575Z\n   118→  - path: hyphae/HYPHA-API-STREAMING.md\n   119→    frozen: true\n   120→    frozenAt: 2026-05-28T03:38:05.575Z\n   121→  - path: hyphae/HYPHA-API-CLIENT.md\n   122→    frozen: true\n   123→    frozenAt: 2026-05-28T03:38:05.575Z\n   124→  - path: hyphae/HYPHA-TESTS.md\n   125→    frozen: true\n   126→    frozenAt: 2026-05-28T03:38:05.575Z\n   127→  - path: hyphae/HYPHA-SYNTHETICS-FIXTURES.md\n   128→    frozen: true\n   129→    frozenAt: 2026-05-28T03:38:05.575Z\n   130→  - path: hyphae/HYPHA-SYNTHETICS-SCORING.md\n   131→    frozen: true\n   132→    frozenAt: 2026-05-28T03:38:05.575Z\n   133→  - path: hyphae/HYPHA-SYNTHETICS-CRAWLER.md\n   134→    frozen: true\n   135→    frozenAt: 2026-05-28T03:38:05.575Z\n   136→synthetics:\n   137→  budget:\n   138→    monthlyUsd: 20\n   139→    abort_threshold_pct: 150\n   140→  cache:\n   141→    aggressive: true\n   142→    prompt_cache_required: true\n   143→  target: local\n   144→agents:\n   145→  - id: data-agent\n   146→    scope: PostgreSQL migrations, SQLAlchemy ORM models, Pydantic schemas, database\n   147→      connection\n   148→    branch: feat/data-agent\n   149→    blocked_by: []\n   150→    blocks:\n   151→      - api-agent\n   152→      - auth-agent\n   153→      - obs-agent\n   154→      - discover-agent\n   155→      - apply-agent\n   156→      - scheduler-agent\n   157→    capabilities:\n   158→      - postgresql\n   159→      - sqlalchemy\n   160→      - alembic\n   161→      - pydantic\n   162→    sub_agents:\n   163→      - id: data-agent.migrations.init\n   164→        scope: backend/migrations/001_init.sql — extensions, candidates table baseline\n   165→      - id: data-agent.migrations.discovery\n   166→        scope: backend/migrations/002_discovery.sql — discovered_jobs, scored_jobs,\n   167→          daily_digests, crawl_runs per HYPHA-SCHEMA-CORE\n   168→      - id: data-agent.mig