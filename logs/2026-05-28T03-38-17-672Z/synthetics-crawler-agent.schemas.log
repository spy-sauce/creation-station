mentType\": { \"type\": \"string\" },\n              \"publishedDate\": { \"type\": \"string\" },\n              \"applicationUrl\": { \"type\": \"string\", \"format\": \"uri\" }\n            },\n            \"additionalProperties\": true\n          }\n        }\n      },\n      \"additionalProperties\": true\n    }\n  },\n  \"health_check_targets\": {\n    \"greenhouse\": {\n      \"slug\": \"anthropic\",\n      \"endpoint\": \"https://boards.greenhouse.io/anthropic.json\",\n      \"method\": \"GET\"\n    },\n    \"lever\": {\n      \"slug\": \"netflix\",\n      \"endpoint\": \"https://api.lever.co/v0/postings/netflix?limit=1\",\n      \"method\": \"GET\"\n    },\n    \"ashby\": {\n      \"slug\": \"posthog\",\n      \"endpoint\": \"https://api.ashbyhq.com/posting-api/job-board/posthog\",\n      \"method\": \"GET\"\n    }\n  },\n  \"validation_rules\": {\n    \"greenhouse\": {\n      \"schema_ref\": \"#/definitions/greenhouse\",\n      \"minimum_jobs\": 1\n    },\n    \"lever\": {\n      \"schema_ref\": \"#/definitions/lever\",\n      \"minimum_jobs\": 1\n    },\n    \"ashby\": {\n      \"schema_ref\": \"#/definitions/ashby\",\n      \"minimum_jobs\": 1\n    }\n  },\n  \"version\": \"1.0.0\",\n  \"last_updated\": \"2026-05-28T00:00:00Z\"\n}\n","numLines":117,"startLine":1,"totalLines":117}}}}
