{"t":"2026-05-28T03:47:40.813Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QaErR1fqeQkjpxKeBJ7pdg","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→CLI entry point for the synthetics scoring suite.\n     6→\n     7→Provides the command-line interface for running synthetic drift detection:\n     8→\n     9→    python -m backend.synthetics run --suite=scoring\n    10→\n    11→The CLI:\n    12→    1. Loads synthetic candidates from the database\n    13→    2. Loads JD fixtures from synthetics/fixtures/jobs/\n    14→    3. Runs the scoring suite against each candidate × JD pair\n    15→    4. Computes fingerprints and compares against baselines\n    16→    5. Writes a report to synthetics/runs/<ts>/scoring-report.json\n    17→    6. Publishes drift events if severity != green\n    18→\n    19→Contract: NUTRIENTS.md §I.2-I.7, HYPHA-SYNTHETICS-SCORING.md\n    20→Owner: synthetics-scoring-agent.cli\n    21→\"\"\"\n    22→\n    23→from __future__ import annotations\n    24→\n    25→import argparse\n    26→import asyncio\n    27→import json\n    28→import sys\n    29→from datetime import datetime, timezone\n    30→from pathlib import Path\n    31→from typing import Optional\n    32→\n    33→import structlog\n    34→\n    35→# Configure structlog before any logging happens\n    36→from backend.observability.logging import configure_logging\n    37→\n    38→configure_logging()\n    39→\n    40→logger = structlog.get_logger(__name__)\n    41→\n    42→\n    43→# ─── CLI Argument Parser ──────────────────────────────────────────────────────\n    44→\n    45→\n    46→def create_parser() -> argparse.ArgumentParser:\n    47→    \"\"\"\n    48→    Create the argument parser for the synthetics CLI.\n    49→\n    50→    Returns:\n    51→        Configured ArgumentParser\n    52→    \"\"\"\n    53→    parser = argparse.ArgumentParser(\n    54→        prog=\"python -m backend.synthetics\",\n    55→        description=\"Synthetics monitoring suite for Talent Agent\",\n    56→    )\n    57→\n    58→    subparsers = parser.add_subparsers(dest=\"command\", help=\"Available commands\")\n    59→\n    60→    # Run command\n    61→    run_parser = subparsers.add_parser(\n    62→        \"run\",\n    63→        help=\"Execute a synthetics test suite\",\n    64→    )\n    65→    run_parser.add_argument(\n    66→        \"--suite\",\n    67→        type=str,\n    68→        required=True,\n    69→        choices=[\"scoring\", \"crawler\"],\n    70→        help=\"Suite to run: 'scoring' for drift detection, 'crawler' for health checks\",\n    71→    )\n    72→    run_parser.add_argument(\n    73→        \"--output-dir\",\n    74→        type=str,\n    75→        default=None,\n    76→        help=\"Output directory for reports (default: synthetics/runs/<ts>/)\",\n    77→    )\n    78→    run_parser.add_argument(\n    79→        \"--no-publish\",\n    80→        action=\"store_true\",\n    81→        help=\"Skip publishing drift events to Redis\",\n    82→    )\n    83→    run_parser.add_argument(\n    84→        \"--verbose\",\n    85→        \"-v\",\n    86→        action=\"store_true\",\n    87→        help=\"Enable verbose output\",\n    88→    )\n    89→\n    90→    return parser\n    91→\n    92→\n    93→# ─── Scoring Suite Runner ─────────────────────────────────────────────────────\n    94→\n    95→\n    96→async def run_scoring_suite(\n    97→    output_dir: Optional[str] = None,\n    98→    publish_events: bool = True,\n    99→    verbose: bool = False,\n   100→) -> int:\n   101→    \"\"\"\n   102→    Execute the scoring drift detection suite.\n   103→\n   104→    Flow:\n   105→        1. Initialize database and Redis connections\n   106→        2. Load synthetic candidates from database\n   107→        3. Load JD fixtures from synthetics/fixtures/jobs/\n   108→        4. For each candidate × JD pair, score via RelevanceScorer\n   109→        5. Compute fingerprints per candidate\n   110→        6. Load baselines and diff against them\n   111→        7. Write scoring-report.json to output directory\n   112→        8. Publish drift events if severity != green\n   113→\n   114→    Args:\n   115→        output_dir: Custom output directory (default: synthetics/runs/<ts>/)\n   116→        publish_events: Whether to publish drift events to Redis\n   117→        verbose: Enable verbose logging\n   118→\n   119→    Returns:\n   120→        Exit code: 0 for success, 1 for hard failure\n   121→    \"\"\"\n   122→    from anthropic import AsyncAnthropic\n   123→    import redis.asyncio as aioredis\n   124→    from sqlalchemy.ext.asyncio import create_async_engine, async_sessionmaker, AsyncSession\n   125→\n   126→    from backend.config import settings\n   127→    from backend.synthetics.scoring_runner import ScoringSyntheticRunner\n   128→    from backend.synthetics.fingerprint import (\n   129→        compute_fingerprint,\n   130→        load_baseline,\n   131→        FingerprintContract,\n   132→    )\n   133→    from backend.synthetics.diff import diff_against_baseline, has_drift\n   134→\n   135→    # Determine output directory\n   136→    if output_dir is None:\n   137→        ts = datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H-%M-%SZ\")\n   138→        output_path = Path(__file__).parent.parent.parent / \"synthetics\" / \"runs\" / ts\n   139→    else:\n   140→        output_path = Path(output_dir)\n   141→\n   142→    output_path.mkdir(parents=True, exist_ok=True)\n   143→\n   144→    logger.info(\n   145→        \"scoring_suite.starting\",\n   146→        output_dir=str(output_path),\n   147→        publish_events=publish_events,\n   148→    )\n   149→\n   150→    # Initialize connections\n   151→    engine = create_async_engine(\n   152→        settings.database_url,\n   153→        echo=verbose,\n   154→        pool_pre_ping=True,\n   155→    )\n   156→    async_session = async_sessionmaker(\n   157→        engine,\n   158→        class_=AsyncSession,\n   159→        expire_on_commit=False,\n   160→    )\n   161→\n   162→    redis_client = aioredis.from_url(\n   163→        settings.redis_url,\n   164→        encoding=\"utf-8\",\n   165→        decode_responses=True,\n   166→    )\n   167→\n   168→    anthropic_client = AsyncAnthropic(api_key=settings.anthropic_api_key)\n   169→\n   170→    # Determine fixtures and baselines directories\n   171→    synthetics_dir = Path(__file__).parent.parent.parent / \"synthetics\"\n   172→    fixtures_dir = synthetics_dir / \"fixtures\"\n   173→    baselines_dir = fixtures_dir / \"baselines\"\n   174→\n   175→    try:\n   176→        async with async_session() as session:\n   177→            # Create runner and execute suite\n   178→            runner = ScoringSyntheticRunner(\n   179→                session=session,\n   180→                redis_client=redis_client,\n   181→                anthropic_client=anthropic_client,\n   182→                fixtures_dir=fixtures_dir,\n   183→            )\n   184→\n   185→            suite_result = await runner.run_suite()\n   186→\n   187→        # Process results and compute fingerprints\n   188→        candidates_results = []\n   189→        overall_severity = \"green\"\n   190→        contract = FingerprintContract()\n   191→\n   192→        for candidate_result in suite_result.get(\"candidates\", []):\n   193→            candidate_id = candidate_result.get(\"candidate_id\")\n   194→\n   195→            # Compute fingerprint\n   196→            fingerprint = compute_fingerprint(\n   197→                candidate_result,\n   198→                contract=contract,\n   199→                baseline=None,  # We'll load baseline separately\n   200→            )\n   201→\n   202→            # Load baseline if exists\n   203→            baseline = load_baseline(str(baselines_dir), candidate_id)\n   204→\n   205→            # Diff against baseline\n   206→            drift_report = None\n   207→            if baseline is not None:\n   208→                drift_report = diff_against_baseline(fingerprint, baseline, contract)\n   209→\n   210→                # Update overall severity\n   211→                if drift_report.severity == \"red\":\n   212→                    overall_severity = \"red\"\n   213→                elif drift_report.severity == \"yellow\" and overall_severity == \"green\":\n   214→                    overall_severity = \"yellow\"\n   215→\n   216→                # Publish drift event if needed\n   217→                if publish_events and has_drift(drift_report):\n   218→                    await _publish_drift_event(redis_client, drift_report)\n   219→\n   220→            candidates_results.append({\n   221→                \"candidate_id\": candidate_id,\n   222→                \"fingerprint\": fingerprint.model_dump(),\n   223→                \"drift_report\": drift_report.model_dump() if drift_report else None,\n   224→                \"cache_stats\": candidate_result.get(\"cache_stats\", {}),\n   225→            })\n   226→\n   227→        # Build final report\n   228→        report = {\n   229→            \"run_id\": suite_result.get(\"run_id\"),\n   230→            \"suite\": \"scoring\",\n   231→            \"started_at\": suite_result.get(\"started_at\"),\n   232→            \"completed_at\": suite_result.get(\"completed_at\"),\n   233→            \"candidates\": candidates_results,\n   234→            \"overall_status\": overall_severity,\n   235→            \"overall_cache_stats\": suite_result.get(\"overall_cache_stats\", {}),\n   236→        }\n   237→\n   238→        # Write report to file\n   239→        report_path = output_path / \"scoring-report.json\"\n   240→        with open(report_path, \"w\") as f:\n   241→            json.dump(report, f, indent=2, default=str)\n   242→\n   243→        logger.info(\n   244→            \"scoring_suite.complete\",\n   245→            report_path=str(report_path),\n   246→            overall_severity=overall_severity,\n   247→            candidates_processed=len(candidates_results),\n   248→            cache_hit_rate=suite_result.get(\"overall_cache_stats\", {}).get(\"cache_hit_rate\", 0),\n   249→        )\n   250→\n   251→        # Log cache stats\n   252→        cache_stats = suite_result.get(\"overall_cache_stats\", {})\n   253→        if cache_stats.get(\"cache_hit_rate\", 0) < 0.9:\n   254→            logger.warning(\n   255→                \"scoring_suite.low_cache_hit_rate\",\n   256→                cache_hit_rate=cache_stats.get(\"cache_hit_rate\"),\n   257→                target_rate=0.9,\n   258→                cache_misses=cache_stats.get(\"cache_misses\"),\n   259→            )\n   260→\n   261→        return 0\n   262→\n   263→    except Exception as e:\n   264→        logger.error(\n   265→            \"scoring_suite.failed\",\n   266→            error=str(e),\n   267→            exc_info=True,\n   268→        )\n   269→        return 1\n   270→\n   271→    finally:\n   272→        # Cleanup connections\n   273→        await redis_client.aclose()\n   274→        await engine.dispose()\n   275→\n   276→\n   277→async def _publish_drift_event(\n   278→    redis_client,\n   279→    drift_report,\n   280→) -> None:\n   281→    \"\"\"\n   282→    Publish a drift event to Redis pub/sub.\n   283→\n   284→    Channel: agent.status.synthetics.drift\n   285→    Contract: NUTRIENTS.md §I.7\n   286→    \"\"\"\n   287→    from backend.observability.events import publish_event\n   288→\n   289→    event = {\n   290→        \"event\": \"SYNTHETICS_DRIFT\",\n   291→        \"candidate_id\": drift_report.candidate_id,\n   292→        \"run_id\": drift_report.run_id,\n   293→        \"severity\": drift_report.severity,\n   294→        \"violation_count\": len(drift_report.exact_violations) + len(drift_report.tolerance_violations),\n   295→        \"ts\": datetime.now(timezone.utc).isoformat(),\n   296→    }\n   297→\n   298→    try:\n   299→        await publish_event(\n   300→            redis_client,\n   301→            \"agent.status.synthetics.drift\",\n   302→            event,\n   303→        )\n   304→        logger.info(\n   305→            \"drift_event.published\",\n   306→            candidate_id=drift_report.candidate_id,\n   307→            severity=drift_report.severity,\n   308→        )\n   309→    except Exception as e:\n   310→        logger.error(\n   311→            \"drift_event.publish_failed\",\n   312→            error=str(e),\n   313→            candidate_id=drift_report.candidate_id,\n   314→        )\n   315→\n   316→\n   317→# ─── Main Entry Point ─────────────────────────────────────────────────────────\n   318→\n   319→\n   320→def main() -> int:\n   321→    \"\"\"\n   322→    Main entry point for the synthetics CLI.\n   323→\n   324→    Parses arguments and dispatches to the appropriate suite runner.\n   325→\n   326→    Returns:\n   327→        Exit code: 0 for success, 1 for failure\n   328→    \"\"\"\n   329→    parser = create_parser()\n   330→    args = parser.parse_args()\n   331→\n   332→    if args.command is None:\n   333→        parser.print_help()\n   334→        return 1\n   335→\n   336→    if args.command == \"run\":\n   337→        if args.suite == \"scoring\":\n   338→            return asyncio.run(\n   339→                run_scoring_suite(\n   340→                    output_dir=args.output_dir,\n   341→                    publish_events=not args.no_publish,\n   342→                    verbose=args.verbose,\n   343→                )\n   344→            )\n   345→        elif args.suite == \"crawler\":\n   346→            # Crawler suite is owned by synthetics-crawler-agent\n   347→            logger.error(\n   348→                \"cli.suite_not_implemented\",\n   349→                suite=args.suite,\n   350→                message=\"Crawler suite is owned by synthetics-crawler-agent\",\n   351→            )\n   352→            return 1\n   353→        else:\n   354→            logger.error(\"cli.unknown_suite\", suite=args.suite)\n   355→            return 1\n   356→\n   357→    return 0\n   358→\n   359→\n   360→if __name__ == \"__main__\":\n   361→    sys.exit(main())\n   362→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"21ef98e9-2e6b-480f-9c6e-e573095c51e5","uuid":"1bf4d5a1-a3d7-4d10-b1d1-7a83b08315c3","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/synthetics/cli.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nCLI entry point for the synthetics scoring suite.\n\nProvides the command-line interface for running synthetic drift detection:\n\n    python -m backend.synthetics run --suite=scoring\n\nThe CLI:\n    1. Loads synthetic candidates from the database\n    2. Loads JD fixtures from synthetics/fixtures/jobs/\n    3. Runs the scoring suite against each candidate × JD pair\n    4. Computes fingerprints and compares against baselines\n    5. Writes a report to synthetics/runs/<ts>/scoring-report.json\n    6. Publishes drift events if severity != green\n\nContract: NUTRIENTS.md §I.2-I.7, HYPHA-SYNTHETICS-SCORING.md\nOwner: synthetics-scoring-agent.cli\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport asyncio\nimport json\nimport sys\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Optional\n\nimport structlog\n\n# Configure structlog before any logging happens\nfrom backend.observability.logging import configure_logging\n\nconfigure_logging()\n\nlogger = structlog.get_logger(__name__)\n\n\n# ─── CLI Argument Parser ──────────────────────────────────────────────────────\n\n\ndef create_parser() -> argparse.ArgumentParser:\n    \"\"\"\n    Create the argument parser for the synthetics CLI.\n\n    Returns:\n        Configured ArgumentParser\n    \"\"\"\n    parser = argparse.ArgumentParser(\n        prog=\"python -m backend.synthetics\",\n        description=\"Synthetics monitoring suite for Talent Agent\",\n    )\n\n    subparsers = parser.add_subparsers(dest=\"command\", help=\"Available commands\")\n\n    # Run command\n    run_parser = subparsers.add_parser(\n        \"run\",\n        help=\"Execute a synthetics test suite\",\n    )\n    run_parser.add_argument(\n        \"--suite\",\n        type=str,\n        required=True,\n        choices=[\"scoring\", \"crawler\"],\n        help=\"Suite to run: 'scoring' for drift detection, 'crawler' for health checks\",\n    )\n    run_parser.add_argument(\n        \"--output-dir\",\n        type=str,\n        default=None,\n        help=\"Output directory for reports (default: synthetics/runs/<ts>/)\",\n    )\n    run_parser.add_argument(\n        \"--no-publish\",\n        action=\"store_true\",\n        help=\"Skip publishing drift events to Redis\",\n    )\n    run_parser.add_argument(\n        \"--verbose\",\n        \"-v\",\n        action=\"store_true\",\n        help=\"Enable verbose output\",\n    )\n\n    return parser\n\n\n# ─── Scoring Suite Runner ─────────────────────────────────────────────────────\n\n\nasync def run_scoring_suite(\n    output_dir: Optional[str] = None,\n    publish_events: bool = True,\n    verbose: bool = False,\n) -> int:\n    \"\"\"\n    Execute the scoring drift detection suite.\n\n    Flow:\n        1. Initialize database and Redis connections\n        2. Load synthetic candidates from database\n        3. Load JD fixtures from synthetics/fixtures/jobs/\n        4. For each candidate × JD pair, score via RelevanceScorer\n        5. Compute fingerprints per candidate\n        6. Load baselines and diff against them\n        7. Write scoring-report.json to output directory\n        8. Publish drift events if severity != green\n\n    Args:\n        output_dir: Custom output directory (default: synthetics/runs/<ts>/)\n        publish_events: Whether to publish drift events to Redis\n        verbose: Enable verbose logging\n\n    Returns:\n        Exit code: 0 for success, 1 for hard failure\n    \"\"\"\n    from anthropic import AsyncAnthropic\n    import redis.asyncio as aioredis\n    from sqlalchemy.ext.asyncio import create_async_engine, async_sessionmaker, AsyncSession\n\n    from backend.config import settings\n    from backend.synthetics.scoring_runner import ScoringSyntheticRunner\n    from backend.synthetics.fingerprint import (\n        compute_fingerprint,\n        load_baseline,\n        FingerprintContract,\n    )\n    from backend.synthetics.diff import diff_against_baseline, has_drift\n\n    # Determine output directory\n    if output_dir is None:\n        ts = datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H-%M-%SZ\")\n        output_path = Path(__file__).parent.parent.parent / \"synthetics\" / \"runs\" / ts\n    else:\n        output_path = Path(output_dir)\n\n    output_path.mkdir(parents=True, exist_ok=True)\n\n    logger.info(\n        \"scoring_suite.starting\",\n        output_dir=str(output_path),\n        publish_events=publish_events,\n    )\n\n    # Initialize connections\n    engine = create_async_engine(\n        settings.database_url,\n        echo=verbose,\n        pool_pre_ping=True,\n    )\n    async_session = async_sessionmaker(\n        engine,\n        class_=AsyncSession,\n        expire_on_commit=False,\n    )\n\n    redis_client = aioredis.from_url(\n        settings.redis_url,\n        encoding=\"utf-8\",\n        decode_responses=True,\n    )\n\n    anthropic_client = AsyncAnthropic(api_key=settings.anthropic_api_key)\n\n    # Determine fixtures and baselines directories\n    synthetics_dir = Path(__file__).parent.parent.parent / \"synthetics\"\n    fixtures_dir = synthetics_dir / \"fixtures\"\n    baselines_dir = fixtures_dir / \"baselines\"\n\n    try:\n        async with async_session() as session:\n            # Create runner and execute suite\n            runner = ScoringSyntheticRunner(\n                session=session,\n                redis_client=redis_client,\n                anthropic_client=anthropic_client,\n                fixtures_dir=fixtures_dir,\n            )\n\n            suite_result = await runner.run_suite()\n\n        # Process results and compute fingerprints\n        candidates_results = []\n        overall_severity = \"green\"\n        contract = FingerprintContract()\n\n        for candidate_result in suite_result.get(\"candidates\", []):\n            candidate_id = candidate_result.get(\"candidate_id\")\n\n            # Compute fingerprint\n            fingerprint = compute_fingerprint(\n                candidate_result,\n                contract=contract,\n                baseline=None,  # We'll load baseline separately\n            )\n\n            # Load baseline if exists\n            baseline = load_baseline(str(baselines_dir), candidate_id)\n\n            # Diff against baseline\n            drift_report = None\n            if baseline is not None:\n                drift_report = diff_against_baseline(fingerprint, baseline, contract)\n\n                # Update overall severity\n                if drift_report.severity == \"red\":\n                    overall_severity = \"red\"\n                elif drift_report.severity == \"yellow\" and overall_severity == \"green\":\n                    overall_severity = \"yellow\"\n\n                # Publish drift event if needed\n                if publish_events and has_drift(drift_report):\n                    await _publish_drift_event(redis_client, drift_report)\n\n            candidates_results.append({\n                \"candidate_id\": candidate_id,\n                \"fingerprint\": fingerprint.model_dump(),\n                \"drift_report\": drift_report.model_dump() if drift_report else None,\n                \"cache_stats\": candidate_result.get(\"cache_stats\", {}),\n            })\n\n        # Build final report\n        report = {\n            \"run_id\": suite_result.get(\"run_id\"),\n            \"suite\": \"scoring\",\n            \"started_at\": suite_result.get(\"started_at\"),\n            \"completed_at\": suite_result.get(\"completed_at\"),\n            \"candidates\": candidates_results,\n            \"overall_status\": overall_severity,\n            \"overall_cache_stats\": suite_result.get(\"overall_cache_stats\", {}),\n        }\n\n        # Write report to file\n        report_path = output_path / \"scoring-report.json\"\n        with open(report_path, \"w\") as f:\n            json.dump(report, f, indent=2, default=str)\n\n        logger.info(\n            \"scoring_suite.complete\",\n            report_path=str(report_path),\n            overall_severity=overall_severity,\n            candidates_processed=len(candidates_results),\n            cache_hit_rate=suite_result.get(\"overall_cache_stats\", {}).get(\"cache_hit_rate\", 0),\n        )\n\n        # Log cache stats\n        cache_stats = suite_result.get(\"overall_cache_stats\", {})\n        if cache_stats.get(\"cache_hit_rate\", 0) < 0.9:\n            logger.warning(\n                \"scoring_suite.low_cache_hit_rate\",\n                cache_hit_rate=cache_stats.get(\"cache_hit_rate\"),\n                target_rate=0.9,\n                cache_misses=cache_stats.get(\"cache_misses\"),\n            )\n\n        return 0\n\n    except Exception as e:\n        logger.error(\n            \"scoring_suite.failed\",\n            error=str(e),\n            exc_info=True,\n        )\n        return 1\n\n    finally:\n        # Cleanup connections\n        await redis_client.aclose()\n        await engine.dispose()\n\n\nasync def _publish_drift_event(\n    redis_client,\n    drift_report,\n) -> None:\n    \"\"\"\n    Publish a drift event to Redis pub/sub.\n\n    Channel: agent.status.synthetics.drift\n    Contract: NUTRIENTS.md §I.7\n    \"\"\"\n    from backend.observability.events import publish_event\n\n    event = {\n        \"event\": \"SYNTHETICS_DRIFT\",\n        \"candidate_id\": drift_report.candidate_id,\n        \"run_id\": drift_report.run_id,\n        \"severity\": drift_report.severity,\n        \"violation_count\": len(drift_report.exact_violations) + len(drift_report.tolerance_violations),\n        \"ts\": datetime.now(timezone.utc).isoformat(),\n    }\n\n    try:\n        await publish_event(\n            redis_client,\n            \"agent.status.synthetics.drift\",\n            event,\n        )\n        logger.info(\n            \"drift_event.published\",\n            candidate_id=drift_report.candidate_id,\n            severity=drift_report.severity,\n        )\n    except Exception as e:\n        logger.error(\n            \"drift_event.publish_failed\",\n            error=str(e),\n            candidate_id=drift_report.candidate_id,\n        )\n\n\n# ─── Main Entry Point ─────────────────────────────────────────────────────────\n\n\ndef main() -> int:\n    \"\"\"\n    Main entry point for the synthetics CLI.\n\n    Parses arguments and dispatches to the appropriate suite runner.\n\n    Returns:\n        Exit code: 0 for success, 1 for failure\n    \"\"\"\n    parser = create_parser()\n    args = parser.parse_args()\n\n    if args.command is None:\n        parser.print_help()\n        return 1\n\n    if args.command == \"run\":\n        if args.suite == \"scoring\":\n            return asyncio.run(\n                run_scoring_suite(\n                    output_dir=args.output_dir,\n                    publish_events=not args.no_publish,\n                    verbose=args.verbose,\n                )\n            )\n        elif args.suite == \"crawler\":\n            # Crawler suite is owned by synthetics-crawler-agent\n            logger.error(\n                \"cli.suite_not_implemented\",\n                suite=args.suite,\n                message=\"Crawler suite is owned by synthetics-crawler-agent\",\n            )\n            return 1\n        else:\n            logger.error(\"cli.unknown_suite\", suite=args.suite)\n            return 1\n\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","numLines":362,"startLine":1,"totalLines":362}}}}
