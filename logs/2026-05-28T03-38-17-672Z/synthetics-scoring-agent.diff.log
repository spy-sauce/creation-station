{"t":"2026-05-28T03:46:18.145Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MuFycMADJTu5fM5bvLdTRB","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Diff module — compares fingerprints against baselines to detect drift.\n     6→\n     7→Implements the drift detection logic per NUTRIENTS.md §I.2-I.4:\n     8→    - Exact-match violations: any difference in top_picks ordering/IDs\n     9→    - Tolerance violations: score dimensions exceeding ±N% threshold\n    10→    - Severity rules: green (clean), yellow (tolerance only), red (exact or 2× tolerance)\n    11→\n    12→Contract: NUTRIENTS.md §I.2-I.4, HYPHA-SYNTHETICS-SCORING.md\n    13→Owner: synthetics-scoring-agent.diff\n    14→\"\"\"\n    15→\n    16→from __future__ import annotations\n    17→\n    18→from datetime import datetime, timezone\n    19→from typing import Any, Optional, Literal\n    20→\n    21→import structlog\n    22→from pydantic import BaseModel, Field\n    23→\n    24→from backend.synthetics.fingerprint import (\n    25→    FingerprintContract,\n    26→    ScoringFingerprint,\n    27→    TopPickFingerprint,\n    28→    TOLERANCE_THRESHOLDS,\n    29→)\n    30→\n    31→logger = structlog.get_logger(__name__)\n    32→\n    33→\n    34→# ─── Drift Severity (from NUTRIENTS.md §I.4) ─────────────────────────────────\n    35→\n    36→\n    37→DriftSeverity = Literal[\"green\", \"yellow\", \"red\"]\n    38→\n    39→\n    40→# ─── Drift Violation ─────────────────────────────────────────────────────────\n    41→\n    42→\n    43→class DriftViolation(BaseModel):\n    44→    \"\"\"\n    45→    A single drift violation detected during comparison.\n    46→\n    47→    Captures the field that drifted, baseline and current values,\n    48→    and delta percentage for tolerance fields.\n    49→\n    50→    Contract: NUTRIENTS.md §I.4 (DriftViolation)\n    51→    \"\"\"\n    52→\n    53→    field: str = Field(description=\"Path to the drifted field\")\n    54→    baseline_value: Any = Field(description=\"Value in the baseline fingerprint\")\n    55→    current_value: Any = Field(description=\"Value in the current fingerprint\")\n    56→    delta_pct: Optional[float] = Field(\n    57→        default=None,\n    58→        description=\"Drift percentage for tolerance fields (null for exact fields)\",\n    59→    )\n    60→\n    61→\n    62→# ─── Drift Report ────────────────────────────────────────────────────────────\n    63→\n    64→\n    65→class DriftReport(BaseModel):\n    66→    \"\"\"\n    67→    Complete drift report comparing a fingerprint against baseline.\n    68→\n    69→    Contains all exact-match and tolerance violations, plus computed\n    70→    severity level.\n    71→\n    72→    Severity rules (NUTRIENTS.md §I.4):\n    73→        - green: zero violations\n    74→        - yellow: tolerance violations only, no exact-match violations\n    75→        - red: any exact-match violation OR tolerance violation > 2× threshold\n    76→\n    77→    Contract: NUTRIENTS.md §I.4 (DriftReport)\n    78→    \"\"\"\n    79→\n    80→    candidate_id: str = Field(description=\"Synthetic candidate UUID\")\n    81→    run_id: str = Field(description=\"UUID of the current run\")\n    82→    baseline_run_id: str = Field(description=\"UUID of the baseline run\")\n    83→    exact_violations: list[DriftViolation] = Field(\n    84→        default_factory=list,\n    85→        description=\"Exact-match field violations (any difference = violation)\",\n    86→    )\n    87→    tolerance_violations: list[DriftViolation] = Field(\n    88→        default_factory=list,\n    89→        description=\"Tolerance-match field violations (exceeded threshold)\",\n    90→    )\n    91→    severity: DriftSeverity = Field(description=\"Overall severity level\")\n    92→    computed_at: str = Field(description=\"ISO-8601 timestamp of comparison\")\n    93→\n    94→\n    95→# ─── Diff Functions ──────────────────────────────────────────────────────────\n    96→\n    97→\n    98→def diff_against_baseline(\n    99→    fingerprint: ScoringFingerprint,\n   100→    baseline: ScoringFingerprint,\n   101→    contract: Optional[FingerprintContract] = None,\n   102→) -> DriftReport:\n   103→    \"\"\"\n   104→    Compare a fingerprint against baseline and produce a DriftReport.\n   105→\n   106→    Checks both exact-match fields (top_picks ordering) and tolerance-match\n   107→    fields (score dimensions) for drift violations.\n   108→\n   109→    Severity calculation (NUTRIENTS.md §I.4):\n   110→        - green: zero violations\n   111→        - yellow: tolerance violations only, no exact-match violations\n   112→        - red: any exact-match violation OR tolerance violation > 2× threshold\n   113→\n   114→    Args:\n   115→        fingerprint: Current scoring fingerprint to compare\n   116→        baseline: Accepted baseline fingerprint to compare against\n   117→        contract: Optional FingerprintContract with tolerance thresholds\n   118→            Defaults to standard contract from NUTRIENTS.md §I.2\n   119→\n   120→    Returns:\n   121→        DriftReport with violations and severity\n   122→\n   123→    Example:\n   124→        >>> fp = compute_fingerprint(result)\n   125→        >>> baseline = load_baseline(baselines_dir, candidate_id)\n   126→        >>> if baseline:\n   127→        ...     report = diff_against_baseline(fp, baseline)\n   128→        ...     if report.severity != \"green\":\n   129→        ...         publish_drift_alert(report)\n   130→    \"\"\"\n   131→    if contract is None:\n   132→        contract = FingerprintContract()\n   133→\n   134→    logger.debug(\n   135→        \"diff.comparing\",\n   136→        candidate_id=fingerprint.candidate_id,\n   137→        run_id=fingerprint.run_id,\n   138→        baseline_run_id=baseline.run_id,\n   139→    )\n   140→\n   141→    # Check exact-match violations\n   142→    exact_violations = _check_exact_violations(fingerprint, baseline)\n   143→\n   144→    # Check tolerance violations\n   145→    tolerance_violations = _check_tolerance_violations(\n   146→        fingerprint,\n   147→        baseline,\n   148→        contract,\n   149→    )\n   150→\n   151→    # Compute severity\n   152→    severity = _compute_severity(exact_violations, tolerance_violations, contract)\n   153→\n   154→    computed_at = datetime.now(timezone.utc).isoformat()\n   155→\n   156→    report = DriftReport(\n   157→        candidate_id=fingerprint.candidate_id,\n   158→        run_id=fingerprint.run_id,\n   159→        baseline_run_id=baseline.run_id,\n   160→        exact_violations=exact_violations,\n   161→        tolerance_violations=tolerance_violations,\n   162→        severity=severity,\n   163→        computed_at=computed_at,\n   164→    )\n   165→\n   166→    logger.info(\n   167→        \"diff.complete\",\n   168→        candidate_id=fingerprint.candidate_id,\n   169→        severity=severity,\n   170→        exact_violations=len(exact_violations),\n   171→        tolerance_violations=len(tolerance_violations),\n   172→    )\n   173→\n   174→    return report\n   175→\n   176→\n   177→def _check_exact_violations(\n   178→    fingerprint: ScoringFingerprint,\n   179→    baseline: ScoringFingerprint,\n   180→) -> list[DriftViolation]:\n   181→    \"\"\"\n   182→    Check exact-match fields for violations.\n   183→\n   184→    Compares top_picks ordering and IDs. Any difference is a violation.\n   185→\n   186→    Contract: NUTRIENTS.md §I.2 (Exact-Match Fields)\n   187→    \"\"\"\n   188→    violations: list[DriftViolation] = []\n   189→\n   190→    current_picks = fingerprint.exact_fields.top_picks\n   191→    baseline_picks = baseline.exact_fields.top_picks\n   192→\n   193→    # Check count mismatch\n   194→    if len(current_picks) != len(baseline_picks):\n   195→        violations.append(\n   196→            DriftViolation(\n   197→                field=\"exact_fields.top_picks.count\",\n   198→                baseline_value=len(baseline_picks),\n   199→                current_value=len(current_picks),\n   200→                delta_pct=None,\n   201→            )\n   202→        )\n   203→\n   204→    # Check each position for match\n   205→    min_len = min(len(current_picks), len(baseline_picks))\n   206→    for i in range(min_len):\n   207→        current = current_picks[i]\n   208→        baseline_pick = baseline_picks[i]\n   209→\n   210→        # Check job_id match\n   211→        if current.job_id != baseline_pick.job_id:\n   212→            violations.append(\n   213→                DriftViolation(\n   214→                    field=f\"exact_fields.top_picks[{i}].job_id\",\n   215→                    baseline_value=baseline_pick.job_id,\n   216→                    current_value=current.job_id,\n   217→                    delta_pct=None,\n   218→                )\n   219→            )\n   220→\n   221→        # Check source match\n   222→        if current.source != baseline_pick.source:\n   223→            violations.append(\n   224→                DriftViolation(\n   225→                    field=f\"exact_fields.top_picks[{i}].source\",\n   226→                    baseline_value=baseline_pick.source,\n   227→                    current_value=current.source,\n   228→                    delta_pct=None,\n   229→                )\n   230→            )\n   231→\n   232→        # Check url match\n   233→        if current.url != baseline_pick.url:\n   234→            violations.append(\n   235→                DriftViolation(\n   236→                    field=f\"exact_fields.top_picks[{i}].url\",\n   237→                    baseline_value=baseline_pick.url,\n   238→                    current_value=current.url,\n   239→                    delta_pct=None,\n   240→                )\n   241→            )\n   242→\n   243→        # Check position match (should always match by index, but verify)\n   244→        if current.position != baseline_pick.position:\n   245→            violations.append(\n   246→                DriftViolation(\n   247→                    field=f\"exact_fields.top_picks[{i}].position\",\n   248→                    baseline_value=baseline_pick.position,\n   249→                    current_value=current.position,\n   250→                    delta_pct=None,\n   251→                )\n   252→            )\n   253→\n   254→    # Report any extra picks beyond baseline\n   255→    for i in range(min_len, len(current_picks)):\n   256→        violations.append(\n   257→            DriftViolation(\n   258→                field=f\"exact_fields.top_picks[{i}]\",\n   259→                baseline_value=None,\n   260→                current_value=_pick_to_dict(current_picks[i]),\n   261→                delta_pct=None,\n   262→            )\n   263→        )\n   264→\n   265→    # Report any missing picks from baseline\n   266→    for i in range(min_len, len(baseline_picks)):\n   267→        violations.append(\n   268→            DriftViolation(\n   269→                field=f\"exact_fields.top_picks[{i}]\",\n   270→                baseline_value=_pick_to_dict(baseline_picks[i]),\n   271→                current_value=None,\n   272→                delta_pct=None,\n   273→            )\n   274→        )\n   275→\n   276→    return violations\n   277→\n   278→\n   279→def _pick_to_dict(pick: TopPickFingerprint) -> dict:\n   280→    \"\"\"Convert a TopPickFingerprint to a dict for violation reporting.\"\"\"\n   281→    return {\n   282→        \"job_id\": pick.job_id,\n   283→        \"source\": pick.source,\n   284→        \"url\": pick.url,\n   285→        \"position\": pick.position,\n   286→    }\n   287→\n   288→\n   289→def _check_tolerance_violations(\n   290→    fingerprint: ScoringFingerprint,\n   291→    baseline: ScoringFingerprint,\n   292→    contract: FingerprintContract,\n   293→) -> list[DriftViolation]:\n   294→    \"\"\"\n   295→    Check tolerance-match fields for violations.\n   296→\n   297→    Compares score dimensions against tolerance thresholds.\n   298→    Only drift exceeding the tolerance ratio is a violation.\n   299→\n   300→    Contract: NUTRIENTS.md §I.2 (Tolerance-Match Fields)\n   301→    \"\"\"\n   302→    violations: list[DriftViolation] = []\n   303→\n   304→    # Map of field names to (current_value, baseline_value, tolerance)\n   305→    fields_to_check = [\n   306→        (\n   307→            \"tolerance_fields.technical_match\",\n   308→            fingerprint.tolerance_fields.technical_match.value,\n   309→            baseline.tolerance_fields.technical_match.value,\n   310→            TOLERANCE_THRESHOLDS[\"technical_match\"].tolerance,\n   311→        ),\n   312→        (\n   313→            \"tolerance_fields.level_match\",\n   314→            fingerprint.tolerance_fields.level_match.value,\n   315→            baseline.tolerance_fields.level_match.value,\n   316→            TOLERANCE_THRESHOLDS[\"level_match\"].tolerance,\n   317→        ),\n   318→        (\n   319→            \"tolerance_fields.culture_match\",\n   320→            fingerprint.tolerance_fields.culture_match.value,\n   321→            baseline.tolerance_fields.culture_match.value,\n   322→            TOLERANCE_THRESHOLDS[\"culture_match\"].tolerance,\n   323→        ),\n   324→        (\n   325→            \"tolerance_fields.industry_match\",\n   326→            fingerprint.tolerance_fields.industry_match.value,\n   327→            baseline.tolerance_fields.industry_match.value,\n   328→            TOLERANCE_THRESHOLDS[\"industry_match\"].tolerance,\n   329→        ),\n   330→        (\n   331→            \"tolerance_fields.growth_potential\",\n   332→            fingerprint.tolerance_fields.growth_potential.value,\n   333→            baseline.tolerance_fields.growth_potential.value,\n   334→            TOLERANCE_THRESHOLDS[\"growth_potential\"].tolerance,\n   335→        ),\n   336→        (\n   337→            \"tolerance_fields.compensation_match\",\n   338→            fingerprint.tolerance_fields.compensation_match.value,\n   339→            baseline.tolerance_fields.compensation_match.value,\n   340→            TOLERANCE_THRESHOLDS[\"compensation_match\"].tolerance,\n   341→        ),\n   342→        (\n   343→            \"tolerance_fields.composite_score\",\n   344→            fingerprint.tolerance_fields.composite_score.value,\n   345→            baseline.tolerance_fields.composite_score.value,\n   346→            TOLERANCE_THRESHOLDS[\"composite_score\"].tolerance,\n   347→        ),\n   348→        (\n   349→            \"tolerance_fields.total_jobs_discovered\",\n   350→            fingerprint.tolerance_fields.total_jobs_discovered.value,\n   351→            baseline.tolerance_fields.total_jobs_discovered.value,\n   352→            TOLERANCE_THRESHOLDS[\"total_jobs_discovered\"].tolerance,\n   353→        ),\n   354→    ]\n   355→\n   356→    for field_name, current_val, baseline_val, tolerance in fields_to_check:\n   357→        violation = _check_single_tolerance(\n   358→            field_name,\n   359→            current_val,\n   360→            baseline_val,\n   361→            tolerance,\n   362→        )\n   363→        if violation is not None:\n   364→            violations.append(violation)\n   365→\n   366→    return violations\n   367→\n   368→\n   369→def _check_single_tolerance(\n   370→    field: str,\n   371→    current_value: float,\n   372→    baseline_value: float,\n   373→    tolerance: float,\n   374→) -> Optional[DriftViolation]:\n   375→    \"\"\"\n   376→    Check a single tolerance field for drift violation.\n   377→\n   378→    Args:\n   379→        field: Field path for violation reporting\n   380→        current_value: Current fingerprint value\n   381→        baseline_value: Baseline fingerprint value\n   382→        tolerance: Allowed tolerance as ratio (0.05 = ±5%)\n   383→\n   384→    Returns:\n   385→        DriftViolation if exceeded, None otherwise\n   386→    \"\"\"\n   387→    # Handle edge case of zero baseline\n   388→    if baseline_value == 0:\n   389→        # If baseline is 0 and current is not, that's significant drift\n   390→        if current_value != 0:\n   391→            return DriftViolation(\n   392→                field=field,\n   393→                baseline_value=baseline_value,\n   394→                current_value=current_value,\n   395→                delta_pct=None,  # Can't compute % from zero\n   396→            )\n   397→        return None\n   398→\n   399→    # Compute drift percentage\n   400→    delta_pct = abs((current_value - baseline_value) / baseline_value)\n   401→    delta_pct_rounded = round(delta_pct, 4)\n   402→\n   403→    # Check if drift exceeds tolerance\n   404→    if delta_pct > tolerance:\n   405→        return DriftViolation(\n   406→            field=field,\n   407→            baseline_value=baseline_value,\n   408→            current_value=current_value,\n   409→            delta_pct=delta_pct_rounded,\n   410→        )\n   411→\n   412→    return None\n   413→\n   414→\n   415→def _compute_severity(\n   416→    exact_violations: list[DriftViolation],\n   417→    tolerance_violations: list[DriftViolation],\n   418→    contract: FingerprintContract,\n   419→) -> DriftSeverity:\n   420→    \"\"\"\n   421→    Compute overall severity from violations.\n   422→\n   423→    Severity rules (NUTRIENTS.md §I.4):\n   424→        - green: zero violations\n   425→        - yellow: tolerance violations only, no exact-match violations\n   426→        - red: any exact-match violation OR tolerance violation > 2× threshold\n   427→\n   428→    Args:\n   429→        exact_violations: List of exact-match violations\n   430→        tolerance_violations: List of tolerance violations\n   431→        contract: FingerprintContract with tolerance thresholds\n   432→\n   433→    Returns:\n   434→        DriftSeverity level\n   435→    \"\"\"\n   436→    # Green: no violations at all\n   437→    if not exact_violations and not tolerance_violations:\n   438→        return \"green\"\n   439→\n   440→    # Red: any exact-match violation\n   441→    if exact_violations:\n   442→        logger.warning(\n   443→            \"diff.severity_red_exact\",\n   444→            exact_count=len(exact_violations),\n   445→            fields=[v.field for v in exact_violations[:3]],  # Log first 3\n   446→        )\n   447→        return \"red\"\n   448→\n   449→    # Check if any tolerance violation exceeds 2× threshold\n   450→    for violation in tolerance_violations:\n   451→        field_name = violation.field.replace(\"tolerance_fields.\", \"\")\n   452→        tolerance = TOLERANCE_THRESHOLDS.get(field_name)\n   453→\n   454→        if tolerance is not None and violation.delta_pct is not None:\n   455→            # Red if drift > 2× tolerance\n   456→            if violation.delta_pct > (tolerance.tolerance * 2):\n   457→                logger.warning(\n   458→                    \"diff.severity_red_tolerance\",\n   459→                    field=violation.field,\n   460→                    delta_pct=violation.delta_pct,\n   461→                    threshold=tolerance.tolerance,\n   462→                    exceeded_2x=True,\n   463→                )\n   464→                return \"red\"\n   465→\n   466→    # Yellow: tolerance violations only, none exceeding 2× threshold\n   467→    logger.info(\n   468→        \"diff.severity_yellow\",\n   469→        tolerance_count=len(tolerance_violations),\n   470→    )\n   471→    return \"yellow\"\n   472→\n   473→\n   474→# ─── Convenience Functions ───────────────────────────────────────────────────\n   475→\n   476→\n   477→def has_drift(report: DriftReport) -> bool:\n   478→    \"\"\"\n   479→    Check if a drift report contains any violations.\n   480→\n   481→    Args:\n   482→        report: DriftReport to check\n   483→\n   484→    Returns:\n   485→        True if any violations present (severity != green)\n   486→    \"\"\"\n   487→    return report.severity != \"green\"\n   488→\n   489→\n   490→def is_critical(report: DriftReport) -> bool:\n   491→    \"\"\"\n   492→    Check if a drift report has critical (red) severity.\n   493→\n   494→    Args:\n   495→        report: DriftReport to check\n   496→\n   497→    Returns:\n   498→        True if severity is red\n   499→    \"\"\"\n   500→    return report.severity == \"red\"\n   501→\n   502→\n   503→def format_summary(report: DriftReport) -> str:\n   504→    \"\"\"\n   505→    Format a human-readable summary of the drift report.\n   506→\n   507→    Args:\n   508→        report: DriftReport to summarize\n   509→\n   510→    Returns:\n   511→        Multi-line string summary\n   512→    \"\"\"\n   513→    lines = [\n   514→        f\"Drift Report for {report.candidate_id}\",\n   515→        f\"  Run: {report.run_id}\",\n   516→        f\"  Baseline: {report.baseline_run_id}\",\n   517→        f\"  Severity: {report.severity.upper()}\",\n   518→        f\"  Computed: {report.computed_at}\",\n   519→        \"\",\n   520→    ]\n   521→\n   522→    if report.exact_violations:\n   523→        lines.append(f\"Exact-Match Violations ({len(report.exact_violations)}):\")\n   524→        for v in report.exact_violations:\n   525→            lines.append(f\"  - {v.field}: {v.baseline_value} -> {v.current_value}\")\n   526→        lines.append(\"\")\n   527→\n   528→    if report.tolerance_violations:\n   529→        lines.append(f\"Tolerance Violations ({len(report.tolerance_violations)}):\")\n   530→        for v in report.tolerance_violations:\n   531→            pct = f\" ({v.delta_pct*100:.1f}%)\" if v.delta_pct else \"\"\n   532→            lines.append(\n   533→                f\"  - {v.field}: {v.baseline_value} -> {v.current_value}{pct}\"\n   534→            )\n   535→        lines.append(\"\")\n   536→\n   537→    if not report.exact_violations and not report.tolerance_violations:\n   538→        lines.append(\"No violations detected.\")\n   539→\n   540→    return \"\\n\".join(lines)\n   541→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"7d647432-976a-467b-a023-6b583c162bc9","uuid":"77b5d81c-d5ba-4e71-9e91-7b34eb5033be","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/synthetics/diff.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nDiff module — compares fingerprints against baselines to detect drift.\n\nImplements the drift detection logic per NUTRIENTS.md §I.2-I.4:\n    - Exact-match violations: any difference in top_picks ordering/IDs\n    - Tolerance violations: score dimensions exceeding ±N% threshold\n    - Severity rules: green (clean), yellow (tolerance only), red (exact or 2× tolerance)\n\nContract: NUTRIENTS.md §I.2-I.4, HYPHA-SYNTHETICS-SCORING.md\nOwner: synthetics-scoring-agent.diff\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import datetime, timezone\nfrom typing import Any, Optional, Literal\n\nimport structlog\nfrom pydantic import BaseModel, Field\n\nfrom backend.synthetics.fingerprint import (\n    FingerprintContract,\n    ScoringFingerprint,\n    TopPickFingerprint,\n    TOLERANCE_THRESHOLDS,\n)\n\nlogger = structlog.get_logger(__name__)\n\n\n# ─── Drift Severity (from NUTRIENTS.md §I.4) ─────────────────────────────────\n\n\nDriftSeverity = Literal[\"green\", \"yellow\", \"red\"]\n\n\n# ─── Drift Violation ─────────────────────────────────────────────────────────\n\n\nclass DriftViolation(BaseModel):\n    \"\"\"\n    A single drift violation detected during comparison.\n\n    Captures the field that drifted, baseline and current values,\n    and delta percentage for tolerance fields.\n\n    Contract: NUTRIENTS.md §I.4 (DriftViolation)\n    \"\"\"\n\n    field: str = Field(description=\"Path to the drifted field\")\n    baseline_value: Any = Field(description=\"Value in the baseline fingerprint\")\n    current_value: Any = Field(description=\"Value in the current fingerprint\")\n    delta_pct: Optional[float] = Field(\n        default=None,\n        description=\"Drift percentage for tolerance fields (null for exact fields)\",\n    )\n\n\n# ─── Drift Report ────────────────────────────────────────────────────────────\n\n\nclass DriftReport(BaseModel):\n    \"\"\"\n    Complete drift report comparing a fingerprint against baseline.\n\n    Contains all exact-match and tolerance violations, plus computed\n    severity level.\n\n    Severity rules (NUTRIENTS.md §I.4):\n        - green: zero violations\n        - yellow: tolerance violations only, no exact-match violations\n        - red: any exact-match violation OR tolerance violation > 2× threshold\n\n    Contract: NUTRIENTS.md §I.4 (DriftReport)\n    \"\"\"\n\n    candidate_id: str = Field(description=\"Synthetic candidate UUID\")\n    run_id: str = Field(description=\"UUID of the current run\")\n    baseline_run_id: str = Field(description=\"UUID of the baseline run\")\n    exact_violations: list[DriftViolation] = Field(\n        default_factory=list,\n        description=\"Exact-match field violations (any difference = violation)\",\n    )\n    tolerance_violations: list[DriftViolation] = Field(\n        default_factory=list,\n        description=\"Tolerance-match field violations (exceeded threshold)\",\n    )\n    severity: DriftSeverity = Field(description=\"Overall severity level\")\n    computed_at: str = Field(description=\"ISO-8601 timestamp of comparison\")\n\n\n# ─── Diff Functions ──────────────────────────────────────────────────────────\n\n\ndef diff_against_baseline(\n    fingerprint: ScoringFingerprint,\n    baseline: ScoringFingerprint,\n    contract: Optional[FingerprintContract] = None,\n) -> DriftReport:\n    \"\"\"\n    Compare a fingerprint against baseline and produce a DriftReport.\n\n    Checks both exact-match fields (top_picks ordering) and tolerance-match\n    fields (score dimensions) for drift violations.\n\n    Severity calculation (NUTRIENTS.md §I.4):\n        - green: zero violations\n        - yellow: tolerance violations only, no exact-match violations\n        - red: any exact-match violation OR tolerance violation > 2× threshold\n\n    Args:\n        fingerprint: Current scoring fingerprint to compare\n        baseline: Accepted baseline fingerprint to compare against\n        contract: Optional FingerprintContract with tolerance thresholds\n            Defaults to standard contract from NUTRIENTS.md §I.2\n\n    Returns:\n        DriftReport with violations and severity\n\n    Example:\n        >>> fp = compute_fingerprint(result)\n        >>> baseline = load_baseline(baselines_dir, candidate_id)\n        >>> if baseline:\n        ...     report = diff_against_baseline(fp, baseline)\n        ...     if report.severity != \"green\":\n        ...         publish_drift_alert(report)\n    \"\"\"\n    if contract is None:\n        contract = FingerprintContract()\n\n    logger.debug(\n        \"diff.comparing\",\n        candidate_id=fingerprint.candidate_id,\n        run_id=fingerprint.run_id,\n        baseline_run_id=baseline.run_id,\n    )\n\n    # Check exact-match violations\n    exact_violations = _check_exact_violations(fingerprint, baseline)\n\n    # Check tolerance violations\n    tolerance_violations = _check_tolerance_violations(\n        fingerprint,\n        baseline,\n        contract,\n    )\n\n    # Compute severity\n    severity = _compute_severity(exact_violations, tolerance_violations, contract)\n\n    computed_at = datetime.now(timezone.utc).isoformat()\n\n    report = DriftReport(\n        candidate_id=fingerprint.candidate_id,\n        run_id=fingerprint.run_id,\n        baseline_run_id=baseline.run_id,\n        exact_violations=exact_violations,\n        tolerance_violations=tolerance_violations,\n        severity=severity,\n        computed_at=computed_at,\n    )\n\n    logger.info(\n        \"diff.complete\",\n        candidate_id=fingerprint.candidate_id,\n        severity=severity,\n        exact_violations=len(exact_violations),\n        tolerance_violations=len(tolerance_violations),\n    )\n\n    return report\n\n\ndef _check_exact_violations(\n    fingerprint: ScoringFingerprint,\n    baseline: ScoringFingerprint,\n) -> list[DriftViolation]:\n    \"\"\"\n    Check exact-match fields for violations.\n\n    Compares top_picks ordering and IDs. Any difference is a violation.\n\n    Contract: NUTRIENTS.md §I.2 (Exact-Match Fields)\n    \"\"\"\n    violations: list[DriftViolation] = []\n\n    current_picks = fingerprint.exact_fields.top_picks\n    baseline_picks = baseline.exact_fields.top_picks\n\n    # Check count mismatch\n    if len(current_picks) != len(baseline_picks):\n        violations.append(\n            DriftViolation(\n                field=\"exact_fields.top_picks.count\",\n                baseline_value=len(baseline_picks),\n                current_value=len(current_picks),\n                delta_pct=None,\n            )\n        )\n\n    # Check each position for match\n    min_len = min(len(current_picks), len(baseline_picks))\n    for i in range(min_len):\n        current = current_picks[i]\n        baseline_pick = baseline_picks[i]\n\n        # Check job_id match\n        if current.job_id != baseline_pick.job_id:\n            violations.append(\n                DriftViolation(\n                    field=f\"exact_fields.top_picks[{i}].job_id\",\n                    baseline_value=baseline_pick.job_id,\n                    current_value=current.job_id,\n                    delta_pct=None,\n                )\n            )\n\n        # Check source match\n        if current.source != baseline_pick.source:\n            violations.append(\n                DriftViolation(\n                    field=f\"exact_fields.top_picks[{i}].source\",\n                    baseline_value=baseline_pick.source,\n                    current_value=current.source,\n                    delta_pct=None,\n                )\n            )\n\n        # Check url match\n        if current.url != baseline_pick.url:\n            violations.append(\n                DriftViolation(\n                    field=f\"exact_fields.top_picks[{i}].url\",\n                    baseline_value=baseline_pick.url,\n                    current_value=current.url,\n                    delta_pct=None,\n                )\n            )\n\n        # Check position match (should always match by index, but verify)\n        if current.position != baseline_pick.position:\n            violations.append(\n                DriftViolation(\n                    field=f\"exact_fields.top_picks[{i}].position\",\n                    baseline_value=baseline_pick.position,\n                    current_value=current.position,\n                    delta_pct=None,\n                )\n            )\n\n    # Report any extra picks beyond baseline\n    for i in range(min_len, len(current_picks)):\n        violations.append(\n            DriftViolation(\n                field=f\"exact_fields.top_picks[{i}]\",\n                baseline_value=None,\n                current_value=_pick_to_dict(current_picks[i]),\n                delta_pct=None,\n            )\n        )\n\n    # Report any missing picks from baseline\n    for i in range(min_len, len(baseline_picks)):\n        violations.append(\n            DriftViolation(\n                field=f\"exact_fields.top_picks[{i}]\",\n                baseline_value=_pick_to_dict(baseline_picks[i]),\n                current_value=None,\n                delta_pct=None,\n            )\n        )\n\n    return violations\n\n\ndef _pick_to_dict(pick: TopPickFingerprint) -> dict:\n    \"\"\"Convert a TopPickFingerprint to a dict for violation reporting.\"\"\"\n    return {\n        \"job_id\": pick.job_id,\n        \"source\": pick.source,\n        \"url\": pick.url,\n        \"position\": pick.position,\n    }\n\n\ndef _check_tolerance_violations(\n    fingerprint: ScoringFingerprint,\n    baseline: ScoringFingerprint,\n    contract: FingerprintContract,\n) -> list[DriftViolation]:\n    \"\"\"\n    Check tolerance-match fields for violations.\n\n    Compares score dimensions against tolerance thresholds.\n    Only drift exceeding the tolerance ratio is a violation.\n\n    Contract: NUTRIENTS.md §I.2 (Tolerance-Match Fields)\n    \"\"\"\n    violations: list[DriftViolation] = []\n\n    # Map of field names to (current_value, baseline_value, tolerance)\n    fields_to_check = [\n        (\n            \"tolerance_fields.technical_match\",\n            fingerprint.tolerance_fields.technical_match.value,\n            baseline.tolerance_fields.technical_match.value,\n            TOLERANCE_THRESHOLDS[\"technical_match\"].tolerance,\n        ),\n        (\n            \"tolerance_fields.level_match\",\n            fingerprint.tolerance_fields.level_match.value,\n            baseline.tolerance_fields.level_match.value,\n            TOLERANCE_THRESHOLDS[\"level_match\"].tolerance,\n        ),\n        (\n            \"tolerance_fields.culture_match\",\n            fingerprint.tolerance_fields.culture_match.value,\n            baseline.tolerance_fields.culture_match.value,\n            TOLERANCE_THRESHOLDS[\"culture_match\"].tolerance,\n        ),\n        (\n            \"tolerance_fields.industry_match\",\n            fingerprint.tolerance_fields.industry_match.value,\n            baseline.tolerance_fields.industry_match.value,\n            TOLERANCE_THRESHOLDS[\"industry_match\"].tolerance,\n        ),\n        (\n            \"tolerance_fields.growth_potential\",\n            fingerprint.tolerance_fields.growth_potential.value,\n            baseline.tolerance_fields.growth_potential.value,\n            TOLERANCE_THRESHOLDS[\"growth_potential\"].tolerance,\n        ),\n        (\n            \"tolerance_fields.compensation_match\",\n            fingerprint.tolerance_fields.compensation_match.value,\n            baseline.tolerance_fields.compensation_match.value,\n            TOLERANCE_THRESHOLDS[\"compensation_match\"].tolerance,\n        ),\n        (\n            \"tolerance_fields.composite_score\",\n            fingerprint.tolerance_fields.composite_score.value,\n            baseline.tolerance_fields.composite_score.value,\n            TOLERANCE_THRESHOLDS[\"composite_score\"].tolerance,\n        ),\n        (\n            \"tolerance_fields.total_jobs_discovered\",\n            fingerprint.tolerance_fields.total_jobs_discovered.value,\n            baseline.tolerance_fields.total_jobs_discovered.value,\n            TOLERANCE_THRESHOLDS[\"total_jobs_discovered\"].tolerance,\n        ),\n    ]\n\n    for field_name, current_val, baseline_val, tolerance in fields_to_check:\n        violation = _check_single_tolerance(\n            field_name,\n            current_val,\n            baseline_val,\n            tolerance,\n        )\n        if violation is not None:\n            violations.append(violation)\n\n    return violations\n\n\ndef _check_single_tolerance(\n    field: str,\n    current_value: float,\n    baseline_value: float,\n    tolerance: float,\n) -> Optional[DriftViolation]:\n    \"\"\"\n    Check a single tolerance field for drift violation.\n\n    Args:\n        field: Field path for violation reporting\n        current_value: Current fingerprint value\n        baseline_value: Baseline fingerprint value\n        tolerance: Allowed tolerance as ratio (0.05 = ±5%)\n\n    Returns:\n        DriftViolation if exceeded, None otherwise\n    \"\"\"\n    # Handle edge case of zero baseline\n    if baseline_value == 0:\n        # If baseline is 0 and current is not, that's significant drift\n        if current_value != 0:\n            return DriftViolation(\n                field=field,\n                baseline_value=baseline_value,\n                current_value=current_value,\n                delta_pct=None,  # Can't compute % from zero\n            )\n        return None\n\n    # Compute drift percentage\n    delta_pct = abs((current_value - baseline_value) / baseline_value)\n    delta_pct_rounded = round(delta_pct, 4)\n\n    # Check if drift exceeds tolerance\n    if delta_pct > tolerance:\n        return DriftViolation(\n            field=field,\n            baseline_value=baseline_value,\n            current_value=current_value,\n            delta_pct=delta_pct_rounded,\n        )\n\n    return None\n\n\ndef _compute_severity(\n    exact_violations: list[DriftViolation],\n    tolerance_violations: list[DriftViolation],\n    contract: FingerprintContract,\n) -> DriftSeverity:\n    \"\"\"\n    Compute overall severity from violations.\n\n    Severity rules (NUTRIENTS.md §I.4):\n        - green: zero violations\n        - yellow: tolerance violations only, no exact-match violations\n        - red: any exact-match violation OR tolerance violation > 2× threshold\n\n    Args:\n        exact_violations: List of exact-match violations\n        tolerance_violations: List of tolerance violations\n        contract: FingerprintContract with tolerance thresholds\n\n    Returns:\n        DriftSeverity level\n    \"\"\"\n    # Green: no violations at all\n    if not exact_violations and not tolerance_violations:\n        return \"green\"\n\n    # Red: any exact-match violation\n    if exact_violations:\n        logger.warning(\n            \"diff.severity_red_exact\",\n            exact_count=len(exact_violations),\n            fields=[v.field for v in exact_violations[:3]],  # Log first 3\n        )\n        return \"red\"\n\n    # Check if any tolerance violation exceeds 2× threshold\n    for violation in tolerance_violations:\n        field_name = violation.field.replace(\"tolerance_fields.\", \"\")\n        tolerance = TOLERANCE_THRESHOLDS.get(field_name)\n\n        if tolerance is not None and violation.delta_pct is not None:\n            # Red if drift > 2× tolerance\n            if violation.delta_pct > (tolerance.tolerance * 2):\n                logger.warning(\n                    \"diff.severity_red_tolerance\",\n                    field=violation.field,\n                    delta_pct=violation.delta_pct,\n                    threshold=tolerance.tolerance,\n                    exceeded_2x=True,\n                )\n                return \"red\"\n\n    # Yellow: tolerance violations only, none exceeding 2× threshold\n    logger.info(\n        \"diff.severity_yellow\",\n        tolerance_count=len(tolerance_violations),\n    )\n    return \"yellow\"\n\n\n# ─── Convenience Functions ───────────────────────────────────────────────────\n\n\ndef has_drift(report: DriftReport) -> bool:\n    \"\"\"\n    Check if a drift report contains any violations.\n\n    Args:\n        report: DriftReport to check\n\n    Returns:\n        True if any violations present (severity != green)\n    \"\"\"\n    return report.severity != \"green\"\n\n\ndef is_critical(report: DriftReport) -> bool:\n    \"\"\"\n    Check if a drift report has critical (red) severity.\n\n    Args:\n        report: DriftReport to check\n\n    Returns:\n        True if severity is red\n    \"\"\"\n    return report.severity == \"red\"\n\n\ndef format_summary(report: DriftReport) -> str:\n    \"\"\"\n    Format a human-readable summary of the drift report.\n\n    Args:\n        report: DriftReport to summarize\n\n    Returns:\n        Multi-line string summary\n    \"\"\"\n    lines = [\n        f\"Drift Report for {report.candidate_id}\",\n        f\"  Run: {report.run_id}\",\n        f\"  Baseline: {report.baseline_run_id}\",\n        f\"  Severity: {report.severity.upper()}\",\n        f\"  Computed: {report.computed_at}\",\n        \"\",\n    ]\n\n    if report.exact_violations:\n        lines.append(f\"Exact-Match Violations ({len(report.exact_violations)}):\")\n        for v in report.exact_violations:\n            lines.append(f\"  - {v.field}: {v.baseline_value} -> {v.current_value}\")\n        lines.append(\"\")\n\n    if report.tolerance_violations:\n        lines.append(f\"Tolerance Violations ({len(report.tolerance_violations)}):\")\n        for v in report.tolerance_violations:\n            pct = f\" ({v.delta_pct*100:.1f}%)\" if v.delta_pct else \"\"\n            lines.append(\n                f\"  - {v.field}: {v.baseline_value} -> {v.current_value}{pct}\"\n            )\n        lines.append(\"\")\n\n    if not report.exact_violations and not report.tolerance_violations:\n        lines.append(\"No violations detected.\")\n\n    return \"\\n\".join(lines)\n","numLines":541,"startLine":1,"totalLines":541}}}}
