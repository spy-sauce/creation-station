{"t":"2026-05-28T03:44:00.367Z","event":"sdk_msg","msg":{"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_01HJPMTbbu3vyRq3j41uWY9E","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01BVx1eHNh2Gn6AKCMq97tkt","name":"Read","input":{"file_path":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/synthetics/fingerprint.py"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":175,"cache_read_input_tokens":84284,"cache_creation":{"ephemeral_5m_input_tokens":175,"ephemeral_1h_input_tokens":0},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"7d647432-976a-467b-a023-6b583c162bc9","uuid":"6db5a563-fd36-4422-bd1b-ae5f0e2f60a5"}}
{"t":"2026-05-28T03:44:00.541Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BVx1eHNh2Gn6AKCMq97tkt","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Fingerprint module — produces stable JSON fingerprints for drift detection.\n     6→\n     7→Computes deterministic fingerprints from scoring results that can be compared\n     8→across runs. The fingerprint captures both exact-match fields (ordering, IDs)\n     9→and tolerance-match fields (scores with bounded variance).\n    10→\n    11→Stability guarantees:\n    12→    1. Arrays sorted by deterministic keys (job_id for top_picks)\n    13→    2. Floats rounded to 4 decimal places to avoid IEEE precision drift\n    14→    3. Timestamps and run_ids excluded from comparison\n    15→    4. First 5 top_picks ordering captured as exact-match field\n    16→\n    17→Contract: NUTRIENTS.md §I.2-I.5, HYPHA-SYNTHETICS-SCORING.md\n    18→Owner: synthetics-scoring-agent.fingerprint\n    19→\"\"\"\n    20→\n    21→from __future__ import annotations\n    22→\n    23→from datetime import datetime, timezone\n    24→from typing import Optional\n    25→\n    26→import structlog\n    27→from pydantic import BaseModel, Field\n    28→\n    29→logger = structlog.get_logger(__name__)\n    30→\n    31→\n    32→# ─── Contract Fields (from NUTRIENTS.md §I.2) ─────────────────────────────────\n    33→\n    34→\n    35→class ToleranceSpec(BaseModel):\n    36→    \"\"\"Tolerance specification for a numeric field.\"\"\"\n    37→\n    38→    tolerance: float = Field(description=\"Allowed variance as ratio (0.05 = ±5%)\")\n    39→\n    40→\n    41→# Default tolerance thresholds from NUTRIENTS.md §I.2\n    42→TOLERANCE_THRESHOLDS = {\n    43→    \"technical_match\": ToleranceSpec(tolerance=0.05),\n    44→    \"level_match\": ToleranceSpec(tolerance=0.05),\n    45→    \"culture_match\": ToleranceSpec(tolerance=0.05),\n    46→    \"industry_match\": ToleranceSpec(tolerance=0.05),\n    47→    \"growth_potential\": ToleranceSpec(tolerance=0.05),\n    48→    \"compensation_match\": ToleranceSpec(tolerance=0.05),\n    49→    \"composite_score\": ToleranceSpec(tolerance=0.03),\n    50→    \"total_jobs_discovered\": ToleranceSpec(tolerance=0.10),\n    51→}\n    52→\n    53→\n    54→# ─── Top Pick Fingerprint ─────────────────────────────────────────────────────\n    55→\n    56→\n    57→class TopPickFingerprint(BaseModel):\n    58→    \"\"\"\n    59→    Fingerprint for a single top pick in the digest.\n    60→\n    61→    Captures the exact-match fields: job_id, source, url, position.\n    62→    \"\"\"\n    63→\n    64→    job_id: str = Field(description=\"Deterministic job ID (synthetic JD UUID)\")\n    65→    source: str = Field(description=\"Job source (greenhouse, lever, etc.)\")\n    66→    url: str = Field(description=\"Job URL\")\n    67→    position: int = Field(description=\"Position in top_picks (0-indexed)\")\n    68→\n    69→\n    70→# ─── Tolerance Field Value ────────────────────────────────────────────────────\n    71→\n    72→\n    73→class ToleranceFieldValue(BaseModel):\n    74→    \"\"\"\n    75→    Value for a tolerance-match field with drift tracking.\n    76→\n    77→    Stores current value, baseline value (if exists), and computed drift %.\n    78→    \"\"\"\n    79→\n    80→    value: float = Field(description=\"Current value (rounded to 4 decimals)\")\n    81→    baseline: Optional[float] = Field(\n    82→        default=None,\n    83→        description=\"Baseline value for comparison (null if no baseline)\",\n    84→    )\n    85→    drift_pct: Optional[float] = Field(\n    86→        default=None,\n    87→        description=\"Drift percentage from baseline (null if no baseline)\",\n    88→    )\n    89→\n    90→\n    91→# ─── Exact Fields Container ───────────────────────────────────────────────────\n    92→\n    93→\n    94→class ExactFields(BaseModel):\n    95→    \"\"\"\n    96→    Container for exact-match fields in the fingerprint.\n    97→\n    98→    Per NUTRIENTS.md §I.2, these fields MUST be byte-identical between runs.\n    99→    Any difference is a drift violation.\n   100→    \"\"\"\n   101→\n   102→    top_picks: list[TopPickFingerprint] = Field(\n   103→        default_factory=list,\n   104→        description=\"First 5 top picks with position (exact-match)\",\n   105→    )\n   106→\n   107→\n   108→# ─── Tolerance Fields Container ───────────────────────────────────────────────\n   109→\n   110→\n   111→class ToleranceFields(BaseModel):\n   112→    \"\"\"\n   113→    Container for tolerance-match fields in the fingerprint.\n   114→\n   115→    Per NUTRIENTS.md §I.2, these fields allow bounded variance (±N%).\n   116→    Exceeding the tolerance is a drift violation.\n   117→    \"\"\"\n   118→\n   119→    technical_match: ToleranceFieldValue\n   120→    level_match: ToleranceFieldValue\n   121→    culture_match: ToleranceFieldValue\n   122→    industry_match: ToleranceFieldValue\n   123→    growth_potential: ToleranceFieldValue\n   124→    compensation_match: ToleranceFieldValue\n   125→    composite_score: ToleranceFieldValue\n   126→    total_jobs_discovered: ToleranceFieldValue\n   127→\n   128→\n   129→# ─── Scoring Fingerprint ──────────────────────────────────────────────────────\n   130→\n   131→\n   132→class ScoringFingerprint(BaseModel):\n   133→    \"\"\"\n   134→    Stable fingerprint for a candidate's scoring results.\n   135→\n   136→    This is the unit of comparison for drift detection. Contains both\n   137→    exact-match fields (must be byte-identical) and tolerance-match\n   138→    fields (allow bounded variance).\n   139→\n   140→    Per HYPHA-SYNTHETICS-SCORING.md, fingerprints must be byte-stable\n   141→    across runs given the same inputs.\n   142→\n   143→    Contract: NUTRIENTS.md §I.9 (ScoringFingerprint)\n   144→    \"\"\"\n   145→\n   146→    candidate_id: str = Field(description=\"Synthetic candidate UUID\")\n   147→    run_id: str = Field(description=\"UUID of the run that produced this fingerprint\")\n   148→    computed_at: str = Field(description=\"ISO-8601 timestamp of computation\")\n   149→    exact_fields: ExactFields = Field(\n   150→        default_factory=ExactFields,\n   151→        description=\"Fields that must be byte-identical\",\n   152→    )\n   153→    tolerance_fields: ToleranceFields = Field(\n   154→        description=\"Fields that allow bounded variance\",\n   155→    )\n   156→\n   157→\n   158→# ─── Fingerprint Contract ─────────────────────────────────────────────────────\n   159→\n   160→\n   161→class FingerprintContract(BaseModel):\n   162→    \"\"\"\n   163→    Contract defining which fields are exact-match vs tolerance-match.\n   164→\n   165→    Used by compute_fingerprint to determine how to extract and normalize\n   166→    values from scoring results.\n   167→    \"\"\"\n   168→\n   169→    exact_fields: list[str] = Field(\n   170→        default_factory=lambda: [\n   171→            \"digest.top_picks[0..4].job.id\",\n   172→            \"digest.top_picks[0..4].job.source\",\n   173→            \"digest.top_picks[0..4].job.url\",\n   174→            \"digest.top_picks[0..4].ordering\",\n   175→        ],\n   176→        description=\"Fields requiring byte-identical match\",\n   177→    )\n   178→\n   179→    tolerance_fields: dict[str, float] = Field(\n   180→        default_factory=lambda: {\n   181→            \"score.technical_match\": 0.05,\n   182→            \"score.level_match\": 0.05,\n   183→            \"score.culture_match\": 0.05,\n   184→            \"score.industry_match\": 0.05,\n   185→            \"score.growth_potential\": 0.05,\n   186→            \"score.compensation_match\": 0.05,\n   187→            \"composite_score\": 0.03,\n   188→            \"total_jobs_discovered\": 0.10,\n   189→        },\n   190→        description=\"Field -> tolerance (as ratio)\",\n   191→    )\n   192→\n   193→    excluded_fields: list[str] = Field(\n   194→        default_factory=lambda: [\n   195→            \"created_at\",\n   196→            \"updated_at\",\n   197→            \"run_id\",\n   198→            \"crawl_run.duration_seconds\",\n   199→            \"crawl_run.started_at\",\n   200→            \"crawl_run.completed_at\",\n   201→            \"non_synthetic_uuids\",\n   202→        ],\n   203→        description=\"Fields excluded from all comparisons\",\n   204→    )\n   205→\n   206→\n   207→# ─── Fingerprint Computation ──────────────────────────────────────────────────\n   208→\n   209→\n   210→def compute_fingerprint(\n   211→    candidate_scoring_result: dict,\n   212→    contract: Optional[FingerprintContract] = None,\n   213→    baseline: Optional[ScoringFingerprint] = None,\n   214→) -> ScoringFingerprint:\n   215→    \"\"\"\n   216→    Compute a stable fingerprint from scoring results.\n   217→\n   218→    Takes the raw scoring output from ScoringSyntheticRunner and produces\n   219→    a deterministic fingerprint suitable for drift comparison.\n   220→\n   221→    Stability guarantees:\n   222→        1. Top picks sorted by job_id before position assignment\n   223→        2. All floats rounded to 4 decimal places\n   224→        3. Timestamps excluded (only computed_at for reference)\n   225→        4. Only first 5 top picks captured\n   226→\n   227→    Args:\n   228→        candidate_scoring_result: Dict from CandidateScoringResult.model_dump()\n   229→            Expected keys: candidate_id, scored_results, cache_stats\n   230→        contract: Optional FingerprintContract defining comparison rules\n   231→            Defaults to standard contract from NUTRIENTS.md §I.2\n   232→        baseline: Optional baseline fingerprint for drift calculation\n   233→\n   234→    Returns:\n   235→        ScoringFingerprint with exact and tolerance fields populated\n   236→\n   237→    Example:\n   238→        >>> result = await runner.run_suite()\n   239→        >>> for candidate in result[\"candidates\"]:\n   240→        ...     fp = compute_fingerprint(candidate)\n   241→        ...     print(fp.candidate_id, fp.tolerance_fields.composite_score.value)\n   242→    \"\"\"\n   243→    if contract is None:\n   244→        contract = FingerprintContract()\n   245→\n   246→    candidate_id = candidate_scoring_result.get(\"candidate_id\", \"unknown\")\n   247→    scored_results = candidate_scoring_result.get(\"scored_results\", [])\n   248→\n   249→    logger.debug(\n   250→        \"fingerprint.computing\",\n   251→        candidate_id=candidate_id,\n   252→        scored_results_count=len(scored_results),\n   253→    )\n   254→\n   255→    # Extract and sort scored results for deterministic ordering\n   256→    # Sort by jd_filename for reproducibility\n   257→    sorted_results = sorted(\n   258→        [r for r in scored_results if r.get(\"scored_job\") is not None],\n   259→        key=lambda r: r.get(\"jd_filename\", \"\"),\n   260→    )\n   261→\n   262→    # Compute exact fields: first 5 top picks by composite score\n   263→    top_results = sorted(\n   264→        sorted_results,\n   265→        key=lambda r: r.get(\"scored_job\", {}).get(\"composite_score\", 0),\n   266→        reverse=True,\n   267→    )[:5]\n   268→\n   269→    top_picks: list[TopPickFingerprint] = []\n   270→    for position, result in enumerate(top_results):\n   271→        scored_job = result.get(\"scored_job\", {})\n   272→        top_picks.append(\n   273→            TopPickFingerprint(\n   274→                job_id=str(scored_job.get(\"discovered_job_id\", \"\")),\n   275→                source=str(result.get(\"jd_filename\", \"\").split(\"-\")[0]),  # Extract source prefix\n   276→                url=str(scored_job.get(\"url\", \"\")),\n   277→                position=position,\n   278→            )\n   279→        )\n   280→\n   281→    exact_fields = ExactFields(top_picks=top_picks)\n   282→\n   283→    # Compute tolerance fields: aggregate score dimensions\n   284→    tolerance_fields = _compute_tolerance_fields(\n   285→        scored_results,\n   286→        baseline,\n   287→    )\n   288→\n   289→    # Generate deterministic run_id from candidate_id + computed_at\n   290→    computed_at = datetime.now(timezone.utc).isoformat()\n   291→\n   292→    fingerprint = ScoringFingerprint(\n   293→        candidate_id=candidate_id,\n   294→        run_id=candidate_scoring_result.get(\"run_id\", \"unknown\"),\n   295→        computed_at=computed_at,\n   296→        exact_fields=exact_fields,\n   297→        tolerance_fields=tolerance_fields,\n   298→    )\n   299→\n   300→    logger.info(\n   301→        \"fingerprint.computed\",\n   302→        candidate_id=candidate_id,\n   303→        top_picks_count=len(top_picks),\n   304→        composite_score=tolerance_fields.composite_score.value,\n   305→    )\n   306→\n   307→    return fingerprint\n   308→\n   309→\n   310→def _compute_tolerance_fields(\n   311→    scored_results: list[dict],\n   312→    baseline: Optional[ScoringFingerprint],\n   313→) -> ToleranceFields:\n   314→    \"\"\"\n   315→    Compute tolerance field values from scored results.\n   316→\n   317→    Aggregates score dimensions across all scored jobs and computes\n   318→    drift percentage if a baseline is provided.\n   319→\n   320→    Args:\n   321→        scored_results: List of scoring result dicts\n   322→        baseline: Optional baseline fingerprint for drift calculation\n   323→\n   324→    Returns:\n   325→        ToleranceFields with aggregated values and drift percentages\n   326→    \"\"\"\n   327→    # Collect all score dimensions\n   328→    tech_scores: list[int] = []\n   329→    level_scores: list[int] = []\n   330→    culture_scores: list[int] = []\n   331→    industry_scores: list[int] = []\n   332→    growth_scores: list[int] = []\n   333→    comp_scores: list[int] = []\n   334→    composite_scores: list[int] = []\n   335→\n   336→    for result in scored_results:\n   337→        scored_job = result.get(\"scored_job\")\n   338→        if scored_job is None:\n   339→            continue\n   340→\n   341→        breakdown = scored_job.get(\"score_breakdown\", {})\n   342→        tech_scores.append(breakdown.get(\"technical_match\", 0))\n   343→        level_scores.append(breakdown.get(\"level_match\", 0))\n   344→        culture_scores.append(breakdown.get(\"culture_match\", 0))\n   345→        industry_scores.append(breakdown.get(\"industry_match\", 0))\n   346→        growth_scores.append(breakdown.get(\"growth_potential\", 0))\n   347→        comp_scores.append(breakdown.get(\"compensation_match\", 0))\n   348→        composite_scores.append(scored_job.get(\"composite_score\", 0))\n   349→\n   350→    # Compute averages (rounded to 4 decimals for stability)\n   351→    def avg(scores: list[int]) -> float:\n   352→        if not scores:\n   353→            return 0.0\n   354→        return round(sum(scores) / len(scores), 4)\n   355→\n   356→    tech_avg = avg(tech_scores)\n   357→    level_avg = avg(level_scores)\n   358→    culture_avg = avg(culture_scores)\n   359→    industry_avg = avg(industry_scores)\n   360→    growth_avg = avg(growth_scores)\n   361→    comp_avg = avg(comp_scores)\n   362→    composite_avg = avg(composite_scores)\n   363→    total_discovered = float(len(scored_results))\n   364→\n   365→    # Helper to compute drift percentage\n   366→    def drift_pct(current: float, baseline_val: Optional[float]) -> Optional[float]:\n   367→        if baseline_val is None or baseline_val == 0:\n   368→            return None\n   369→        return round((current - baseline_val) / baseline_val, 4)\n   370→\n   371→    # Extract baseline values if present\n   372→    baseline_tech = None\n   373→    baseline_level = None\n   374→    baseline_culture = None\n   375→    baseline_industry = None\n   376→    baseline_growth = None\n   377→    baseline_comp = None\n   378→    baseline_composite = None\n   379→    baseline_discovered = None\n   380→\n   381→    if baseline is not None:\n   382→        baseline_tech = baseline.tolerance_fields.technical_match.value\n   383→        baseline_level = baseline.tolerance_fields.level_match.value\n   384→        baseline_culture = baseline.tolerance_fields.culture_match.value\n   385→        baseline_industry = baseline.tolerance_fields.industry_match.value\n   386→        baseline_growth = baseline.tolerance_fields.growth_potential.value\n   387→        baseline_comp = baseline.tolerance_fields.compensation_match.value\n   388→        baseline_composite = baseline.tolerance_fields.composite_score.value\n   389→        baseline_discovered = baseline.tolerance_fields.total_jobs_discovered.value\n   390→\n   391→    return ToleranceFields(\n   392→        technical_match=ToleranceFieldValue(\n   393→            value=tech_avg,\n   394→            baseline=baseline_tech,\n   395→            drift_pct=drift_pct(tech_avg, baseline_tech),\n   396→        ),\n   397→        level_match=ToleranceFieldValue(\n   398→            value=level_avg,\n   399→            baseline=baseline_level,\n   400→            drift_pct=drift_pct(level_avg, baseline_level),\n   401→        ),\n   402→        culture_match=ToleranceFieldValue(\n   403→            value=culture_avg,\n   404→            baseline=baseline_culture,\n   405→            drift_pct=drift_pct(culture_avg, baseline_culture),\n   406→        ),\n   407→        industry_match=ToleranceFieldValue(\n   408→            value=industry_avg,\n   409→            baseline=baseline_industry,\n   410→            drift_pct=drift_pct(industry_avg, baseline_industry),\n   411→        ),\n   412→        growth_potential=ToleranceFieldValue(\n   413→            value=growth_avg,\n   414→            baseline=baseline_growth,\n   415→            drift_pct=drift_pct(growth_avg, baseline_growth),\n   416→        ),\n   417→        compensation_match=ToleranceFieldValue(\n   418→            value=comp_avg,\n   419→            baseline=baseline_comp,\n   420→            drift_pct=drift_pct(comp_avg, baseline_comp),\n   421→        ),\n   422→        composite_score=ToleranceFieldValue(\n   423→            value=composite_avg,\n   424→            baseline=baseline_composite,\n   425→            drift_pct=drift_pct(composite_avg, baseline_composite),\n   426→        ),\n   427→        total_jobs_discovered=ToleranceFieldValue(\n   428→            value=total_discovered,\n   429→            baseline=baseline_discovered,\n   430→            drift_pct=drift_pct(total_discovered, baseline_discovered),\n   431→        ),\n   432→    )\n   433→\n   434→\n   435→# ─── Baseline Loading ─────────────────────────────────────────────────────────\n   436→\n   437→\n   438→def load_baseline(\n   439→    baselines_dir: str,\n   440→    candidate_id: str,\n   441→) -> Optional[ScoringFingerprint]:\n   442→    \"\"\"\n   443→    Load the latest accepted baseline for a candidate.\n   444→\n   445→    Baselines are stored at:\n   446→        synthetics/fixtures/baselines/<candidate_id>__<run_id>.json\n   447→\n   448→    Only committed baselines are considered valid. The latest by\n   449→    accepted_at timestamp is returned.\n   450→\n   451→    Args:\n   452→        baselines_dir: Path to synthetics/fixtures/baselines/\n   453→        candidate_id: Synthetic candidate UUID\n   454→\n   455→    Returns:\n   456→        ScoringFingerprint from baseline, or None if no baseline exists\n   457→    \"\"\"\n   458→    import json\n   459→    from pathlib import Path\n   460→\n   461→    baselines_path = Path(baselines_dir)\n   462→    if not baselines_path.exists():\n   463→        logger.debug(\"fingerprint.baseline_dir_not_found\", path=baselines_dir)\n   464→        return None\n   465→\n   466→    # Find all baselines for this candidate\n   467→    pattern = f\"{candidate_id}__*.json\"\n   468→    baseline_files = list(baselines_path.glob(pattern))\n   469→\n   470→    if not baseline_files:\n   471→        logger.debug(\n   472→            \"fingerprint.no_baseline\",\n   473→            candidate_id=candidate_id,\n   474→            pattern=pattern,\n   475→        )\n   476→        return None\n   477→\n   478→    # Sort by file modification time (latest first)\n   479→    baseline_files.sort(key=lambda f: f.stat().st_mtime, reverse=True)\n   480→    latest_file = baseline_files[0]\n   481→\n   482→    logger.debug(\n   483→        \"fingerprint.loading_baseline\",\n   484→        candidate_id=candidate_id,\n   485→        file=str(latest_file),\n   486→    )\n   487→\n   488→    try:\n   489→        with open(latest_file) as f:\n   490→            data = json.load(f)\n   491→            # Extract just the fingerprint portion\n   492→            fingerprint_data = data.get(\"fingerprint\", data)\n   493→            return ScoringFingerprint.model_validate(fingerprint_data)\n   494→    except Exception as e:\n   495→        logger.error(\n   496→            \"fingerprint.baseline_load_error\",\n   497→            file=str(latest_file),\n   498→            error=str(e),\n   499→        )\n   500→        return None\n   501→\n   502→\n   503→def save_baseline(\n   504→    baselines_dir: str,\n   505→    fingerprint: ScoringFingerprint,\n   506→) -> str:\n   507→    \"\"\"\n   508→    Save a fingerprint as a baseline (for baseline acceptance workflow).\n   509→\n   510→    Creates a file at:\n   511→        synthetics/fixtures/baselines/<candidate_id>__<run_id>.json\n   512→\n   513→    Note: This function writes the file but does NOT commit it.\n   514→    Baseline acceptance requires explicit commit via:\n   515→        mycelium synthetics baseline accept <run_id>\n   516→\n   517→    Args:\n   518→        baselines_dir: Path to synthetics/fixtures/baselines/\n   519→        fingerprint: ScoringFingerprint to save\n   520→\n   521→    Returns:\n   522→        Path to the saved baseline file\n   523→    \"\"\"\n   524→    import json\n   525→    from pathlib import Path\n   526→\n   527→    baselines_path = Path(baselines_dir)\n   528→    baselines_path.mkdir(parents=True, exist_ok=True)\n   529→\n   530→    filename = f\"{fingerprint.candidate_id}__{fingerprint.run_id}.json\"\n   531→    filepath = baselines_path / filename\n   532→\n   533→    baseline_record = {\n   534→        \"candidate_id\": fingerprint.candidate_id,\n   535→        \"run_id\": fingerprint.run_id,\n   536→        \"accepted_at\": datetime.now(timezone.utc).isoformat(),\n   537→        \"fingerprint\": fingerprint.model_dump(),\n   538→    }\n   539→\n   540→    with open(filepath, \"w\") as f:\n   541→        json.dump(baseline_record, f, indent=2)\n   542→\n   543→    logger.info(\n   544→        \"fingerprint.baseline_saved\",\n   545→        candidate_id=fingerprint.candidate_id,\n   546→        run_id=fingerprint.run_id,\n   547→        file=str(filepath),\n   548→    )\n   549→\n   550→    return str(filepath)\n   551→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"7d647432-976a-467b-a023-6b583c162bc9","uuid":"0460cc7c-aaf5-40da-a877-419bc324b2d1","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/synthetics/fingerprint.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nFingerprint module — produces stable JSON fingerprints for drift detection.\n\nComputes deterministic fingerprints from scoring results that can be compared\nacross runs. The fingerprint captures both exact-match fields (ordering, IDs)\nand tolerance-match fields (scores with bounded variance).\n\nStability guarantees:\n    1. Arrays sorted by deterministic keys (job_id for top_picks)\n    2. Floats rounded to 4 decimal places to avoid IEEE precision drift\n    3. Timestamps and run_ids excluded from comparison\n    4. First 5 top_picks ordering captured as exact-match field\n\nContract: NUTRIENTS.md §I.2-I.5, HYPHA-SYNTHETICS-SCORING.md\nOwner: synthetics-scoring-agent.fingerprint\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import datetime, timezone\nfrom typing import Optional\n\nimport structlog\nfrom pydantic import BaseModel, Field\n\nlogger = structlog.get_logger(__name__)\n\n\n# ─── Contract Fields (from NUTRIENTS.md §I.2) ─────────────────────────────────\n\n\nclass ToleranceSpec(BaseModel):\n    \"\"\"Tolerance specification for a numeric field.\"\"\"\n\n    tolerance: float = Field(description=\"Allowed variance as ratio (0.05 = ±5%)\")\n\n\n# Default tolerance thresholds from NUTRIENTS.md §I.2\nTOLERANCE_THRESHOLDS = {\n    \"technical_match\": ToleranceSpec(tolerance=0.05),\n    \"level_match\": ToleranceSpec(tolerance=0.05),\n    \"culture_match\": ToleranceSpec(tolerance=0.05),\n    \"industry_match\": ToleranceSpec(tolerance=0.05),\n    \"growth_potential\": ToleranceSpec(tolerance=0.05),\n    \"compensation_match\": ToleranceSpec(tolerance=0.05),\n    \"composite_score\": ToleranceSpec(tolerance=0.03),\n    \"total_jobs_discovered\": ToleranceSpec(tolerance=0.10),\n}\n\n\n# ─── Top Pick Fingerprint ─────────────────────────────────────────────────────\n\n\nclass TopPickFingerprint(BaseModel):\n    \"\"\"\n    Fingerprint for a single top pick in the digest.\n\n    Captures the exact-match fields: job_id, source, url, position.\n    \"\"\"\n\n    job_id: str = Field(description=\"Deterministic job ID (synthetic JD UUID)\")\n    source: str = Field(description=\"Job source (greenhouse, lever, etc.)\")\n    url: str = Field(description=\"Job URL\")\n    position: int = Field(description=\"Position in top_picks (0-indexed)\")\n\n\n# ─── Tolerance Field Value ────────────────────────────────────────────────────\n\n\nclass ToleranceFieldValue(BaseModel):\n    \"\"\"\n    Value for a tolerance-match field with drift tracking.\n\n    Stores current value, baseline value (if exists), and computed drift %.\n    \"\"\"\n\n    value: float = Field(description=\"Current value (rounded to 4 decimals)\")\n    baseline: Optional[float] = Field(\n        default=None,\n        description=\"Baseline value for comparison (null if no baseline)\",\n    )\n    drift_pct: Optional[float] = Field(\n        default=None,\n        description=\"Drift percentage from baseline (null if no baseline)\",\n    )\n\n\n# ─── Exact Fields Container ───────────────────────────────────────────────────\n\n\nclass ExactFields(BaseModel):\n    \"\"\"\n    Container for exact-match fields in the fingerprint.\n\n    Per NUTRIENTS.md §I.2, these fields MUST be byte-identical between runs.\n    Any difference is a drift violation.\n    \"\"\"\n\n    top_picks: list[TopPickFingerprint] = Field(\n        default_factory=list,\n        description=\"First 5 top picks with position (exact-match)\",\n    )\n\n\n# ─── Tolerance Fields Container ───────────────────────────────────────────────\n\n\nclass ToleranceFields(BaseModel):\n    \"\"\"\n    Container for tolerance-match fields in the fingerprint.\n\n    Per NUTRIENTS.md §I.2, these fields allow bounded variance (±N%).\n    Exceeding the tolerance is a drift violation.\n    \"\"\"\n\n    technical_match: ToleranceFieldValue\n    level_match: ToleranceFieldValue\n    culture_match: ToleranceFieldValue\n    industry_match: ToleranceFieldValue\n    growth_potential: ToleranceFieldValue\n    compensation_match: ToleranceFieldValue\n    composite_score: ToleranceFieldValue\n    total_jobs_discovered: ToleranceFieldValue\n\n\n# ─── Scoring Fingerprint ──────────────────────────────────────────────────────\n\n\nclass ScoringFingerprint(BaseModel):\n    \"\"\"\n    Stable fingerprint for a candidate's scoring results.\n\n    This is the unit of comparison for drift detection. Contains both\n    exact-match fields (must be byte-identical) and tolerance-match\n    fields (allow bounded variance).\n\n    Per HYPHA-SYNTHETICS-SCORING.md, fingerprints must be byte-stable\n    across runs given the same inputs.\n\n    Contract: NUTRIENTS.md §I.9 (ScoringFingerprint)\n    \"\"\"\n\n    candidate_id: str = Field(description=\"Synthetic candidate UUID\")\n    run_id: str = Field(description=\"UUID of the run that produced this fingerprint\")\n    computed_at: str = Field(description=\"ISO-8601 timestamp of computation\")\n    exact_fields: ExactFields = Field(\n        default_factory=ExactFields,\n        description=\"Fields that must be byte-identical\",\n    )\n    tolerance_fields: ToleranceFields = Field(\n        description=\"Fields that allow bounded variance\",\n    )\n\n\n# ─── Fingerprint Contract ─────────────────────────────────────────────────────\n\n\nclass FingerprintContract(BaseModel):\n    \"\"\"\n    Contract defining which fields are exact-match vs tolerance-match.\n\n    Used by compute_fingerprint to determine how to extract and normalize\n    values from scoring results.\n    \"\"\"\n\n    exact_fields: list[str] = Field(\n        default_factory=lambda: [\n            \"digest.top_picks[0..4].job.id\",\n            \"digest.top_picks[0..4].job.source\",\n            \"digest.top_picks[0..4].job.url\",\n            \"digest.top_picks[0..4].ordering\",\n        ],\n        description=\"Fields requiring byte-identical match\",\n    )\n\n    tolerance_fields: dict[str, float] = Field(\n        default_factory=lambda: {\n            \"score.technical_match\": 0.05,\n            \"score.level_match\": 0.05,\n            \"score.culture_match\": 0.05,\n            \"score.industry_match\": 0.05,\n            \"score.growth_potential\": 0.05,\n            \"score.compensation_match\": 0.05,\n            \"composite_score\": 0.03,\n            \"total_jobs_discovered\": 0.10,\n        },\n        description=\"Field -> tolerance (as ratio)\",\n    )\n\n    excluded_fields: list[str] = Field(\n        default_factory=lambda: [\n            \"created_at\",\n            \"updated_at\",\n            \"run_id\",\n            \"crawl_run.duration_seconds\",\n            \"crawl_run.started_at\",\n            \"crawl_run.completed_at\",\n            \"non_synthetic_uuids\",\n        ],\n        description=\"Fields excluded from all comparisons\",\n    )\n\n\n# ─── Fingerprint Computation ──────────────────────────────────────────────────\n\n\ndef compute_fingerprint(\n    candidate_scoring_result: dict,\n    contract: Optional[FingerprintContract] = None,\n    baseline: Optional[ScoringFingerprint] = None,\n) -> ScoringFingerprint:\n    \"\"\"\n    Compute a stable fingerprint from scoring results.\n\n    Takes the raw scoring output from ScoringSyntheticRunner and produces\n    a deterministic fingerprint suitable for drift comparison.\n\n    Stability guarantees:\n        1. Top picks sorted by job_id before position assignment\n        2. All floats rounded to 4 decimal places\n        3. Timestamps excluded (only computed_at for reference)\n        4. Only first 5 top picks captured\n\n    Args:\n        candidate_scoring_result: Dict from CandidateScoringResult.model_dump()\n            Expected keys: candidate_id, scored_results, cache_stats\n        contract: Optional FingerprintContract defining comparison rules\n            Defaults to standard contract from NUTRIENTS.md §I.2\n        baseline: Optional baseline fingerprint for drift calculation\n\n    Returns:\n        ScoringFingerprint with exact and tolerance fields populated\n\n    Example:\n        >>> result = await runner.run_suite()\n        >>> for candidate in result[\"candidates\"]:\n        ...     fp = compute_fingerprint(candidate)\n        ...     print(fp.candidate_id, fp.tolerance_fields.composite_score.value)\n    \"\"\"\n    if contract is None:\n        contract = FingerprintContract()\n\n    candidate_id = candidate_scoring_result.get(\"candidate_id\", \"unknown\")\n    scored_results = candidate_scoring_result.get(\"scored_results\", [])\n\n    logger.debug(\n        \"fingerprint.computing\",\n        candidate_id=candidate_id,\n        scored_results_count=len(scored_results),\n    )\n\n    # Extract and sort scored results for deterministic ordering\n    # Sort by jd_filename for reproducibility\n    sorted_results = sorted(\n        [r for r in scored_results if r.get(\"scored_job\") is not None],\n        key=lambda r: r.get(\"jd_filename\", \"\"),\n    )\n\n    # Compute exact fields: first 5 top picks by composite score\n    top_results = sorted(\n        sorted_results,\n        key=lambda r: r.get(\"scored_job\", {}).get(\"composite_score\", 0),\n        reverse=True,\n    )[:5]\n\n    top_picks: list[TopPickFingerprint] = []\n    for position, result in enumerate(top_results):\n        scored_job = result.get(\"scored_job\", {})\n        top_picks.append(\n            TopPickFingerprint(\n                job_id=str(scored_job.get(\"discovered_job_id\", \"\")),\n                source=str(result.get(\"jd_filename\", \"\").split(\"-\")[0]),  # Extract source prefix\n                url=str(scored_job.get(\"url\", \"\")),\n                position=position,\n            )\n        )\n\n    exact_fields = ExactFields(top_picks=top_picks)\n\n    # Compute tolerance fields: aggregate score dimensions\n    tolerance_fields = _compute_tolerance_fields(\n        scored_results,\n        baseline,\n    )\n\n    # Generate deterministic run_id from candidate_id + computed_at\n    computed_at = datetime.now(timezone.utc).isoformat()\n\n    fingerprint = ScoringFingerprint(\n        candidate_id=candidate_id,\n        run_id=candidate_scoring_result.get(\"run_id\", \"unknown\"),\n        computed_at=computed_at,\n        exact_fields=exact_fields,\n        tolerance_fields=tolerance_fields,\n    )\n\n    logger.info(\n        \"fingerprint.computed\",\n        candidate_id=candidate_id,\n        top_picks_count=len(top_picks),\n        composite_score=tolerance_fields.composite_score.value,\n    )\n\n    return fingerprint\n\n\ndef _compute_tolerance_fields(\n    scored_results: list[dict],\n    baseline: Optional[ScoringFingerprint],\n) -> ToleranceFields:\n    \"\"\"\n    Compute tolerance field values from scored results.\n\n    Aggregates score dimensions across all scored jobs and computes\n    drift percentage if a baseline is provided.\n\n    Args:\n        scored_results: List of scoring result dicts\n        baseline: Optional baseline fingerprint for drift calculation\n\n    Returns:\n        ToleranceFields with aggregated values and drift percentages\n    \"\"\"\n    # Collect all score dimensions\n    tech_scores: list[int] = []\n    level_scores: list[int] = []\n    culture_scores: list[int] = []\n    industry_scores: list[int] = []\n    growth_scores: list[int] = []\n    comp_scores: list[int] = []\n    composite_scores: list[int] = []\n\n    for result in scored_results:\n        scored_job = result.get(\"scored_job\")\n        if scored_job is None:\n            continue\n\n        breakdown = scored_job.get(\"score_breakdown\", {})\n        tech_scores.append(breakdown.get(\"technical_match\", 0))\n        level_scores.append(breakdown.get(\"level_match\", 0))\n        culture_scores.append(breakdown.get(\"culture_match\", 0))\n        industry_scores.append(breakdown.get(\"industry_match\", 0))\n        growth_scores.append(breakdown.get(\"growth_potential\", 0))\n        comp_scores.append(breakdown.get(\"compensation_match\", 0))\n        composite_scores.append(scored_job.get(\"composite_score\", 0))\n\n    # Compute averages (rounded to 4 decimals for stability)\n    def avg(scores: list[int]) -> float:\n        if not scores:\n            return 0.0\n        return round(sum(scores) / len(scores), 4)\n\n    tech_avg = avg(tech_scores)\n    level_avg = avg(level_scores)\n    culture_avg = avg(culture_scores)\n    industry_avg = avg(industry_scores)\n    growth_avg = avg(growth_scores)\n    comp_avg = avg(comp_scores)\n    composite_avg = avg(composite_scores)\n    total_discovered = float(len(scored_results))\n\n    # Helper to compute drift percentage\n    def drift_pct(current: float, baseline_val: Optional[float]) -> Optional[float]:\n        if baseline_val is None or baseline_val == 0:\n            return None\n        return round((current - baseline_val) / baseline_val, 4)\n\n    # Extract baseline values if present\n    baseline_tech = None\n    baseline_level = None\n    baseline_culture = None\n    baseline_industry = None\n    baseline_growth = None\n    baseline_comp = None\n    baseline_composite = None\n    baseline_discovered = None\n\n    if baseline is not None:\n        baseline_tech = baseline.tolerance_fields.technical_match.value\n        baseline_level = baseline.tolerance_fields.level_match.value\n        baseline_culture = baseline.tolerance_fields.culture_match.value\n        baseline_industry = baseline.tolerance_fields.industry_match.value\n        baseline_growth = baseline.tolerance_fields.growth_potential.value\n        baseline_comp = baseline.tolerance_fields.compensation_match.value\n        baseline_composite = baseline.tolerance_fields.composite_score.value\n        baseline_discovered = baseline.tolerance_fields.total_jobs_discovered.value\n\n    return ToleranceFields(\n        technical_match=ToleranceFieldValue(\n            value=tech_avg,\n            baseline=baseline_tech,\n            drift_pct=drift_pct(tech_avg, baseline_tech),\n        ),\n        level_match=ToleranceFieldValue(\n            value=level_avg,\n            baseline=baseline_level,\n            drift_pct=drift_pct(level_avg, baseline_level),\n        ),\n        culture_match=ToleranceFieldValue(\n            value=culture_avg,\n            baseline=baseline_culture,\n            drift_pct=drift_pct(culture_avg, baseline_culture),\n        ),\n        industry_match=ToleranceFieldValue(\n            value=industry_avg,\n            baseline=baseline_industry,\n            drift_pct=drift_pct(industry_avg, baseline_industry),\n        ),\n        growth_potential=ToleranceFieldValue(\n            value=growth_avg,\n            baseline=baseline_growth,\n            drift_pct=drift_pct(growth_avg, baseline_growth),\n        ),\n        compensation_match=ToleranceFieldValue(\n            value=comp_avg,\n            baseline=baseline_comp,\n            drift_pct=drift_pct(comp_avg, baseline_comp),\n        ),\n        composite_score=ToleranceFieldValue(\n            value=composite_avg,\n            baseline=baseline_composite,\n            drift_pct=drift_pct(composite_avg, baseline_composite),\n        ),\n        total_jobs_discovered=ToleranceFieldValue(\n            value=total_discovered,\n            baseline=baseline_discovered,\n            drift_pct=drift_pct(total_discovered, baseline_discovered),\n        ),\n    )\n\n\n# ─── Baseline Loading ─────────────────────────────────────────────────────────\n\n\ndef load_baseline(\n    baselines_dir: str,\n    candidate_id: str,\n) -> Optional[ScoringFingerprint]:\n    \"\"\"\n    Load the latest accepted baseline for a candidate.\n\n    Baselines are stored at:\n        synthetics/fixtures/baselines/<candidate_id>__<run_id>.json\n\n    Only committed baselines are considered valid. The latest by\n    accepted_at timestamp is returned.\n\n    Args:\n        baselines_dir: Path to synthetics/fixtures/baselines/\n        candidate_id: Synthetic candidate UUID\n\n    Returns:\n        ScoringFingerprint from baseline, or None if no baseline exists\n    \"\"\"\n    import json\n    from pathlib import Path\n\n    baselines_path = Path(baselines_dir)\n    if not baselines_path.exists():\n        logger.debug(\"fingerprint.baseline_dir_not_found\", path=baselines_dir)\n        return None\n\n    # Find all baselines for this candidate\n    pattern = f\"{candidate_id}__*.json\"\n    baseline_files = list(baselines_path.glob(pattern))\n\n    if not baseline_files:\n        logger.debug(\n            \"fingerprint.no_baseline\",\n            candidate_id=candidate_id,\n            pattern=pattern,\n        )\n        return None\n\n    # Sort by file modification time (latest first)\n    baseline_files.sort(key=lambda f: f.stat().st_mtime, reverse=True)\n    latest_file = baseline_files[0]\n\n    logger.debug(\n        \"fingerprint.loading_baseline\",\n        candidate_id=candidate_id,\n        file=str(latest_file),\n    )\n\n    try:\n        with open(latest_file) as f:\n            data = json.load(f)\n            # Extract just the fingerprint portion\n            fingerprint_data = data.get(\"fingerprint\", data)\n            return ScoringFingerprint.model_validate(fingerprint_data)\n    except Exception as e:\n        logger.error(\n            \"fingerprint.baseline_load_error\",\n            file=str(latest_file),\n            error=str(e),\n        )\n        return None\n\n\ndef save_baseline(\n    baselines_dir: str,\n    fingerprint: ScoringFingerprint,\n) -> str:\n    \"\"\"\n    Save a fingerprint as a baseline (for baseline acceptance workflow).\n\n    Creates a file at:\n        synthetics/fixtures/baselines/<candidate_id>__<run_id>.json\n\n    Note: This function writes the file but does NOT commit it.\n    Baseline acceptance requires explicit commit via:\n        mycelium synthetics baseline accept <run_id>\n\n    Args:\n        baselines_dir: Path to synthetics/fixtures/baselines/\n        fingerprint: ScoringFingerprint to save\n\n    Returns:\n        Path to the saved baseline file\n    \"\"\"\n    import json\n    from pathlib import Path\n\n    baselines_path = Path(baselines_dir)\n    baselines_path.mkdir(parents=True, exist_ok=True)\n\n    filename = f\"{fingerprint.candidate_id}__{fingerprint.run_id}.json\"\n    filepath = baselines_path / filename\n\n    baseline_record = {\n        \"candidate_id\": fingerprint.candidate_id,\n        \"run_id\": fingerprint.run_id,\n        \"accepted_at\": datetime.now(timezone.utc).isoformat(),\n        \"fingerprint\": fingerprint.model_dump(),\n    }\n\n    with open(filepath, \"w\") as f:\n        json.dump(baseline_record, f, indent=2)\n\n    logger.info(\n        \"fingerprint.baseline_saved\",\n        candidate_id=fingerprint.candidate_id,\n        run_id=fingerprint.run_id,\n        file=str(filepath),\n    )\n\n    return str(filepath)\n","numLines":551,"startLine":1,"totalLines":551}}}}
