ent.core.main\n   369→        scope: backend/main.py — FastAPI app factory, router registration, lifespan (db\n   370→          + redis init)\n   371→      - id: api-agent.core.config\n   372→        scope: backend/config.py — Pydantic Settings, env loading, secret resolution\n   373→      - id: api-agent.core.database\n   374→        scope: backend/database.py — async SQLAlchemy engine, session factory, redis\n   375→          client factory, get_db dependency\n   376→      - id: api-agent.routers.discovery\n   377→        scope: backend/api/discovery.py — GET /digest/today, POST /discovery/run, GET\n   378→          /jobs/{id}\n   379→      - id: api-agent.routers.application\n   380→        scope: backend/api/application.py — POST /applications, GET /applications, POST\n   381→          /applications/{id}/approve, POST /applications/{id}/reject\n   382→      - id: api-agent.routers.review\n   383→        scope: backend/api/review.py — GET /review/queue, POST /review/{id}/decision\n   384→      - id: api-agent.onboarding.resume-profile\n   385→        scope: backend/api/onboarding.py — POST /onboarding/resume upload + profile\n   386→          build + initial archetype expansion\n   387→      - id: api-agent.health.endpoint\n   388→        scope: backend/api/health.py — GET /health, GET /readiness with db + redis\n   389→          probes\n   390→  - id: frontend-agent\n   391→    scope: React 19 + Vite 8 frontend, UI primitives, routing, auth context, pages\n   392→    branch: feat/frontend-agent\n   393→    blocked_by:\n   394→      - design-agent\n   395→      - api-agent\n   396→    blocks:\n   397→      - infra-agent\n   398→      - api-client-agent\n   399→    capabilities:\n   400→      - react\n   401→      - vite\n   402→      - tailwind\n   403→      - lucide-react\n   404→      - react-router-dom\n   405→    sub_agents:\n   406→      - id: frontend-agent.primitives.button\n   407→        scope: frontend/src/components/ui/Button.tsx — variant + size + loading state\n   408→      - id: frontend-agent.primitives.input\n   409→        scope: frontend/src/components/ui/Input.tsx — labeled, error state, helper text\n   410→      - id: frontend-agent.primitives.card\n   411→        scope: frontend/src/components/ui/Card.tsx — header/body/footer composition\n   412→      - id: frontend-agent.primitives.dialog\n   413→        scope: frontend/src/components/ui/Dialog.tsx — accessible modal with backdrop +\n   414→          Escape close\n   415→      - id: frontend-agent.layout.sidebar\n   416→        scope: frontend/src/layout/Sidebar.tsx — nav links, active state, brand seal\n   417→      - id: frontend-agent.layout.dashboard\n   418→        scope: frontend/src/layout/DashboardLayout.tsx — sidebar + topbar + content slot\n   419→          + auth guard\n   420→      - id: frontend-agent.auth-flow.login\n   421→        scope: frontend/src/pages/Login.tsx — magic-link request form\n   422→      - id: frontend-agent.auth-flow.verify\n   423→        scope: frontend/src/pages/Verify.tsx — token-in-url handler, JWT storage,\n   424→          redirect\n   425→      - id: frontend-agent.auth-flow.context\n   426→        scope: frontend/src/auth/AuthContext.tsx — provider, useAuth hook, refresh logic\n   427→      - id: frontend-agent.onboarding.wizard\n   428→        scope: frontend/src/pages/Onboarding.tsx — resume upload → profile preview →\n   429→          confirmation\n   430→      - id: frontend-agent.dashboard.overview\n   431→        scope: frontend/src/pages/Overview.tsx — today's digest, hot picks, agent\n   432→          activity\n   433→      - id: frontend-agent.dashboard.pipeline\n   434→        scope: frontend/src/pages/Pipeline.tsx — kanban of applications across stages\n   435→      - id: frontend-agent.dashboard.analytics\n   436→        scope: frontend/src/pages/Analytics.tsx — funnel, conversion, source breakdown\n   437→      - id: frontend-agent.review-queue.list\n   438→        scope: frontend/src/pages/ReviewQueue.tsx — list of pending approvals with quick\n   439→          actions\n   440→      - id: frontend-agent.review-queue.detail\n   441→        scope: frontend/src/pages/ReviewDetail.tsx — full artifact panes (JD, tailored\n   442→          resume, outreach, contact) + approve/reject\n   443→  - id: discover-agent\n   444→    scope: \"Discovery engine: identity profiler, archetype generator, multi-source\n   445→      crawler, relevance scorer, digest builder, pub/sub gap closure\"\n   446→    branch: feat/discover-agent\n   447→    blocked_by:\n   448→      - data-agent\n   449→      - obs-agent\n   450→    blocks:\n   451→      - apply-agent\n   452→      - scheduler-agent\n   453→      - api-streaming-agent\n   454→    capabilities:\n   455→      - anthropic-sdk\n   456→      - httpx\n   457→      - playwright\n   458→      - redis\n   459→      - redis-pubsub\n   460→    sub_agents:\n   461→      - id: discover-agent.identity.profiler\n   462→        scope: backend/agents/discovery/identity_profiler.py — Claude-driven\n   463→          IdentityProfile builder + 24h Redis cache\n   464→      - id: discover-agent.archetype.generator\n   465→        scope: backend/agents/discovery/archetype_generator.py — IdentityProfile →\n   466→          SearchManifest expansion with exclusions\n   467→      - id: discover-agent.crawler.greenhouse\n   468→        scope: backend/agents/discovery/crawler_agent.py GreenhouseAdapter — httpx\n   469→          async, boards.greenhouse.io/{slug}.json\n   470→      - id: discover-agent.crawler.lever\n   471→        scope: backend/agents/discovery/crawler_agent.py LeverAdapter — httpx async,\n   472→          api.lever.co/v0/postings/{slug}\n   473→      - id: discover-agent.crawler.ashby\n   474→        scope: backend/agents/discovery/crawler_agent.py AshbyAdapter — httpx async,\n   475→          api.ashbyhq.com/posting-api/job-board/{slug}\n   476→      - id: discover-agent.crawler.workday\n   477→        scope: backend/agents/discovery/crawler_agent.py WorkdayAdapter — playwright\n   478→          async, {tenant}.wd1.myworkdayjobs.com/{board}\n   479→      - id: discover-agent.scorer.relevance\n   480→        scope: backend/agents/discovery/relevance_scorer.py — 6-dimension weighted\n   481→          scoring + is_hot threshold\n   482→      - id: discover-agent.digest.builder\n   483→        scope: backend/agents/discovery/digest_builder.py — compile DailyDigest from\n   484→          scored jobs\n   485→      - id: discover-agent.orchestrator\n   486→        scope: backend/agents/discovery/orchestrator.py — DiscoveryOrchestrator.run\n   487→          wires all 5 sub-agents + CrawlRun state + agent.status.discovery\n   488→          pub/sub\n   489→      - id: discover-agent.pubsub\n   490→        scope: backend/agents/discovery/orchestrator.py _publish_status helper — emit\n   491→          events to agent.status.discovery channel per pattern from\n   492→          application/orchestrator.py\n   493→  - id: infra-agent\n   494→    scope: Docker, docker-compose, AWS ECS Fargate, Digital Dash pipeline, deploy\n   495→      scripts, Celery containers\n   496→    branch: feat/infra-agent\n   497→    blocked_by:\n   498→      - api-agent\n   499→      - frontend-agent\n   500→      - scheduler-agent\n   501→    blocks: []\n   502→    capabilities:\n   503→      - docker\n   504→      - ecs\n   505→      - ecr\n   506→      - alb\n   507→      - digital-dash\n   508→      - celery\n   509→    sub_agents:\n   510→      - id: infra-agent.docker.backend\n   511→        scope: backend/Dockerfile — python:3.12-slim, requirements caching, non-root\n   512→          user\n   513→        artifact: deploy/Dockerfile.backend\n   514→      - id: infra-agent.docker.frontend\n   515→        scope: frontend/Dockerfile — node build stage + nginx serve stage\n   516→        artifact: deploy/Dockerfile.frontend\n   517→      - id: infra-agent.docker.compose\n   518→        scope: docker-compose.yml — postgres + redis + backend + frontend +\n   519→          celery-worker + celery-beat with healthchecks\n   520→        artifact: docker-compose.yml\n   521→      - id: infra-agent.ecs.task-defs\n   522→        scope: deploy/ecs-task-def-backend.json + ecs-task-def-frontend.json +\n   523→          ecs-task-def-celery-worker.json + ecs-task-def-celery-beat.json\n   524→        artifact: deploy/ecs-task-def-*.json\n   525→      - id: infra-agent.ecs.bootstrap\n   526→        scope: deploy/setup-aws.sh — one-time VPC, ALB, ECR, ECS cluster, RDS,\n   527→          ElastiCache + Celery IAM role\n   528→        artifact: deploy/setup-aws.sh\n   529→      - id: infra-agent.pipeline.digital-dash\n   530→        scope: digital-dash-pipeline.yml — build, test, push, deploy stages with\n   531→          approval gate + deploy-celery stage\n   532→        artifact: .github/workflows/digital-dash-pipeline.yml\n   533→  - id: scheduler-agent\n   534→    scope: \"Celery beat wiring: app factory, daily discovery task, beat schedule,\n   535→      retry policy\"\n   536→    branch: feat/scheduler-agent\n   537→    blocked_by:\n   538→      - data-agent\n   539→      - discover-agent\n   540→    blocks:\n   541→      - infra-agent\n   542→    capabilities:\n   543→      - celery\n   544→      - redis\n   545→      - asyncio\n   546→    sub_agents:\n   547→      - id: scheduler-agent.app\n   548→        scope: backend/scheduler/celery_app.py — Celery app factory reading broker URL\n   549→          from settings.redis_url\n   550→      - id: scheduler-agent.tasks\n   551→        scope: backend/scheduler/tasks.py — daily_discovery_task(candidate_id) wrapping\n   552→          async orchestrator.run\n   553→      - id: scheduler-agent.beat\n   554→        scope: backend/scheduler/beat.py — Beat schedule 07:00 America/New_York,\n   555→          iterates active candidates\n   556→      - id: scheduler-agent.retry\n   557→        scope: backend/scheduler/tasks.py — exponential backoff 60s/300s/900s,\n   558→          dead-letter to crawl_runs.error_log\n   559→  - id: api-streaming-agent\n   560→    scope: SSE event stream endpoint for real-time agent status streaming\n   561→    branch: feat/api-streaming-agent\n   562→    blocked_by:\n   563→      - api-agent\n   564→      - auth-agent\n   565→      - obs-agent\n   566→      - discover-agent\n   567→    blocks:\n   568→      - api-client-agent\n   569→    capabilities:\n   570→      - fastapi\n   571→      - sse\n   572→      - redis-pubsub\n   573→    sub_agents:\n   574→      - id: api-streaming-agent.events\n   575→        scope: backend/api/events.py — GET /events/stream?channel=... SSE endpoint\n   576→      - id: api-streaming-agent.subscriber\n   577→        scope: backend/api/events.py — Redis pub/sub subscriber with channel allowlist\n   578→      - id: api-streaming-agent.heartbeat\n   579→        scope: backend/api/events.py — :ping every 15s for connection loss detection\n   580→      - id: api-streaming-agent.backpressure\n   581→        scope: backend/api/events.py — drop >100 messages behind, emit slow_client event\n   582→  - id: api-client-agent\n   583→    scope: \"Frontend API client wiring: fetch wrapper, auth token injection, page\n   584→      data integration\"\n   585→    branch: feat/api-client-agent\n   586→    blocked_by:\n   587→      - api-agent\n   588→      - frontend-agent\n   589→      - api-streaming-agent\n   590→    blocks:\n   591→      - tests-agent\n   592→    capabilities:\n   593→      - typescript\n   594→      - fetch\n   595→      - eventsource\n   596→    sub_agents:\n   597→      - id: api-client-agent.client\n   598→        scope: frontend/src/api/client.ts — single apiClient instance, base URL from\n   599→          VITE_API_BASE_URL\n   600→      - id: api-client-agent.auth\n   601→        scope: frontend/src/api/auth.ts — requestMagicLink, verifyToken, refreshSession,\n   602→          JWT in localStorage\n   603→      - id: api-client-agent.discovery\n   604→        scope: frontend/src/api/discovery.ts — getTodayDigest, triggerDiscoveryRun,\n   605→          getJob\n   606→      - id: api-client-agent.applications\n   607→        scope: frontend/src/api/applications.ts — listApplications, approveApplication,\n   608→          rejectApplication\n   609→      - id: api-client-agent.events\n   610→        scope: frontend/src/api/events.ts — subscribeAgentStatus(channel, onMessage) via\n   611→          EventSource\n   612→      - id: api-client-agent.error-handling\n   613→        scope: frontend/src/api/client.ts — 401 → invalidate JWT, redirect to /login,\n   614→          toast\n   615→      - id: api-client-agent.page-wiring\n   616→        scope: Re-wire Overview.tsx, Pipeline.tsx, Analytics.tsx, ReviewQueue.tsx,\n   617→          ReviewDetail.tsx to use apiClient\n   618→  - id: tests-agent\n   619→    scope: pytest and vitest test suites for all iter-4 biomes\n   620→    branch: feat/tests-agent\n   621→    blocked_by:\n   622→      - discover-agent\n   623→      - scheduler-agent\n   624→      - api-streaming-agent\n   625→      - api-client-agent\n   626→    blocks: []\n   627→    capabilities:\n   628→      - pytest\n   629→      - vitest\n   630→      - fakeredis\n   631→    sub_agents:\n   632→      - id: tests-agent.discovery.pubsub\n   633→        scope: tests/discovery/test_orchestrator_pubsub.py — fake Redis, verify 8+ event\n   634→          sequence\n   635→      - id: tests-agent.scheduler.daily\n   636→        scope: tests/scheduler/test_daily_task.py — mock orchestrator, verify crawl_runs\n   637→          creation\n   638→      - id: tests-agent.api.events\n   639→        scope: tests/api/test_events_stream.py — TestClient streaming, verify SSE frames\n   640→          + heartbeat\n   641→      - id: tests-agent.api.review\n   642→        scope: tests/api/test_review_approve.py — full integration approve flow\n   643→      - id: tests-agent.frontend.client\n   644→        scope: frontend/src/api/__tests__/client.test.ts — vitest, mock fetch, 401\n   645→          handling\n   646→  - id: synthetics-fixtures-agent\n   647→    scope: Synthetic candidate fixtures, JD fixtures, baseline scaffolding, seeder\n   648→      for deterministic test data\n   649→    branch: feat/synthetics-fixtures-agent\n   650→    blocked_by: []\n   651→    blocks:\n   652→      - synthetics-scoring-agent\n   653→      - synthetics-crawler-agent\n   654→    capabilities:\n   655→      - pydantic\n   656→      - pyyaml\n   657→      - uuid5\n   658→    sub_agents:\n   659→      - id: synthetics-fixtures-agent.candidates\n   660→        scope: synthetics/fixtures/candidates.yaml — 3 synthetic candidates with full\n   661→          resume text + identity context\n   662→      - id: synthetics-fixtures-agent.jobs\n   663→        scope: synthetics/fixtures/jobs/ — 12 JD markdown files with expected_hot +\n   664→          expected_score_band frontmatter\n   665→      - id: synthetics-fixtures-agent.baselines\n   666→        scope: synthetics/fixtures/baselines/ — gitignored scaffold for baseline\n   667→          fingerprints\n   668→      - id: synthetics-fixtures-agent.seeder\n   669→        scope: synthetics/fixtures/seeder.py — idempotent loader that upserts synthetic\n   670→          candidates into Postgres on backend boot\n   671→  - id: synthetics-scoring-agent\n   672→    scope: Deterministic scoring drift detection via fingerprinting and diffing\n   673→      against accepted baselines\n   674→    branch: feat/synthetics-scoring-agent\n   675→    blocked_by:\n   676→      - synthetics-fixtures-agent\n   677→    blocks: []\n   678→    capabilities:\n   679→      - anthropic-sdk\n   680→      - pydantic\n   681→      - structlog\n   682→    sub_agents:\n   683→      - id: synthetics-scoring-agent.runner\n   684→        scope: backend/synthetics/scoring_runner.py — ScoringSyntheticRunner.run_suite()\n   685→          iterates synthetic candidates × JDs\n   686→      - id: synthetics-scoring-agent.fingerprint\n   687→        scope: backend/synthetics/fingerprint.py — compute_fingerprint(digest, contract)\n   688→          produces stable JSON per candidate\n   689→      - id: synthetics-scoring-agent.diff\n   690→        scope: backend/synthetics/diff.py — diff_against_baseline(fingerprint, baseline,\n   691→          contract) returns DriftReport\n   692→      - id: synthetics-scoring-agent.cli\n   693→        scope: backend/synthetics/cli.py — python -m backend.synthetics run\n   694→          --suite=scoring\n   695→      - id: synthetics-scoring-agent.cache-verification\n   696→        scope: backend/synthetics/scoring_runner.py — verify cache_creation_input_tokens\n   697→          == 0 on subsequent runs\n   698→  - id: synthetics-crawler-agent\n   699→    scope: Upstream health monitoring with state machine alerts for consecutive\n   700→      failures\n   701→    branch: feat/synthetics-crawler-agent\n   702→    blocked_by:\n   703→      - synthetics-fixtures-agent\n   704→    blocks: []\n   705→    capabilities:\n   706→      - httpx\n   707→      - redis-pubsub\n   708→      - structlog\n   709→    sub_agents:\n   710→      - id: synthetics-crawler-agent.runner\n   711→        scope: backend/synthetics/crawler_health.py — CrawlerHealthRunner.run_suite()\n   712→          hits known-good slugs per source\n   713→      - id: synthetics-crawler-agent.schemas\n   714→        scope: backend/synthetics/expected_schema_v1.json — expected top-level shape for\n   715→          Greenhouse/Lever/Ashby\n   716→      - id: synthetics-crawler-agent.state-machine\n   717→        scope: synthetics/state.json — consecutive_failures tracking with 3-strike alert\n   718→          threshold\n   719→      - id: synthetics-crawler-agent.beat-extension\n   720→        scope: backend/synthetics/beat_schedule.py — hourly Celery beat entry for\n   721→          crawler health, registered additively\n   722→merge_order:\n   723→  - data-agent\n   724→  - design-agent\n   725→  - auth-agent\n   726→  - obs-agent\n   727→  - discover-agent\n   728→  - apply-agent\n   729→  - agents-agent\n   730→  - api-agent\n   731→  - scheduler-agent\n   732→  - api-streaming-agent\n   733→  - frontend-agent\n   734→  - api-client-agent\n   735→  - infra-agent\n   736→  - tests-agent\n   737→  - synthetics-fixtures-agent\n   738→  - synthetics-scoring-agent\n   739→  - synthetics-crawler-agent\n   740→timeline:\n   741→  parallel_phases:\n   742→    - hours: 0-1\n   743→      active:\n   744→        - data-agent\n   745→        - design-agent\n   746→      description: Wave 1 — foundations with zero cross-biome deps. Schemas + models +\n   747→        design tokens land first so every downstream biome consumes frozen\n   748→        contracts.\n   749→    - hours: 1-3\n   750→      active:\n   751→        - auth-agent\n   752→        - obs-agent\n   753→      description: Wave 2 — core services depending only on data. Auth + observability\n   754→        wire on top of the schema, both consumed by every engine below.\n   755→    - hours: 3-5\n   756→      active:\n   757→        - discover-agent\n   758→      description: Wave 3a — Discovery engine with pub/sub gap closure. Must publish\n   759→        events on agent.status.discovery channel.\n   760→    - hours: 5-7\n   761→      active:\n   762→        - scheduler-agent\n   763→        - api-streaming-agent\n   764→      description: Wave 3b — Scheduler and streaming in parallel. Scheduler consumes\n   765→        discover-agent, streaming consumes obs-agent.\n   766→    - hours: 7-8\n   767→      active:\n   768→        - apply-agent\n   769→      description: Wave 4 — Application engine, blocked by discover-agent.\n   770→    - hours: 8-9\n   771→      active:\n   772→        - agents-agent\n   773→      description: Wave 5 — AgentManager wrapper over the engines.\n   774→    - hours: 9-11\n   775→      active:\n   776→        - api-agent\n   777→        - frontend-agent\n   778→     