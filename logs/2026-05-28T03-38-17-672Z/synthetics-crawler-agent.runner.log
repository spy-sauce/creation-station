{"t":"2026-05-28T03:45:53.072Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SKSu916pUVYwSVo8KBkS5t","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Scoring Synthetic Runner — iterates synthetic candidates × JD fixtures.\n     6→\n     7→Executes the RelevanceScorer against synthetic candidates with cache-aware\n     8→instrumentation. Tracks cache hit/miss rates from Claude API responses.\n     9→\n    10→The scorer module (RelevanceScorer) is FROZEN. To enforce the cache contract\n    11→(NUTRIENTS.md §I.5), this runner wraps Claude API calls with cache_control\n    12→headers by providing a wrapper client that intercepts and augments requests.\n    13→\n    14→Contract: NUTRIENTS.md §I.2-I.5, HYPHA-SYNTHETICS-SCORING.md\n    15→Owner: synthetics-scoring-agent.runner\n    16→\"\"\"\n    17→\n    18→from __future__ import annotations\n    19→\n    20→import uuid\n    21→from dataclasses import dataclass, field\n    22→from datetime import datetime, timezone\n    23→from pathlib import Path\n    24→from typing import Optional\n    25→\n    26→import redis.asyncio as aioredis\n    27→import structlog\n    28→import yaml\n    29→from anthropic import AsyncAnthropic\n    30→from pydantic import BaseModel, Field\n    31→from sqlalchemy import text\n    32→from sqlalchemy.ext.asyncio import AsyncSession\n    33→\n    34→from backend.agents.discovery.identity_profiler import IdentityProfiler\n    35→from backend.agents.discovery.relevance_scorer import RelevanceScorer\n    36→from backend.agents.discovery.schemas import (\n    37→    CandidateSchema,\n    38→    DiscoveredJobSchema,\n    39→    IdentityProfileSchema,\n    40→    ScoredJobSchema,\n    41→)\n    42→\n    43→logger = structlog.get_logger(__name__)\n    44→\n    45→\n    46→# ─── Cache Statistics ────────────────────────────────────────────────────────\n    47→\n    48→\n    49→@dataclass\n    50→class CacheStats:\n    51→    \"\"\"Tracks cache hit/miss statistics for Claude API calls.\"\"\"\n    52→\n    53→    total_calls: int = 0\n    54→    cache_creation_tokens: int = 0\n    55→    cache_read_tokens: int = 0\n    56→\n    57→    @property\n    58→    def cache_hits(self) -> int:\n    59→        \"\"\"Number of calls that hit the cache.\"\"\"\n    60→        # A cache hit is when cache_read_input_tokens > 0\n    61→        return self._hit_count\n    62→\n    63→    @property\n    64→    def cache_misses(self) -> int:\n    65→        \"\"\"Number of calls that missed the cache.\"\"\"\n    66→        return self.total_calls - self._hit_count\n    67→\n    68→    @property\n    69→    def cache_hit_rate(self) -> float:\n    70→        \"\"\"Cache hit rate as a ratio 0.0-1.0.\"\"\"\n    71→        if self.total_calls == 0:\n    72→            return 0.0\n    73→        return self._hit_count / self.total_calls\n    74→\n    75→    _hit_count: int = field(default=0, init=False)\n    76→\n    77→    def record_call(\n    78→        self,\n    79→        cache_creation_input_tokens: int,\n    80→        cache_read_input_tokens: int,\n    81→    ) -> None:\n    82→        \"\"\"Record a Claude API call's cache statistics.\"\"\"\n    83→        self.total_calls += 1\n    84→        self.cache_creation_tokens += cache_creation_input_tokens\n    85→        self.cache_read_tokens += cache_read_input_tokens\n    86→        if cache_read_input_tokens > 0:\n    87→            self._hit_count += 1\n    88→\n    89→\n    90→# ─── JD Fixture Loading ──────────────────────────────────────────────────────\n    91→\n    92→\n    93→class JDFixture(BaseModel):\n    94→    \"\"\"A JD fixture loaded from synthetics/fixtures/jobs/.\"\"\"\n    95→\n    96→    filename: str\n    97→    target_candidate: str\n    98→    expected_hot: bool\n    99→    expected_score_band: str  # low | mid | high\n   100→    source: str\n   101→    title: str\n   102→    company: str\n   103→    location: Optional[str] = None\n   104→    description: str\n   105→    url: str = \"\"\n   106→\n   107→\n   108→def load_jd_fixtures(fixtures_dir: Path) -> list[JDFixture]:\n   109→    \"\"\"\n   110→    Load all JD fixtures from the jobs directory.\n   111→\n   112→    Each fixture is a markdown file with YAML frontmatter.\n   113→\n   114→    Args:\n   115→        fixtures_dir: Path to synthetics/fixtures/jobs/\n   116→\n   117→    Returns:\n   118→        List of JDFixture objects\n   119→    \"\"\"\n   120→    fixtures: list[JDFixture] = []\n   121→    jobs_dir = fixtures_dir / \"jobs\"\n   122→\n   123→    if not jobs_dir.exists():\n   124→        logger.warning(\"jd_fixtures.dir_not_found\", path=str(jobs_dir))\n   125→        return fixtures\n   126→\n   127→    for md_file in jobs_dir.glob(\"*.md\"):\n   128→        try:\n   129→            fixture = _parse_jd_fixture(md_file)\n   130→            fixtures.append(fixture)\n   131→            logger.debug(\n   132→                \"jd_fixtures.loaded\",\n   133→                filename=md_file.name,\n   134→                target=fixture.target_candidate,\n   135→            )\n   136→        except Exception as e:\n   137→            logger.error(\n   138→                \"jd_fixtures.parse_error\",\n   139→                filename=md_file.name,\n   140→                error=str(e),\n   141→            )\n   142→\n   143→    logger.info(\"jd_fixtures.loaded_all\", count=len(fixtures))\n   144→    return fixtures\n   145→\n   146→\n   147→def _parse_jd_fixture(path: Path) -> JDFixture:\n   148→    \"\"\"Parse a single JD fixture markdown file with YAML frontmatter.\"\"\"\n   149→    content = path.read_text()\n   150→\n   151→    # Split frontmatter from body\n   152→    if not content.startswith(\"---\"):\n   153→        raise ValueError(f\"No YAML frontmatter in {path.name}\")\n   154→\n   155→    parts = content.split(\"---\", 2)\n   156→    if len(parts) < 3:\n   157→        raise ValueError(f\"Invalid frontmatter format in {path.name}\")\n   158→\n   159→    frontmatter = yaml.safe_load(parts[1])\n   160→    body = parts[2].strip()\n   161→\n   162→    return JDFixture(\n   163→        filename=path.name,\n   164→        target_candidate=frontmatter[\"target_candidate\"],\n   165→        expected_hot=frontmatter[\"expected_hot\"],\n   166→        expected_score_band=frontmatter[\"expected_score_band\"],\n   167→        source=frontmatter.get(\"source\", \"greenhouse\"),\n   168→        title=frontmatter.get(\"title\", \"Unknown Title\"),\n   169→        company=frontmatter.get(\"company\", \"Unknown Company\"),\n   170→        location=frontmatter.get(\"location\"),\n   171→        description=body,\n   172→        url=frontmatter.get(\"url\", f\"https://example.com/jobs/{path.stem}\"),\n   173→    )\n   174→\n   175→\n   176→# ─── Synthetic Candidate Loading ─────────────────────────────────────────────\n   177→\n   178→\n   179→async def load_synthetic_candidates(\n   180→    session: AsyncSession,\n   181→) -> list[CandidateSchema]:\n   182→    \"\"\"\n   183→    Load synthetic candidates from the database.\n   184→\n   185→    Synthetic candidates are identified by UUIDv5 markers matching\n   186→    the pattern: id::text LIKE '00000000-%'\n   187→\n   188→    Contract: NUTRIENTS.md §I.1\n   189→\n   190→    Args:\n   191→        session: Async SQLAlchemy session\n   192→\n   193→    Returns:\n   194→        List of CandidateSchema for synthetic candidates\n   195→    \"\"\"\n   196→    # Query candidates with synthetic UUID pattern\n   197→    result = await session.execute(\n   198→        text(\"\"\"\n   199→            SELECT\n   200→                id, name, email, resume_text, linkedin_url, github_url,\n   201→                personal_context, target_locations, remote_preference,\n   202→                min_compensation, excluded_companies, excluded_industries,\n   203→                created_at, updated_at\n   204→            FROM candidates\n   205→            WHERE id::text LIKE '00000000-%'\n   206→            ORDER BY name\n   207→        \"\"\")\n   208→    )\n   209→\n   210→    candidates: list[CandidateSchema] = []\n   211→    for row in result.fetchall():\n   212→        candidates.append(\n   213→            CandidateSchema(\n   214→                id=row.id,\n   215→                name=row.name,\n   216→                email=row.email,\n   217→                resume_text=row.resume_text or \"\",\n   218→                linkedin_url=row.linkedin_url,\n   219→                github_url=row.github_url,\n   220→                personal_context=row.personal_context,\n   221→                target_locations=list(row.target_locations or []),\n   222→                remote_preference=row.remote_preference or \"flexible\",\n   223→                min_compensation=row.min_compensation,\n   224→                excluded_companies=list(row.excluded_companies or []),\n   225→                excluded_industries=list(row.excluded_industries or []),\n   226→                created_at=row.created_at,\n   227→                updated_at=row.updated_at,\n   228→            )\n   229→        )\n   230→\n   231→    logger.info(\n   232→        \"synthetic_candidates.loaded\",\n   233→        count=len(candidates),\n   234→        ids=[str(c.id) for c in candidates],\n   235→    )\n   236→    return candidates\n   237→\n   238→\n   239→# ─── Cache-Aware Claude Wrapper ──────────────────────────────────────────────\n   240→\n   241→\n   242→class CacheAwareAnthropic:\n   243→    \"\"\"\n   244→    Wrapper around AsyncAnthropic that enforces cache_control headers.\n   245→\n   246→    The RelevanceScorer is FROZEN and doesn't set cache_control.\n   247→    This wrapper intercepts message creation and adds the required\n   248→    cache_control headers per NUTRIENTS.md §I.5.\n   249→    \"\"\"\n   250→\n   251→    def __init__(\n   252→        self,\n   253→        client: AsyncAnthropic,\n   254→        cache_stats: CacheStats,\n   255→        candidate_identity: str,\n   256→    ):\n   257→        \"\"\"\n   258→        Initialize the cache-aware wrapper.\n   259→\n   260→        Args:\n   261→            client: The underlying AsyncAnthropic client\n   262→            cache_stats: CacheStats object to record metrics\n   263→            candidate_identity: Candidate identity text to cache\n   264→        \"\"\"\n   265→        self._client = client\n   266→        self._cache_stats = cache_stats\n   267→        self._candidate_identity = candidate_identity\n   268→        self.messages = _CacheAwareMessages(self)\n   269→\n   270→\n   271→class _CacheAwareMessages:\n   272→    \"\"\"Wraps the messages API to add cache_control.\"\"\"\n   273→\n   274→    def __init__(self, wrapper: CacheAwareAnthropic):\n   275→        self._wrapper = wrapper\n   276→\n   277→    async def create(self, **kwargs) -> object:\n   278→        \"\"\"\n   279→        Create a message with cache_control headers.\n   280→\n   281→        Transforms the messages to include cache_control on system prompt\n   282→        and candidate identity per NUTRIENTS.md §I.5.\n   283→        \"\"\"\n   284→        # Extract original messages\n   285→        messages = kwargs.get(\"messages\", [])\n   286→\n   287→        # Transform to use cache_control\n   288→        transformed_messages = []\n   289→        for msg in messages:\n   290→            if msg.get(\"role\") == \"user\":\n   291→                content = msg.get(\"content\", \"\")\n   292→                if isinstance(content, str):\n   293→                    # Split into cacheable parts\n   294→                    transformed_messages.append(\n   295→                        {\n   296→                            \"role\": \"user\",\n   297→                            \"content\": [\n   298→                                {\n   299→                                    \"type\": \"text\",\n   300→                                    \"text\": self._wrapper._candidate_identity,\n   301→                                    \"cache_control\": {\"type\": \"ephemeral\"},\n   302→                                },\n   303→                                {\n   304→                                    \"type\": \"text\",\n   305→                                    \"text\": content,\n   306→                                },\n   307→                            ],\n   308→                        }\n   309→                    )\n   310→                else:\n   311→                    # Already structured, just pass through\n   312→                    transformed_messages.append(msg)\n   313→            else:\n   314→                transformed_messages.append(msg)\n   315→\n   316→        # Add system prompt with cache_control\n   317→        system_content = [\n   318→            {\n   319→                \"type\": \"text\",\n   320→                \"text\": (\n   321→                    \"You are a talent agent scoring jobs against candidate profiles. \"\n   322→                    \"Return structured JSON responses.\"\n   323→                ),\n   324→                \"cache_control\": {\"type\": \"ephemeral\"},\n   325→            }\n   326→        ]\n   327→\n   328→        # Make the request\n   329→        kwargs[\"messages\"] = transformed_messages\n   330→        kwargs[\"system\"] = system_content\n   331→\n   332→        response = await self._wrapper._client.messages.create(**kwargs)\n   333→\n   334→        # Record cache statistics\n   335→        usage = response.usage\n   336→        cache_creation = getattr(usage, \"cache_creation_input_tokens\", 0) or 0\n   337→        cache_read = getattr(usage, \"cache_read_input_tokens\", 0) or 0\n   338→\n   339→        self._wrapper._cache_stats.record_call(cache_creation, cache_read)\n   340→\n   341→        logger.debug(\n   342→            \"cache_aware.request_complete\",\n   343→            cache_creation_tokens=cache_creation,\n   344→            cache_read_tokens=cache_read,\n   345→            total_calls=self._wrapper._cache_stats.total_calls,\n   346→        )\n   347→\n   348→        return response\n   349→\n   350→\n   351→# ─── Scored Result ───────────────────────────────────────────────────────────\n   352→\n   353→\n   354→class ScoredResult(BaseModel):\n   355→    \"\"\"Result of scoring a single candidate × JD pair.\"\"\"\n   356→\n   357→    candidate_id: str\n   358→    candidate_name: str\n   359→    jd_filename: str\n   360→    scored_job: Optional[ScoredJobSchema] = None\n   361→    expected_hot: bool\n   362→    expected_score_band: str\n   363→    actual_hot: bool = False\n   364→    actual_score: int = 0\n   365→    error: Optional[str] = None\n   366→\n   367→\n   368→class CandidateScoringResult(BaseModel):\n   369→    \"\"\"All scoring results for a single candidate.\"\"\"\n   370→\n   371→    candidate_id: str\n   372→    candidate_name: str\n   373→    profile: Optional[IdentityProfileSchema] = None\n   374→    scored_results: list[ScoredResult] = Field(default_factory=list)\n   375→    cache_stats: dict = Field(default_factory=dict)\n   376→    error: Optional[str] = None\n   377→\n   378→\n   379→# ─── Scoring Runner ──────────────────────────────────────────────────────────\n   380→\n   381→\n   382→class ScoringSyntheticRunner:\n   383→    \"\"\"\n   384→    Iterates synthetic candidates × JD fixtures for drift detection.\n   385→\n   386→    This runner:\n   387→    1. Loads synthetic candidates from the database\n   388→    2. Loads JD fixtures from synthetics/fixtures/jobs/\n   389→    3. For each candidate × JD pair, scores via RelevanceScorer\n   390→    4. Tracks cache hit/miss from Claude API responses\n   391→    5. Returns structured results for fingerprinting\n   392→\n   393→    Contract: NUTRIENTS.md §I.2-I.5, HYPHA-SYNTHETICS-SCORING.md\n   394→    \"\"\"\n   395→\n   396→    def __init__(\n   397→        self,\n   398→        session: AsyncSession,\n   399→        redis_client: aioredis.Redis,\n   400→        anthropic_client: AsyncAnthropic,\n   401→        fixtures_dir: Optional[Path] = None,\n   402→    ):\n   403→        \"\"\"\n   404→        Initialize the ScoringSyntheticRunner.\n   405→\n   406→        Args:\n   407→            session: Async SQLAlchemy session for database access\n   408→            redis_client: Async Redis client for caching\n   409→            anthropic_client: Async Anthropic client for Claude API\n   410→            fixtures_dir: Path to synthetics/fixtures/ (default: auto-detect)\n   411→        \"\"\"\n   412→        self._session = session\n   413→        self._redis = redis_client\n   414→        self._anthropic = anthropic_client\n   415→\n   416→        # Auto-detect fixtures directory if not provided\n   417→        if fixtures_dir is None:\n   418→            self._fixtures_dir = Path(__file__).parent.parent.parent / \"synthetics\" / \"fixtures\"\n   419→        else:\n   420→            self._fixtures_dir = fixtures_dir\n   421→\n   422→        self._run_id = str(uuid.uuid4())\n   423→\n   424→    async def run_suite(self) -> dict:\n   425→        \"\"\"\n   426→        Execute the full scoring suite.\n   427→\n   428→        Iterates all synthetic candidates × applicable JD fixtures,\n   429→        scoring each pair and collecting results.\n   430→\n   431→        Returns:\n   432→            dict with:\n   433→                - run_id: UUID of this run\n   434→                - started_at: ISO timestamp\n   435→                - completed_at: ISO timestamp\n   436→                - candidates: list of CandidateScoringResult\n   437→                - overall_cache_stats: aggregated cache statistics\n   438→        \"\"\"\n   439→        started_at = datetime.now(timezone.utc)\n   440→\n   441→        logger.info(\n   442→            \"scoring_runner.suite_start\",\n   443→            run_id=self._run_id,\n   444→            fixtures_dir=str(self._fixtures_dir),\n   445→        )\n   446→\n   447→        # Load synthetic candidates\n   448→        candidates = await load_synthetic_candidates(self._session)\n   449→        if not candidates:\n   450→            logger.warning(\"scoring_runner.no_candidates\")\n   451→            return {\n   452→                \"run_id\": self._run_id,\n   453→                \"started_at\": started_at.isoformat(),\n   454→                \"completed_at\": datetime.now(timezone.utc).isoformat(),\n   455→                \"candidates\": [],\n   456→                \"overall_cache_stats\": {\"total_calls\": 0, \"cache_hit_rate\": 0.0},\n   457→            }\n   458→\n   459→        # Load JD fixtures\n   460→        jd_fixtures = load_jd_fixtures(self._fixtures_dir)\n   461→        if not jd_fixtures:\n   462→            logger.warning(\"scoring_runner.no_fixtures\")\n   463→            return {\n   464→                \"run_id\": self._run_id,\n   465→                \"started_at\": started_at.isoformat(),\n   466→                \"completed_at\": datetime.now(timezone.utc).isoformat(),\n   467→                \"candidates\": [],\n   468→                \"overall_cache_stats\": {\"total_calls\": 0, \"cache_hit_rate\": 0.0},\n   469→            }\n   470→\n   471→        # Build mapping of candidate slug to JD fixtures\n   472→        candidate_slug_map = self._build_candidate_slug_map(candidates)\n   473→\n   474→        # Process each candidate\n   475→        all_results: list[CandidateScoringResult] = []\n   476→        overall_cache_stats = CacheStats()\n   477→\n   478→        for candidate in candidates:\n   479→            result = await self._score_candidate(\n   480→                candidate,\n   481→                jd_fixtures,\n   482→                candidate_slug_map,\n   483→                overall_cache_stats,\n   484→            )\n   485→            all_results.append(result)\n   486→\n   487→        completed_at = datetime.now(timezone.utc)\n   488→\n   489→        logger.info(\n   490→            \"scoring_runner.suite_complete\",\n   491→            run_id=self._run_id,\n   492→            candidates_processed=len(all_results),\n   493→            total_claude_calls=overall_cache_stats.total_calls,\n   494→            cache_hit_rate=round(overall_cache_stats.cache_hit_rate, 4),\n   495→            duration_seconds=(completed_at - started_at).total_seconds(),\n   496→        )\n   497→\n   498→        return {\n   499→            \"run_id\": self._run_id,\n   500→            \"started_at\": started_at.isoformat(),\n   501→            \"completed_at\": completed_at.isoformat(),\n   502→            \"candidates\": [r.model_dump() for r in all_results],\n   503→            \"overall_cache_stats\": {\n   504→                \"total_calls\": overall_cache_stats.total_calls,\n   505→                \"cache_hits\": overall_cache_stats.cache_hits,\n   506→                \"cache_misses\": overall_cache_stats.cache_misses,\n   507→                \"cache_hit_rate\": round(overall_cache_stats.cache_hit_rate, 4),\n   508→                \"cache_creation_tokens\": overall_cache_stats.cache_creation_tokens,\n   509→                \"cache_read_tokens\": overall_cache_stats.cache_read_tokens,\n   510→            },\n   511→        }\n   512→\n   513→    def _build_candidate_slug_map(\n   514→        self,\n   515→        candidates: list[CandidateSchema],\n   516→    ) -> dict[str, CandidateSchema]:\n   517→        \"\"\"\n   518→        Build a mapping of synthetic slugs to candidates.\n   519→\n   520→        Derives the slug from the candidate's email prefix:\n   521→            jordan.chen.synthetic@... → synthetic-jr-engineer (from name pattern)\n   522→        \"\"\"\n   523→        slug_map: dict[str, CandidateSchema] = {}\n   524→\n   525→        for candidate in candidates:\n   526→            # Extract slug from email pattern or name\n   527→            email = candidate.email.lower()\n   528→\n   529→            if \"jordan\" in email or \"chen\" in email:\n   530→                slug_map[\"synthetic-jr-engineer\"] = candidate\n   531→            elif \"priya\" in email or \"ramanathan\" in email:\n   532→                slug_map[\"synthetic-senior-ml\"] = candidate\n   533→            elif \"marcus\" in email or \"thompson\" in email:\n   534→                slug_map[\"synthetic-mid-product\"] = candidate\n   535→            else:\n   536→                # Fallback: use email prefix\n   537→                prefix = email.split(\"@\")[0].replace(\".\", \"-\")\n   538→                slug_map[prefix] = candidate\n   539→\n   540→        logger.debug(\n   541→            \"candidate_slug_map.built\",\n   542→            slugs=list(slug_map.keys()),\n   543→        )\n   544→        return slug_map\n   545→\n   546→    async def _score_candidate(\n   547→        self,\n   548→        candidate: CandidateSchema,\n   549→        jd_fixtures: list[JDFixture],\n   550→        slug_map: dict[str, CandidateSchema],\n   551→        overall_cache_stats: CacheStats,\n   552→    ) -> CandidateScoringResult:\n   553→        \"\"\"\n   554→        Score all applicable JD fixtures for a single candidate.\n   555→\n   556→        Args:\n   557→            candidate: The synthetic candidate\n   558→            jd_fixtures: All JD fixtures\n   559→            slug_map: Mapping of slugs to candidates\n   560→            overall_cache_stats: Aggregated cache stats\n   561→\n   562→        Returns:\n   563→            CandidateScoringResult with all scoring results\n   564→        \"\"\"\n   565→        # Determine which slug this candidate maps to\n   566→        candidate_slug = None\n   567→        for slug, cand in slug_map.items():\n   568→            if cand.id == candidate.id:\n   569→                candidate_slug = slug\n   570→                break\n   571→\n   572→        if not candidate_slug:\n   573→            logger.warning(\n   574→                \"scoring_runner.unknown_slug\",\n   575→                candidate_id=str(candidate.id),\n   576→                candidate_name=candidate.name,\n   577→            )\n   578→            return CandidateScoringResult(\n   579→                candidate_id=str(candidate.id),\n   580→                candidate_name=candidate.name,\n   581→                error=\"Could not determine candidate slug\",\n   582→            )\n   583→\n   584→        # Filter JD fixtures for this candidate\n   585→        applicable_jds = [\n   586→            jd for jd in jd_fixtures if jd.target_candidate == candidate_slug\n   587→        ]\n   588→\n   589→        logger.info(\n   590→            \"scoring_runner.candidate_start\",\n   591→            candidate_id=str(candidate.id),\n   592→            candidate_name=candidate.name,\n   593→            slug=candidate_slug,\n   594→            applicable_jds=len(applicable_jds),\n   595→        )\n   596→\n   597→        # Build identity profile first\n   598→        candidate_identity = self._build_candidate_identity_text(candidate)\n   599→        cache_stats = CacheStats()\n   600→\n   601→        # Create cache-aware wrapper for this candidate\n   602→        cache_client = CacheAwareAnthropic(\n   603→            self._anthropic,\n   604→            cache_stats,\n   605→            candidate_identity,\n   606→        )\n   607→\n   608→        # Build profile via IdentityProfiler\n   609→        profiler = IdentityProfiler(self._redis, cache_client)\n   610→        try:\n   611→            profile = await profiler.build_profile(candidate)\n   612→        except Exception as e:\n   613→            logger.error(\n   614→                \"scoring_runner.profile_error\",\n   615→                candidate_id=str(candidate.id),\n   616→                error=str(e),\n   617→            )\n   618→            return CandidateScoringResult(\n   619→                candidate_id=str(candidate.id),\n   620→                candidate_name=candidate.name,\n   621→                error=f\"Failed to build profile: {e}\",\n   622→            )\n   623→\n   624→        # Create scorer with cache-aware client\n   625→        scorer = RelevanceScorer(cache_client)\n   626→\n   627→        # Score each applicable JD\n   628→        scored_results: list[ScoredResult] = []\n   629→\n   630→        for jd in applicable_jds:\n   631→            result = await self._score_single_jd(\n   632→                candidate,\n   633→                profile,\n   634→                jd,\n   635→                scorer,\n   636→            )\n   637→            scored_results.append(result)\n   638→\n   639→        # Aggregate cache stats into overall\n   640→        overall_cache_stats.total_calls += cache_stats.total_calls\n   641→        overall_cache_stats.cache_creation_tokens += cache_stats.cache_creation_tokens\n   642→        overall_cache_stats.cache_read_tokens += cache_stats.cache_read_tokens\n   643→        overall_cache_stats._hit_count += cache_stats._hit_count\n   644→\n   645→        logger.info(\n   646→            \"scoring_runner.candidate_complete\",\n   647→            candidate_id=str(candidate.id),\n   648→            scored_count=len(scored_results),\n   649→            cache_calls=cache_stats.total_calls,\n   650→            cache_hit_rate=round(cache_stats.cache_hit_rate, 4),\n   651→        )\n   652→\n   653→        return CandidateScoringResult(\n   654→            candidate_id=str(candidate.id),\n   655→            candidate_name=candidate.name,\n   656→            profile=profile,\n   657→            scored_results=scored_results,\n   658→            cache_stats={\n   659→                \"total_calls\": cache_stats.total_calls,\n   660→                \"cache_hits\": cache_stats.cache_hits,\n   661→                \"cache_misses\": cache_stats.cache_misses,\n   662→                \"cache_hit_rate\": round(cache_stats.cache_hit_rate, 4),\n   663→            },\n   664→        )\n   665→\n   666→    def _build_candidate_identity_text(self, candidate: CandidateSchema) -> str:\n   667→        \"\"\"\n   668→        Build the candidate identity text for caching.\n   669→\n   670→        This text is prepended to all Claude calls for this candidate\n   671→        and marked with cache_control.\n   672→        \"\"\"\n   673→        return f\"\"\"# CANDIDATE IDENTITY\n   674→\n   675→Name: {candidate.name}\n   676→Location: {\", \".join(candidate.target_locations) if candidate.target_locations else \"Flexible\"}\n   677→Remote Preference: {candidate.remote_preference}\n   678→Min Compensation: {candidate.min_compensation or \"Not specified\"}\n   679→Excluded Companies: {\", \".join(candidate.excluded_companies) if candidate.excluded_companies else \"None\"}\n   680→Excluded Industries: {\", \".join(candidate.excluded_industries) if candidate.excluded_industries else \"None\"}\n   681→\n   682→## Resume\n   683→{candidate.resume_text}\n   684→\n   685→## Personal Context\n   686→{candidate.personal_context or \"Not provided\"}\n   687→\"\"\"\n   688→\n   689→    async def _score_single_jd(\n   690→        self,\n   691→        candidate: CandidateSchema,\n   692→        profile: IdentityProfileSchema,\n   693→        jd: JDFixture,\n   694→        scorer: RelevanceScorer,\n   695→    ) -> ScoredResult:\n   696→        \"\"\"\n   697→        Score a single candidate × JD pair.\n   698→\n   699→        Args:\n   700→            candidate: The synthetic candidate\n   701→            profile: The candidate's identity profile\n   702→            jd: The JD fixture\n   703→            scorer: RelevanceScorer instance\n   704→\n   705→        Returns:\n   706→            ScoredResult with scoring details\n   707→        \"\"\"\n   708→        logger.debug(\n   709→            \"scoring_runner.scoring_jd\",\n   710→            candidate_id=str(candidate.id),\n   711→            jd_filename=jd.filename,\n   712→        )\n   713→\n   714→        # Convert JD fixture to DiscoveredJobSchema\n   715→        discovered_job = DiscoveredJobSchema(\n   716→            id=uuid.uuid5(uuid.NAMESPACE_DNS, f\"synthetic-jd-{jd.filename}\"),\n   717→            source=jd.source,\n   718→            source_id=f\"synthetic-{jd.filename}\",\n   719→            title=jd.title,\n   720→            company=jd.company,\n   721→            location=jd.location,\n   722→            description=jd.description,\n   723→            url=jd.url,\n   724→            posted_at=None,\n   725→            salary_min=None,\n   726→            salary_max=None,\n   727→            remote=False,\n   728→            crawled_at=datetime.now(timezone.utc),\n   729→        )\n   730→\n   731→        try:\n   732→            scored_job = await scorer.score_job(\n   733→                discovered_job,\n   734→                profile,\n   735→                candidate.id,\n   736→            )\n   737→\n   738→            return ScoredResult(\n   739→                candidate_id=str(candidate.id),\n   740→                candidate_name=candidate.name,\n   741→                jd_filename=jd.filename,\n   742→                scored_job=scored_job,\n   743→                expected_hot=jd.expected_hot,\n   744→                expected_score_band=jd.expected_score_band,\n   745→                actual_hot=scored_job.is_hot,\n   746→                actual_score=scored_job.composite_score,\n   747→            )\n   748→\n   749→        except Exception as e:\n   750→            logger.error(\n   751→                \"scoring_runner.score_error\",\n   752→                candidate_id=str(candidate.id),\n   753→                jd_filename=jd.filename,\n   754→                error=str(e),\n   755→            )\n   756→            return ScoredResult(\n   757→                candidate_id=str(candidate.id),\n   758→                candidate_name=candidate.name,\n   759→                jd_filename=jd.filename,\n   760→                expected_hot=jd.expected_hot,\n   761→                expected_score_band=jd.expected_score_band,\n   762→                error=str(e),\n   763→            )\n   764→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"c3d85e71-547f-47fc-9b8e-03f9b792b0cb","uuid":"9bcadb15-d455-4dfb-ba40-fcff4eebe6cd","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/synthetics/scoring_runner.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nScoring Synthetic Runner — iterates synthetic candidates × JD fixtures.\n\nExecutes the RelevanceScorer against synthetic candidates with cache-aware\ninstrumentation. Tracks cache hit/miss rates from Claude API responses.\n\nThe scorer module (RelevanceScorer) is FROZEN. To enforce the cache contract\n(NUTRIENTS.md §I.5), this runner wraps Claude API calls with cache_control\nheaders by providing a wrapper client that intercepts and augments requests.\n\nContract: NUTRIENTS.md §I.2-I.5, HYPHA-SYNTHETICS-SCORING.md\nOwner: synthetics-scoring-agent.runner\n\"\"\"\n\nfrom __future__ import annotations\n\nimport uuid\nfrom dataclasses import dataclass, field\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Optional\n\nimport redis.asyncio as aioredis\nimport structlog\nimport yaml\nfrom anthropic import AsyncAnthropic\nfrom pydantic import BaseModel, Field\nfrom sqlalchemy import text\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom backend.agents.discovery.identity_profiler import IdentityProfiler\nfrom backend.agents.discovery.relevance_scorer import RelevanceScorer\nfrom backend.agents.discovery.schemas import (\n    CandidateSchema,\n    DiscoveredJobSchema,\n    IdentityProfileSchema,\n    ScoredJobSchema,\n)\n\nlogger = structlog.get_logger(__name__)\n\n\n# ─── Cache Statistics ────────────────────────────────────────────────────────\n\n\n@dataclass\nclass CacheStats:\n    \"\"\"Tracks cache hit/miss statistics for Claude API calls.\"\"\"\n\n    total_calls: int = 0\n    cache_creation_tokens: int = 0\n    cache_read_tokens: int = 0\n\n    @property\n    def cache_hits(self) -> int:\n        \"\"\"Number of calls that hit the cache.\"\"\"\n        # A cache hit is when cache_read_input_tokens > 0\n        return self._hit_count\n\n    @property\n    def cache_misses(self) -> int:\n        \"\"\"Number of calls that missed the cache.\"\"\"\n        return self.total_calls - self._hit_count\n\n    @property\n    def cache_hit_rate(self) -> float:\n        \"\"\"Cache hit rate as a ratio 0.0-1.0.\"\"\"\n        if self.total_calls == 0:\n            return 0.0\n        return self._hit_count / self.total_calls\n\n    _hit_count: int = field(default=0, init=False)\n\n    def record_call(\n        self,\n        cache_creation_input_tokens: int,\n        cache_read_input_tokens: int,\n    ) -> None:\n        \"\"\"Record a Claude API call's cache statistics.\"\"\"\n        self.total_calls += 1\n        self.cache_creation_tokens += cache_creation_input_tokens\n        self.cache_read_tokens += cache_read_input_tokens\n        if cache_read_input_tokens > 0:\n            self._hit_count += 1\n\n\n# ─── JD Fixture Loading ──────────────────────────────────────────────────────\n\n\nclass JDFixture(BaseModel):\n    \"\"\"A JD fixture loaded from synthetics/fixtures/jobs/.\"\"\"\n\n    filename: str\n    target_candidate: str\n    expected_hot: bool\n    expected_score_band: str  # low | mid | high\n    source: str\n    title: str\n    company: str\n    location: Optional[str] = None\n    description: str\n    url: str = \"\"\n\n\ndef load_jd_fixtures(fixtures_dir: Path) -> list[JDFixture]:\n    \"\"\"\n    Load all JD fixtures from the jobs directory.\n\n    Each fixture is a markdown file with YAML frontmatter.\n\n    Args:\n        fixtures_dir: Path to synthetics/fixtures/jobs/\n\n    Returns:\n        List of JDFixture objects\n    \"\"\"\n    fixtures: list[JDFixture] = []\n    jobs_dir = fixtures_dir / \"jobs\"\n\n    if not jobs_dir.exists():\n        logger.warning(\"jd_fixtures.dir_not_found\", path=str(jobs_dir))\n        return fixtures\n\n    for md_file in jobs_dir.glob(\"*.md\"):\n        try:\n            fixture = _parse_jd_fixture(md_file)\n            fixtures.append(fixture)\n            logger.debug(\n                \"jd_fixtures.loaded\",\n                filename=md_file.name,\n                target=fixture.target_candidate,\n            )\n        except Exception as e:\n            logger.error(\n                \"jd_fixtures.parse_error\",\n                filename=md_file.name,\n                error=str(e),\n            )\n\n    logger.info(\"jd_fixtures.loaded_all\", count=len(fixtures))\n    return fixtures\n\n\ndef _parse_jd_fixture(path: Path) -> JDFixture:\n    \"\"\"Parse a single JD fixture markdown file with YAML frontmatter.\"\"\"\n    content = path.read_text()\n\n    # Split frontmatter from body\n    if not content.startswith(\"---\"):\n        raise ValueError(f\"No YAML frontmatter in {path.name}\")\n\n    parts = content.split(\"---\", 2)\n    if len(parts) < 3:\n        raise ValueError(f\"Invalid frontmatter format in {path.name}\")\n\n    frontmatter = yaml.safe_load(parts[1])\n    body = parts[2].strip()\n\n    return JDFixture(\n        filename=path.name,\n        target_candidate=frontmatter[\"target_candidate\"],\n        expected_hot=frontmatter[\"expected_hot\"],\n        expected_score_band=frontmatter[\"expected_score_band\"],\n        source=frontmatter.get(\"source\", \"greenhouse\"),\n        title=frontmatter.get(\"title\", \"Unknown Title\"),\n        company=frontmatter.get(\"company\", \"Unknown Company\"),\n        location=frontmatter.get(\"location\"),\n        description=body,\n        url=frontmatter.get(\"url\", f\"https://example.com/jobs/{path.stem}\"),\n    )\n\n\n# ─── Synthetic Candidate Loading ─────────────────────────────────────────────\n\n\nasync def load_synthetic_candidates(\n    session: AsyncSession,\n) -> list[CandidateSchema]:\n    \"\"\"\n    Load synthetic candidates from the database.\n\n    Synthetic candidates are identified by UUIDv5 markers matching\n    the pattern: id::text LIKE '00000000-%'\n\n    Contract: NUTRIENTS.md §I.1\n\n    Args:\n        session: Async SQLAlchemy session\n\n    Returns:\n        List of CandidateSchema for synthetic candidates\n    \"\"\"\n    # Query candidates with synthetic UUID pattern\n    result = await session.execute(\n        text(\"\"\"\n            SELECT\n                id, name, email, resume_text, linkedin_url, github_url,\n                personal_context, target_locations, remote_preference,\n                min_compensation, excluded_companies, excluded_industries,\n                created_at, updated_at\n            FROM candidates\n            WHERE id::text LIKE '00000000-%'\n            ORDER BY name\n        \"\"\")\n    )\n\n    candidates: list[CandidateSchema] = []\n    for row in result.fetchall():\n        candidates.append(\n            CandidateSchema(\n                id=row.id,\n                name=row.name,\n                email=row.email,\n                resume_text=row.resume_text or \"\",\n                linkedin_url=row.linkedin_url,\n                github_url=row.github_url,\n                personal_context=row.personal_context,\n                target_locations=list(row.target_locations or []),\n                remote_preference=row.remote_preference or \"flexible\",\n                min_compensation=row.min_compensation,\n                excluded_companies=list(row.excluded_companies or []),\n                excluded_industries=list(row.excluded_industries or []),\n                created_at=row.created_at,\n                updated_at=row.updated_at,\n            )\n        )\n\n    logger.info(\n        \"synthetic_candidates.loaded\",\n        count=len(candidates),\n        ids=[str(c.id) for c in candidates],\n    )\n    return candidates\n\n\n# ─── Cache-Aware Claude Wrapper ──────────────────────────────────────────────\n\n\nclass CacheAwareAnthropic:\n    \"\"\"\n    Wrapper around AsyncAnthropic that enforces cache_control headers.\n\n    The RelevanceScorer is FROZEN and doesn't set cache_control.\n    This wrapper intercepts message creation and adds the required\n    cache_control headers per NUTRIENTS.md §I.5.\n    \"\"\"\n\n    def __init__(\n        self,\n        client: AsyncAnthropic,\n        cache_stats: CacheStats,\n        candidate_identity: str,\n    ):\n        \"\"\"\n        Initialize the cache-aware wrapper.\n\n        Args:\n            client: The underlying AsyncAnthropic client\n            cache_stats: CacheStats object to record metrics\n            candidate_identity: Candidate identity text to cache\n        \"\"\"\n        self._client = client\n        self._cache_stats = cache_stats\n        self._candidate_identity = candidate_identity\n        self.messages = _CacheAwareMessages(self)\n\n\nclass _CacheAwareMessages:\n    \"\"\"Wraps the messages API to add cache_control.\"\"\"\n\n    def __init__(self, wrapper: CacheAwareAnthropic):\n        self._wrapper = wrapper\n\n    async def create(self, **kwargs) -> object:\n        \"\"\"\n        Create a message with cache_control headers.\n\n        Transforms the messages to include cache_control on system prompt\n        and candidate identity per NUTRIENTS.md §I.5.\n        \"\"\"\n        # Extract original messages\n        messages = kwargs.get(\"messages\", [])\n\n        # Transform to use cache_control\n        transformed_messages = []\n        for msg in messages:\n            if msg.get(\"role\") == \"user\":\n                content = msg.get(\"content\", \"\")\n                if isinstance(content, str):\n                    # Split into cacheable parts\n                    transformed_messages.append(\n                        {\n                            \"role\": \"user\",\n                            \"content\": [\n                                {\n                                    \"type\": \"text\",\n                                    \"text\": self._wrapper._candidate_identity,\n                                    \"cache_control\": {\"type\": \"ephemeral\"},\n                                },\n                                {\n                                    \"type\": \"text\",\n                                    \"text\": content,\n                                },\n                            ],\n                        }\n                    )\n                else:\n                    # Already structured, just pass through\n                    transformed_messages.append(msg)\n            else:\n                transformed_messages.append(msg)\n\n        # Add system prompt with cache_control\n        system_content = [\n            {\n                \"type\": \"text\",\n                \"text\": (\n                    \"You are a talent agent scoring jobs against candidate profiles. \"\n                    \"Return structured JSON responses.\"\n                ),\n                \"cache_control\": {\"type\": \"ephemeral\"},\n            }\n        ]\n\n        # Make the request\n        kwargs[\"messages\"] = transformed_messages\n        kwargs[\"system\"] = system_content\n\n        response = await self._wrapper._client.messages.create(**kwargs)\n\n        # Record cache statistics\n        usage = response.usage\n        cache_creation = getattr(usage, \"cache_creation_input_tokens\", 0) or 0\n        cache_read = getattr(usage, \"cache_read_input_tokens\", 0) or 0\n\n        self._wrapper._cache_stats.record_call(cache_creation, cache_read)\n\n        logger.debug(\n            \"cache_aware.request_complete\",\n            cache_creation_tokens=cache_creation,\n            cache_read_tokens=cache_read,\n            total_calls=self._wrapper._cache_stats.total_calls,\n        )\n\n        return response\n\n\n# ─── Scored Result ───────────────────────────────────────────────────────────\n\n\nclass ScoredResult(BaseModel):\n    \"\"\"Result of scoring a single candidate × JD pair.\"\"\"\n\n    candidate_id: str\n    candidate_name: str\n    jd_filename: str\n    scored_job: Optional[ScoredJobSchema] = None\n    expected_hot: bool\n    expected_score_band: str\n    actual_hot: bool = False\n    actual_score: int = 0\n    error: Optional[str] = None\n\n\nclass CandidateScoringResult(BaseModel):\n    \"\"\"All scoring results for a single candidate.\"\"\"\n\n    candidate_id: str\n    candidate_name: str\n    profile: Optional[IdentityProfileSchema] = None\n    scored_results: list[ScoredResult] = Field(default_factory=list)\n    cache_stats: dict = Field(default_factory=dict)\n    error: Optional[str] = None\n\n\n# ─── Scoring Runner ──────────────────────────────────────────────────────────\n\n\nclass ScoringSyntheticRunner:\n    \"\"\"\n    Iterates synthetic candidates × JD fixtures for drift detection.\n\n    This runner:\n    1. Loads synthetic candidates from the database\n    2. Loads JD fixtures from synthetics/fixtures/jobs/\n    3. For each candidate × JD pair, scores via RelevanceScorer\n    4. Tracks cache hit/miss from Claude API responses\n    5. Returns structured results for fingerprinting\n\n    Contract: NUTRIENTS.md §I.2-I.5, HYPHA-SYNTHETICS-SCORING.md\n    \"\"\"\n\n    def __init__(\n        self,\n        session: AsyncSession,\n        redis_client: aioredis.Redis,\n        anthropic_client: AsyncAnthropic,\n        fixtures_dir: Optional[Path] = None,\n    ):\n        \"\"\"\n        Initialize the ScoringSyntheticRunner.\n\n        Args:\n            session: Async SQLAlchemy session for database access\n            redis_client: Async Redis client for caching\n            anthropic_client: Async Anthropic client for Claude API\n            fixtures_dir: Path to synthetics/fixtures/ (default: auto-detect)\n        \"\"\"\n        self._session = session\n        self._redis = redis_client\n        self._anthropic = anthropic_client\n\n        # Auto-detect fixtures directory if not provided\n        if fixtures_dir is None:\n            self._fixtures_dir = Path(__file__).parent.parent.parent / \"synthetics\" / \"fixtures\"\n        else:\n            self._fixtures_dir = fixtures_dir\n\n        self._run_id = str(uuid.uuid4())\n\n    async def run_suite(self) -> dict:\n        \"\"\"\n        Execute the full scoring suite.\n\n        Iterates all synthetic candidates × applicable JD fixtures,\n        scoring each pair and collecting results.\n\n        Returns:\n            dict with:\n                - run_id: UUID of this run\n                - started_at: ISO timestamp\n                - completed_at: ISO timestamp\n                - candidates: list of CandidateScoringResult\n                - overall_cache_stats: aggregated cache statistics\n        \"\"\"\n        started_at = datetime.now(timezone.utc)\n\n        logger.info(\n            \"scoring_runner.suite_start\",\n            run_id=self._run_id,\n            fixtures_dir=str(self._fixtures_dir),\n        )\n\n        # Load synthetic candidates\n        candidates = await load_synthetic_candidates(self._session)\n        if not candidates:\n            logger.warning(\"scoring_runner.no_candidates\")\n            return {\n                \"run_id\": self._run_id,\n                \"started_at\": started_at.isoformat(),\n                \"completed_at\": datetime.now(timezone.utc).isoformat(),\n                \"candidates\": [],\n                \"overall_cache_stats\": {\"total_calls\": 0, \"cache_hit_rate\": 0.0},\n            }\n\n        # Load JD fixtures\n        jd_fixtures = load_jd_fixtures(self._fixtures_dir)\n        if not jd_fixtures:\n            logger.warning(\"scoring_runner.no_fixtures\")\n            return {\n                \"run_id\": self._run_id,\n                \"started_at\": started_at.isoformat(),\n                \"completed_at\": datetime.now(timezone.utc).isoformat(),\n                \"candidates\": [],\n                \"overall_cache_stats\": {\"total_calls\": 0, \"cache_hit_rate\": 0.0},\n            }\n\n        # Build mapping of candidate slug to JD fixtures\n        candidate_slug_map = self._build_candidate_slug_map(candidates)\n\n        # Process each candidate\n        all_results: list[CandidateScoringResult] = []\n        overall_cache_stats = CacheStats()\n\n        for candidate in candidates:\n            result = await self._score_candidate(\n                candidate,\n                jd_fixtures,\n                candidate_slug_map,\n                overall_cache_stats,\n            )\n            all_results.append(result)\n\n        completed_at = datetime.now(timezone.utc)\n\n        logger.info(\n            \"scoring_runner.suite_complete\",\n            run_id=self._run_id,\n            candidates_processed=len(all_results),\n            total_claude_calls=overall_cache_stats.total_calls,\n            cache_hit_rate=round(overall_cache_stats.cache_hit_rate, 4),\n            duration_seconds=(completed_at - started_at).total_seconds(),\n        )\n\n        return {\n            \"run_id\": self._run_id,\n            \"started_at\": started_at.isoformat(),\n            \"completed_at\": completed_at.isoformat(),\n            \"candidates\": [r.model_dump() for r in all_results],\n            \"overall_cache_stats\": {\n                \"total_calls\": overall_cache_stats.total_calls,\n                \"cache_hits\": overall_cache_stats.cache_hits,\n                \"cache_misses\": overall_cache_stats.cache_misses,\n                \"cache_hit_rate\": round(overall_cache_stats.cache_hit_rate, 4),\n                \"cache_creation_tokens\": overall_cache_stats.cache_creation_tokens,\n                \"cache_read_tokens\": overall_cache_stats.cache_read_tokens,\n            },\n        }\n\n    def _build_candidate_slug_map(\n        self,\n        candidates: list[CandidateSchema],\n    ) -> dict[str, CandidateSchema]:\n        \"\"\"\n        Build a mapping of synthetic slugs to candidates.\n\n        Derives the slug from the candidate's email prefix:\n            jordan.chen.synthetic@... → synthetic-jr-engineer (from name pattern)\n        \"\"\"\n        slug_map: dict[str, CandidateSchema] = {}\n\n        for candidate in candidates:\n            # Extract slug from email pattern or name\n            email = candidate.email.lower()\n\n            if \"jordan\" in email or \"chen\" in email:\n                slug_map[\"synthetic-jr-engineer\"] = candidate\n            elif \"priya\" in email or \"ramanathan\" in email:\n                slug_map[\"synthetic-senior-ml\"] = candidate\n            elif \"marcus\" in email or \"thompson\" in email:\n                slug_map[\"synthetic-mid-product\"] = candidate\n            else:\n                # Fallback: use email prefix\n                prefix = email.split(\"@\")[0].replace(\".\", \"-\")\n                slug_map[prefix] = candidate\n\n        logger.debug(\n            \"candidate_slug_map.built\",\n            slugs=list(slug_map.keys()),\n        )\n        return slug_map\n\n    async def _score_candidate(\n        self,\n        candidate: CandidateSchema,\n        jd_fixtures: list[JDFixture],\n        slug_map: dict[str, CandidateSchema],\n        overall_cache_stats: CacheStats,\n    ) -> CandidateScoringResult:\n        \"\"\"\n        Score all applicable JD fixtures for a single candidate.\n\n        Args:\n            candidate: The synthetic candidate\n            jd_fixtures: All JD fixtures\n            slug_map: Mapping of slugs to candidates\n            overall_cache_stats: Aggregated cache stats\n\n        Returns:\n            CandidateScoringResult with all scoring results\n        \"\"\"\n        # Determine which slug this candidate maps to\n        candidate_slug = None\n        for slug, cand in slug_map.items():\n            if cand.id == candidate.id:\n                candidate_slug = slug\n                break\n\n        if not candidate_slug:\n            logger.warning(\n                \"scoring_runner.unknown_slug\",\n                candidate_id=str(candidate.id),\n                candidate_name=candidate.name,\n            )\n            return CandidateScoringResult(\n                candidate_id=str(candidate.id),\n                candidate_name=candidate.name,\n                error=\"Could not determine candidate slug\",\n            )\n\n        # Filter JD fixtures for this candidate\n        applicable_jds = [\n            jd for jd in jd_fixtures if jd.target_candidate == candidate_slug\n        ]\n\n        logger.info(\n            \"scoring_runner.candidate_start\",\n            candidate_id=str(candidate.id),\n            candidate_name=candidate.name,\n            slug=candidate_slug,\n            applicable_jds=len(applicable_jds),\n        )\n\n        # Build identity profile first\n        candidate_identity = self._build_candidate_identity_text(candidate)\n        cache_stats = CacheStats()\n\n        # Create cache-aware wrapper for this candidate\n        cache_client = CacheAwareAnthropic(\n            self._anthropic,\n            cache_stats,\n            candidate_identity,\n        )\n\n        # Build profile via IdentityProfiler\n        profiler = IdentityProfiler(self._redis, cache_client)\n        try:\n            profile = await profiler.build_profile(candidate)\n        except Exception as e:\n            logger.error(\n                \"scoring_runner.profile_error\",\n                candidate_id=str(candidate.id),\n                error=str(e),\n            )\n            return CandidateScoringResult(\n                candidate_id=str(candidate.id),\n                candidate_name=candidate.name,\n                error=f\"Failed to build profile: {e}\",\n            )\n\n        # Create scorer with cache-aware client\n        scorer = RelevanceScorer(cache_client)\n\n        # Score each applicable JD\n        scored_results: list[ScoredResult] = []\n\n        for jd in applicable_jds:\n            result = await self._score_single_jd(\n                candidate,\n                profile,\n                jd,\n                scorer,\n            )\n            scored_results.append(result)\n\n        # Aggregate cache stats into overall\n        overall_cache_stats.total_calls += cache_stats.total_calls\n        overall_cache_stats.cache_creation_tokens += cache_stats.cache_creation_tokens\n        overall_cache_stats.cache_read_tokens += cache_stats.cache_read_tokens\n        overall_cache_stats._hit_count += cache_stats._hit_count\n\n        logger.info(\n            \"scoring_runner.candidate_complete\",\n            candidate_id=str(candidate.id),\n            scored_count=len(scored_results),\n            cache_calls=cache_stats.total_calls,\n            cache_hit_rate=round(cache_stats.cache_hit_rate, 4),\n        )\n\n        return CandidateScoringResult(\n            candidate_id=str(candidate.id),\n            candidate_name=candidate.name,\n            profile=profile,\n            scored_results=scored_results,\n            cache_stats={\n                \"total_calls\": cache_stats.total_calls,\n                \"cache_hits\": cache_stats.cache_hits,\n                \"cache_misses\": cache_stats.cache_misses,\n                \"cache_hit_rate\": round(cache_stats.cache_hit_rate, 4),\n            },\n        )\n\n    def _build_candidate_identity_text(self, candidate: CandidateSchema) -> str:\n        \"\"\"\n        Build the candidate identity text for caching.\n\n        This text is prepended to all Claude calls for this candidate\n        and marked with cache_control.\n        \"\"\"\n        return f\"\"\"# CANDIDATE IDENTITY\n\nName: {candidate.name}\nLocation: {\", \".join(candidate.target_locations) if candidate.target_locations else \"Flexible\"}\nRemote Preference: {candidate.remote_preference}\nMin Compensation: {candidate.min_compensation or \"Not specified\"}\nExcluded Companies: {\", \".join(candidate.excluded_companies) if candidate.excluded_companies else \"None\"}\nExcluded Industries: {\", \".join(candidate.excluded_industries) if candidate.excluded_industries else \"None\"}\n\n## Resume\n{candidate.resume_text}\n\n## Personal Context\n{candidate.personal_context or \"Not provided\"}\n\"\"\"\n\n    async def _score_single_jd(\n        self,\n        candidate: CandidateSchema,\n        profile: IdentityProfileSchema,\n        jd: JDFixture,\n        scorer: RelevanceScorer,\n    ) -> ScoredResult:\n        \"\"\"\n        Score a single candidate × JD pair.\n\n        Args:\n            candidate: The synthetic candidate\n            profile: The candidate's identity profile\n            jd: The JD fixture\n            scorer: RelevanceScorer instance\n\n        Returns:\n            ScoredResult with scoring details\n        \"\"\"\n        logger.debug(\n            \"scoring_runner.scoring_jd\",\n            candidate_id=str(candidate.id),\n            jd_filename=jd.filename,\n        )\n\n        # Convert JD fixture to DiscoveredJobSchema\n        discovered_job = DiscoveredJobSchema(\n            id=uuid.uuid5(uuid.NAMESPACE_DNS, f\"synthetic-jd-{jd.filename}\"),\n            source=jd.source,\n            source_id=f\"synthetic-{jd.filename}\",\n            title=jd.title,\n            company=jd.company,\n            location=jd.location,\n            description=jd.description,\n            url=jd.url,\n            posted_at=None,\n            salary_min=None,\n            salary_max=None,\n            remote=False,\n            crawled_at=datetime.now(timezone.utc),\n        )\n\n        try:\n            scored_job = await scorer.score_job(\n                discovered_job,\n                profile,\n                candidate.id,\n            )\n\n            return ScoredResult(\n                candidate_id=str(candidate.id),\n                candidate_name=candidate.name,\n                jd_filename=jd.filename,\n                scored_job=scored_job,\n                expected_hot=jd.expected_hot,\n                expected_score_band=jd.expected_score_band,\n                actual_hot=scored_job.is_hot,\n                actual_score=scored_job.composite_score,\n            )\n\n        except Exception as e:\n            logger.error(\n                \"scoring_runner.score_error\",\n                candidate_id=str(candidate.id),\n                jd_filename=jd.filename,\n                error=str(e),\n            )\n            return ScoredResult(\n                candidate_id=str(candidate.id),\n                candidate_name=candidate.name,\n                jd_filename=jd.filename,\n                expected_hot=jd.expected_hot,\n                expected_score_band=jd.expected_score_band,\n                error=str(e),\n            )\n","numLines":764,"startLine":1,"totalLines":764}}}}
