=2.9.2\npydantic-settings==2.5.2\n\n# Database\nsqlalchemy==2.0.35\nasyncpg==0.29.0\nalembic==1.13.3\n\n# Task queue\ncelery==5.4.0\nredis==5.1.1\n\n# HTTP client\nhttpx==0.27.2\n\n# Web scraping\nplaywright==1.47.0\nbeautifulsoup4==4.12.3\nlxml==5.3.0\n\n# AI\nanthropic==0.34.2\n\n# Logging\nstructlog==24.4.0\n\n# Testing\npytest==8.3.3\npytest-asyncio==0.24.0\npytest-httpx==0.32.0\npytest-cov==5.0.0\nfakeredis==2.23.3\naiosqlite==0.20.0\n\n# Auth\nPyJWT==2.9.0\nresend==2.4.0\n\n# PDF parsing\npymupdf==1.24.10\n\n# Utilities\npython-dotenv==1.0.1\ntenacity==9.0.0\npython-multipart==0.0.12\n","numLines":52,"startLine":1,"totalLines":52}}}}
