    SourceCheckResult,\n    43→    StateTransition,\n    44→)\n    45→\n    46→__all__ = [\n    47→    # Scoring Runner\n    48→    \"ScoringSyntheticRunner\",\n    49→    # Crawler Health Runner\n    50→    \"CrawlerHealthRunner\",\n    51→    \"CrawlerHealthState\",\n    52→    \"SourceCheckResult\",\n    53→    \"StateTransition\",\n    54→    # Fingerprint\n    55→    \"FingerprintContract\",\n    56→    \"ScoringFingerprint\",\n    57→    \"compute_fingerprint\",\n    58→    \"load_baseline\",\n    59→    \"save_baseline\",\n    60→    # Diff\n    61→    \"DriftReport\",\n    62→    \"DriftViolation\",\n    63→    \"diff_against_baseline\",\n    64→    \"has_drift\",\n    65→    \"is_critical\",\n    66→    \"format_summary\",\n    67→]\n    68→"}]},"parent_tool_use_id":null,"session_id":"c3d85e71-547f-47fc-9b8e-03f9b792b0cb","uuid":"7cc86647-6943-46b9-9725-eb006f91d391","tool_use_result":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/synthetics/__init__.py","oldString":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nBackend synthetics package for Talent Agent.\n\nProvides deterministic scoring drift detection via:\n    - ScoringSyntheticRunner: Iterates synthetic candidates × JDs\n    - compute_fingerprint: Produces stable JSON fingerprints\n    - diff_against_baseline: Compares fingerprints for drift\n    - DriftReport: Drift comparison result with severity\n\nContract: NUTRIENTS.md §I.2-I.5, HYPHA-SYNTHETICS-SCORING.md\n\"\"\"\n\nfrom backend.synthetics.diff import (\n    DriftReport,\n    DriftViolation,\n    diff_against_baseline,\n    has_drift,\n    is_critical,\n    format_summary,\n)\nfrom backend.synthetics.fingerprint import (\n    FingerprintContract,\n    ScoringFingerprint,\n    compute_fingerprint,\n    load_baseline,\n    save_baseline,\n)\nfrom backend.synthetics.scoring_runner import ScoringSyntheticRunner\n\n__all__ = [\n    # Runner\n    \"ScoringSyntheticRunner\",\n    # Fingerprint\n    \"FingerprintContract\",\n    \"ScoringFingerprint\",\n    \"compute_fingerprint\",\n    \"load_baseline\",\n    \"save_baseline\",\n    # Diff\n    \"DriftReport\",\n    \"DriftViolation\",\n    \"diff_against_baseline\",\n    \"has_drift\",\n    \"is_critical\",\n    \"format_summary\",\n]","newString":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nBackend synthetics package for Talent Agent.\n\nProvides two monitoring capabilities:\n\n1. Scoring Drift Detection (synthetics-scoring-agent):\n    - ScoringSyntheticRunner: Iterates synthetic candidates × JDs\n    - compute_fingerprint: Produces stable JSON fingerprints\n    - diff_against_baseline: Compares fingerprints for drift\n    - DriftReport: Drift comparison result with severity\n\n2. Crawler Health Monitoring (synthetics-crawler-agent):\n    - CrawlerHealthRunner: Hits known-good slugs per source\n    - CrawlerHealthState: Tracks consecutive failures + alerts\n    - State machine: 3-strike threshold for alerts\n\nContract: NUTRIENTS.md §I.2-I.6, HYPHA-SYNTHETICS-SCORING.md, HYPHA-SYNTHETICS-CRAWLER.md\n\"\"\"\n\nfrom backend.synthetics.diff import (\n    DriftReport,\n    DriftViolation,\n    diff_against_baseline,\n    has_drift,\n    is_critical,\n    format_summary,\n)\nfrom backend.synthetics.fingerprint import (\n    FingerprintContract,\n    ScoringFingerprint,\n    compute_fingerprint,\n    load_baseline,\n    save_baseline,\n)\nfrom backend.synthetics.scoring_runner import ScoringSyntheticRunner\nfrom backend.synthetics.crawler_health import (\n    CrawlerHealthRunner,\n    CrawlerHealthState,\n    SourceCheckResult,\n    StateTransition,\n)\n\n__all__ = [\n    # Scoring Runner\n    \"ScoringSyntheticRunner\",\n    # Crawler Health Runner\n    \"CrawlerHealthRunner\",\n    \"CrawlerHealthState\",\n    \"SourceCheckResult\",\n    \"StateTransition\",\n    # Fingerprint\n    \"FingerprintContract\",\n    \"ScoringFingerprint\",\n    \"compute_fingerprint\",\n    \"load_baseline\",\n    \"save_baseline\",\n    # Diff\n    \"DriftReport\",\n    \"DriftViolation\",\n    \"diff_against_baseline\",\n    \"has_drift\",\n    \"is_critical\",\n    \"format_summary\",\n]","originalFile":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nBackend synthetics package for Talent Agent.\n\nProvides deterministic scoring drift detection via:\n    - ScoringSyntheticRunner: Iterates synthetic candidates × JDs\n    - compute_fingerprint: Produces stable JSON fingerprints\n    - diff_against_baseline: Compares fingerprints for drift\n    - DriftReport: Drift comparison result with severity\n\nContract: NUTRIENTS.md §I.2-I.5, HYPHA-SYNTHETICS-SCORING.md\n\"\"\"\n\nfrom backend.synthetics.diff import (\n    DriftReport,\n    DriftViolation,\n    diff_against_baseline,\n    has_drift,\n    is_critical,\n    format_summary,\n)\nfrom backend.synthetics.fingerprint import (\n    FingerprintContract,\n    ScoringFingerprint,\n    compute_fingerprint,\n    load_baseline,\n    save_baseline,\n)\nfrom backend.synthetics.scoring_runner import ScoringSyntheticRunner\n\n__all__ = [\n    # Runner\n    \"ScoringSyntheticRunner\",\n    # Fingerprint\n    \"FingerprintContract\",\n    \"ScoringFingerprint\",\n    \"compute_fingerprint\",\n    \"load_baseline\",\n    \"save_baseline\",\n    # Diff\n    \"DriftReport\",\n    \"DriftViolation\",\n    \"diff_against_baseline\",\n    \"has_drift\",\n    \"is_critical\",\n    \"format_summary\",\n]\n","structuredPatch":[{"oldStart":4,"oldLines":13,"newStart":4,"newLines":20,"lines":[" \"\"\""," Backend synthetics package for Talent Agent."," ","-Provides deterministic scoring drift detection via:","+Provides two monitoring capabilities:","+","+1. Scoring Drift Detection (synthetics-scoring-agent):","     - ScoringSyntheticRunner: Iterates synthetic candidates × JDs","     - compute_fingerprint: Produces stable JSON fingerprints","     - diff_against_baseline: Compares fingerprints for drift","     - DriftReport: Drift comparison result with severity"," ","-Contract: NUTRIENTS.md §I.2-I.5, HYPHA-SYNTHETICS-SCORING.md","+2. Crawler Health Monitoring (synthetics-crawler-agent):","+    - CrawlerHealthRunner: Hits known-good slugs per source","+    - CrawlerHealthState: Tracks consecutive failures + alerts","+    - State machine: 3-strike threshold for alerts","+","+Contract: NUTRIENTS.md §I.2-I.6, HYPHA-SYNTHETICS-SCORING.md, HYPHA-SYNTHETICS-CRAWLER.md"," \"\"\""," "," from backend.synthetics.diff import ("]},{"oldStart":29,"oldLines":10,"newStart":36,"newLines":21,"lines":["     save_baseline,"," )"," from backend.synthetics.scoring_runner import ScoringSyntheticRunner","+from backend.synthetics.crawler_health import (","+    CrawlerHealthRunner,","+    CrawlerHealthState,","+    SourceCheckResult,","+    StateTransition,","+)"," "," __all__ = [","-    # Runner","+    # Scoring Runner","     \"ScoringSyntheticRunner\",","+    # Crawler Health Runner","+    \"CrawlerHealthRunner\",","+    \"CrawlerHealthState\",","+    \"SourceCheckResult\",","+    \"StateTransition\",","     # Fingerprint","     \"FingerprintContract\",","     \"ScoringFingerprint\","]}],"userModified":false,"replaceAll":false}}}
