{"t":"2026-05-28T03:49:41.665Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VPNjbgjLp8aCM8FJtj5FY4","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"Celery task definitions for daily discovery runs.\n     5→\n     6→This module defines the `daily_discovery_task` that wraps the async\n     7→DiscoveryOrchestrator.run() with asyncio.run() for Celery's sync workers.\n     8→\n     9→Retry policy:\n    10→    - 3 retries with exponential backoff: 60s, 300s, 900s\n    11→    - On terminal failure: write traceback to crawl_runs.error_log\n    12→    - Publish DAILY_TASK_DEAD event to agent.status.discovery\n    13→\n    14→Idempotency:\n    15→    - Task ID format: discovery-{candidate_id}-{YYYY-MM-DD}\n    16→    - Prevents duplicate runs if worker re-fires on the same day\n    17→\n    18→Contract: HYPHA-SCHEDULER.md\n    19→\"\"\"\n    20→\n    21→from __future__ import annotations\n    22→\n    23→import asyncio\n    24→import traceback\n    25→from datetime import date, datetime, timezone\n    26→from uuid import UUID\n    27→\n    28→import redis.asyncio as aioredis\n    29→import structlog\n    30→from celery import Task\n    31→from celery.exceptions import MaxRetriesExceededError\n    32→from sqlalchemy import select\n    33→from sqlalchemy.ext.asyncio import AsyncSession, create_async_engine, async_sessionmaker\n    34→\n    35→from backend.config import settings\n    36→from backend.scheduler.celery_app import celery_app\n    37→from backend.observability.events import PubSubChannel, publish_event, BaseEvent\n    38→\n    39→\n    40→logger = structlog.get_logger(__name__)\n    41→\n    42→# Retry countdown in seconds: 60s, 300s (5min), 900s (15min)\n    43→RETRY_COUNTDOWNS = [60, 300, 900]\n    44→\n    45→\n    46→class DailyTaskDeadEvent(BaseEvent):\n    47→    \"\"\"Event published when a daily discovery task exhausts all retries.\n    48→\n    49→    Published to: agent.status.discovery\n    50→    \"\"\"\n    51→\n    52→    event: str = \"DAILY_TASK_DEAD\"\n    53→    candidate_id: str\n    54→    task_id: str\n    55→    error: str\n    56→    retries_exhausted: int\n    57→\n    58→\n    59→def _compute_task_id(candidate_id: str | UUID) -> str:\n    60→    \"\"\"Compute idempotent task ID for a candidate on today's date (UTC).\n    61→\n    62→    Format: discovery-{candidate_id}-{YYYY-MM-DD}\n    63→\n    64→    Args:\n    65→        candidate_id: The candidate's UUID\n    66→\n    67→    Returns:\n    68→        Idempotent task ID string\n    69→    \"\"\"\n    70→    run_date = date.today().isoformat()\n    71→    return f\"discovery-{candidate_id}-{run_date}\"\n    72→\n    73→\n    74→async def _run_discovery(candidate_id: UUID) -> None:\n    75→    \"\"\"Run the async discovery orchestrator with fresh connections.\n    76→\n    77→    Creates a fresh DB session and Redis client for this invocation,\n    78→    ensuring no connection pooling issues across Celery tasks.\n    79→\n    80→    Args:\n    81→        candidate_id: UUID of the candidate to run discovery for\n    82→\n    83→    Raises:\n    84→        Exception: Any error from the orchestrator is propagated\n    85→    \"\"\"\n    86→    # Import here to avoid circular imports at module load time\n    87→    from backend.agents.discovery.orchestrator import DiscoveryOrchestrator\n    88→\n    89→    # Create fresh async engine for this task (no shared pool across workers)\n    90→    engine = create_async_engine(\n    91→        settings.database_url,\n    92→        echo=False,\n    93→        pool_pre_ping=True,\n    94→        pool_size=1,\n    95→        max_overflow=0,\n    96→    )\n    97→    session_factory = async_sessionmaker(\n    98→        engine,\n    99→        class_=AsyncSession,\n   100→        expire_on_commit=False,\n   101→    )\n   102→\n   103→    # Create fresh Redis client\n   104→    redis_client = aioredis.from_url(\n   105→        settings.redis_url,\n   106→        decode_responses=True,\n   107→    )\n   108→\n   109→    try:\n   110→        async with session_factory() as db:\n   111→            orchestrator = DiscoveryOrchestrator(db, redis_client)\n   112→            await orchestrator.run(candidate_id, dry_run=False)\n   113→    finally:\n   114→        await redis_client.aclose()\n   115→        await engine.dispose()\n   116→\n   117→\n   118→async def _mark_crawl_run_failed(candidate_id: UUID, error_log: str) -> None:\n   119→    \"\"\"Mark the most recent RUNNING crawl run as FAILED with error log.\n   120→\n   121→    Args:\n   122→        candidate_id: UUID of the candidate\n   123→        error_log: Traceback or error message to record\n   124→    \"\"\"\n   125→    from backend.models.discovery import CrawlRun\n   126→\n   127→    engine = create_async_engine(\n   128→        settings.database_url,\n   129→        echo=False,\n   130→        pool_pre_ping=True,\n   131→        pool_size=1,\n   132→        max_overflow=0,\n   133→    )\n   134→    session_factory = async_sessionmaker(\n   135→        engine,\n   136→        class_=AsyncSession,\n   137→        expire_on_commit=False,\n   138→    )\n   139→\n   140→    try:\n   141→        async with session_factory() as db:\n   142→            # Find the most recent RUNNING crawl run for this candidate\n   143→            result = await db.execute(\n   144→                select(CrawlRun)\n   145→                .where(CrawlRun.candidate_id == candidate_id)\n   146→                .where(CrawlRun.status == \"RUNNING\")\n   147→                .order_by(CrawlRun.started_at.desc())\n   148→                .limit(1)\n   149→            )\n   150→            crawl_run = result.scalar_one_or_none()\n   151→\n   152→            if crawl_run:\n   153→                crawl_run.status = \"FAILED\"\n   154→                crawl_run.completed_at = datetime.now(timezone.utc)\n   155→                crawl_run.error_log = error_log\n   156→                await db.commit()\n   157→                logger.info(\n   158→                    \"task.crawl_run_marked_failed\",\n   159→                    crawl_run_id=str(crawl_run.id),\n   160→                    candidate_id=str(candidate_id),\n   161→                )\n   162→            else:\n   163→                logger.warning(\n   164→                    \"task.no_running_crawl_run\",\n   165→                    candidate_id=str(candidate_id),\n   166→                )\n   167→    finally:\n   168→        await engine.dispose()\n   169→\n   170→\n   171→async def _publish_dead_event(\n   172→    candidate_id: UUID, task_id: str, error: str, retries: int\n   173→) -> None:\n   174→    \"\"\"Publish DAILY_TASK_DEAD event to agent.status.discovery.\n   175→\n   176→    Args:\n   177→        candidate_id: UUID of the candidate\n   178→        task_id: The Celery task ID\n   179→        error: Error message or traceback\n   180→        retries: Number of retries exhausted\n   181→    \"\"\"\n   182→    redis_client = aioredis.from_url(\n   183→        settings.redis_url,\n   184→        decode_responses=True,\n   185→    )\n   186→\n   187→    try:\n   188→        event = DailyTaskDeadEvent(\n   189→            candidate_id=str(candidate_id),\n   190→            task_id=task_id,\n   191→            error=error,\n   192→            retries_exhausted=retries,\n   193→        )\n   194→        await publish_event(redis_client, PubSubChannel.DISCOVERY, event)\n   195→        logger.info(\n   196→            \"task.dead_event_published\",\n   197→            candidate_id=str(candidate_id),\n   198→            task_id=task_id,\n   199→        )\n   200→    finally:\n   201→        await redis_client.aclose()\n   202→\n   203→\n   204→@celery_app.task(\n   205→    bind=True,\n   206→    name=\"backend.scheduler.tasks.daily_discovery_task\",\n   207→    max_retries=3,\n   208→    default_retry_delay=60,\n   209→    autoretry_for=(Exception,),\n   210→    retry_backoff=False,  # We implement custom backoff via countdown\n   211→    acks_late=True,\n   212→    reject_on_worker_lost=True,\n   213→    track_started=True,\n   214→)\n   215→def daily_discovery_task(self: Task, candidate_id: str) -> dict:\n   216→    \"\"\"Run daily job discovery for a single candidate.\n   217→\n   218→    This task wraps the async DiscoveryOrchestrator.run() with asyncio.run()\n   219→    since Celery workers are synchronous by design. Each invocation creates\n   220→    a fresh event loop, DB session, and Redis client.\n   221→\n   222→    Retry policy:\n   223→        - 3 retries with exponential backoff: 60s, 300s, 900s\n   224→        - On MaxRetriesExceededError: write to crawl_runs.error_log,\n   225→          publish DAILY_TASK_DEAD, then re-raise\n   226→\n   227→    Args:\n   228→        candidate_id: UUID string of the candidate\n   229→\n   230→    Returns:\n   231→        dict with status and candidate_id on success\n   232→\n   233→    Raises:\n   234→        MaxRetriesExceededError: After 3 failed attempts\n   235→    \"\"\"\n   236→    candidate_uuid = UUID(candidate_id)\n   237→    task_id = _compute_task_id(candidate_id)\n   238→    attempt = self.request.retries + 1\n   239→\n   240→    log = logger.bind(\n   241→        candidate_id=candidate_id,\n   242→        task_id=task_id,\n   243→        attempt=attempt,\n   244→        max_retries=self.max_retries,\n   245→    )\n   246→\n   247→    log.info(\"task.started\")\n   248→\n   249→    try:\n   250→        # Run the async orchestrator in a fresh event loop\n   251→        asyncio.run(_run_discovery(candidate_uuid))\n   252→\n   253→        log.info(\"task.completed\")\n   254→        return {\n   255→            \"status\": \"completed\",\n   256→            \"candidate_id\": candidate_id,\n   257→            \"task_id\": task_id,\n   258→        }\n   259→\n   260→    except Exception as exc:\n   261→        error_msg = str(exc)\n   262→        tb = traceback.format_exc()\n   263→\n   264→        log.error(\n   265→            \"task.failed\",\n   266→            error=error_msg,\n   267→            traceback=tb,\n   268→        )\n   269→\n   270→        # Check if we've exhausted retries\n   271→        if self.request.retries >= self.max_retries:\n   272→            log.error(\n   273→                \"task.max_retries_exceeded\",\n   274→                retries_exhausted=self.max_retries,\n   275→            )\n   276→\n   277→            # Write to crawl_runs.error_log and publish DAILY_TASK_DEAD\n   278→            asyncio.run(_mark_crawl_run_failed(candidate_uuid, tb))\n   279→            asyncio.run(\n   280→                _publish_dead_event(\n   281→                    candidate_uuid,\n   282→                    task_id,\n   283→                    error_msg,\n   284→                    self.max_retries,\n   285→                )\n   286→            )\n   287→\n   288→            # Re-raise to mark task as failed\n   289→            raise MaxRetriesExceededError(\n   290→                f\"Task {task_id} failed after {self.max_retries} retries: {error_msg}\"\n   291→            ) from exc\n   292→\n   293→        # Calculate countdown for next retry (exponential backoff)\n   294→        retry_index = min(self.request.retries, len(RETRY_COUNTDOWNS) - 1)\n   295→        countdown = RETRY_COUNTDOWNS[retry_index]\n   296→\n   297→        log.info(\n   298→            \"task.retrying\",\n   299→            countdown=countdown,\n   300→            next_attempt=attempt + 1,\n   301→        )\n   302→\n   303→        # Schedule retry with backoff\n   304→        raise self.retry(exc=exc, countdown=countdown)\n   305→\n   306→\n   307→def trigger_daily_discovery(candidate_id: str | UUID) -> str:\n   308→    \"\"\"Trigger a daily discovery task for a candidate.\n   309→\n   310→    This is a convenience function for programmatic triggering,\n   311→    e.g., from the API endpoint or Celery beat scheduler.\n   312→\n   313→    Args:\n   314→        candidate_id: UUID or string UUID of the candidate\n   315→\n   316→    Returns:\n   317→        The Celery task ID (idempotent, based on candidate + date)\n   318→    \"\"\"\n   319→    candidate_str = str(candidate_id)\n   320→    task_id = _compute_task_id(candidate_str)\n   321→\n   322→    daily_discovery_task.apply_async(\n   323→        args=[candidate_str],\n   324→        task_id=task_id,\n   325→    )\n   326→\n   327→    logger.info(\n   328→        \"task.triggered\",\n   329→        candidate_id=candidate_str,\n   330→        task_id=task_id,\n   331→    )\n   332→\n   333→    return task_id\n   334→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"ef9d5bd8-0780-4df4-9ad6-553a7652cb5c","uuid":"fd7086d7-5507-4070-85d0-895b413e6e06","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/scheduler/tasks.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"Celery task definitions for daily discovery runs.\n\nThis module defines the `daily_discovery_task` that wraps the async\nDiscoveryOrchestrator.run() with asyncio.run() for Celery's sync workers.\n\nRetry policy:\n    - 3 retries with exponential backoff: 60s, 300s, 900s\n    - On terminal failure: write traceback to crawl_runs.error_log\n    - Publish DAILY_TASK_DEAD event to agent.status.discovery\n\nIdempotency:\n    - Task ID format: discovery-{candidate_id}-{YYYY-MM-DD}\n    - Prevents duplicate runs if worker re-fires on the same day\n\nContract: HYPHA-SCHEDULER.md\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport traceback\nfrom datetime import date, datetime, timezone\nfrom uuid import UUID\n\nimport redis.asyncio as aioredis\nimport structlog\nfrom celery import Task\nfrom celery.exceptions import MaxRetriesExceededError\nfrom sqlalchemy import select\nfrom sqlalchemy.ext.asyncio import AsyncSession, create_async_engine, async_sessionmaker\n\nfrom backend.config import settings\nfrom backend.scheduler.celery_app import celery_app\nfrom backend.observability.events import PubSubChannel, publish_event, BaseEvent\n\n\nlogger = structlog.get_logger(__name__)\n\n# Retry countdown in seconds: 60s, 300s (5min), 900s (15min)\nRETRY_COUNTDOWNS = [60, 300, 900]\n\n\nclass DailyTaskDeadEvent(BaseEvent):\n    \"\"\"Event published when a daily discovery task exhausts all retries.\n\n    Published to: agent.status.discovery\n    \"\"\"\n\n    event: str = \"DAILY_TASK_DEAD\"\n    candidate_id: str\n    task_id: str\n    error: str\n    retries_exhausted: int\n\n\ndef _compute_task_id(candidate_id: str | UUID) -> str:\n    \"\"\"Compute idempotent task ID for a candidate on today's date (UTC).\n\n    Format: discovery-{candidate_id}-{YYYY-MM-DD}\n\n    Args:\n        candidate_id: The candidate's UUID\n\n    Returns:\n        Idempotent task ID string\n    \"\"\"\n    run_date = date.today().isoformat()\n    return f\"discovery-{candidate_id}-{run_date}\"\n\n\nasync def _run_discovery(candidate_id: UUID) -> None:\n    \"\"\"Run the async discovery orchestrator with fresh connections.\n\n    Creates a fresh DB session and Redis client for this invocation,\n    ensuring no connection pooling issues across Celery tasks.\n\n    Args:\n        candidate_id: UUID of the candidate to run discovery for\n\n    Raises:\n        Exception: Any error from the orchestrator is propagated\n    \"\"\"\n    # Import here to avoid circular imports at module load time\n    from backend.agents.discovery.orchestrator import DiscoveryOrchestrator\n\n    # Create fresh async engine for this task (no shared pool across workers)\n    engine = create_async_engine(\n        settings.database_url,\n        echo=False,\n        pool_pre_ping=True,\n        pool_size=1,\n        max_overflow=0,\n    )\n    session_factory = async_sessionmaker(\n        engine,\n        class_=AsyncSession,\n        expire_on_commit=False,\n    )\n\n    # Create fresh Redis client\n    redis_client = aioredis.from_url(\n        settings.redis_url,\n        decode_responses=True,\n    )\n\n    try:\n        async with session_factory() as db:\n            orchestrator = DiscoveryOrchestrator(db, redis_client)\n            await orchestrator.run(candidate_id, dry_run=False)\n    finally:\n        await redis_client.aclose()\n        await engine.dispose()\n\n\nasync def _mark_crawl_run_failed(candidate_id: UUID, error_log: str) -> None:\n    \"\"\"Mark the most recent RUNNING crawl run as FAILED with error log.\n\n    Args:\n        candidate_id: UUID of the candidate\n        error_log: Traceback or error message to record\n    \"\"\"\n    from backend.models.discovery import CrawlRun\n\n    engine = create_async_engine(\n        settings.database_url,\n        echo=False,\n        pool_pre_ping=True,\n        pool_size=1,\n        max_overflow=0,\n    )\n    session_factory = async_sessionmaker(\n        engine,\n        class_=AsyncSession,\n        expire_on_commit=False,\n    )\n\n    try:\n        async with session_factory() as db:\n            # Find the most recent RUNNING crawl run for this candidate\n            result = await db.execute(\n                select(CrawlRun)\n                .where(CrawlRun.candidate_id == candidate_id)\n                .where(CrawlRun.status == \"RUNNING\")\n                .order_by(CrawlRun.started_at.desc())\n                .limit(1)\n            )\n            crawl_run = result.scalar_one_or_none()\n\n            if crawl_run:\n                crawl_run.status = \"FAILED\"\n                crawl_run.completed_at = datetime.now(timezone.utc)\n                crawl_run.error_log = error_log\n                await db.commit()\n                logger.info(\n                    \"task.crawl_run_marked_failed\",\n                    crawl_run_id=str(crawl_run.id),\n                    candidate_id=str(candidate_id),\n                )\n            else:\n                logger.warning(\n                    \"task.no_running_crawl_run\",\n                    candidate_id=str(candidate_id),\n                )\n    finally:\n        await engine.dispose()\n\n\nasync def _publish_dead_event(\n    candidate_id: UUID, task_id: str, error: str, retries: int\n) -> None:\n    \"\"\"Publish DAILY_TASK_DEAD event to agent.status.discovery.\n\n    Args:\n        candidate_id: UUID of the candidate\n        task_id: The Celery task ID\n        error: Error message or traceback\n        retries: Number of retries exhausted\n    \"\"\"\n    redis_client = aioredis.from_url(\n        settings.redis_url,\n        decode_responses=True,\n    )\n\n    try:\n        event = DailyTaskDeadEvent(\n            candidate_id=str(candidate_id),\n            task_id=task_id,\n            error=error,\n            retries_exhausted=retries,\n        )\n        await publish_event(redis_client, PubSubChannel.DISCOVERY, event)\n        logger.info(\n            \"task.dead_event_published\",\n            candidate_id=str(candidate_id),\n            task_id=task_id,\n        )\n    finally:\n        await redis_client.aclose()\n\n\n@celery_app.task(\n    bind=True,\n    name=\"backend.scheduler.tasks.daily_discovery_task\",\n    max_retries=3,\n    default_retry_delay=60,\n    autoretry_for=(Exception,),\n    retry_backoff=False,  # We implement custom backoff via countdown\n    acks_late=True,\n    reject_on_worker_lost=True,\n    track_started=True,\n)\ndef daily_discovery_task(self: Task, candidate_id: str) -> dict:\n    \"\"\"Run daily job discovery for a single candidate.\n\n    This task wraps the async DiscoveryOrchestrator.run() with asyncio.run()\n    since Celery workers are synchronous by design. Each invocation creates\n    a fresh event loop, DB session, and Redis client.\n\n    Retry policy:\n        - 3 retries with exponential backoff: 60s, 300s, 900s\n        - On MaxRetriesExceededError: write to crawl_runs.error_log,\n          publish DAILY_TASK_DEAD, then re-raise\n\n    Args:\n        candidate_id: UUID string of the candidate\n\n    Returns:\n        dict with status and candidate_id on success\n\n    Raises:\n        MaxRetriesExceededError: After 3 failed attempts\n    \"\"\"\n    candidate_uuid = UUID(candidate_id)\n    task_id = _compute_task_id(candidate_id)\n    attempt = self.request.retries + 1\n\n    log = logger.bind(\n        candidate_id=candidate_id,\n        task_id=task_id,\n        attempt=attempt,\n        max_retries=self.max_retries,\n    )\n\n    log.info(\"task.started\")\n\n    try:\n        # Run the async orchestrator in a fresh event loop\n        asyncio.run(_run_discovery(candidate_uuid))\n\n        log.info(\"task.completed\")\n        return {\n            \"status\": \"completed\",\n            \"candidate_id\": candidate_id,\n            \"task_id\": task_id,\n        }\n\n    except Exception as exc:\n        error_msg = str(exc)\n        tb = traceback.format_exc()\n\n        log.error(\n            \"task.failed\",\n            error=error_msg,\n            traceback=tb,\n        )\n\n        # Check if we've exhausted retries\n        if self.request.retries >= self.max_retries:\n            log.error(\n                \"task.max_retries_exceeded\",\n                retries_exhausted=self.max_retries,\n            )\n\n            # Write to crawl_runs.error_log and publish DAILY_TASK_DEAD\n            asyncio.run(_mark_crawl_run_failed(candidate_uuid, tb))\n            asyncio.run(\n                _publish_dead_event(\n                    candidate_uuid,\n                    task_id,\n                    error_msg,\n                    self.max_retries,\n                )\n            )\n\n            # Re-raise to mark task as failed\n            raise MaxRetriesExceededError(\n                f\"Task {task_id} failed after {self.max_retries} retries: {error_msg}\"\n            ) from exc\n\n        # Calculate countdown for next retry (exponential backoff)\n        retry_index = min(self.request.retries, len(RETRY_COUNTDOWNS) - 1)\n        countdown = RETRY_COUNTDOWNS[retry_index]\n\n        log.info(\n            \"task.retrying\",\n            countdown=countdown,\n            next_attempt=attempt + 1,\n        )\n\n        # Schedule retry with backoff\n        raise self.retry(exc=exc, countdown=countdown)\n\n\ndef trigger_daily_discovery(candidate_id: str | UUID) -> str:\n    \"\"\"Trigger a daily discovery task for a candidate.\n\n    This is a convenience function for programmatic triggering,\n    e.g., from the API endpoint or Celery beat scheduler.\n\n    Args:\n        candidate_id: UUID or string UUID of the candidate\n\n    Returns:\n        The Celery task ID (idempotent, based on candidate + date)\n    \"\"\"\n    candidate_str = str(candidate_id)\n    task_id = _compute_task_id(candidate_str)\n\n    daily_discovery_task.apply_async(\n        args=[candidate_str],\n        task_id=task_id,\n    )\n\n    logger.info(\n        \"task.triggered\",\n        candidate_id=candidate_str,\n        task_id=task_id,\n    )\n\n    return task_id\n","numLines":334,"startLine":1,"totalLines":334}}}}
