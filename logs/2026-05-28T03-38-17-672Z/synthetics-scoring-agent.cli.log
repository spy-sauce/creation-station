{"t":"2026-05-28T03:44:24.485Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Fz63334Yv3DL4ezp7pHPUD","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Backend synthetics package for Talent Agent.\n     6→\n     7→Provides deterministic scoring drift detection via:\n     8→    - ScoringSyntheticRunner: Iterates synthetic candidates × JDs\n     9→    - compute_fingerprint: Produces stable JSON fingerprints\n    10→    - diff_against_baseline: Compares fingerprints for drift\n    11→\n    12→Contract: NUTRIENTS.md §I.2-I.5, HYPHA-SYNTHETICS-SCORING.md\n    13→\"\"\"\n    14→\n    15→from backend.synthetics.fingerprint import (\n    16→    ScoringFingerprint,\n    17→    compute_fingerprint,\n    18→    load_baseline,\n    19→    save_baseline,\n    20→    FingerprintContract,\n    21→)\n    22→from backend.synthetics.scoring_runner import ScoringSyntheticRunner\n    23→\n    24→__all__ = [\n    25→    \"ScoringSyntheticRunner\",\n    26→    \"ScoringFingerprint\",\n    27→    \"compute_fingerprint\",\n    28→    \"load_baseline\",\n    29→    \"save_baseline\",\n    30→    \"FingerprintContract\",\n    31→]\n    32→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"d03d3d20-5f6b-41a7-88e6-34cec2448ac8","uuid":"4971a193-2b0b-4400-b802-e5fe5ae6c193","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/synthetics/__init__.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nBackend synthetics package for Talent Agent.\n\nProvides deterministic scoring drift detection via:\n    - ScoringSyntheticRunner: Iterates synthetic candidates × JDs\n    - compute_fingerprint: Produces stable JSON fingerprints\n    - diff_against_baseline: Compares fingerprints for drift\n\nContract: NUTRIENTS.md §I.2-I.5, HYPHA-SYNTHETICS-SCORING.md\n\"\"\"\n\nfrom backend.synthetics.fingerprint import (\n    ScoringFingerprint,\n    compute_fingerprint,\n    load_baseline,\n    save_baseline,\n    FingerprintContract,\n)\nfrom backend.synthetics.scoring_runner import ScoringSyntheticRunner\n\n__all__ = [\n    \"ScoringSyntheticRunner\",\n    \"ScoringFingerprint\",\n    \"compute_fingerprint\",\n    \"load_baseline\",\n    \"save_baseline\",\n    \"FingerprintContract\",\n]\n","numLines":32,"startLine":1,"totalLines":32}}}}
{"t":"2026-05-28T03:44:24.495Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SvQ2pSBA51Z6evbbrYWagk","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Fingerprint module — produces stable JSON fingerprints for drift detection.\n     6→\n     7→Computes deterministic fingerprints from scoring results that can be compared\n     8→across runs. The fingerprint captures both exact-match fields (ordering, IDs)\n     9→and tolerance-match fields (scores with bounded variance).\n    10→\n    11→Stability guarantees:\n    12→    1. Arrays sorted by deterministic keys (job_id for top_picks)\n    13→    2. Floats rounded to 4 decimal places to avoid IEEE precision drift\n    14→    3. Timestamps and run_ids excluded from comparison\n    15→    4. First 5 top_picks ordering captured as exact-match field\n    16→\n    17→Contract: NUTRIENTS.md §I.2-I.5, HYPHA-SYNTHETICS-SCORING.md\n    18→Owner: synthetics-scoring-agent.fingerprint\n    19→\"\"\"\n    20→\n    21→from __future__ import annotations\n    22→\n    23→from datetime import datetime, timezone\n    24→from typing import Optional\n    25→\n    26→import structlog\n    27→from pydantic import BaseModel, Field\n    28→\n    29→logger = structlog.get_logger(__name__)\n    30→\n    31→\n    32→# ─── Contract Fields (from NUTRIENTS.md §I.2) ─────────────────────────────────\n    33→\n    34→\n    35→class ToleranceSpec(BaseModel):\n    36→    \"\"\"Tolerance specification for a numeric field.\"\"\"\n    37→\n    38→    tolerance: float = Field(description=\"Allowed variance as ratio (0.05 = ±5%)\")\n    39→\n    40→\n    41→# Default tolerance thresholds from NUTRIENTS.md §I.2\n    42→TOLERANCE_THRESHOLDS = {\n    43→    \"technical_match\": ToleranceSpec(tolerance=0.05),\n    44→    \"level_match\": ToleranceSpec(tolerance=0.05),\n    45→    \"culture_match\": ToleranceSpec(tolerance=0.05),\n    46→    \"industry_match\": ToleranceSpec(tolerance=0.05),\n    47→    \"growth_potential\": ToleranceSpec(tolerance=0.05),\n    48→    \"compensation_match\": ToleranceSpec(tolerance=0.05),\n    49→    \"composite_score\": ToleranceSpec(tolerance=0.03),\n    50→    \"total_jobs_discovered\": ToleranceSpec(tolerance=0.10),\n    51→}\n    52→\n    53→\n    54→# ─── Top Pick Fingerprint ─────────────────────────────────────────────────────\n    55→\n    56→\n    57→class TopPickFingerprint(BaseModel):\n    58→    \"\"\"\n    59→    Fingerprint for a single top pick in the digest.\n    60→\n    61→    Captures the exact-match fields: job_id, source, url, position.\n    62→    \"\"\"\n    63→\n    64→    job_id: str = Field(description=\"Deterministic job ID (synthetic JD UUID)\")\n    65→    source: str = Field(description=\"Job source (greenhouse, lever, etc.)\")\n    66→    url: str = Field(description=\"Job URL\")\n    67→    position: int = Field(description=\"Position in top_picks (0-indexed)\")\n    68→\n    69→\n    70→# ─── Tolerance Field Value ────────────────────────────────────────────────────\n    71→\n    72→\n    73→class ToleranceFieldValue(BaseModel):\n    74→    \"\"\"\n    75→    Value for a tolerance-match field with drift tracking.\n    76→\n    77→    Stores current value, baseline value (if exists), and computed drift %.\n    78→    \"\"\"\n    79→\n    80→    value: float = Field(description=\"Current value (rounded to 4 decimals)\")\n    81→    baseline: Optional[float] = Field(\n    82→        default=None,\n    83→        description=\"Baseline value for comparison (null if no baseline)\",\n    84→    )\n    85→    drift_pct: Optional[float] = Field(\n    86→        default=None,\n    87→        description=\"Drift percentage from baseline (null if no baseline)\",\n    88→    )\n    89→\n    90→\n    91→# ─── Exact Fields Container ───────────────────────────────────────────────────\n    92→\n    93→\n    94→class ExactFields(BaseModel):\n    95→    \"\"\"\n    96→    Container for exact-match fields in the fingerprint.\n    97→\n    98→    Per NUTRIENTS.md §I.2, these fields MUST be byte-identical between runs.\n    99→    Any difference is a drift violation.\n   100→    \"\"\"\n   101→\n   102→    top_picks: list[TopPickFingerprint] = Field(\n   103→        default_factory=list,\n   104→        description=\"First 5 top picks with position (exact-match)\",\n   105→    )\n   106→\n   107→\n   108→# ─── Tolerance Fields Container ───────────────────────────────────────────────\n   109→\n   110→\n   111→class ToleranceFields(BaseModel):\n   112→    \"\"\"\n   113→    Container for tolerance-match fields in the fingerprint.\n   114→\n   115→    Per NUTRIENTS.md §I.2, these fields allow bounded variance (±N%).\n   116→    Exceeding the tolerance is a drift violation.\n   117→    \"\"\"\n   118→\n   119→    technical_match: ToleranceFieldValue\n   120→    level_match: ToleranceFieldValue\n   121→    culture_match: ToleranceFieldValue\n   122→    industry_match: ToleranceFieldValue\n   123→    growth_potential: ToleranceFieldValue\n   124→    compensation_match: ToleranceFieldValue\n   125→    composite_score: ToleranceFieldValue\n   126→    total_jobs_discovered: ToleranceFieldValue\n   127→\n   128→\n   129→# ─── Scoring Fingerprint ──────────────────────────────────────────────────────\n   130→\n   131→\n   132→class ScoringFingerprint(BaseModel):\n   133→    \"\"\"\n   134→    Stable fingerprint for a candidate's scoring results.\n   135→\n   136→    This is the unit of comparison for drift detection. Contains both\n   137→    exact-match fields (must be byte-identical) and tolerance-match\n   138→    fields (allow bounded variance).\n   139→\n   140→    Per HYPHA-SYNTHETICS-SCORING.md, fingerprints must be byte-stable\n   141→    across runs given the same inputs.\n   142→\n   143→    Contract: NUTRIENTS.md §I.9 (ScoringFingerprint)\n   144→    \"\"\"\n   145→\n   146→    candidate_id: str = Field(description=\"Synthetic candidate UUID\")\n   147→    run_id: str = Field(description=\"UUID of the run that produced this fingerprint\")\n   148→    computed_at: str = Field(description=\"ISO-8601 timestamp of computation\")\n   149→    exact_fields: ExactFields = Field(\n   150→        default_factory=ExactFields,\n   151→        description=\"Fields that must be byte-identical\",\n   152→    )\n   153→    tolerance_fields: ToleranceFields = Field(\n   154→        description=\"Fields that allow bounded variance\",\n   155→    )\n   156→\n   157→\n   158→# ─── Fingerprint Contract ─────────────────────────────────────────────────────\n   159→\n   160→\n   161→class FingerprintContract(BaseModel):\n   162→    \"\"\"\n   163→    Contract defining which fields are exact-match vs tolerance-match.\n   164→\n   165→    Used by compute_fingerprint to determine how to extract and normalize\n   166→    values from scoring results.\n   167→    \"\"\"\n   168→\n   169→    exact_fields: list[str] = Field(\n   170→        default_factory=lambda: [\n   171→            \"digest.top_picks[0..4].job.id\",\n   172→            \"digest.top_picks[0..4].job.source\",\n   173→            \"digest.top_picks[0..4].job.url\",\n   174→            \"digest.top_picks[0..4].ordering\",\n   175→        ],\n   176→        description=\"Fields requiring byte-identical match\",\n   177→    )\n   178→\n   179→    tolerance_fields: dict[str, float] = Field(\n   180→        default_factory=lambda: {\n   181→            \"score.technical_match\": 0.05,\n   182→            \"score.level_match\": 0.05,\n   183→            \"score.culture_match\": 0.05,\n   184→            \"score.industry_match\": 0.05,\n   185→            \"score.growth_potential\": 0.05,\n   186→            \"score.compensation_match\": 0.05,\n   187→            \"composite_score\": 0.03,\n   188→            \"total_jobs_discovered\": 0.10,\n   189→        },\n   190→        description=\"Field -> tolerance (as ratio)\",\n   191→    )\n   192→\n   193→    excluded_fields: list[str] = Field(\n   194→        default_factory=lambda: [\n   195→            \"created_at\",\n   196→            \"updated_at\",\n   197→            \"run_id\",\n   198→            \"crawl_run.duration_seconds\",\n   199→            \"crawl_run.started_at\",\n   200→            \"crawl_run.completed_at\",\n   201→            \"non_synthetic_uuids\",\n   202→        ],\n   203→        description=\"Fields excluded from all comparisons\",\n   204→    )\n   205→\n   206→\n   207→# ─── Fingerprint Computation ──────────────────────────────────────────────────\n   208→\n   209→\n   210→def compute_fingerprint(\n   211→    candidate_scoring_result: dict,\n   212→    contract: Optional[FingerprintContract] = None,\n   213→    baseline: Optional[ScoringFingerprint] = None,\n   214→) -> ScoringFingerprint:\n   215→    \"\"\"\n   216→    Compute a stable fingerprint from scoring results.\n   217→\n   218→    Takes the raw scoring output from ScoringSyntheticRunner and produces\n   219→    a deterministic fingerprint suitable for drift comparison.\n   220→\n   221→    Stability guarantees:\n   222→        1. Top picks sorted by job_id before position assignment\n   223→        2. All floats rounded to 4 decimal places\n   224→        3. Timestamps excluded (only computed_at for reference)\n   225→        4. Only first 5 top picks captured\n   226→\n   227→    Args:\n   228→        candidate_scoring_result: Dict from CandidateScoringResult.model_dump()\n   229→            Expected keys: candidate_id, scored_results, cache_stats\n   230→        contract: Optional FingerprintContract defining comparison rules\n   231→            Defaults to standard contract from NUTRIENTS.md §I.2\n   232→        baseline: Optional baseline fingerprint for drift calculation\n   233→\n   234→    Returns:\n   235→        ScoringFingerprint with exact and tolerance fields populated\n   236→\n   237→    Example:\n   238→        >>> result = await runner.run_suite()\n   239→        >>> for candidate in result[\"candidates\"]:\n   240→        ...     fp = compute_fingerprint(candidate)\n   241→        ...     print(fp.candidate_id, fp.tolerance_fields.composite_score.value)\n   242→    \"\"\"\n   243→    if contract is None:\n   244→        contract = FingerprintContract()\n   245→\n   246→    candidate_id = candidate_scoring_result.get(\"candidate_id\", \"unknown\")\n   247→    scored_results = candidate_scoring_result.get(\"scored_results\", [])\n   248→\n   249→    logger.debug(\n   250→        \"fingerprint.computing\",\n   251→        candidate_id=candidate_id,\n   252→        scored_results_count=len(scored_results),\n   253→    )\n   254→\n   255→    # Extract and sort scored results for deterministic ordering\n   256→    # Sort by jd_filename for reproducibility\n   257→    sorted_results = sorted(\n   258→        [r for r in scored_results if r.get(\"scored_job\") is not None],\n   259→        key=lambda r: r.get(\"jd_filename\", \"\"),\n   260→    )\n   261→\n   262→    # Compute exact fields: first 5 top picks by composite score\n   263→    top_results = sorted(\n   264→        sorted_results,\n   265→        key=lambda r: r.get(\"scored_job\", {}).get(\"composite_score\", 0),\n   266→        reverse=True,\n   267→    )[:5]\n   268→\n   269→    top_picks: list[TopPickFingerprint] = []\n   270→    for position, result in enumerate(top_results):\n   271→        scored_job = result.get(\"scored_job\", {})\n   272→        top_picks.append(\n   273→            TopPickFingerprint(\n   274→                job_id=str(scored_job.get(\"discovered_job_id\", \"\")),\n   275→                source=str(result.get(\"jd_filename\", \"\").split(\"-\")[0]),  # Extract source prefix\n   276→                url=str(scored_job.get(\"url\", \"\")),\n   277→                position=position,\n   278→            )\n   279→        )\n   280→\n   281→    exact_fields = ExactFields(top_picks=top_picks)\n   282→\n   283→    # Compute tolerance fields: aggregate score dimensions\n   284→    tolerance_fields = _compute_tolerance_fields(\n   285→        scored_results,\n   286→        baseline,\n   287→    )\n   288→\n   289→    # Generate deterministic run_id from candidate_id + computed_at\n   290→    computed_at = datetime.now(timezone.utc).isoformat()\n   291→\n   292→    fingerprint = ScoringFingerprint(\n   293→        candidate_id=candidate_id,\n   294→        run_id=candidate_scoring_result.get(\"run_id\", \"unknown\"),\n   295→        computed_at=computed_at,\n   296→        exact_fields=exact_fields,\n   297→        tolerance_fields=tolerance_fields,\n   298→    )\n   299→\n   300→    logger.info(\n   301→        \"fingerprint.computed\",\n   302→        candidate_id=candidate_id,\n   303→        top_picks_count=len(top_picks),\n   304→        composite_score=tolerance_fields.composite_score.value,\n   305→    )\n   306→\n   307→    return fingerprint\n   308→\n   309→\n   310→def _compute_tolerance_fields(\n   311→    scored_results: list[dict],\n   312→    baseline: Optional[ScoringFingerprint],\n   313→) -> ToleranceFields:\n   314→    \"\"\"\n   315→    Compute tolerance field values from scored results.\n   316→\n   317→    Aggregates score dimensions across all scored jobs and computes\n   318→    drift percentage if a baseline is provided.\n   319→\n   320→    Args:\n   321→        scored_results: List of scoring result dicts\n   322→        baseline: Optional baseline fingerprint for drift calculation\n   323→\n   324→    Returns:\n   325→        ToleranceFields with aggregated values and drift percentages\n   326→    \"\"\"\n   327→    # Collect all score dimensions\n   328→    tech_scores: list[int] = []\n   329→    level_scores: list[int] = []\n   330→    culture_scores: list[int] = []\n   331→    industry_scores: list[int] = []\n   332→    growth_scores: list[int] = []\n   333→    comp_scores: list[int] = []\n   334→    composite_scores: list[int] = []\n   335→\n   336→    for result in scored_results:\n   337→        scored_job = result.get(\"scored_job\")\n   338→        if scored_job is None:\n   339→            continue\n   340→\n   341→        breakdown = scored_job.get(\"score_breakdown\", {})\n   342→        tech_scores.append(breakdown.get(\"technical_match\", 0))\n   343→        level_scores.append(breakdown.get(\"level_match\", 0))\n   344→        culture_scores.append(breakdown.get(\"culture_match\", 0))\n   345→        industry_scores.append(breakdown.get(\"industry_match\", 0))\n   346→        growth_scores.append(breakdown.get(\"growth_potential\", 0))\n   347→        comp_scores.append(breakdown.get(\"compensation_match\", 0))\n   348→        composite_scores.append(scored_job.get(\"composite_score\", 0))\n   349→\n   350→    # Compute averages (rounded to 4 decimals for stability)\n   351→    def avg(scores: list[int]) -> float:\n   352→        if not scores:\n   353→            return 0.0\n   354→        return round(sum(scores) / len(scores), 4)\n   355→\n   356→    tech_avg = avg(tech_scores)\n   357→    level_avg = avg(level_scores)\n   358→    culture_avg = avg(culture_scores)\n   359→    industry_avg = avg(industry_scores)\n   360→    growth_avg = avg(growth_scores)\n   361→    comp_avg = avg(comp_scores)\n   362→    composite_avg = avg(composite_scores)\n   363→    total_discovered = float(len(scored_results))\n   364→\n   365→    # Helper to compute drift percentage\n   366→    def drift_pct(current: float, baseline_val: Optional[float]) -> Optional[float]:\n   367→        if baseline_val is None or baseline_val == 0:\n   368→            return None\n   369→        return round((current - baseline_val) / baseline_val, 4)\n   370→\n   371→    # Extract baseline values if present\n   372→    baseline_tech = None\n   373→    baseline_level = None\n   374→    baseline_culture = None\n   375→    baseline_industry = None\n   376→    baseline_growth = None\n   377→    baseline_comp = None\n   378→    baseline_composite = None\n   379→    baseline_discovered = None\n   380→\n   381→    if baseline is not None:\n   382→        baseline_tech = baseline.tolerance_fields.technical_match.value\n   383→        baseline_level = baseline.tolerance_fields.level_match.value\n   384→        baseline_culture = baseline.tolerance_fields.culture_match.value\n   385→        baseline_industry = baseline.tolerance_fields.industry_match.value\n   386→        baseline_growth = baseline.tolerance_fields.growth_potential.value\n   387→        baseline_comp = baseline.tolerance_fields.compensation_match.value\n   388→        baseline_composite = baseline.tolerance_fields.composite_score.value\n   389→        baseline_discovered = baseline.tolerance_fields.total_jobs_discovered.value\n   390→\n   391→    return ToleranceFields(\n   392→        technical_match=ToleranceFieldValue(\n   393→            value=tech_avg,\n   394→            baseline=baseline_tech,\n   395→            drift_pct=drift_pct(tech_avg, baseline_tech),\n   396→        ),\n   397→        level_match=ToleranceFieldValue(\n   398→            value=level_avg,\n   399→            baseline=baseline_level,\n   400→            drift_pct=drift_pct(level_avg, baseline_level),\n   401→        ),\n   402→        culture_match=ToleranceFieldValue(\n   403→            value=culture_avg,\n   404→            baseline=baseline_culture,\n   405→            drift_pct=drift_pct(culture_avg, baseline_culture),\n   406→        ),\n   407→        industry_match=ToleranceFieldValue(\n   408→            value=industry_avg,\n   409→            baseline=baseline_industry,\n   410→            drift_pct=drift_pct(industry_avg, baseline_industry),\n   411→        ),\n   412→        growth_potential=ToleranceFieldValue(\n   413→            value=growth_avg,\n   414→            baseline=baseline_growth,\n   415→            drift_pct=drift_pct(growth_avg, baseline_growth),\n   416→        ),\n   417→        compensation_match=ToleranceFieldValue(\n   418→            value=comp_avg,\n   419→            baseline=baseline_comp,\n   420→            drift_pct=drift_pct(comp_avg, baseline_comp),\n   421→        ),\n   422→        composite_score=ToleranceFieldValue(\n   423→            value=composite_avg,\n   424→            baseline=baseline_composite,\n   425→            drift_pct=drift_pct(composite_avg, baseline_composite),\n   426→        ),\n   427→        total_jobs_discovered=ToleranceFieldValue(\n   428→            value=total_discovered,\n   429→            baseline=baseline_discovered,\n   430→            drift_pct=drift_pct(total_discovered, baseline_discovered),\n   431→        ),\n   432→    )\n   433→\n   434→\n   435→# ─── Baseline Loading ─────────────────────────────────────────────────────────\n   436→\n   437→\n   438→def load_baseline(\n   439→    baselines_dir: str,\n   440→    candidate_id: str,\n   441→) -> Optional[ScoringFingerprint]:\n   442→    \"\"\"\n   443→    Load the latest accepted baseline for a candidate.\n   444→\n   445→    Baselines are stored at:\n   446→        synthetics/fixtures/baselines/<candidate_id>__<run_id>.json\n   447→\n   448→    Only committed baselines are considered valid. The latest by\n   449→    accepted_at timestamp is returned.\n   450→\n   451→    Args:\n   452→        baselines_dir: Path to synthetics/fixtures/baselines/\n   453→        candidate_id: Synthetic candidate UUID\n   454→\n   455→    Returns:\n   456→        ScoringFingerprint from baseline, or None if no baseline exists\n   457→    \"\"\"\n   458→    import json\n   459→    from pathlib import Path\n   460→\n   461→    baselines_path = Path(baselines_dir)\n   462→    if not baselines_path.exists():\n   463→        logger.debug(\"fingerprint.baseline_dir_not_found\", path=baselines_dir)\n   464→        return None\n   465→\n   466→    # Find all baselines for this candidate\n   467→    pattern = f\"{candidate_id}__*.json\"\n   468→    baseline_files = list(baselines_path.glob(pattern))\n   469→\n   470→    if not baseline_files:\n   471→        logger.debug(\n   472→            \"fingerprint.no_baseline\",\n   473→            candidate_id=candidate_id,\n   474→            pattern=pattern,\n   475→        )\n   476→        return None\n   477→\n   478→    # Sort by file modification time (latest first)\n   479→    baseline_files.sort(key=lambda f: f.stat().st_mtime, reverse=True)\n   480→    latest_file = baseline_files[0]\n   481→\n   482→    logger.debug(\n   483→        \"fingerprint.loading_baseline\",\n   484→        candidate_id=candidate_id,\n   485→        file=str(latest_file),\n   486→    )\n   487→\n   488→    try:\n   489→        with open(latest_file) as f:\n   490→            data = json.load(f)\n   491→            # Extract just the fingerprint portion\n   492→            fingerprint_data = data.get(\"fingerprint\", data)\n   493→            return ScoringFingerprint.model_validate(fingerprint_data)\n   494→    except Exception as e:\n   495→        logger.error(\n   496→            \"fingerprint.baseline_load_error\",\n   497→            file=str(latest_file),\n   498→            error=str(e),\n   499→        )\n   500→        return None\n   501→\n   502→\n   503→def save_baseline(\n   504→    baselines_dir: str,\n   505→    fingerprint: ScoringFingerprint,\n   506→) -> str:\n   507→    \"\"\"\n   508→    Save a fingerprint as a baseline (for baseline acceptance workflow).\n   509→\n   510→    Creates a file at:\n   511→        synthetics/fixtures/baselines/<candidate_id>__<run_id>.json\n   512→\n   513→    Note: This function writes the file but does NOT commit it.\n   514→    Baseline acceptance requires explicit commit via:\n   515→        mycelium synthetics baseline accept <run_id>\n   516→\n   517→    Args:\n   518→        baselines_dir: Path to synthetics/fixtures/baselines/\n   519→        fingerprint: ScoringFingerprint to save\n   520→\n   521→    Returns:\n   522→        Path to the saved baseline file\n   523→    \"\"\"\n   524→    import json\n   525→    from pathlib import Path\n   526→\n   527→    baselines_path = Path(baselines_dir)\n   528→    baselines_path.mkdir(parents=True, exist_ok=True)\n   529→\n   530→    filename = f\"{fingerprint.candidate_id}__{fingerprint.run_id}.json\"\n   531→    filepath = baselines_path / filename\n   532→\n   533→    baseline_record = {\n   534→        \"candidate_id\": fingerprint.candidate_id,\n   535→        \"run_id\": fingerprint.run_id,\n   536→        \"accepted_at\": datetime.now(timezone.utc).isoformat(),\n   537→        \"fingerprint\": fingerprint.model_dump(),\n   538→    }\n   539→\n   540→    with open(filepath, \"w\") as f:\n   541→        json.dump(baseline_record, f, indent=2)\n   542→\n   543→    logger.info(\n   544→        \"fingerprint.baseline_saved\",\n   545→        candidate_id=fingerprint.candidate_id,\n   546→        run_id=fingerprint.run_id,\n   547→        file=str(filepath),\n   548→    )\n   549→\n   550→    return str(filepath)\n   551→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"d03d3d20-5f6b-41a7-88e6-34cec2448ac8","uuid":"5f02f4d7-a625-458e-91f6-24d342d09a86","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/synthetics/fingerprint.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nFingerprint module — produces stable JSON fingerprints for drift detection.\n\nComputes deterministic fingerprints from scoring results that can be compared\nacross runs. The fingerprint captures both exact-match fields (ordering, IDs)\nand tolerance-match fields (scores with bounded variance).\n\nStability guarantees:\n    1. Arrays sorted by deterministic keys (job_id for top_picks)\n    2. Floats rounded to 4 decimal places to avoid IEEE precision drift\n    3. Timestamps and run_ids excluded from comparison\n    4. First 5 top_picks ordering captured as exact-match field\n\nContract: NUTRIENTS.md §I.2-I.5, HYPHA-SYNTHETICS-SCORING.md\nOwner: synthetics-scoring-agent.fingerprint\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import datetime, timezone\nfrom typing import Optional\n\nimport structlog\nfrom pydantic import BaseModel, Field\n\nlogger = structlog.get_logger(__name__)\n\n\n# ─── Contract Fields (from NUTRIENTS.md §I.2) ─────────────────────────────────\n\n\nclass ToleranceSpec(BaseModel):\n    \"\"\"Tolerance specification for a numeric field.\"\"\"\n\n    tolerance: float = Field(description=\"Allowed variance as ratio (0.05 = ±5%)\")\n\n\n# Default tolerance thresholds from NUTRIENTS.md §I.2\nTOLERANCE_THRESHOLDS = {\n    \"technical_match\": ToleranceSpec(tolerance=0.05),\n    \"level_match\": ToleranceSpec(tolerance=0.05),\n    \"culture_match\": ToleranceSpec(tolerance=0.05),\n    \"industry_match\": ToleranceSpec(tolerance=0.05),\n    \"growth_potential\": ToleranceSpec(tolerance=0.05),\n    \"compensation_match\": ToleranceSpec(tolerance=0.05),\n    \"composite_score\": ToleranceSpec(tolerance=0.03),\n    \"total_jobs_discovered\": ToleranceSpec(tolerance=0.10),\n}\n\n\n# ─── Top Pick Fingerprint ─────────────────────────────────────────────────────\n\n\nclass TopPickFingerprint(BaseModel):\n    \"\"\"\n    Fingerprint for a single top pick in the digest.\n\n    Captures the exact-match fields: job_id, source, url, position.\n    \"\"\"\n\n    job_id: str = Field(description=\"Deterministic job ID (synthetic JD UUID)\")\n    source: str = Field(description=\"Job source (greenhouse, lever, etc.)\")\n    url: str = Field(description=\"Job URL\")\n    position: int = Field(description=\"Position in top_picks (0-indexed)\")\n\n\n# ─── Tolerance Field Value ────────────────────────────────────────────────────\n\n\nclass ToleranceFieldValue(BaseModel):\n    \"\"\"\n    Value for a tolerance-match field with drift tracking.\n\n    Stores current value, baseline value (if exists), and computed drift %.\n    \"\"\"\n\n    value: float = Field(description=\"Current value (rounded to 4 decimals)\")\n    baseline: Optional[float] = Field(\n        default=None,\n        description=\"Baseline value for comparison (null if no baseline)\",\n    )\n    drift_pct: Optional[float] = Field(\n        default=None,\n        description=\"Drift percentage from baseline (null if no baseline)\",\n    )\n\n\n# ─── Exact Fields Container ───────────────────────────────────────────────────\n\n\nclass ExactFields(BaseModel):\n    \"\"\"\n    Container for exact-match fields in the fingerprint.\n\n    Per NUTRIENTS.md §I.2, these fields MUST be byte-identical between runs.\n    Any difference is a drift violation.\n    \"\"\"\n\n    top_picks: list[TopPickFingerprint] = Field(\n        default_factory=list,\n        description=\"First 5 top picks with position (exact-match)\",\n    )\n\n\n# ─── Tolerance Fields Container ───────────────────────────────────────────────\n\n\nclass ToleranceFields(BaseModel):\n    \"\"\"\n    Container for tolerance-match fields in the fingerprint.\n\n    Per NUTRIENTS.md §I.2, these fields allow bounded variance (±N%).\n    Exceeding the tolerance is a drift violation.\n    \"\"\"\n\n    technical_match: ToleranceFieldValue\n    level_match: ToleranceFieldValue\n    culture_match: ToleranceFieldValue\n    industry_match: ToleranceFieldValue\n    growth_potential: ToleranceFieldValue\n    compensation_match: ToleranceFieldValue\n    composite_score: ToleranceFieldValue\n    total_jobs_discovered: ToleranceFieldValue\n\n\n# ─── Scoring Fingerprint ──────────────────────────────────────────────────────\n\n\nclass ScoringFingerprint(BaseModel):\n    \"\"\"\n    Stable fingerprint for a candidate's scoring results.\n\n    This is the unit of comparison for drift detection. Contains both\n    exact-match fields (must be byte-identical) and tolerance-match\n    fields (allow bounded variance).\n\n    Per HYPHA-SYNTHETICS-SCORING.md, fingerprints must be byte-stable\n    across runs given the same inputs.\n\n    Contract: NUTRIENTS.md §I.9 (ScoringFingerprint)\n    \"\"\"\n\n    candidate_id: str = Field(description=\"Synthetic candidate UUID\")\n    run_id: str = Field(description=\"UUID of the run that produced this fingerprint\")\n    computed_at: str = Field(description=\"ISO-8601 timestamp of computation\")\n    exact_fields: ExactFields = Field(\n        default_factory=ExactFields,\n        description=\"Fields that must be byte-identical\",\n    )\n    tolerance_fields: ToleranceFields = Field(\n        description=\"Fields that allow bounded variance\",\n    )\n\n\n# ─── Fingerprint Contract ─────────────────────────────────────────────────────\n\n\nclass FingerprintContract(BaseModel):\n    \"\"\"\n    Contract defining which fields are exact-match vs tolerance-match.\n\n    Used by compute_fingerprint to determine how to extract and normalize\n    values from scoring results.\n    \"\"\"\n\n    exact_fields: list[str] = Field(\n        default_factory=lambda: [\n            \"digest.top_picks[0..4].job.id\",\n            \"digest.top_picks[0..4].job.source\",\n            \"digest.top_picks[0..4].job.url\",\n            \"digest.top_picks[0..4].ordering\",\n        ],\n        description=\"Fields requiring byte-identical match\",\n    )\n\n    tolerance_fields: dict[str, float] = Field(\n        default_factory=lambda: {\n            \"score.technical_match\": 0.05,\n            \"score.level_match\": 0.05,\n            \"score.culture_match\": 0.05,\n            \"score.industry_match\": 0.05,\n            \"score.growth_potential\": 0.05,\n            \"score.compensation_match\": 0.05,\n            \"composite_score\": 0.03,\n            \"total_jobs_discovered\": 0.10,\n        },\n        description=\"Field -> tolerance (as ratio)\",\n    )\n\n    excluded_fields: list[str] = Field(\n        default_factory=lambda: [\n            \"created_at\",\n            \"updated_at\",\n            \"run_id\",\n            \"crawl_run.duration_seconds\",\n            \"crawl_run.started_at\",\n            \"crawl_run.completed_at\",\n            \"non_synthetic_uuids\",\n        ],\n        description=\"Fields excluded from all comparisons\",\n    )\n\n\n# ─── Fingerprint Computation ──────────────────────────────────────────────────\n\n\ndef compute_fingerprint(\n    candidate_scoring_result: dict,\n    contract: Optional[FingerprintContract] = None,\n    baseline: Optional[ScoringFingerprint] = None,\n) -> ScoringFingerprint:\n    \"\"\"\n    Compute a stable fingerprint from scoring results.\n\n    Takes the raw scoring output from ScoringSyntheticRunner and produces\n    a deterministic fingerprint suitable for drift comparison.\n\n    Stability guarantees:\n        1. Top picks sorted by job_id before position assignment\n        2. All floats rounded to 4 decimal places\n        3. Timestamps excluded (only computed_at for reference)\n        4. Only first 5 top picks captured\n\n    Args:\n        candidate_scoring_result: Dict from CandidateScoringResult.model_dump()\n            Expected keys: candidate_id, scored_results, cache_stats\n        contract: Optional FingerprintContract defining comparison rules\n            Defaults to standard contract from NUTRIENTS.md §I.2\n        baseline: Optional baseline fingerprint for drift calculation\n\n    Returns:\n        ScoringFingerprint with exact and tolerance fields populated\n\n    Example:\n        >>> result = await runner.run_suite()\n        >>> for candidate in result[\"candidates\"]:\n        ...     fp = compute_fingerprint(candidate)\n        ...     print(fp.candidate_id, fp.tolerance_fields.composite_score.value)\n    \"\"\"\n    if contract is None:\n        contract = FingerprintContract()\n\n    candidate_id = candidate_scoring_result.get(\"candidate_id\", \"unknown\")\n    scored_results = candidate_scoring_result.get(\"scored_results\", [])\n\n    logger.debug(\n        \"fingerprint.computing\",\n        candidate_id=candidate_id,\n        scored_results_count=len(scored_results),\n    )\n\n    # Extract and sort scored results for deterministic ordering\n    # Sort by jd_filename for reproducibility\n    sorted_results = sorted(\n        [r for r in scored_results if r.get(\"scored_job\") is not None],\n        key=lambda r: r.get(\"jd_filename\", \"\"),\n    )\n\n    # Compute exact fields: first 5 top picks by composite score\n    top_results = sorted(\n        sorted_results,\n        key=lambda r: r.get(\"scored_job\", {}).get(\"composite_score\", 0),\n        reverse=True,\n    )[:5]\n\n    top_picks: list[TopPickFingerprint] = []\n    for position, result in enumerate(top_results):\n        scored_job = result.get(\"scored_job\", {})\n        top_picks.append(\n            TopPickFingerprint(\n                job_id=str(scored_job.get(\"discovered_job_id\", \"\")),\n                source=str(result.get(\"jd_filename\", \"\").split(\"-\")[0]),  # Extract source prefix\n                url=str(scored_job.get(\"url\", \"\")),\n                position=position,\n            )\n        )\n\n    exact_fields = ExactFields(top_picks=top_picks)\n\n    # Compute tolerance fields: aggregate score dimensions\n    tolerance_fields = _compute_tolerance_fields(\n        scored_results,\n        baseline,\n    )\n\n    # Generate deterministic run_id from candidate_id + computed_at\n    computed_at = datetime.now(timezone.utc).isoformat()\n\n    fingerprint = ScoringFingerprint(\n        candidate_id=candidate_id,\n        run_id=candidate_scoring_result.get(\"run_id\", \"unknown\"),\n        computed_at=computed_at,\n        exact_fields=exact_fields,\n        tolerance_fields=tolerance_fields,\n    )\n\n    logger.info(\n        \"fingerprint.computed\",\n        candidate_id=candidate_id,\n        top_picks_count=len(top_picks),\n        composite_score=tolerance_fields.composite_score.value,\n    )\n\n    return fingerprint\n\n\ndef _compute_tolerance_fields(\n    scored_results: list[dict],\n    baseline: Optional[ScoringFingerprint],\n) -> ToleranceFields:\n    \"\"\"\n    Compute tolerance field values from scored results.\n\n    Aggregates score dimensions across all scored jobs and computes\n    drift percentage if a baseline is provided.\n\n    Args:\n        scored_results: List of scoring result dicts\n        baseline: Optional baseline fingerprint for drift calculation\n\n    Returns:\n        ToleranceFields with aggregated values and drift percentages\n    \"\"\"\n    # Collect all score dimensions\n    tech_scores: list[int] = []\n    level_scores: list[int] = []\n    culture_scores: list[int] = []\n    industry_scores: list[int] = []\n    growth_scores: list[int] = []\n    comp_scores: list[int] = []\n    composite_scores: list[int] = []\n\n    for result in scored_results:\n        scored_job = result.get(\"scored_job\")\n        if scored_job is None:\n            continue\n\n        breakdown = scored_job.get(\"score_breakdown\", {})\n        tech_scores.append(breakdown.get(\"technical_match\", 0))\n        level_scores.append(breakdown.get(\"level_match\", 0))\n        culture_scores.append(breakdown.get(\"culture_match\", 0))\n        industry_scores.append(breakdown.get(\"industry_match\", 0))\n        growth_scores.append(breakdown.get(\"growth_potential\", 0))\n        comp_scores.append(breakdown.get(\"compensation_match\", 0))\n        composite_scores.append(scored_job.get(\"composite_score\", 0))\n\n    # Compute averages (rounded to 4 decimals for stability)\n    def avg(scores: list[int]) -> float:\n        if not scores:\n            return 0.0\n        return round(sum(scores) / len(scores), 4)\n\n    tech_avg = avg(tech_scores)\n    level_avg = avg(level_scores)\n    culture_avg = avg(culture_scores)\n    industry_avg = avg(industry_scores)\n    growth_avg = avg(growth_scores)\n    comp_avg = avg(comp_scores)\n    composite_avg = avg(composite_scores)\n    total_discovered = float(len(scored_results))\n\n    # Helper to compute drift percentage\n    def drift_pct(current: float, baseline_val: Optional[float]) -> Optional[float]:\n        if baseline_val is None or baseline_val == 0:\n            return None\n        return round((current - baseline_val) / baseline_val, 4)\n\n    # Extract baseline values if present\n    baseline_tech = None\n    baseline_level = None\n    baseline_culture = None\n    baseline_industry = None\n    baseline_growth = None\n    baseline_comp = None\n    baseline_composite = None\n    baseline_discovered = None\n\n    if baseline is not None:\n        baseline_tech = baseline.tolerance_fields.technical_match.value\n        baseline_level = baseline.tolerance_fields.level_match.value\n        baseline_culture = baseline.tolerance_fields.culture_match.value\n        baseline_industry = baseline.tolerance_fields.industry_match.value\n        baseline_growth = baseline.tolerance_fields.growth_potential.value\n        baseline_comp = baseline.tolerance_fields.compensation_match.value\n        baseline_composite = baseline.tolerance_fields.composite_score.value\n        baseline_discovered = baseline.tolerance_fields.total_jobs_discovered.value\n\n    return ToleranceFields(\n        technical_match=ToleranceFieldValue(\n            value=tech_avg,\n            baseline=baseline_tech,\n            drift_pct=drift_pct(tech_avg, baseline_tech),\n        ),\n        level_match=ToleranceFieldValue(\n            value=level_avg,\n            baseline=baseline_level,\n            drift_pct=drift_pct(level_avg, baseline_level),\n        ),\n        culture_match=ToleranceFieldValue(\n            value=culture_avg,\n            baseline=baseline_culture,\n            drift_pct=drift_pct(culture_avg, baseline_culture),\n        ),\n        industry_match=ToleranceFieldValue(\n            value=industry_avg,\n            baseline=baseline_industry,\n            drift_pct=drift_pct(industry_avg, baseline_industry),\n        ),\n        growth_potential=ToleranceFieldValue(\n            value=growth_avg,\n            baseline=baseline_growth,\n            drift_pct=drift_pct(growth_avg, baseline_growth),\n        ),\n        compensation_match=ToleranceFieldValue(\n            value=comp_avg,\n            baseline=baseline_comp,\n            drift_pct=drift_pct(comp_avg, baseline_comp),\n        ),\n        composite_score=ToleranceFieldValue(\n            value=composite_avg,\n            baseline=baseline_composite,\n            drift_pct=drift_pct(composite_avg, baseline_composite),\n        ),\n        total_jobs_discovered=ToleranceFieldValue(\n            value=total_discovered,\n            baseline=baseline_discovered,\n            drift_pct=drift_pct(total_discovered, baseline_discovered),\n        ),\n    )\n\n\n# ─── Baseline Loading ─────────────────────────────────────────────────────────\n\n\ndef load_baseline(\n    baselines_dir: str,\n    candidate_id: str,\n) -> Optional[ScoringFingerprint]:\n    \"\"\"\n    Load the latest accepted baseline for a candidate.\n\n    Baselines are stored at:\n        synthetics/fixtures/baselines/<candidate_id>__<run_id>.json\n\n    Only committed baselines are considered valid. The latest by\n    accepted_at timestamp is returned.\n\n    Args:\n        baselines_dir: Path to synthetics/fixtures/baselines/\n        candidate_id: Synthetic candidate UUID\n\n    Returns:\n        ScoringFingerprint from baseline, or None if no baseline exists\n    \"\"\"\n    import json\n    from pathlib import Path\n\n    baselines_path = Path(baselines_dir)\n    if not baselines_path.exists():\n        logger.debug(\"fingerprint.baseline_dir_not_found\", path=baselines_dir)\n        return None\n\n    # Find all baselines for this candidate\n    pattern = f\"{candidate_id}__*.json\"\n    baseline_files = list(baselines_path.glob(pattern))\n\n    if not baseline_files:\n        logger.debug(\n            \"fingerprint.no_baseline\",\n            candidate_id=candidate_id,\n            pattern=pattern,\n        )\n        return None\n\n    # Sort by file modification time (latest first)\n    baseline_files.sort(key=lambda f: f.stat().st_mtime, reverse=True)\n    latest_file = baseline_files[0]\n\n    logger.debug(\n        \"fingerprint.loading_baseline\",\n        candidate_id=candidate_id,\n        file=str(latest_file),\n    )\n\n    try:\n        with open(latest_file) as f:\n            data = json.load(f)\n            # Extract just the fingerprint portion\n            fingerprint_data = data.get(\"fingerprint\", data)\n            return ScoringFingerprint.model_validate(fingerprint_data)\n    except Exception as e:\n        logger.error(\n            \"fingerprint.baseline_load_error\",\n            file=str(latest_file),\n            error=str(e),\n        )\n        return None\n\n\ndef save_baseline(\n    baselines_dir: str,\n    fingerprint: ScoringFingerprint,\n) -> str:\n    \"\"\"\n    Save a fingerprint as a baseline (for baseline acceptance workflow).\n\n    Creates a file at:\n        synthetics/fixtures/baselines/<candidate_id>__<run_id>.json\n\n    Note: This function writes the file but does NOT commit it.\n    Baseline acceptance requires explicit commit via:\n        mycelium synthetics baseline accept <run_id>\n\n    Args:\n        baselines_dir: Path to synthetics/fixtures/baselines/\n        fingerprint: ScoringFingerprint to save\n\n    Returns:\n        Path to the saved baseline file\n    \"\"\"\n    import json\n    from pathlib import Path\n\n    baselines_path = Path(baselines_dir)\n    baselines_path.mkdir(parents=True, exist_ok=True)\n\n    filename = f\"{fingerprint.candidate_id}__{fingerprint.run_id}.json\"\n    filepath = baselines_path / filename\n\n    baseline_record = {\n        \"candidate_id\": fingerprint.candidate_id,\n        \"run_id\": fingerprint.run_id,\n        \"accepted_at\": datetime.now(timezone.utc).isoformat(),\n        \"fingerprint\": fingerprint.model_dump(),\n    }\n\n    with open(filepath, \"w\") as f:\n        json.dump(baseline_record, f, indent=2)\n\n    logger.info(\n        \"fingerprint.baseline_saved\",\n        candidate_id=fingerprint.candidate_id,\n        run_id=fingerprint.run_id,\n        file=str(filepath),\n    )\n\n    return str(filepath)\n","numLines":551,"startLine":1,"totalLines":551}}}}
{"t":"2026-05-28T03:44:24.504Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LvUhYfv3p385Fi42qy1rZR","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Relevance Scorer — scores each discovered job against the candidate's identity profile.\n     6→\n     7→Scoring dimensions (each 0–100):\n     8→  technical_match   30%  — skills overlap between JD and candidate profile\n     9→  level_match       20%  — seniority alignment (penalise over AND under)\n    10→  culture_match     15%  — startup/enterprise, remote, mission alignment\n    11→  industry_match    15%  — domain expertise alignment\n    12→  growth_potential  10%  — does this expand the candidate's trajectory?\n    13→  compensation_match 10% — estimated band vs candidate target\n    14→\n    15→Claude parses the JD. Math runs locally. Claude writes 2-sentence reasoning.\n    16→\"\"\"\n    17→\n    18→import json\n    19→import re\n    20→from datetime import datetime, timezone\n    21→from uuid import UUID, uuid4\n    22→\n    23→import structlog\n    24→from anthropic import AsyncAnthropic\n    25→from tenacity import retry, stop_after_attempt, wait_exponential\n    26→\n    27→from backend.agents.discovery.schemas import (\n    28→    IdentityProfileSchema,\n    29→    DiscoveredJobSchema,\n    30→    ScoredJobSchema,\n    31→    ScoreBreakdown,\n    32→)\n    33→\n    34→logger = structlog.get_logger(__name__)\n    35→\n    36→# Seniority levels for level_match scoring — lower index = more junior\n    37→_SENIORITY_LADDER = [\n    38→    \"intern\",\n    39→    \"junior\",\n    40→    \"associate\",\n    41→    \"mid\",\n    42→    \"senior\",\n    43→    \"staff\",\n    44→    \"principal\",\n    45→    \"lead\",\n    46→    \"manager\",\n    47→    \"director\",\n    48→    \"vp\",\n    49→    \"svp\",\n    50→    \"head\",\n    51→    \"cto\",\n    52→    \"coo\",\n    53→    \"ceo\",\n    54→    \"founder\",\n    55→    \"exec\",\n    56→    \"c-level\",\n    57→]\n    58→\n    59→_LEADERSHIP_TO_LADDER = {\n    60→    \"IC\": \"senior\",\n    61→    \"Lead\": \"lead\",\n    62→    \"Manager\": \"manager\",\n    63→    \"Director\": \"director\",\n    64→    \"VP\": \"vp\",\n    65→    \"C-Level\": \"cto\",\n    66→}\n    67→\n    68→\n    69→class RelevanceScorer:\n    70→    \"\"\"\n    71→    Scores discovered jobs against a candidate's identity profile.\n    72→\n    73→    Uses Claude to parse JD requirements and generate reasoning.\n    74→    Scoring math runs locally — no LLM needed for the numbers.\n    75→    \"\"\"\n    76→\n    77→    def __init__(self, anthropic_client: AsyncAnthropic):\n    78→        \"\"\"\n    79→        Initialize the RelevanceScorer.\n    80→\n    81→        Args:\n    82→            anthropic_client: Async Anthropic client for Claude API\n    83→        \"\"\"\n    84→        self._claude = anthropic_client\n    85→\n    86→    async def score_batch(\n    87→        self,\n    88→        jobs: list[DiscoveredJobSchema],\n    89→        profile: IdentityProfileSchema,\n    90→        candidate_id: UUID,\n    91→        min_score: int = 60,\n    92→    ) -> list[ScoredJobSchema]:\n    93→        \"\"\"\n    94→        Score a batch of discovered jobs, filtering out those below min_score.\n    95→\n    96→        Args:\n    97→            jobs: Raw discovered jobs to score\n    98→            profile: Candidate identity profile\n    99→            candidate_id: Candidate UUID for scored job records\n   100→            min_score: Jobs below this composite score are discarded\n   101→\n   102→        Returns:\n   103→            Sorted list of ScoredJobSchema, highest composite first\n   104→        \"\"\"\n   105→        logger.info(\n   106→            \"relevance_scorer.batch_start\",\n   107→            job_count=len(jobs),\n   108→            min_score=min_score,\n   109→        )\n   110→\n   111→        scored: list[ScoredJobSchema] = []\n   112→        for job in jobs:\n   113→            try:\n   114→                result = await self.score_job(job, profile, candidate_id)\n   115→                if result.composite_score >= min_score:\n   116→                    scored.append(result)\n   117→            except Exception as e:\n   118→                logger.error(\n   119→                    \"relevance_scorer.job_error\",\n   120→                    job_url=job.url,\n   121→                    error=str(e),\n   122→                )\n   123→\n   124→        scored.sort(key=lambda s: s.composite_score, reverse=True)\n   125→        logger.info(\n   126→            \"relevance_scorer.batch_complete\",\n   127→            scored=len(scored),\n   128→            filtered_out=len(jobs) - len(scored),\n   129→        )\n   130→        return scored\n   131→\n   132→    async def score_job(\n   133→        self,\n   134→        job: DiscoveredJobSchema,\n   135→        profile: IdentityProfileSchema,\n   136→        candidate_id: UUID,\n   137→    ) -> ScoredJobSchema:\n   138→        \"\"\"\n   139→        Score a single job against the identity profile.\n   140→\n   141→        Args:\n   142→            job: Discovered job\n   143→            profile: Candidate identity profile\n   144→            candidate_id: Candidate UUID\n   145→\n   146→        Returns:\n   147→            ScoredJobSchema with full breakdown and reasoning\n   148→        \"\"\"\n   149→        parsed_jd = await self._parse_jd(job)\n   150→        scores = self._compute_scores(parsed_jd, profile, job)\n   151→        composite = scores.composite\n   152→        is_hot = composite >= 80\n   153→        reasoning = await self._generate_reasoning(job, profile, scores, composite)\n   154→\n   155→        return ScoredJobSchema(\n   156→            id=uuid4(),\n   157→            discovered_job_id=job.id or uuid4(),\n   158→            candidate_id=candidate_id,\n   159→            score_breakdown=scores,\n   160→            composite_score=composite,\n   161→            is_hot=is_hot,\n   162→            reasoning=reasoning,\n   163→            scored_at=datetime.now(timezone.utc),\n   164→            # Denormalized job fields for digest display\n   165→            title=job.title,\n   166→            company=job.company,\n   167→            location=job.location,\n   168→            url=job.url,\n   169→        )\n   170→\n   171→    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n   172→    async def _parse_jd(self, job: DiscoveredJobSchema) -> dict:\n   173→        \"\"\"Use Claude to extract structured requirements from a job description.\"\"\"\n   174→        if not job.description:\n   175→            return {}\n   176→\n   177→        prompt = f\"\"\"Extract structured data from this job description. Return ONLY valid JSON, no markdown:\n   178→\n   179→Job Title: {job.title}\n   180→Company: {job.company}\n   181→Location: {job.location or \"Not specified\"}\n   182→\n   183→Description:\n   184→{job.description[:3000]}\n   185→\n   186→Return this exact JSON structure:\n   187→{{\n   188→  \"required_skills\": [\"<skill1>\", \"<skill2>\"],\n   189→  \"preferred_skills\": [\"<skill1>\"],\n   190→  \"seniority_level\": \"<intern|junior|mid|senior|staff|principal|lead|manager|director|vp|head|exec>\",\n   191→  \"remote_type\": \"<remote|hybrid|onsite|flexible>\",\n   192→  \"industries\": [\"<industry1>\"],\n   193→  \"comp_mentioned\": \"<salary string or null>\",\n   194→  \"culture_signals\": {{\n   195→    \"startup_vs_enterprise\": \"<startup|enterprise|both>\",\n   196→    \"mission_driven\": true\n   197→  }},\n   198→  \"growth_indicators\": [\"<indicator1>\"]\n   199→}}\"\"\"\n   200→\n   201→        response = await self._claude.messages.create(\n   202→            model=\"claude-sonnet-4-20250514\",\n   203→            max_tokens=1024,\n   204→            messages=[{\"role\": \"user\", \"content\": prompt}],\n   205→        )\n   206→\n   207→        raw = response.content[0].text.strip()\n   208→        try:\n   209→            return json.loads(raw)\n   210→        except json.JSONDecodeError:\n   211→            match = re.search(r\"\\{.*\\}\", raw, re.DOTALL)\n   212→            return json.loads(match.group()) if match else {}\n   213→\n   214→    def _compute_scores(\n   215→        self,\n   216→        parsed_jd: dict,\n   217→        profile: IdentityProfileSchema,\n   218→        job: DiscoveredJobSchema,\n   219→    ) -> ScoreBreakdown:\n   220→        \"\"\"Compute all six scoring dimensions locally.\"\"\"\n   221→        return ScoreBreakdown(\n   222→            technical_match=self._score_technical(parsed_jd, profile),\n   223→            level_match=self._score_level(parsed_jd, profile),\n   224→            culture_match=self._score_culture(parsed_jd, profile, job),\n   225→            industry_match=self._score_industry(parsed_jd, profile),\n   226→            growth_potential=self._score_growth(parsed_jd, profile),\n   227→            compensation_match=self._score_compensation(parsed_jd, profile),\n   228→        )\n   229→\n   230→    def _score_technical(\n   231→        self, parsed_jd: dict, profile: IdentityProfileSchema\n   232→    ) -> int:\n   233→        \"\"\"Score based on skills overlap between JD requirements and candidate skills.\"\"\"\n   234→        required = {s.lower() for s in parsed_jd.get(\"required_skills\", [])}\n   235→        preferred = {s.lower() for s in parsed_jd.get(\"preferred_skills\", [])}\n   236→        candidate_skills = {s.lower() for s in profile.technical_skills}\n   237→\n   238→        if not required:\n   239→            return 60  # No requirements listed — neutral score\n   240→\n   241→        required_hits = len(required & candidate_skills)\n   242→        preferred_hits = len(preferred & candidate_skills)\n   243→\n   244→        required_ratio = required_hits / len(required) if required else 0\n   245→        preferred_bonus = min(20, preferred_hits * 4) if preferred else 0\n   246→\n   247→        base = int(required_ratio * 80)\n   248→        return min(100, base + preferred_bonus)\n   249→\n   250→    def _score_level(self, parsed_jd: dict, profile: IdentityProfileSchema) -> int:\n   251→        \"\"\"Score seniority alignment — penalise both under and over.\"\"\"\n   252→        jd_level = parsed_jd.get(\"seniority_level\", \"\").lower()\n   253→        candidate_level = _LEADERSHIP_TO_LADDER.get(\n   254→            profile.leadership_level, \"senior\"\n   255→        )\n   256→\n   257→        try:\n   258→            jd_idx = _SENIORITY_LADDER.index(jd_level)\n   259→        except ValueError:\n   260→            return 70  # Unknown level — generous neutral\n   261→\n   262→        try:\n   263→            candidate_idx = _SENIORITY_LADDER.index(candidate_level)\n   264→        except ValueError:\n   265→            return 70\n   266→\n   267→        diff = abs(jd_idx - candidate_idx)\n   268→        if diff == 0:\n   269→            return 100\n   270→        elif diff == 1:\n   271→            return 80\n   272→        elif diff == 2:\n   273→            return 55\n   274→        elif diff == 3:\n   275→            return 30\n   276→        else:\n   277→            return 10\n   278→\n   279→    def _score_culture(\n   280→        self,\n   281→        parsed_jd: dict,\n   282→        profile: IdentityProfileSchema,\n   283→        job: DiscoveredJobSchema,\n   284→    ) -> int:\n   285→        \"\"\"Score culture alignment: startup/enterprise + remote preference.\"\"\"\n   286→        score = 60  # default neutral\n   287→\n   288→        # Startup vs enterprise alignment\n   289→        jd_type = parsed_jd.get(\"culture_signals\", {}).get(\n   290→            \"startup_vs_enterprise\", \"\"\n   291→        )\n   292→        candidate_pref = profile.signals.get(\"startup_vs_enterprise\", \"both\")\n   293→        if jd_type and candidate_pref != \"both\":\n   294→            if jd_type == candidate_pref:\n   295→                score += 20\n   296→            else:\n   297→                score -= 20\n   298→\n   299→        # Remote alignment\n   300→        jd_remote = parsed_jd.get(\"remote_type\", \"\")\n   301→        candidate_remote = profile.signals.get(\"remote_preference\", \"flexible\")\n   302→        if jd_remote and candidate_remote != \"flexible\":\n   303→            if jd_remote == candidate_remote:\n   304→                score += 20\n   305→            elif jd_remote == \"onsite\" and candidate_remote == \"remote\":\n   306→                score -= 30\n   307→            else:\n   308→                score -= 10\n   309→\n   310→        return max(0, min(100, score))\n   311→\n   312→    def _score_industry(\n   313→        self, parsed_jd: dict, profile: IdentityProfileSchema\n   314→    ) -> int:\n   315→        \"\"\"Score how well the job's industries align with the candidate's domain expertise.\"\"\"\n   316→        jd_industries = {i.lower() for i in parsed_jd.get(\"industries\", [])}\n   317→        candidate_domains = {d.lower() for d in profile.industry_experience}\n   318→\n   319→        if not jd_industries:\n   320→            return 60\n   321→\n   322→        overlap = len(jd_industries & candidate_domains)\n   323→        if overlap >= 2:\n   324→            return 100\n   325→        elif overlap == 1:\n   326→            return 75\n   327→        else:\n   328→            return 35\n   329→\n   330→    def _score_growth(\n   331→        self, parsed_jd: dict, profile: IdentityProfileSchema\n   332→    ) -> int:\n   333→        \"\"\"Score whether this role expands the candidate's trajectory.\"\"\"\n   334→        indicators = parsed_jd.get(\"growth_indicators\", [])\n   335→        growth_keywords = {\n   336→            \"build from scratch\",\n   337→            \"greenfield\",\n   338→            \"founding\",\n   339→            \"new team\",\n   340→            \"technical strategy\",\n   341→            \"shape the\",\n   342→            \"lead the\",\n   343→            \"define the\",\n   344→            \"architect\",\n   345→            \"platform\",\n   346→            \"0 to 1\",\n   347→        }\n   348→\n   349→        indicator_text = \" \".join(indicators).lower()\n   350→        matches = sum(1 for kw in growth_keywords if kw in indicator_text)\n   351→\n   352→        if matches >= 3:\n   353→            return 90\n   354→        elif matches >= 1:\n   355→            return 70\n   356→        else:\n   357→            return 50\n   358→\n   359→    def _score_compensation(\n   360→        self, parsed_jd: dict, profile: IdentityProfileSchema\n   361→    ) -> int:\n   362→        \"\"\"Score comp alignment — generous when comp isn't mentioned.\"\"\"\n   363→        comp_str = parsed_jd.get(\"comp_mentioned\")\n   364→        if not comp_str:\n   365→            return 75  # No comp listed is common for senior/exec roles\n   366→\n   367→        # Extract numbers from comp string\n   368→        numbers = re.findall(r\"\\d[\\d,]*\", comp_str.replace(\",\", \"\"))\n   369→        if not numbers:\n   370→            return 70\n   371→\n   372→        amounts = [int(n) for n in numbers if len(n) <= 7]  # filter out noise\n   373→        if not amounts:\n   374→            return 70\n   375→\n   376→        # Without candidate min, return neutral\n   377→        return 75\n   378→\n   379→    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n   380→    async def _generate_reasoning(\n   381→        self,\n   382→        job: DiscoveredJobSchema,\n   383→        profile: IdentityProfileSchema,\n   384→        scores: ScoreBreakdown,\n   385→        composite: int,\n   386→    ) -> str:\n   387→        \"\"\"Generate a 2-sentence human-readable reasoning string via Claude.\"\"\"\n   388→        prompt = f\"\"\"You are writing a brief explanation for why a job matches a candidate in a talent agent digest.\n   389→\n   390→Candidate archetypes: {\", \".join(profile.archetypes[:5])}\n   391→Job: {job.title} at {job.company} ({job.location or \"location TBD\"})\n   392→Composite score: {composite}/100\n   393→\n   394→Score breakdown:\n   395→- Technical match: {scores.technical_match}/100\n   396→- Level match: {scores.level_match}/100\n   397→- Culture match: {scores.culture_match}/100\n   398→- Industry match: {scores.industry_match}/100\n   399→- Growth potential: {scores.growth_potential}/100\n   400→- Compensation match: {scores.compensation_match}/100\n   401→\n   402→Write exactly 2 sentences: one sentence on why this is a strong match, one on the key consideration or risk.\n   403→Be specific. Do not use filler phrases like \"This role offers\" or \"This position presents\". Start with the substance.\n   404→Return only the 2 sentences, no other text.\"\"\"\n   405→\n   406→        response = await self._claude.messages.create(\n   407→            model=\"claude-sonnet-4-20250514\",\n   408→            max_tokens=200,\n   409→            messages=[{\"role\": \"user\", \"content\": prompt}],\n   410→        )\n   411→        return response.content[0].text.strip()\n   412→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"d03d3d20-5f6b-41a7-88e6-34cec2448ac8","uuid":"66fa90e1-fd46-4b21-931c-b13a637e5b55","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/agents/discovery/relevance_scorer.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nRelevance Scorer — scores each discovered job against the candidate's identity profile.\n\nScoring dimensions (each 0–100):\n  technical_match   30%  — skills overlap between JD and candidate profile\n  level_match       20%  — seniority alignment (penalise over AND under)\n  culture_match     15%  — startup/enterprise, remote, mission alignment\n  industry_match    15%  — domain expertise alignment\n  growth_potential  10%  — does this expand the candidate's trajectory?\n  compensation_match 10% — estimated band vs candidate target\n\nClaude parses the JD. Math runs locally. Claude writes 2-sentence reasoning.\n\"\"\"\n\nimport json\nimport re\nfrom datetime import datetime, timezone\nfrom uuid import UUID, uuid4\n\nimport structlog\nfrom anthropic import AsyncAnthropic\nfrom tenacity import retry, stop_after_attempt, wait_exponential\n\nfrom backend.agents.discovery.schemas import (\n    IdentityProfileSchema,\n    DiscoveredJobSchema,\n    ScoredJobSchema,\n    ScoreBreakdown,\n)\n\nlogger = structlog.get_logger(__name__)\n\n# Seniority levels for level_match scoring — lower index = more junior\n_SENIORITY_LADDER = [\n    \"intern\",\n    \"junior\",\n    \"associate\",\n    \"mid\",\n    \"senior\",\n    \"staff\",\n    \"principal\",\n    \"lead\",\n    \"manager\",\n    \"director\",\n    \"vp\",\n    \"svp\",\n    \"head\",\n    \"cto\",\n    \"coo\",\n    \"ceo\",\n    \"founder\",\n    \"exec\",\n    \"c-level\",\n]\n\n_LEADERSHIP_TO_LADDER = {\n    \"IC\": \"senior\",\n    \"Lead\": \"lead\",\n    \"Manager\": \"manager\",\n    \"Director\": \"director\",\n    \"VP\": \"vp\",\n    \"C-Level\": \"cto\",\n}\n\n\nclass RelevanceScorer:\n    \"\"\"\n    Scores discovered jobs against a candidate's identity profile.\n\n    Uses Claude to parse JD requirements and generate reasoning.\n    Scoring math runs locally — no LLM needed for the numbers.\n    \"\"\"\n\n    def __init__(self, anthropic_client: AsyncAnthropic):\n        \"\"\"\n        Initialize the RelevanceScorer.\n\n        Args:\n            anthropic_client: Async Anthropic client for Claude API\n        \"\"\"\n        self._claude = anthropic_client\n\n    async def score_batch(\n        self,\n        jobs: list[DiscoveredJobSchema],\n        profile: IdentityProfileSchema,\n        candidate_id: UUID,\n        min_score: int = 60,\n    ) -> list[ScoredJobSchema]:\n        \"\"\"\n        Score a batch of discovered jobs, filtering out those below min_score.\n\n        Args:\n            jobs: Raw discovered jobs to score\n            profile: Candidate identity profile\n            candidate_id: Candidate UUID for scored job records\n            min_score: Jobs below this composite score are discarded\n\n        Returns:\n            Sorted list of ScoredJobSchema, highest composite first\n        \"\"\"\n        logger.info(\n            \"relevance_scorer.batch_start\",\n            job_count=len(jobs),\n            min_score=min_score,\n        )\n\n        scored: list[ScoredJobSchema] = []\n        for job in jobs:\n            try:\n                result = await self.score_job(job, profile, candidate_id)\n                if result.composite_score >= min_score:\n                    scored.append(result)\n            except Exception as e:\n                logger.error(\n                    \"relevance_scorer.job_error\",\n                    job_url=job.url,\n                    error=str(e),\n                )\n\n        scored.sort(key=lambda s: s.composite_score, reverse=True)\n        logger.info(\n            \"relevance_scorer.batch_complete\",\n            scored=len(scored),\n            filtered_out=len(jobs) - len(scored),\n        )\n        return scored\n\n    async def score_job(\n        self,\n        job: DiscoveredJobSchema,\n        profile: IdentityProfileSchema,\n        candidate_id: UUID,\n    ) -> ScoredJobSchema:\n        \"\"\"\n        Score a single job against the identity profile.\n\n        Args:\n            job: Discovered job\n            profile: Candidate identity profile\n            candidate_id: Candidate UUID\n\n        Returns:\n            ScoredJobSchema with full breakdown and reasoning\n        \"\"\"\n        parsed_jd = await self._parse_jd(job)\n        scores = self._compute_scores(parsed_jd, profile, job)\n        composite = scores.composite\n        is_hot = composite >= 80\n        reasoning = await self._generate_reasoning(job, profile, scores, composite)\n\n        return ScoredJobSchema(\n            id=uuid4(),\n            discovered_job_id=job.id or uuid4(),\n            candidate_id=candidate_id,\n            score_breakdown=scores,\n            composite_score=composite,\n            is_hot=is_hot,\n            reasoning=reasoning,\n            scored_at=datetime.now(timezone.utc),\n            # Denormalized job fields for digest display\n            title=job.title,\n            company=job.company,\n            location=job.location,\n            url=job.url,\n        )\n\n    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n    async def _parse_jd(self, job: DiscoveredJobSchema) -> dict:\n        \"\"\"Use Claude to extract structured requirements from a job description.\"\"\"\n        if not job.description:\n            return {}\n\n        prompt = f\"\"\"Extract structured data from this job description. Return ONLY valid JSON, no markdown:\n\nJob Title: {job.title}\nCompany: {job.company}\nLocation: {job.location or \"Not specified\"}\n\nDescription:\n{job.description[:3000]}\n\nReturn this exact JSON structure:\n{{\n  \"required_skills\": [\"<skill1>\", \"<skill2>\"],\n  \"preferred_skills\": [\"<skill1>\"],\n  \"seniority_level\": \"<intern|junior|mid|senior|staff|principal|lead|manager|director|vp|head|exec>\",\n  \"remote_type\": \"<remote|hybrid|onsite|flexible>\",\n  \"industries\": [\"<industry1>\"],\n  \"comp_mentioned\": \"<salary string or null>\",\n  \"culture_signals\": {{\n    \"startup_vs_enterprise\": \"<startup|enterprise|both>\",\n    \"mission_driven\": true\n  }},\n  \"growth_indicators\": [\"<indicator1>\"]\n}}\"\"\"\n\n        response = await self._claude.messages.create(\n            model=\"claude-sonnet-4-20250514\",\n            max_tokens=1024,\n            messages=[{\"role\": \"user\", \"content\": prompt}],\n        )\n\n        raw = response.content[0].text.strip()\n        try:\n            return json.loads(raw)\n        except json.JSONDecodeError:\n            match = re.search(r\"\\{.*\\}\", raw, re.DOTALL)\n            return json.loads(match.group()) if match else {}\n\n    def _compute_scores(\n        self,\n        parsed_jd: dict,\n        profile: IdentityProfileSchema,\n        job: DiscoveredJobSchema,\n    ) -> ScoreBreakdown:\n        \"\"\"Compute all six scoring dimensions locally.\"\"\"\n        return ScoreBreakdown(\n            technical_match=self._score_technical(parsed_jd, profile),\n            level_match=self._score_level(parsed_jd, profile),\n            culture_match=self._score_culture(parsed_jd, profile, job),\n            industry_match=self._score_industry(parsed_jd, profile),\n            growth_potential=self._score_growth(parsed_jd, profile),\n            compensation_match=self._score_compensation(parsed_jd, profile),\n        )\n\n    def _score_technical(\n        self, parsed_jd: dict, profile: IdentityProfileSchema\n    ) -> int:\n        \"\"\"Score based on skills overlap between JD requirements and candidate skills.\"\"\"\n        required = {s.lower() for s in parsed_jd.get(\"required_skills\", [])}\n        preferred = {s.lower() for s in parsed_jd.get(\"preferred_skills\", [])}\n        candidate_skills = {s.lower() for s in profile.technical_skills}\n\n        if not required:\n            return 60  # No requirements listed — neutral score\n\n        required_hits = len(required & candidate_skills)\n        preferred_hits = len(preferred & candidate_skills)\n\n        required_ratio = required_hits / len(required) if required else 0\n        preferred_bonus = min(20, preferred_hits * 4) if preferred else 0\n\n        base = int(required_ratio * 80)\n        return min(100, base + preferred_bonus)\n\n    def _score_level(self, parsed_jd: dict, profile: IdentityProfileSchema) -> int:\n        \"\"\"Score seniority alignment — penalise both under and over.\"\"\"\n        jd_level = parsed_jd.get(\"seniority_level\", \"\").lower()\n        candidate_level = _LEADERSHIP_TO_LADDER.get(\n            profile.leadership_level, \"senior\"\n        )\n\n        try:\n            jd_idx = _SENIORITY_LADDER.index(jd_level)\n        except ValueError:\n            return 70  # Unknown level — generous neutral\n\n        try:\n            candidate_idx = _SENIORITY_LADDER.index(candidate_level)\n        except ValueError:\n            return 70\n\n        diff = abs(jd_idx - candidate_idx)\n        if diff == 0:\n            return 100\n        elif diff == 1:\n            return 80\n        elif diff == 2:\n            return 55\n        elif diff == 3:\n            return 30\n        else:\n            return 10\n\n    def _score_culture(\n        self,\n        parsed_jd: dict,\n        profile: IdentityProfileSchema,\n        job: DiscoveredJobSchema,\n    ) -> int:\n        \"\"\"Score culture alignment: startup/enterprise + remote preference.\"\"\"\n        score = 60  # default neutral\n\n        # Startup vs enterprise alignment\n        jd_type = parsed_jd.get(\"culture_signals\", {}).get(\n            \"startup_vs_enterprise\", \"\"\n        )\n        candidate_pref = profile.signals.get(\"startup_vs_enterprise\", \"both\")\n        if jd_type and candidate_pref != \"both\":\n            if jd_type == candidate_pref:\n                score += 20\n            else:\n                score -= 20\n\n        # Remote alignment\n        jd_remote = parsed_jd.get(\"remote_type\", \"\")\n        candidate_remote = profile.signals.get(\"remote_preference\", \"flexible\")\n        if jd_remote and candidate_remote != \"flexible\":\n            if jd_remote == candidate_remote:\n                score += 20\n            elif jd_remote == \"onsite\" and candidate_remote == \"remote\":\n                score -= 30\n            else:\n                score -= 10\n\n        return max(0, min(100, score))\n\n    def _score_industry(\n        self, parsed_jd: dict, profile: IdentityProfileSchema\n    ) -> int:\n        \"\"\"Score how well the job's industries align with the candidate's domain expertise.\"\"\"\n        jd_industries = {i.lower() for i in parsed_jd.get(\"industries\", [])}\n        candidate_domains = {d.lower() for d in profile.industry_experience}\n\n        if not jd_industries:\n            return 60\n\n        overlap = len(jd_industries & candidate_domains)\n        if overlap >= 2:\n            return 100\n        elif overlap == 1:\n            return 75\n        else:\n            return 35\n\n    def _score_growth(\n        self, parsed_jd: dict, profile: IdentityProfileSchema\n    ) -> int:\n        \"\"\"Score whether this role expands the candidate's trajectory.\"\"\"\n        indicators = parsed_jd.get(\"growth_indicators\", [])\n        growth_keywords = {\n            \"build from scratch\",\n            \"greenfield\",\n            \"founding\",\n            \"new team\",\n            \"technical strategy\",\n            \"shape the\",\n            \"lead the\",\n            \"define the\",\n            \"architect\",\n            \"platform\",\n            \"0 to 1\",\n        }\n\n        indicator_text = \" \".join(indicators).lower()\n        matches = sum(1 for kw in growth_keywords if kw in indicator_text)\n\n        if matches >= 3:\n            return 90\n        elif matches >= 1:\n            return 70\n        else:\n            return 50\n\n    def _score_compensation(\n        self, parsed_jd: dict, profile: IdentityProfileSchema\n    ) -> int:\n        \"\"\"Score comp alignment — generous when comp isn't mentioned.\"\"\"\n        comp_str = parsed_jd.get(\"comp_mentioned\")\n        if not comp_str:\n            return 75  # No comp listed is common for senior/exec roles\n\n        # Extract numbers from comp string\n        numbers = re.findall(r\"\\d[\\d,]*\", comp_str.replace(\",\", \"\"))\n        if not numbers:\n            return 70\n\n        amounts = [int(n) for n in numbers if len(n) <= 7]  # filter out noise\n        if not amounts:\n            return 70\n\n        # Without candidate min, return neutral\n        return 75\n\n    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n    async def _generate_reasoning(\n        self,\n        job: DiscoveredJobSchema,\n        profile: IdentityProfileSchema,\n        scores: ScoreBreakdown,\n        composite: int,\n    ) -> str:\n        \"\"\"Generate a 2-sentence human-readable reasoning string via Claude.\"\"\"\n        prompt = f\"\"\"You are writing a brief explanation for why a job matches a candidate in a talent agent digest.\n\nCandidate archetypes: {\", \".join(profile.archetypes[:5])}\nJob: {job.title} at {job.company} ({job.location or \"location TBD\"})\nComposite score: {composite}/100\n\nScore breakdown:\n- Technical match: {scores.technical_match}/100\n- Level match: {scores.level_match}/100\n- Culture match: {scores.culture_match}/100\n- Industry match: {scores.industry_match}/100\n- Growth potential: {scores.growth_potential}/100\n- Compensation match: {scores.compensation_match}/100\n\nWrite exactly 2 sentences: one sentence on why this is a strong match, one on the key consideration or risk.\nBe specific. Do not use filler phrases like \"This role offers\" or \"This position presents\". Start with the substance.\nReturn only the 2 sentences, no other text.\"\"\"\n\n        response = await self._claude.messages.create(\n            model=\"claude-sonnet-4-20250514\",\n            max_tokens=200,\n            messages=[{\"role\": \"user\", \"content\": prompt}],\n        )\n        return response.content[0].text.strip()\n","numLines":412,"startLine":1,"totalLines":412}}}}
{"t":"2026-05-28T03:44:24.638Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TrsyFsp8rrtk17E1xC6CTU","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Scoring Synthetic Runner — iterates synthetic candidates × JD fixtures.\n     6→\n     7→Executes the RelevanceScorer against synthetic candidates with cache-aware\n     8→instrumentation. Tracks cache hit/miss rates from Claude API responses.\n     9→\n    10→The scorer module (RelevanceScorer) is FROZEN. To enforce the cache contract\n    11→(NUTRIENTS.md §I.5), this runner wraps Claude API calls with cache_control\n    12→headers by providing a wrapper client that intercepts and augments requests.\n    13→\n    14→Contract: NUTRIENTS.md §I.2-I.5, HYPHA-SYNTHETICS-SCORING.md\n    15→Owner: synthetics-scoring-agent.runner\n    16→\"\"\"\n    17→\n    18→from __future__ import annotations\n    19→\n    20→import uuid\n    21→from dataclasses import dataclass, field\n    22→from datetime import datetime, timezone\n    23→from pathlib import Path\n    24→from typing import Optional\n    25→\n    26→import redis.asyncio as aioredis\n    27→import structlog\n    28→import yaml\n    29→from anthropic import AsyncAnthropic\n    30→from pydantic import BaseModel, Field\n    31→from sqlalchemy import text\n    32→from sqlalchemy.ext.asyncio import AsyncSession\n    33→\n    34→from backend.agents.discovery.identity_profiler import IdentityProfiler\n    35→from backend.agents.discovery.relevance_scorer import RelevanceScorer\n    36→from backend.agents.discovery.schemas import (\n    37→    CandidateSchema,\n    38→    DiscoveredJobSchema,\n    39→    IdentityProfileSchema,\n    40→    ScoredJobSchema,\n    41→)\n    42→\n    43→logger = structlog.get_logger(__name__)\n    44→\n    45→\n    46→# ─── Cache Statistics ────────────────────────────────────────────────────────\n    47→\n    48→\n    49→@dataclass\n    50→class CacheStats:\n    51→    \"\"\"Tracks cache hit/miss statistics for Claude API calls.\"\"\"\n    52→\n    53→    total_calls: int = 0\n    54→    cache_creation_tokens: int = 0\n    55→    cache_read_tokens: int = 0\n    56→\n    57→    @property\n    58→    def cache_hits(self) -> int:\n    59→        \"\"\"Number of calls that hit the cache.\"\"\"\n    60→        # A cache hit is when cache_read_input_tokens > 0\n    61→        return self._hit_count\n    62→\n    63→    @property\n    64→    def cache_misses(self) -> int:\n    65→        \"\"\"Number of calls that missed the cache.\"\"\"\n    66→        return self.total_calls - self._hit_count\n    67→\n    68→    @property\n    69→    def cache_hit_rate(self) -> float:\n    70→        \"\"\"Cache hit rate as a ratio 0.0-1.0.\"\"\"\n    71→        if self.total_calls == 0:\n    72→            return 0.0\n    73→        return self._hit_count / self.total_calls\n    74→\n    75→    _hit_count: int = field(default=0, init=False)\n    76→\n    77→    def record_call(\n    78→        self,\n    79→        cache_creation_input_tokens: int,\n    80→        cache_read_input_tokens: int,\n    81→    ) -> None:\n    82→        \"\"\"Record a Claude API call's cache statistics.\"\"\"\n    83→        self.total_calls += 1\n    84→        self.cache_creation_tokens += cache_creation_input_tokens\n    85→        self.cache_read_tokens += cache_read_input_tokens\n    86→        if cache_read_input_tokens > 0:\n    87→            self._hit_count += 1\n    88→\n    89→\n    90→# ─── JD Fixture Loading ──────────────────────────────────────────────────────\n    91→\n    92→\n    93→class JDFixture(BaseModel):\n    94→    \"\"\"A JD fixture loaded from synthetics/fixtures/jobs/.\"\"\"\n    95→\n    96→    filename: str\n    97→    target_candidate: str\n    98→    expected_hot: bool\n    99→    expected_score_band: str  # low | mid | high\n   100→    source: str\n   101→    title: str\n   102→    company: str\n   103→    location: Optional[str] = None\n   104→    description: str\n   105→    url: str = \"\"\n   106→\n   107→\n   108→def load_jd_fixtures(fixtures_dir: Path) -> list[JDFixture]:\n   109→    \"\"\"\n   110→    Load all JD fixtures from the jobs directory.\n   111→\n   112→    Each fixture is a markdown file with YAML frontmatter.\n   113→\n   114→    Args:\n   115→        fixtures_dir: Path to synthetics/fixtures/jobs/\n   116→\n   117→    Returns:\n   118→        List of JDFixture objects\n   119→    \"\"\"\n   120→    fixtures: list[JDFixture] = []\n   121→    jobs_dir = fixtures_dir / \"jobs\"\n   122→\n   123→    if not jobs_dir.exists():\n   124→        logger.warning(\"jd_fixtures.dir_not_found\", path=str(jobs_dir))\n   125→        return fixtures\n   126→\n   127→    for md_file in jobs_dir.glob(\"*.md\"):\n   128→        try:\n   129→            fixture = _parse_jd_fixture(md_file)\n   130→            fixtures.append(fixture)\n   131→            logger.debug(\n   132→                \"jd_fixtures.loaded\",\n   133→                filename=md_file.name,\n   134→                target=fixture.target_candidate,\n   135→            )\n   136→        except Exception as e:\n   137→            logger.error(\n   138→                \"jd_fixtures.parse_error\",\n   139→                filename=md_file.name,\n   140→                error=str(e),\n   141→            )\n   142→\n   143→    logger.info(\"jd_fixtures.loaded_all\", count=len(fixtures))\n   144→    return fixtures\n   145→\n   146→\n   147→def _parse_jd_fixture(path: Path) -> JDFixture:\n   148→    \"\"\"Parse a single JD fixture markdown file with YAML frontmatter.\"\"\"\n   149→    content = path.read_text()\n   150→\n   151→    # Split frontmatter from body\n   152→    if not content.startswith(\"---\"):\n   153→        raise ValueError(f\"No YAML frontmatter in {path.name}\")\n   154→\n   155→    parts = content.split(\"---\", 2)\n   156→    if len(parts) < 3:\n   157→        raise ValueError(f\"Invalid frontmatter format in {path.name}\")\n   158→\n   159→    frontmatter = yaml.safe_load(parts[1])\n   160→    body = parts[2].strip()\n   161→\n   162→    return JDFixture(\n   163→        filename=path.name,\n   164→        target_candidate=frontmatter[\"target_candidate\"],\n   165→        expected_hot=frontmatter[\"expected_hot\"],\n   166→        expected_score_band=frontmatter[\"expected_score_band\"],\n   167→        source=frontmatter.get(\"source\", \"greenhouse\"),\n   168→        title=frontmatter.get(\"title\", \"Unknown Title\"),\n   169→        company=frontmatter.get(\"company\", \"Unknown Company\"),\n   170→        location=frontmatter.get(\"location\"),\n   171→        description=body,\n   172→        url=frontmatter.get(\"url\", f\"https://example.com/jobs/{path.stem}\"),\n   173→    )\n   174→\n   175→\n   176→# ─── Synthetic Candidate Loading ─────────────────────────────────────────────\n   177→\n   178→\n   179→async def load_synthetic_candidates(\n   180→    session: AsyncSession,\n   181→) -> list[CandidateSchema]:\n   182→    \"\"\"\n   183→    Load synthetic candidates from the database.\n   184→\n   185→    Synthetic candidates are identified by UUIDv5 markers matching\n   186→    the pattern: id::text LIKE '00000000-%'\n   187→\n   188→    Contract: NUTRIENTS.md §I.1\n   189→\n   190→    Args:\n   191→        session: Async SQLAlchemy session\n   192→\n   193→    Returns:\n   194→        List of CandidateSchema for synthetic candidates\n   195→    \"\"\"\n   196→    # Query candidates with synthetic UUID pattern\n   197→    result = await session.execute(\n   198→        text(\"\"\"\n   199→            SELECT\n   200→                id, name, email, resume_text, linkedin_url, github_url,\n   201→                personal_context, target_locations, remote_preference,\n   202→                min_compensation, excluded_companies, excluded_industries,\n   203→                created_at, updated_at\n   204→            FROM candidates\n   205→            WHERE id::text LIKE '00000000-%'\n   206→            ORDER BY name\n   207→        \"\"\")\n   208→    )\n   209→\n   210→    candidates: list[CandidateSchema] = []\n   211→    for row in result.fetchall():\n   212→        candidates.append(\n   213→            CandidateSchema(\n   214→                id=row.id,\n   215→                name=row.name,\n   216→                email=row.email,\n   217→                resume_text=row.resume_text or \"\",\n   218→                linkedin_url=row.linkedin_url,\n   219→                github_url=row.github_url,\n   220→                personal_context=row.personal_context,\n   221→                target_locations=list(row.target_locations or []),\n   222→                remote_preference=row.remote_preference or \"flexible\",\n   223→                min_compensation=row.min_compensation,\n   224→                excluded_companies=list(row.excluded_companies or []),\n   225→                excluded_industries=list(row.excluded_industries or []),\n   226→                created_at=row.created_at,\n   227→                updated_at=row.updated_at,\n   228→            )\n   229→        )\n   230→\n   231→    logger.info(\n   232→        \"synthetic_candidates.loaded\",\n   233→        count=len(candidates),\n   234→        ids=[str(c.id) for c in candidates],\n   235→    )\n   236→    return candidates\n   237→\n   238→\n   239→# ─── Cache-Aware Claude Wrapper ──────────────────────────────────────────────\n   240→\n   241→\n   242→class CacheAwareAnthropic:\n   243→    \"\"\"\n   244→    Wrapper around AsyncAnthropic that enforces cache_control headers.\n   245→\n   246→    The RelevanceScorer is FROZEN and doesn't set cache_control.\n   247→    This wrapper intercepts message creation and adds the required\n   248→    cache_control headers per NUTRIENTS.md §I.5.\n   249→    \"\"\"\n   250→\n   251→    def __init__(\n   252→        self,\n   253→        client: AsyncAnthropic,\n   254→        cache_stats: CacheStats,\n   255→        candidate_identity: str,\n   256→    ):\n   257→        \"\"\"\n   258→        Initialize the cache-aware wrapper.\n   259→\n   260→        Args:\n   261→            client: The underlying AsyncAnthropic client\n   262→            cache_stats: CacheStats object to record metrics\n   263→            candidate_identity: Candidate identity text to cache\n   264→        \"\"\"\n   265→        self._client = client\n   266→        self._cache_stats = cache_stats\n   267→        self._candidate_identity = candidate_identity\n   268→        self.messages = _CacheAwareMessages(self)\n   269→\n   270→\n   271→class _CacheAwareMessages:\n   272→    \"\"\"Wraps the messages API to add cache_control.\"\"\"\n   273→\n   274→    def __init__(self, wrapper: CacheAwareAnthropic):\n   275→        self._wrapper = wrapper\n   276→\n   277→    async def create(self, **kwargs) -> object:\n   278→        \"\"\"\n   279→        Create a message with cache_control headers.\n   280→\n   281→        Transforms the messages to include cache_control on system prompt\n   282→        and candidate identity per NUTRIENTS.md §I.5.\n   283→        \"\"\"\n   284→        # Extract original messages\n   285→        messages = kwargs.get(\"messages\", [])\n   286→\n   287→        # Transform to use cache_control\n   288→        transformed_messages = []\n   289→        for msg in messages:\n   290→            if msg.get(\"role\") == \"user\":\n   291→                content = msg.get(\"content\", \"\")\n   292→                if isinstance(content, str):\n   293→                    # Split into cacheable parts\n   294→                    transformed_messages.append(\n   295→                        {\n   296→                            \"role\": \"user\",\n   297→                            \"content\": [\n   298→                                {\n   299→                                    \"type\": \"text\",\n   300→                                    \"text\": self._wrapper._candidate_identity,\n   301→                                    \"cache_control\": {\"type\": \"ephemeral\"},\n   302→                                },\n   303→                                {\n   304→                                    \"type\": \"text\",\n   305→                                    \"text\": content,\n   306→                                },\n   307→                            ],\n   308→                        }\n   309→                    )\n   310→                else:\n   311→                    # Already structured, just pass through\n   312→                    transformed_messages.append(msg)\n   313→            else:\n   314→                transformed_messages.append(msg)\n   315→\n   316→        # Add system prompt with cache_control\n   317→        system_content = [\n   318→            {\n   319→                \"type\": \"text\",\n   320→                \"text\": (\n   321→                    \"You are a talent agent scoring jobs against candidate profiles. \"\n   322→                    \"Return structured JSON responses.\"\n   323→                ),\n   324→                \"cache_control\": {\"type\": \"ephemeral\"},\n   325→            }\n   326→        ]\n   327→\n   328→        # Make the request\n   329→        kwargs[\"messages\"] = transformed_messages\n   330→        kwargs[\"system\"] = system_content\n   331→\n   332→        response = await self._wrapper._client.messages.create(**kwargs)\n   333→\n   334→        # Record cache statistics\n   335→        usage = response.usage\n   336→        cache_creation = getattr(usage, \"cache_creation_input_tokens\", 0) or 0\n   337→        cache_read = getattr(usage, \"cache_read_input_tokens\", 0) or 0\n   338→\n   339→        self._wrapper._cache_stats.record_call(cache_creation, cache_read)\n   340→\n   341→        logger.debug(\n   342→            \"cache_aware.request_complete\",\n   343→            cache_creation_tokens=cache_creation,\n   344→            cache_read_tokens=cache_read,\n   345→            total_calls=self._wrapper._cache_stats.total_calls,\n   346→        )\n   347→\n   348→        return response\n   349→\n   350→\n   351→# ─── Scored Result ───────────────────────────────────────────────────────────\n   352→\n   353→\n   354→class ScoredResult(BaseModel):\n   355→    \"\"\"Result of scoring a single candidate × JD pair.\"\"\"\n   356→\n   357→    candidate_id: str\n   358→    candidate_name: str\n   359→    jd_filename: str\n   360→    scored_job: Optional[ScoredJobSchema] = None\n   361→    expected_hot: bool\n   362→    expected_score_band: str\n   363→    actual_hot: bool = False\n   364→    actual_score: int = 0\n   365→    error: Optional[str] = None\n   366→\n   367→\n   368→class CandidateScoringResult(BaseModel):\n   369→    \"\"\"All scoring results for a single candidate.\"\"\"\n   370→\n   371→    candidate_id: str\n   372→    candidate_name: str\n   373→    profile: Optional[IdentityProfileSchema] = None\n   374→    scored_results: list[ScoredResult] = Field(default_factory=list)\n   375→    cache_stats: dict = Field(default_factory=dict)\n   376→    error: Optional[str] = None\n   377→\n   378→\n   379→# ─── Scoring Runner ──────────────────────────────────────────────────────────\n   380→\n   381→\n   382→class ScoringSyntheticRunner:\n   383→    \"\"\"\n   384→    Iterates synthetic candidates × JD fixtures for drift detection.\n   385→\n   386→    This runner:\n   387→    1. Loads synthetic candidates from the database\n   388→    2. Loads JD fixtures from synthetics/fixtures/jobs/\n   389→    3. For each candidate × JD pair, scores via RelevanceScorer\n   390→    4. Tracks cache hit/miss from Claude API responses\n   391→    5. Returns structured results for fingerprinting\n   392→\n   393→    Contract: NUTRIENTS.md §I.2-I.5, HYPHA-SYNTHETICS-SCORING.md\n   394→    \"\"\"\n   395→\n   396→    def __init__(\n   397→        self,\n   398→        session: AsyncSession,\n   399→        redis_client: aioredis.Redis,\n   400→        anthropic_client: AsyncAnthropic,\n   401→        fixtures_dir: Optional[Path] = None,\n   402→    ):\n   403→        \"\"\"\n   404→        Initialize the ScoringSyntheticRunner.\n   405→\n   406→        Args:\n   407→            session: Async SQLAlchemy session for database access\n   408→            redis_client: Async Redis client for caching\n   409→            anthropic_client: Async Anthropic client for Claude API\n   410→            fixtures_dir: Path to synthetics/fixtures/ (default: auto-detect)\n   411→        \"\"\"\n   412→        self._session = session\n   413→        self._redis = redis_client\n   414→        self._anthropic = anthropic_client\n   415→\n   416→        # Auto-detect fixtures directory if not provided\n   417→        if fixtures_dir is None:\n   418→            self._fixtures_dir = Path(__file__).parent.parent.parent / \"synthetics\" / \"fixtures\"\n   419→        else:\n   420→            self._fixtures_dir = fixtures_dir\n   421→\n   422→        self._run_id = str(uuid.uuid4())\n   423→\n   424→    async def run_suite(self) -> dict:\n   425→        \"\"\"\n   426→        Execute the full scoring suite.\n   427→\n   428→        Iterates all synthetic candidates × applicable JD fixtures,\n   429→        scoring each pair and collecting results.\n   430→\n   431→        Returns:\n   432→            dict with:\n   433→                - run_id: UUID of this run\n   434→                - started_at: ISO timestamp\n   435→                - completed_at: ISO timestamp\n   436→                - candidates: list of CandidateScoringResult\n   437→                - overall_cache_stats: aggregated cache statistics\n   438→        \"\"\"\n   439→        started_at = datetime.now(timezone.utc)\n   440→\n   441→        logger.info(\n   442→            \"scoring_runner.suite_start\",\n   443→            run_id=self._run_id,\n   444→            fixtures_dir=str(self._fixtures_dir),\n   445→        )\n   446→\n   447→        # Load synthetic candidates\n   448→        candidates = await load_synthetic_candidates(self._session)\n   449→        if not candidates:\n   450→            logger.warning(\"scoring_runner.no_candidates\")\n   451→            return {\n   452→                \"run_id\": self._run_id,\n   453→                \"started_at\": started_at.isoformat(),\n   454→                \"completed_at\": datetime.now(timezone.utc).isoformat(),\n   455→                \"candidates\": [],\n   456→                \"overall_cache_stats\": {\"total_calls\": 0, \"cache_hit_rate\": 0.0},\n   457→            }\n   458→\n   459→        # Load JD fixtures\n   460→        jd_fixtures = load_jd_fixtures(self._fixtures_dir)\n   461→        if not jd_fixtures:\n   462→            logger.warning(\"scoring_runner.no_fixtures\")\n   463→            return {\n   464→                \"run_id\": self._run_id,\n   465→                \"started_at\": started_at.isoformat(),\n   466→                \"completed_at\": datetime.now(timezone.utc).isoformat(),\n   467→                \"candidates\": [],\n   468→                \"overall_cache_stats\": {\"total_calls\": 0, \"cache_hit_rate\": 0.0},\n   469→            }\n   470→\n   471→        # Build mapping of candidate slug to JD fixtures\n   472→        candidate_slug_map = self._build_candidate_slug_map(candidates)\n   473→\n   474→        # Process each candidate\n   475→        all_results: list[CandidateScoringResult] = []\n   476→        overall_cache_stats = CacheStats()\n   477→\n   478→        for candidate in candidates:\n   479→            result = await self._score_candidate(\n   480→                candidate,\n   481→                jd_fixtures,\n   482→                candidate_slug_map,\n   483→                overall_cache_stats,\n   484→            )\n   485→            all_results.append(result)\n   486→\n   487→        completed_at = datetime.now(timezone.utc)\n   488→\n   489→        logger.info(\n   490→            \"scoring_runner.suite_complete\",\n   491→            run_id=self._run_id,\n   492→            candidates_processed=len(all_results),\n   493→            total_claude_calls=overall_cache_stats.total_calls,\n   494→            cache_hit_rate=round(overall_cache_stats.cache_hit_rate, 4),\n   495→            duration_seconds=(completed_at - started_at).total_seconds(),\n   496→        )\n   497→\n   498→        return {\n   499→            \"run_id\": self._run_id,\n   500→            \"started_at\": started_at.isoformat(),\n   501→            \"completed_at\": completed_at.isoformat(),\n   502→            \"candidates\": [r.model_dump() for r in all_results],\n   503→            \"overall_cache_stats\": {\n   504→                \"total_calls\": overall_cache_stats.total_calls,\n   505→                \"cache_hits\": overall_cache_stats.cache_hits,\n   506→                \"cache_misses\": overall_cache_stats.cache_misses,\n   507→                \"cache_hit_rate\": round(overall_cache_stats.cache_hit_rate, 4),\n   508→                \"cache_creation_tokens\": overall_cache_stats.cache_creation_tokens,\n   509→                \"cache_read_tokens\": overall_cache_stats.cache_read_tokens,\n   510→            },\n   511→        }\n   512→\n   513→    def _build_candidate_slug_map(\n   514→        self,\n   515→        candidates: list[CandidateSchema],\n   516→    ) -> dict[str, CandidateSchema]:\n   517→        \"\"\"\n   518→        Build a mapping of synthetic slugs to candidates.\n   519→\n   520→        Derives the slug from the candidate's email prefix:\n   521→            jordan.chen.synthetic@... → synthetic-jr-engineer (from name pattern)\n   522→        \"\"\"\n   523→        slug_map: dict[str, CandidateSchema] = {}\n   524→\n   525→        for candidate in candidates:\n   526→            # Extract slug from email pattern or name\n   527→            email = candidate.email.lower()\n   528→\n   529→            if \"jordan\" in email or \"chen\" in email:\n   530→                slug_map[\"synthetic-jr-engineer\"] = candidate\n   531→            elif \"priya\" in email or \"ramanathan\" in email:\n   532→                slug_map[\"synthetic-senior-ml\"] = candidate\n   533→            elif \"marcus\" in email or \"thompson\" in email:\n   534→                slug_map[\"synthetic-mid-product\"] = candidate\n   535→            else:\n   536→                # Fallback: use email prefix\n   537→                prefix = email.split(\"@\")[0].replace(\".\", \"-\")\n   538→                slug_map[prefix] = candidate\n   539→\n   540→        logger.debug(\n   541→            \"candidate_slug_map.built\",\n   542→            slugs=list(slug_map.keys()),\n   543→        )\n   544→        return slug_map\n   545→\n   546→    async def _score_candidate(\n   547→        self,\n   548→        candidate: CandidateSchema,\n   549→        jd_fixtures: list[JDFixture],\n   550→        slug_map: dict[str, CandidateSchema],\n   551→        overall_cache_stats: CacheStats,\n   552→    ) -> CandidateScoringResult:\n   553→        \"\"\"\n   554→        Score all applicable JD fixtures for a single candidate.\n   555→\n   556→        Args:\n   557→            candidate: The synthetic candidate\n   558→            jd_fixtures: All JD fixtures\n   559→            slug_map: Mapping of slugs to candidates\n   560→            overall_cache_stats: Aggregated cache stats\n   561→\n   562→        Returns:\n   563→            CandidateScoringResult with all scoring results\n   564→        \"\"\"\n   565→        # Determine which slug this candidate maps to\n   566→        candidate_slug = None\n   567→        for slug, cand in slug_map.items():\n   568→            if cand.id == candidate.id:\n   569→                candidate_slug = slug\n   570→                break\n   571→\n   572→        if not candidate_slug:\n   573→            logger.warning(\n   574→                \"scoring_runner.unknown_slug\",\n   575→                candidate_id=str(candidate.id),\n   576→                candidate_name=candidate.name,\n   577→            )\n   578→            return CandidateScoringResult(\n   579→                candidate_id=str(candidate.id),\n   580→                candidate_name=candidate.name,\n   581→                error=\"Could not determine candidate slug\",\n   582→            )\n   583→\n   584→        # Filter JD fixtures for this candidate\n   585→        applicable_jds = [\n   586→            jd for jd in jd_fixtures if jd.target_candidate == candidate_slug\n   587→        ]\n   588→\n   589→        logger.info(\n   590→            \"scoring_runner.candidate_start\",\n   591→            candidate_id=str(candidate.id),\n   592→            candidate_name=candidate.name,\n   593→            slug=candidate_slug,\n   594→            applicable_jds=len(applicable_jds),\n   595→        )\n   596→\n   597→        # Build identity profile first\n   598→        candidate_identity = self._build_candidate_identity_text(candidate)\n   599→        cache_stats = CacheStats()\n   600→\n   601→        # Create cache-aware wrapper for this candidate\n   602→        cache_client = CacheAwareAnthropic(\n   603→            self._anthropic,\n   604→            cache_stats,\n   605→            candidate_identity,\n   606→        )\n   607→\n   608→        # Build profile via IdentityProfiler\n   609→        profiler = IdentityProfiler(self._redis, cache_client)\n   610→        try:\n   611→            profile = await profiler.build_profile(candidate)\n   612→        except Exception as e:\n   613→            logger.error(\n   614→                \"scoring_runner.profile_error\",\n   615→                candidate_id=str(candidate.id),\n   616→                error=str(e),\n   617→            )\n   618→            return CandidateScoringResult(\n   619→                candidate_id=str(candidate.id),\n   620→                candidate_name=candidate.name,\n   621→                error=f\"Failed to build profile: {e}\",\n   622→            )\n   623→\n   624→        # Create scorer with cache-aware client\n   625→        scorer = RelevanceScorer(cache_client)\n   626→\n   627→        # Score each applicable JD\n   628→        scored_results: list[ScoredResult] = []\n   629→\n   630→        for jd in applicable_jds:\n   631→            result = await self._score_single_jd(\n   632→                candidate,\n   633→                profile,\n   634→                jd,\n   635→                scorer,\n   636→            )\n   637→            scored_results.append(result)\n   638→\n   639→        # Aggregate cache stats into overall\n   640→        overall_cache_stats.total_calls += cache_stats.total_calls\n   641→        overall_cache_stats.cache_creation_tokens += cache_stats.cache_creation_tokens\n   642→        overall_cache_stats.cache_read_tokens += cache_stats.cache_read_tokens\n   643→        overall_cache_stats._hit_count += cache_stats._hit_count\n   644→\n   645→        logger.info(\n   646→            \"scoring_runner.candidate_complete\",\n   647→            candidate_id=str(candidate.id),\n   648→            scored_count=len(scored_results),\n   649→            cache_calls=cache_stats.total_calls,\n   650→            cache_hit_rate=round(cache_stats.cache_hit_rate, 4),\n   651→        )\n   652→\n   653→        return CandidateScoringResult(\n   654→            candidate_id=str(candidate.id),\n   655→            candidate_name=candidate.name,\n   656→            profile=profile,\n   657→            scored_results=scored_results,\n   658→            cache_stats={\n   659→                \"total_calls\": cache_stats.total_calls,\n   660→                \"cache_hits\": cache_stats.cache_hits,\n   661→                \"cache_misses\": cache_stats.cache_misses,\n   662→                \"cache_hit_rate\": round(cache_stats.cache_hit_rate, 4),\n   663→            },\n   664→        )\n   665→\n   666→    def _build_candidate_identity_text(self, candidate: CandidateSchema) -> str:\n   667→        \"\"\"\n   668→        Build the candidate identity text for caching.\n   669→\n   670→        This text is prepended to all Claude calls for this candidate\n   671→        and marked with cache_control.\n   672→        \"\"\"\n   673→        return f\"\"\"# CANDIDATE IDENTITY\n   674→\n   675→Name: {candidate.name}\n   676→Location: {\", \".join(candidate.target_locations) if candidate.target_locations else \"Flexible\"}\n   677→Remote Preference: {candidate.remote_preference}\n   678→Min Compensation: {candidate.min_compensation or \"Not specified\"}\n   679→Excluded Companies: {\", \".join(candidate.excluded_companies) if candidate.excluded_companies else \"None\"}\n   680→Excluded Industries: {\", \".join(candidate.excluded_industries) if candidate.excluded_industries else \"None\"}\n   681→\n   682→## Resume\n   683→{candidate.resume_text}\n   684→\n   685→## Personal Context\n   686→{candidate.personal_context or \"Not provided\"}\n   687→\"\"\"\n   688→\n   689→    async def _score_single_jd(\n   690→        self,\n   691→        candidate: CandidateSchema,\n   692→        profile: IdentityProfileSchema,\n   693→        jd: JDFixture,\n   694→        scorer: RelevanceScorer,\n   695→    ) -> ScoredResult:\n   696→        \"\"\"\n   697→        Score a single candidate × JD pair.\n   698→\n   699→        Args:\n   700→            candidate: The synthetic candidate\n   701→            profile: The candidate's identity profile\n   702→            jd: The JD fixture\n   703→            scorer: RelevanceScorer instance\n   704→\n   705→        Returns:\n   706→            ScoredResult with scoring details\n   707→        \"\"\"\n   708→        logger.debug(\n   709→            \"scoring_runner.scoring_jd\",\n   710→            candidate_id=str(candidate.id),\n   711→            jd_filename=jd.filename,\n   712→        )\n   713→\n   714→        # Convert JD fixture to DiscoveredJobSchema\n   715→        discovered_job = DiscoveredJobSchema(\n   716→            id=uuid.uuid5(uuid.NAMESPACE_DNS, f\"synthetic-jd-{jd.filename}\"),\n   717→            source=jd.source,\n   718→            source_id=f\"synthetic-{jd.filename}\",\n   719→            title=jd.title,\n   720→            company=jd.company,\n   721→            location=jd.location,\n   722→            description=jd.description,\n   723→            url=jd.url,\n   724→            posted_at=None,\n   725→            salary_min=None,\n   726→            salary_max=None,\n   727→            remote=False,\n   728→            crawled_at=datetime.now(timezone.utc),\n   729→        )\n   730→\n   731→        try:\n   732→            scored_job = await scorer.score_job(\n   733→                discovered_job,\n   734→                profile,\n   735→                candidate.id,\n   736→            )\n   737→\n   738→            return ScoredResult(\n   739→                candidate_id=str(candidate.id),\n   740→                candidate_name=candidate.name,\n   741→                jd_filename=jd.filename,\n   742→                scored_job=scored_job,\n   743→                expected_hot=jd.expected_hot,\n   744→                expected_score_band=jd.expected_score_band,\n   745→                actual_hot=scored_job.is_hot,\n   746→                actual_score=scored_job.composite_score,\n   747→            )\n   748→\n   749→        except Exception as e:\n   750→            logger.error(\n   751→                \"scoring_runner.score_error\",\n   752→                candidate_id=str(candidate.id),\n   753→                jd_filename=jd.filename,\n   754→                error=str(e),\n   755→            )\n   756→            return ScoredResult(\n   757→                candidate_id=str(candidate.id),\n   758→                candidate_name=candidate.name,\n   759→                jd_filename=jd.filename,\n   760→                expected_hot=jd.expected_hot,\n   761→                expected_score_band=jd.expected_score_band,\n   762→                error=str(e),\n   763→            )\n   764→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"d03d3d20-5f6b-41a7-88e6-34cec2448ac8","uuid":"7732e5af-b859-4aca-b146-b8aca650f6b2","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/synthetics/scoring_runner.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nScoring Synthetic Runner — iterates synthetic candidates × JD fixtures.\n\nExecutes the RelevanceScorer against synthetic candidates with cache-aware\ninstrumentation. Tracks cache hit/miss rates from Claude API responses.\n\nThe scorer module (RelevanceScorer) is FROZEN. To enforce the cache contract\n(NUTRIENTS.md §I.5), this runner wraps Claude API calls with cache_control\nheaders by providing a wrapper client that intercepts and augments requests.\n\nContract: NUTRIENTS.md §I.2-I.5, HYPHA-SYNTHETICS-SCORING.md\nOwner: synthetics-scoring-agent.runner\n\"\"\"\n\nfrom __future__ import annotations\n\nimport uuid\nfrom dataclasses import dataclass, field\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Optional\n\nimport redis.asyncio as aioredis\nimport structlog\nimport yaml\nfrom anthropic import AsyncAnthropic\nfrom pydantic import BaseModel, Field\nfrom sqlalchemy import text\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom backend.agents.discovery.identity_profiler import IdentityProfiler\nfrom backend.agents.discovery.relevance_scorer import RelevanceScorer\nfrom backend.agents.discovery.schemas import (\n    CandidateSchema,\n    DiscoveredJobSchema,\n    IdentityProfileSchema,\n    ScoredJobSchema,\n)\n\nlogger = structlog.get_logger(__name__)\n\n\n# ─── Cache Statistics ────────────────────────────────────────────────────────\n\n\n@dataclass\nclass CacheStats:\n    \"\"\"Tracks cache hit/miss statistics for Claude API calls.\"\"\"\n\n    total_calls: int = 0\n    cache_creation_tokens: int = 0\n    cache_read_tokens: int = 0\n\n    @property\n    def cache_hits(self) -> int:\n        \"\"\"Number of calls that hit the cache.\"\"\"\n        # A cache hit is when cache_read_input_tokens > 0\n        return self._hit_count\n\n    @property\n    def cache_misses(self) -> int:\n        \"\"\"Number of calls that missed the cache.\"\"\"\n        return self.total_calls - self._hit_count\n\n    @property\n    def cache_hit_rate(self) -> float:\n        \"\"\"Cache hit rate as a ratio 0.0-1.0.\"\"\"\n        if self.total_calls == 0:\n            return 0.0\n        return self._hit_count / self.total_calls\n\n    _hit_count: int = field(default=0, init=False)\n\n    def record_call(\n        self,\n        cache_creation_input_tokens: int,\n        cache_read_input_tokens: int,\n    ) -> None:\n        \"\"\"Record a Claude API call's cache statistics.\"\"\"\n        self.total_calls += 1\n        self.cache_creation_tokens += cache_creation_input_tokens\n        self.cache_read_tokens += cache_read_input_tokens\n        if cache_read_input_tokens > 0:\n            self._hit_count += 1\n\n\n# ─── JD Fixture Loading ──────────────────────────────────────────────────────\n\n\nclass JDFixture(BaseModel):\n    \"\"\"A JD fixture loaded from synthetics/fixtures/jobs/.\"\"\"\n\n    filename: str\n    target_candidate: str\n    expected_hot: bool\n    expected_score_band: str  # low | mid | high\n    source: str\n    title: str\n    company: str\n    location: Optional[str] = None\n    description: str\n    url: str = \"\"\n\n\ndef load_jd_fixtures(fixtures_dir: Path) -> list[JDFixture]:\n    \"\"\"\n    Load all JD fixtures from the jobs directory.\n\n    Each fixture is a markdown file with YAML frontmatter.\n\n    Args:\n        fixtures_dir: Path to synthetics/fixtures/jobs/\n\n    Returns:\n        List of JDFixture objects\n    \"\"\"\n    fixtures: list[JDFixture] = []\n    jobs_dir = fixtures_dir / \"jobs\"\n\n    if not jobs_dir.exists():\n        logger.warning(\"jd_fixtures.dir_not_found\", path=str(jobs_dir))\n        return fixtures\n\n    for md_file in jobs_dir.glob(\"*.md\"):\n        try:\n            fixture = _parse_jd_fixture(md_file)\n            fixtures.append(fixture)\n            logger.debug(\n                \"jd_fixtures.loaded\",\n                filename=md_file.name,\n                target=fixture.target_candidate,\n            )\n        except Exception as e:\n            logger.error(\n                \"jd_fixtures.parse_error\",\n                filename=md_file.name,\n                error=str(e),\n            )\n\n    logger.info(\"jd_fixtures.loaded_all\", count=len(fixtures))\n    return fixtures\n\n\ndef _parse_jd_fixture(path: Path) -> JDFixture:\n    \"\"\"Parse a single JD fixture markdown file with YAML frontmatter.\"\"\"\n    content = path.read_text()\n\n    # Split frontmatter from body\n    if not content.startswith(\"---\"):\n        raise ValueError(f\"No YAML frontmatter in {path.name}\")\n\n    parts = content.split(\"---\", 2)\n    if len(parts) < 3:\n        raise ValueError(f\"Invalid frontmatter format in {path.name}\")\n\n    frontmatter = yaml.safe_load(parts[1])\n    body = parts[2].strip()\n\n    return JDFixture(\n        filename=path.name,\n        target_candidate=frontmatter[\"target_candidate\"],\n        expected_hot=frontmatter[\"expected_hot\"],\n        expected_score_band=frontmatter[\"expected_score_band\"],\n        source=frontmatter.get(\"source\", \"greenhouse\"),\n        title=frontmatter.get(\"title\", \"Unknown Title\"),\n        company=frontmatter.get(\"company\", \"Unknown Company\"),\n        location=frontmatter.get(\"location\"),\n        description=body,\n        url=frontmatter.get(\"url\", f\"https://example.com/jobs/{path.stem}\"),\n    )\n\n\n# ─── Synthetic Candidate Loading ─────────────────────────────────────────────\n\n\nasync def load_synthetic_candidates(\n    session: AsyncSession,\n) -> list[CandidateSchema]:\n    \"\"\"\n    Load synthetic candidates from the database.\n\n    Synthetic candidates are identified by UUIDv5 markers matching\n    the pattern: id::text LIKE '00000000-%'\n\n    Contract: NUTRIENTS.md §I.1\n\n    Args:\n        session: Async SQLAlchemy session\n\n    Returns:\n        List of CandidateSchema for synthetic candidates\n    \"\"\"\n    # Query candidates with synthetic UUID pattern\n    result = await session.execute(\n        text(\"\"\"\n            SELECT\n                id, name, email, resume_text, linkedin_url, github_url,\n                personal_context, target_locations, remote_preference,\n                min_compensation, excluded_companies, excluded_industries,\n                created_at, updated_at\n            FROM candidates\n            WHERE id::text LIKE '00000000-%'\n            ORDER BY name\n        \"\"\")\n    )\n\n    candidates: list[CandidateSchema] = []\n    for row in result.fetchall():\n        candidates.append(\n            CandidateSchema(\n                id=row.id,\n                name=row.name,\n                email=row.email,\n                resume_text=row.resume_text or \"\",\n                linkedin_url=row.linkedin_url,\n                github_url=row.github_url,\n                personal_context=row.personal_context,\n                target_locations=list(row.target_locations or []),\n                remote_preference=row.remote_preference or \"flexible\",\n                min_compensation=row.min_compensation,\n                excluded_companies=list(row.excluded_companies or []),\n                excluded_industries=list(row.excluded_industries or []),\n                created_at=row.created_at,\n                updated_at=row.updated_at,\n            )\n        )\n\n    logger.info(\n        \"synthetic_candidates.loaded\",\n        count=len(candidates),\n        ids=[str(c.id) for c in candidates],\n    )\n    return candidates\n\n\n# ─── Cache-Aware Claude Wrapper ──────────────────────────────────────────────\n\n\nclass CacheAwareAnthropic:\n    \"\"\"\n    Wrapper around AsyncAnthropic that enforces cache_control headers.\n\n    The RelevanceScorer is FROZEN and doesn't set cache_control.\n    This wrapper intercepts message creation and adds the required\n    cache_control headers per NUTRIENTS.md §I.5.\n    \"\"\"\n\n    def __init__(\n        self,\n        client: AsyncAnthropic,\n        cache_stats: CacheStats,\n        candidate_identity: str,\n    ):\n        \"\"\"\n        Initialize the cache-aware wrapper.\n\n        Args:\n            client: The underlying AsyncAnthropic client\n            cache_stats: CacheStats object to record metrics\n            candidate_identity: Candidate identity text to cache\n        \"\"\"\n        self._client = client\n        self._cache_stats = cache_stats\n        self._candidate_identity = candidate_identity\n        self.messages = _CacheAwareMessages(self)\n\n\nclass _CacheAwareMessages:\n    \"\"\"Wraps the messages API to add cache_control.\"\"\"\n\n    def __init__(self, wrapper: CacheAwareAnthropic):\n        self._wrapper = wrapper\n\n    async def create(self, **kwargs) -> object:\n        \"\"\"\n        Create a message with cache_control headers.\n\n        Transforms the messages to include cache_control on system prompt\n        and candidate identity per NUTRIENTS.md §I.5.\n        \"\"\"\n        # Extract original messages\n        messages = kwargs.get(\"messages\", [])\n\n        # Transform to use cache_control\n        transformed_messages = []\n        for msg in messages:\n            if msg.get(\"role\") == \"user\":\n                content = msg.get(\"content\", \"\")\n                if isinstance(content, str):\n                    # Split into cacheable parts\n                    transformed_messages.append(\n                        {\n                            \"role\": \"user\",\n                            \"content\": [\n                                {\n                                    \"type\": \"text\",\n                                    \"text\": self._wrapper._candidate_identity,\n                                    \"cache_control\": {\"type\": \"ephemeral\"},\n                                },\n                                {\n                                    \"type\": \"text\",\n                                    \"text\": content,\n                                },\n                            ],\n                        }\n                    )\n                else:\n                    # Already structured, just pass through\n                    transformed_messages.append(msg)\n            else:\n                transformed_messages.append(msg)\n\n        # Add system prompt with cache_control\n        system_content = [\n            {\n                \"type\": \"text\",\n                \"text\": (\n                    \"You are a talent agent scoring jobs against candidate profiles. \"\n                    \"Return structured JSON responses.\"\n                ),\n                \"cache_control\": {\"type\": \"ephemeral\"},\n            }\n        ]\n\n        # Make the request\n        kwargs[\"messages\"] = transformed_messages\n        kwargs[\"system\"] = system_content\n\n        response = await self._wrapper._client.messages.create(**kwargs)\n\n        # Record cache statistics\n        usage = response.usage\n        cache_creation = getattr(usage, \"cache_creation_input_tokens\", 0) or 0\n        cache_read = getattr(usage, \"cache_read_input_tokens\", 0) or 0\n\n        self._wrapper._cache_stats.record_call(cache_creation, cache_read)\n\n        logger.debug(\n            \"cache_aware.request_complete\",\n            cache_creation_tokens=cache_creation,\n            cache_read_tokens=cache_read,\n            total_calls=self._wrapper._cache_stats.total_calls,\n        )\n\n        return response\n\n\n# ─── Scored Result ───────────────────────────────────────────────────────────\n\n\nclass ScoredResult(BaseModel):\n    \"\"\"Result of scoring a single candidate × JD pair.\"\"\"\n\n    candidate_id: str\n    candidate_name: str\n    jd_filename: str\n    scored_job: Optional[ScoredJobSchema] = None\n    expected_hot: bool\n    expected_score_band: str\n    actual_hot: bool = False\n    actual_score: int = 0\n    error: Optional[str] = None\n\n\nclass CandidateScoringResult(BaseModel):\n    \"\"\"All scoring results for a single candidate.\"\"\"\n\n    candidate_id: str\n    candidate_name: str\n    profile: Optional[IdentityProfileSchema] = None\n    scored_results: list[ScoredResult] = Field(default_factory=list)\n    cache_stats: dict = Field(default_factory=dict)\n    error: Optional[str] = None\n\n\n# ─── Scoring Runner ──────────────────────────────────────────────────────────\n\n\nclass ScoringSyntheticRunner:\n    \"\"\"\n    Iterates synthetic candidates × JD fixtures for drift detection.\n\n    This runner:\n    1. Loads synthetic candidates from the database\n    2. Loads JD fixtures from synthetics/fixtures/jobs/\n    3. For each candidate × JD pair, scores via RelevanceScorer\n    4. Tracks cache hit/miss from Claude API responses\n    5. Returns structured results for fingerprinting\n\n    Contract: NUTRIENTS.md §I.2-I.5, HYPHA-SYNTHETICS-SCORING.md\n    \"\"\"\n\n    def __init__(\n        self,\n        session: AsyncSession,\n        redis_client: aioredis.Redis,\n        anthropic_client: AsyncAnthropic,\n        fixtures_dir: Optional[Path] = None,\n    ):\n        \"\"\"\n        Initialize the ScoringSyntheticRunner.\n\n        Args:\n            session: Async SQLAlchemy session for database access\n            redis_client: Async Redis client for caching\n            anthropic_client: Async Anthropic client for Claude API\n            fixtures_dir: Path to synthetics/fixtures/ (default: auto-detect)\n        \"\"\"\n        self._session = session\n        self._redis = redis_client\n        self._anthropic = anthropic_client\n\n        # Auto-detect fixtures directory if not provided\n        if fixtures_dir is None:\n            self._fixtures_dir = Path(__file__).parent.parent.parent / \"synthetics\" / \"fixtures\"\n        else:\n            self._fixtures_dir = fixtures_dir\n\n        self._run_id = str(uuid.uuid4())\n\n    async def run_suite(self) -> dict:\n        \"\"\"\n        Execute the full scoring suite.\n\n        Iterates all synthetic candidates × applicable JD fixtures,\n        scoring each pair and collecting results.\n\n        Returns:\n            dict with:\n                - run_id: UUID of this run\n                - started_at: ISO timestamp\n                - completed_at: ISO timestamp\n                - candidates: list of CandidateScoringResult\n                - overall_cache_stats: aggregated cache statistics\n        \"\"\"\n        started_at = datetime.now(timezone.utc)\n\n        logger.info(\n            \"scoring_runner.suite_start\",\n            run_id=self._run_id,\n            fixtures_dir=str(self._fixtures_dir),\n        )\n\n        # Load synthetic candidates\n        candidates = await load_synthetic_candidates(self._session)\n        if not candidates:\n            logger.warning(\"scoring_runner.no_candidates\")\n            return {\n                \"run_id\": self._run_id,\n                \"started_at\": started_at.isoformat(),\n                \"completed_at\": datetime.now(timezone.utc).isoformat(),\n                \"candidates\": [],\n                \"overall_cache_stats\": {\"total_calls\": 0, \"cache_hit_rate\": 0.0},\n            }\n\n        # Load JD fixtures\n        jd_fixtures = load_jd_fixtures(self._fixtures_dir)\n        if not jd_fixtures:\n            logger.warning(\"scoring_runner.no_fixtures\")\n            return {\n                \"run_id\": self._run_id,\n                \"started_at\": started_at.isoformat(),\n                \"completed_at\": datetime.now(timezone.utc).isoformat(),\n                \"candidates\": [],\n                \"overall_cache_stats\": {\"total_calls\": 0, \"cache_hit_rate\": 0.0},\n            }\n\n        # Build mapping of candidate slug to JD fixtures\n        candidate_slug_map = self._build_candidate_slug_map(candidates)\n\n        # Process each candidate\n        all_results: list[CandidateScoringResult] = []\n        overall_cache_stats = CacheStats()\n\n        for candidate in candidates:\n            result = await self._score_candidate(\n                candidate,\n                jd_fixtures,\n                candidate_slug_map,\n                overall_cache_stats,\n            )\n            all_results.append(result)\n\n        completed_at = datetime.now(timezone.utc)\n\n        logger.info(\n            \"scoring_runner.suite_complete\",\n            run_id=self._run_id,\n            candidates_processed=len(all_results),\n            total_claude_calls=overall_cache_stats.total_calls,\n            cache_hit_rate=round(overall_cache_stats.cache_hit_rate, 4),\n            duration_seconds=(completed_at - started_at).total_seconds(),\n        )\n\n        return {\n            \"run_id\": self._run_id,\n            \"started_at\": started_at.isoformat(),\n            \"completed_at\": completed_at.isoformat(),\n            \"candidates\": [r.model_dump() for r in all_results],\n            \"overall_cache_stats\": {\n                \"total_calls\": overall_cache_stats.total_calls,\n                \"cache_hits\": overall_cache_stats.cache_hits,\n                \"cache_misses\": overall_cache_stats.cache_misses,\n                \"cache_hit_rate\": round(overall_cache_stats.cache_hit_rate, 4),\n                \"cache_creation_tokens\": overall_cache_stats.cache_creation_tokens,\n                \"cache_read_tokens\": overall_cache_stats.cache_read_tokens,\n            },\n        }\n\n    def _build_candidate_slug_map(\n        self,\n        candidates: list[CandidateSchema],\n    ) -> dict[str, CandidateSchema]:\n        \"\"\"\n        Build a mapping of synthetic slugs to candidates.\n\n        Derives the slug from the candidate's email prefix:\n            jordan.chen.synthetic@... → synthetic-jr-engineer (from name pattern)\n        \"\"\"\n        slug_map: dict[str, CandidateSchema] = {}\n\n        for candidate in candidates:\n            # Extract slug from email pattern or name\n            email = candidate.email.lower()\n\n            if \"jordan\" in email or \"chen\" in email:\n                slug_map[\"synthetic-jr-engineer\"] = candidate\n            elif \"priya\" in email or \"ramanathan\" in email:\n                slug_map[\"synthetic-senior-ml\"] = candidate\n            elif \"marcus\" in email or \"thompson\" in email:\n                slug_map[\"synthetic-mid-product\"] = candidate\n            else:\n                # Fallback: use email prefix\n                prefix = email.split(\"@\")[0].replace(\".\", \"-\")\n                slug_map[prefix] = candidate\n\n        logger.debug(\n            \"candidate_slug_map.built\",\n            slugs=list(slug_map.keys()),\n        )\n        return slug_map\n\n    async def _score_candidate(\n        self,\n        candidate: CandidateSchema,\n        jd_fixtures: list[JDFixture],\n        slug_map: dict[str, CandidateSchema],\n        overall_cache_stats: CacheStats,\n    ) -> CandidateScoringResult:\n        \"\"\"\n        Score all applicable JD fixtures for a single candidate.\n\n        Args:\n            candidate: The synthetic candidate\n            jd_fixtures: All JD fixtures\n            slug_map: Mapping of slugs to candidates\n            overall_cache_stats: Aggregated cache stats\n\n        Returns:\n            CandidateScoringResult with all scoring results\n        \"\"\"\n        # Determine which slug this candidate maps to\n        candidate_slug = None\n        for slug, cand in slug_map.items():\n            if cand.id == candidate.id:\n                candidate_slug = slug\n                break\n\n        if not candidate_slug:\n            logger.warning(\n                \"scoring_runner.unknown_slug\",\n                candidate_id=str(candidate.id),\n                candidate_name=candidate.name,\n            )\n            return CandidateScoringResult(\n                candidate_id=str(candidate.id),\n                candidate_name=candidate.name,\n                error=\"Could not determine candidate slug\",\n            )\n\n        # Filter JD fixtures for this candidate\n        applicable_jds = [\n            jd for jd in jd_fixtures if jd.target_candidate == candidate_slug\n        ]\n\n        logger.info(\n            \"scoring_runner.candidate_start\",\n            candidate_id=str(candidate.id),\n            candidate_name=candidate.name,\n            slug=candidate_slug,\n            applicable_jds=len(applicable_jds),\n        )\n\n        # Build identity profile first\n        candidate_identity = self._build_candidate_identity_text(candidate)\n        cache_stats = CacheStats()\n\n        # Create cache-aware wrapper for this candidate\n        cache_client = CacheAwareAnthropic(\n            self._anthropic,\n            cache_stats,\n            candidate_identity,\n        )\n\n        # Build profile via IdentityProfiler\n        profiler = IdentityProfiler(self._redis, cache_client)\n        try:\n            profile = await profiler.build_profile(candidate)\n        except Exception as e:\n            logger.error(\n                \"scoring_runner.profile_error\",\n                candidate_id=str(candidate.id),\n                error=str(e),\n            )\n            return CandidateScoringResult(\n                candidate_id=str(candidate.id),\n                candidate_name=candidate.name,\n                error=f\"Failed to build profile: {e}\",\n            )\n\n        # Create scorer with cache-aware client\n        scorer = RelevanceScorer(cache_client)\n\n        # Score each applicable JD\n        scored_results: list[ScoredResult] = []\n\n        for jd in applicable_jds:\n            result = await self._score_single_jd(\n                candidate,\n                profile,\n                jd,\n                scorer,\n            )\n            scored_results.append(result)\n\n        # Aggregate cache stats into overall\n        overall_cache_stats.total_calls += cache_stats.total_calls\n        overall_cache_stats.cache_creation_tokens += cache_stats.cache_creation_tokens\n        overall_cache_stats.cache_read_tokens += cache_stats.cache_read_tokens\n        overall_cache_stats._hit_count += cache_stats._hit_count\n\n        logger.info(\n            \"scoring_runner.candidate_complete\",\n            candidate_id=str(candidate.id),\n            scored_count=len(scored_results),\n            cache_calls=cache_stats.total_calls,\n            cache_hit_rate=round(cache_stats.cache_hit_rate, 4),\n        )\n\n        return CandidateScoringResult(\n            candidate_id=str(candidate.id),\n            candidate_name=candidate.name,\n            profile=profile,\n            scored_results=scored_results,\n            cache_stats={\n                \"total_calls\": cache_stats.total_calls,\n                \"cache_hits\": cache_stats.cache_hits,\n                \"cache_misses\": cache_stats.cache_misses,\n                \"cache_hit_rate\": round(cache_stats.cache_hit_rate, 4),\n            },\n        )\n\n    def _build_candidate_identity_text(self, candidate: CandidateSchema) -> str:\n        \"\"\"\n        Build the candidate identity text for caching.\n\n        This text is prepended to all Claude calls for this candidate\n        and marked with cache_control.\n        \"\"\"\n        return f\"\"\"# CANDIDATE IDENTITY\n\nName: {candidate.name}\nLocation: {\", \".join(candidate.target_locations) if candidate.target_locations else \"Flexible\"}\nRemote Preference: {candidate.remote_preference}\nMin Compensation: {candidate.min_compensation or \"Not specified\"}\nExcluded Companies: {\", \".join(candidate.excluded_companies) if candidate.excluded_companies else \"None\"}\nExcluded Industries: {\", \".join(candidate.excluded_industries) if candidate.excluded_industries else \"None\"}\n\n## Resume\n{candidate.resume_text}\n\n## Personal Context\n{candidate.personal_context or \"Not provided\"}\n\"\"\"\n\n    async def _score_single_jd(\n        self,\n        candidate: CandidateSchema,\n        profile: IdentityProfileSchema,\n        jd: JDFixture,\n        scorer: RelevanceScorer,\n    ) -> ScoredResult:\n        \"\"\"\n        Score a single candidate × JD pair.\n\n        Args:\n            candidate: The synthetic candidate\n            profile: The candidate's identity profile\n            jd: The JD fixture\n            scorer: RelevanceScorer instance\n\n        Returns:\n            ScoredResult with scoring details\n        \"\"\"\n        logger.debug(\n            \"scoring_runner.scoring_jd\",\n            candidate_id=str(candidate.id),\n            jd_filename=jd.filename,\n        )\n\n        # Convert JD fixture to DiscoveredJobSchema\n        discovered_job = DiscoveredJobSchema(\n            id=uuid.uuid5(uuid.NAMESPACE_DNS, f\"synthetic-jd-{jd.filename}\"),\n            source=jd.source,\n            source_id=f\"synthetic-{jd.filename}\",\n            title=jd.title,\n            company=jd.company,\n            location=jd.location,\n            description=jd.description,\n            url=jd.url,\n            posted_at=None,\n            salary_min=None,\n            salary_max=None,\n            remote=False,\n            crawled_at=datetime.now(timezone.utc),\n        )\n\n        try:\n            scored_job = await scorer.score_job(\n                discovered_job,\n                profile,\n                candidate.id,\n            )\n\n            return ScoredResult(\n                candidate_id=str(candidate.id),\n                candidate_name=candidate.name,\n                jd_filename=jd.filename,\n                scored_job=scored_job,\n                expected_hot=jd.expected_hot,\n                expected_score_band=jd.expected_score_band,\n                actual_hot=scored_job.is_hot,\n                actual_score=scored_job.composite_score,\n            )\n\n        except Exception as e:\n            logger.error(\n                \"scoring_runner.score_error\",\n                candidate_id=str(candidate.id),\n                jd_filename=jd.filename,\n                error=str(e),\n            )\n            return ScoredResult(\n                candidate_id=str(candidate.id),\n                candidate_name=candidate.name,\n                jd_filename=jd.filename,\n                expected_hot=jd.expected_hot,\n                expected_score_band=jd.expected_score_band,\n                error=str(e),\n            )\n","numLines":764,"startLine":1,"totalLines":764}}}}
