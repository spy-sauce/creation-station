{"t":"2026-05-28T03:45:32.420Z","event":"sdk_msg","msg":{"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_01FkVc44Zg36aVC98v8Cfmjg","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011JsHCjZ6dcXHCHC3hFDUMF","name":"Write","input":{"file_path":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/synthetics/diff.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nDiff module — compares fingerprints against baselines for drift detection.\n\nTakes a ScoringFingerprint and compares it against a baseline fingerprint,\napplying the contract rules from NUTRIENTS.md §I.2-I.4:\n    - Exact-match fields: must be byte-identical\n    - Tolerance-match fields: allow bounded variance (±N%)\n    - Excluded fields: never compared\n\nProduces a DriftReport with severity classification:\n    - green: zero violations\n    - yellow: tolerance violations only, no exact-match violations\n    - red: any exact-match violation OR tolerance violation > 2× threshold\n\nContract: NUTRIENTS.md §I.2-I.4, HYPHA-SYNTHETICS-SCORING.md\nOwner: synthetics-scoring-agent.diff\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import datetime, timezone\nfrom typing import Any, Optional\n\nimport structlog\nfrom pydantic import BaseModel, Field\n\nfrom backend.synthetics.fingerprint import (\n    FingerprintContract,\n    ScoringFingerprint,\n    TopPickFingerprint,\n    TOLERANCE_THRESHOLDS,\n)\n\nlogger = structlog.get_logger(__name__)\n\n\n# ─── Drift Types ──────────────────────────────────────────────────────────────\n\n\nclass DriftViolation(BaseModel):\n    \"\"\"\n    A single drift violation detected during comparison.\n\n    Contract: NUTRIENTS.md §I.4 (DriftViolation)\n    \"\"\"\n\n    field: str = Field(description=\"Dotted path to the violated field\")\n    baseline_value: Any = Field(description=\"Value in the baseline\")\n    current_value: Any = Field(description=\"Value in the current run\")\n    delta_pct: Optional[float] = Field(\n        default=None,\n        description=\"Percentage drift for tolerance fields (null for exact fields)\",\n    )\n\n\nclass DriftSeverity:\n    \"\"\"Drift severity levels.\"\"\"\n\n    GREEN = \"green\"\n    YELLOW = \"yellow\"\n    RED = \"red\"\n\n\nclass DriftReport(BaseModel):\n    \"\"\"\n    Complete drift report comparing current fingerprint against baseline.\n\n    Severity rules from NUTRIENTS.md §I.4:\n        - green: zero violations\n        - yellow: tolerance violations only, no exact-match violations\n        - red: any exact-match violation OR tolerance violation > 2× threshold\n\n    Contract: NUTRIENTS.md §I.4 (DriftReport)\n    \"\"\"\n\n    candidate_id: str = Field(description=\"Synthetic candidate UUID\")\n    run_id: str = Field(description=\"UUID of the current run\")\n    baseline_run_id: str = Field(description=\"UUID of the baseline run\")\n    exact_violations: list[DriftViolation] = Field(\n        default_factory=list,\n        description=\"Violations in exact-match fields\",\n    )\n    tolerance_violations: list[DriftViolation] = Field(\n        default_factory=list,\n        description=\"Violations in tolerance-match fields\",\n    )\n    severity: str = Field(\n        default=DriftSeverity.GREEN,\n        description=\"Overall severity: green, yellow, or red\",\n    )\n    computed_at: str = Field(\n        default_factory=lambda: datetime.now(timezone.utc).isoformat(),\n        description=\"ISO-8601 timestamp of computation\",\n    )\n\n\n# ─── Diff Against Baseline ────────────────────────────────────────────────────\n\n\ndef diff_against_baseline(\n    fingerprint: ScoringFingerprint,\n    baseline: ScoringFingerprint,\n    contract: Optional[FingerprintContract] = None,\n) -> DriftReport:\n    \"\"\"\n    Compare a fingerprint against a baseline and produce a drift report.\n\n    Applies the contract rules from NUTRIENTS.md §I.2:\n        - Exact-match fields: byte-identical comparison\n        - Tolerance-match fields: bounded variance check\n\n    Args:\n        fingerprint: The current run's fingerprint\n        baseline: The accepted baseline fingerprint\n        contract: Optional FingerprintContract defining thresholds\n            Defaults to standard contract from NUTRIENTS.md §I.2\n\n    Returns:\n        DriftReport with violations and severity classification\n\n    Example:\n        >>> report = diff_against_baseline(current_fp, baseline_fp)\n        >>> if report.severity != \"green\":\n        ...     publish_drift_alert(report)\n    \"\"\"\n    if contract is None:\n        contract = FingerprintContract()\n\n    logger.debug(\n        \"diff.comparing\",\n        candidate_id=fingerprint.candidate_id,\n        run_id=fingerprint.run_id,\n        baseline_run_id=baseline.run_id,\n    )\n\n    # Collect violations\n    exact_violations = _check_exact_fields(fingerprint, baseline)\n    tolerance_violations = _check_tolerance_fields(fingerprint, baseline, contract)\n\n    # Determine severity\n    severity = _compute_severity(exact_violations, tolerance_violations, contract)\n\n    report = DriftReport(\n        candidate_id=fingerprint.candidate_id,\n        run_id=fingerprint.run_id,\n        baseline_run_id=baseline.run_id,\n        exact_violations=exact_violations,\n        tolerance_violations=tolerance_violations,\n        severity=severity,\n    )\n\n    logger.info(\n        \"diff.complete\",\n        candidate_id=fingerprint.candidate_id,\n        severity=severity,\n        exact_violation_count=len(exact_violations),\n        tolerance_violation_count=len(tolerance_violations),\n    )\n\n    return report\n\n\ndef _check_exact_fields(\n    fingerprint: ScoringFingerprint,\n    baseline: ScoringFingerprint,\n) -> list[DriftViolation]:\n    \"\"\"\n    Check exact-match fields for any differences.\n\n    Per NUTRIENTS.md §I.2, these fields MUST be byte-identical:\n        - digest.top_picks[0..4].job.id\n        - digest.top_picks[0..4].job.source\n        - digest.top_picks[0..4].job.url\n        - digest.top_picks[0..4].ordering\n\n    Args:\n        fingerprint: Current fingerprint\n        baseline: Baseline fingerprint\n\n    Returns:\n        List of DriftViolation for any differences\n    \"\"\"\n    violations: list[DriftViolation] = []\n\n    current_picks = fingerprint.exact_fields.top_picks\n    baseline_picks = baseline.exact_fields.top_picks\n\n    # Compare top picks ordering and content\n    max_picks = max(len(current_picks), len(baseline_picks))\n\n    for i in range(min(5, max_picks)):  # Only first 5 per contract\n        current = current_picks[i] if i < len(current_picks) else None\n        baseline_pick = baseline_picks[i] if i < len(baseline_picks) else None\n\n        if current is None and baseline_pick is None:\n            continue\n\n        if current is None:\n            violations.append(\n                DriftViolation(\n                    field=f\"exact_fields.top_picks[{i}]\",\n                    baseline_value=baseline_pick.model_dump() if baseline_pick else None,\n                    current_value=None,\n                )\n            )\n            continue\n\n        if baseline_pick is None:\n            violations.append(\n                DriftViolation(\n                    field=f\"exact_fields.top_picks[{i}]\",\n                    baseline_value=None,\n                    current_value=current.model_dump() if current else None,\n                )\n            )\n            continue\n\n        # Compare individual fields\n        if current.job_id != baseline_pick.job_id:\n            violations.append(\n                DriftViolation(\n                    field=f\"exact_fields.top_picks[{i}].job_id\",\n                    baseline_value=baseline_pick.job_id,\n                    current_value=current.job_id,\n                )\n            )\n\n        if current.source != baseline_pick.source:\n            violations.append(\n                DriftViolation(\n                    field=f\"exact_fields.top_picks[{i}].source\",\n                    baseline_value=baseline_pick.source,\n                    current_value=current.source,\n                )\n            )\n\n        if current.url != baseline_pick.url:\n            violations.append(\n                DriftViolation(\n                    field=f\"exact_fields.top_picks[{i}].url\",\n                    baseline_value=baseline_pick.url,\n                    current_value=current.url,\n                )\n            )\n\n        if current.position != baseline_pick.position:\n            violations.append(\n                DriftViolation(\n                    field=f\"exact_fields.top_picks[{i}].position\",\n                    baseline_value=baseline_pick.position,\n                    current_value=current.position,\n                )\n            )\n\n    return violations\n\n\ndef _check_tolerance_fields(\n    fingerprint: ScoringFingerprint,\n    baseline: ScoringFingerprint,\n    contract: FingerprintContract,\n) -> list[DriftViolation]:\n    \"\"\"\n    Check tolerance-match fields for variance exceeding thresholds.\n\n    Per NUTRIENTS.md §I.2, these fields allow bounded variance:\n        - score.technical_match: ±5%\n        - score.level_match: ±5%\n        - score.culture_match: ±5%\n        - score.industry_match: ±5%\n        - score.growth_potential: ±5%\n        - score.compensation_match: ±5%\n        - composite_score: ±3%\n        - total_jobs_discovered: ±10%\n\n    Args:\n        fingerprint: Current fingerprint\n        baseline: Baseline fingerprint\n        contract: Contract defining tolerance thresholds\n\n    Returns:\n        List of DriftViolation for fields exceeding tolerance\n    \"\"\"\n    violations: list[DriftViolation] = []\n\n    # Map of field name -> (current_value, baseline_value, threshold)\n    tolerance_checks = [\n        (\n            \"tolerance_fields.technical_match\",\n            fingerprint.tolerance_fields.technical_match.value,\n            baseline.tolerance_fields.technical_match.value,\n            TOLERANCE_THRESHOLDS.get(\"technical_match\").tolerance,\n        ),\n        (\n            \"tolerance_fields.level_match\",\n            fingerprint.tolerance_fields.level_match.value,\n            baseline.tolerance_fields.level_match.value,\n            TOLERANCE_THRESHOLDS.get(\"level_match\").tolerance,\n        ),\n        (\n            \"tolerance_fields.culture_match\",\n            fingerprint.tolerance_fields.culture_match.value,\n            baseline.tolerance_fields.culture_match.value,\n            TOLERANCE_THRESHOLDS.get(\"culture_match\").tolerance,\n        ),\n        (\n            \"tolerance_fields.industry_match\",\n            fingerprint.tolerance_fields.industry_match.value,\n            baseline.tolerance_fields.industry_match.value,\n            TOLERANCE_THRESHOLDS.get(\"industry_match\").tolerance,\n        ),\n        (\n            \"tolerance_fields.growth_potential\",\n            fingerprint.tolerance_fields.growth_potential.value,\n            baseline.tolerance_fields.growth_potential.value,\n            TOLERANCE_THRESHOLDS.get(\"growth_potential\").tolerance,\n        ),\n        (\n            \"tolerance_fields.compensation_match\",\n            fingerprint.tolerance_fields.compensation_match.value,\n            baseline.tolerance_fields.compensation_match.value,\n            TOLERANCE_THRESHOLDS.get(\"compensation_match\").tolerance,\n        ),\n        (\n            \"tolerance_fields.composite_score\",\n            fingerprint.tolerance_fields.composite_score.value,\n            baseline.tolerance_fields.composite_score.value,\n            TOLERANCE_THRESHOLDS.get(\"composite_score\").tolerance,\n        ),\n        (\n            \"tolerance_fields.total_jobs_discovered\",\n            fingerprint.tolerance_fields.total_jobs_discovered.value,\n            baseline.tolerance_fields.total_jobs_discovered.value,\n            TOLERANCE_THRESHOLDS.get(\"total_jobs_discovered\").tolerance,\n        ),\n    ]\n\n    for field_name, current_val, baseline_val, threshold in tolerance_checks:\n        # Skip if baseline is zero (avoid division by zero)\n        if baseline_val == 0:\n            if current_val != 0:\n                # Any non-zero when baseline is zero is a violation\n                violations.append(\n                    DriftViolation(\n                        field=field_name,\n                        baseline_value=baseline_val,\n                        current_value=current_val,\n                        delta_pct=None,  # Cannot compute percentage\n                    )\n                )\n            continue\n\n        # Calculate drift percentage\n        delta_pct = abs((current_val - baseline_val) / baseline_val)\n\n        if delta_pct > threshold:\n            violations.append(\n                DriftViolation(\n                    field=field_name,\n                    baseline_value=baseline_val,\n                    current_value=current_val,\n                    delta_pct=round(delta_pct, 4),\n                )\n            )\n\n    return violations\n\n\ndef _compute_severity(\n    exact_violations: list[DriftViolation],\n    tolerance_violations: list[DriftViolation],\n    contract: FingerprintContract,\n) -> str:\n    \"\"\"\n    Compute drift severity from violations.\n\n    Severity rules from NUTRIENTS.md §I.4:\n        - green: zero violations\n        - yellow: tolerance violations only, no exact-match violations\n        - red: any exact-match violation OR tolerance violation > 2× threshold\n\n    Args:\n        exact_violations: List of exact-match violations\n        tolerance_violations: List of tolerance-match violations\n        contract: Contract defining thresholds\n\n    Returns:\n        Severity string: \"green\", \"yellow\", or \"red\"\n    \"\"\"\n    # Green: no violations at all\n    if not exact_violations and not tolerance_violations:\n        return DriftSeverity.GREEN\n\n    # Red: any exact-match violation\n    if exact_violations:\n        return DriftSeverity.RED\n\n    # Check if any tolerance violation exceeds 2× threshold\n    for violation in tolerance_violations:\n        if violation.delta_pct is None:\n            # Baseline was zero, current is non-zero — treat as red\n            return DriftSeverity.RED\n\n        # Extract field name (last part of dotted path)\n        field_key = violation.field.split(\".\")[-1]\n        threshold_spec = TOLERANCE_THRESHOLDS.get(field_key)\n\n        if threshold_spec and violation.delta_pct > (2 * threshold_spec.tolerance):\n            return DriftSeverity.RED\n\n    # Yellow: tolerance violations only, within 2× threshold\n    return DriftSeverity.YELLOW\n\n\n# ─── Drift Event Publishing ───────────────────────────────────────────────────\n\n\nclass SyntheticsDriftEvent(BaseModel):\n    \"\"\"\n    Event published when drift is detected.\n\n    Published to: agent.status.synthetics.drift\n    Contract: NUTRIENTS.md §I.7\n    \"\"\"\n\n    event: str = \"SYNTHETICS_DRIFT\"\n    candidate_id: str\n    run_id: str\n    severity: str\n    violation_count: int\n    ts: str = Field(\n        default_factory=lambda: datetime.now(timezone.utc).isoformat(),\n    )\n\n\ndef create_drift_event(report: DriftReport) -> SyntheticsDriftEvent:\n    \"\"\"\n    Create a drift event from a drift report.\n\n    Used for publishing to agent.status.synthetics.drift channel.\n\n    Args:\n        report: The DriftReport to convert\n\n    Returns:\n        SyntheticsDriftEvent ready for publishing\n    \"\"\"\n    return SyntheticsDriftEvent(\n        candidate_id=report.candidate_id,\n        run_id=report.run_id,\n        severity=report.severity,\n        violation_count=len(report.exact_violations) + len(report.tolerance_violations),\n    )\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":426,"cache_read_input_tokens":93150,"cache_creation":{"ephemeral_5m_input_tokens":426,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"d03d3d20-5f6b-41a7-88e6-34cec2448ac8","uuid":"6a4b36b0-410d-4b75-91cc-f73a7b41d5bc"}}
