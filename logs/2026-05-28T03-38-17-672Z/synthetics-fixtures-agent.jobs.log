s/fixtures/seeder.py idempotent loader","status":"in_progress","activeForm":"Creating seeder module"}]}}}
{"t":"2026-05-28T03:43:27.858Z","event":"sdk_msg","msg":{"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_01Dh4ygwZiHqhovVS5cFxVpE","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QH9wbE2Q9BeADoeW1yfv3m","name":"Write","input":{"file_path":"/Users/spy/mfautomations/repos/creation-station/reverse-search/synthetics/fixtures/seeder.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nIdempotent seeder for synthetic candidates.\n\nUpserts synthetic candidates into PostgreSQL on backend boot.\nUses UUIDv5 derivation per NUTRIENTS.md I.1 for deterministic IDs.\n\nUsage:\n    from synthetics.fixtures.seeder import seed\n    await seed()  # Safe to call multiple times\n\nContract: HYPHA-SYNTHETICS-FIXTURES Acceptance Criteria\n\"\"\"\n\nfrom __future__ import annotations\n\nimport uuid\nfrom pathlib import Path\nfrom typing import TYPE_CHECKING\n\nimport structlog\nimport yaml\nfrom sqlalchemy import select\nfrom sqlalchemy.dialects.postgresql import insert\n\nfrom backend.database import AsyncSessionLocal\nfrom backend.models.discovery import Candidate, RemotePreference\n\nif TYPE_CHECKING:\n    from sqlalchemy.ext.asyncio import AsyncSession\n\nlogger = structlog.get_logger(__name__)\n\n# Path to candidates fixture file\nFIXTURES_DIR = Path(__file__).parent\nCANDIDATES_YAML = FIXTURES_DIR / \"candidates.yaml\"\n\n\ndef get_synthetic_id(slug: str) -> uuid.UUID:\n    \"\"\"\n    Derive deterministic UUIDv5 for a synthetic candidate.\n\n    Uses DNS namespace with \"synthetic-{slug}\" to produce stable IDs.\n    The resulting UUIDs have version 5 marker for detection via SQL:\n        WHERE id::text LIKE '%-5xxx-%'\n\n    Args:\n        slug: The synthetic candidate slug (e.g., \"jr-engineer\")\n\n    Returns:\n        Deterministic UUID for the synthetic candidate\n    \"\"\"\n    return uuid.uuid5(uuid.NAMESPACE_DNS, f\"synthetic-{slug}\")\n\n\ndef _parse_remote_preference(value: str) -> RemotePreference:\n    \"\"\"Convert YAML remote preference string to enum.\"\"\"\n    mapping = {\n        \"remote_only\": RemotePreference.REMOTE_ONLY,\n        \"hybrid\": RemotePreference.HYBRID,\n        \"onsite\": RemotePreference.ONSITE,\n        \"flexible\": RemotePreference.FLEXIBLE,\n    }\n    return mapping.get(value, RemotePreference.FLEXIBLE)\n\n\nasync def _load_candidates() -> list[dict]:\n    \"\"\"Load synthetic candidate definitions from YAML fixture.\"\"\"\n    if not CANDIDATES_YAML.exists():\n        logger.warning(\n            \"candidates_yaml_not_found\",\n            path=str(CANDIDATES_YAML),\n        )\n        return []\n\n    with CANDIDATES_YAML.open(\"r\", encoding=\"utf-8\") as f:\n        data = yaml.safe_load(f)\n\n    return data.get(\"candidates\", [])\n\n\nasync def _upsert_candidate(session: AsyncSession, candidate_data: dict) -> bool:\n    \"\"\"\n    Upsert a single synthetic candidate.\n\n    Uses PostgreSQL ON CONFLICT DO NOTHING for idempotency.\n    If the candidate already exists (by UUID), no changes are made.\n\n    Args:\n        session: SQLAlchemy async session\n        candidate_data: Parsed candidate definition from YAML\n\n    Returns:\n        True if a new row was inserted, False if it already existed\n    \"\"\"\n    slug = candidate_data[\"slug\"]\n    synthetic_id = get_synthetic_id(slug)\n\n    # Check if candidate already exists\n    existing = await session.execute(\n        select(Candidate.id).where(Candidate.id == synthetic_id)\n    )\n    if existing.scalar_one_or_none() is not None:\n        logger.debug(\n            \"synthetic_candidate_exists\",\n            slug=slug,\n            id=str(synthetic_id),\n        )\n        return False\n\n    # Extract identity context for additional fields\n    identity_ctx = candidate_data.get(\"identity_context\", {})\n\n    # Build candidate record\n    stmt = insert(Candidate).values(\n        id=synthetic_id,\n        name=candidate_data[\"name\"],\n        email=candidate_data[\"email\"],\n        resume_text=candidate_data.get(\"resume_text\", \"\"),\n        linkedin_url=candidate_data.get(\"linkedin_url\"),\n        github_url=candidate_data.get(\"github_url\"),\n        personal_context=None,  # Not used for synthetics\n        target_locations=candidate_data.get(\"target_locations\", []),\n        remote_preference=_parse_remote_preference(\n            identity_ctx.get(\"remote_preference\", \"flexible\")\n        ),\n        min_compensation=identity_ctx.get(\"target_salary_min\"),\n        excluded_companies=candidate_data.get(\"excluded_companies\", []),\n        excluded_industries=candidate_data.get(\"excluded_industries\", []),\n    ).on_conflict_do_nothing(index_elements=[\"id\"])\n\n    result = await session.execute(stmt)\n    inserted = result.rowcount > 0\n\n    if inserted:\n        logger.info(\n            \"synthetic_candidate_inserted\",\n            slug=slug,\n            id=str(synthetic_id),\n            name=candidate_data[\"name\"],\n        )\n\n    return inserted\n\n\nasync def seed() -> int:\n    \"\"\"\n    Idempotent seeder for synthetic candidates.\n\n    Loads candidate definitions from candidates.yaml and upserts them\n    into PostgreSQL. Safe to call on every backend boot - existing\n    candidates are not modified.\n\n    Returns:\n        Number of new candidates inserted (0 if all already existed)\n    \"\"\"\n    logger.info(\"synthetic_seeder_starting\")\n\n    candidates = await _load_candidates()\n    if not candidates:\n        logger.warning(\"no_synthetic_candidates_found\")\n        return 0\n\n    inserted_count = 0\n\n    async with AsyncSessionLocal() as session:\n        async with session.begin():\n            for candidate_data in candidates:\n                try:\n                    inserted = await _upsert_candidate(session, candidate_data)\n                    if inserted:\n                        inserted_count += 1\n                except Exception as e:\n                    logger.error(\n                        \"synthetic_candidate_upsert_failed\",\n                        slug=candidate_data.get(\"slug\", \"unknown\"),\n                        error=str(e),\n                    )\n                    raise\n\n    logger.info(\n        \"synthetic_seeder_complete\",\n        total_candidates=len(candidates),\n        inserted=inserted_count,\n        skipped=len(candidates) - inserted_count,\n    )\n\n    return inserted_count\n\n\nasync def verify_synthetics() -> dict:\n    \"\"\"\n    Verify synthetic candidates exist in database.\n\n    Used for testing and health checks.\n\n    Returns:\n        Dict with verification status and candidate IDs\n    \"\"\"\n    async with AsyncSessionLocal() as session:\n        # Query for candidates with UUIDv5 marker pattern\n        # UUIDv5 has version nibble '5' at position 14 (0-indexed)\n        result = await session.execute(\n            select(Candidate.id, Candidate.name, Candidate.email).where(\n                Candidate.email.like(\"%synthetic@talent-agent.test\")\n            )\n        )\n        rows = result.all()\n\n        return {\n            \"count\": len(rows),\n            \"expected\": 3,\n            \"healthy\": len(rows) == 3,\n            \"candidates\": [\n                {\"id\": str(row.id), \"name\": row.name, \"email\": row.email}\n                for row in rows\n            ],\n        }\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":328,"cache_read_input_tokens":89580,"cache_creation":{"ephemeral_5m_input_tokens":328,"ephemeral_1h_input_tokens":0},"output_tokens":72,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"115930cd-9f87-4632-b47e-ed08593aff21","uuid":"1b575303-55fa-42b1-bf0f-6e09ae11fb45"}}
