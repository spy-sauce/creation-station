      - id: data-agent.migrations.init\n        scope: backend/migrations/001_init.sql — extensions, candidates table baseline\n      - id: data-agent.migrations.discovery\n        scope: backend/migrations/002_discovery.sql — discovered_jobs, scored_jobs,\n          daily_digests, crawl_runs per HYPHA-SCHEMA-CORE\n      - id: data-agent.migrations.application\n        scope: backend/migrations/003_application.sql — applications,\n          application_events, outreach_messages, contacts\n      - id: data-agent.migrations.auth\n        scope: backend/migrations/004_auth.sql — magic_link_tokens, sessions\n      - id: data-agent.models.base\n        scope: backend/models/__init__.py + base Declarative class with UUID PK +\n          created_at/updated_at mixins\n      - id: data-agent.models.discovery\n        scope: backend/models/discovery.py — Candidate, DiscoveredJob, ScoredJob,\n          DailyDigest, CrawlRun ORM\n      - id: data-agent.models.application\n        scope: backend/models/application.py — Application, ApplicationEvent,\n          OutreachMessage, Contact ORM\n      - id: data-agent.models.auth\n        scope: backend/models/auth.py — MagicLinkToken, Session ORM\n      - id: data-agent.schemas.discovery\n        scope: backend/agents/discovery/schemas.py — Pydantic v2 schemas for all\n          discovery contracts\n      - id: data-agent.schemas.application\n        scope: backend/agents/application/schemas.py — Pydantic v2 schemas for\n          application contracts\n  - id: design-agent\n    scope: Design tokens, Top Shelf editorial, CSS custom properties, typography,\n      StatusBadge, StatCard\n    branch: feat/design-agent\n    blocked_by: []\n    blocks:\n      - frontend-agent\n    capabilities:\n      - tailwind\n      - css-tokens\n      - design-system\n    sub_agents:\n      - id: design-agent.tokens.palette\n        scope: frontend/src/design/tokens.css — Top Shelf palette as CSS custom\n          properties (--ink, --paper, --gold, severity colors)\n      - id: design-agent.tokens.typography\n        scope: frontend/src/design/typography.css — font stacks + scale + line-heights\n      - id: design-agent.tokens.spacing\n        scope: frontend/src/design/spacing.css — 4px-based spacing scale + radius tokens\n      - id: design-agent.primitives.status-badge\n        scope: frontend/src/components/StatusBadge.tsx — variant prop per agent\n          lifecycle state, identity-color border\n      - id: design-agent.primitives.stat-card\n        scope: frontend/src/components/StatCard.tsx — title + value + delta + sparkline\n          slot\n      - id: design-agent.docs.cheatsheet\n        scope: frontend/src/design/CHEATSHEET.md — token names, usage rules, do/don't\n      - id: design-agent.docs.reference\n        scope: frontend/src/design/REFERENCE.md — full token table + component gallery\n  - id: auth-agent\n    scope: JWT issuance, magic-link flow, Resend integration, get_current_user\n      dependency\n    branch: feat/auth-agent\n    blocked_by:\n      - data-agent\n    blocks:\n      - api-agent\n      - frontend-agent\n      - api-streaming-agent\n    capabilities:\n      - jwt\n      - resend\n      - fastapi-deps\n    sub_agents:\n      - id: auth-agent.magic-link.request\n        scope: backend/api/auth.py POST /auth/magic-link — issue token, send via Resend,\n          rate-limit 3/hour/email\n      - id: auth-agent.magic-link.verify\n        scope: backend/api/auth.py POST /auth/verify — validate token, mint JWT, return\n          session cookie\n      - id: auth-agent.magic-link.resend\n        scope: backend/api/auth.py POST /auth/resend — invalidate prior token, issue new\n      - id: auth-agent.jwt.issue\n        scope: backend/auth/jwt.py issue_jwt(candidate_id, ttl_hours=24) — HS256, signed\n          with settings.jwt_secret\n      - id: auth-agent.jwt.validate\n        scope: backend/auth/jwt.py validate_jwt(token) — raise on expired/invalid\n      - id: auth-agent.jwt.current-user\n        scope: backend/auth/deps.py get_current_user FastAPI dependency — reads cookie\n          or Authorization header, loads Candidate\n  - id: obs-agent\n    scope: \"Observability: structlog config, PII redaction, Redis pub/sub taxonomy,\n      CRM events, health endpoint\"\n    branch: feat/obs-agent\n    blocked_by:\n      - data-agent\n    blocks:\n      - api-agent\n      - discover-agent\n      - apply-agent\n      - api-streaming-agent\n    capabilities:\n      - structlog\n      - redis-pubsub\n      - logging\n    sub_agents:\n      - id: obs-agent.logging.config\n        scope: backend/obs/logging.py — structlog config, JSON renderer in prod, console\n          in dev, request-id correlation\n      - id: obs-agent.logging.pii-redact\n        scope: backend/obs/redact.py — processor that scrubs emails, phones, resumes,\n          tokens before log emission\n      - id: obs-agent.pubsub.taxonomy\n        scope: backend/obs/events.py — channel constants + payload schemas\n          (agent.status.{name}, digest.ready, application.event)\n      - id: obs-agent.pubsub.publisher\n        scope: backend/obs/publisher.py — publish_event(channel, payload) async helper\n          with retry + dead-letter logging\n  - id: apply-agent\n    scope: \"Application engine: JD parser, resume tailor, company intel, contact\n      finder, outreach composer, auto-apply\"\n    branch: feat/apply-agent\n    blocked_by:\n      - data-agent\n      - obs-agent\n      - discover-agent\n    blocks:\n      - agents-agent\n    capabilities:\n      - anthropic-sdk\n      - playwright\n      - pydantic\n    sub_agents:\n      - id: apply-agent.jd-parser\n        scope: backend/agents/application/jd_parser.py — Claude extracts requirements,\n          responsibilities, comp signal from raw_description\n      - id: apply-agent.resume-tailor\n        scope: backend/agents/application/resume_tailor.py — emphasize matching\n          experience without fabricating skills\n      - id: 