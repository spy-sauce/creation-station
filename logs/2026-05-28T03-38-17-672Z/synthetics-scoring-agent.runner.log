{"t":"2026-05-28T03:39:45.696Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MdiwG62yRN7mjRG6NWfzKk","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Relevance Scorer — scores each discovered job against the candidate's identity profile.\n     6→\n     7→Scoring dimensions (each 0–100):\n     8→  technical_match   30%  — skills overlap between JD and candidate profile\n     9→  level_match       20%  — seniority alignment (penalise over AND under)\n    10→  culture_match     15%  — startup/enterprise, remote, mission alignment\n    11→  industry_match    15%  — domain expertise alignment\n    12→  growth_potential  10%  — does this expand the candidate's trajectory?\n    13→  compensation_match 10% — estimated band vs candidate target\n    14→\n    15→Claude parses the JD. Math runs locally. Claude writes 2-sentence reasoning.\n    16→\"\"\"\n    17→\n    18→import json\n    19→import re\n    20→from datetime import datetime, timezone\n    21→from uuid import UUID, uuid4\n    22→\n    23→import structlog\n    24→from anthropic import AsyncAnthropic\n    25→from tenacity import retry, stop_after_attempt, wait_exponential\n    26→\n    27→from backend.agents.discovery.schemas import (\n    28→    IdentityProfileSchema,\n    29→    DiscoveredJobSchema,\n    30→    ScoredJobSchema,\n    31→    ScoreBreakdown,\n    32→)\n    33→\n    34→logger = structlog.get_logger(__name__)\n    35→\n    36→# Seniority levels for level_match scoring — lower index = more junior\n    37→_SENIORITY_LADDER = [\n    38→    \"intern\",\n    39→    \"junior\",\n    40→    \"associate\",\n    41→    \"mid\",\n    42→    \"senior\",\n    43→    \"staff\",\n    44→    \"principal\",\n    45→    \"lead\",\n    46→    \"manager\",\n    47→    \"director\",\n    48→    \"vp\",\n    49→    \"svp\",\n    50→    \"head\",\n    51→    \"cto\",\n    52→    \"coo\",\n    53→    \"ceo\",\n    54→    \"founder\",\n    55→    \"exec\",\n    56→    \"c-level\",\n    57→]\n    58→\n    59→_LEADERSHIP_TO_LADDER = {\n    60→    \"IC\": \"senior\",\n    61→    \"Lead\": \"lead\",\n    62→    \"Manager\": \"manager\",\n    63→    \"Director\": \"director\",\n    64→    \"VP\": \"vp\",\n    65→    \"C-Level\": \"cto\",\n    66→}\n    67→\n    68→\n    69→class RelevanceScorer:\n    70→    \"\"\"\n    71→    Scores discovered jobs against a candidate's identity profile.\n    72→\n    73→    Uses Claude to parse JD requirements and generate reasoning.\n    74→    Scoring math runs locally — no LLM needed for the numbers.\n    75→    \"\"\"\n    76→\n    77→    def __init__(self, anthropic_client: AsyncAnthropic):\n    78→        \"\"\"\n    79→        Initialize the RelevanceScorer.\n    80→\n    81→        Args:\n    82→            anthropic_client: Async Anthropic client for Claude API\n    83→        \"\"\"\n    84→        self._claude = anthropic_client\n    85→\n    86→    async def score_batch(\n    87→        self,\n    88→        jobs: list[DiscoveredJobSchema],\n    89→        profile: IdentityProfileSchema,\n    90→        candidate_id: UUID,\n    91→        min_score: int = 60,\n    92→    ) -> list[ScoredJobSchema]:\n    93→        \"\"\"\n    94→        Score a batch of discovered jobs, filtering out those below min_score.\n    95→\n    96→        Args:\n    97→            jobs: Raw discovered jobs to score\n    98→            profile: Candidate identity profile\n    99→            candidate_id: Candidate UUID for scored job records\n   100→            min_score: Jobs below this composite score are discarded\n   101→\n   102→        Returns:\n   103→            Sorted list of ScoredJobSchema, highest composite first\n   104→        \"\"\"\n   105→        logger.info(\n   106→            \"relevance_scorer.batch_start\",\n   107→            job_count=len(jobs),\n   108→            min_score=min_score,\n   109→        )\n   110→\n   111→        scored: list[ScoredJobSchema] = []\n   112→        for job in jobs:\n   113→            try:\n   114→                result = await self.score_job(job, profile, candidate_id)\n   115→                if result.composite_score >= min_score:\n   116→                    scored.append(result)\n   117→            except Exception as e:\n   118→                logger.error(\n   119→                    \"relevance_scorer.job_error\",\n   120→                    job_url=job.url,\n   121→                    error=str(e),\n   122→                )\n   123→\n   124→        scored.sort(key=lambda s: s.composite_score, reverse=True)\n   125→        logger.info(\n   126→            \"relevance_scorer.batch_complete\",\n   127→            scored=len(scored),\n   128→            filtered_out=len(jobs) - len(scored),\n   129→        )\n   130→        return scored\n   131→\n   132→    async def score_job(\n   133→        self,\n   134→        job: DiscoveredJobSchema,\n   135→        profile: IdentityProfileSchema,\n   136→        candidate_id: UUID,\n   137→    ) -> ScoredJobSchema:\n   138→        \"\"\"\n   139→        Score a single job against the identity profile.\n   140→\n   141→        Args:\n   142→            job: Discovered job\n   143→            profile: Candidate identity profile\n   144→            candidate_id: Candidate UUID\n   145→\n   146→        Returns:\n   147→            ScoredJobSchema with full breakdown and reasoning\n   148→        \"\"\"\n   149→        parsed_jd = await self._parse_jd(job)\n   150→        scores = self._compute_scores(parsed_jd, profile, job)\n   151→        composite = scores.composite\n   152→        is_hot = composite >= 80\n   153→        reasoning = await self._generate_reasoning(job, profile, scores, composite)\n   154→\n   155→        return ScoredJobSchema(\n   156→            id=uuid4(),\n   157→            discovered_job_id=job.id or uuid4(),\n   158→            candidate_id=candidate_id,\n   159→            score_breakdown=scores,\n   160→            composite_score=composite,\n   161→            is_hot=is_hot,\n   162→            reasoning=reasoning,\n   163→            scored_at=datetime.now(timezone.utc),\n   164→            # Denormalized job fields for digest display\n   165→            title=job.title,\n   166→            company=job.company,\n   167→            location=job.location,\n   168→            url=job.url,\n   169→        )\n   170→\n   171→    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n   172→    async def _parse_jd(self, job: DiscoveredJobSchema) -> dict:\n   173→        \"\"\"Use Claude to extract structured requirements from a job description.\"\"\"\n   174→        if not job.description:\n   175→            return {}\n   176→\n   177→        prompt = f\"\"\"Extract structured data from this job description. Return ONLY valid JSON, no markdown:\n   178→\n   179→Job Title: {job.title}\n   180→Company: {job.company}\n   181→Location: {job.location or \"Not specified\"}\n   182→\n   183→Description:\n   184→{job.description[:3000]}\n   185→\n   186→Return this exact JSON structure:\n   187→{{\n   188→  \"required_skills\": [\"<skill1>\", \"<skill2>\"],\n   189→  \"preferred_skills\": [\"<skill1>\"],\n   190→  \"seniority_level\": \"<intern|junior|mid|senior|staff|principal|lead|manager|director|vp|head|exec>\",\n   191→  \"remote_type\": \"<remote|hybrid|onsite|flexible>\",\n   192→  \"industries\": [\"<industry1>\"],\n   193→  \"comp_mentioned\": \"<salary string or null>\",\n   194→  \"culture_signals\": {{\n   195→    \"startup_vs_enterprise\": \"<startup|enterprise|both>\",\n   196→    \"mission_driven\": true\n   197→  }},\n   198→  \"growth_indicators\": [\"<indicator1>\"]\n   199→}}\"\"\"\n   200→\n   201→        response = await self._claude.messages.create(\n   202→            model=\"claude-sonnet-4-20250514\",\n   203→            max_tokens=1024,\n   204→            messages=[{\"role\": \"user\", \"content\": prompt}],\n   205→        )\n   206→\n   207→        raw = response.content[0].text.strip()\n   208→        try:\n   209→            return json.loads(raw)\n   210→        except json.JSONDecodeError:\n   211→            match = re.search(r\"\\{.*\\}\", raw, re.DOTALL)\n   212→            return json.loads(match.group()) if match else {}\n   213→\n   214→    def _compute_scores(\n   215→        self,\n   216→        parsed_jd: dict,\n   217→        profile: IdentityProfileSchema,\n   218→        job: DiscoveredJobSchema,\n   219→    ) -> ScoreBreakdown:\n   220→        \"\"\"Compute all six scoring dimensions locally.\"\"\"\n   221→        return ScoreBreakdown(\n   222→            technical_match=self._score_technical(parsed_jd, profile),\n   223→            level_match=self._score_level(parsed_jd, profile),\n   224→            culture_match=self._score_culture(parsed_jd, profile, job),\n   225→            industry_match=self._score_industry(parsed_jd, profile),\n   226→            growth_potential=self._score_growth(parsed_jd, profile),\n   227→            compensation_match=self._score_compensation(parsed_jd, profile),\n   228→        )\n   229→\n   230→    def _score_technical(\n   231→        self, parsed_jd: dict, profile: IdentityProfileSchema\n   232→    ) -> int:\n   233→        \"\"\"Score based on skills overlap between JD requirements and candidate skills.\"\"\"\n   234→        required = {s.lower() for s in parsed_jd.get(\"required_skills\", [])}\n   235→        preferred = {s.lower() for s in parsed_jd.get(\"preferred_skills\", [])}\n   236→        candidate_skills = {s.lower() for s in profile.technical_skills}\n   237→\n   238→        if not required:\n   239→            return 60  # No requirements listed — neutral score\n   240→\n   241→        required_hits = len(required & candidate_skills)\n   242→        preferred_hits = len(preferred & candidate_skills)\n   243→\n   244→        required_ratio = required_hits / len(required) if required else 0\n   245→        preferred_bonus = min(20, preferred_hits * 4) if preferred else 0\n   246→\n   247→        base = int(required_ratio * 80)\n   248→        return min(100, base + preferred_bonus)\n   249→\n   250→    def _score_level(self, parsed_jd: dict, profile: IdentityProfileSchema) -> int:\n   251→        \"\"\"Score seniority alignment — penalise both under and over.\"\"\"\n   252→        jd_level = parsed_jd.get(\"seniority_level\", \"\").lower()\n   253→        candidate_level = _LEADERSHIP_TO_LADDER.get(\n   254→            profile.leadership_level, \"senior\"\n   255→        )\n   256→\n   257→        try:\n   258→            jd_idx = _SENIORITY_LADDER.index(jd_level)\n   259→        except ValueError:\n   260→            return 70  # Unknown level — generous neutral\n   261→\n   262→        try:\n   263→            candidate_idx = _SENIORITY_LADDER.index(candidate_level)\n   264→        except ValueError:\n   265→            return 70\n   266→\n   267→        diff = abs(jd_idx - candidate_idx)\n   268→        if diff == 0:\n   269→            return 100\n   270→        elif diff == 1:\n   271→            return 80\n   272→        elif diff == 2:\n   273→            return 55\n   274→        elif diff == 3:\n   275→            return 30\n   276→        else:\n   277→            return 10\n   278→\n   279→    def _score_culture(\n   280→        self,\n   281→        parsed_jd: dict,\n   282→        profile: IdentityProfileSchema,\n   283→        job: DiscoveredJobSchema,\n   284→    ) -> int:\n   285→        \"\"\"Score culture alignment: startup/enterprise + remote preference.\"\"\"\n   286→        score = 60  # default neutral\n   287→\n   288→        # Startup vs enterprise alignment\n   289→        jd_type = parsed_jd.get(\"culture_signals\", {}).get(\n   290→            \"startup_vs_enterprise\", \"\"\n   291→        )\n   292→        candidate_pref = profile.signals.get(\"startup_vs_enterprise\", \"both\")\n   293→        if jd_type and candidate_pref != \"both\":\n   294→            if jd_type == candidate_pref:\n   295→                score += 20\n   296→            else:\n   297→                score -= 20\n   298→\n   299→        # Remote alignment\n   300→        jd_remote = parsed_jd.get(\"remote_type\", \"\")\n   301→        candidate_remote = profile.signals.get(\"remote_preference\", \"flexible\")\n   302→        if jd_remote and candidate_remote != \"flexible\":\n   303→            if jd_remote == candidate_remote:\n   304→                score += 20\n   305→            elif jd_remote == \"onsite\" and candidate_remote == \"remote\":\n   306→                score -= 30\n   307→            else:\n   308→                score -= 10\n   309→\n   310→        return max(0, min(100, score))\n   311→\n   312→    def _score_industry(\n   313→        self, parsed_jd: dict, profile: IdentityProfileSchema\n   314→    ) -> int:\n   315→        \"\"\"Score how well the job's industries align with the candidate's domain expertise.\"\"\"\n   316→        jd_industries = {i.lower() for i in parsed_jd.get(\"industries\", [])}\n   317→        candidate_domains = {d.lower() for d in profile.industry_experience}\n   318→\n   319→        if not jd_industries:\n   320→            return 60\n   321→\n   322→        overlap = len(jd_industries & candidate_domains)\n   323→        if overlap >= 2:\n   324→            return 100\n   325→        elif overlap == 1:\n   326→            return 75\n   327→        else:\n   328→            return 35\n   329→\n   330→    def _score_growth(\n   331→        self, parsed_jd: dict, profile: IdentityProfileSchema\n   332→    ) -> int:\n   333→        \"\"\"Score whether this role expands the candidate's trajectory.\"\"\"\n   334→        indicators = parsed_jd.get(\"growth_indicators\", [])\n   335→        growth_keywords = {\n   336→            \"build from scratch\",\n   337→            \"greenfield\",\n   338→            \"founding\",\n   339→            \"new team\",\n   340→            \"technical strategy\",\n   341→            \"shape the\",\n   342→            \"lead the\",\n   343→            \"define the\",\n   344→            \"architect\",\n   345→            \"platform\",\n   346→            \"0 to 1\",\n   347→        }\n   348→\n   349→        indicator_text = \" \".join(indicators).lower()\n   350→        matches = sum(1 for kw in growth_keywords if kw in indicator_text)\n   351→\n   352→        if matches >= 3:\n   353→            return 90\n   354→        elif matches >= 1:\n   355→            return 70\n   356→        else:\n   357→            return 50\n   358→\n   359→    def _score_compensation(\n   360→        self, parsed_jd: dict, profile: IdentityProfileSchema\n   361→    ) -> int:\n   362→        \"\"\"Score comp alignment — generous when comp isn't mentioned.\"\"\"\n   363→        comp_str = parsed_jd.get(\"comp_mentioned\")\n   364→        if not comp_str:\n   365→            return 75  # No comp listed is common for senior/exec roles\n   366→\n   367→        # Extract numbers from comp string\n   368→        numbers = re.findall(r\"\\d[\\d,]*\", comp_str.replace(\",\", \"\"))\n   369→        if not numbers:\n   370→            return 70\n   371→\n   372→        amounts = [int(n) for n in numbers if len(n) <= 7]  # filter out noise\n   373→        if not amounts:\n   374→            return 70\n   375→\n   376→        # Without candidate min, return neutral\n   377→        return 75\n   378→\n   379→    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n   380→    async def _generate_reasoning(\n   381→        self,\n   382→        job: DiscoveredJobSchema,\n   383→        profile: IdentityProfileSchema,\n   384→        scores: ScoreBreakdown,\n   385→        composite: int,\n   386→    ) -> str:\n   387→        \"\"\"Generate a 2-sentence human-readable reasoning string via Claude.\"\"\"\n   388→        prompt = f\"\"\"You are writing a brief explanation for why a job matches a candidate in a talent agent digest.\n   389→\n   390→Candidate archetypes: {\", \".join(profile.archetypes[:5])}\n   391→Job: {job.title} at {job.company} ({job.location or \"location TBD\"})\n   392→Composite score: {composite}/100\n   393→\n   394→Score breakdown:\n   395→- Technical match: {scores.technical_match}/100\n   396→- Level match: {scores.level_match}/100\n   397→- Culture match: {scores.culture_match}/100\n   398→- Industry match: {scores.industry_match}/100\n   399→- Growth potential: {scores.growth_potential}/100\n   400→- Compensation match: {scores.compensation_match}/100\n   401→\n   402→Write exactly 2 sentences: one sentence on why this is a strong match, one on the key consideration or risk.\n   403→Be specific. Do not use filler phrases like \"This role offers\" or \"This position presents\". Start with the substance.\n   404→Return only the 2 sentences, no other text.\"\"\"\n   405→\n   406→        response = await self._claude.messages.create(\n   407→            model=\"claude-sonnet-4-20250514\",\n   408→            max_tokens=200,\n   409→            messages=[{\"role\": \"user\", \"content\": prompt}],\n   410→        )\n   411→        return response.content[0].text.strip()\n   412→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"4a09f4fa-29b0-40d4-99d3-86bdcfeef6a7","uuid":"e5330303-32a3-4517-8c14-cf78a4e665af","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/agents/discovery/relevance_scorer.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nRelevance Scorer — scores each discovered job against the candidate's identity profile.\n\nScoring dimensions (each 0–100):\n  technical_match   30%  — skills overlap between JD and candidate profile\n  level_match       20%  — seniority alignment (penalise over AND under)\n  culture_match     15%  — startup/enterprise, remote, mission alignment\n  industry_match    15%  — domain expertise alignment\n  growth_potential  10%  — does this expand the candidate's trajectory?\n  compensation_match 10% — estimated band vs candidate target\n\nClaude parses the JD. Math runs locally. Claude writes 2-sentence reasoning.\n\"\"\"\n\nimport json\nimport re\nfrom datetime import datetime, timezone\nfrom uuid import UUID, uuid4\n\nimport structlog\nfrom anthropic import AsyncAnthropic\nfrom tenacity import retry, stop_after_attempt, wait_exponential\n\nfrom backend.agents.discovery.schemas import (\n    IdentityProfileSchema,\n    DiscoveredJobSchema,\n    ScoredJobSchema,\n    ScoreBreakdown,\n)\n\nlogger = structlog.get_logger(__name__)\n\n# Seniority levels for level_match scoring — lower index = more junior\n_SENIORITY_LADDER = [\n    \"intern\",\n    \"junior\",\n    \"associate\",\n    \"mid\",\n    \"senior\",\n    \"staff\",\n    \"principal\",\n    \"lead\",\n    \"manager\",\n    \"director\",\n    \"vp\",\n    \"svp\",\n    \"head\",\n    \"cto\",\n    \"coo\",\n    \"ceo\",\n    \"founder\",\n    \"exec\",\n    \"c-level\",\n]\n\n_LEADERSHIP_TO_LADDER = {\n    \"IC\": \"senior\",\n    \"Lead\": \"lead\",\n    \"Manager\": \"manager\",\n    \"Director\": \"director\",\n    \"VP\": \"vp\",\n    \"C-Level\": \"cto\",\n}\n\n\nclass RelevanceScorer:\n    \"\"\"\n    Scores discovered jobs against a candidate's identity profile.\n\n    Uses Claude to parse JD requirements and generate reasoning.\n    Scoring math runs locally — no LLM needed for the numbers.\n    \"\"\"\n\n    def __init__(self, anthropic_client: AsyncAnthropic):\n        \"\"\"\n        Initialize the RelevanceScorer.\n\n        Args:\n            anthropic_client: Async Anthropic client for Claude API\n        \"\"\"\n        self._claude = anthropic_client\n\n    async def score_batch(\n        self,\n        jobs: list[DiscoveredJobSchema],\n        profile: IdentityProfileSchema,\n        candidate_id: UUID,\n        min_score: int = 60,\n    ) -> list[ScoredJobSchema]:\n        \"\"\"\n        Score a batch of discovered jobs, filtering out those below min_score.\n\n        Args:\n            jobs: Raw discovered jobs to score\n            profile: Candidate identity profile\n            candidate_id: Candidate UUID for scored job records\n            min_score: Jobs below this composite score are discarded\n\n        Returns:\n            Sorted list of ScoredJobSchema, highest composite first\n        \"\"\"\n        logger.info(\n            \"relevance_scorer.batch_start\",\n            job_count=len(jobs),\n            min_score=min_score,\n        )\n\n        scored: list[ScoredJobSchema] = []\n        for job in jobs:\n            try:\n                result = await self.score_job(job, profile, candidate_id)\n                if result.composite_score >= min_score:\n                    scored.append(result)\n            except Exception as e:\n                logger.error(\n                    \"relevance_scorer.job_error\",\n                    job_url=job.url,\n                    error=str(e),\n                )\n\n        scored.sort(key=lambda s: s.composite_score, reverse=True)\n        logger.info(\n            \"relevance_scorer.batch_complete\",\n            scored=len(scored),\n            filtered_out=len(jobs) - len(scored),\n        )\n        return scored\n\n    async def score_job(\n        self,\n        job: DiscoveredJobSchema,\n        profile: IdentityProfileSchema,\n        candidate_id: UUID,\n    ) -> ScoredJobSchema:\n        \"\"\"\n        Score a single job against the identity profile.\n\n        Args:\n            job: Discovered job\n            profile: Candidate identity profile\n            candidate_id: Candidate UUID\n\n        Returns:\n            ScoredJobSchema with full breakdown and reasoning\n        \"\"\"\n        parsed_jd = await self._parse_jd(job)\n        scores = self._compute_scores(parsed_jd, profile, job)\n        composite = scores.composite\n        is_hot = composite >= 80\n        reasoning = await self._generate_reasoning(job, profile, scores, composite)\n\n        return ScoredJobSchema(\n            id=uuid4(),\n            discovered_job_id=job.id or uuid4(),\n            candidate_id=candidate_id,\n            score_breakdown=scores,\n            composite_score=composite,\n            is_hot=is_hot,\n            reasoning=reasoning,\n            scored_at=datetime.now(timezone.utc),\n            # Denormalized job fields for digest display\n            title=job.title,\n            company=job.company,\n            location=job.location,\n            url=job.url,\n        )\n\n    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n    async def _parse_jd(self, job: DiscoveredJobSchema) -> dict:\n        \"\"\"Use Claude to extract structured requirements from a job description.\"\"\"\n        if not job.description:\n            return {}\n\n        prompt = f\"\"\"Extract structured data from this job description. Return ONLY valid JSON, no markdown:\n\nJob Title: {job.title}\nCompany: {job.company}\nLocation: {job.location or \"Not specified\"}\n\nDescription:\n{job.description[:3000]}\n\nReturn this exact JSON structure:\n{{\n  \"required_skills\": [\"<skill1>\", \"<skill2>\"],\n  \"preferred_skills\": [\"<skill1>\"],\n  \"seniority_level\": \"<intern|junior|mid|senior|staff|principal|lead|manager|director|vp|head|exec>\",\n  \"remote_type\": \"<remote|hybrid|onsite|flexible>\",\n  \"industries\": [\"<industry1>\"],\n  \"comp_mentioned\": \"<salary string or null>\",\n  \"culture_signals\": {{\n    \"startup_vs_enterprise\": \"<startup|enterprise|both>\",\n    \"mission_driven\": true\n  }},\n  \"growth_indicators\": [\"<indicator1>\"]\n}}\"\"\"\n\n        response = await self._claude.messages.create(\n            model=\"claude-sonnet-4-20250514\",\n            max_tokens=1024,\n            messages=[{\"role\": \"user\", \"content\": prompt}],\n        )\n\n        raw = response.content[0].text.strip()\n        try:\n            return json.loads(raw)\n        except json.JSONDecodeError:\n            match = re.search(r\"\\{.*\\}\", raw, re.DOTALL)\n            return json.loads(match.group()) if match else {}\n\n    def _compute_scores(\n        self,\n        parsed_jd: dict,\n        profile: IdentityProfileSchema,\n        job: DiscoveredJobSchema,\n    ) -> ScoreBreakdown:\n        \"\"\"Compute all six scoring dimensions locally.\"\"\"\n        return ScoreBreakdown(\n            technical_match=self._score_technical(parsed_jd, profile),\n            level_match=self._score_level(parsed_jd, profile),\n            culture_match=self._score_culture(parsed_jd, profile, job),\n            industry_match=self._score_industry(parsed_jd, profile),\n            growth_potential=self._score_growth(parsed_jd, profile),\n            compensation_match=self._score_compensation(parsed_jd, profile),\n        )\n\n    def _score_technical(\n        self, parsed_jd: dict, profile: IdentityProfileSchema\n    ) -> int:\n        \"\"\"Score based on skills overlap between JD requirements and candidate skills.\"\"\"\n        required = {s.lower() for s in parsed_jd.get(\"required_skills\", [])}\n        preferred = {s.lower() for s in parsed_jd.get(\"preferred_skills\", [])}\n        candidate_skills = {s.lower() for s in profile.technical_skills}\n\n        if not required:\n            return 60  # No requirements listed — neutral score\n\n        required_hits = len(required & candidate_skills)\n        preferred_hits = len(preferred & candidate_skills)\n\n        required_ratio = required_hits / len(required) if required else 0\n        preferred_bonus = min(20, preferred_hits * 4) if preferred else 0\n\n        base = int(required_ratio * 80)\n        return min(100, base + preferred_bonus)\n\n    def _score_level(self, parsed_jd: dict, profile: IdentityProfileSchema) -> int:\n        \"\"\"Score seniority alignment — penalise both under and over.\"\"\"\n        jd_level = parsed_jd.get(\"seniority_level\", \"\").lower()\n        candidate_level = _LEADERSHIP_TO_LADDER.get(\n            profile.leadership_level, \"senior\"\n        )\n\n        try:\n            jd_idx = _SENIORITY_LADDER.index(jd_level)\n        except ValueError:\n            return 70  # Unknown level — generous neutral\n\n        try:\n            candidate_idx = _SENIORITY_LADDER.index(candidate_level)\n        except ValueError:\n            return 70\n\n        diff = abs(jd_idx - candidate_idx)\n        if diff == 0:\n            return 100\n        elif diff == 1:\n            return 80\n        elif diff == 2:\n            return 55\n        elif diff == 3:\n            return 30\n        else:\n            return 10\n\n    def _score_culture(\n        self,\n        parsed_jd: dict,\n        profile: IdentityProfileSchema,\n        job: DiscoveredJobSchema,\n    ) -> int:\n        \"\"\"Score culture alignment: startup/enterprise + remote preference.\"\"\"\n        score = 60  # default neutral\n\n        # Startup vs enterprise alignment\n        jd_type = parsed_jd.get(\"culture_signals\", {}).get(\n            \"startup_vs_enterprise\", \"\"\n        )\n        candidate_pref = profile.signals.get(\"startup_vs_enterprise\", \"both\")\n        if jd_type and candidate_pref != \"both\":\n            if jd_type == candidate_pref:\n                score += 20\n            else:\n                score -= 20\n\n        # Remote alignment\n        jd_remote = parsed_jd.get(\"remote_type\", \"\")\n        candidate_remote = profile.signals.get(\"remote_preference\", \"flexible\")\n        if jd_remote and candidate_remote != \"flexible\":\n            if jd_remote == candidate_remote:\n                score += 20\n            elif jd_remote == \"onsite\" and candidate_remote == \"remote\":\n                score -= 30\n            else:\n                score -= 10\n\n        return max(0, min(100, score))\n\n    def _score_industry(\n        self, parsed_jd: dict, profile: IdentityProfileSchema\n    ) -> int:\n        \"\"\"Score how well the job's industries align with the candidate's domain expertise.\"\"\"\n        jd_industries = {i.lower() for i in parsed_jd.get(\"industries\", [])}\n        candidate_domains = {d.lower() for d in profile.industry_experience}\n\n        if not jd_industries:\n            return 60\n\n        overlap = len(jd_industries & candidate_domains)\n        if overlap >= 2:\n            return 100\n        elif overlap == 1:\n            return 75\n        else:\n            return 35\n\n    def _score_growth(\n        self, parsed_jd: dict, profile: IdentityProfileSchema\n    ) -> int:\n        \"\"\"Score whether this role expands the candidate's trajectory.\"\"\"\n        indicators = parsed_jd.get(\"growth_indicators\", [])\n        growth_keywords = {\n            \"build from scratch\",\n            \"greenfield\",\n            \"founding\",\n            \"new team\",\n            \"technical strategy\",\n            \"shape the\",\n            \"lead the\",\n            \"define the\",\n            \"architect\",\n            \"platform\",\n            \"0 to 1\",\n        }\n\n        indicator_text = \" \".join(indicators).lower()\n        matches = sum(1 for kw in growth_keywords if kw in indicator_text)\n\n        if matches >= 3:\n            return 90\n        elif matches >= 1:\n            return 70\n        else:\n            return 50\n\n    def _score_compensation(\n        self, parsed_jd: dict, profile: IdentityProfileSchema\n    ) -> int:\n        \"\"\"Score comp alignment — generous when comp isn't mentioned.\"\"\"\n        comp_str = parsed_jd.get(\"comp_mentioned\")\n        if not comp_str:\n            return 75  # No comp listed is common for senior/exec roles\n\n        # Extract numbers from comp string\n        numbers = re.findall(r\"\\d[\\d,]*\", comp_str.replace(\",\", \"\"))\n        if not numbers:\n            return 70\n\n        amounts = [int(n) for n in numbers if len(n) <= 7]  # filter out noise\n        if not amounts:\n            return 70\n\n        # Without candidate min, return neutral\n        return 75\n\n    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n    async def _generate_reasoning(\n        self,\n        job: DiscoveredJobSchema,\n        profile: IdentityProfileSchema,\n        scores: ScoreBreakdown,\n        composite: int,\n    ) -> str:\n        \"\"\"Generate a 2-sentence human-readable reasoning string via Claude.\"\"\"\n        prompt = f\"\"\"You are writing a brief explanation for why a job matches a candidate in a talent agent digest.\n\nCandidate archetypes: {\", \".join(profile.archetypes[:5])}\nJob: {job.title} at {job.company} ({job.location or \"location TBD\"})\nComposite score: {composite}/100\n\nScore breakdown:\n- Technical match: {scores.technical_match}/100\n- Level match: {scores.level_match}/100\n- Culture match: {scores.culture_match}/100\n- Industry match: {scores.industry_match}/100\n- Growth potential: {scores.growth_potential}/100\n- Compensation match: {scores.compensation_match}/100\n\nWrite exactly 2 sentences: one sentence on why this is a strong match, one on the key consideration or risk.\nBe specific. Do not use filler phrases like \"This role offers\" or \"This position presents\". Start with the substance.\nReturn only the 2 sentences, no other text.\"\"\"\n\n        response = await self._claude.messages.create(\n            model=\"claude-sonnet-4-20250514\",\n            max_tokens=200,\n            messages=[{\"role\": \"user\", \"content\": prompt}],\n        )\n        return response.content[0].text.strip()\n","numLines":412,"startLine":1,"totalLines":412}}}}
{"t":"2026-05-28T03:39:45.706Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013wbY6kaMZoum9aKG1Z326m","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Pydantic v2 schemas for the Discovery Engine.\n     6→\n     7→These are the data contracts between agents — separate from ORM models.\n     8→Aligns with NUTRIENTS.md DATA_CONTRACTS.\n     9→\"\"\"\n    10→\n    11→from __future__ import annotations\n    12→\n    13→from datetime import datetime\n    14→from typing import Optional, Union\n    15→from uuid import UUID\n    16→\n    17→from pydantic import BaseModel, Field, ConfigDict, computed_field\n    18→\n    19→\n    20→# ─── Candidate ────────────────────────────────────────────────────────────────\n    21→\n    22→\n    23→class CandidateSchema(BaseModel):\n    24→    \"\"\"Full candidate profile used as input to the Discovery Engine.\"\"\"\n    25→\n    26→    model_config = ConfigDict(from_attributes=True)\n    27→\n    28→    id: UUID\n    29→    name: str\n    30→    email: str\n    31→    resume_text: str\n    32→    linkedin_url: Optional[str] = None\n    33→    github_url: Optional[str] = None\n    34→    personal_context: Optional[str] = None\n    35→    target_locations: list[str] = Field(default_factory=list)\n    36→    remote_preference: str = \"flexible\"\n    37→    min_compensation: Optional[int] = None\n    38→    excluded_companies: list[str] = Field(default_factory=list)\n    39→    excluded_industries: list[str] = Field(default_factory=list)\n    40→    created_at: Optional[datetime] = None\n    41→    updated_at: Optional[datetime] = None\n    42→\n    43→\n    44→# ─── Identity Profile ─────────────────────────────────────────────────────────\n    45→\n    46→\n    47→class IdentityProfileSchema(BaseModel):\n    48→    \"\"\"\n    49→    Multi-dimensional identity model for a candidate.\n    50→\n    51→    Generated by IdentityProfiler — the foundation of the entire discovery run.\n    52→    Cached in Redis for 24h.\n    53→\n    54→    Matches NUTRIENTS.md DATA_CONTRACTS.IdentityProfile.\n    55→    \"\"\"\n    56→\n    57→    model_config = ConfigDict(from_attributes=True)\n    58→\n    59→    archetypes: list[str] = Field(default_factory=list)\n    60→    archetype_tags: list[str] = Field(default_factory=list)  # Alias for agents\n    61→    leadership_level: str = Field(\n    62→        default=\"IC\",\n    63→        description=\"IC | Lead | Manager | Director | VP | C-Level\",\n    64→    )\n    65→    technical_skills: Union[dict[str, int], list[str]] = Field(default_factory=dict)\n    66→    soft_skills: list[str] = Field(default_factory=list)\n    67→    domain_expertise: list[str] = Field(default_factory=list)\n    68→    industry_experience: list[str] = Field(default_factory=list)\n    69→    notable_achievements: list[str] = Field(default_factory=list)\n    70→    career_trajectory: str = \"\"\n    71→    ideal_role_description: str = \"\"\n    72→    creative_layer: list[str] = Field(default_factory=list)\n    73→    signals: dict[str, str] = Field(default_factory=dict)\n    74→\n    75→\n    76→# Alias for backward compatibility\n    77→IdentityProfile = IdentityProfileSchema\n    78→\n    79→\n    80→# ─── Search Manifest ─────────────────────────────────────────────────────────\n    81→\n    82→\n    83→class SearchManifestSchema(BaseModel):\n    84→    \"\"\"\n    85→    Search instructions derived from an IdentityProfile.\n    86→\n    87→    Matches NUTRIENTS.md DATA_CONTRACTS.SearchManifest.\n    88→    \"\"\"\n    89→\n    90→    model_config = ConfigDict(from_attributes=True)\n    91→\n    92→    target_titles: list[str] = Field(default_factory=list)\n    93→    keywords: list[str] = Field(default_factory=list)\n    94→    excluded_titles: list[str] = Field(default_factory=list)\n    95→    excluded_companies: list[str] = Field(default_factory=list)\n    96→    excluded_industries: list[str] = Field(default_factory=list)\n    97→    location_filters: list[str] = Field(default_factory=list)\n    98→    remote_preference: str = \"flexible\"\n    99→    min_compensation: Optional[int] = None\n   100→\n   101→\n   102→# ─── Discovered Job ───────────────────────────────────────────────────────────\n   103→\n   104→\n   105→class DiscoveredJobSchema(BaseModel):\n   106→    \"\"\"\n   107→    Raw job data from a crawl — before scoring.\n   108→\n   109→    Matches NUTRIENTS.md DATA_CONTRACTS.DiscoveredJob.\n   110→    \"\"\"\n   111→\n   112→    model_config = ConfigDict(from_attributes=True)\n   113→\n   114→    id: Optional[UUID] = None\n   115→    source: str\n   116→    source_id: str\n   117→    title: str\n   118→    company: str\n   119→    location: Optional[str] = None\n   120→    description: Optional[str] = None\n   121→    url: str\n   122→    posted_at: Optional[datetime] = None\n   123→    salary_min: Optional[int] = None\n   124→    salary_max: Optional[int] = None\n   125→    remote: bool = False\n   126→    crawled_at: Optional[datetime] = None\n   127→\n   128→\n   129→# ─── Score Breakdown ─────────────────────────────────────────────────────────\n   130→\n   131→\n   132→class ScoreBreakdown(BaseModel):\n   133→    \"\"\"\n   134→    Dimension-level score breakdown (0-100 per dimension).\n   135→\n   136→    Matches NUTRIENTS.md DATA_CONTRACTS.ScoreBreakdown.\n   137→    \"\"\"\n   138→\n   139→    model_config = ConfigDict(from_attributes=True)\n   140→\n   141→    technical_match: int = Field(ge=0, le=100)\n   142→    level_match: int = Field(ge=0, le=100)\n   143→    culture_match: int = Field(ge=0, le=100)\n   144→    industry_match: int = Field(ge=0, le=100)\n   145→    growth_potential: int = Field(ge=0, le=100)\n   146→    compensation_match: int = Field(ge=0, le=100)\n   147→\n   148→    @computed_field\n   149→    @property\n   150→    def composite(self) -> int:\n   151→        \"\"\"\n   152→        Weighted composite score.\n   153→\n   154→        Weights (sum to 100%):\n   155→          - technical_match: 30%\n   156→          - level_match: 20%\n   157→          - culture_match: 15%\n   158→          - industry_match: 15%\n   159→          - growth_potential: 10%\n   160→          - compensation_match: 10%\n   161→        \"\"\"\n   162→        return int(\n   163→            self.technical_match * 0.30\n   164→            + self.level_match * 0.20\n   165→            + self.culture_match * 0.15\n   166→            + self.industry_match * 0.15\n   167→            + self.growth_potential * 0.10\n   168→            + self.compensation_match * 0.10\n   169→        )\n   170→\n   171→\n   172→# ─── Scored Job ───────────────────────────────────────────────────────────────\n   173→\n   174→\n   175→class ScoredJobSchema(BaseModel):\n   176→    \"\"\"\n   177→    A discovered job with full scoring breakdown and reasoning.\n   178→\n   179→    Matches NUTRIENTS.md DATA_CONTRACTS.ScoredJob.\n   180→    \"\"\"\n   181→\n   182→    model_config = ConfigDict(from_attributes=True)\n   183→\n   184→    id: Optional[UUID] = None\n   185→    discovered_job_id: UUID\n   186→    candidate_id: UUID\n   187→    score_breakdown: ScoreBreakdown\n   188→    composite_score: int = Field(ge=0, le=100)\n   189→    is_hot: bool = False\n   190→    reasoning: str\n   191→    scored_at: Optional[datetime] = None\n   192→\n   193→    # Denormalized job fields for digest display\n   194→    title: str = \"\"\n   195→    company: str = \"\"\n   196→    location: Optional[str] = None\n   197→    url: str = \"\"\n   198→\n   199→\n   200→# ─── Daily Digest ─────────────────────────────────────────────────────────────\n   201→\n   202→\n   203→class DailyDigestSchema(BaseModel):\n   204→    \"\"\"\n   205→    Full daily digest — persisted to DB and published to Redis.\n   206→\n   207→    Matches NUTRIENTS.md DATA_CONTRACTS.DailyDigest.\n   208→    \"\"\"\n   209→\n   210→    model_config = ConfigDict(from_attributes=True)\n   211→\n   212→    id: Optional[UUID] = None\n   213→    candidate_id: UUID\n   214→    run_date: str = Field(description=\"ISO date: YYYY-MM-DD\")\n   215→    top_picks: list[ScoredJobSchema] = Field(default_factory=list)\n   216→    hot_picks: list[ScoredJobSchema] = Field(default_factory=list)\n   217→    new_companies: list[str] = Field(default_factory=list)\n   218→    total_jobs_discovered: int = 0\n   219→    total_jobs_scored: int = 0\n   220→    created_at: Optional[datetime] = None\n   221→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"4a09f4fa-29b0-40d4-99d3-86bdcfeef6a7","uuid":"a4f391e0-8ee0-446d-9fcd-44b80eb8d549","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomations/repos/creation-station/reverse-search/backend/agents/discovery/schemas.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nPydantic v2 schemas for the Discovery Engine.\n\nThese are the data contracts between agents — separate from ORM models.\nAligns with NUTRIENTS.md DATA_CONTRACTS.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import datetime\nfrom typing import Optional, Union\nfrom uuid import UUID\n\nfrom pydantic import BaseModel, Field, ConfigDict, computed_field\n\n\n# ─── Candidate ────────────────────────────────────────────────────────────────\n\n\nclass CandidateSchema(BaseModel):\n    \"\"\"Full candidate profile used as input to the Discovery Engine.\"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: UUID\n    name: str\n    email: str\n    resume_text: str\n    linkedin_url: Optional[str] = None\n    github_url: Optional[str] = None\n    personal_context: Optional[str] = None\n    target_locations: list[str] = Field(default_factory=list)\n    remote_preference: str = \"flexible\"\n    min_compensation: Optional[int] = None\n    excluded_companies: list[str] = Field(default_factory=list)\n    excluded_industries: list[str] = Field(default_factory=list)\n    created_at: Optional[datetime] = None\n    updated_at: Optional[datetime] = None\n\n\n# ─── Identity Profile ─────────────────────────────────────────────────────────\n\n\nclass IdentityProfileSchema(BaseModel):\n    \"\"\"\n    Multi-dimensional identity model for a candidate.\n\n    Generated by IdentityProfiler — the foundation of the entire discovery run.\n    Cached in Redis for 24h.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.IdentityProfile.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    archetypes: list[str] = Field(default_factory=list)\n    archetype_tags: list[str] = Field(default_factory=list)  # Alias for agents\n    leadership_level: str = Field(\n        default=\"IC\",\n        description=\"IC | Lead | Manager | Director | VP | C-Level\",\n    )\n    technical_skills: Union[dict[str, int], list[str]] = Field(default_factory=dict)\n    soft_skills: list[str] = Field(default_factory=list)\n    domain_expertise: list[str] = Field(default_factory=list)\n    industry_experience: list[str] = Field(default_factory=list)\n    notable_achievements: list[str] = Field(default_factory=list)\n    career_trajectory: str = \"\"\n    ideal_role_description: str = \"\"\n    creative_layer: list[str] = Field(default_factory=list)\n    signals: dict[str, str] = Field(default_factory=dict)\n\n\n# Alias for backward compatibility\nIdentityProfile = IdentityProfileSchema\n\n\n# ─── Search Manifest ─────────────────────────────────────────────────────────\n\n\nclass SearchManifestSchema(BaseModel):\n    \"\"\"\n    Search instructions derived from an IdentityProfile.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.SearchManifest.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    target_titles: list[str] = Field(default_factory=list)\n    keywords: list[str] = Field(default_factory=list)\n    excluded_titles: list[str] = Field(default_factory=list)\n    excluded_companies: list[str] = Field(default_factory=list)\n    excluded_industries: list[str] = Field(default_factory=list)\n    location_filters: list[str] = Field(default_factory=list)\n    remote_preference: str = \"flexible\"\n    min_compensation: Optional[int] = None\n\n\n# ─── Discovered Job ───────────────────────────────────────────────────────────\n\n\nclass DiscoveredJobSchema(BaseModel):\n    \"\"\"\n    Raw job data from a crawl — before scoring.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.DiscoveredJob.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    source: str\n    source_id: str\n    title: str\n    company: str\n    location: Optional[str] = None\n    description: Optional[str] = None\n    url: str\n    posted_at: Optional[datetime] = None\n    salary_min: Optional[int] = None\n    salary_max: Optional[int] = None\n    remote: bool = False\n    crawled_at: Optional[datetime] = None\n\n\n# ─── Score Breakdown ─────────────────────────────────────────────────────────\n\n\nclass ScoreBreakdown(BaseModel):\n    \"\"\"\n    Dimension-level score breakdown (0-100 per dimension).\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.ScoreBreakdown.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    technical_match: int = Field(ge=0, le=100)\n    level_match: int = Field(ge=0, le=100)\n    culture_match: int = Field(ge=0, le=100)\n    industry_match: int = Field(ge=0, le=100)\n    growth_potential: int = Field(ge=0, le=100)\n    compensation_match: int = Field(ge=0, le=100)\n\n    @computed_field\n    @property\n    def composite(self) -> int:\n        \"\"\"\n        Weighted composite score.\n\n        Weights (sum to 100%):\n          - technical_match: 30%\n          - level_match: 20%\n          - culture_match: 15%\n          - industry_match: 15%\n          - growth_potential: 10%\n          - compensation_match: 10%\n        \"\"\"\n        return int(\n            self.technical_match * 0.30\n            + self.level_match * 0.20\n            + self.culture_match * 0.15\n            + self.industry_match * 0.15\n            + self.growth_potential * 0.10\n            + self.compensation_match * 0.10\n        )\n\n\n# ─── Scored Job ───────────────────────────────────────────────────────────────\n\n\nclass ScoredJobSchema(BaseModel):\n    \"\"\"\n    A discovered job with full scoring breakdown and reasoning.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.ScoredJob.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    discovered_job_id: UUID\n    candidate_id: UUID\n    score_breakdown: ScoreBreakdown\n    composite_score: int = Field(ge=0, le=100)\n    is_hot: bool = False\n    reasoning: str\n    scored_at: Optional[datetime] = None\n\n    # Denormalized job fields for digest display\n    title: str = \"\"\n    company: str = \"\"\n    location: Optional[str] = None\n    url: str = \"\"\n\n\n# ─── Daily Digest ─────────────────────────────────────────────────────────────\n\n\nclass DailyDigestSchema(BaseModel):\n    \"\"\"\n    Full daily digest — persisted to DB and published to Redis.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.DailyDigest.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    candidate_id: UUID\n    run_date: str = Field(description=\"ISO date: YYYY-MM-DD\")\n    top_picks: list[ScoredJobSchema] = Field(default_factory=list)\n    hot_picks: list[ScoredJobSchema] = Field(default_factory=list)\n    new_companies: list[str] = Field(default_factory=list)\n    total_jobs_discovered: int = 0\n    total_jobs_scored: int = 0\n    created_at: Optional[datetime] = None\n","numLines":221,"startLine":1,"totalLines":221}}}}
