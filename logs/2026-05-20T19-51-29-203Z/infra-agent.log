────────────────────────────────────────────────────────────────\n    46→\n    47→test:\n    48→\tpytest tests/ -v\n    49→\n    50→lint:\n    51→\truff check backend/ --output-format=github\n    52→\truff format backend/ --check\n    53→\tcd frontend && npm run lint\n    54→\n    55→# ─── Digital Dash Pipeline (local simulation) ────────────────────────────────\n    56→\n    57→pipeline:\n    58→\t@echo \"\"\n    59→\t@echo \"╔══════════════════════════════════════════════════╗\"\n    60→\t@echo \"║  Digital Dash — Local Pipeline Run               ║\"\n    61→\t@echo \"╚══════════════════════════════════════════════════╝\"\n    62→\t@echo \"\"\n    63→\t@echo \"Stage 1: Lint...\"\n    64→\t@$(MAKE) lint || (echo \"🔴 Lint failed — pipeline blocked\" && exit 1)\n    65→\t@echo \"✅ Lint passed\"\n    66→\t@echo \"\"\n    67→\t@echo \"Stage 2: Test...\"\n    68→\t@$(MAKE) test || (echo \"🔴 Tests failed — pipeline blocked\" && exit 1)\n    69→\t@echo \"✅ Tests passed\"\n    70→\t@echo \"\"\n    71→\t@echo \"Stage 3: Build...\"\n    72→\t@docker build -t talent-agent-backend:local -f Dockerfile . || (echo \"🔴 Backend build failed\" && exit 1)\n    73→\t@cd frontend && docker build -t talent-agent-frontend:local -f Dockerfile . || (echo \"🔴 Frontend build failed\" && exit 1)\n    74→\t@echo \"✅ Images built\"\n    75→\t@echo \"\"\n    76→\t@echo \"╔══════════════════════════════════════════════════╗\"\n    77→\t@echo \"║  ✅ Pipeline GREEN — ready for deployment        ║\"\n    78→\t@echo \"╚══════════════════════════════════════════════════╝\"\n    79→\n    80→# ─── Deployment ──────────────────────────────────────────────────────────────\n    81→\n    82→deploy-local:\n    83→\t./deploy/deploy.sh local\n    84→\n    85→deploy-staging:\n    86→\t./deploy/deploy.sh staging all\n    87→\n    88→deploy-prod:\n    89→\t./deploy/deploy.sh prod all\n    90→\n    91→rollback:\n    92→\t@echo \"Usage: make rollback-staging or make rollback-prod\"\n    93→\n    94→rollback-staging:\n    95→\t./deploy/deploy.sh staging backend --rollback\n    96→\t./deploy/deploy.sh staging frontend --rollback\n    97→\n    98→rollback-prod:\n    99→\t./deploy/deploy.sh prod backend --rollback\n   100→\t./deploy/deploy.sh prod frontend --rollback\n   101→\n   102→# ─── AWS Setup (one-time) ───────────────────────────────────────────────────\n   103→\n   104→setup-aws:\n   105→\t./deploy/setup-aws.sh\n   106→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"896edb10-d5e4-4e2d-8d2d-7fe02bdd0dae","uuid":"7ce9f37b-8581-4853-b6ca-2d7f290f1b44","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/Makefile","content":"# ╔══════════════════════════════════════════════════════════════════════════════╗\n# ║  Talent Agent — Makefile                                                   ║\n# ║  VibeSpace LLC · Digital Dash integrated                                   ║\n# ╚══════════════════════════════════════════════════════════════════════════════╝\n\n.PHONY: up down build logs shell test migrate install dev \\\n        deploy-local deploy-staging deploy-prod rollback \\\n        lint pipeline frontend-dev setup-aws\n\n# ─── Local Development ───────────────────────────────────────────────────────\n\nup:\n\tdocker-compose up -d\n\ndown:\n\tdocker-compose down\n\nbuild:\n\tdocker-compose build\n\nlogs:\n\tdocker-compose logs -f app\n\nshell:\n\tdocker-compose exec app bash\n\ninstall:\n\tpip install -r requirements.txt\n\tplaywright install chromium\n\ndev:\n\tuvicorn backend.main:app --reload --port 8000\n\nfrontend-dev:\n\tcd frontend && npm run dev\n\n# ─── Database ────────────────────────────────────────────────────────────────\n\nmigrate:\n\tdocker-compose exec db psql -U talent_agent -d talent_agent -f /docker-entrypoint-initdb.d/000_init.sql\n\tdocker-compose exec db psql -U talent_agent -d talent_agent -f /docker-entrypoint-initdb.d/001_discovery.sql\n\tdocker-compose exec db psql -U talent_agent -d talent_agent -f /docker-entrypoint-initdb.d/002_application.sql\n\tdocker-compose exec db psql -U talent_agent -d talent_agent -f /docker-entrypoint-initdb.d/003_auth.sql\n\n# ─── Testing ─────────────────────────────────────────────────────────────────\n\ntest:\n\tpytest tests/ -v\n\nlint:\n\truff check backend/ --output-format=github\n\truff format backend/ --check\n\tcd frontend && npm run lint\n\n# ─── Digital Dash Pipeline (local simulation) ────────────────────────────────\n\npipeline:\n\t@echo \"\"\n\t@echo \"╔══════════════════════════════════════════════════╗\"\n\t@echo \"║  Digital Dash — Local Pipeline Run               ║\"\n\t@echo \"╚══════════════════════════════════════════════════╝\"\n\t@echo \"\"\n\t@echo \"Stage 1: Lint...\"\n\t@$(MAKE) lint || (echo \"🔴 Lint failed — pipeline blocked\" && exit 1)\n\t@echo \"✅ Lint passed\"\n\t@echo \"\"\n\t@echo \"Stage 2: Test...\"\n\t@$(MAKE) test || (echo \"🔴 Tests failed — pipeline blocked\" && exit 1)\n\t@echo \"✅ Tests passed\"\n\t@echo \"\"\n\t@echo \"Stage 3: Build...\"\n\t@docker build -t talent-agent-backend:local -f Dockerfile . || (echo \"🔴 Backend build failed\" && exit 1)\n\t@cd frontend && docker build -t talent-agent-frontend:local -f Dockerfile . || (echo \"🔴 Frontend build failed\" && exit 1)\n\t@echo \"✅ Images built\"\n\t@echo \"\"\n\t@echo \"╔══════════════════════════════════════════════════╗\"\n\t@echo \"║  ✅ Pipeline GREEN — ready for deployment        ║\"\n\t@echo \"╚══════════════════════════════════════════════════╝\"\n\n# ─── Deployment ──────────────────────────────────────────────────────────────\n\ndeploy-local:\n\t./deploy/deploy.sh local\n\ndeploy-staging:\n\t./deploy/deploy.sh staging all\n\ndeploy-prod:\n\t./deploy/deploy.sh prod all\n\nrollback:\n\t@echo \"Usage: make rollback-staging or make rollback-prod\"\n\nrollback-staging:\n\t./deploy/deploy.sh staging backend --rollback\n\t./deploy/deploy.sh staging frontend --rollback\n\nrollback-prod:\n\t./deploy/deploy.sh prod backend --rollback\n\t./deploy/deploy.sh prod frontend --rollback\n\n# ─── AWS Setup (one-time) ───────────────────────────────────────────────────\n\nsetup-aws:\n\t./deploy/setup-aws.sh\n","numLines":106,"startLine":1,"totalLines":106}}}}
{"t":"2026-05-20T20:15:03.595Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018cjoBYfAFXB11ba3pKZv9E","type":"tool_result","content":"     1→# ╔══════════════════════════════════════════════════════════════════════════════╗\n     2→# ║  DIGITAL DASH — Pipeline Configuration                                     ║\n     3→# ║  VibeSpace LLC · The Dot Connector                                         ║\n     4→# ║                                                                            ║\n     5→# ║  This is the canonical pipeline spec for Digital Dash, VibeSpace's         ║\n     6→# ║  AI-native CI/CD platform. Every VibeSpace product uses this format.       ║\n     7→# ║                                                                            ║\n     8→# ║  Rules:                                                                    ║\n     9→# ║    • Green pipeline  → auto-merge                                          ║\n    10→# ║    • Red pipeline    → flag for human review                               ║\n    11→# ║    • Yellow pipeline → warn but continue (non-blocking)                    ║\n    12→# ╚══════════════════════════════════════════════════════════════════════════════╝\n    13→\n    14→product: talent-agent\n    15→version: \"0.1.0\"\n    16→team: vibespace-core\n    17→owner: spy@seanyoung.biz\n    18→\n    19→# ─── Environment Variables (injected at runtime) ─────────────────────────────\n    20→# Secrets are pulled from AWS Secrets Manager, never stored in this file.\n    21→env:\n    22→  AWS_REGION: us-east-1\n    23→  AWS_ACCOUNT_ID: \"${AWS_ACCOUNT_ID}\"\n    24→  ECR_REGISTRY: \"${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com\"\n    25→  ECR_REPO_BACKEND: talent-agent-backend\n    26→  ECR_REPO_FRONTEND: talent-agent-frontend\n    27→  ECS_CLUSTER: vibespace-prod\n    28→  ECS_SERVICE_BACKEND: talent-agent-backend\n    29→  ECS_SERVICE_FRONTEND: talent-agent-frontend\n    30→  STAGING_URL: \"https://staging.talent-agent.seanyoung.biz\"\n    31→  PROD_URL: \"https://talent-agent.seanyoung.biz\"\n    32→\n    33→# ─── Triggers ────────────────────────────────────────────────────────────────\n    34→triggers:\n    35→  push:\n    36→    branches: [main, develop, \"release/*\"]\n    37→  pull_request:\n    38→    branches: [main]\n    39→  manual:\n    40→    enabled: true\n    41→    description: \"Manually trigger a full pipeline run\"\n    42→\n    43→# ─── Pipeline Stages ────────────────────────────────────────────────────────\n    44→# Stages run sequentially. Steps within a stage run concurrently by default.\n    45→# A failed stage halts the pipeline and flags for human review.\n    46→#\n    47→# Stage lifecycle:  QUEUED → RUNNING → PASSED | FAILED | WARNED\n    48→# Pipeline result:  All PASSED → green (auto-merge)\n    49→#                   Any FAILED → red (human review)\n    50→#                   Any WARNED → yellow (continue, notify)\n    51→\n    52→stages:\n    53→\n    54→  # ── Stage 1: Lint & Static Analysis ──────────────────────────────────────\n    55→  - name: lint\n    56→    display: \"Lint & Analysis\"\n    57→    steps:\n    58→      - name: python-lint\n    59→        run: |\n    60→          pip install ruff\n    61→          ruff check backend/ --output-format=github\n    62→          ruff format backend/ --check\n    63→        on_fail: block\n    64→\n    65→      - name: frontend-lint\n    66→        run: |\n    67→          cd frontend\n    68→          npm ci\n    69→          npm run lint\n    70→        on_fail: block\n    71→\n    72→      - name: security-scan\n    73→        run: |\n    74→          pip install bandit safety\n    75→          bandit -r backend/ -ll -q\n    76→          safety check --file=requirements.txt\n    77→        on_fail: warn  # Non-blocking — notify but don't halt\n    78→\n    79→  # ── Stage 2: Test ────────────────────────────────────────────────────────\n    80→  - name: test\n    81→    display: \"Test Suite\"\n    82→    services:\n    83→      - name: postgres\n    84→        image: postgres:15-alpine\n    85→        env:\n    86→          POSTGRES_DB: talent_agent_test\n    87→          POSTGRES_USER: talent_agent\n    88→          POSTGRES_PASSWORD: test_password\n    89→        health_check: \"pg_isready -U talent_agent\"\n    90→\n    91→      - name: redis\n    92→        image: redis:7-alpine\n    93→        health_check: \"redis-cli ping\"\n    94→\n    95→    steps:\n    96→      - name: backend-tests\n    97→        env:\n    98→          DATABASE_URL: \"postgresql+asyncpg://talent_agent:test_password@postgres:5432/talent_agent_test\"\n    99→          REDIS_URL: \"redis://redis:6379/0\"\n   100→          ANTHROPIC_API_KEY: \"test-key\"\n   101→          APP_ENV: \"test\"\n   102→          DEBUG: \"false\"\n   103→        run: |\n   104→          pip install -r requirements.txt\n   105→          python -m pytest tests/ -v --tb=short --junitxml=reports/test-results.xml\n   106→        artifacts:\n   107→          - reports/test-results.xml\n   108→        on_fail: block\n   109→\n   110→      - name: frontend-tests\n   111→        run: |\n   112→          cd frontend\n   113→          npm ci\n   114→          npm run build  # Build validates TypeScript/JSX compilation\n   115→        on_fail: block\n   116→\n   117→  # ── Stage 3: Build ───────────────────────────────────────────────────────\n   118→  - name: build\n   119→    display: \"Build & Push Images\"\n   120→    only:\n   121→      branches: [main, \"release/*\"]\n   122→    steps:\n   123→      - name: build-backend\n   124→        run: |\n   125→          IMAGE=\"${ECR_REGISTRY}/${ECR_REPO_BACKEND}\"\n   126→          GIT_SHA=$(git rev-parse --short HEAD)\n   127→          docker build -t ${IMAGE}:${GIT_SHA} -t ${IMAGE}:latest -f Dockerfile .\n   128→          aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}\n   129→          docker push ${IMAGE}:${GIT_SHA}\n   130→          docker push ${IMAGE}:latest\n   131→        outputs:\n   132→          BACKEND_IMAGE_TAG: \"${GIT_SHA}\"\n   133→        on_fail: block\n   134→\n   135→      - name: build-frontend\n   136→        run: |\n   137→          IMAGE=\"${ECR_REGISTRY}/${ECR_REPO_FRONTEND}\"\n   138→          GIT_SHA=$(git rev-parse --short HEAD)\n   139→          docker build -t ${IMAGE}:${GIT_SHA} -t ${IMAGE}:latest -f frontend/Dockerfile frontend/\n   140→          aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}\n   141→          docker push ${IMAGE}:${GIT_SHA}\n   142→          docker push ${IMAGE}:latest\n   143→        outputs:\n   144→          FRONTEND_IMAGE_TAG: \"${GIT_SHA}\"\n   145→        on_fail: block\n   146→\n   147→  # ── Stage 4: Deploy to Staging ───────────────────────────────────────────\n   148→  - name: deploy-staging\n   149→    display: \"Deploy → Staging\"\n   150→    only:\n   151→      branches: [main, \"release/*\"]\n   152→    steps:\n   153→      - name: deploy-backend-staging\n   154→        run: |\n   155→          ./deploy/deploy.sh staging backend ${BACKEND_IMAGE_TAG}\n   156→        on_fail: block\n   157→\n   158→      - name: deploy-frontend-staging\n   159→        run: |\n   160→          ./deploy/deploy.sh staging frontend ${FRONTEND_IMAGE_TAG}\n   161→        on_fail: block\n   162→\n   163→  # ── Stage 5: Health Check ────────────────────────────────────────────────\n   164→  - name: health-check\n   165→    display: \"Staging Health Check\"\n   166→    only:\n   167→      branches: [main, \"release/*\"]\n   168→    steps:\n   169→      - name: api-health\n   170→        run: |\n   171→          echo \"Waiting for staging to stabilize...\"\n   172→          sleep 15\n   173→          for i in 1 2 3 4 5; do\n   174→            STATUS=$(curl -sf \"${STAGING_URL}/health\" | jq -r '.status' 2>/dev/null || echo \"down\")\n   175→            if [ \"$STATUS\" = \"ok\" ]; then\n   176→              echo \"Staging is healthy ✓\"\n   177→              exit 0\n   178→            fi\n   179→            echo \"Attempt $i: status=$STATUS — retrying in 10s...\"\n   180→            sleep 10\n   181→          done\n   182→          echo \"Staging health check failed after 5 attempts\"\n   183→          exit 1\n   184→        on_fail: block\n   185→\n   186→      - name: smoke-test\n   187→        run: |\n   188→          # Verify key endpoints respond\n   189→          curl -sf \"${STAGING_URL}/api/v1/auth/me\" -o /dev/null -w \"%{http_code}\" | grep -q \"401\" || exit 1\n   190→          echo \"Auth endpoint responding ✓\"\n   191→          curl -sf \"${STAGING_URL}/health\" | jq -e '.version' || exit 1\n   192→          echo \"Health endpoint with version ✓\"\n   193→        on_fail: warn\n   194→\n   195→  # ── Stage 6: Deploy to Production ────────────────────────────────────────\n   196→  - name: deploy-prod\n   197→    display: \"Deploy → Production\"\n   198→    only:\n   199→      branches: [main]\n   200→    gate:\n   201→      type: manual\n   202→      approvers: [spy@seanyoung.biz]\n   203→      message: \"Staging is green. Approve production deployment?\"\n   204→      timeout: 24h\n   205→    steps:\n   206→      - name: deploy-backend-prod\n   207→        run: |\n   208→          ./deploy/deploy.sh prod backend ${BACKEND_IMAGE_TAG}\n   209→        on_fail: block\n   210→\n   211→      - name: deploy-frontend-prod\n   212→        run: |\n   213→          ./deploy/deploy.sh prod frontend ${FRONTEND_IMAGE_TAG}\n   214→        on_fail: block\n   215→\n   216→      - name: verify-prod\n   217→        run: |\n   218→          sleep 15\n   219→          STATUS=$(curl -sf \"${PROD_URL}/health\" | jq -r '.status' 2>/dev/null || echo \"down\")\n   220→          if [ \"$STATUS\" != \"ok\" ]; then\n   221→            echo \"PRODUCTION HEALTH CHECK FAILED — triggering rollback\"\n   222→            ./deploy/deploy.sh prod backend --rollback\n   223→            ./deploy/deploy.sh prod frontend --rollback\n   224→            exit 1\n   225→          fi\n   226→          echo \"Production is healthy ✓\"\n   227→        on_fail: block\n   228→\n   229→# ─── Notifications ────────────────────────────────────────────────────────────\n   230→notifications:\n   231→  on_success:\n   232→    - channel: stdout\n   233→      message: \"✅ Pipeline green — ${product} ${version} deployed\"\n   234→  on_failure:\n   235→    - channel: stdout\n   236→      message: \"🔴 Pipeline failed at stage: ${failed_stage} — flagged for human review\"\n   237→  on_warn:\n   238→    - channel: stdout\n   239→      message: \"⚠️ Pipeline passed with warnings in: ${warned_stages}\"\n   240→\n   241→# ─── Metadata ─────────────────────────────────────────────────────────────────\n   242→metadata:\n   243→  framework: vibespace-framework\n   244→  created: \"2026-04-03\"\n   245→  spec_version: \"1.0.0\"\n   246→  description: >\n   247→    Full CI/CD pipeline for Talent Agent. Runs lint, test, build Docker images,\n   248→    deploy to staging with health checks, then production with manual gate and\n   249→    automatic rollback on failure.\n   250→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"896edb10-d5e4-4e2d-8d2d-7fe02bdd0dae","uuid":"f31e31c3-c096-4ba5-b1a4-e3455f188c81","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/digital-dash-pipeline.yml","content":"# ╔══════════════════════════════════════════════════════════════════════════════╗\n# ║  DIGITAL DASH — Pipeline Configuration                                     ║\n# ║  VibeSpace LLC · The Dot Connector                                         ║\n# ║                                                                            ║\n# ║  This is the canonical pipeline spec for Digital Dash, VibeSpace's         ║\n# ║  AI-native CI/CD platform. Every VibeSpace product uses this format.       ║\n# ║                                                                            ║\n# ║  Rules:                                                                    ║\n# ║    • Green pipeline  → auto-merge                                          ║\n# ║    • Red pipeline    → flag for human review                               ║\n# ║    • Yellow pipeline → warn but continue (non-blocking)                    ║\n# ╚══════════════════════════════════════════════════════════════════════════════╝\n\nproduct: talent-agent\nversion: \"0.1.0\"\nteam: vibespace-core\nowner: spy@seanyoung.biz\n\n# ─── Environment Variables (injected at runtime) ─────────────────────────────\n# Secrets are pulled from AWS Secrets Manager, never stored in this file.\nenv:\n  AWS_REGION: us-east-1\n  AWS_ACCOUNT_ID: \"${AWS_ACCOUNT_ID}\"\n  ECR_REGISTRY: \"${AWS_ACCOUNT_ID}.dkr.ecr.us-east-1.amazonaws.com\"\n  ECR_REPO_BACKEND: talent-agent-backend\n  ECR_REPO_FRONTEND: talent-agent-frontend\n  ECS_CLUSTER: vibespace-prod\n  ECS_SERVICE_BACKEND: talent-agent-backend\n  ECS_SERVICE_FRONTEND: talent-agent-frontend\n  STAGING_URL: \"https://staging.talent-agent.seanyoung.biz\"\n  PROD_URL: \"https://talent-agent.seanyoung.biz\"\n\n# ─── Triggers ────────────────────────────────────────────────────────────────\ntriggers:\n  push:\n    branches: [main, develop, \"release/*\"]\n  pull_request:\n    branches: [main]\n  manual:\n    enabled: true\n    description: \"Manually trigger a full pipeline run\"\n\n# ─── Pipeline Stages ────────────────────────────────────────────────────────\n# Stages run sequentially. Steps within a stage run concurrently by default.\n# A failed stage halts the pipeline and flags for human review.\n#\n# Stage lifecycle:  QUEUED → RUNNING → PASSED | FAILED | WARNED\n# Pipeline result:  All PASSED → green (auto-merge)\n#                   Any FAILED → red (human review)\n#                   Any WARNED → yellow (continue, notify)\n\nstages:\n\n  # ── Stage 1: Lint & Static Analysis ──────────────────────────────────────\n  - name: lint\n    display: \"Lint & Analysis\"\n    steps:\n      - name: python-lint\n        run: |\n          pip install ruff\n          ruff check backend/ --output-format=github\n          ruff format backend/ --check\n        on_fail: block\n\n      - name: frontend-lint\n        run: |\n          cd frontend\n          npm ci\n          npm run lint\n        on_fail: block\n\n      - name: security-scan\n        run: |\n          pip install bandit safety\n          bandit -r backend/ -ll -q\n          safety check --file=requirements.txt\n        on_fail: warn  # Non-blocking — notify but don't halt\n\n  # ── Stage 2: Test ────────────────────────────────────────────────────────\n  - name: test\n    display: \"Test Suite\"\n    services:\n      - name: postgres\n        image: postgres:15-alpine\n        env:\n          POSTGRES_DB: talent_agent_test\n          POSTGRES_USER: talent_agent\n          POSTGRES_PASSWORD: test_password\n        health_check: \"pg_isready -U talent_agent\"\n\n      - name: redis\n        image: redis:7-alpine\n        health_check: \"redis-cli ping\"\n\n    steps:\n      - name: backend-tests\n        env:\n          DATABASE_URL: \"postgresql+asyncpg://talent_agent:test_password@postgres:5432/talent_agent_test\"\n          REDIS_URL: \"redis://redis:6379/0\"\n          ANTHROPIC_API_KEY: \"test-key\"\n          APP_ENV: \"test\"\n          DEBUG: \"false\"\n        run: |\n          pip install -r requirements.txt\n          python -m pytest tests/ -v --tb=short --junitxml=reports/test-results.xml\n        artifacts:\n          - reports/test-results.xml\n        on_fail: block\n\n      - name: frontend-tests\n        run: |\n          cd frontend\n          npm ci\n          npm run build  # Build validates TypeScript/JSX compilation\n        on_fail: block\n\n  # ── Stage 3: Build ───────────────────────────────────────────────────────\n  - name: build\n    display: \"Build & Push Images\"\n    only:\n      branches: [main, \"release/*\"]\n    steps:\n      - name: build-backend\n        run: |\n          IMAGE=\"${ECR_REGISTRY}/${ECR_REPO_BACKEND}\"\n          GIT_SHA=$(git rev-parse --short HEAD)\n          docker build -t ${IMAGE}:${GIT_SHA} -t ${IMAGE}:latest -f Dockerfile .\n          aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}\n          docker push ${IMAGE}:${GIT_SHA}\n          docker push ${IMAGE}:latest\n        outputs:\n          BACKEND_IMAGE_TAG: \"${GIT_SHA}\"\n        on_fail: block\n\n      - name: build-frontend\n        run: |\n          IMAGE=\"${ECR_REGISTRY}/${ECR_REPO_FRONTEND}\"\n          GIT_SHA=$(git rev-parse --short HEAD)\n          docker build -t ${IMAGE}:${GIT_SHA} -t ${IMAGE}:latest -f frontend/Dockerfile frontend/\n          aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}\n          docker push ${IMAGE}:${GIT_SHA}\n          docker push ${IMAGE}:latest\n        outputs:\n          FRONTEND_IMAGE_TAG: \"${GIT_SHA}\"\n        on_fail: block\n\n  # ── Stage 4: Deploy to Staging ───────────────────────────────────────────\n  - name: deploy-staging\n    display: \"Deploy → Staging\"\n    only:\n      branches: [main, \"release/*\"]\n    steps:\n      - name: deploy-backend-staging\n        run: |\n          ./deploy/deploy.sh staging backend ${BACKEND_IMAGE_TAG}\n        on_fail: block\n\n      - name: deploy-frontend-staging\n        run: |\n          ./deploy/deploy.sh staging frontend ${FRONTEND_IMAGE_TAG}\n        on_fail: block\n\n  # ── Stage 5: Health Check ────────────────────────────────────────────────\n  - name: health-check\n    display: \"Staging Health Check\"\n    only:\n      branches: [main, \"release/*\"]\n    steps:\n      - name: api-health\n        run: |\n          echo \"Waiting for staging to stabilize...\"\n          sleep 15\n          for i in 1 2 3 4 5; do\n            STATUS=$(curl -sf \"${STAGING_URL}/health\" | jq -r '.status' 2>/dev/null || echo \"down\")\n            if [ \"$STATUS\" = \"ok\" ]; then\n              echo \"Staging is healthy ✓\"\n              exit 0\n            fi\n            echo \"Attempt $i: status=$STATUS — retrying in 10s...\"\n            sleep 10\n          done\n          echo \"Staging health check failed after 5 attempts\"\n          exit 1\n        on_fail: block\n\n      - name: smoke-test\n        run: |\n          # Verify key endpoints respond\n          curl -sf \"${STAGING_URL}/api/v1/auth/me\" -o /dev/null -w \"%{http_code}\" | grep -q \"401\" || exit 1\n          echo \"Auth endpoint responding ✓\"\n          curl -sf \"${STAGING_URL}/health\" | jq -e '.version' || exit 1\n          echo \"Health endpoint with version ✓\"\n        on_fail: warn\n\n  # ── Stage 6: Deploy to Production ────────────────────────────────────────\n  - name: deploy-prod\n    display: \"Deploy → Production\"\n    only:\n      branches: [main]\n    gate:\n      type: manual\n      approvers: [spy@seanyoung.biz]\n      message: \"Staging is green. Approve production deployment?\"\n      timeout: 24h\n    steps:\n      - name: deploy-backend-prod\n        run: |\n          ./deploy/deploy.sh prod backend ${BACKEND_IMAGE_TAG}\n        on_fail: block\n\n      - name: deploy-frontend-prod\n        run: |\n          ./deploy/deploy.sh prod frontend ${FRONTEND_IMAGE_TAG}\n        on_fail: block\n\n      - name: verify-prod\n        run: |\n          sleep 15\n          STATUS=$(curl -sf \"${PROD_URL}/health\" | jq -r '.status' 2>/dev/null || echo \"down\")\n          if [ \"$STATUS\" != \"ok\" ]; then\n            echo \"PRODUCTION HEALTH CHECK FAILED — triggering rollback\"\n            ./deploy/deploy.sh prod backend --rollback\n            ./deploy/deploy.sh prod frontend --rollback\n            exit 1\n          fi\n          echo \"Production is healthy ✓\"\n        on_fail: block\n\n# ─── Notifications ────────────────────────────────────────────────────────────\nnotifications:\n  on_success:\n    - channel: stdout\n      message: \"✅ Pipeline green — ${product} ${version} deployed\"\n  on_failure:\n    - channel: stdout\n      message: \"🔴 Pipeline failed at stage: ${failed_stage} — flagged for human review\"\n  on_warn:\n    - channel: stdout\n      message: \"⚠️ Pipeline passed with warnings in: ${warned_stages}\"\n\n# ─── Metadata ─────────────────────────────────────────────────────────────────\nmetadata:\n  framework: vibespace-framework\n  created: \"2026-04-03\"\n  spec_version: \"1.0.0\"\n  description: >\n    Full CI/CD pipeline for Talent Agent. Runs lint, test, build Docker images,\n    deploy to staging with health checks, then production with manual gate and\n    automatic rollback on failure.\n","numLines":250,"startLine":1,"totalLines":250}}}}
