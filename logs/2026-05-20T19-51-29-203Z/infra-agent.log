op for production\nCMD [\"python\", \"-m\", \"uvicorn\", \"backend.main:app\", \\\n     \"--host\", \"0.0.0.0\", \"--port\", \"8000\", \\\n     \"--workers\", \"4\", \"--loop\", \"uvloop\", \\\n     \"--access-log\"]"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":986,"cache_read_input_tokens":72816,"cache_creation":{"ephemeral_5m_input_tokens":986,"ephemeral_1h_input_tokens":0},"output_tokens":687,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"896edb10-d5e4-4e2d-8d2d-7fe02bdd0dae","uuid":"54afd42a-7b47-4920-8528-d595e8adba38"}}
