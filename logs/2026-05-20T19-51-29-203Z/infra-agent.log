{"t":"2026-05-20T20:15:12.135Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012wyKLkbrJh7Na3aM1xQh1F","type":"tool_result","content":"     1→#!/usr/bin/env bash\n     2→# ╔══════════════════════════════════════════════════════════════════════════════╗\n     3→# ║  deploy.sh — Talent Agent Deployment Script                                ║\n     4→# ║  VibeSpace LLC · Integrated with Digital Dash Pipeline                     ║\n     5→# ║                                                                            ║\n     6→# ║  Usage:                                                                    ║\n     7→# ║    ./deploy/deploy.sh <environment> <service> [image_tag]                  ║\n     8→# ║    ./deploy/deploy.sh <environment> <service> --rollback                   ║\n     9→# ║    ./deploy/deploy.sh <environment> all [image_tag]                        ║\n    10→# ║                                                                            ║\n    11→# ║  Examples:                                                                 ║\n    12→# ║    ./deploy/deploy.sh staging backend abc1234                              ║\n    13→# ║    ./deploy/deploy.sh prod all                     # uses :latest          ║\n    14→# ║    ./deploy/deploy.sh prod backend --rollback      # rolls back            ║\n    15→# ║    ./deploy/deploy.sh local                        # docker-compose up     ║\n    16→# ╚══════════════════════════════════════════════════════════════════════════════╝\n    17→\n    18→set -euo pipefail\n    19→\n    20→# ─── Config ──────────────────────────────────────────────────────────────────\n    21→\n    22→SCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\n    23→PROJECT_ROOT=\"$(dirname \"$SCRIPT_DIR\")\"\n    24→\n    25→AWS_REGION=\"${AWS_REGION:-us-east-1}\"\n    26→AWS_ACCOUNT_ID=\"${AWS_ACCOUNT_ID:-}\"\n    27→ECR_REGISTRY=\"${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com\"\n    28→ECS_CLUSTER=\"${ECS_CLUSTER:-vibespace-prod}\"\n    29→\n    30→# Service → ECS mapping\n    31→declare -A ECS_SERVICES=(\n    32→  [backend]=\"talent-agent-backend\"\n    33→  [frontend]=\"talent-agent-frontend\"\n    34→)\n    35→\n    36→declare -A ECR_REPOS=(\n    37→  [backend]=\"talent-agent-backend\"\n    38→  [frontend]=\"talent-agent-frontend\"\n    39→)\n    40→\n    41→declare -A TASK_DEFS=(\n    42→  [backend]=\"talent-agent-backend\"\n    43→  [frontend]=\"talent-agent-frontend\"\n    44→)\n    45→\n    46→# ─── Colors ──────────────────────────────────────────────────────────────────\n    47→\n    48→RED='\\033[0;31m'\n    49→GREEN='\\033[0;32m'\n    50→YELLOW='\\033[1;33m'\n    51→CYAN='\\033[0;36m'\n    52→BOLD='\\033[1m'\n    53→RESET='\\033[0m'\n    54→\n    55→log()  { echo -e \"${CYAN}[deploy]${RESET} $*\"; }\n    56→ok()   { echo -e \"${GREEN}[deploy]${RESET} $*\"; }\n    57→warn() { echo -e \"${YELLOW}[deploy]${RESET} $*\"; }\n    58→die()  { echo -e \"${RED}[deploy]${RESET} $*\" >&2; exit 1; }\n    59→\n    60→# ─── Helpers ─────────────────────────────────────────────────────────────────\n    61→\n    62→require_cmd() {\n    63→  command -v \"$1\" >/dev/null 2>&1 || die \"Required command not found: $1\"\n    64→}\n    65→\n    66→get_git_sha() {\n    67→  git rev-parse --short HEAD 2>/dev/null || echo \"unknown\"\n    68→}\n    69→\n    70→get_timestamp() {\n    71→  date -u '+%Y-%m-%dT%H:%M:%SZ'\n    72→}\n    73→\n    74→ecr_login() {\n    75→  log \"Authenticating with ECR...\"\n    76→  aws ecr get-login-password --region \"${AWS_REGION}\" | \\\n    77→    docker login --username AWS --password-stdin \"${ECR_REGISTRY}\" 2>/dev/null\n    78→  ok \"ECR authentication successful\"\n    79→}\n    80→\n    81→# ─── Build ───────────────────────────────────────────────────────────────────\n    82→\n    83→build_image() {\n    84→  local service=\"$1\"\n    85→  local tag=\"$2\"\n    86→  local image=\"${ECR_REGISTRY}/${ECR_REPOS[$service]}:${tag}\"\n    87→\n    88→  log \"Building ${BOLD}${service}${RESET} image → ${image}\"\n    89→\n    90→  if [[ \"$service\" == \"backend\" ]]; then\n    91→    docker build \\\n    92→      -t \"${image}\" \\\n    93→      -t \"${ECR_REGISTRY}/${ECR_REPOS[$service]}:latest\" \\\n    94→      -f \"${PROJECT_ROOT}/Dockerfile\" \\\n    95→      \"${PROJECT_ROOT}\"\n    96→  elif [[ \"$service\" == \"frontend\" ]]; then\n    97→    local api_url=\"\"\n    98→    if [[ \"$ENV\" == \"staging\" ]]; then\n    99→      api_url=\"https://staging.talent-agent.seanyoung.biz/api/v1\"\n   100→    elif [[ \"$ENV\" == \"prod\" ]]; then\n   101→      api_url=\"https://talent-agent.seanyoung.biz/api/v1\"\n   102→    fi\n   103→\n   104→    docker build \\\n   105→      --build-arg VITE_API_URL=\"${api_url}\" \\\n   106→      -t \"${image}\" \\\n   107→      -t \"${ECR_REGISTRY}/${ECR_REPOS[$service]}:latest\" \\\n   108→      -f \"${PROJECT_ROOT}/frontend/Dockerfile\" \\\n   109→      \"${PROJECT_ROOT}/frontend\"\n   110→  fi\n   111→\n   112→  ok \"Built ${service} → ${image}\"\n   113→}\n   114→\n   115→push_image() {\n   116→  local service=\"$1\"\n   117→  local tag=\"$2\"\n   118→  local image=\"${ECR_REGISTRY}/${ECR_REPOS[$service]}\"\n   119→\n   120→  log \"Pushing ${BOLD}${service}${RESET} images...\"\n   121→  docker push \"${image}:${tag}\"\n   122→  docker push \"${image}:latest\"\n   123→  ok \"Pushed ${service}:${tag} + :latest\"\n   124→}\n   125→\n   126→# ─── Deploy to ECS ───────────────────────────────────────────────────────────\n   127→\n   128→deploy_ecs() {\n   129→  local service=\"$1\"\n   130→  local tag=\"$2\"\n   131→  local ecs_service=\"${ECS_SERVICES[$service]}\"\n   132→  local task_def=\"${TASK_DEFS[$service]}\"\n   133→  local image=\"${ECR_REGISTRY}/${ECR_REPOS[$service]}:${tag}\"\n   134→  local cluster=\"${ECS_CLUSTER}\"\n   135→\n   136→  # Add environment suffix for staging\n   137→  if [[ \"$ENV\" == \"staging\" ]]; then\n   138→    cluster=\"${ECS_CLUSTER}-staging\"\n   139→    ecs_service=\"${ecs_service}-staging\"\n   140→    task_def=\"${task_def}-staging\"\n   141→  fi\n   142→\n   143→  log \"Deploying ${BOLD}${service}${RESET} to ECS...\"\n   144→  log \"  Cluster:  ${cluster}\"\n   145→  log \"  Service:  ${ecs_service}\"\n   146→  log \"  Image:    ${image}\"\n   147→\n   148→  # Get current task definition\n   149→  local current_task_def\n   150→  current_task_def=$(aws ecs describe-task-definition \\\n   151→    --task-definition \"${task_def}\" \\\n   152→    --region \"${AWS_REGION}\" \\\n   153→    --query 'taskDefinition' \\\n   154→    --output json 2>/dev/null) || die \"Failed to fetch task definition: ${task_def}\"\n   155→\n   156→  # Update the image in the container definition\n   157→  local new_task_def\n   158→  new_task_def=$(echo \"$current_task_def\" | \\\n   159→    jq --arg IMAGE \"$image\" \\\n   160→    '.containerDefinitions[0].image = $IMAGE |\n   161→     del(.taskDefinitionArn, .revision, .status, .requiresAttributes,\n   162→         .compatibilities, .registeredAt, .registeredBy)')\n   163→\n   164→  # Register new task definition revision\n   165→  local new_revision\n   166→  new_revision=$(aws ecs register-task-definition \\\n   167→    --region \"${AWS_REGION}\" \\\n   168→    --cli-input-json \"$new_task_def\" \\\n   169→    --query 'taskDefinition.taskDefinitionArn' \\\n   170→    --output text) || die \"Failed to register new task definition\"\n   171→\n   172→  log \"  New task def: ${new_revision}\"\n   173→\n   174→  # Update the service to use the new task definition\n   175→  aws ecs update-service \\\n   176→    --region \"${AWS_REGION}\" \\\n   177→    --cluster \"${cluster}\" \\\n   178→    --service \"${ecs_service}\" \\\n   179→    --task-definition \"${new_revision}\" \\\n   180→    --force-new-deployment \\\n   181→    --query 'service.serviceName' \\\n   182→    --output text >/dev/null || die \"Failed to update ECS service\"\n   183→\n   184→  ok \"Deployment initiated for ${service} on ${cluster}\"\n   185→\n   186→  # Wait for service stability\n   187→  log \"Waiting for ${service} to stabilize (timeout: 5m)...\"\n   188→  if aws ecs wait services-stable \\\n   189→    --region \"${AWS_REGION}\" \\\n   190→    --cluster \"${cluster}\" \\\n   191→    --services \"${ecs_service}\" 2>/dev/null; then\n   192→    ok \"${service} is stable and running ✓\"\n   193→  else\n   194→    die \"${service} failed to stabilize — check ECS console\"\n   195→  fi\n   196→}\n   197→\n   198→# ─── Rollback ────────────────────────────────────────────────────────────────\n   199→\n   200→rollback_ecs() {\n   201→  local service=\"$1\"\n   202→  local ecs_service=\"${ECS_SERVICES[$service]}\"\n   203→  local task_def=\"${TASK_DEFS[$service]}\"\n   204→  local cluster=\"${ECS_CLUSTER}\"\n   205→\n   206→  if [[ \"$ENV\" == \"staging\" ]]; then\n   207→    cluster=\"${ECS_CLUSTER}-staging\"\n   208→    ecs_service=\"${ecs_service}-staging\"\n   209→    task_def=\"${task_def}-staging\"\n   210→  fi\n   211→\n   212→  warn \"Rolling back ${BOLD}${service}${RESET}...\"\n   213→\n   214→  # Get the previous task definition revision\n   215→  local revisions\n   216→  revisions=$(aws ecs list-task-definitions \\\n   217→    --family-prefix \"${task_def}\" \\\n   218→    --region \"${AWS_REGION}\" \\\n   219→    --sort DESC \\\n   220→    --query 'taskDefinitionArns[0:2]' \\\n   221→    --output json)\n   222→\n   223→  local previous_revision\n   224→  previous_revision=$(echo \"$revisions\" | jq -r '.[1] // empty')\n   225→\n   226→  if [[ -z \"$previous_revision\" ]]; then\n   227→    die \"No previous revision found for ${task_def} — cannot rollback\"\n   228→  fi\n   229→\n   230→  log \"Rolling back to: ${previous_revision}\"\n   231→\n   232→  aws ecs update-service \\\n   233→    --region \"${AWS_REGION}\" \\\n   234→    --cluster \"${cluster}\" \\\n   235→    --service \"${ecs_service}\" \\\n   236→    --task-definition \"${previous_revision}\" \\\n   237→    --force-new-deployment \\\n   238→    --query 'service.serviceName' \\\n   239→    --output text >/dev/null || die \"Rollback failed\"\n   240→\n   241→  log \"Waiting for rollback to stabilize...\"\n   242→  aws ecs wait services-stable \\\n   243→    --region \"${AWS_REGION}\" \\\n   244→    --cluster \"${cluster}\" \\\n   245→    --services \"${ecs_service}\" 2>/dev/null\n   246→\n   247→  ok \"Rollback complete for ${service} ✓\"\n   248→}\n   249→\n   250→# ─── Local Deploy (docker-compose) ──────────────────────────────────────────\n   251→\n   252→deploy_local() {\n   253→  log \"Running local deployment via docker-compose...\"\n   254→  cd \"${PROJECT_ROOT}\"\n   255→\n   256→  docker-compose down --remove-orphans 2>/dev/null || true\n   257→  docker-compose build\n   258→  docker-compose up -d\n   259→\n   260→  log \"Waiting for services...\"\n   261→  sleep 5\n   262→\n   263→  # Health check\n   264→  for i in 1 2 3 4 5; do\n   265→    if curl -sf http://localhost:8000/health >/dev/null 2>&1; then\n   266→      ok \"Local deployment is healthy ✓\"\n   267→      echo \"\"\n   268→      log \"Services:\"\n   269→      log \"  Backend:   http://localhost:8000\"\n   270→      log \"  Frontend:  http://localhost:5173 (run 'cd frontend && npm run dev')\"\n   271→      log \"  Postgres:  localhost:5432\"\n   272→      log \"  Redis:     localhost:6379\"\n   273→      echo \"\"\n   274→      docker-compose ps\n   275→      exit 0\n   276→    fi\n   277→    log \"Attempt $i — waiting...\"\n   278→    sleep 3\n   279→  done\n   280→\n   281→  warn \"Backend not responding yet — check logs with: docker-compose logs -f app\"\n   282→}\n   283→\n   284→# ─── Run Database Migrations ─────────────────────────────────────────────────\n   285→\n   286→run_migrations() {\n   287→  local env=\"$1\"\n   288→  log \"Running database migrations for ${env}...\"\n   289→\n   290→  if [[ \"$env\" == \"local\" ]]; then\n   291→    docker-compose exec -T db psql -U talent_agent -d talent_agent \\\n   292→      -f /docker-entrypoint-initdb.d/000_init.sql 2>/dev/null || true\n   293→    docker-compose exec -T db psql -U talent_agent -d talent_agent \\\n   294→      -f /docker-entrypoint-initdb.d/001_discovery.sql\n   295→    docker-compose exec -T db psql -U talent_agent -d talent_agent \\\n   296→      -f /docker-entrypoint-initdb.d/002_application.sql\n   297→    docker-compose exec -T db psql -U talent_agent -d talent_agent \\\n   298→      -f /docker-entrypoint-initdb.d/003_auth.sql\n   299→  else\n   300→    # For staging/prod, migrations run via the app's SQLAlchemy create_all\n   301→    # or via a dedicated migration task\n   302→    log \"Remote migrations handled by app startup (SQLAlchemy metadata.create_all)\"\n   303→  fi\n   304→\n   305→  ok \"Migrations complete ✓\"\n   306→}\n   307→\n   308→# ─── Main ────────────────────────────────────────────────────────────────────\n   309→\n   310→usage() {\n   311→  echo \"\"\n   312→  echo -e \"${BOLD}Usage:${RESET}\"\n   313→  echo \"  ./deploy/deploy.sh <environment> [service] [image_tag|--rollback]\"\n   314→  echo \"\"\n   315→  echo -e \"${BOLD}Environments:${RESET}\"\n   316→  echo \"  local     Docker Compose (development)\"\n   317→  echo \"  staging   ECS Fargate staging cluster\"\n   318→  echo \"  prod      ECS Fargate production cluster\"\n   319→  echo \"\"\n   320→  echo -e \"${BOLD}Services:${RESET}\"\n   321→  echo \"  backend   FastAPI backend\"\n   322→  echo \"  frontend  React frontend (Nginx)\"\n   323→  echo \"  all       Both services\"\n   324→  echo \"\"\n   325→  echo -e \"${BOLD}Examples:${RESET}\"\n   326→  echo \"  ./deploy/deploy.sh local                        # spin up local env\"\n   327→  echo \"  ./deploy/deploy.sh local --migrate              # local + run migrations\"\n   328→  echo \"  ./deploy/deploy.sh staging backend abc1234      # deploy specific tag\"\n   329→  echo \"  ./deploy/deploy.sh staging all                  # deploy both, :latest\"\n   330→  echo \"  ./deploy/deploy.sh prod backend --rollback      # rollback backend\"\n   331→  echo \"  ./deploy/deploy.sh prod all abc1234             # deploy both to prod\"\n   332→  echo \"\"\n   333→  exit 1\n   334→}\n   335→\n   336→main() {\n   337→  ENV=\"${1:-}\"\n   338→  SERVICE=\"${2:-all}\"\n   339→  TAG=\"${3:-$(get_git_sha)}\"\n   340→\n   341→  [[ -z \"$ENV\" ]] && usage\n   342→\n   343→  echo \"\"\n   344→  echo -e \"${CYAN}╔══════════════════════════════════════════════════╗${RESET}\"\n   345→  echo -e \"${CYAN}║${RESET}  ${BOLD}Talent Agent — Deployment${RESET}                        ${CYAN}║${RESET}\"\n   346→  echo -e \"${CYAN}║${RESET}  VibeSpace LLC · Digital Dash Pipeline           ${CYAN}║${RESET}\"\n   347→  echo -e \"${CYAN}╚══════════════════════════════════════════════════╝${RESET}\"\n   348→  echo \"\"\n   349→  log \"Environment: ${BOLD}${ENV}${RESET}\"\n   350→  log \"Service:     ${BOLD}${SERVICE}${RESET}\"\n   351→  log \"Tag:         ${BOLD}${TAG}${RESET}\"\n   352→  log \"Timestamp:   $(get_timestamp)\"\n   353→  log \"Git SHA:     $(get_git_sha)\"\n   354→  echo \"\"\n   355→\n   356→  # ── Local deployment ───────────────────────────────────────────────────\n   357→  if [[ \"$ENV\" == \"local\" ]]; then\n   358→    require_cmd docker\n   359→    require_cmd docker-compose\n   360→\n   361→    if [[ \"$SERVICE\" == \"--migrate\" || \"$TAG\" == \"--migrate\" ]]; then\n   362→      deploy_local\n   363→      run_migrations local\n   364→    else\n   365→      deploy_local\n   366→    fi\n   367→    exit 0\n   368→  fi\n   369→\n   370→  # ── Cloud deployment (staging / prod) ──────────────────────────────────\n   371→  require_cmd aws\n   372→  require_cmd docker\n   373→  require_cmd jq\n   374→\n   375→  [[ -z \"$AWS_ACCOUNT_ID\" ]] && die \"AWS_ACCOUNT_ID is not set. Export it or add to .env\"\n   376→\n   377→  # Rollback mode\n   378→  if [[ \"$TAG\" == \"--rollback\" ]]; then\n   379→    if [[ \"$SERVICE\" == \"all\" ]]; then\n   380→      rollback_ecs backend\n   381→      rollback_ecs frontend\n   382→    else\n   383→      rollback_ecs \"$SERVICE\"\n   384→    fi\n   385→    exit 0\n   386→  fi\n   387→\n   388→  # Build + Push + Deploy\n   389→  ecr_login\n   390→\n   391→  deploy_service() {\n   392→    local svc=\"$1\"\n   393→    build_image \"$svc\" \"$TAG\"\n   394→    push_image \"$svc\" \"$TAG\"\n   395→    deploy_ecs \"$svc\" \"$TAG\"\n   396→  }\n   397→\n   398→  if [[ \"$SERVICE\" == \"all\" ]]; then\n   399→    deploy_service backend\n   400→    deploy_service frontend\n   401→  else\n   402→    [[ -z \"${ECS_SERVICES[$SERVICE]+_}\" ]] && die \"Unknown service: ${SERVICE}. Use: backend, frontend, all\"\n   403→    deploy_service \"$SERVICE\"\n   404→  fi\n   405→\n   406→  echo \"\"\n   407→  ok \"═══════════════════════════════════════════════════\"\n   408→  ok \"  Deployment complete! 🚀\"\n   409→  ok \"  ${ENV} / ${SERVICE} / ${TAG}\"\n   410→  ok \"═══════════════════════════════════════════════════\"\n   411→  echo \"\"\n   412→}\n   413→\n   414→main \"$@\"\n   415→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"896edb10-d5e4-4e2d-8d2d-7fe02bdd0dae","uuid":"080ce8a0-4af1-480c-90cb-258bede3e5b7","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/deploy/deploy.sh","content":"#!/usr/bin/env bash\n# ╔══════════════════════════════════════════════════════════════════════════════╗\n# ║  deploy.sh — Talent Agent Deployment Script                                ║\n# ║  VibeSpace LLC · Integrated with Digital Dash Pipeline                     ║\n# ║                                                                            ║\n# ║  Usage:                                                                    ║\n# ║    ./deploy/deploy.sh <environment> <service> [image_tag]                  ║\n# ║    ./deploy/deploy.sh <environment> <service> --rollback                   ║\n# ║    ./deploy/deploy.sh <environment> all [image_tag]                        ║\n# ║                                                                            ║\n# ║  Examples:                                                                 ║\n# ║    ./deploy/deploy.sh staging backend abc1234                              ║\n# ║    ./deploy/deploy.sh prod all                     # uses :latest          ║\n# ║    ./deploy/deploy.sh prod backend --rollback      # rolls back            ║\n# ║    ./deploy/deploy.sh local                        # docker-compose up     ║\n# ╚══════════════════════════════════════════════════════════════════════════════╝\n\nset -euo pipefail\n\n# ─── Config ──────────────────────────────────────────────────────────────────\n\nSCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd)\"\nPROJECT_ROOT=\"$(dirname \"$SCRIPT_DIR\")\"\n\nAWS_REGION=\"${AWS_REGION:-us-east-1}\"\nAWS_ACCOUNT_ID=\"${AWS_ACCOUNT_ID:-}\"\nECR_REGISTRY=\"${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com\"\nECS_CLUSTER=\"${ECS_CLUSTER:-vibespace-prod}\"\n\n# Service → ECS mapping\ndeclare -A ECS_SERVICES=(\n  [backend]=\"talent-agent-backend\"\n  [frontend]=\"talent-agent-frontend\"\n)\n\ndeclare -A ECR_REPOS=(\n  [backend]=\"talent-agent-backend\"\n  [frontend]=\"talent-agent-frontend\"\n)\n\ndeclare -A TASK_DEFS=(\n  [backend]=\"talent-agent-backend\"\n  [frontend]=\"talent-agent-frontend\"\n)\n\n# ─── Colors ──────────────────────────────────────────────────────────────────\n\nRED='\\033[0;31m'\nGREEN='\\033[0;32m'\nYELLOW='\\033[1;33m'\nCYAN='\\033[0;36m'\nBOLD='\\033[1m'\nRESET='\\033[0m'\n\nlog()  { echo -e \"${CYAN}[deploy]${RESET} $*\"; }\nok()   { echo -e \"${GREEN}[deploy]${RESET} $*\"; }\nwarn() { echo -e \"${YELLOW}[deploy]${RESET} $*\"; }\ndie()  { echo -e \"${RED}[deploy]${RESET} $*\" >&2; exit 1; }\n\n# ─── Helpers ─────────────────────────────────────────────────────────────────\n\nrequire_cmd() {\n  command -v \"$1\" >/dev/null 2>&1 || die \"Required command not found: $1\"\n}\n\nget_git_sha() {\n  git rev-parse --short HEAD 2>/dev/null || echo \"unknown\"\n}\n\nget_timestamp() {\n  date -u '+%Y-%m-%dT%H:%M:%SZ'\n}\n\necr_login() {\n  log \"Authenticating with ECR...\"\n  aws ecr get-login-password --region \"${AWS_REGION}\" | \\\n    docker login --username AWS --password-stdin \"${ECR_REGISTRY}\" 2>/dev/null\n  ok \"ECR authentication successful\"\n}\n\n# ─── Build ───────────────────────────────────────────────────────────────────\n\nbuild_image() {\n  local service=\"$1\"\n  local tag=\"$2\"\n  local image=\"${ECR_REGISTRY}/${ECR_REPOS[$service]}:${tag}\"\n\n  log \"Building ${BOLD}${service}${RESET} image → ${image}\"\n\n  if [[ \"$service\" == \"backend\" ]]; then\n    docker build \\\n      -t \"${image}\" \\\n      -t \"${ECR_REGISTRY}/${ECR_REPOS[$service]}:latest\" \\\n      -f \"${PROJECT_ROOT}/Dockerfile\" \\\n      \"${PROJECT_ROOT}\"\n  elif [[ \"$service\" == \"frontend\" ]]; then\n    local api_url=\"\"\n    if [[ \"$ENV\" == \"staging\" ]]; then\n      api_url=\"https://staging.talent-agent.seanyoung.biz/api/v1\"\n    elif [[ \"$ENV\" == \"prod\" ]]; then\n      api_url=\"https://talent-agent.seanyoung.biz/api/v1\"\n    fi\n\n    docker build \\\n      --build-arg VITE_API_URL=\"${api_url}\" \\\n      -t \"${image}\" \\\n      -t \"${ECR_REGISTRY}/${ECR_REPOS[$service]}:latest\" \\\n      -f \"${PROJECT_ROOT}/frontend/Dockerfile\" \\\n      \"${PROJECT_ROOT}/frontend\"\n  fi\n\n  ok \"Built ${service} → ${image}\"\n}\n\npush_image() {\n  local service=\"$1\"\n  local tag=\"$2\"\n  local image=\"${ECR_REGISTRY}/${ECR_REPOS[$service]}\"\n\n  log \"Pushing ${BOLD}${service}${RESET} images...\"\n  docker push \"${image}:${tag}\"\n  docker push \"${image}:latest\"\n  ok \"Pushed ${service}:${tag} + :latest\"\n}\n\n# ─── Deploy to ECS ───────────────────────────────────────────────────────────\n\ndeploy_ecs() {\n  local service=\"$1\"\n  local tag=\"$2\"\n  local ecs_service=\"${ECS_SERVICES[$service]}\"\n  local task_def=\"${TASK_DEFS[$service]}\"\n  local image=\"${ECR_REGISTRY}/${ECR_REPOS[$service]}:${tag}\"\n  local cluster=\"${ECS_CLUSTER}\"\n\n  # Add environment suffix for staging\n  if [[ \"$ENV\" == \"staging\" ]]; then\n    cluster=\"${ECS_CLUSTER}-staging\"\n    ecs_service=\"${ecs_service}-staging\"\n    task_def=\"${task_def}-staging\"\n  fi\n\n  log \"Deploying ${BOLD}${service}${RESET} to ECS...\"\n  log \"  Cluster:  ${cluster}\"\n  log \"  Service:  ${ecs_service}\"\n  log \"  Image:    ${image}\"\n\n  # Get current task definition\n  local current_task_def\n  current_task_def=$(aws ecs describe-task-definition \\\n    --task-definition \"${task_def}\" \\\n    --region \"${AWS_REGION}\" \\\n    --query 'taskDefinition' \\\n    --output json 2>/dev/null) || die \"Failed to fetch task definition: ${task_def}\"\n\n  # Update the image in the container definition\n  local new_task_def\n  new_task_def=$(echo \"$current_task_def\" | \\\n    jq --arg IMAGE \"$image\" \\\n    '.containerDefinitions[0].image = $IMAGE |\n     del(.taskDefinitionArn, .revision, .status, .requiresAttributes,\n         .compatibilities, .registeredAt, .registeredBy)')\n\n  # Register new task definition revision\n  local new_revision\n  new_revision=$(aws ecs register-task-definition \\\n    --region \"${AWS_REGION}\" \\\n    --cli-input-json \"$new_task_def\" \\\n    --query 'taskDefinition.taskDefinitionArn' \\\n    --output text) || die \"Failed to register new task definition\"\n\n  log \"  New task def: ${new_revision}\"\n\n  # Update the service to use the new task definition\n  aws ecs update-service \\\n    --region \"${AWS_REGION}\" \\\n    --cluster \"${cluster}\" \\\n    --service \"${ecs_service}\" \\\n    --task-definition \"${new_revision}\" \\\n    --force-new-deployment \\\n    --query 'service.serviceName' \\\n    --output text >/dev/null || die \"Failed to update ECS service\"\n\n  ok \"Deployment initiated for ${service} on ${cluster}\"\n\n  # Wait for service stability\n  log \"Waiting for ${service} to stabilize (timeout: 5m)...\"\n  if aws ecs wait services-stable \\\n    --region \"${AWS_REGION}\" \\\n    --cluster \"${cluster}\" \\\n    --services \"${ecs_service}\" 2>/dev/null; then\n    ok \"${service} is stable and running ✓\"\n  else\n    die \"${service} failed to stabilize — check ECS console\"\n  fi\n}\n\n# ─── Rollback ────────────────────────────────────────────────────────────────\n\nrollback_ecs() {\n  local service=\"$1\"\n  local ecs_service=\"${ECS_SERVICES[$service]}\"\n  local task_def=\"${TASK_DEFS[$service]}\"\n  local cluster=\"${ECS_CLUSTER}\"\n\n  if [[ \"$ENV\" == \"staging\" ]]; then\n    cluster=\"${ECS_CLUSTER}-staging\"\n    ecs_service=\"${ecs_service}-staging\"\n    task_def=\"${task_def}-staging\"\n  fi\n\n  warn \"Rolling back ${BOLD}${service}${RESET}...\"\n\n  # Get the previous task definition revision\n  local revisions\n  revisions=$(aws ecs list-task-definitions \\\n    --family-prefix \"${task_def}\" \\\n    --region \"${AWS_REGION}\" \\\n    --sort DESC \\\n    --query 'taskDefinitionArns[0:2]' \\\n    --output json)\n\n  local previous_revision\n  previous_revision=$(echo \"$revisions\" | jq -r '.[1] // empty')\n\n  if [[ -z \"$previous_revision\" ]]; then\n    die \"No previous revision found for ${task_def} — cannot rollback\"\n  fi\n\n  log \"Rolling back to: ${previous_revision}\"\n\n  aws ecs update-service \\\n    --region \"${AWS_REGION}\" \\\n    --cluster \"${cluster}\" \\\n    --service \"${ecs_service}\" \\\n    --task-definition \"${previous_revision}\" \\\n    --force-new-deployment \\\n    --query 'service.serviceName' \\\n    --output text >/dev/null || die \"Rollback failed\"\n\n  log \"Waiting for rollback to stabilize...\"\n  aws ecs wait services-stable \\\n    --region \"${AWS_REGION}\" \\\n    --cluster \"${cluster}\" \\\n    --services \"${ecs_service}\" 2>/dev/null\n\n  ok \"Rollback complete for ${service} ✓\"\n}\n\n# ─── Local Deploy (docker-compose) ──────────────────────────────────────────\n\ndeploy_local() {\n  log \"Running local deployment via docker-compose...\"\n  cd \"${PROJECT_ROOT}\"\n\n  docker-compose down --remove-orphans 2>/dev/null || true\n  docker-compose build\n  docker-compose up -d\n\n  log \"Waiting for services...\"\n  sleep 5\n\n  # Health check\n  for i in 1 2 3 4 5; do\n    if curl -sf http://localhost:8000/health >/dev/null 2>&1; then\n      ok \"Local deployment is healthy ✓\"\n      echo \"\"\n      log \"Services:\"\n      log \"  Backend:   http://localhost:8000\"\n      log \"  Frontend:  http://localhost:5173 (run 'cd frontend && npm run dev')\"\n      log \"  Postgres:  localhost:5432\"\n      log \"  Redis:     localhost:6379\"\n      echo \"\"\n      docker-compose ps\n      exit 0\n    fi\n    log \"Attempt $i — waiting...\"\n    sleep 3\n  done\n\n  warn \"Backend not responding yet — check logs with: docker-compose logs -f app\"\n}\n\n# ─── Run Database Migrations ─────────────────────────────────────────────────\n\nrun_migrations() {\n  local env=\"$1\"\n  log \"Running database migrations for ${env}...\"\n\n  if [[ \"$env\" == \"local\" ]]; then\n    docker-compose exec -T db psql -U talent_agent -d talent_agent \\\n      -f /docker-entrypoint-initdb.d/000_init.sql 2>/dev/null || true\n    docker-compose exec -T db psql -U talent_agent -d talent_agent \\\n      -f /docker-entrypoint-initdb.d/001_discovery.sql\n    docker-compose exec -T db psql -U talent_agent -d talent_agent \\\n      -f /docker-entrypoint-initdb.d/002_application.sql\n    docker-compose exec -T db psql -U talent_agent -d talent_agent \\\n      -f /docker-entrypoint-initdb.d/003_auth.sql\n  else\n    # For staging/prod, migrations run via the app's SQLAlchemy create_all\n    # or via a dedicated migration task\n    log \"Remote migrations handled by app startup (SQLAlchemy metadata.create_all)\"\n  fi\n\n  ok \"Migrations complete ✓\"\n}\n\n# ─── Main ────────────────────────────────────────────────────────────────────\n\nusage() {\n  echo \"\"\n  echo -e \"${BOLD}Usage:${RESET}\"\n  echo \"  ./deploy/deploy.sh <environment> [service] [image_tag|--rollback]\"\n  echo \"\"\n  echo -e \"${BOLD}Environments:${RESET}\"\n  echo \"  local     Docker Compose (development)\"\n  echo \"  staging   ECS Fargate staging cluster\"\n  echo \"  prod      ECS Fargate production cluster\"\n  echo \"\"\n  echo -e \"${BOLD}Services:${RESET}\"\n  echo \"  backend   FastAPI backend\"\n  echo \"  frontend  React frontend (Nginx)\"\n  echo \"  all       Both services\"\n  echo \"\"\n  echo -e \"${BOLD}Examples:${RESET}\"\n  echo \"  ./deploy/deploy.sh local                        # spin up local env\"\n  echo \"  ./deploy/deploy.sh local --migrate              # local + run migrations\"\n  echo \"  ./deploy/deploy.sh staging backend abc1234      # deploy specific tag\"\n  echo \"  ./deploy/deploy.sh staging all                  # deploy both, :latest\"\n  echo \"  ./deploy/deploy.sh prod backend --rollback      # rollback backend\"\n  echo \"  ./deploy/deploy.sh prod all abc1234             # deploy both to prod\"\n  echo \"\"\n  exit 1\n}\n\nmain() {\n  ENV=\"${1:-}\"\n  SERVICE=\"${2:-all}\"\n  TAG=\"${3:-$(get_git_sha)}\"\n\n  [[ -z \"$ENV\" ]] && usage\n\n  echo \"\"\n  echo -e \"${CYAN}╔══════════════════════════════════════════════════╗${RESET}\"\n  echo -e \"${CYAN}║${RESET}  ${BOLD}Talent Agent — Deployment${RESET}                        ${CYAN}║${RESET}\"\n  echo -e \"${CYAN}║${RESET}  VibeSpace LLC · Digital Dash Pipeline           ${CYAN}║${RESET}\"\n  echo -e \"${CYAN}╚══════════════════════════════════════════════════╝${RESET}\"\n  echo \"\"\n  log \"Environment: ${BOLD}${ENV}${RESET}\"\n  log \"Service:     ${BOLD}${SERVICE}${RESET}\"\n  log \"Tag:         ${BOLD}${TAG}${RESET}\"\n  log \"Timestamp:   $(get_timestamp)\"\n  log \"Git SHA:     $(get_git_sha)\"\n  echo \"\"\n\n  # ── Local deployment ───────────────────────────────────────────────────\n  if [[ \"$ENV\" == \"local\" ]]; then\n    require_cmd docker\n    require_cmd docker-compose\n\n    if [[ \"$SERVICE\" == \"--migrate\" || \"$TAG\" == \"--migrate\" ]]; then\n      deploy_local\n      run_migrations local\n    else\n      deploy_local\n    fi\n    exit 0\n  fi\n\n  # ── Cloud deployment (staging / prod) ──────────────────────────────────\n  require_cmd aws\n  require_cmd docker\n  require_cmd jq\n\n  [[ -z \"$AWS_ACCOUNT_ID\" ]] && die \"AWS_ACCOUNT_ID is not set. Export it or add to .env\"\n\n  # Rollback mode\n  if [[ \"$TAG\" == \"--rollback\" ]]; then\n    if [[ \"$SERVICE\" == \"all\" ]]; then\n      rollback_ecs backend\n      rollback_ecs frontend\n    else\n      rollback_ecs \"$SERVICE\"\n    fi\n    exit 0\n  fi\n\n  # Build + Push + Deploy\n  ecr_login\n\n  deploy_service() {\n    local svc=\"$1\"\n    build_image \"$svc\" \"$TAG\"\n    push_image \"$svc\" \"$TAG\"\n    deploy_ecs \"$svc\" \"$TAG\"\n  }\n\n  if [[ \"$SERVICE\" == \"all\" ]]; then\n    deploy_service backend\n    deploy_service frontend\n  else\n    [[ -z \"${ECS_SERVICES[$SERVICE]+_}\" ]] && die \"Unknown service: ${SERVICE}. Use: backend, frontend, all\"\n    deploy_service \"$SERVICE\"\n  fi\n\n  echo \"\"\n  ok \"═══════════════════════════════════════════════════\"\n  ok \"  Deployment complete! 🚀\"\n  ok \"  ${ENV} / ${SERVICE} / ${TAG}\"\n  ok \"═══════════════════════════════════════════════════\"\n  echo \"\"\n}\n\nmain \"$@\"\n","numLines":415,"startLine":1,"totalLines":415}}}}
{"t":"2026-05-20T20:15:12.147Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KSwcFcNnky3S3D6XDkfE8J","type":"tool_result","content":"     1→#!/usr/bin/env bash\n     2→# ╔══════════════════════════════════════════════════════════════════════════════╗\n     3→# ║  setup-aws.sh — One-time AWS infrastructure setup for Talent Agent         ║\n     4→# ║  VibeSpace LLC                                                             ║\n     5→# ║                                                                            ║\n     6→# ║  Run this ONCE to create all the AWS resources needed for deployment.      ║\n     7→# ║  After this, deploy.sh handles everything.                                 ║\n     8→# ║                                                                            ║\n     9→# ║  Prerequisites:                                                            ║\n    10→# ║    - AWS CLI configured with appropriate IAM permissions                   ║\n    11→# ║    - AWS_ACCOUNT_ID exported                                               ║\n    12→# ╚══════════════════════════════════════════════════════════════════════════════╝\n    13→\n    14→set -euo pipefail\n    15→\n    16→AWS_REGION=\"${AWS_REGION:-us-east-1}\"\n    17→AWS_ACCOUNT_ID=\"${AWS_ACCOUNT_ID:?'AWS_ACCOUNT_ID must be set'}\"\n    18→ECR_REGISTRY=\"${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com\"\n    19→\n    20→CYAN='\\033[0;36m'\n    21→GREEN='\\033[0;32m'\n    22→YELLOW='\\033[1;33m'\n    23→BOLD='\\033[1m'\n    24→RESET='\\033[0m'\n    25→\n    26→log()  { echo -e \"${CYAN}[setup]${RESET} $*\"; }\n    27→ok()   { echo -e \"${GREEN}[setup]${RESET} $*\"; }\n    28→warn() { echo -e \"${YELLOW}[setup]${RESET} $*\"; }\n    29→\n    30→echo \"\"\n    31→echo -e \"${CYAN}╔══════════════════════════════════════════════════╗${RESET}\"\n    32→echo -e \"${CYAN}║${RESET}  ${BOLD}Talent Agent — AWS Infrastructure Setup${RESET}        ${CYAN}║${RESET}\"\n    33→echo -e \"${CYAN}║${RESET}  VibeSpace LLC · One-time bootstrap              ${CYAN}║${RESET}\"\n    34→echo -e \"${CYAN}╚══════════════════════════════════════════════════╝${RESET}\"\n    35→echo \"\"\n    36→\n    37→# ── 1. ECR Repositories ──────────────────────────────────────────────────────\n    38→\n    39→log \"Creating ECR repositories...\"\n    40→\n    41→for repo in talent-agent-backend talent-agent-frontend; do\n    42→  if aws ecr describe-repositories --repository-names \"$repo\" --region \"$AWS_REGION\" >/dev/null 2>&1; then\n    43→    warn \"ECR repo '${repo}' already exists — skipping\"\n    44→  else\n    45→    aws ecr create-repository \\\n    46→      --repository-name \"$repo\" \\\n    47→      --region \"$AWS_REGION\" \\\n    48→      --image-scanning-configuration scanOnPush=true \\\n    49→      --encryption-configuration encryptionType=AES256 \\\n    50→      --query 'repository.repositoryUri' \\\n    51→      --output text\n    52→    ok \"Created ECR repo: ${repo}\"\n    53→  fi\n    54→done\n    55→\n    56→# Set lifecycle policy (keep last 10 images)\n    57→LIFECYCLE_POLICY='{\"rules\":[{\"rulePriority\":1,\"description\":\"Keep last 10 images\",\"selection\":{\"tagStatus\":\"any\",\"countType\":\"imageCountMoreThan\",\"countNumber\":10},\"action\":{\"type\":\"expire\"}}]}'\n    58→\n    59→for repo in talent-agent-backend talent-agent-frontend; do\n    60→  aws ecr put-lifecycle-policy \\\n    61→    --repository-name \"$repo\" \\\n    62→    --region \"$AWS_REGION\" \\\n    63→    --lifecycle-policy-text \"$LIFECYCLE_POLICY\" >/dev/null\n    64→done\n    65→ok \"ECR lifecycle policies set (keep last 10 images)\"\n    66→\n    67→# ── 2. CloudWatch Log Groups ─────────────────────────────────────────────────\n    68→\n    69→log \"Creating CloudWatch log groups...\"\n    70→\n    71→for group in /ecs/talent-agent-backend /ecs/talent-agent-frontend; do\n    72→  if aws logs describe-log-groups --log-group-name-prefix \"$group\" --region \"$AWS_REGION\" \\\n    73→    --query \"logGroups[?logGroupName=='${group}']\" --output text | grep -q \"$group\"; then\n    74→    warn \"Log group '${group}' already exists — skipping\"\n    75→  else\n    76→    aws logs create-log-group --log-group-name \"$group\" --region \"$AWS_REGION\"\n    77→    aws logs put-retention-policy --log-group-name \"$group\" --retention-in-days 30 --region \"$AWS_REGION\"\n    78→    ok \"Created log group: ${group} (30 day retention)\"\n    79→  fi\n    80→done\n    81→\n    82→# ── 3. ECS Cluster ───────────────────────────────────────────────────────────\n    83→\n    84→log \"Creating ECS clusters...\"\n    85→\n    86→for cluster in vibespace-prod vibespace-prod-staging; do\n    87→  if aws ecs describe-clusters --clusters \"$cluster\" --region \"$AWS_REGION\" \\\n    88→    --query \"clusters[?status=='ACTIVE'].clusterName\" --output text | grep -q \"$cluster\"; then\n    89→    warn \"ECS cluster '${cluster}' already exists — skipping\"\n    90→  else\n    91→    aws ecs create-cluster \\\n    92→      --cluster-name \"$cluster\" \\\n    93→      --region \"$AWS_REGION\" \\\n    94→      --capacity-providers FARGATE FARGATE_SPOT \\\n    95→      --default-capacity-provider-strategy \\\n    96→        capacityProvider=FARGATE,weight=1,base=1 \\\n    97→        capacityProvider=FARGATE_SPOT,weight=3 \\\n    98→      --query 'cluster.clusterName' \\\n    99→      --output text\n   100→    ok \"Created ECS cluster: ${cluster}\"\n   101→  fi\n   102→done\n   103→\n   104→# ── 4. Secrets Manager Placeholders ──────────────────────────────────────────\n   105→\n   106→log \"Creating Secrets Manager entries...\"\n   107→warn \"You'll need to update these with real values after creation.\"\n   108→\n   109→SECRETS=(\n   110→  \"talent-agent/database-url:postgresql+asyncpg://user:pass@host:5432/talent_agent\"\n   111→  \"talent-agent/redis-url:redis://host:6379/0\"\n   112→  \"talent-agent/anthropic-api-key:sk-ant-placeholder\"\n   113→  \"talent-agent/jwt-secret:change-me-in-production\"\n   114→  \"talent-agent/hunter-api-key:placeholder\"\n   115→)\n   116→\n   117→for entry in \"${SECRETS[@]}\"; do\n   118→  name=\"${entry%%:*}\"\n   119→  value=\"${entry#*:}\"\n   120→\n   121→  if aws secretsmanager describe-secret --secret-id \"$name\" --region \"$AWS_REGION\" >/dev/null 2>&1; then\n   122→    warn \"Secret '${name}' already exists — skipping\"\n   123→  else\n   124→    aws secretsmanager create-secret \\\n   125→      --name \"$name\" \\\n   126→      --region \"$AWS_REGION\" \\\n   127→      --secret-string \"$value\" \\\n   128→      --description \"Talent Agent - ${name}\" \\\n   129→      --query 'Name' --output text\n   130→    ok \"Created secret: ${name}\"\n   131→  fi\n   132→done\n   133→\n   134→# ── 5. Summary ───────────────────────────────────────────────────────────────\n   135→\n   136→echo \"\"\n   137→ok \"═══════════════════════════════════════════════════\"\n   138→ok \"  AWS infrastructure setup complete!\"\n   139→ok \"═══════════════════════════════════════════════════\"\n   140→echo \"\"\n   141→log \"Next steps:\"\n   142→echo \"  1. Update secrets in AWS Secrets Manager with real values:\"\n   143→echo \"     - talent-agent/database-url  (your RDS connection string)\"\n   144→echo \"     - talent-agent/redis-url     (your ElastiCache endpoint)\"\n   145→echo \"     - talent-agent/anthropic-api-key\"\n   146→echo \"     - talent-agent/jwt-secret    (generate a strong random string)\"\n   147→echo \"\"\n   148→echo \"  2. Create an RDS PostgreSQL 15 instance + ElastiCache Redis 7 cluster\"\n   149→echo \"     (if you haven't already)\"\n   150→echo \"\"\n   151→echo \"  3. Create an ALB with target groups for backend (:8000) and frontend (:80)\"\n   152→echo \"     - Route /api/* → backend target group\"\n   153→echo \"     - Route /*     → frontend target group\"\n   154→echo \"\"\n   155→echo \"  4. Register the ECS task definitions:\"\n   156→echo \"     aws ecs register-task-definition --cli-input-json file://deploy/ecs-task-def-backend.json\"\n   157→echo \"     aws ecs register-task-definition --cli-input-json file://deploy/ecs-task-def-frontend.json\"\n   158→echo \"\"\n   159→echo \"  5. Create the ECS services (after ALB + target groups are ready):\"\n   160→echo \"     aws ecs create-service --cluster vibespace-prod --service-name talent-agent-backend ...\"\n   161→echo \"     aws ecs create-service --cluster vibespace-prod --service-name talent-agent-frontend ...\"\n   162→echo \"\"\n   163→echo \"  6. Deploy:\"\n   164→echo \"     ./deploy/deploy.sh staging all\"\n   165→echo \"\"\n   166→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"896edb10-d5e4-4e2d-8d2d-7fe02bdd0dae","uuid":"3c22f829-e3a0-4bc3-91c0-68f6bbb4a9b8","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/deploy/setup-aws.sh","content":"#!/usr/bin/env bash\n# ╔══════════════════════════════════════════════════════════════════════════════╗\n# ║  setup-aws.sh — One-time AWS infrastructure setup for Talent Agent         ║\n# ║  VibeSpace LLC                                                             ║\n# ║                                                                            ║\n# ║  Run this ONCE to create all the AWS resources needed for deployment.      ║\n# ║  After this, deploy.sh handles everything.                                 ║\n# ║                                                                            ║\n# ║  Prerequisites:                                                            ║\n# ║    - AWS CLI configured with appropriate IAM permissions                   ║\n# ║    - AWS_ACCOUNT_ID exported                                               ║\n# ╚══════════════════════════════════════════════════════════════════════════════╝\n\nset -euo pipefail\n\nAWS_REGION=\"${AWS_REGION:-us-east-1}\"\nAWS_ACCOUNT_ID=\"${AWS_ACCOUNT_ID:?'AWS_ACCOUNT_ID must be set'}\"\nECR_REGISTRY=\"${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com\"\n\nCYAN='\\033[0;36m'\nGREEN='\\033[0;32m'\nYELLOW='\\033[1;33m'\nBOLD='\\033[1m'\nRESET='\\033[0m'\n\nlog()  { echo -e \"${CYAN}[setup]${RESET} $*\"; }\nok()   { echo -e \"${GREEN}[setup]${RESET} $*\"; }\nwarn() { echo -e \"${YELLOW}[setup]${RESET} $*\"; }\n\necho \"\"\necho -e \"${CYAN}╔══════════════════════════════════════════════════╗${RESET}\"\necho -e \"${CYAN}║${RESET}  ${BOLD}Talent Agent — AWS Infrastructure Setup${RESET}        ${CYAN}║${RESET}\"\necho -e \"${CYAN}║${RESET}  VibeSpace LLC · One-time bootstrap              ${CYAN}║${RESET}\"\necho -e \"${CYAN}╚══════════════════════════════════════════════════╝${RESET}\"\necho \"\"\n\n# ── 1. ECR Repositories ──────────────────────────────────────────────────────\n\nlog \"Creating ECR repositories...\"\n\nfor repo in talent-agent-backend talent-agent-frontend; do\n  if aws ecr describe-repositories --repository-names \"$repo\" --region \"$AWS_REGION\" >/dev/null 2>&1; then\n    warn \"ECR repo '${repo}' already exists — skipping\"\n  else\n    aws ecr create-repository \\\n      --repository-name \"$repo\" \\\n      --region \"$AWS_REGION\" \\\n      --image-scanning-configuration scanOnPush=true \\\n      --encryption-configuration encryptionType=AES256 \\\n      --query 'repository.repositoryUri' \\\n      --output text\n    ok \"Created ECR repo: ${repo}\"\n  fi\ndone\n\n# Set lifecycle policy (keep last 10 images)\nLIFECYCLE_POLICY='{\"rules\":[{\"rulePriority\":1,\"description\":\"Keep last 10 images\",\"selection\":{\"tagStatus\":\"any\",\"countType\":\"imageCountMoreThan\",\"countNumber\":10},\"action\":{\"type\":\"expire\"}}]}'\n\nfor repo in talent-agent-backend talent-agent-frontend; do\n  aws ecr put-lifecycle-policy \\\n    --repository-name \"$repo\" \\\n    --region \"$AWS_REGION\" \\\n    --lifecycle-policy-text \"$LIFECYCLE_POLICY\" >/dev/null\ndone\nok \"ECR lifecycle policies set (keep last 10 images)\"\n\n# ── 2. CloudWatch Log Groups ─────────────────────────────────────────────────\n\nlog \"Creating CloudWatch log groups...\"\n\nfor group in /ecs/talent-agent-backend /ecs/talent-agent-frontend; do\n  if aws logs describe-log-groups --log-group-name-prefix \"$group\" --region \"$AWS_REGION\" \\\n    --query \"logGroups[?logGroupName=='${group}']\" --output text | grep -q \"$group\"; then\n    warn \"Log group '${group}' already exists — skipping\"\n  else\n    aws logs create-log-group --log-group-name \"$group\" --region \"$AWS_REGION\"\n    aws logs put-retention-policy --log-group-name \"$group\" --retention-in-days 30 --region \"$AWS_REGION\"\n    ok \"Created log group: ${group} (30 day retention)\"\n  fi\ndone\n\n# ── 3. ECS Cluster ───────────────────────────────────────────────────────────\n\nlog \"Creating ECS clusters...\"\n\nfor cluster in vibespace-prod vibespace-prod-staging; do\n  if aws ecs describe-clusters --clusters \"$cluster\" --region \"$AWS_REGION\" \\\n    --query \"clusters[?status=='ACTIVE'].clusterName\" --output text | grep -q \"$cluster\"; then\n    warn \"ECS cluster '${cluster}' already exists — skipping\"\n  else\n    aws ecs create-cluster \\\n      --cluster-name \"$cluster\" \\\n      --region \"$AWS_REGION\" \\\n      --capacity-providers FARGATE FARGATE_SPOT \\\n      --default-capacity-provider-strategy \\\n        capacityProvider=FARGATE,weight=1,base=1 \\\n        capacityProvider=FARGATE_SPOT,weight=3 \\\n      --query 'cluster.clusterName' \\\n      --output text\n    ok \"Created ECS cluster: ${cluster}\"\n  fi\ndone\n\n# ── 4. Secrets Manager Placeholders ──────────────────────────────────────────\n\nlog \"Creating Secrets Manager entries...\"\nwarn \"You'll need to update these with real values after creation.\"\n\nSECRETS=(\n  \"talent-agent/database-url:postgresql+asyncpg://user:pass@host:5432/talent_agent\"\n  \"talent-agent/redis-url:redis://host:6379/0\"\n  \"talent-agent/anthropic-api-key:sk-ant-placeholder\"\n  \"talent-agent/jwt-secret:change-me-in-production\"\n  \"talent-agent/hunter-api-key:placeholder\"\n)\n\nfor entry in \"${SECRETS[@]}\"; do\n  name=\"${entry%%:*}\"\n  value=\"${entry#*:}\"\n\n  if aws secretsmanager describe-secret --secret-id \"$name\" --region \"$AWS_REGION\" >/dev/null 2>&1; then\n    warn \"Secret '${name}' already exists — skipping\"\n  else\n    aws secretsmanager create-secret \\\n      --name \"$name\" \\\n      --region \"$AWS_REGION\" \\\n      --secret-string \"$value\" \\\n      --description \"Talent Agent - ${name}\" \\\n      --query 'Name' --output text\n    ok \"Created secret: ${name}\"\n  fi\ndone\n\n# ── 5. Summary ───────────────────────────────────────────────────────────────\n\necho \"\"\nok \"═══════════════════════════════════════════════════\"\nok \"  AWS infrastructure setup complete!\"\nok \"═══════════════════════════════════════════════════\"\necho \"\"\nlog \"Next steps:\"\necho \"  1. Update secrets in AWS Secrets Manager with real values:\"\necho \"     - talent-agent/database-url  (your RDS connection string)\"\necho \"     - talent-agent/redis-url     (your ElastiCache endpoint)\"\necho \"     - talent-agent/anthropic-api-key\"\necho \"     - talent-agent/jwt-secret    (generate a strong random string)\"\necho \"\"\necho \"  2. Create an RDS PostgreSQL 15 instance + ElastiCache Redis 7 cluster\"\necho \"     (if you haven't already)\"\necho \"\"\necho \"  3. Create an ALB with target groups for backend (:8000) and frontend (:80)\"\necho \"     - Route /api/* → backend target group\"\necho \"     - Route /*     → frontend target group\"\necho \"\"\necho \"  4. Register the ECS task definitions:\"\necho \"     aws ecs register-task-definition --cli-input-json file://deploy/ecs-task-def-backend.json\"\necho \"     aws ecs register-task-definition --cli-input-json file://deploy/ecs-task-def-frontend.json\"\necho \"\"\necho \"  5. Create the ECS services (after ALB + target groups are ready):\"\necho \"     aws ecs create-service --cluster vibespace-prod --service-name talent-agent-backend ...\"\necho \"     aws ecs create-service --cluster vibespace-prod --service-name talent-agent-frontend ...\"\necho \"\"\necho \"  6. Deploy:\"\necho \"     ./deploy/deploy.sh staging all\"\necho \"\"\n","numLines":166,"startLine":1,"totalLines":166}}}}
