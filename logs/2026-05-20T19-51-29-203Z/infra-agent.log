smanager:us-east-1:${AWS_ACCOUNT_ID}:secret:talent-agent/jwt-secret\"\n        },\n        {\n          \"name\": \"HUNTER_API_KEY\",\n          \"valueFrom\": \"arn:aws:secretsmanager:us-east-1:${AWS_ACCOUNT_ID}:secret:talent-agent/hunter-api-key\"\n        },\n        {\n          \"name\": \"RESEND_API_KEY\",\n          \"valueFrom\": \"arn:aws:secretsmanager:us-east-1:${AWS_ACCOUNT_ID}:secret:talent-agent/resend-api-key\"\n        }\n      ],"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":1359,"cache_read_input_tokens":83660,"cache_creation":{"ephemeral_5m_input_tokens":1359,"ephemeral_1h_input_tokens":0},"output_tokens":864,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"896edb10-d5e4-4e2d-8d2d-7fe02bdd0dae","uuid":"46fd5456-de70-4f11-94f4-f2bc90fb8169"}}
