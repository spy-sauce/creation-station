\"\n    A discovered job with full scoring breakdown and reasoning.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.ScoredJob.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    discovered_job_id: UUID\n    candidate_id: UUID\n    score_breakdown: ScoreBreakdown\n    composite_score: int = Field(ge=0, le=100)\n    is_hot: bool = False\n    reasoning: str\n    scored_at: Optional[datetime] = None\n\n    # Denormalized job fields for digest display\n    title: str = \"\"\n    company: str = \"\"\n    location: Optional[str] = None\n    url: str = \"\"\n\n\n# ─── Daily Digest ─────────────────────────────────────────────────────────────\n\n\nclass DailyDigestSchema(BaseModel):\n    \"\"\"\n    Full daily digest — persisted to DB and published to Redis.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.DailyDigest.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    candidate_id: UUID\n    run_date: str = Field(description=\"ISO date: YYYY-MM-DD\")\n    top_picks: list[ScoredJobSchema] = Field(default_factory=list)\n    hot_picks: list[ScoredJobSchema] = Field(default_factory=list)\n    new_companies: list[str] = Field(default_factory=list)\n    total_jobs_discovered: int = 0\n    total_jobs_scored: int = 0\n    created_at: Optional[datetime] = None\n","structuredPatch":[{"oldStart":57,"oldLines":19,"newStart":57,"newLines":26,"lines":["     model_config = ConfigDict(from_attributes=True)"," ","     archetypes: list[str] = Field(default_factory=list)","+    archetype_tags: list[str] = Field(default_factory=list)  # Alias for agents","     leadership_level: str = Field(","         default=\"IC\",","         description=\"IC | Lead | Manager | Director | VP | C-Level\",","     )","-    technical_skills: list[str] = Field(default_factory=list)","+    technical_skills: dict[str, int] | list[str] = Field(default_factory=dict)","     soft_skills: list[str] = Field(default_factory=li