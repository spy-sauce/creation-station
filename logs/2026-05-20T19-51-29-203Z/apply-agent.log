n    50→\n    51→    Generated by IdentityProfiler — the foundation of the entire discovery run.\n    52→    Cached in Redis for 24h.\n    53→\n    54→    Matches NUTRIENTS.md DATA_CONTRACTS.IdentityProfile.\n    55→    \"\"\"\n    56→\n    57→    model_config = ConfigDict(from_attributes=True)\n    58→\n    59→    archetypes: list[str] = Field(default_factory=list)\n    60→    leadership_level: str = Field(\n    61→        default=\"IC\",\n    62→        description=\"IC | Lead | Manager | Director | VP | C-Level\",\n    63→    )\n    64→    technical_skills: list[str] = Field(default_factory=list)\n    65→    soft_skills: list[str] = Field(default_factory=list)\n    66→    industry_experience: list[str] = Field(default_factory=list)\n    67→    notable_achievements: list[str] = Field(default_factory=list)\n    68→    career_trajectory: str = \"\"\n    69→    ideal_role_description: str = \"\"\n    70→    signals: dict[str, str] = Field(default_factory=dict)\n    71→\n    72→\n    73→# ─── Search Manifest ─────────────────────────────────────────────────────────\n    74→\n    75→\n    76→class SearchManifestSchema(BaseModel):\n    77→    \"\"\"\n    78→    Search instructions derived from an IdentityProfile.\n    79→\n    80→    Matches NUTRIENTS.md DATA_CONTRACTS.SearchManifest.\n    81→    \"\"\"\n    82→\n    83→    model_config = ConfigDict(from_attributes=True)\n    84→\n    85→    target_titles: list[str] = Field(default_factory=list)\n    86→    keywords: list[str] = Field(default_factory=list)\n    87→    excluded_titles: list[str] = Field(default_factory=list)\n    88→    excluded_companies: list[str] = Field(default_factory=list)\n    89→    excluded_industries: list[str] = Field(default_factory=list)\n    90→    location_filters: list[str] = Field(default_factory=list)\n    91→    remote_preference: str = \"flexible\"\n    92→    min_compensation: Optional[int] = None\n    93→\n    94→\n    95→# ─── Discovered Job ───────────────────────────────────────────────────────────\n    96→\n    97→\n    98→class DiscoveredJobSchema(BaseModel):\n    99→    \"\"\"\n   100→    Raw job data from a crawl — before scoring.\n   101→\n   102→    Matches NUTRIENTS.md DATA_CONTRACTS.DiscoveredJob.\n   103→    \"\"\"\n   104→\n   105→    model_config = ConfigDict(from_attributes=True)\n   106→\n   107→    id: Optional[UUID] = None\n   108→    source: str\n   109→    source_id: str\n   110→    title: str\n   111→    company: str\n   112→    location: Optional[str] = None\n   113→    description: Optional[str] = None\n   114→    url: str\n   115→    posted_at: Optional[datetime] = None\n   116→    salary_min: Optional[int] = None\n   117→    salary_max: Optional[int] = None\n   118→    remote: bool = False\n   119→    crawled_at: Optional[datetime] = None\n   120→\n   121→\n   122→# ─── Score Breakdown ─────────────────────────────────────────────────────────\n   123→\n   124→\n   125→class ScoreBreakdown(BaseModel):\n   126→    \"\"\"\n   127→    Dimension-level score breakdown (0-100 per dimension).\n   128→\n   129→    Matches NUTRIENTS.md DATA_CONTRACTS.ScoreBreakdown.\n   130→    \"\"\"\n   131→\n   132→    model_config = ConfigDict(from_attributes=True)\n   133→\n   134→    technical_match: int = Field(ge=0, le=100)\n   135→    level_match: int = Field(ge=0, le=100)\n   136→    culture_match: int = Field(ge=0, le=100)\n   137→    industry_match: int = Field(ge=0, le=100)\n   138→    growth_potential: int = Field(ge=0, le=100)\n   139→    compensation_match: int = Field(ge=0, le=100)\n   140→\n   141→    @computed_field\n   142→    @property\n   143→    def composite(self) -> int:\n   144→        \"\"\"\n   145→        Weighted composite score.\n   146→\n   147→        Weights (sum to 100%):\n   148→          - technical_match: 30%\n   149→          - level_match: 20%\n   150→          - culture_match: 15%\n   151→          - industry_match: 15%\n   152→          - growth_potential: 10%\n   153→          - compensation_match: 10%\n   154→        \"\"\"\n   155→        return int(\n   156→            self.technical_match * 0.30\n   157→            + self.level_match * 0.20\n   158→            + self.culture_match * 0.15\n   159→            + self.industry_match * 0.15\n   160→            + self.growth_potential * 0.10\n   161→            + self.compensation_match * 0.10\n   162→        )\n   163→\n   164→\n   165→# ─── Scored Job ───────────────────────────────────────────────────────────────\n   166→\n   167→\n   168→class ScoredJobSchema(BaseModel):\n   169→    \"\"\"\n   170→    A discovered job with full scoring breakdown and reasoning.\n   171→\n   172→    Matches NUTRIENTS.md DATA_CONTRACTS.ScoredJob.\n   173→    \"\"\"\n   174→\n   175→    model_config = ConfigDict(from_attributes=True)\n   176→\n   177→    id: Optional[UUID] = None\n   178→    discovered_job_id: UUID\n   179→    candidate_id: UUID\n   180→    score_breakdown: ScoreBreakdown\n   181→    composite_score: int = Field(ge=0, le=100)\n   182→    is_hot: bool = False\n   183→    reasoning: str\n   184→    scored_at: Optional[datetime] = None\n   185→\n   186→    # Denormalized job fields for digest display\n   187→    title: str = \"\"\n   188→    company: str = \"\"\n   189→    location: Optional[str] = None\n   190→    url: str = \"\"\n   191→\n   192→\n   193→# ─── Daily Digest ─────────────────────────────────────────────────────────────\n   194→\n   195→\n   196→class DailyDigestSchema(BaseModel):\n   197→    \"\"\"\n   198→    Full daily digest — persisted to DB and published to Redis.\n   199→\n   200→    Matches NUTRIENTS.md DATA_CONTRACTS.DailyDigest.\n   201→    \"\"\"\n   202→\n   203→    model_config = ConfigDict(from_attributes=True)\n   204→\n   205→    id: Optional[UUID] = None\n   206→    candidate_id: UUID\n   207→    run_date: str = Field(description=\"ISO date: YYYY-MM-DD\")\n   208→    top_picks: list[ScoredJobSchema] = Field(default_factory=list)\n   209→    hot_picks: list[ScoredJobSchema] = Field(default_factory=list)\n   210→    new_companies: list[str] = Field(default_factory=list)\n   211→    total_jobs_discovered: int = 0\n   212→    total_jobs_scored: int = 0\n   213→    created_at: Optional[datetime] = None\n   214→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"deb7dcc2-71e5-4120-93c5-a6ba962cce9e","uuid":"1e28dce9-13fc-4527-aed9-37f1b36b2ad3","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/discovery/schemas.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nPydantic v2 schemas for the Discovery Engine.\n\nThese are the data contracts between agents — separate from ORM models.\nAligns with NUTRIENTS.md DATA_CONTRACTS.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import datetime\nfrom typing import Optional\nfrom uuid import UUID\n\nfrom pydantic import BaseModel, Field, ConfigDict, computed_field\n\n\n# ─── Candidate ────────────────────────────────────────────────────────────────\n\n\nclass CandidateSchema(BaseModel):\n    \"\"\"Full candidate profile used as input to the Discovery Engine.\"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: UUID\n    name: str\n    email: str\n    resume_text: str\n    linkedin_url: Optional[str] = None\n    github_url: Optional[str] = None\n    personal_context: Optional[str] = None\n    target_locations: list[str] = Field(default_factory=list)\n    remote_preference: str = \"flexible\"\n    min_compensation: Optional[int] = None\n    excluded_companies: list[str] = Field(default_factory=list)\n    excluded_industries: list[str] = Field(default_factory=list)\n    created_at: Optional[datetime] = None\n    updated_at: Optional[datetime] = None\n\n\n# ─── Identity Profile ─────────────────────────────────────────────────────────\n\n\nclass IdentityProfileSchema(BaseModel):\n    \"\"\"\n    Multi-dimensional identity model for a candidate.\n\n    Generated by IdentityProfiler — the foundation of the entire discovery run.\n    Cached in Redis for 24h.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.IdentityProfile.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    archetypes: list[str] = Field(default_factory=list)\n    leadership_level: str = Field(\n        default=\"IC\",\n        description=\"IC | Lead | Manager | Director | VP | C-Level\",\n    )\n    technical_skills: list[str] = Field(default_factory=list)\n    soft_skills: list[str] = Field(default_factory=list)\n    industry_experience: list[str] = Field(default_factory=list)\n    notable_achievements: list[str] = Field(default_factory=list)\n    career_trajectory: str = \"\"\n    ideal_role_description: str = \"\"\n    signals: dict[str, str] = Field(default_factory=dict)\n\n\n# ─── Search Manifest ─────────────────────────────────────────────────────────\n\n\nclass SearchManifestSchema(BaseModel):\n    \"\"\"\n    Search instructions derived from an IdentityProfile.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.SearchManifest.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    target_titles: list[str] = Field(default_factory=list)\n    keywords: list[str] = Field(default_factory=list)\n    excluded_titles: list[str] = Field(default_factory=list)\n    excluded_companies: list[str] = Field(default_factory=list)\n    excluded_industries: list[str] = Field(default_factory=list)\n    location_filters: list[str] = Field(default_factory=list)\n    remote_preference: str = \"flexible\"\n    min_compensation: Optional[int] = None\n\n\n# ─── Discovered Job ───────────────────────────────────────────────────────────\n\n\nclass DiscoveredJobSchema(BaseModel):\n    \"\"\"\n    Raw job data from a crawl — before scoring.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.DiscoveredJob.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    source: str\n    source_id: str\n    title: str\n    company: str\n    location: Optional[str] = None\n    description: Optional[str] = None\n    url: str\n    posted_at: Optional[datetime] = None\n    salary_min: Optional[int] = None\n    salary_max: Optional[int] = None\n    remote: bool = False\n    crawled_at: Optional[datetime] = None\n\n\n# ─── Score Breakdown ─────────────────────────────────────────────────────────\n\n\nclass ScoreBreakdown(BaseModel):\n    \"\"\"\n    Dimension-level score breakdown (0-100 per dimension).\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.ScoreBreakdown.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    technical_match: int = Field(ge=0, le=100)\n    level_match: int = Field(ge=0, le=100)\n    culture_match: int = Field(ge=0, le=100)\n    industry_match: int = Field(ge=0, le=100)\n    growth_potential: int = Field(ge=0, le=100)\n    compensation_match: int = Field(ge=0, le=100)\n\n    @computed_field\n    @property\n    def composite(self) -> int:\n        \"\"\"\n        Weighted composite score.\n\n        Weights (sum to 100%):\n          - technical_match: 30%\n          - level_match: 20%\n          - culture_match: 15%\n          - industry_match: 15%\n          - growth_potential: 10%\n          - compensation_match: 10%\n        \"\"\"\n        return int(\n            self.technical_match * 0.30\n            + self.level_match * 0.20\n            + self.culture_match * 0.15\n            + self.industry_match * 0.15\n            + self.growth_potential * 0.10\n            + self.compensation_match * 0.10\n        )\n\n\n# ─── Scored Job ───────────────────────────────────────────────────────────────\n\n\nclass ScoredJobSchema(BaseModel):\n    \"\"\"\n    A discovered job with full scoring breakdown and reasoning.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.ScoredJob.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    discovered_job_id: UUID\n    candidate_id: UUID\n    score_breakdown: ScoreBreakdown\n    composite_score: int = Field(ge=0, le=100)\n    is_hot: bool = False\n    reasoning: str\n    scored_at: Optional[datetime] = None\n\n    # Denormalized job fields for digest display\n    title: str = \"\"\n    company: str = \"\"\n    location: Optional[str] = None\n    url: str = \"\"\n\n\n# ─── Daily Digest ─────────────────────────────────────────────────────────────\n\n\nclass DailyDigestSchema(BaseModel):\n    \"\"\"\n    Full daily digest — persisted to DB and published to Redis.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.DailyDigest.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    candidate_id: UUID\n    run_date: str = Field(description=\"ISO date: YYYY-MM-DD\")\n    top_picks: list[ScoredJobSchema] = Field(default_factory=list)\n    hot_picks: list[ScoredJobSchema] = Field(default_factory=list)\n    new_companies: list[str] = Field(default_factory=list)\n    total_jobs_discovered: int = 0\n    total_jobs_scored: int = 0\n    created_at: Optional[datetime] = None\n","numLines":214,"startLine":1,"totalLines":214}}}}
{"t":"2026-05-20T20:08:20.198Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CPDKwUaFiucqx6sk7t6u8t","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Identity Profiler — transforms a raw candidate profile into a rich,\n     6→multi-dimensional identity model used by the rest of the Discovery Engine.\n     7→\n     8→Flow:\n     9→  1. Check Redis cache (TTL 24h) — return cached profile if fresh\n    10→  2. Parse resume + personal context with Claude\n    11→  3. Generate archetypes and identity dimensions via Claude\n    12→  4. Cache result in Redis\n    13→  5. Return IdentityProfileSchema\n    14→\"\"\"\n    15→\n    16→import json\n    17→import hashlib\n    18→\n    19→import redis.asyncio as aioredis\n    20→import structlog\n    21→from anthropic import AsyncAnthropic\n    22→from tenacity import retry, stop_after_attempt, wait_exponential\n    23→\n    24→from backend.agents.discovery.schemas import CandidateSchema, IdentityProfileSchema\n    25→\n    26→logger = structlog.get_logger(__name__)\n    27→\n    28→_CACHE_TTL = 86_400  # 24 hours\n    29→\n    30→\n    31→class IdentityProfiler:\n    32→    \"\"\"\n    33→    Builds a rich multi-dimensional identity model from a candidate profile.\n    34→\n    35→    Uses Claude to extract technical skills, leadership level, domain expertise,\n    36→    and generate archetypes for role matching.\n    37→    \"\"\"\n    38→\n    39→    def __init__(self, redis_client: aioredis.Redis, anthropic_client: AsyncAnthropic):\n    40→        \"\"\"\n    41→        Initialize the IdentityProfiler.\n    42→\n    43→        Args:\n    44→            redis_client: Async Redis client for caching\n    45→            anthropic_client: Async Anthropic client for Claude API\n    46→        \"\"\"\n    47→        self._redis = redis_client\n    48→        self._claude = anthropic_client\n    49→\n    50→    def _cache_key(self, candidate: CandidateSchema) -> str:\n    51→        \"\"\"\n    52→        Derive a cache key from the candidate's data hash.\n    53→\n    54→        Content hash ensures stale profiles auto-invalidate when resume changes.\n    55→        \"\"\"\n    56→        content = f\"{candidate.resume_text}{candidate.personal_context or ''}\"\n    57→        content_hash = hashlib.sha256(content.encode()).hexdigest()[:16]\n    58→        return f\"profile:candidate:{candidate.id}:{content_hash}\"\n    59→\n    60→    async def build_profile(self, candidate: CandidateSchema) -> IdentityProfileSchema:\n    61→        \"\"\"\n    62→        Build or retrieve cached identity profile for a candidate.\n    63→\n    64→        Args:\n    65→            candidate: Full candidate schema\n    66→\n    67→        Returns:\n    68→            IdentityProfileSchema with all dimensions populated\n    69→        \"\"\"\n    70→        cache_key = self._cache_key(candidate)\n    71→\n    72→        # Check cache first\n    73→        cached = await self._redis.get(cache_key)\n    74→        if cached:\n    75→            logger.info(\"identity_profiler.cache_hit\", candidate_id=str(candidate.id))\n    76→            return IdentityProfileSchema.model_validate_json(cached)\n    77→\n    78→        logger.info(\"identity_profiler.generating\", candidate_id=str(candidate.id))\n    79→        profile = await self._generate_profile(candidate)\n    80→\n    81→        # Cache the result\n    82→        await self._redis.setex(cache_key, _CACHE_TTL, profile.model_dump_json())\n    83→        logger.info(\n    84→            \"identity_profiler.cached\",\n    85→            candidate_id=str(candidate.id),\n    86→            archetypes=len(profile.archetypes),\n    87→        )\n    88→        return profile\n    89→\n    90→    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n    91→    async def _generate_profile(self, candidate: CandidateSchema) -> IdentityProfileSchema:\n    92→        \"\"\"Call Claude to extract identity dimensions and generate archetypes.\"\"\"\n    93→        prompt = self._build_prompt(candidate)\n    94→\n    95→        response = await self._claude.messages.create(\n    96→            model=\"claude-sonnet-4-20250514\",\n    97→            max_tokens=4096,\n    98→            messages=[{\"role\": \"user\", \"content\": prompt}],\n    99→        )\n   100→\n   101→        raw = response.content[0].text\n   102→        logger.info(\n   103→            \"identity_profiler.claude_response\",\n   104→            candidate_id=str(candidate.id),\n   105→            tokens_used=response.usage.output_tokens,\n   106→        )\n   107→\n   108→        return self._parse_response(raw)\n   109→\n   110→    def _build_prompt(self, candidate: CandidateSchema) -> str:\n   111→        \"\"\"Construct the Claude prompt for identity extraction.\"\"\"\n   112→        excluded = {\n   113→            \"companies\": candidate.excluded_companies,\n   114→            \"industries\": candidate.excluded_industries,\n   115→        }\n   116→        return f\"\"\"You are building a rich identity model for a talent agent system.\n   117→\n   118→Analyze this candidate and return a JSON object with the exact structure specified below.\n   119→\n   120→# CANDIDATE DATA\n   121→\n   122→Name: {candidate.name}\n   123→Remote Preference: {candidate.remote_preference}\n   124→Min Compensation: {candidate.min_compensation or \"Not specified\"}\n   125→Target Locations: {\", \".join(candidate.target_locations) or \"Flexible\"}\n   126→Excluded: {json.dumps(excluded)}\n   127→\n   128→## Resume\n   129→{candidate.resume_text}\n   130→\n   131→## Personal Context\n   132→{candidate.personal_context or \"Not provided\"}\n   133→\n   134→# INSTRUCTIONS\n   135→\n   136→Return ONLY valid JSON matching this exact schema. No markdown, no explanation:\n   137→\n   138→{{\n   139→  \"archetypes\": [\n   140→    \"<archetype_1>\",\n   141→    \"<archetype_2>\"\n   142→  ],\n   143→  \"leadership_level\": \"<IC|Lead|Manager|Director|VP|C-Level>\",\n   144→  \"technical_skills\": [\"<skill_1>\", \"<skill_2>\"],\n   145→  \"soft_skills\": [\"<skill_1>\", \"<skill_2>\"],\n   146→  \"industry_experience\": [\"<industry_1>\", \"<industry_2>\"],\n   147→  \"notable_achievements\": [\"<achievement_1>\", \"<achievement_2>\"],\n   148→  \"career_trajectory\": \"<one sentence describing career arc>\",\n   149→  \"ideal_role_description\": \"<one sentence describing ideal next role>\",\n   150→  \"signals\": {{\n   151→    \"startup_vs_enterprise\": \"<startup|enterprise|both>\",\n   152→    \"remote_preference\": \"<remote|hybrid|onsite|flexible>\",\n   153→    \"mission_vs_comp\": \"<mission|comp|balanced>\"\n   154→  }}\n   155→}}\n   156→\n   157→# RULES FOR archetypes\n   158→- Generate 15–20 non-obvious role archetypes beyond the candidate's current title\n   159→- Think: what roles would a headhunter NOT suggest but should?\n   160→- Include VP/director-level if seniority warrants\n   161→- Include cross-functional roles (e.g., DevRel, Technical PM, CTO, AI Creative Director)\n   162→- Include roles at the intersection of their technical + creative identity\n   163→- Do NOT include roles clearly below their level\n   164→- Do NOT include roles in their excluded_industries\n   165→\n   166→# CRITICAL RULES\n   167→- NEVER fabricate skills not evidenced in the resume\n   168→- Extract ONLY skills explicitly mentioned or clearly demonstrated\n   169→- Be conservative with leadership_level — evidence must be clear\n   170→\"\"\"\n   171→\n   172→    def _parse_response(self, raw: str) -> IdentityProfileSchema:\n   173→        \"\"\"Parse Claude's JSON response into an IdentityProfileSchema.\"\"\"\n   174→        import re\n   175→\n   176→        try:\n   177→            data = json.loads(raw.strip())\n   178→        except json.JSONDecodeError:\n   179→            # Attempt to extract JSON block if Claude included surrounding text\n   180→            match = re.search(r\"\\{.*\\}\", raw, re.DOTALL)\n   181→            if not match:\n   182→                raise ValueError(f\"Claude returned non-JSON response: {raw[:200]}\")\n   183→            data = json.loads(match.group())\n   184→\n   185→        return IdentityProfileSchema(\n   186→            archetypes=data.get(\"archetypes\", []),\n   187→            leadership_level=data.get(\"leadership_level\", \"IC\"),\n   188→            technical_skills=data.get(\"technical_skills\", []),\n   189→            soft_skills=data.get(\"soft_skills\", []),\n   190→            industry_experience=data.get(\"industry_experience\", []),\n   191→            notable_achievements=data.get(\"notable_achievements\", []),\n   192→            career_trajectory=data.get(\"career_trajectory\", \"\"),\n   193→            ideal_role_description=data.get(\"ideal_role_description\", \"\"),\n   194→            signals=data.get(\"signals\", {}),\n   195→        )\n   196→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"deb7dcc2-71e5-4120-93c5-a6ba962cce9e","uuid":"a6578048-d6ef-4e5e-a7f4-b9acc4273140","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/discovery/identity_profiler.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nIdentity Profiler — transforms a raw candidate profile into a rich,\nmulti-dimensional identity model used by the rest of the Discovery Engine.\n\nFlow:\n  1. Check Redis cache (TTL 24h) — return cached profile if fresh\n  2. Parse resume + personal context with Claude\n  3. Generate archetypes and identity dimensions via Claude\n  4. Cache result in Redis\n  5. Return IdentityProfileSchema\n\"\"\"\n\nimport json\nimport hashlib\n\nimport redis.asyncio as aioredis\nimport structlog\nfrom anthropic import AsyncAnthropic\nfrom tenacity import retry, stop_after_attempt, wait_exponential\n\nfrom backend.agents.discovery.schemas import CandidateSchema, IdentityProfileSchema\n\nlogger = structlog.get_logger(__name__)\n\n_CACHE_TTL = 86_400  # 24 hours\n\n\nclass IdentityProfiler:\n    \"\"\"\n    Builds a rich multi-dimensional identity model from a candidate profile.\n\n    Uses Claude to extract technical skills, leadership level, domain expertise,\n    and generate archetypes for role matching.\n    \"\"\"\n\n    def __init__(self, redis_client: aioredis.Redis, anthropic_client: AsyncAnthropic):\n        \"\"\"\n        Initialize the IdentityProfiler.\n\n        Args:\n            redis_client: Async Redis client for caching\n            anthropic_client: Async Anthropic client for Claude API\n        \"\"\"\n        self._redis = redis_client\n        self._claude = anthropic_client\n\n    def _cache_key(self, candidate: CandidateSchema) -> str:\n        \"\"\"\n        Derive a cache key from the candidate's data hash.\n\n        Content hash ensures stale profiles auto-invalidate when resume changes.\n        \"\"\"\n        content = f\"{candidate.resume_text}{candidate.personal_context or ''}\"\n        content_hash = hashlib.sha256(content.encode()).hexdigest()[:16]\n        return f\"profile:candidate:{candidate.id}:{content_hash}\"\n\n    async def build_profile(self, candidate: CandidateSchema) -> IdentityProfileSchema:\n        \"\"\"\n        Build or retrieve cached identity profile for a candidate.\n\n        Args:\n            candidate: Full candidate schema\n\n        Returns:\n            IdentityProfileSchema with all dimensions populated\n        \"\"\"\n        cache_key = self._cache_key(candidate)\n\n        # Check cache first\n        cached = await self._redis.get(cache_key)\n        if cached:\n            logger.info(\"identity_profiler.cache_hit\", candidate_id=str(candidate.id))\n            return IdentityProfileSchema.model_validate_json(cached)\n\n        logger.info(\"identity_profiler.generating\", candidate_id=str(candidate.id))\n        profile = await self._generate_profile(candidate)\n\n        # Cache the result\n        await self._redis.setex(cache_key, _CACHE_TTL, profile.model_dump_json())\n        logger.info(\n            \"identity_profiler.cached\",\n            candidate_id=str(candidate.id),\n            archetypes=len(profile.archetypes),\n        )\n        return profile\n\n    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n    async def _generate_profile(self, candidate: CandidateSchema) -> IdentityProfileSchema:\n        \"\"\"Call Claude to extract identity dimensions and generate archetypes.\"\"\"\n        prompt = self._build_prompt(candidate)\n\n        response = await self._claude.messages.create(\n            model=\"claude-sonnet-4-20250514\",\n            max_tokens=4096,\n            messages=[{\"role\": \"user\", \"content\": prompt}],\n        )\n\n        raw = response.content[0].text\n        logger.info(\n            \"identity_profiler.claude_response\",\n            candidate_id=str(candidate.id),\n            tokens_used=response.usage.output_tokens,\n        )\n\n        return self._parse_response(raw)\n\n    def _build_prompt(self, candidate: CandidateSchema) -> str:\n        \"\"\"Construct the Claude prompt for identity extraction.\"\"\"\n        excluded = {\n            \"companies\": candidate.excluded_companies,\n            \"industries\": candidate.excluded_industries,\n        }\n        return f\"\"\"You are building a rich identity model for a talent agent system.\n\nAnalyze this candidate and return a JSON object with the exact structure specified below.\n\n# CANDIDATE DATA\n\nName: {candidate.name}\nRemote Preference: {candidate.remote_preference}\nMin Compensation: {candidate.min_compensation or \"Not specified\"}\nTarget Locations: {\", \".join(candidate.target_locations) or \"Flexible\"}\nExcluded: {json.dumps(excluded)}\n\n## Resume\n{candidate.resume_text}\n\n## Personal Context\n{candidate.personal_context or \"Not provided\"}\n\n# INSTRUCTIONS\n\nReturn ONLY valid JSON matching this exact schema. No markdown, no explanation:\n\n{{\n  \"archetypes\": [\n    \"<archetype_1>\",\n    \"<archetype_2>\"\n  ],\n  \"leadership_level\": \"<IC|Lead|Manager|Director|VP|C-Level>\",\n  \"technical_skills\": [\"<skill_1>\", \"<skill_2>\"],\n  \"soft_skills\": [\"<skill_1>\", \"<skill_2>\"],\n  \"industry_experience\": [\"<industry_1>\", \"<industry_2>\"],\n  \"notable_achievements\": [\"<achievement_1>\", \"<achievement_2>\"],\n  \"career_trajectory\": \"<one sentence describing career arc>\",\n  \"ideal_role_description\": \"<one sentence describing ideal next role>\",\n  \"signals\": {{\n    \"startup_vs_enterprise\": \"<startup|enterprise|both>\",\n    \"remote_preference\": \"<remote|hybrid|onsite|flexible>\",\n    \"mission_vs_comp\": \"<mission|comp|balanced>\"\n  }}\n}}\n\n# RULES FOR archetypes\n- Generate 15–20 non-obvious role archetypes beyond the candidate's current title\n- Think: what roles would a headhunter NOT suggest but should?\n- Include VP/director-level if seniority warrants\n- Include cross-functional roles (e.g., DevRel, Technical PM, CTO, AI Creative Director)\n- Include roles at the intersection of their technical + creative identity\n- Do NOT include roles clearly below their level\n- Do NOT include roles in their excluded_industries\n\n# CRITICAL RULES\n- NEVER fabricate skills not evidenced in the resume\n- Extract ONLY skills explicitly mentioned or clearly demonstrated\n- Be conservative with leadership_level — evidence must be clear\n\"\"\"\n\n    def _parse_response(self, raw: str) -> IdentityProfileSchema:\n        \"\"\"Parse Claude's JSON response into an IdentityProfileSchema.\"\"\"\n        import re\n\n        try:\n            data = json.loads(raw.strip())\n        except json.JSONDecodeError:\n            # Attempt to extract JSON block if Claude included surrounding text\n            match = re.search(r\"\\{.*\\}\", raw, re.DOTALL)\n            if not match:\n                raise ValueError(f\"Claude returned non-JSON response: {raw[:200]}\")\n            data = json.loads(match.group())\n\n        return IdentityProfileSchema(\n            archetypes=data.get(\"archetypes\", []),\n            leadership_level=data.get(\"leadership_level\", \"IC\"),\n            technical_skills=data.get(\"technical_skills\", []),\n            soft_skills=data.get(\"soft_skills\", []),\n            industry_experience=data.get(\"industry_experience\", []),\n            notable_achievements=data.get(\"notable_achievements\", []),\n            career_trajectory=data.get(\"career_trajectory\", \"\"),\n            ideal_role_description=data.get(\"ideal_role_description\", \"\"),\n            signals=data.get(\"signals\", {}),\n        )\n","numLines":196,"startLine":1,"totalLines":196}}}}
