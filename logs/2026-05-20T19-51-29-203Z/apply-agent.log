n    50→\n    51→    Generated by IdentityProfiler — the foundation of the entire discovery run.\n    52→    Cached in Redis for 24h.\n    53→\n    54→    Matches NUTRIENTS.md DATA_CONTRACTS.IdentityProfile.\n    55→    \"\"\"\n    56→\n    57→    model_config = ConfigDict(from_attributes=True)\n    58→\n    59→    archetypes: list[str] = Field(default_factory=list)\n    60→    leadership_level: str = Field(\n    61→        default=\"IC\",\n    62→        description=\"IC | Lead | Manager | Director | VP | C-Level\",\n    63→    )\n    64→    technical_skills: list[str] = Field(default_factory=list)\n    65→    soft_skills: list[str] = Field(default_factory=list)\n    66→    industry_experience: list[str] = Field(default_factory=list)\n    67→    notable_achievements: list[str] = Field(default_factory=list)\n    68→    career_trajectory: str = \"\"\n    69→    ideal_role_description: str = \"\"\n    70→    signals: dict[str, str] = Field(default_factory=dict)\n    71→\n    72→\n    73→# ─── Search Manifest ─────────────────────────────────────────────────────────\n    74→\n    75→\n    76→class SearchManifestSchema(BaseModel):\n    77→    \"\"\"\n    78→    Search instructions derived from an IdentityProfile.\n    79→\n    80→    Matches NUTRIENTS.md DATA_CONTRACTS.SearchManifest.\n    81→    \"\"\"\n    82→\n    83→    model_config = ConfigDict(from_attributes=True)\n    84→\n    85→    target_titles: list[str] = Field(default_factory=list)\n    86→    keywords: list[str] = Field(default_factory=list)\n    87→    excluded_titles: list[str] = Field(default_factory=list)\n    88→    excluded_companies: list[str] = Field(default_factory=list)\n    89→    excluded_industries: list[str] = Field(default_factory=list)\n    90→    location_filters: list[str] = Field(default_factory=list)\n    91→    remote_preference: str = \"flexible\"\n    92→    min_compensation: Optional[int] = None\n    93→\n    94→\n    95→# ─── Discovered Job ───────────────────────────────────────────────────────────\n    96→\n    97→\n    98→class DiscoveredJobSchema(BaseModel):\n    99→    \"\"\"\n   100→    Raw job data from a crawl — before scoring.\n   101→\n   102→    Matches NUTRIENTS.md DATA_CONTRACTS.DiscoveredJob.\n   103→    \"\"\"\n   104→\n   105→    model_config = ConfigDict(from_attributes=True)\n   106→\n   107→    id: Optional[UUID] = None\n   108→    source: str\n   109→    source_id: str\n   110→    title: str\n   111→    company: str\n   112→    location: Optional[str] = None\n   113→    description: Optional[str] = None\n   114→    url: str\n   115→    posted_at: Optional[datetime] = None\n   116→    salary_min: Optional[int] = None\n   117→    salary_max: Optional[int] = None\n   118→    remote: bool = False\n   119→    crawled_at: Optional[datetime] = None\n   120→\n   121→\n   122→# ─── Score Breakdown ─────────────────────────────────────────────────────────\n   123→\n   124→\n   125→class ScoreBreakdown(BaseModel):\n   126→    \"\"\"\n   127→    Dimension-level score breakdown (0-100 per dimension).\n   128→\n   129→    Matches NUTRIENTS.md DATA_CONTRACTS.ScoreBreakdown.\n   130→    \"\"\"\n   131→\n   132→    model_config = ConfigDict(from_attributes=True)\n   133→\n   134→    technical_match: int = Field(ge=0, le=100)\n   135→    level_match: int = Field(ge=0, le=100)\n   136→    culture_match: int = Field(ge=0, le=100)\n   137→    industry_match: int = Field(ge=0, le=100)\n   138→    growth_potential: int = Field(ge=0, le=100)\n   139→    compensation_match: int = Field(ge=0, le=100)\n   140→\n   141→    @computed_field\n   142→    @property\n   143→    def composite(self) -> int:\n   144→        \"\"\"\n   145→        Weighted composite score.\n   146→\n   147→        Weights (sum to 100%):\n   148→          - technical_match: 30%\n   149→          - level_match: 20%\n   150→          - culture_match: 15%\n   151→          - industry_match: 15%\n   152→          - growth_potential: 10%\n   153→          - compensation_match: 10%\n   154→        \"\"\"\n   155→        return int(\n   156→            self.technical_match * 0.30\n   157→            + self.level_match * 0.20\n   158→            + self.culture_match * 0.15\n   159→            + self.industry_match * 0.15\n   160→            + self.growth_potential * 0.10\n   161→            + self.compensation_match * 0.10\n   162→        )\n   163→\n   164→\n   165→# ─── Scored Job ───────────────────────────────────────────────────────────────\n   166→\n   167→\n   168→class ScoredJobSchema(BaseModel):\n   169→    \"\"\"\n   170→    A discovered job with full scoring breakdown and reasoning.\n   171→\n   172→    Matches NUTRIENTS.md DATA_CONTRACTS.ScoredJob.\n   173→    \"\"\"\n   174→\n   175→    model_config = ConfigDict(from_attributes=True)\n   176→\n   177→    id: Optional[UUID] = None\n   178→    discovered_job_id: UUID\n   179→    candidate_id: UUID\n   180→    score_breakdown: ScoreBreakdown\n   181→    composite_score: int = Field(ge=0, le=100)\n   182→    is_hot: bool = False\n   183→    reasoning: str\n   184→    scored_at: Optional[datetime] = None\n   185→\n   186→    # Denormalized job fields for digest display\n   187→    title: str = \"\"\n   188→    company: str = \"\"\n   189→    location: Optional[str] = None\n   190→    url: str = \"\"\n   191→\n   192→\n   193→# ─── Daily Digest ─────────────────────────────────────────────────────────────\n   194→\n   195→\n   196→class DailyDigestSchema(BaseModel):\n   197→    \"\"\"\n   198→    Full daily digest — persisted to DB and published to Redis.\n   199→\n   200→    Matches NUTRIENTS.md DATA_CONTRACTS.DailyDigest.\n   201→    \"\"\"\n   202→\n   203→    model_config = ConfigDict(from_attributes=True)\n   204→\n   205→    id: Optional[UUID] = None\n   206→    candidate_id: UUID\n   207→    run_date: str = Field(description=\"ISO date: YYYY-MM-DD\")\n   208→    top_picks: list[ScoredJobSchema] = Field(default_factory=list)\n   209→    hot_picks: list[ScoredJobSchema] = Field(default_factory=list)\n   210→    new_companies: list[str] = Field(default_factory=list)\n   211→    total_jobs_discovered: int = 0\n   212→    total_jobs_scored: int = 0\n   213→    created_at: Optional[datetime] = None\n   214→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"deb7dcc2-71e5-4120-93c5-a6ba962cce9e","uuid":"7655b3c6-9e6e-44fa-8594-62089084e164","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/discovery/schemas.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nPydantic v2 schemas for the Discovery Engine.\n\nThese are the data contracts between agents — separate from ORM models.\nAligns with NUTRIENTS.md DATA_CONTRACTS.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import datetime\nfrom typing import Optional\nfrom uuid import UUID\n\nfrom pydantic import BaseModel, Field, ConfigDict, computed_field\n\n\n# ─── Candidate ────────────────────────────────────────────────────────────────\n\n\nclass CandidateSchema(BaseModel):\n    \"\"\"Full candidate profile used as input to the Discovery Engine.\"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: UUID\n    name: str\n    email: str\n    resume_text: str\n    linkedin_url: Optional[str] = None\n    github_url: Optional[str] = None\n    personal_context: Optional[str] = None\n    target_locations: list[str] = Field(default_factory=list)\n    remote_preference: str = \"flexible\"\n    min_compensation: Optional[int] = None\n    excluded_companies: list[str] = Field(default_factory=list)\n    excluded_industries: list[str] = Field(default_factory=list)\n    created_at: Optional[datetime] = None\n    updated_at: Optional[datetime] = None\n\n\n# ─── Identity Profile ─────────────────────────────────────────────────────────\n\n\nclass IdentityProfileSchema(BaseModel):\n    \"\"\"\n    Multi-dimensional identity model for a candidate.\n\n    Generated by IdentityProfiler — the foundation of the entire discovery run.\n    Cached in Redis for 24h.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.IdentityProfile.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    archetypes: list[str] = Field(default_factory=list)\n    leadership_level: str = Field(\n        default=\"IC\",\n        description=\"IC | Lead | Manager | Director | VP | C-Level\",\n    )\n    technical_skills: list[str] = Field(default_factory=list)\n    soft_skills: list[str] = Field(default_factory=list)\n    industry_experience: list[str] = Field(default_factory=list)\n    notable_achievements: list[str] = Field(default_factory=list)\n    career_trajectory: str = \"\"\n    ideal_role_description: str = \"\"\n    signals: dict[str, str] = Field(default_factory=dict)\n\n\n# ─── Search Manifest ─────────────────────────────────────────────────────────\n\n\nclass SearchManifestSchema(BaseModel):\n    \"\"\"\n    Search instructions derived from an IdentityProfile.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.SearchManifest.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    target_titles: list[str] = Field(default_factory=list)\n    keywords: list[str] = Field(default_factory=list)\n    excluded_titles: list[str] = Field(default_factory=list)\n    excluded_companies: list[str] = Field(default_factory=list)\n    excluded_industries: list[str] = Field(default_factory=list)\n    location_filters: list[str] = Field(default_factory=list)\n    remote_preference: str = \"flexible\"\n    min_compensation: Optional[int] = None\n\n\n# ─── Discovered Job ───────────────────────────────────────────────────────────\n\n\nclass DiscoveredJobSchema(BaseModel):\n    \"\"\"\n    Raw job data from a crawl — before scoring.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.DiscoveredJob.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    source: str\n    source_id: str\n    title: str\n    company: str\n    location: Optional[str] = None\n    description: Optional[str] = None\n    url: str\n    posted_at: Optional[datetime] = None\n    salary_min: Optional[int] = None\n    salary_max: Optional[int] = None\n    remote: bool = False\n    crawled_at: Optional[datetime] = None\n\n\n# ─── Score Breakdown ─────────────────────────────────────────────────────────\n\n\nclass ScoreBreakdown(BaseModel):\n    \"\"\"\n    Dimension-level score breakdown (0-100 per dimension).\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.ScoreBreakdown.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    technical_match: int = Field(ge=0, le=100)\n    level_match: int = Field(ge=0, le=100)\n    culture_match: int = Field(ge=0, le=100)\n    industry_match: int = Field(ge=0, le=100)\n    growth_potential: int = Field(ge=0, le=100)\n    compensation_match: int = Field(ge=0, le=100)\n\n    @computed_field\n    @property\n    def composite(self) -> int:\n        \"\"\"\n        Weighted composite score.\n\n        Weights (sum to 100%):\n          - technical_match: 30%\n          - level_match: 20%\n          - culture_match: 15%\n          - industry_match: 15%\n          - growth_potential: 10%\n          - compensation_match: 10%\n        \"\"\"\n        return int(\n            self.technical_match * 0.30\n            + self.level_match * 0.20\n            + self.culture_match * 0.15\n            + self.industry_match * 0.15\n            + self.growth_potential * 0.10\n            + self.compensation_match * 0.10\n        )\n\n\n# ─── Scored Job ───────────────────────────────────────────────────────────────\n\n\nclass ScoredJobSchema(BaseModel):\n    \"\"\"\n    A discovered job with full scoring breakdown and reasoning.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.ScoredJob.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    discovered_job_id: UUID\n    candidate_id: UUID\n    score_breakdown: ScoreBreakdown\n    composite_score: int = Field(ge=0, le=100)\n    is_hot: bool = False\n    reasoning: str\n    scored_at: Optional[datetime] = None\n\n    # Denormalized job fields for digest display\n    title: str = \"\"\n    company: str = \"\"\n    location: Optional[str] = None\n    url: str = \"\"\n\n\n# ─── Daily Digest ─────────────────────────────────────────────────────────────\n\n\nclass DailyDigestSchema(BaseModel):\n    \"\"\"\n    Full daily digest — persisted to DB and published to Redis.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.DailyDigest.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    candidate_id: UUID\n    run_date: str = Field(description=\"ISO date: YYYY-MM-DD\")\n    top_picks: list[ScoredJobSchema] = Field(default_factory=list)\n    hot_picks: list[ScoredJobSchema] = Field(default_factory=list)\n    new_companies: list[str] = Field(default_factory=list)\n    total_jobs_discovered: int = 0\n    total_jobs_scored: int = 0\n    created_at: Optional[datetime] = None\n","numLines":214,"startLine":1,"totalLines":214}}}}
