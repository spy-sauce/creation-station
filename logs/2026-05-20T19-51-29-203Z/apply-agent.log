{"t":"2026-05-20T20:08:15.569Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VxnAYQumFBeQwdWZ6RQzfp","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Outreach Composer — writes a cold email that doesn't read like a cold email.\n     6→\n     7→Email structure:\n     8→  1. Hook (1 sentence) — specific and real: funding, launch, blog post, shared signal\n     9→  2. Bridge (1-2 sentences) — connect hook to why the candidate is reaching out\n    10→  3. Value (2-3 sentences) — most relevant proof of impact for THIS role\n    11→  4. Ask (1 sentence) — specific low-friction CTA\n    12→  5. Signature — name, title, links\n    13→\n    14→Rules:\n    15→  - 150–200 words max\n    16→  - Never start with \"I hope this email finds you well\"\n    17→  - Never use \"I'm reaching out because...\"\n    18→  - 3 subject line variants shown in Review Dashboard\n    19→  - Draft stays DRAFT until approved\n    20→\"\"\"\n    21→\n    22→import json\n    23→import re\n    24→from uuid import UUID\n    25→\n    26→import structlog\n    27→from anthropic import AsyncAnthropic\n    28→from sqlalchemy.ext.asyncio import AsyncSession\n    29→from tenacity import retry, stop_after_attempt, wait_exponential\n    30→\n    31→from backend.agents.application.schemas import (\n    32→    CompanyIntelSchema,\n    33→    ContactSchema,\n    34→    OutreachEmailSchema,\n    35→    ParsedJDSchema,\n    36→    TailoredResumeSchema,\n    37→)\n    38→from backend.agents.discovery.schemas import IdentityProfile\n    39→from backend.models.application import OutreachEmail as OutreachEmailORM\n    40→\n    41→logger = structlog.get_logger(__name__)\n    42→\n    43→\n    44→class OutreachComposer:\n    45→    \"\"\"\n    46→    Writes a personalised cold email grounded in real company context.\n    47→\n    48→    Uses all available context: parsed JD, company intel, contact, tailored resume, identity profile.\n    49→    Generates 3 subject variants. Stays in DRAFT until the Review Dashboard approves it.\n    50→    \"\"\"\n    51→\n    52→    def __init__(self, db: AsyncSession, anthropic_client: AsyncAnthropic):\n    53→        self._db = db\n    54→        self._claude = anthropic_client\n    55→\n    56→    async def compose(\n    57→        self,\n    58→        parsed_jd: ParsedJDSchema,\n    59→        intel: CompanyIntelSchema,\n    60→        contact: ContactSchema,\n    61→        resume: TailoredResumeSchema,\n    62→        profile: IdentityProfile,\n    63→        candidate_name: str,\n    64→        candidate_email: str,\n    65→        candidate_github: str | None = None,\n    66→        candidate_linkedin: str | None = None,\n    67→    ) -> OutreachEmailSchema:\n    68→        \"\"\"\n    69→        Compose a cold outreach email for a specific job application.\n    70→\n    71→        Args:\n    72→            parsed_jd: Structured job description signals\n    73→            intel: Company research with recent news and notable facts\n    74→            contact: Target recipient\n    75→            resume: Tailored resume (for selecting the right proof points)\n    76→            profile: Candidate identity profile\n    77→            candidate_name: Candidate's full name\n    78→            candidate_email: Candidate's email for signature\n    79→            candidate_github: Optional GitHub URL\n    80→            candidate_linkedin: Optional LinkedIn URL\n    81→\n    82→        Returns:\n    83→            OutreachEmailSchema in DRAFT status\n    84→        \"\"\"\n    85→        log = logger.bind(\n    86→            job_id=str(parsed_jd.job_id),\n    87→            company=intel.company_name,\n    88→            contact=contact.email,\n    89→        )\n    90→        log.info(\"outreach_composer.composing\")\n    91→\n    92→        result = await self._call_claude(\n    93→            parsed_jd, intel, contact, resume, profile,\n    94→            candidate_name, candidate_email, candidate_github, candidate_linkedin,\n    95→        )\n    96→\n    97→        await self._persist(result)\n    98→        log.info(\"outreach_composer.complete\", subject=result.subject)\n    99→        return result\n   100→\n   101→    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n   102→    async def _call_claude(\n   103→        self,\n   104→        parsed_jd: ParsedJDSchema,\n   105→        intel: CompanyIntelSchema,\n   106→        contact: ContactSchema,\n   107→        resume: TailoredResumeSchema,\n   108→        profile: IdentityProfile,\n   109→        candidate_name: str,\n   110→        candidate_email: str,\n   111→        candidate_github: str | None,\n   112→        candidate_linkedin: str | None,\n   113→    ) -> OutreachEmailSchema:\n   114→        \"\"\"Generate the outreach email via Claude.\"\"\"\n   115→        prompt = self._build_prompt(\n   116→            parsed_jd, intel, contact, resume, profile,\n   117→            candidate_name, candidate_email, candidate_github, candidate_linkedin,\n   118→        )\n   119→\n   120→        response = await self._claude.messages.create(\n   121→            model=\"claude-sonnet-4-20250514\",\n   122→            max_tokens=2048,\n   123→            messages=[{\"role\": \"user\", \"content\": prompt}],\n   124→        )\n   125→\n   126→        raw = response.content[0].text.strip()\n   127→        logger.info(\n   128→            \"outreach_composer.claude_response\",\n   129→            job_id=str(parsed_jd.job_id),\n   130→            tokens=response.usage.output_tokens,\n   131→        )\n   132→\n   133→        data = self._extract_json(raw)\n   134→\n   135→        subjects = data.get(\"subject_variants\", [])\n   136→        primary_subject = subjects[0] if subjects else data.get(\"subject\", \"\")\n   137→\n   138→        return OutreachEmailSchema(\n   139→            job_id=parsed_jd.job_id,\n   140→            candidate_id=resume.candidate_id,\n   141→            to=contact.email or contact.fallback_email,\n   142→            subject=primary_subject,\n   143→            subject_variants=subjects,\n   144→            body=data.get(\"body\", \"\"),\n   145→            tone_used=data.get(\"tone_used\", intel.growth_stage or \"professional\"),\n   146→            hook_used=data.get(\"hook_used\"),\n   147→            status=\"DRAFT\",\n   148→        )\n   149→\n   150→    def _build_prompt(\n   151→        self,\n   152→        parsed_jd: ParsedJDSchema,\n   153→        intel: CompanyIntelSchema,\n   154→        contact: ContactSchema,\n   155→        resume: TailoredResumeSchema,\n   156→        profile: IdentityProfile,\n   157→        candidate_name: str,\n   158→        candidate_email: str,\n   159→        candidate_github: str | None,\n   160→        candidate_linkedin: str | None,\n   161→    ) -> str:\n   162→        sig_links = []\n   163→        if candidate_github:\n   164→            sig_links.append(candidate_github)\n   165→        if candidate_linkedin:\n   166→            sig_links.append(candidate_linkedin)\n   167→\n   168→        signature = f\"{candidate_name}\\n{candidate_email}\"\n   169→        if sig_links:\n   170→            signature += \"\\n\" + \" | \".join(sig_links)\n   171→\n   172→        return f\"\"\"You are writing a cold outreach email for a job application. It must feel human — specific, direct, not AI-generated.\n   173→\n   174→# CANDIDATE CONTEXT\n   175→Name: {candidate_name}\n   176→Identity: {\", \".join(profile.archetype_tags)}\n   177→Level: {profile.leadership_level}\n   178→Top skills: {\", \".join(list(profile.technical_skills.keys())[:8])}\n   179→Creative layer: {\", \".join(profile.creative_layer)}\n   180→\n   181→# TARGET ROLE\n   182→Company: {intel.company_name}\n   183→Role: (job_id: {parsed_jd.job_id})\n   184→Pain point this hire solves: {parsed_jd.pain_points or \"not specified\"}\n   185→Key responsibilities: {\", \".join(parsed_jd.key_responsibilities[:3])}\n   186→Culture: {parsed_jd.tone}, {parsed_jd.culture_signals.get(\"startup_vs_enterprise\", \"unknown\")} company\n   187→\n   188→# COMPANY INTEL\n   189→About: {intel.about or \"Not available\"}\n   190→Recent news: {intel.recent_news or \"No recent news found\"}\n   191→Notable hook: {intel.notable_facts or \"None identified\"}\n   192→Growth stage: {intel.growth_stage or \"unknown\"}\n   193→Engineering culture: {intel.engineering_culture or \"not available\"}\n   194→\n   195→# RECIPIENT\n   196→Name: {contact.name or \"Hiring Manager\"}\n   197→Title: {contact.title or \"Engineering Lead\"}\n   198→Email: {contact.email or \"unknown\"}\n   199→\n   200→# SIGNATURE\n   201→{signature}\n   202→\n   203→# EMAIL RULES\n   204→1. HOOK (1 sentence): Reference something specific and real about the company — the notable_facts, recent news, a challenge implied by the role, or something in the eng culture. Be specific.\n   205→2. BRIDGE (1-2 sentences): Connect that hook to why you're reaching out\n   206→3. VALUE (2-3 sentences): The candidate's most relevant proof of impact for THIS role — pick from the tailored resume summary. Be concrete.\n   207→4. ASK (1 sentence): Specific low-friction CTA like \"Would a 20-minute call this week make sense?\"\n   208→5. Signature\n   209→\n   210→ABSOLUTE RULES:\n   211→- 150–200 words max for the body\n   212→- Never start with \"I hope this email finds you well\"\n   213→- Never use \"I'm reaching out because...\"\n   214→- Never list every skill — pick the 1-2 that matter most here\n   215→- Address recipient by first name if available, \"Hi\" + first name\n   216→- Sound like a human wrote this at 9pm after doing research, not an AI at 6am\n   217→\n   218→Return ONLY valid JSON:\n   219→{{\n   220→  \"subject_variants\": [\"<subject 1>\", \"<subject 2>\", \"<subject 3>\"],\n   221→  \"body\": \"<full email body including greeting and signature>\",\n   222→  \"tone_used\": \"<the tone you chose based on company culture>\",\n   223→  \"hook_used\": \"<the specific company fact you used as the opening hook>\"\n   224→}}\"\"\"\n   225→\n   226→    def _extract_json(self, raw: str) -> dict:\n   227→        \"\"\"Extract JSON from Claude's response.\"\"\"\n   228→        try:\n   229→            return json.loads(raw)\n   230→        except json.JSONDecodeError:\n   231→            match = re.search(r\"\\{.*\\}\", raw, re.DOTALL)\n   232→            if not match:\n   233→                raise ValueError(f\"Claude returned non-JSON: {raw[:200]}\")\n   234→            return json.loads(match.group())\n   235→\n   236→    async def _persist(self, email: OutreachEmailSchema) -> None:\n   237→        \"\"\"Store the draft email in PostgreSQL.\"\"\"\n   238→        orm = OutreachEmailORM(\n   239→            job_id=email.job_id,\n   240→            candidate_id=email.candidate_id,\n   241→            subject=email.subject,\n   242→            subject_variants=email.subject_variants,\n   243→            body=email.body,\n   244→            tone_used=email.tone_used,\n   245→            hook_used=email.hook_used,\n   246→            status=email.status,\n   247→        )\n   248→        self._db.add(orm)\n   249→        await self._db.commit()\n   250→        logger.info(\n   251→            \"outreach_composer.persisted\",\n   252→            job_id=str(email.job_id),\n   253→            subject=email.subject,\n   254→        )\n   255→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"deb7dcc2-71e5-4120-93c5-a6ba962cce9e","uuid":"cc65973b-4f6f-4de3-9ad3-efc390397b23","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/application/outreach_composer.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nOutreach Composer — writes a cold email that doesn't read like a cold email.\n\nEmail structure:\n  1. Hook (1 sentence) — specific and real: funding, launch, blog post, shared signal\n  2. Bridge (1-2 sentences) — connect hook to why the candidate is reaching out\n  3. Value (2-3 sentences) — most relevant proof of impact for THIS role\n  4. Ask (1 sentence) — specific low-friction CTA\n  5. Signature — name, title, links\n\nRules:\n  - 150–200 words max\n  - Never start with \"I hope this email finds you well\"\n  - Never use \"I'm reaching out because...\"\n  - 3 subject line variants shown in Review Dashboard\n  - Draft stays DRAFT until approved\n\"\"\"\n\nimport json\nimport re\nfrom uuid import UUID\n\nimport structlog\nfrom anthropic import AsyncAnthropic\nfrom sqlalchemy.ext.asyncio import AsyncSession\nfrom tenacity import retry, stop_after_attempt, wait_exponential\n\nfrom backend.agents.application.schemas import (\n    CompanyIntelSchema,\n    ContactSchema,\n    OutreachEmailSchema,\n    ParsedJDSchema,\n    TailoredResumeSchema,\n)\nfrom backend.agents.discovery.schemas import IdentityProfile\nfrom backend.models.application import OutreachEmail as OutreachEmailORM\n\nlogger = structlog.get_logger(__name__)\n\n\nclass OutreachComposer:\n    \"\"\"\n    Writes a personalised cold email grounded in real company context.\n\n    Uses all available context: parsed JD, company intel, contact, tailored resume, identity profile.\n    Generates 3 subject variants. Stays in DRAFT until the Review Dashboard approves it.\n    \"\"\"\n\n    def __init__(self, db: AsyncSession, anthropic_client: AsyncAnthropic):\n        self._db = db\n        self._claude = anthropic_client\n\n    async def compose(\n        self,\n        parsed_jd: ParsedJDSchema,\n        intel: CompanyIntelSchema,\n        contact: ContactSchema,\n        resume: TailoredResumeSchema,\n        profile: IdentityProfile,\n        candidate_name: str,\n        candidate_email: str,\n        candidate_github: str | None = None,\n        candidate_linkedin: str | None = None,\n    ) -> OutreachEmailSchema:\n        \"\"\"\n        Compose a cold outreach email for a specific job application.\n\n        Args:\n            parsed_jd: Structured job description signals\n            intel: Company research with recent news and notable facts\n            contact: Target recipient\n            resume: Tailored resume (for selecting the right proof points)\n            profile: Candidate identity profile\n            candidate_name: Candidate's full name\n            candidate_email: Candidate's email for signature\n            candidate_github: Optional GitHub URL\n            candidate_linkedin: Optional LinkedIn URL\n\n        Returns:\n            OutreachEmailSchema in DRAFT status\n        \"\"\"\n        log = logger.bind(\n            job_id=str(parsed_jd.job_id),\n            company=intel.company_name,\n            contact=contact.email,\n        )\n        log.info(\"outreach_composer.composing\")\n\n        result = await self._call_claude(\n            parsed_jd, intel, contact, resume, profile,\n            candidate_name, candidate_email, candidate_github, candidate_linkedin,\n        )\n\n        await self._persist(result)\n        log.info(\"outreach_composer.complete\", subject=result.subject)\n        return result\n\n    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n    async def _call_claude(\n        self,\n        parsed_jd: ParsedJDSchema,\n        intel: CompanyIntelSchema,\n        contact: ContactSchema,\n        resume: TailoredResumeSchema,\n        profile: IdentityProfile,\n        candidate_name: str,\n        candidate_email: str,\n        candidate_github: str | None,\n        candidate_linkedin: str | None,\n    ) -> OutreachEmailSchema:\n        \"\"\"Generate the outreach email via Claude.\"\"\"\n        prompt = self._build_prompt(\n            parsed_jd, intel, contact, resume, profile,\n            candidate_name, candidate_email, candidate_github, candidate_linkedin,\n        )\n\n        response = await self._claude.messages.create(\n            model=\"claude-sonnet-4-20250514\",\n            max_tokens=2048,\n            messages=[{\"role\": \"user\", \"content\": prompt}],\n        )\n\n        raw = response.content[0].text.strip()\n        logger.info(\n            \"outreach_composer.claude_response\",\n            job_id=str(parsed_jd.job_id),\n            tokens=response.usage.output_tokens,\n        )\n\n        data = self._extract_json(raw)\n\n        subjects = data.get(\"subject_variants\", [])\n        primary_subject = subjects[0] if subjects else data.get(\"subject\", \"\")\n\n        return OutreachEmailSchema(\n            job_id=parsed_jd.job_id,\n            candidate_id=resume.candidate_id,\n            to=contact.email or contact.fallback_email,\n            subject=primary_subject,\n            subject_variants=subjects,\n            body=data.get(\"body\", \"\"),\n            tone_used=data.get(\"tone_used\", intel.growth_stage or \"professional\"),\n            hook_used=data.get(\"hook_used\"),\n            status=\"DRAFT\",\n        )\n\n    def _build_prompt(\n        self,\n        parsed_jd: ParsedJDSchema,\n        intel: CompanyIntelSchema,\n        contact: ContactSchema,\n        resume: TailoredResumeSchema,\n        profile: IdentityProfile,\n        candidate_name: str,\n        candidate_email: str,\n        candidate_github: str | None,\n        candidate_linkedin: str | None,\n    ) -> str:\n        sig_links = []\n        if candidate_github:\n            sig_links.append(candidate_github)\n        if candidate_linkedin:\n            sig_links.append(candidate_linkedin)\n\n        signature = f\"{candidate_name}\\n{candidate_email}\"\n        if sig_links:\n            signature += \"\\n\" + \" | \".join(sig_links)\n\n        return f\"\"\"You are writing a cold outreach email for a job application. It must feel human — specific, direct, not AI-generated.\n\n# CANDIDATE CONTEXT\nName: {candidate_name}\nIdentity: {\", \".join(profile.archetype_tags)}\nLevel: {profile.leadership_level}\nTop skills: {\", \".join(list(profile.technical_skills.keys())[:8])}\nCreative layer: {\", \".join(profile.creative_layer)}\n\n# TARGET ROLE\nCompany: {intel.company_name}\nRole: (job_id: {parsed_jd.job_id})\nPain point this hire solves: {parsed_jd.pain_points or \"not specified\"}\nKey responsibilities: {\", \".join(parsed_jd.key_responsibilities[:3])}\nCulture: {parsed_jd.tone}, {parsed_jd.culture_signals.get(\"startup_vs_enterprise\", \"unknown\")} company\n\n# COMPANY INTEL\nAbout: {intel.about or \"Not available\"}\nRecent news: {intel.recent_news or \"No recent news found\"}\nNotable hook: {intel.notable_facts or \"None identified\"}\nGrowth stage: {intel.growth_stage or \"unknown\"}\nEngineering culture: {intel.engineering_culture or \"not available\"}\n\n# RECIPIENT\nName: {contact.name or \"Hiring Manager\"}\nTitle: {contact.title or \"Engineering Lead\"}\nEmail: {contact.email or \"unknown\"}\n\n# SIGNATURE\n{signature}\n\n# EMAIL RULES\n1. HOOK (1 sentence): Reference something specific and real about the company — the notable_facts, recent news, a challenge implied by the role, or something in the eng culture. Be specific.\n2. BRIDGE (1-2 sentences): Connect that hook to why you're reaching out\n3. VALUE (2-3 sentences): The candidate's most relevant proof of impact for THIS role — pick from the tailored resume summary. Be concrete.\n4. ASK (1 sentence): Specific low-friction CTA like \"Would a 20-minute call this week make sense?\"\n5. Signature\n\nABSOLUTE RULES:\n- 150–200 words max for the body\n- Never start with \"I hope this email finds you well\"\n- Never use \"I'm reaching out because...\"\n- Never list every skill — pick the 1-2 that matter most here\n- Address recipient by first name if available, \"Hi\" + first name\n- Sound like a human wrote this at 9pm after doing research, not an AI at 6am\n\nReturn ONLY valid JSON:\n{{\n  \"subject_variants\": [\"<subject 1>\", \"<subject 2>\", \"<subject 3>\"],\n  \"body\": \"<full email body including greeting and signature>\",\n  \"tone_used\": \"<the tone you chose based on company culture>\",\n  \"hook_used\": \"<the specific company fact you used as the opening hook>\"\n}}\"\"\"\n\n    def _extract_json(self, raw: str) -> dict:\n        \"\"\"Extract JSON from Claude's response.\"\"\"\n        try:\n            return json.loads(raw)\n        except json.JSONDecodeError:\n            match = re.search(r\"\\{.*\\}\", raw, re.DOTALL)\n            if not match:\n                raise ValueError(f\"Claude returned non-JSON: {raw[:200]}\")\n            return json.loads(match.group())\n\n    async def _persist(self, email: OutreachEmailSchema) -> None:\n        \"\"\"Store the draft email in PostgreSQL.\"\"\"\n        orm = OutreachEmailORM(\n            job_id=email.job_id,\n            candidate_id=email.candidate_id,\n            subject=email.subject,\n            subject_variants=email.subject_variants,\n            body=email.body,\n            tone_used=email.tone_used,\n            hook_used=email.hook_used,\n            status=email.status,\n        )\n        self._db.add(orm)\n        await self._db.commit()\n        logger.info(\n            \"outreach_composer.persisted\",\n            job_id=str(email.job_id),\n            subject=email.subject,\n        )\n","numLines":255,"startLine":1,"totalLines":255}}}}
{"t":"2026-05-20T20:08:15.579Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012wnawP3Uq9AxHSf9ErBCdi","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Auto-Apply Agent — navigates career pages and submits application forms via Playwright.\n     6→\n     7→NEVER submits without explicit Review Dashboard approval.\n     8→Handles known ATS systems (Greenhouse, Lever, Workday, Ashby) with field maps.\n     9→Unknown ATSs: AI-guided DOM inspection.\n    10→\n    11→CAPTCHA detection → marks as REQUIRES_MANUAL and surfaces to dashboard.\n    12→Screenshots every major step for audit trail.\n    13→\"\"\"\n    14→\n    15→import asyncio\n    16→import os\n    17→import re\n    18→from pathlib import Path\n    19→from uuid import UUID\n    20→\n    21→import structlog\n    22→from playwright.async_api import async_playwright, Page, Browser\n    23→\n    24→from backend.agents.application.schemas import (\n    25→    ApplicationResultSchema,\n    26→    TailoredResumeSchema,\n    27→)\n    28→from backend.agents.discovery.schemas import CandidateSchema\n    29→\n    30→logger = structlog.get_logger(__name__)\n    31→\n    32→# ─── ATS Field Maps ────────────────────────────────────────────────────────────\n    33→# Known selectors for the most common ATS platforms\n    34→\n    35→_ATS_FIELD_MAPS = {\n    36→    \"greenhouse\": {\n    37→        \"first_name\": \"#first_name\",\n    38→        \"last_name\": \"#last_name\",\n    39→        \"email\": \"#email\",\n    40→        \"phone\": \"#phone\",\n    41→        \"resume_upload\": \"input[type='file']\",\n    42→        \"linkedin\": \"input[placeholder*='LinkedIn'], input[name*='linkedin']\",\n    43→        \"github\": \"input[placeholder*='GitHub'], input[name*='github']\",\n    44→        \"cover_letter\": \"textarea[name*='cover_letter'], #cover_letter\",\n    45→    },\n    46→    \"lever\": {\n    47→        \"first_name\": \"input[name='name']\",  # Lever uses full name\n    48→        \"email\": \"input[name='email']\",\n    49→        \"phone\": \"input[name='phone']\",\n    50→        \"resume_upload\": \"input[type='file']\",\n    51→        \"linkedin\": \"input[name='urls[LinkedIn]']\",\n    52→        \"github\": \"input[name='urls[GitHub]']\",\n    53→        \"cover_letter\": \"textarea[name='comments']\",\n    54→    },\n    55→    \"workday\": {\n    56→        \"first_name\": \"input[data-automation-id='legalNameSection_firstName']\",\n    57→        \"last_name\": \"input[data-automation-id='legalNameSection_lastName']\",\n    58→        \"email\": \"input[data-automation-id='email']\",\n    59→        \"phone\": \"input[data-automation-id='phone-number']\",\n    60→        \"resume_upload\": \"input[type='file']\",\n    61→    },\n    62→    \"ashby\": {\n    63→        \"first_name\": \"input[name='firstName'], input[placeholder*='First']\",\n    64→        \"last_name\": \"input[name='lastName'], input[placeholder*='Last']\",\n    65→        \"email\": \"input[name='email'], input[type='email']\",\n    66→        \"phone\": \"input[name='phone'], input[type='tel']\",\n    67→        \"resume_upload\": \"input[type='file']\",\n    68→        \"linkedin\": \"input[placeholder*='LinkedIn']\",\n    69→        \"github\": \"input[placeholder*='GitHub']\",\n    70→    },\n    71→}\n    72→\n    73→\n    74→def _detect_ats(url: str) -> str:\n    75→    \"\"\"Detect ATS type from URL pattern.\"\"\"\n    76→    url_lower = url.lower()\n    77→    if \"greenhouse.io\" in url_lower or \"boards.greenhouse.io\" in url_lower:\n    78→        return \"greenhouse\"\n    79→    if \"lever.co\" in url_lower or \"jobs.lever.co\" in url_lower:\n    80→        return \"lever\"\n    81→    if \"myworkdayjobs.com\" in url_lower or \"workday.com\" in url_lower:\n    82→        return \"workday\"\n    83→    if \"jobs.ashby.io\" in url_lower or \"ashbyhq.com\" in url_lower:\n    84→        return \"ashby\"\n    85→    return \"unknown\"\n    86→\n    87→\n    88→class AutoApplyAgent:\n    89→    \"\"\"\n    90→    Submits application forms via Playwright.\n    91→\n    92→    CRITICAL: Only call submit() after receiving explicit APPROVED status from the pipeline.\n    93→    This agent runs headless in production.\n    94→    \"\"\"\n    95→\n    96→    def __init__(self, screenshot_dir: str = \"./screenshots\"):\n    97→        self._screenshot_dir = Path(screenshot_dir)\n    98→\n    99→    async def submit(\n   100→        self,\n   101→        job_url: str,\n   102→        job_id: UUID,\n   103→        pipeline_id: UUID,\n   104→        candidate: CandidateSchema,\n   105→        resume: TailoredResumeSchema,\n   106→    ) -> ApplicationResultSchema:\n   107→        \"\"\"\n   108→        Submit an application form. Only called after Review Dashboard approval.\n   109→\n   110→        Args:\n   111→            job_url: The job posting URL\n   112→            job_id: Job ID for tracking\n   113→            pipeline_id: Pipeline ID for tracking\n   114→            candidate: Candidate profile with contact details\n   115→            resume: Tailored resume with PDF path\n   116→\n   117→        Returns:\n   118→            ApplicationResultSchema with outcome\n   119→        \"\"\"\n   120→        log = logger.bind(job_id=str(job_id), url=job_url)\n   121→        shot_dir = self._screenshot_dir / str(job_id)\n   122→        shot_dir.mkdir(parents=True, exist_ok=True)\n   123→\n   124→        ats = _detect_ats(job_url)\n   125→        log.info(\"auto_apply.starting\", ats=ats)\n   126→\n   127→        async with async_playwright() as p:\n   128→            browser = await p.chromium.launch(headless=True)\n   129→            try:\n   130→                result = await self._navigate_and_fill(\n   131→                    browser, job_url, job_id, pipeline_id,\n   132→                    candidate, resume, ats, shot_dir\n   133→                )\n   134→                return result\n   135→            except Exception as e:\n   136→                log.error(\"auto_apply.failed\", error=str(e))\n   137→                return ApplicationResultSchema(\n   138→                    pipeline_id=pipeline_id,\n   139→                    job_id=job_id,\n   140→                    status=\"FAILED\",\n   141→                    error=str(e),\n   142→                    fallback_url=job_url,\n   143→                )\n   144→            finally:\n   145→                await browser.close()\n   146→\n   147→    async def _navigate_and_fill(\n   148→        self,\n   149→        browser: Browser,\n   150→        url: str,\n   151→        job_id: UUID,\n   152→        pipeline_id: UUID,\n   153→        candidate: CandidateSchema,\n   154→        resume: TailoredResumeSchema,\n   155→        ats: str,\n   156→        shot_dir: Path,\n   157→    ) -> ApplicationResultSchema:\n   158→        \"\"\"Navigate to the application form and fill it out.\"\"\"\n   159→        page = await browser.new_page()\n   160→        fields_completed: list[str] = []\n   161→\n   162→        try:\n   163→            await page.goto(url, wait_until=\"networkidle\", timeout=30000)\n   164→            await page.screenshot(path=str(shot_dir / \"01_loaded.png\"))\n   165→\n   166→            # CAPTCHA detection\n   167→            if await self._has_captcha(page):\n   168→                logger.warning(\"auto_apply.captcha_detected\", url=url)\n   169→                await page.screenshot(path=str(shot_dir / \"captcha.png\"))\n   170→                return ApplicationResultSchema(\n   171→                    pipeline_id=pipeline_id,\n   172→                    job_id=job_id,\n   173→                    status=\"REQUIRES_MANUAL\",\n   174→                    screenshot_path=str(shot_dir / \"captcha.png\"),\n   175→                    error=\"CAPTCHA detected — requires manual submission\",\n   176→                    fallback_url=url,\n   177→                )\n   178→\n   179→            field_map = _ATS_FIELD_MAPS.get(ats, {})\n   180→\n   181→            # Fill name fields\n   182→            name_parts = candidate.name.split(\" \", 1)\n   183→            first_name = name_parts[0]\n   184→            last_name = name_parts[1] if len(name_parts) > 1 else \"\"\n   185→\n   186→            if ats == \"lever\":\n   187→                # Lever uses a single full name field\n   188→                if await self._fill_field(page, field_map.get(\"first_name\", \"\"), candidate.name):\n   189→                    fields_completed.append(\"full_name\")\n   190→            else:\n   191→                if await self._fill_field(page, field_map.get(\"first_name\", \"\"), first_name):\n   192→                    fields_completed.append(\"first_name\")\n   193→                if await self._fill_field(page, field_map.get(\"last_name\", \"\"), last_name):\n   194→                    fields_completed.append(\"last_name\")\n   195→\n   196→            if await self._fill_field(page, field_map.get(\"email\", \"input[type='email']\"), candidate.email):\n   197→                fields_completed.append(\"email\")\n   198→\n   199→            await page.screenshot(path=str(shot_dir / \"02_basic_info.png\"))\n   200→\n   201→            # Upload resume PDF\n   202→            if resume.pdf_path and os.path.exists(resume.pdf_path):\n   203→                upload_sel = field_map.get(\"resume_upload\", \"input[type='file']\")\n   204→                try:\n   205→                    file_input = await page.query_selector(upload_sel)\n   206→                    if file_input:\n   207→                        await file_input.set_input_files(resume.pdf_path)\n   208→                        fields_completed.append(\"resume\")\n   209→                        await page.screenshot(path=str(shot_dir / \"03_resume_uploaded.png\"))\n   210→                except Exception as e:\n   211→                    logger.warning(\"auto_apply.upload_failed\", error=str(e))\n   212→\n   213→            # LinkedIn / GitHub\n   214→            if candidate.linkedin_url:\n   215→                if await self._fill_field(page, field_map.get(\"linkedin\", \"\"), candidate.linkedin_url):\n   216→                    fields_completed.append(\"linkedin\")\n   217→            if candidate.github_url:\n   218→                if await self._fill_field(page, field_map.get(\"github\", \"\"), candidate.github_url):\n   219→                    fields_completed.append(\"github\")\n   220→\n   221→            await page.screenshot(path=str(shot_dir / \"04_filled.png\"))\n   222→\n   223→            logger.info(\n   224→                \"auto_apply.form_filled\",\n   225→                fields=fields_completed,\n   226→                ats=ats,\n   227→            )\n   228→\n   229→            # NOTE: We do NOT submit here — the form is filled and staged.\n   230→            # The Review Dashboard confirms fields were filled correctly.\n   231→            # Actual submission happens only after a second explicit human approval.\n   232→            return ApplicationResultSchema(\n   233→                pipeline_id=pipeline_id,\n   234→                job_id=job_id,\n   235→                status=\"REQUIRES_MANUAL\",  # Human clicks submit after reviewing filled form\n   236→                screenshot_path=str(shot_dir / \"04_filled.png\"),\n   237→                fields_completed=fields_completed,\n   238→                fallback_url=url,\n   239→            )\n   240→\n   241→        finally:\n   242→            await page.close()\n   243→\n   244→    async def _fill_field(self, page: Page, selector: str, value: str) -> bool:\n   245→        \"\"\"Attempt to fill a form field. Returns True if successful.\"\"\"\n   246→        if not selector or not value:\n   247→            return False\n   248→        try:\n   249→            # Try each selector if comma-separated\n   250→            for sel in [s.strip() for s in selector.split(\",\")]:\n   251→                element = await page.query_selector(sel)\n   252→                if element:\n   253→                    await element.fill(value)\n   254→                    return True\n   255→        except Exception as e:\n   256→            logger.debug(\"auto_apply.field_fill_failed\", selector=selector, error=str(e))\n   257→        return False\n   258→\n   259→    async def _has_captcha(self, page: Page) -> bool:\n   260→        \"\"\"Detect common CAPTCHA patterns on the page.\"\"\"\n   261→        captcha_signals = [\n   262→            \"iframe[src*='recaptcha']\",\n   263→            \"iframe[src*='hcaptcha']\",\n   264→            \".g-recaptcha\",\n   265→            \"#captcha\",\n   266→            \"div[class*='captcha']\",\n   267→        ]\n   268→        for signal in captcha_signals:\n   269→            element = await page.query_selector(signal)\n   270→            if element:\n   271→                return True\n   272→        return False\n   273→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"deb7dcc2-71e5-4120-93c5-a6ba962cce9e","uuid":"aee5a6db-75e6-420b-bdfb-dd3e0de8f204","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/application/auto_apply.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nAuto-Apply Agent — navigates career pages and submits application forms via Playwright.\n\nNEVER submits without explicit Review Dashboard approval.\nHandles known ATS systems (Greenhouse, Lever, Workday, Ashby) with field maps.\nUnknown ATSs: AI-guided DOM inspection.\n\nCAPTCHA detection → marks as REQUIRES_MANUAL and surfaces to dashboard.\nScreenshots every major step for audit trail.\n\"\"\"\n\nimport asyncio\nimport os\nimport re\nfrom pathlib import Path\nfrom uuid import UUID\n\nimport structlog\nfrom playwright.async_api import async_playwright, Page, Browser\n\nfrom backend.agents.application.schemas import (\n    ApplicationResultSchema,\n    TailoredResumeSchema,\n)\nfrom backend.agents.discovery.schemas import CandidateSchema\n\nlogger = structlog.get_logger(__name__)\n\n# ─── ATS Field Maps ────────────────────────────────────────────────────────────\n# Known selectors for the most common ATS platforms\n\n_ATS_FIELD_MAPS = {\n    \"greenhouse\": {\n        \"first_name\": \"#first_name\",\n        \"last_name\": \"#last_name\",\n        \"email\": \"#email\",\n        \"phone\": \"#phone\",\n        \"resume_upload\": \"input[type='file']\",\n        \"linkedin\": \"input[placeholder*='LinkedIn'], input[name*='linkedin']\",\n        \"github\": \"input[placeholder*='GitHub'], input[name*='github']\",\n        \"cover_letter\": \"textarea[name*='cover_letter'], #cover_letter\",\n    },\n    \"lever\": {\n        \"first_name\": \"input[name='name']\",  # Lever uses full name\n        \"email\": \"input[name='email']\",\n        \"phone\": \"input[name='phone']\",\n        \"resume_upload\": \"input[type='file']\",\n        \"linkedin\": \"input[name='urls[LinkedIn]']\",\n        \"github\": \"input[name='urls[GitHub]']\",\n        \"cover_letter\": \"textarea[name='comments']\",\n    },\n    \"workday\": {\n        \"first_name\": \"input[data-automation-id='legalNameSection_firstName']\",\n        \"last_name\": \"input[data-automation-id='legalNameSection_lastName']\",\n        \"email\": \"input[data-automation-id='email']\",\n        \"phone\": \"input[data-automation-id='phone-number']\",\n        \"resume_upload\": \"input[type='file']\",\n    },\n    \"ashby\": {\n        \"first_name\": \"input[name='firstName'], input[placeholder*='First']\",\n        \"last_name\": \"input[name='lastName'], input[placeholder*='Last']\",\n        \"email\": \"input[name='email'], input[type='email']\",\n        \"phone\": \"input[name='phone'], input[type='tel']\",\n        \"resume_upload\": \"input[type='file']\",\n        \"linkedin\": \"input[placeholder*='LinkedIn']\",\n        \"github\": \"input[placeholder*='GitHub']\",\n    },\n}\n\n\ndef _detect_ats(url: str) -> str:\n    \"\"\"Detect ATS type from URL pattern.\"\"\"\n    url_lower = url.lower()\n    if \"greenhouse.io\" in url_lower or \"boards.greenhouse.io\" in url_lower:\n        return \"greenhouse\"\n    if \"lever.co\" in url_lower or \"jobs.lever.co\" in url_lower:\n        return \"lever\"\n    if \"myworkdayjobs.com\" in url_lower or \"workday.com\" in url_lower:\n        return \"workday\"\n    if \"jobs.ashby.io\" in url_lower or \"ashbyhq.com\" in url_lower:\n        return \"ashby\"\n    return \"unknown\"\n\n\nclass AutoApplyAgent:\n    \"\"\"\n    Submits application forms via Playwright.\n\n    CRITICAL: Only call submit() after receiving explicit APPROVED status from the pipeline.\n    This agent runs headless in production.\n    \"\"\"\n\n    def __init__(self, screenshot_dir: str = \"./screenshots\"):\n        self._screenshot_dir = Path(screenshot_dir)\n\n    async def submit(\n        self,\n        job_url: str,\n        job_id: UUID,\n        pipeline_id: UUID,\n        candidate: CandidateSchema,\n        resume: TailoredResumeSchema,\n    ) -> ApplicationResultSchema:\n        \"\"\"\n        Submit an application form. Only called after Review Dashboard approval.\n\n        Args:\n            job_url: The job posting URL\n            job_id: Job ID for tracking\n            pipeline_id: Pipeline ID for tracking\n            candidate: Candidate profile with contact details\n            resume: Tailored resume with PDF path\n\n        Returns:\n            ApplicationResultSchema with outcome\n        \"\"\"\n        log = logger.bind(job_id=str(job_id), url=job_url)\n        shot_dir = self._screenshot_dir / str(job_id)\n        shot_dir.mkdir(parents=True, exist_ok=True)\n\n        ats = _detect_ats(job_url)\n        log.info(\"auto_apply.starting\", ats=ats)\n\n        async with async_playwright() as p:\n            browser = await p.chromium.launch(headless=True)\n            try:\n                result = await self._navigate_and_fill(\n                    browser, job_url, job_id, pipeline_id,\n                    candidate, resume, ats, shot_dir\n                )\n                return result\n            except Exception as e:\n                log.error(\"auto_apply.failed\", error=str(e))\n                return ApplicationResultSchema(\n                    pipeline_id=pipeline_id,\n                    job_id=job_id,\n                    status=\"FAILED\",\n                    error=str(e),\n                    fallback_url=job_url,\n                )\n            finally:\n                await browser.close()\n\n    async def _navigate_and_fill(\n        self,\n        browser: Browser,\n        url: str,\n        job_id: UUID,\n        pipeline_id: UUID,\n        candidate: CandidateSchema,\n        resume: TailoredResumeSchema,\n        ats: str,\n        shot_dir: Path,\n    ) -> ApplicationResultSchema:\n        \"\"\"Navigate to the application form and fill it out.\"\"\"\n        page = await browser.new_page()\n        fields_completed: list[str] = []\n\n        try:\n            await page.goto(url, wait_until=\"networkidle\", timeout=30000)\n            await page.screenshot(path=str(shot_dir / \"01_loaded.png\"))\n\n            # CAPTCHA detection\n            if await self._has_captcha(page):\n                logger.warning(\"auto_apply.captcha_detected\", url=url)\n                await page.screenshot(path=str(shot_dir / \"captcha.png\"))\n                return ApplicationResultSchema(\n                    pipeline_id=pipeline_id,\n                    job_id=job_id,\n                    status=\"REQUIRES_MANUAL\",\n                    screenshot_path=str(shot_dir / \"captcha.png\"),\n                    error=\"CAPTCHA detected — requires manual submission\",\n                    fallback_url=url,\n                )\n\n            field_map = _ATS_FIELD_MAPS.get(ats, {})\n\n            # Fill name fields\n            name_parts = candidate.name.split(\" \", 1)\n            first_name = name_parts[0]\n            last_name = name_parts[1] if len(name_parts) > 1 else \"\"\n\n            if ats == \"lever\":\n                # Lever uses a single full name field\n                if await self._fill_field(page, field_map.get(\"first_name\", \"\"), candidate.name):\n                    fields_completed.append(\"full_name\")\n            else:\n                if await self._fill_field(page, field_map.get(\"first_name\", \"\"), first_name):\n                    fields_completed.append(\"first_name\")\n                if await self._fill_field(page, field_map.get(\"last_name\", \"\"), last_name):\n                    fields_completed.append(\"last_name\")\n\n            if await self._fill_field(page, field_map.get(\"email\", \"input[type='email']\"), candidate.email):\n                fields_completed.append(\"email\")\n\n            await page.screenshot(path=str(shot_dir / \"02_basic_info.png\"))\n\n            # Upload resume PDF\n            if resume.pdf_path and os.path.exists(resume.pdf_path):\n                upload_sel = field_map.get(\"resume_upload\", \"input[type='file']\")\n                try:\n                    file_input = await page.query_selector(upload_sel)\n                    if file_input:\n                        await file_input.set_input_files(resume.pdf_path)\n                        fields_completed.append(\"resume\")\n                        await page.screenshot(path=str(shot_dir / \"03_resume_uploaded.png\"))\n                except Exception as e:\n                    logger.warning(\"auto_apply.upload_failed\", error=str(e))\n\n            # LinkedIn / GitHub\n            if candidate.linkedin_url:\n                if await self._fill_field(page, field_map.get(\"linkedin\", \"\"), candidate.linkedin_url):\n                    fields_completed.append(\"linkedin\")\n            if candidate.github_url:\n                if await self._fill_field(page, field_map.get(\"github\", \"\"), candidate.github_url):\n                    fields_completed.append(\"github\")\n\n            await page.screenshot(path=str(shot_dir / \"04_filled.png\"))\n\n            logger.info(\n                \"auto_apply.form_filled\",\n                fields=fields_completed,\n                ats=ats,\n            )\n\n            # NOTE: We do NOT submit here — the form is filled and staged.\n            # The Review Dashboard confirms fields were filled correctly.\n            # Actual submission happens only after a second explicit human approval.\n            return ApplicationResultSchema(\n                pipeline_id=pipeline_id,\n                job_id=job_id,\n                status=\"REQUIRES_MANUAL\",  # Human clicks submit after reviewing filled form\n                screenshot_path=str(shot_dir / \"04_filled.png\"),\n                fields_completed=fields_completed,\n                fallback_url=url,\n            )\n\n        finally:\n            await page.close()\n\n    async def _fill_field(self, page: Page, selector: str, value: str) -> bool:\n        \"\"\"Attempt to fill a form field. Returns True if successful.\"\"\"\n        if not selector or not value:\n            return False\n        try:\n            # Try each selector if comma-separated\n            for sel in [s.strip() for s in selector.split(\",\")]:\n                element = await page.query_selector(sel)\n                if element:\n                    await element.fill(value)\n                    return True\n        except Exception as e:\n            logger.debug(\"auto_apply.field_fill_failed\", selector=selector, error=str(e))\n        return False\n\n    async def _has_captcha(self, page: Page) -> bool:\n        \"\"\"Detect common CAPTCHA patterns on the page.\"\"\"\n        captcha_signals = [\n            \"iframe[src*='recaptcha']\",\n            \"iframe[src*='hcaptcha']\",\n            \".g-recaptcha\",\n            \"#captcha\",\n            \"div[class*='captcha']\",\n        ]\n        for signal in captcha_signals:\n            element = await page.query_selector(signal)\n            if element:\n                return True\n        return False\n","numLines":273,"startLine":1,"totalLines":273}}}}
{"t":"2026-05-20T20:08:15.588Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EaFjhC7cNZyyy6h5Fmg5WD","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→CRM — tracks every application and its outcome over time.\n     6→\n     7→Simple PostgreSQL-backed event log. No third-party CRM dependency.\n     8→Every significant moment in the application journey gets an event.\n     9→\n    10→Event types:\n    11→  APPLICATION_STARTED\n    12→  RESUME_TAILORED\n    13→  COMPANY_RESEARCHED\n    14→  CONTACT_FOUND\n    15→  EMAIL_DRAFTED\n    16→  APPROVED_FOR_SUBMISSION\n    17→  SUBMITTED\n    18→  EMAIL_SENT\n    19→  EMAIL_OPENED\n    20→  RESPONDED\n    21→  INTERVIEW_SCHEDULED\n    22→  OFFER_RECEIVED\n    23→  REJECTED\n    24→  PLACED\n    25→\"\"\"\n    26→\n    27→from uuid import UUID\n    28→from typing import Optional\n    29→\n    30→import structlog\n    31→from sqlalchemy.ext.asyncio import AsyncSession\n    32→from sqlalchemy import select\n    33→\n    34→from backend.models.application import CRMEvent as CRMEventORM, ApplicationPipeline\n    35→\n    36→logger = structlog.get_logger(__name__)\n    37→\n    38→\n    39→class CRM:\n    40→    \"\"\"\n    41→    Logs application lifecycle events to PostgreSQL.\n    42→\n    43→    Provides a complete audit trail for every application from start to placement.\n    44→    \"\"\"\n    45→\n    46→    def __init__(self, db: AsyncSession):\n    47→        self._db = db\n    48→\n    49→    async def log(\n    50→        self,\n    51→        pipeline_id: UUID,\n    52→        candidate_id: UUID,\n    53→        job_id: UUID,\n    54→        event_type: str,\n    55→        details: Optional[dict] = None,\n    56→    ) -> None:\n    57→        \"\"\"\n    58→        Record an event in the application timeline.\n    59→\n    60→        Args:\n    61→            pipeline_id: The application pipeline this event belongs to\n    62→            candidate_id: Candidate FK\n    63→            job_id: Job FK\n    64→            event_type: One of the defined event type strings\n    65→            details: Optional metadata dict (scores, email subjects, confirmation numbers, etc.)\n    66→        \"\"\"\n    67→        orm = CRMEventORM(\n    68→            pipeline_id=pipeline_id,\n    69→            candidate_id=candidate_id,\n    70→            job_id=job_id,\n    71→            event_type=event_type,\n    72→            details=details,\n    73→        )\n    74→        self._db.add(orm)\n    75→        await self._db.commit()\n    76→\n    77→        logger.info(\n    78→            \"crm.event_logged\",\n    79→            pipeline_id=str(pipeline_id),\n    80→            event_type=event_type,\n    81→        )\n    82→\n    83→    async def get_timeline(self, pipeline_id: UUID) -> list[dict]:\n    84→        \"\"\"\n    85→        Return the full event timeline for an application pipeline.\n    86→\n    87→        Args:\n    88→            pipeline_id: Pipeline to fetch events for\n    89→\n    90→        Returns:\n    91→            List of event dicts ordered by created_at ascending\n    92→        \"\"\"\n    93→        result = await self._db.execute(\n    94→            select(CRMEventORM)\n    95→            .where(CRMEventORM.pipeline_id == pipeline_id)\n    96→            .order_by(CRMEventORM.created_at.asc())\n    97→        )\n    98→        events = result.scalars().all()\n    99→        return [\n   100→            {\n   101→                \"id\": str(e.id),\n   102→                \"event_type\": e.event_type,\n   103→                \"details\": e.details,\n   104→                \"created_at\": e.created_at.isoformat(),\n   105→            }\n   106→            for e in events\n   107→        ]\n   108→\n   109→    async def update_pipeline_status(\n   110→        self, pipeline_id: UUID, status: str, current_step: Optional[str] = None\n   111→    ) -> None:\n   112→        \"\"\"\n   113→        Update the application pipeline's status and log the transition.\n   114→\n   115→        Args:\n   116→            pipeline_id: Pipeline to update\n   117→            status: New pipeline status\n   118→            current_step: Optional current step name\n   119→        \"\"\"\n   120→        result = await self._db.execute(\n   121→            select(ApplicationPipeline).where(ApplicationPipeline.id == pipeline_id)\n   122→        )\n   123→        pipeline = result.scalar_one_or_none()\n   124→        if not pipeline:\n   125→            logger.warning(\"crm.pipeline_not_found\", pipeline_id=str(pipeline_id))\n   126→            return\n   127→\n   128→        old_status = pipeline.status\n   129→        pipeline.status = status\n   130→        if current_step:\n   131→            pipeline.current_step = current_step\n   132→\n   133→        await self._db.commit()\n   134→\n   135→        logger.info(\n   136→            \"crm.status_updated\",\n   137→            pipeline_id=str(pipeline_id),\n   138→            old_status=old_status,\n   139→            new_status=status,\n   140→        )\n   141→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"deb7dcc2-71e5-4120-93c5-a6ba962cce9e","uuid":"22eeae5a-dd8a-48a4-a932-0802a7879d33","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/application/crm.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nCRM — tracks every application and its outcome over time.\n\nSimple PostgreSQL-backed event log. No third-party CRM dependency.\nEvery significant moment in the application journey gets an event.\n\nEvent types:\n  APPLICATION_STARTED\n  RESUME_TAILORED\n  COMPANY_RESEARCHED\n  CONTACT_FOUND\n  EMAIL_DRAFTED\n  APPROVED_FOR_SUBMISSION\n  SUBMITTED\n  EMAIL_SENT\n  EMAIL_OPENED\n  RESPONDED\n  INTERVIEW_SCHEDULED\n  OFFER_RECEIVED\n  REJECTED\n  PLACED\n\"\"\"\n\nfrom uuid import UUID\nfrom typing import Optional\n\nimport structlog\nfrom sqlalchemy.ext.asyncio import AsyncSession\nfrom sqlalchemy import select\n\nfrom backend.models.application import CRMEvent as CRMEventORM, ApplicationPipeline\n\nlogger = structlog.get_logger(__name__)\n\n\nclass CRM:\n    \"\"\"\n    Logs application lifecycle events to PostgreSQL.\n\n    Provides a complete audit trail for every application from start to placement.\n    \"\"\"\n\n    def __init__(self, db: AsyncSession):\n        self._db = db\n\n    async def log(\n        self,\n        pipeline_id: UUID,\n        candidate_id: UUID,\n        job_id: UUID,\n        event_type: str,\n        details: Optional[dict] = None,\n    ) -> None:\n        \"\"\"\n        Record an event in the application timeline.\n\n        Args:\n            pipeline_id: The application pipeline this event belongs to\n            candidate_id: Candidate FK\n            job_id: Job FK\n            event_type: One of the defined event type strings\n            details: Optional metadata dict (scores, email subjects, confirmation numbers, etc.)\n        \"\"\"\n        orm = CRMEventORM(\n            pipeline_id=pipeline_id,\n            candidate_id=candidate_id,\n            job_id=job_id,\n            event_type=event_type,\n            details=details,\n        )\n        self._db.add(orm)\n        await self._db.commit()\n\n        logger.info(\n            \"crm.event_logged\",\n            pipeline_id=str(pipeline_id),\n            event_type=event_type,\n        )\n\n    async def get_timeline(self, pipeline_id: UUID) -> list[dict]:\n        \"\"\"\n        Return the full event timeline for an application pipeline.\n\n        Args:\n            pipeline_id: Pipeline to fetch events for\n\n        Returns:\n            List of event dicts ordered by created_at ascending\n        \"\"\"\n        result = await self._db.execute(\n            select(CRMEventORM)\n            .where(CRMEventORM.pipeline_id == pipeline_id)\n            .order_by(CRMEventORM.created_at.asc())\n        )\n        events = result.scalars().all()\n        return [\n            {\n                \"id\": str(e.id),\n                \"event_type\": e.event_type,\n                \"details\": e.details,\n                \"created_at\": e.created_at.isoformat(),\n            }\n            for e in events\n        ]\n\n    async def update_pipeline_status(\n        self, pipeline_id: UUID, status: str, current_step: Optional[str] = None\n    ) -> None:\n        \"\"\"\n        Update the application pipeline's status and log the transition.\n\n        Args:\n            pipeline_id: Pipeline to update\n            status: New pipeline status\n            current_step: Optional current step name\n        \"\"\"\n        result = await self._db.execute(\n            select(ApplicationPipeline).where(ApplicationPipeline.id == pipeline_id)\n        )\n        pipeline = result.scalar_one_or_none()\n        if not pipeline:\n            logger.warning(\"crm.pipeline_not_found\", pipeline_id=str(pipeline_id))\n            return\n\n        old_status = pipeline.status\n        pipeline.status = status\n        if current_step:\n            pipeline.current_step = current_step\n\n        await self._db.commit()\n\n        logger.info(\n            \"crm.status_updated\",\n            pipeline_id=str(pipeline_id),\n            old_status=old_status,\n            new_status=status,\n        )\n","numLines":141,"startLine":1,"totalLines":141}}}}
