{"t":"2026-05-20T20:11:40.937Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RwB8WFso1UcNz5c3uZ6Z7K","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→SQLAlchemy ORM models for the Application Engine.\n     6→\n     7→Tables:\n     8→  - parsed_jds: Structured JD parsing output\n     9→  - application_pipelines: Pipeline state machine (QUEUED → SENT)\n    10→  - tailored_resumes: Resume rewrites for specific jobs\n    11→  - company_intel: Company research artifacts\n    12→  - contacts: Discovered recipient contacts\n    13→  - outreach_emails: Draft outreach emails\n    14→  - crm_events: Append-only event log per pipeline\n    15→\"\"\"\n    16→\n    17→import uuid\n    18→from datetime import datetime\n    19→from typing import Optional\n    20→import enum\n    21→\n    22→from sqlalchemy import String, Text, Integer, DateTime, ForeignKey, func, Enum\n    23→from sqlalchemy.orm import Mapped, mapped_column, relationship\n    24→from sqlalchemy.dialects.postgresql import UUID, ARRAY, JSONB\n    25→\n    26→from backend.database import Base\n    27→\n    28→\n    29→# ─── Enums ───────────────────────────────────────────────────────────────────\n    30→\n    31→class ApplicationPipelineStatus(str, enum.Enum):\n    32→    \"\"\"Application pipeline state machine.\"\"\"\n    33→    QUEUED = \"QUEUED\"\n    34→    PARSING = \"PARSING\"\n    35→    TAILORING = \"TAILORING\"\n    36→    RESEARCHING = \"RESEARCHING\"\n    37→    COMPOSING = \"COMPOSING\"\n    38→    AWAITING_REVIEW = \"AWAITING_REVIEW\"\n    39→    APPROVED = \"APPROVED\"\n    40→    REJECTED = \"REJECTED\"\n    41→    SUBMITTED = \"SUBMITTED\"\n    42→    SENT = \"SENT\"\n    43→    TRACKED = \"TRACKED\"\n    44→    FAILED = \"FAILED\"\n    45→    REQUIRES_MANUAL = \"REQUIRES_MANUAL\"\n    46→\n    47→\n    48→class ContactConfidence(str, enum.Enum):\n    49→    \"\"\"Contact confidence level.\"\"\"\n    50→    HIGH = \"HIGH\"\n    51→    MEDIUM = \"MEDIUM\"\n    52→    LOW = \"LOW\"\n    53→\n    54→\n    55→class OutreachStatus(str, enum.Enum):\n    56→    \"\"\"Outreach email status.\"\"\"\n    57→    DRAFT = \"DRAFT\"\n    58→    SENT = \"SENT\"\n    59→    BOUNCED = \"BOUNCED\"\n    60→    REPLIED = \"REPLIED\"\n    61→\n    62→\n    63→# ─── Parsed JD ───────────────────────────────────────────────────────────────\n    64→\n    65→class ParsedJD(Base):\n    66→    \"\"\"Cached structured parse of a job description.\"\"\"\n    67→\n    68→    __tablename__ = \"parsed_jds\"\n    69→\n    70→    id: Mapped[uuid.UUID] = mapped_column(\n    71→        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n    72→    )\n    73→    job_id: Mapped[uuid.UUID] = mapped_column(\n    74→        ForeignKey(\"discovered_jobs.id\", ondelete=\"CASCADE\"),\n    75→        unique=True,\n    76→        nullable=False,\n    77→    )\n    78→    required_skills: Mapped[list[str]] = mapped_column(\n    79→        ARRAY(String), server_default=\"{}\", nullable=False\n    80→    )\n    81→    preferred_skills: Mapped[list[str]] = mapped_column(\n    82→        ARRAY(String), server_default=\"{}\", nullable=False\n    83→    )\n    84→    seniority_level: Mapped[Optional[str]] = mapped_column(String(100))\n    85→    tech_stack: Mapped[list[str]] = mapped_column(\n    86→        ARRAY(String), server_default=\"{}\", nullable=False\n    87→    )\n    88→    culture_signals: Mapped[list[str]] = mapped_column(\n    89→        ARRAY(String), server_default=\"{}\", nullable=False\n    90→    )\n    91→    tone: Mapped[Optional[str]] = mapped_column(String(50))\n    92→    pain_points: Mapped[list[str]] = mapped_column(\n    93→        ARRAY(String), server_default=\"{}\", nullable=False\n    94→    )\n    95→    compensation_range: Mapped[Optional[str]] = mapped_column(String(255))\n    96→    red_flags: Mapped[list[str]] = mapped_column(\n    97→        ARRAY(String), server_default=\"{}\", nullable=False\n    98→    )\n    99→    application_instructions: Mapped[Optional[str]] = mapped_column(Text)\n   100→    parsed_at: Mapped[datetime] = mapped_column(\n   101→        DateTime(timezone=True), server_default=func.now(), nullable=False\n   102→    )\n   103→    created_at: Mapped[datetime] = mapped_column(\n   104→        DateTime(timezone=True), server_default=func.now(), nullable=False\n   105→    )\n   106→\n   107→\n   108→# ─── Application Pipeline ────────────────────────────────────────────────────\n   109→\n   110→class ApplicationPipeline(Base):\n   111→    \"\"\"Full pipeline state for a single job application.\"\"\"\n   112→\n   113→    __tablename__ = \"application_pipelines\"\n   114→\n   115→    id: Mapped[uuid.UUID] = mapped_column(\n   116→        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n   117→    )\n   118→    candidate_id: Mapped[uuid.UUID] = mapped_column(\n   119→        ForeignKey(\"candidates.id\", ondelete=\"CASCADE\"), nullable=False\n   120→    )\n   121→    job_id: Mapped[uuid.UUID] = mapped_column(\n   122→        ForeignKey(\"scored_jobs.id\", ondelete=\"CASCADE\"), nullable=False\n   123→    )\n   124→    status: Mapped[ApplicationPipelineStatus] = mapped_column(\n   125→        Enum(ApplicationPipelineStatus, name=\"application_pipeline_status\", create_type=False),\n   126→        server_default=\"QUEUED\",\n   127→        nullable=False,\n   128→    )\n   129→    approval_timestamp: Mapped[Optional[datetime]] = mapped_column(DateTime(timezone=True))\n   130→    submitted_at: Mapped[Optional[datetime]] = mapped_column(DateTime(timezone=True))\n   131→    screenshots: Mapped[list[str]] = mapped_column(\n   132→        ARRAY(String), server_default=\"{}\", nullable=False\n   133→    )\n   134→    created_at: Mapped[datetime] = mapped_column(\n   135→        DateTime(timezone=True), server_default=func.now(), nullable=False\n   136→    )\n   137→    updated_at: Mapped[datetime] = mapped_column(\n   138→        DateTime(timezone=True), server_default=func.now(), onupdate=func.now(), nullable=False\n   139→    )\n   140→\n   141→    # Relationships\n   142→    tailored_resume: Mapped[Optional[\"TailoredResume\"]] = relationship(\n   143→        back_populates=\"pipeline\", uselist=False, cascade=\"all, delete-orphan\"\n   144→    )\n   145→    company_intel: Mapped[Optional[\"CompanyIntel\"]] = relationship(\n   146→        back_populates=\"pipeline\", uselist=False, cascade=\"all, delete-orphan\"\n   147→    )\n   148→    contacts: Mapped[list[\"Contact\"]] = relationship(\n   149→        back_populates=\"pipeline\", cascade=\"all, delete-orphan\"\n   150→    )\n   151→    outreach_email: Mapped[Optional[\"OutreachEmail\"]] = relationship(\n   152→        back_populates=\"pipeline\", uselist=False, cascade=\"all, delete-orphan\"\n   153→    )\n   154→    crm_events: Mapped[list[\"CRMEvent\"]] = relationship(\n   155→        back_populates=\"pipeline\", cascade=\"all, delete-orphan\"\n   156→    )\n   157→\n   158→\n   159→# ─── Tailored Resume ─────────────────────────────────────────────────────────\n   160→\n   161→class TailoredResume(Base):\n   162→    \"\"\"Version-controlled tailored resume for a specific job application.\"\"\"\n   163→\n   164→    __tablename__ = \"tailored_resumes\"\n   165→\n   166→    id: Mapped[uuid.UUID] = mapped_column(\n   167→        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n   168→    )\n   169→    pipeline_id: Mapped[uuid.UUID] = mapped_column(\n   170→        ForeignKey(\"application_pipelines.id\", ondelete=\"CASCADE\"),\n   171→        unique=True,\n   172→        nullable=False,\n   173→    )\n   174→    original_text: Mapped[str] = mapped_column(Text, nullable=False)\n   175→    tailored_text: Mapped[str] = mapped_column(Text, nullable=False)\n   176→    change_log: Mapped[list[str]] = mapped_column(\n   177→        ARRAY(String), server_default=\"{}\", nullable=False\n   178→    )\n   179→    gap_analysis: Mapped[Optional[str]] = mapped_column(Text)\n   180→    created_at: Mapped[datetime] = mapped_column(\n   181→        DateTime(timezone=True), server_default=func.now(), nullable=False\n   182→    )\n   183→\n   184→    # Relationships\n   185→    pipeline: Mapped[\"ApplicationPipeline\"] = relationship(back_populates=\"tailored_resume\")\n   186→\n   187→\n   188→# ─── Company Intel ───────────────────────────────────────────────────────────\n   189→\n   190→class CompanyIntel(Base):\n   191→    \"\"\"Cached company research for a pipeline.\"\"\"\n   192→\n   193→    __tablename__ = \"company_intel\"\n   194→\n   195→    id: Mapped[uuid.UUID] = mapped_column(\n   196→        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n   197→    )\n   198→    pipeline_id: Mapped[uuid.UUID] = mapped_column(\n   199→        ForeignKey(\"application_pipelines.id\", ondelete=\"CASCADE\"),\n   200→        unique=True,\n   201→        nullable=False,\n   202→    )\n   203→    company_name: Mapped[str] = mapped_column(String(255), nullable=False)\n   204→    about: Mapped[Optional[str]] = mapped_column(Text)\n   205→    recent_news: Mapped[list[str]] = mapped_column(\n   206→        ARRAY(String), server_default=\"{}\", nullable=False\n   207→    )\n   208→    tech_stack: Mapped[list[str]] = mapped_column(\n   209→        ARRAY(String), server_default=\"{}\", nullable=False\n   210→    )\n   211→    engineering_culture: Mapped[Optional[str]] = mapped_column(Text)\n   212→    growth_stage: Mapped[Optional[str]] = mapped_column(String(100))\n   213→    team_size: Mapped[Optional[str]] = mapped_column(String(100))\n   214→    notable_facts: Mapped[list[str]] = mapped_column(\n   215→        ARRAY(String), server_default=\"{}\", nullable=False\n   216→    )\n   217→    researched_at: Mapped[datetime] = mapped_column(\n   218→        DateTime(timezone=True), server_default=func.now(), nullable=False\n   219→    )\n   220→    created_at: Mapped[datetime] = mapped_column(\n   221→        DateTime(timezone=True), server_default=func.now(), nullable=False\n   222→    )\n   223→    updated_at: Mapped[datetime] = mapped_column(\n   224→        DateTime(timezone=True), server_default=func.now(), onupdate=func.now(), nullable=False\n   225→    )\n   226→\n   227→    # Relationships\n   228→    pipeline: Mapped[\"ApplicationPipeline\"] = relationship(back_populates=\"company_intel\")\n   229→\n   230→\n   231→# ─── Contact ─────────────────────────────────────────────────────────────────\n   232→\n   233→class Contact(Base):\n   234→    \"\"\"A contact person discovered for a company.\"\"\"\n   235→\n   236→    __tablename__ = \"contacts\"\n   237→\n   238→    id: Mapped[uuid.UUID] = mapped_column(\n   239→        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n   240→    )\n   241→    pipeline_id: Mapped[uuid.UUID] = mapped_column(\n   242→        ForeignKey(\"application_pipelines.id\", ondelete=\"CASCADE\"), nullable=False\n   243→    )\n   244→    name: Mapped[str] = mapped_column(String(255), nullable=False)\n   245→    title: Mapped[str] = mapped_column(String(255), nullable=False)\n   246→    email: Mapped[str] = mapped_column(String(255), nullable=False)\n   247→    linkedin_url: Mapped[Optional[str]] = mapped_column(String(500))\n   248→    confidence: Mapped[ContactConfidence] = mapped_column(\n   249→        Enum(ContactConfidence, name=\"contact_confidence\", create_type=False),\n   250→        server_default=\"LOW\",\n   251→        nullable=False,\n   252→    )\n   253→    fallback_email: Mapped[Optional[str]] = mapped_column(String(255))\n   254→    source: Mapped[Optional[str]] = mapped_column(String(100))\n   255→    found_at: Mapped[datetime] = mapped_column(\n   256→        DateTime(timezone=True), server_default=func.now(), nullable=False\n   257→    )\n   258→    created_at: Mapped[datetime] = mapped_column(\n   259→        DateTime(timezone=True), server_default=func.now(), nullable=False\n   260→    )\n   261→\n   262→    # Relationships\n   263→    pipeline: Mapped[\"ApplicationPipeline\"] = relationship(back_populates=\"contacts\")\n   264→\n   265→\n   266→# ─── Outreach Email ──────────────────────────────────────────────────────────\n   267→\n   268→class OutreachEmail(Base):\n   269→    \"\"\"Draft outreach email — moves to SENT only after Review Dashboard approval.\"\"\"\n   270→\n   271→    __tablename__ = \"outreach_emails\"\n   272→\n   273→    id: Mapped[uuid.UUID] = mapped_column(\n   274→        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n   275→    )\n   276→    pipeline_id: Mapped[uuid.UUID] = mapped_column(\n   277→        ForeignKey(\"application_pipelines.id\", ondelete=\"CASCADE\"),\n   278→        unique=True,\n   279→        nullable=False,\n   280→    )\n   281→    subject_lines: Mapped[list[str]] = mapped_column(\n   282→        ARRAY(String), server_default=\"{}\", nullable=False\n   283→    )\n   284→    body: Mapped[str] = mapped_column(Text, nullable=False)\n   285→    status: Mapped[OutreachStatus] = mapped_column(\n   286→        Enum(OutreachStatus, name=\"outreach_status\", create_type=False),\n   287→        server_default=\"DRAFT\",\n   288→        nullable=False,\n   289→    )\n   290→    created_at: Mapped[datetime] = mapped_column(\n   291→        DateTime(timezone=True), server_default=func.now(), nullable=False\n   292→    )\n   293→\n   294→    # Relationships\n   295→    pipeline: Mapped[\"ApplicationPipeline\"] = relationship(back_populates=\"outreach_email\")\n   296→\n   297→\n   298→# ─── CRM Event ───────────────────────────────────────────────────────────────\n   299→\n   300→class CRMEvent(Base):\n   301→    \"\"\"Immutable timeline event for a job application.\"\"\"\n   302→\n   303→    __tablename__ = \"crm_events\"\n   304→\n   305→    id: Mapped[uuid.UUID] = mapped_column(\n   306→        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n   307→    )\n   308→    pipeline_id: Mapped[uuid.UUID] = mapped_column(\n   309→        ForeignKey(\"application_pipelines.id\", ondelete=\"CASCADE\"), nullable=False\n   310→    )\n   311→    event_type: Mapped[str] = mapped_column(String(100), nullable=False)\n   312→    payload: Mapped[dict] = mapped_column(JSONB, server_default=\"{}\", nullable=False)\n   313→    created_at: Mapped[datetime] = mapped_column(\n   314→        DateTime(timezone=True), server_default=func.now(), nullable=False\n   315→    )\n   316→\n   317→    # Relationships\n   318→    pipeline: Mapped[\"ApplicationPipeline\"] = relationship(back_populates=\"crm_events\")\n   319→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"deb7dcc2-71e5-4120-93c5-a6ba962cce9e","uuid":"03ae9b3f-fa5a-4942-aebd-ae7063fdb0f1","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/models/application.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nSQLAlchemy ORM models for the Application Engine.\n\nTables:\n  - parsed_jds: Structured JD parsing output\n  - application_pipelines: Pipeline state machine (QUEUED → SENT)\n  - tailored_resumes: Resume rewrites for specific jobs\n  - company_intel: Company research artifacts\n  - contacts: Discovered recipient contacts\n  - outreach_emails: Draft outreach emails\n  - crm_events: Append-only event log per pipeline\n\"\"\"\n\nimport uuid\nfrom datetime import datetime\nfrom typing import Optional\nimport enum\n\nfrom sqlalchemy import String, Text, Integer, DateTime, ForeignKey, func, Enum\nfrom sqlalchemy.orm import Mapped, mapped_column, relationship\nfrom sqlalchemy.dialects.postgresql import UUID, ARRAY, JSONB\n\nfrom backend.database import Base\n\n\n# ─── Enums ───────────────────────────────────────────────────────────────────\n\nclass ApplicationPipelineStatus(str, enum.Enum):\n    \"\"\"Application pipeline state machine.\"\"\"\n    QUEUED = \"QUEUED\"\n    PARSING = \"PARSING\"\n    TAILORING = \"TAILORING\"\n    RESEARCHING = \"RESEARCHING\"\n    COMPOSING = \"COMPOSING\"\n    AWAITING_REVIEW = \"AWAITING_REVIEW\"\n    APPROVED = \"APPROVED\"\n    REJECTED = \"REJECTED\"\n    SUBMITTED = \"SUBMITTED\"\n    SENT = \"SENT\"\n    TRACKED = \"TRACKED\"\n    FAILED = \"FAILED\"\n    REQUIRES_MANUAL = \"REQUIRES_MANUAL\"\n\n\nclass ContactConfidence(str, enum.Enum):\n    \"\"\"Contact confidence level.\"\"\"\n    HIGH = \"HIGH\"\n    MEDIUM = \"MEDIUM\"\n    LOW = \"LOW\"\n\n\nclass OutreachStatus(str, enum.Enum):\n    \"\"\"Outreach email status.\"\"\"\n    DRAFT = \"DRAFT\"\n    SENT = \"SENT\"\n    BOUNCED = \"BOUNCED\"\n    REPLIED = \"REPLIED\"\n\n\n# ─── Parsed JD ───────────────────────────────────────────────────────────────\n\nclass ParsedJD(Base):\n    \"\"\"Cached structured parse of a job description.\"\"\"\n\n    __tablename__ = \"parsed_jds\"\n\n    id: Mapped[uuid.UUID] = mapped_column(\n        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n    )\n    job_id: Mapped[uuid.UUID] = mapped_column(\n        ForeignKey(\"discovered_jobs.id\", ondelete=\"CASCADE\"),\n        unique=True,\n        nullable=False,\n    )\n    required_skills: Mapped[list[str]] = mapped_column(\n        ARRAY(String), server_default=\"{}\", nullable=False\n    )\n    preferred_skills: Mapped[list[str]] = mapped_column(\n        ARRAY(String), server_default=\"{}\", nullable=False\n    )\n    seniority_level: Mapped[Optional[str]] = mapped_column(String(100))\n    tech_stack: Mapped[list[str]] = mapped_column(\n        ARRAY(String), server_default=\"{}\", nullable=False\n    )\n    culture_signals: Mapped[list[str]] = mapped_column(\n        ARRAY(String), server_default=\"{}\", nullable=False\n    )\n    tone: Mapped[Optional[str]] = mapped_column(String(50))\n    pain_points: Mapped[list[str]] = mapped_column(\n        ARRAY(String), server_default=\"{}\", nullable=False\n    )\n    compensation_range: Mapped[Optional[str]] = mapped_column(String(255))\n    red_flags: Mapped[list[str]] = mapped_column(\n        ARRAY(String), server_default=\"{}\", nullable=False\n    )\n    application_instructions: Mapped[Optional[str]] = mapped_column(Text)\n    parsed_at: Mapped[datetime] = mapped_column(\n        DateTime(timezone=True), server_default=func.now(), nullable=False\n    )\n    created_at: Mapped[datetime] = mapped_column(\n        DateTime(timezone=True), server_default=func.now(), nullable=False\n    )\n\n\n# ─── Application Pipeline ────────────────────────────────────────────────────\n\nclass ApplicationPipeline(Base):\n    \"\"\"Full pipeline state for a single job application.\"\"\"\n\n    __tablename__ = \"application_pipelines\"\n\n    id: Mapped[uuid.UUID] = mapped_column(\n        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n    )\n    candidate_id: Mapped[uuid.UUID] = mapped_column(\n        ForeignKey(\"candidates.id\", ondelete=\"CASCADE\"), nullable=False\n    )\n    job_id: Mapped[uuid.UUID] = mapped_column(\n        ForeignKey(\"scored_jobs.id\", ondelete=\"CASCADE\"), nullable=False\n    )\n    status: Mapped[ApplicationPipelineStatus] = mapped_column(\n        Enum(ApplicationPipelineStatus, name=\"application_pipeline_status\", create_type=False),\n        server_default=\"QUEUED\",\n        nullable=False,\n    )\n    approval_timestamp: Mapped[Optional[datetime]] = mapped_column(DateTime(timezone=True))\n    submitted_at: Mapped[Optional[datetime]] = mapped_column(DateTime(timezone=True))\n    screenshots: Mapped[list[str]] = mapped_column(\n        ARRAY(String), server_default=\"{}\", nullable=False\n    )\n    created_at: Mapped[datetime] = mapped_column(\n        DateTime(timezone=True), server_default=func.now(), nullable=False\n    )\n    updated_at: Mapped[datetime] = mapped_column(\n        DateTime(timezone=True), server_default=func.now(), onupdate=func.now(), nullable=False\n    )\n\n    # Relationships\n    tailored_resume: Mapped[Optional[\"TailoredResume\"]] = relationship(\n        back_populates=\"pipeline\", uselist=False, cascade=\"all, delete-orphan\"\n    )\n    company_intel: Mapped[Optional[\"CompanyIntel\"]] = relationship(\n        back_populates=\"pipeline\", uselist=False, cascade=\"all, delete-orphan\"\n    )\n    contacts: Mapped[list[\"Contact\"]] = relationship(\n        back_populates=\"pipeline\", cascade=\"all, delete-orphan\"\n    )\n    outreach_email: Mapped[Optional[\"OutreachEmail\"]] = relationship(\n        back_populates=\"pipeline\", uselist=False, cascade=\"all, delete-orphan\"\n    )\n    crm_events: Mapped[list[\"CRMEvent\"]] = relationship(\n        back_populates=\"pipeline\", cascade=\"all, delete-orphan\"\n    )\n\n\n# ─── Tailored Resume ─────────────────────────────────────────────────────────\n\nclass TailoredResume(Base):\n    \"\"\"Version-controlled tailored resume for a specific job application.\"\"\"\n\n    __tablename__ = \"tailored_resumes\"\n\n    id: Mapped[uuid.UUID] = mapped_column(\n        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n    )\n    pipeline_id: Mapped[uuid.UUID] = mapped_column(\n        ForeignKey(\"application_pipelines.id\", ondelete=\"CASCADE\"),\n        unique=True,\n        nullable=False,\n    )\n    original_text: Mapped[str] = mapped_column(Text, nullable=False)\n    tailored_text: Mapped[str] = mapped_column(Text, nullable=False)\n    change_log: Mapped[list[str]] = mapped_column(\n        ARRAY(String), server_default=\"{}\", nullable=False\n    )\n    gap_analysis: Mapped[Optional[str]] = mapped_column(Text)\n    created_at: Mapped[datetime] = mapped_column(\n        DateTime(timezone=True), server_default=func.now(), nullable=False\n    )\n\n    # Relationships\n    pipeline: Mapped[\"ApplicationPipeline\"] = relationship(back_populates=\"tailored_resume\")\n\n\n# ─── Company Intel ───────────────────────────────────────────────────────────\n\nclass CompanyIntel(Base):\n    \"\"\"Cached company research for a pipeline.\"\"\"\n\n    __tablename__ = \"company_intel\"\n\n    id: Mapped[uuid.UUID] = mapped_column(\n        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n    )\n    pipeline_id: Mapped[uuid.UUID] = mapped_column(\n        ForeignKey(\"application_pipelines.id\", ondelete=\"CASCADE\"),\n        unique=True,\n        nullable=False,\n    )\n    company_name: Mapped[str] = mapped_column(String(255), nullable=False)\n    about: Mapped[Optional[str]] = mapped_column(Text)\n    recent_news: Mapped[list[str]] = mapped_column(\n        ARRAY(String), server_default=\"{}\", nullable=False\n    )\n    tech_stack: Mapped[list[str]] = mapped_column(\n        ARRAY(String), server_default=\"{}\", nullable=False\n    )\n    engineering_culture: Mapped[Optional[str]] = mapped_column(Text)\n    growth_stage: Mapped[Optional[str]] = mapped_column(String(100))\n    team_size: Mapped[Optional[str]] = mapped_column(String(100))\n    notable_facts: Mapped[list[str]] = mapped_column(\n        ARRAY(String), server_default=\"{}\", nullable=False\n    )\n    researched_at: Mapped[datetime] = mapped_column(\n        DateTime(timezone=True), server_default=func.now(), nullable=False\n    )\n    created_at: Mapped[datetime] = mapped_column(\n        DateTime(timezone=True), server_default=func.now(), nullable=False\n    )\n    updated_at: Mapped[datetime] = mapped_column(\n        DateTime(timezone=True), server_default=func.now(), onupdate=func.now(), nullable=False\n    )\n\n    # Relationships\n    pipeline: Mapped[\"ApplicationPipeline\"] = relationship(back_populates=\"company_intel\")\n\n\n# ─── Contact ─────────────────────────────────────────────────────────────────\n\nclass Contact(Base):\n    \"\"\"A contact person discovered for a company.\"\"\"\n\n    __tablename__ = \"contacts\"\n\n    id: Mapped[uuid.UUID] = mapped_column(\n        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n    )\n    pipeline_id: Mapped[uuid.UUID] = mapped_column(\n        ForeignKey(\"application_pipelines.id\", ondelete=\"CASCADE\"), nullable=False\n    )\n    name: Mapped[str] = mapped_column(String(255), nullable=False)\n    title: Mapped[str] = mapped_column(String(255), nullable=False)\n    email: Mapped[str] = mapped_column(String(255), nullable=False)\n    linkedin_url: Mapped[Optional[str]] = mapped_column(String(500))\n    confidence: Mapped[ContactConfidence] = mapped_column(\n        Enum(ContactConfidence, name=\"contact_confidence\", create_type=False),\n        server_default=\"LOW\",\n        nullable=False,\n    )\n    fallback_email: Mapped[Optional[str]] = mapped_column(String(255))\n    source: Mapped[Optional[str]] = mapped_column(String(100))\n    found_at: Mapped[datetime] = mapped_column(\n        DateTime(timezone=True), server_default=func.now(), nullable=False\n    )\n    created_at: Mapped[datetime] = mapped_column(\n        DateTime(timezone=True), server_default=func.now(), nullable=False\n    )\n\n    # Relationships\n    pipeline: Mapped[\"ApplicationPipeline\"] = relationship(back_populates=\"contacts\")\n\n\n# ─── Outreach Email ──────────────────────────────────────────────────────────\n\nclass OutreachEmail(Base):\n    \"\"\"Draft outreach email — moves to SENT only after Review Dashboard approval.\"\"\"\n\n    __tablename__ = \"outreach_emails\"\n\n    id: Mapped[uuid.UUID] = mapped_column(\n        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n    )\n    pipeline_id: Mapped[uuid.UUID] = mapped_column(\n        ForeignKey(\"application_pipelines.id\", ondelete=\"CASCADE\"),\n        unique=True,\n        nullable=False,\n    )\n    subject_lines: Mapped[list[str]] = mapped_column(\n        ARRAY(String), server_default=\"{}\", nullable=False\n    )\n    body: Mapped[str] = mapped_column(Text, nullable=False)\n    status: Mapped[OutreachStatus] = mapped_column(\n        Enum(OutreachStatus, name=\"outreach_status\", create_type=False),\n        server_default=\"DRAFT\",\n        nullable=False,\n    )\n    created_at: Mapped[datetime] = mapped_column(\n        DateTime(timezone=True), server_default=func.now(), nullable=False\n    )\n\n    # Relationships\n    pipeline: Mapped[\"ApplicationPipeline\"] = relationship(back_populates=\"outreach_email\")\n\n\n# ─── CRM Event ───────────────────────────────────────────────────────────────\n\nclass CRMEvent(Base):\n    \"\"\"Immutable timeline event for a job application.\"\"\"\n\n    __tablename__ = \"crm_events\"\n\n    id: Mapped[uuid.UUID] = mapped_column(\n        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n    )\n    pipeline_id: Mapped[uuid.UUID] = mapped_column(\n        ForeignKey(\"application_pipelines.id\", ondelete=\"CASCADE\"), nullable=False\n    )\n    event_type: Mapped[str] = mapped_column(String(100), nullable=False)\n    payload: Mapped[dict] = mapped_column(JSONB, server_default=\"{}\", nullable=False)\n    created_at: Mapped[datetime] = mapped_column(\n        DateTime(timezone=True), server_default=func.now(), nullable=False\n    )\n\n    # Relationships\n    pipeline: Mapped[\"ApplicationPipeline\"] = relationship(back_populates=\"crm_events\")\n","numLines":319,"startLine":1,"totalLines":319}}}}
