{"t":"2026-05-20T20:08:07.280Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01H1hVQ2wDrDkstCuTaRy8b6","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Pydantic v2 schemas for the Application Engine.\n     6→\n     7→These are the data contracts between application agents — separate from ORM models.\n     8→\"\"\"\n     9→\n    10→from __future__ import annotations\n    11→\n    12→from datetime import datetime\n    13→from typing import Optional\n    14→from uuid import UUID\n    15→\n    16→from pydantic import BaseModel, Field, ConfigDict\n    17→\n    18→\n    19→# ─── Parsed JD ────────────────────────────────────────────────────────────────\n    20→\n    21→\n    22→class ParsedJDSchema(BaseModel):\n    23→    \"\"\"\n    24→    Deep-parsed job description — every signal needed for tailoring the application.\n    25→\n    26→    Generated by JDParser. Cached in PostgreSQL — reused if job is re-processed.\n    27→    \"\"\"\n    28→\n    29→    model_config = ConfigDict(from_attributes=True)\n    30→\n    31→    id: Optional[UUID] = None\n    32→    job_id: UUID\n    33→    required_skills: list[str] = Field(default_factory=list)\n    34→    preferred_skills: list[str] = Field(default_factory=list)\n    35→    seniority_level: str = \"senior\"\n    36→    tech_stack: list[str] = Field(default_factory=list)\n    37→    culture_signals: list[str] = Field(default_factory=list)\n    38→    tone: str = \"professional\"\n    39→    pain_points: list[str] = Field(default_factory=list)\n    40→    compensation_range: Optional[str] = None\n    41→    red_flags: list[str] = Field(default_factory=list)\n    42→    application_instructions: Optional[str] = None\n    43→    parsed_at: Optional[datetime] = None\n    44→\n    45→\n    46→# ─── Tailored Resume ──────────────────────────────────────────────────────────\n    47→\n    48→\n    49→class TailoredResumeSchema(BaseModel):\n    50→    \"\"\"\n    51→    Rewritten resume tailored for a specific role.\n    52→\n    53→    Never fabricates experience — rewrites framing, ordering, and emphasis.\n    54→    \"\"\"\n    55→\n    56→    model_config = ConfigDict(from_attributes=True)\n    57→\n    58→    id: Optional[UUID] = None\n    59→    pipeline_id: UUID\n    60→    original_text: str\n    61→    tailored_text: str\n    62→    change_log: list[str] = Field(default_factory=list)\n    63→    gap_analysis: Optional[str] = None\n    64→    created_at: Optional[datetime] = None\n    65→\n    66→\n    67→# ─── Company Intel ────────────────────────────────────────────────────────────\n    68→\n    69→\n    70→class CompanyIntelSchema(BaseModel):\n    71→    \"\"\"\n    72→    Synthesized company research for outreach composition.\n    73→\n    74→    Cached 7 days — don't re-scrape the same company within a week.\n    75→    \"\"\"\n    76→\n    77→    model_config = ConfigDict(from_attributes=True)\n    78→\n    79→    id: Optional[UUID] = None\n    80→    pipeline_id: UUID\n    81→    company_name: str\n    82→    about: Optional[str] = None\n    83→    recent_news: list[str] = Field(default_factory=list)\n    84→    tech_stack: list[str] = Field(default_factory=list)\n    85→    engineering_culture: Optional[str] = None\n    86→    growth_stage: Optional[str] = None\n    87→    team_size: Optional[str] = None\n    88→    notable_facts: list[str] = Field(default_factory=list)\n    89→    researched_at: Optional[datetime] = None\n    90→\n    91→\n    92→# ─── Contact ──────────────────────────────────────────────────────────────────\n    93→\n    94→\n    95→class ContactSchema(BaseModel):\n    96→    \"\"\"\n    97→    The right person to send the cold outreach to.\n    98→\n    99→    Confidence levels: HIGH = verified email; MEDIUM = pattern-matched; LOW = generic fallback.\n   100→    \"\"\"\n   101→\n   102→    model_config = ConfigDict(from_attributes=True)\n   103→\n   104→    id: Optional[UUID] = None\n   105→    pipeline_id: UUID\n   106→    name: str\n   107→    title: str\n   108→    email: str\n   109→    linkedin_url: Optional[str] = None\n   110→    confidence: str = \"LOW\"  # HIGH | MEDIUM | LOW\n   111→    fallback_email: Optional[str] = None\n   112→    source: Optional[str] = None\n   113→    found_at: Optional[datetime] = None\n   114→\n   115→\n   116→# ─── Outreach Email ───────────────────────────────────────────────────────────\n   117→\n   118→\n   119→class OutreachEmailSchema(BaseModel):\n   120→    \"\"\"\n   121→    A cold email that doesn't read like a cold email.\n   122→\n   123→    Stays in DRAFT status until approved in the Review Dashboard.\n   124→    Max 150–200 words. Grounded in real company context.\n   125→    \"\"\"\n   126→\n   127→    model_config = ConfigDict(from_attributes=True)\n   128→\n   129→    id: Optional[UUID] = None\n   130→    pipeline_id: UUID\n   131→    subject_lines: list[str] = Field(\n   132→        default_factory=list,\n   133→        description=\"3 subject line variants shown in Review Dashboard\",\n   134→    )\n   135→    body: str = Field(description=\"Email body — 150–200 words max\")\n   136→    status: str = \"DRAFT\"  # DRAFT | SENT | BOUNCED | REPLIED\n   137→    created_at: Optional[datetime] = None\n   138→\n   139→\n   140→# ─── Application Pipeline ─────────────────────────────────────────────────────\n   141→\n   142→\n   143→class ApplicationPipelineSchema(BaseModel):\n   144→    \"\"\"\n   145→    Full pipeline state for a single approved job application.\n   146→\n   147→    Status flow:\n   148→      QUEUED → PARSING → TAILORING → RESEARCHING → COMPOSING →\n   149→      AWAITING_REVIEW → APPROVED/REJECTED → SUBMITTED → SENT → TRACKED\n   150→    \"\"\"\n   151→\n   152→    model_config = ConfigDict(from_attributes=True)\n   153→\n   154→    id: Optional[UUID] = None\n   155→    candidate_id: UUID\n   156→    job_id: UUID\n   157→    status: str = \"QUEUED\"\n   158→    parsed_jd: Optional[ParsedJDSchema] = None\n   159→    tailored_resume: Optional[TailoredResumeSchema] = None\n   160→    company_intel: Optional[CompanyIntelSchema] = None\n   161→    contact: Optional[ContactSchema] = None\n   162→    outreach_email: Optional[OutreachEmailSchema] = None\n   163→    approval_timestamp: Optional[datetime] = None\n   164→    submitted_at: Optional[datetime] = None\n   165→    screenshots: list[str] = Field(default_factory=list)\n   166→    created_at: Optional[datetime] = None\n   167→    updated_at: Optional[datetime] = None\n   168→\n   169→\n   170→# ─── CRM Event ────────────────────────────────────────────────────────────────\n   171→\n   172→\n   173→class CRMEventSchema(BaseModel):\n   174→    \"\"\"An immutable timeline event in the application journey.\"\"\"\n   175→\n   176→    model_config = ConfigDict(from_attributes=True)\n   177→\n   178→    id: Optional[UUID] = None\n   179→    pipeline_id: UUID\n   180→    event_type: str = Field(\n   181→        description=\"APPLIED | EMAIL_SENT | EMAIL_OPENED | RESPONDED | INTERVIEW_SCHEDULED | OFFER_RECEIVED | REJECTED | PLACED\"\n   182→    )\n   183→    payload: Optional[dict] = Field(default_factory=dict)\n   184→    created_at: Optional[datetime] = None\n   185→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"deb7dcc2-71e5-4120-93c5-a6ba962cce9e","uuid":"3a566829-967d-42e8-8f1a-64687626a3ed","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/application/schemas.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nPydantic v2 schemas for the Application Engine.\n\nThese are the data contracts between application agents — separate from ORM models.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import datetime\nfrom typing import Optional\nfrom uuid import UUID\n\nfrom pydantic import BaseModel, Field, ConfigDict\n\n\n# ─── Parsed JD ────────────────────────────────────────────────────────────────\n\n\nclass ParsedJDSchema(BaseModel):\n    \"\"\"\n    Deep-parsed job description — every signal needed for tailoring the application.\n\n    Generated by JDParser. Cached in PostgreSQL — reused if job is re-processed.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    job_id: UUID\n    required_skills: list[str] = Field(default_factory=list)\n    preferred_skills: list[str] = Field(default_factory=list)\n    seniority_level: str = \"senior\"\n    tech_stack: list[str] = Field(default_factory=list)\n    culture_signals: list[str] = Field(default_factory=list)\n    tone: str = \"professional\"\n    pain_points: list[str] = Field(default_factory=list)\n    compensation_range: Optional[str] = None\n    red_flags: list[str] = Field(default_factory=list)\n    application_instructions: Optional[str] = None\n    parsed_at: Optional[datetime] = None\n\n\n# ─── Tailored Resume ──────────────────────────────────────────────────────────\n\n\nclass TailoredResumeSchema(BaseModel):\n    \"\"\"\n    Rewritten resume tailored for a specific role.\n\n    Never fabricates experience — rewrites framing, ordering, and emphasis.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    pipeline_id: UUID\n    original_text: str\n    tailored_text: str\n    change_log: list[str] = Field(default_factory=list)\n    gap_analysis: Optional[str] = None\n    created_at: Optional[datetime] = None\n\n\n# ─── Company Intel ────────────────────────────────────────────────────────────\n\n\nclass CompanyIntelSchema(BaseModel):\n    \"\"\"\n    Synthesized company research for outreach composition.\n\n    Cached 7 days — don't re-scrape the same company within a week.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    pipeline_id: UUID\n    company_name: str\n    about: Optional[str] = None\n    recent_news: list[str] = Field(default_factory=list)\n    tech_stack: list[str] = Field(default_factory=list)\n    engineering_culture: Optional[str] = None\n    growth_stage: Optional[str] = None\n    team_size: Optional[str] = None\n    notable_facts: list[str] = Field(default_factory=list)\n    researched_at: Optional[datetime] = None\n\n\n# ─── Contact ──────────────────────────────────────────────────────────────────\n\n\nclass ContactSchema(BaseModel):\n    \"\"\"\n    The right person to send the cold outreach to.\n\n    Confidence levels: HIGH = verified email; MEDIUM = pattern-matched; LOW = generic fallback.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    pipeline_id: UUID\n    name: str\n    title: str\n    email: str\n    linkedin_url: Optional[str] = None\n    confidence: str = \"LOW\"  # HIGH | MEDIUM | LOW\n    fallback_email: Optional[str] = None\n    source: Optional[str] = None\n    found_at: Optional[datetime] = None\n\n\n# ─── Outreach Email ───────────────────────────────────────────────────────────\n\n\nclass OutreachEmailSchema(BaseModel):\n    \"\"\"\n    A cold email that doesn't read like a cold email.\n\n    Stays in DRAFT status until approved in the Review Dashboard.\n    Max 150–200 words. Grounded in real company context.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    pipeline_id: UUID\n    subject_lines: list[str] = Field(\n        default_factory=list,\n        description=\"3 subject line variants shown in Review Dashboard\",\n    )\n    body: str = Field(description=\"Email body — 150–200 words max\")\n    status: str = \"DRAFT\"  # DRAFT | SENT | BOUNCED | REPLIED\n    created_at: Optional[datetime] = None\n\n\n# ─── Application Pipeline ─────────────────────────────────────────────────────\n\n\nclass ApplicationPipelineSchema(BaseModel):\n    \"\"\"\n    Full pipeline state for a single approved job application.\n\n    Status flow:\n      QUEUED → PARSING → TAILORING → RESEARCHING → COMPOSING →\n      AWAITING_REVIEW → APPROVED/REJECTED → SUBMITTED → SENT → TRACKED\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    candidate_id: UUID\n    job_id: UUID\n    status: str = \"QUEUED\"\n    parsed_jd: Optional[ParsedJDSchema] = None\n    tailored_resume: Optional[TailoredResumeSchema] = None\n    company_intel: Optional[CompanyIntelSchema] = None\n    contact: Optional[ContactSchema] = None\n    outreach_email: Optional[OutreachEmailSchema] = None\n    approval_timestamp: Optional[datetime] = None\n    submitted_at: Optional[datetime] = None\n    screenshots: list[str] = Field(default_factory=list)\n    created_at: Optional[datetime] = None\n    updated_at: Optional[datetime] = None\n\n\n# ─── CRM Event ────────────────────────────────────────────────────────────────\n\n\nclass CRMEventSchema(BaseModel):\n    \"\"\"An immutable timeline event in the application journey.\"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    pipeline_id: UUID\n    event_type: str = Field(\n        description=\"APPLIED | EMAIL_SENT | EMAIL_OPENED | RESPONDED | INTERVIEW_SCHEDULED | OFFER_RECEIVED | REJECTED | PLACED\"\n    )\n    payload: Optional[dict] = Field(default_factory=dict)\n    created_at: Optional[datetime] = None\n","numLines":185,"startLine":1,"totalLines":185}}}}
{"t":"2026-05-20T20:08:07.289Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JwVUd49WRB2cRECibQRE7u","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Application Orchestrator — coordinates the full application pipeline for an approved job.\n     6→\n     7→Pipeline flow:\n     8→  receive_approved_job(job_id)\n     9→    → jd_parser.parse(job)\n    10→    → resume_tailor.tailor(parsed_jd, candidate)      ← parallel\n    11→    → company_intel.research(company)                  ← parallel\n    12→    → contact_finder.find(intel, parsed_jd)\n    13→    → outreach_composer.compose(all_context)\n    14→    → [PAUSE — await Review Dashboard approval]\n    15→    → auto_apply.submit(job, resume)                  ← only if APPROVED\n    16→    → log CRM events throughout\n    17→\n    18→Status machine:\n    19→  QUEUED → PARSING → TAILORING → RESEARCHING → COMPOSING →\n    20→  AWAITING_REVIEW → APPROVED/REJECTED → SUBMITTED → SENT → TRACKED\n    21→\"\"\"\n    22→\n    23→import asyncio\n    24→from uuid import UUID\n    25→\n    26→import redis.asyncio as aioredis\n    27→import structlog\n    28→from anthropic import AsyncAnthropic\n    29→from sqlalchemy import select\n    30→from sqlalchemy.ext.asyncio import AsyncSession\n    31→\n    32→from backend.config import settings\n    33→from backend.agents.application.jd_parser import JDParser\n    34→from backend.agents.application.resume_tailor import ResumeTailor\n    35→from backend.agents.application.company_intel import CompanyIntelAgent\n    36→from backend.agents.application.contact_finder import ContactFinder\n    37→from backend.agents.application.outreach_composer import OutreachComposer\n    38→from backend.agents.application.auto_apply import AutoApplyAgent\n    39→from backend.agents.application.crm import CRM\n    40→from backend.agents.application.schemas import ApplicationPipelineSchema\n    41→from backend.agents.discovery.schemas import CandidateSchema\n    42→from backend.agents.discovery.identity_profiler import IdentityProfiler\n    43→from backend.models.discovery import Candidate as CandidateORM, DiscoveredJob, ScoredJob\n    44→from backend.models.application import ApplicationPipeline as ApplicationPipelineORM\n    45→\n    46→logger = structlog.get_logger(__name__)\n    47→\n    48→_STATUS_CHANNEL = \"agent.status.application\"\n    49→\n    50→\n    51→class ApplicationOrchestrator:\n    52→    \"\"\"\n    53→    Coordinates the full application pipeline for a single approved job.\n    54→\n    55→    resume_tailor and company_intel run concurrently — both need parsed_jd\n    56→    but don't depend on each other. This cuts wall-clock time roughly in half.\n    57→    \"\"\"\n    58→\n    59→    def __init__(\n    60→        self,\n    61→        db: AsyncSession,\n    62→        redis_client: aioredis.Redis,\n    63→    ):\n    64→        self._db = db\n    65→        self._redis = redis_client\n    66→        self._claude = AsyncAnthropic(api_key=settings.anthropic_api_key)\n    67→\n    68→        self._jd_parser = JDParser(db, self._claude)\n    69→        self._resume_tailor = ResumeTailor(db, self._claude)\n    70→        self._company_intel = CompanyIntelAgent(db, redis_client, self._claude)\n    71→        self._contact_finder = ContactFinder(db)\n    72→        self._composer = OutreachComposer(db, self._claude)\n    73→        self._auto_apply = AutoApplyAgent()\n    74→        self._crm = CRM(db)\n    75→        self._profiler = IdentityProfiler(redis_client, self._claude)\n    76→\n    77→    async def start(self, job_id: UUID, candidate_id: UUID) -> ApplicationPipelineSchema:\n    78→        \"\"\"\n    79→        Start the application pipeline for an approved job.\n    80→\n    81→        Runs through JD parsing, resume tailoring, company research,\n    82→        and outreach composition. Pauses at AWAITING_REVIEW.\n    83→\n    84→        Args:\n    85→            job_id: Approved job to process\n    86→            candidate_id: Candidate to build application for\n    87→\n    88→        Returns:\n    89→            ApplicationPipelineSchema with all artifacts ready for review\n    90→        \"\"\"\n    91→        log = logger.bind(job_id=str(job_id), candidate_id=str(candidate_id))\n    92→        log.info(\"application_orchestrator.starting\")\n    93→\n    94→        # Create pipeline record\n    95→        pipeline = await self._create_pipeline(job_id, candidate_id)\n    96→        pipeline_id = pipeline.id\n    97→\n    98→        try:\n    99→            # Load candidate + job\n   100→            candidate = await self._load_candidate(candidate_id)\n   101→            job = await self._load_scored_job(job_id, candidate_id)\n   102→            profile = await self._profiler.build_profile(candidate)\n   103→\n   104→            log.info(\"application_orchestrator.loaded\", candidate=candidate.name)\n   105→\n   106→            # Step 1: Parse JD\n   107→            await self._crm.update_pipeline_status(pipeline_id, \"PARSING\", \"jd_parser\")\n   108→            parsed_jd = await self._jd_parser.parse(job)\n   109→            await self._crm.log(pipeline_id, candidate_id, job_id, \"JD_PARSED\", {\n   110→                \"required_skills\": parsed_jd.required_skills[:5],\n   111→                \"seniority_level\": parsed_jd.seniority_level,\n   112→            })\n   113→            log.info(\"application_orchestrator.jd_parsed\", skills=len(parsed_jd.required_skills))\n   114→\n   115→            # Steps 2+3: Resume tailoring and company research run in parallel\n   116→            await self._crm.update_pipeline_status(pipeline_id, \"TAILORING\", \"resume_tailor+company_intel\")\n   117→\n   118→            resume_task = asyncio.create_task(\n   119→                self._resume_tailor.tailor(parsed_jd, candidate, profile)\n   120→            )\n   121→            intel_task = asyncio.create_task(\n   122→                self._company_intel.research(\n   123→                    job.job.company,\n   124→                    company_url=None,  # Could be extracted from job URL\n   125→                )\n   126→            )\n   127→\n   128→            resume, intel = await asyncio.gather(resume_task, intel_task)\n   129→\n   130→            await self._crm.log(pipeline_id, candidate_id, job_id, \"RESUME_TAILORED\", {\n   131→                \"version\": resume.version,\n   132→            })\n   133→            await self._crm.log(pipeline_id, candidate_id, job_id, \"COMPANY_RESEARCHED\", {\n   134→                \"company\": intel.company_name,\n   135→                \"growth_stage\": intel.growth_stage,\n   136→            })\n   137→            log.info(\"application_orchestrator.parallel_complete\")\n   138→\n   139→            # Step 4: Find contact\n   140→            await self._crm.update_pipeline_status(pipeline_id, \"RESEARCHING\", \"contact_finder\")\n   141→            contact = await self._contact_finder.find(intel, parsed_jd)\n   142→            await self._crm.log(pipeline_id, candidate_id, job_id, \"CONTACT_FOUND\", {\n   143→                \"email\": contact.email,\n   144→                \"confidence\": contact.confidence,\n   145→                \"source\": contact.source,\n   146→            })\n   147→\n   148→            # Step 5: Compose outreach\n   149→            await self._crm.update_pipeline_status(pipeline_id, \"COMPOSING\", \"outreach_composer\")\n   150→            email = await self._composer.compose(\n   151→                parsed_jd=parsed_jd,\n   152→                intel=intel,\n   153→                contact=contact,\n   154→                resume=resume,\n   155→                profile=profile,\n   156→                candidate_name=candidate.name,\n   157→                candidate_email=candidate.email,\n   158→                candidate_github=candidate.github_url,\n   159→                candidate_linkedin=candidate.linkedin_url,\n   160→            )\n   161→            await self._crm.log(pipeline_id, candidate_id, job_id, \"EMAIL_DRAFTED\", {\n   162→                \"subject\": email.subject,\n   163→                \"tone\": email.tone_used,\n   164→            })\n   165→\n   166→            # Pause — await human review\n   167→            await self._crm.update_pipeline_status(pipeline_id, \"AWAITING_REVIEW\")\n   168→            await self._publish_status(pipeline_id, candidate_id, \"AWAITING_REVIEW\")\n   169→\n   170→            log.info(\"application_orchestrator.awaiting_review\", pipeline_id=str(pipeline_id))\n   171→\n   172→            return ApplicationPipelineSchema(\n   173→                id=pipeline_id,\n   174→                job_id=job_id,\n   175→                candidate_id=candidate_id,\n   176→                status=\"AWAITING_REVIEW\",\n   177→                parsed_jd=parsed_jd,\n   178→                tailored_resume=resume,\n   179→                company_intel=intel,\n   180→                contact=contact,\n   181→                outreach_email=email,\n   182→            )\n   183→\n   184→        except Exception as e:\n   185→            log.error(\"application_orchestrator.failed\", error=str(e))\n   186→            await self._crm.update_pipeline_status(pipeline_id, \"FAILED\")\n   187→            await self._crm.log(pipeline_id, candidate_id, job_id, \"PIPELINE_FAILED\", {\n   188→                \"error\": str(e)\n   189→            })\n   190→            raise\n   191→\n   192→    async def submit(self, pipeline_id: UUID) -> None:\n   193→        \"\"\"\n   194→        Execute the approved submission — called only after Review Dashboard approval.\n   195→\n   196→        Runs auto_apply for form submission. CRM logs the outcome.\n   197→\n   198→        Args:\n   199→            pipeline_id: The pipeline that was approved in the Review Dashboard\n   200→        \"\"\"\n   201→        result_orm = await self._db.execute(\n   202→            select(ApplicationPipelineORM).where(ApplicationPipelineORM.id == pipeline_id)\n   203→        )\n   204→        pipeline = result_orm.scalar_one_or_none()\n   205→        if not pipeline:\n   206→            raise ValueError(f\"Pipeline {pipeline_id} not found\")\n   207→        if pipeline.status != \"APPROVED\":\n   208→            raise ValueError(f\"Pipeline {pipeline_id} is not APPROVED (status: {pipeline.status})\")\n   209→\n   210→        log = logger.bind(pipeline_id=str(pipeline_id))\n   211→        log.info(\"application_orchestrator.submitting\")\n   212→\n   213→        candidate = await self._load_candidate(pipeline.candidate_id)\n   214→        job_result = await self._db.execute(\n   215→            select(DiscoveredJob).where(DiscoveredJob.id == pipeline.job_id)\n   216→        )\n   217→        job = job_result.scalar_one_or_none()\n   218→\n   219→        if not job:\n   220→            raise ValueError(f\"Job {pipeline.job_id} not found\")\n   221→\n   222→        # Load tailored resume\n   223→        from backend.models.application import TailoredResume as TailoredResumeORM\n   224→        from backend.agents.application.schemas import TailoredResumeSchema\n   225→        resume_result = await self._db.execute(\n   226→            select(TailoredResumeORM).where(TailoredResumeORM.id == pipeline.resume_id)\n   227→        )\n   228→        resume_orm = resume_result.scalar_one_or_none()\n   229→        resume = TailoredResumeSchema(\n   230→            job_id=pipeline.job_id,\n   231→            candidate_id=pipeline.candidate_id,\n   232→            full_text=resume_orm.full_text if resume_orm else \"\",\n   233→            summary=resume_orm.summary if resume_orm else \"\",\n   234→            change_log=resume_orm.change_log if resume_orm else \"\",\n   235→            pdf_path=resume_orm.pdf_path if resume_orm else None,\n   236→        )\n   237→\n   238→        result = await self._auto_apply.submit(\n   239→            job_url=job.url,\n   240→            job_id=pipeline.job_id,\n   241→            pipeline_id=pipeline_id,\n   242→            candidate=candidate,\n   243→            resume=resume,\n   244→        )\n   245→\n   246→        await self._crm.update_pipeline_status(pipeline_id, result.status)\n   247→        await self._crm.log(\n   248→            pipeline_id, pipeline.candidate_id, pipeline.job_id,\n   249→            \"SUBMITTED\",\n   250→            {\"status\": result.status, \"confirmation\": result.confirmation_number, \"fields\": result.fields_completed},\n   251→        )\n   252→        log.info(\"application_orchestrator.submit_complete\", status=result.status)\n   253→\n   254→    async def _create_pipeline(\n   255→        self, job_id: UUID, candidate_id: UUID\n   256→    ) -> ApplicationPipelineORM:\n   257→        \"\"\"Create a new ApplicationPipeline record and return it.\"\"\"\n   258→        pipeline = ApplicationPipelineORM(\n   259→            job_id=job_id,\n   260→            candidate_id=candidate_id,\n   261→            status=\"QUEUED\",\n   262→        )\n   263→        self._db.add(pipeline)\n   264→        await self._db.commit()\n   265→        await self._db.refresh(pipeline)\n   266→        return pipeline\n   267→\n   268→    async def _load_candidate(self, candidate_id: UUID) -> CandidateSchema:\n   269→        \"\"\"Load candidate from PostgreSQL.\"\"\"\n   270→        result = await self._db.execute(\n   271→            select(CandidateORM).where(CandidateORM.id == candidate_id)\n   272→        )\n   273→        orm = result.scalar_one_or_none()\n   274→        if not orm:\n   275→            raise ValueError(f\"Candidate {candidate_id} not found\")\n   276→        return CandidateSchema.model_validate(orm)\n   277→\n   278→    async def _load_scored_job(self, job_id: UUID, candidate_id: UUID):\n   279→        \"\"\"Load the scored job — wraps DiscoveredJob + ScoredJob into ScoredJobSchema.\"\"\"\n   280→        from backend.agents.discovery.schemas import (\n   281→            DiscoveredJobSchema, ScoredJobSchema, ScoreBreakdown\n   282→        )\n   283→\n   284→        job_result = await self._db.execute(\n   285→            select(DiscoveredJob).where(DiscoveredJob.id == job_id)\n   286→        )\n   287→        job_orm = job_result.scalar_one_or_none()\n   288→        if not job_orm:\n   289→            raise ValueError(f\"Job {job_id} not found\")\n   290→\n   291→        score_result = await self._db.execute(\n   292→            select(ScoredJob).where(ScoredJob.job_id == job_id)\n   293→        )\n   294→        score_orm = score_result.scalar_one_or_none()\n   295→\n   296→        job_schema = DiscoveredJobSchema(\n   297→            id=job_orm.id,\n   298→            candidate_id=job_orm.candidate_id,\n   299→            title=job_orm.title,\n   300→            company=job_orm.company,\n   301→            location=job_orm.location,\n   302→            url=job_orm.url,\n   303→            url_hash=job_orm.url_hash,\n   304→            description=job_orm.description,\n   305→            source=job_orm.source,\n   306→        )\n   307→\n   308→        scores = ScoreBreakdown(\n   309→            technical_match=score_orm.technical_match or 70 if score_orm else 70,\n   310→            level_match=score_orm.level_match or 70 if score_orm else 70,\n   311→            culture_match=score_orm.culture_match or 70 if score_orm else 70,\n   312→            industry_match=score_orm.industry_match or 70 if score_orm else 70,\n   313→            growth_potential=score_orm.growth_potential or 70 if score_orm else 70,\n   314→            compensation_match=score_orm.compensation_match or 70 if score_orm else 70,\n   315→        )\n   316→\n   317→        return ScoredJobSchema(\n   318→            job=job_schema,\n   319→            scores=scores,\n   320→            composite_score=score_orm.composite_score if score_orm else 70,\n   321→            reasoning=score_orm.reasoning or \"\" if score_orm else \"\",\n   322→            is_hot=score_orm.is_hot if score_orm else False,\n   323→        )\n   324→\n   325→    async def _publish_status(\n   326→        self, pipeline_id: UUID, candidate_id: UUID, status: str\n   327→    ) -> None:\n   328→        \"\"\"Publish pipeline status event to Redis pub/sub.\"\"\"\n   329→        import json\n   330→        payload = json.dumps({\n   331→            \"event\": \"APPLICATION_STATUS\",\n   332→            \"pipeline_id\": str(pipeline_id),\n   333→            \"candidate_id\": str(candidate_id),\n   334→            \"status\": status,\n   335→        })\n   336→        await self._redis.publish(_STATUS_CHANNEL, payload)\n   337→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"deb7dcc2-71e5-4120-93c5-a6ba962cce9e","uuid":"ea44ddad-3086-471d-b01a-3eaccc83b78f","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/application/orchestrator.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nApplication Orchestrator — coordinates the full application pipeline for an approved job.\n\nPipeline flow:\n  receive_approved_job(job_id)\n    → jd_parser.parse(job)\n    → resume_tailor.tailor(parsed_jd, candidate)      ← parallel\n    → company_intel.research(company)                  ← parallel\n    → contact_finder.find(intel, parsed_jd)\n    → outreach_composer.compose(all_context)\n    → [PAUSE — await Review Dashboard approval]\n    → auto_apply.submit(job, resume)                  ← only if APPROVED\n    → log CRM events throughout\n\nStatus machine:\n  QUEUED → PARSING → TAILORING → RESEARCHING → COMPOSING →\n  AWAITING_REVIEW → APPROVED/REJECTED → SUBMITTED → SENT → TRACKED\n\"\"\"\n\nimport asyncio\nfrom uuid import UUID\n\nimport redis.asyncio as aioredis\nimport structlog\nfrom anthropic import AsyncAnthropic\nfrom sqlalchemy import select\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom backend.config import settings\nfrom backend.agents.application.jd_parser import JDParser\nfrom backend.agents.application.resume_tailor import ResumeTailor\nfrom backend.agents.application.company_intel import CompanyIntelAgent\nfrom backend.agents.application.contact_finder import ContactFinder\nfrom backend.agents.application.outreach_composer import OutreachComposer\nfrom backend.agents.application.auto_apply import AutoApplyAgent\nfrom backend.agents.application.crm import CRM\nfrom backend.agents.application.schemas import ApplicationPipelineSchema\nfrom backend.agents.discovery.schemas import CandidateSchema\nfrom backend.agents.discovery.identity_profiler import IdentityProfiler\nfrom backend.models.discovery import Candidate as CandidateORM, DiscoveredJob, ScoredJob\nfrom backend.models.application import ApplicationPipeline as ApplicationPipelineORM\n\nlogger = structlog.get_logger(__name__)\n\n_STATUS_CHANNEL = \"agent.status.application\"\n\n\nclass ApplicationOrchestrator:\n    \"\"\"\n    Coordinates the full application pipeline for a single approved job.\n\n    resume_tailor and company_intel run concurrently — both need parsed_jd\n    but don't depend on each other. This cuts wall-clock time roughly in half.\n    \"\"\"\n\n    def __init__(\n        self,\n        db: AsyncSession,\n        redis_client: aioredis.Redis,\n    ):\n        self._db = db\n        self._redis = redis_client\n        self._claude = AsyncAnthropic(api_key=settings.anthropic_api_key)\n\n        self._jd_parser = JDParser(db, self._claude)\n        self._resume_tailor = ResumeTailor(db, self._claude)\n        self._company_intel = CompanyIntelAgent(db, redis_client, self._claude)\n        self._contact_finder = ContactFinder(db)\n        self._composer = OutreachComposer(db, self._claude)\n        self._auto_apply = AutoApplyAgent()\n        self._crm = CRM(db)\n        self._profiler = IdentityProfiler(redis_client, self._claude)\n\n    async def start(self, job_id: UUID, candidate_id: UUID) -> ApplicationPipelineSchema:\n        \"\"\"\n        Start the application pipeline for an approved job.\n\n        Runs through JD parsing, resume tailoring, company research,\n        and outreach composition. Pauses at AWAITING_REVIEW.\n\n        Args:\n            job_id: Approved job to process\n            candidate_id: Candidate to build application for\n\n        Returns:\n            ApplicationPipelineSchema with all artifacts ready for review\n        \"\"\"\n        log = logger.bind(job_id=str(job_id), candidate_id=str(candidate_id))\n        log.info(\"application_orchestrator.starting\")\n\n        # Create pipeline record\n        pipeline = await self._create_pipeline(job_id, candidate_id)\n        pipeline_id = pipeline.id\n\n        try:\n            # Load candidate + job\n            candidate = await self._load_candidate(candidate_id)\n            job = await self._load_scored_job(job_id, candidate_id)\n            profile = await self._profiler.build_profile(candidate)\n\n            log.info(\"application_orchestrator.loaded\", candidate=candidate.name)\n\n            # Step 1: Parse JD\n            await self._crm.update_pipeline_status(pipeline_id, \"PARSING\", \"jd_parser\")\n            parsed_jd = await self._jd_parser.parse(job)\n            await self._crm.log(pipeline_id, candidate_id, job_id, \"JD_PARSED\", {\n                \"required_skills\": parsed_jd.required_skills[:5],\n                \"seniority_level\": parsed_jd.seniority_level,\n            })\n            log.info(\"application_orchestrator.jd_parsed\", skills=len(parsed_jd.required_skills))\n\n            # Steps 2+3: Resume tailoring and company research run in parallel\n            await self._crm.update_pipeline_status(pipeline_id, \"TAILORING\", \"resume_tailor+company_intel\")\n\n            resume_task = asyncio.create_task(\n                self._resume_tailor.tailor(parsed_jd, candidate, profile)\n            )\n            intel_task = asyncio.create_task(\n                self._company_intel.research(\n                    job.job.company,\n                    company_url=None,  # Could be extracted from job URL\n                )\n            )\n\n            resume, intel = await asyncio.gather(resume_task, intel_task)\n\n            await self._crm.log(pipeline_id, candidate_id, job_id, \"RESUME_TAILORED\", {\n                \"version\": resume.version,\n            })\n            await self._crm.log(pipeline_id, candidate_id, job_id, \"COMPANY_RESEARCHED\", {\n                \"company\": intel.company_name,\n                \"growth_stage\": intel.growth_stage,\n            })\n            log.info(\"application_orchestrator.parallel_complete\")\n\n            # Step 4: Find contact\n            await self._crm.update_pipeline_status(pipeline_id, \"RESEARCHING\", \"contact_finder\")\n            contact = await self._contact_finder.find(intel, parsed_jd)\n            await self._crm.log(pipeline_id, candidate_id, job_id, \"CONTACT_FOUND\", {\n                \"email\": contact.email,\n                \"confidence\": contact.confidence,\n                \"source\": contact.source,\n            })\n\n            # Step 5: Compose outreach\n            await self._crm.update_pipeline_status(pipeline_id, \"COMPOSING\", \"outreach_composer\")\n            email = await self._composer.compose(\n                parsed_jd=parsed_jd,\n                intel=intel,\n                contact=contact,\n                resume=resume,\n                profile=profile,\n                candidate_name=candidate.name,\n                candidate_email=candidate.email,\n                candidate_github=candidate.github_url,\n                candidate_linkedin=candidate.linkedin_url,\n            )\n            await self._crm.log(pipeline_id, candidate_id, job_id, \"EMAIL_DRAFTED\", {\n                \"subject\": email.subject,\n                \"tone\": email.tone_used,\n            })\n\n            # Pause — await human review\n            await self._crm.update_pipeline_status(pipeline_id, \"AWAITING_REVIEW\")\n            await self._publish_status(pipeline_id, candidate_id, \"AWAITING_REVIEW\")\n\n            log.info(\"application_orchestrator.awaiting_review\", pipeline_id=str(pipeline_id))\n\n            return ApplicationPipelineSchema(\n                id=pipeline_id,\n                job_id=job_id,\n                candidate_id=candidate_id,\n                status=\"AWAITING_REVIEW\",\n                parsed_jd=parsed_jd,\n                tailored_resume=resume,\n                company_intel=intel,\n                contact=contact,\n                outreach_email=email,\n            )\n\n        except Exception as e:\n            log.error(\"application_orchestrator.failed\", error=str(e))\n            await self._crm.update_pipeline_status(pipeline_id, \"FAILED\")\n            await self._crm.log(pipeline_id, candidate_id, job_id, \"PIPELINE_FAILED\", {\n                \"error\": str(e)\n            })\n            raise\n\n    async def submit(self, pipeline_id: UUID) -> None:\n        \"\"\"\n        Execute the approved submission — called only after Review Dashboard approval.\n\n        Runs auto_apply for form submission. CRM logs the outcome.\n\n        Args:\n            pipeline_id: The pipeline that was approved in the Review Dashboard\n        \"\"\"\n        result_orm = await self._db.execute(\n            select(ApplicationPipelineORM).where(ApplicationPipelineORM.id == pipeline_id)\n        )\n        pipeline = result_orm.scalar_one_or_none()\n        if not pipeline:\n            raise ValueError(f\"Pipeline {pipeline_id} not found\")\n        if pipeline.status != \"APPROVED\":\n            raise ValueError(f\"Pipeline {pipeline_id} is not APPROVED (status: {pipeline.status})\")\n\n        log = logger.bind(pipeline_id=str(pipeline_id))\n        log.info(\"application_orchestrator.submitting\")\n\n        candidate = await self._load_candidate(pipeline.candidate_id)\n        job_result = await self._db.execute(\n            select(DiscoveredJob).where(DiscoveredJob.id == pipeline.job_id)\n        )\n        job = job_result.scalar_one_or_none()\n\n        if not job:\n            raise ValueError(f\"Job {pipeline.job_id} not found\")\n\n        # Load tailored resume\n        from backend.models.application import TailoredResume as TailoredResumeORM\n        from backend.agents.application.schemas import TailoredResumeSchema\n        resume_result = await self._db.execute(\n            select(TailoredResumeORM).where(TailoredResumeORM.id == pipeline.resume_id)\n        )\n        resume_orm = resume_result.scalar_one_or_none()\n        resume = TailoredResumeSchema(\n            job_id=pipeline.job_id,\n            candidate_id=pipeline.candidate_id,\n            full_text=resume_orm.full_text if resume_orm else \"\",\n            summary=resume_orm.summary if resume_orm else \"\",\n            change_log=resume_orm.change_log if resume_orm else \"\",\n            pdf_path=resume_orm.pdf_path if resume_orm else None,\n        )\n\n        result = await self._auto_apply.submit(\n            job_url=job.url,\n            job_id=pipeline.job_id,\n            pipeline_id=pipeline_id,\n            candidate=candidate,\n            resume=resume,\n        )\n\n        await self._crm.update_pipeline_status(pipeline_id, result.status)\n        await self._crm.log(\n            pipeline_id, pipeline.candidate_id, pipeline.job_id,\n            \"SUBMITTED\",\n            {\"status\": result.status, \"confirmation\": result.confirmation_number, \"fields\": result.fields_completed},\n        )\n        log.info(\"application_orchestrator.submit_complete\", status=result.status)\n\n    async def _create_pipeline(\n        self, job_id: UUID, candidate_id: UUID\n    ) -> ApplicationPipelineORM:\n        \"\"\"Create a new ApplicationPipeline record and return it.\"\"\"\n        pipeline = ApplicationPipelineORM(\n            job_id=job_id,\n            candidate_id=candidate_id,\n            status=\"QUEUED\",\n        )\n        self._db.add(pipeline)\n        await self._db.commit()\n        await self._db.refresh(pipeline)\n        return pipeline\n\n    async def _load_candidate(self, candidate_id: UUID) -> CandidateSchema:\n        \"\"\"Load candidate from PostgreSQL.\"\"\"\n        result = await self._db.execute(\n            select(CandidateORM).where(CandidateORM.id == candidate_id)\n        )\n        orm = result.scalar_one_or_none()\n        if not orm:\n            raise ValueError(f\"Candidate {candidate_id} not found\")\n        return CandidateSchema.model_validate(orm)\n\n    async def _load_scored_job(self, job_id: UUID, candidate_id: UUID):\n        \"\"\"Load the scored job — wraps DiscoveredJob + ScoredJob into ScoredJobSchema.\"\"\"\n        from backend.agents.discovery.schemas import (\n            DiscoveredJobSchema, ScoredJobSchema, ScoreBreakdown\n        )\n\n        job_result = await self._db.execute(\n            select(DiscoveredJob).where(DiscoveredJob.id == job_id)\n        )\n        job_orm = job_result.scalar_one_or_none()\n        if not job_orm:\n            raise ValueError(f\"Job {job_id} not found\")\n\n        score_result = await self._db.execute(\n            select(ScoredJob).where(ScoredJob.job_id == job_id)\n        )\n        score_orm = score_result.scalar_one_or_none()\n\n        job_schema = DiscoveredJobSchema(\n            id=job_orm.id,\n            candidate_id=job_orm.candidate_id,\n            title=job_orm.title,\n            company=job_orm.company,\n            location=job_orm.location,\n            url=job_orm.url,\n            url_hash=job_orm.url_hash,\n            description=job_orm.description,\n            source=job_orm.source,\n        )\n\n        scores = ScoreBreakdown(\n            technical_match=score_orm.technical_match or 70 if score_orm else 70,\n            level_match=score_orm.level_match or 70 if score_orm else 70,\n            culture_match=score_orm.culture_match or 70 if score_orm else 70,\n            industry_match=score_orm.industry_match or 70 if score_orm else 70,\n            growth_potential=score_orm.growth_potential or 70 if score_orm else 70,\n            compensation_match=score_orm.compensation_match or 70 if score_orm else 70,\n        )\n\n        return ScoredJobSchema(\n            job=job_schema,\n            scores=scores,\n            composite_score=score_orm.composite_score if score_orm else 70,\n            reasoning=score_orm.reasoning or \"\" if score_orm else \"\",\n            is_hot=score_orm.is_hot if score_orm else False,\n        )\n\n    async def _publish_status(\n        self, pipeline_id: UUID, candidate_id: UUID, status: str\n    ) -> None:\n        \"\"\"Publish pipeline status event to Redis pub/sub.\"\"\"\n        import json\n        payload = json.dumps({\n            \"event\": \"APPLICATION_STATUS\",\n            \"pipeline_id\": str(pipeline_id),\n            \"candidate_id\": str(candidate_id),\n            \"status\": status,\n        })\n        await self._redis.publish(_STATUS_CHANNEL, payload)\n","numLines":337,"startLine":1,"totalLines":337}}}}
