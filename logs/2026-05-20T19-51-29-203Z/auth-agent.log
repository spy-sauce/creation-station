{"t":"2026-05-20T19:59:37.346Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TbtASDMEjogXiq3cmRuVne","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Authentication API — passwordless magic link flow.\n     6→\n     7→POST  /auth/request-link     → request a magic login link\n     8→POST  /auth/verify            → verify magic link token, return JWT\n     9→GET   /auth/me                → get current authenticated user\n    10→\"\"\"\n    11→\n    12→import uuid\n    13→import secrets\n    14→from datetime import datetime, timedelta, timezone\n    15→\n    16→import jwt\n    17→import structlog\n    18→from fastapi import APIRouter, Depends, HTTPException, Request\n    19→from fastapi.security import HTTPBearer, HTTPAuthorizationCredentials\n    20→from pydantic import BaseModel, EmailStr\n    21→from sqlalchemy import select\n    22→from sqlalchemy.ext.asyncio import AsyncSession\n    23→\n    24→from backend.config import settings\n    25→from backend.database import get_db\n    26→from backend.models.auth import User, MagicLink\n    27→\n    28→logger = structlog.get_logger(__name__)\n    29→router = APIRouter()\n    30→security = HTTPBearer(auto_error=False)\n    31→\n    32→\n    33→# ─── Schemas ─────────────────────────────────────────────────────────────────\n    34→\n    35→class RequestLinkPayload(BaseModel):\n    36→    \"\"\"Payload to request a magic link.\"\"\"\n    37→    email: EmailStr\n    38→\n    39→\n    40→class RequestLinkResponse(BaseModel):\n    41→    \"\"\"Response after requesting a magic link.\"\"\"\n    42→    message: str\n    43→    # In dev mode, we return the magic link directly so you can click it\n    44→    magic_link: str | None = None\n    45→    token: str | None = None\n    46→\n    47→\n    48→class VerifyTokenPayload(BaseModel):\n    49→    \"\"\"Payload to verify a magic link token.\"\"\"\n    50→    token: str\n    51→\n    52→\n    53→class AuthResponse(BaseModel):\n    54→    \"\"\"Response with JWT access token.\"\"\"\n    55→    access_token: str\n    56→    token_type: str = \"bearer\"\n    57→    user_id: str\n    58→    email: str\n    59→    is_onboarded: bool\n    60→\n    61→\n    62→class UserResponse(BaseModel):\n    63→    \"\"\"Current user info.\"\"\"\n    64→    id: str\n    65→    email: str\n    66→    name: str | None\n    67→    is_onboarded: bool\n    68→    candidate_id: str | None\n    69→    created_at: str\n    70→\n    71→\n    72→# ─── JWT Helpers ─────────────────────────────────────────────────────────────\n    73→\n    74→def create_jwt(user_id: uuid.UUID, email: str) -> str:\n    75→    \"\"\"Create a JWT access token for an authenticated user.\"\"\"\n    76→    payload = {\n    77→        \"sub\": str(user_id),\n    78→        \"email\": email,\n    79→        \"iat\": datetime.now(timezone.utc),\n    80→        \"exp\": datetime.now(timezone.utc) + timedelta(days=7),\n    81→    }\n    82→    return jwt.encode(payload, settings.jwt_secret, algorithm=\"HS256\")\n    83→\n    84→\n    85→def decode_jwt(token: str) -> dict:\n    86→    \"\"\"Decode and validate a JWT token.\"\"\"\n    87→    try:\n    88→        return jwt.decode(token, settings.jwt_secret, algorithms=[\"HS256\"])\n    89→    except jwt.ExpiredSignatureError:\n    90→        raise HTTPException(status_code=401, detail=\"Token expired\")\n    91→    except jwt.InvalidTokenError:\n    92→        raise HTTPException(status_code=401, detail=\"Invalid token\")\n    93→\n    94→\n    95→# ─── Auth Dependency ─────────────────────────────────────────────────────────\n    96→\n    97→async def get_current_user(\n    98→    credentials: HTTPAuthorizationCredentials | None = Depends(security),\n    99→    db: AsyncSession = Depends(get_db),\n   100→) -> User:\n   101→    \"\"\"FastAPI dependency that returns the current authenticated user.\"\"\"\n   102→    if credentials is None:\n   103→        raise HTTPException(status_code=401, detail=\"Not authenticated\")\n   104→\n   105→    payload = decode_jwt(credentials.credentials)\n   106→    user_id = payload.get(\"sub\")\n   107→    if not user_id:\n   108→        raise HTTPException(status_code=401, detail=\"Invalid token payload\")\n   109→\n   110→    result = await db.execute(\n   111→        select(User).where(User.id == uuid.UUID(user_id))\n   112→    )\n   113→    user = result.scalar_one_or_none()\n   114→    if not user or not user.is_active:\n   115→        raise HTTPException(status_code=401, detail=\"User not found or inactive\")\n   116→\n   117→    return user\n   118→\n   119→\n   120→# ─── Endpoints ───────────────────────────────────────────────────────────────\n   121→\n   122→@router.post(\"/request-link\", response_model=RequestLinkResponse)\n   123→async def request_magic_link(\n   124→    payload: RequestLinkPayload,\n   125→    request: Request,\n   126→    db: AsyncSession = Depends(get_db),\n   127→):\n   128→    \"\"\"\n   129→    Request a magic login link. Creates user if they don't exist.\n   130→\n   131→    In dev mode (DEBUG=true), returns the magic link directly in the response\n   132→    so you can click it without needing email infrastructure.\n   133→    In production, this would send the link via email.\n   134→    \"\"\"\n   135→    email = payload.email.lower().strip()\n   136→\n   137→    # Find or create user\n   138→    result = await db.execute(select(User).where(User.email == email))\n   139→    user = result.scalar_one_or_none()\n   140→\n   141→    if not user:\n   142→        user = User(email=email)\n   143→        db.add(user)\n   144→        await db.flush()\n   145→        logger.info(\"auth.user_created\", email=email, user_id=str(user.id))\n   146→\n   147→    # Generate magic link token\n   148→    token = secrets.token_urlsafe(48)\n   149→    expires_at = datetime.now(timezone.utc) + timedelta(minutes=settings.magic_link_expiry_minutes)\n   150→\n   151→    magic_link_record = MagicLink(\n   152→        user_id=user.id,\n   153→        token=token,\n   154→        expires_at=expires_at,\n   155→    )\n   156→    db.add(magic_link_record)\n   157→    await db.commit()\n   158→\n   159→    # Build the magic link URL\n   160→    base_url = str(request.base_url).rstrip(\"/\")\n   161→    # Frontend will handle this route\n   162→    magic_link_url = f\"{request.headers.get('origin', 'http://localhost:5173')}/auth/verify?token={token}\"\n   163→\n   164→    logger.info(\"auth.magic_link_created\", email=email, expires_at=expires_at.isoformat())\n   165→\n   166→    if settings.debug:\n   167→        return RequestLinkResponse(\n   168→            message=\"Magic link created. Click to log in.\",\n   169→            magic_link=magic_link_url,\n   170→            token=token,\n   171→        )\n   172→    else:\n   173→        # TODO: Send email with magic link via email service\n   174→        return RequestLinkResponse(\n   175→            message=\"Check your email for a login link.\",\n   176→        )\n   177→\n   178→\n   179→@router.post(\"/verify\", response_model=AuthResponse)\n   180→async def verify_magic_link(\n   181→    payload: VerifyTokenPayload,\n   182→    db: AsyncSession = Depends(get_db),\n   183→):\n   184→    \"\"\"\n   185→    Verify a magic link token and return a JWT access token.\n   186→\n   187→    The magic link token is single-use and time-limited.\n   188→    \"\"\"\n   189→    result = await db.execute(\n   190→        select(MagicLink).where(MagicLink.token == payload.token)\n   191→    )\n   192→    magic_link = result.scalar_one_or_none()\n   193→\n   194→    if not magic_link:\n   195→        raise HTTPException(status_code=401, detail=\"Invalid or expired link\")\n   196→\n   197→    if magic_link.is_used:\n   198→        raise HTTPException(status_code=401, detail=\"This link has already been used\")\n   199→\n   200→    if magic_link.expires_at.replace(tzinfo=timezone.utc) < datetime.now(timezone.utc):\n   201→        raise HTTPException(status_code=401, detail=\"This link has expired\")\n   202→\n   203→    # Mark as used\n   204→    magic_link.is_used = True\n   205→\n   206→    # Get the user\n   207→    user_result = await db.execute(\n   208→        select(User).where(User.id == magic_link.user_id)\n   209→    )\n   210→    user = user_result.scalar_one_or_none()\n   211→    if not user:\n   212→        raise HTTPException(status_code=401, detail=\"User not found\")\n   213→\n   214→    # Update last login\n   215→    user.last_login_at = datetime.now(timezone.utc)\n   216→    await db.commit()\n   217→\n   218→    # Issue JWT\n   219→    access_token = create_jwt(user.id, user.email)\n   220→\n   221→    logger.info(\"auth.login_success\", email=user.email, user_id=str(user.id))\n   222→\n   223→    return AuthResponse(\n   224→        access_token=access_token,\n   225→        user_id=str(user.id),\n   226→        email=user.email,\n   227→        is_onboarded=user.is_onboarded,\n   228→    )\n   229→\n   230→\n   231→@router.get(\"/me\", response_model=UserResponse)\n   232→async def get_me(\n   233→    current_user: User = Depends(get_current_user),\n   234→):\n   235→    \"\"\"Get the current authenticated user's info.\"\"\"\n   236→    return UserResponse(\n   237→        id=str(current_user.id),\n   238→        email=current_user.email,\n   239→        name=current_user.name,\n   240→        is_onboarded=current_user.is_onboarded,\n   241→        candidate_id=str(current_user.candidate_id) if current_user.candidate_id else None,\n   242→        created_at=current_user.created_at.isoformat(),\n   243→    )\n   244→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"922c085c-e35c-4179-9c95-d428c008504e","uuid":"c0384527-6ae0-4355-a89f-29a9d13340f0","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/api/auth.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nAuthentication API — passwordless magic link flow.\n\nPOST  /auth/request-link     → request a magic login link\nPOST  /auth/verify            → verify magic link token, return JWT\nGET   /auth/me                → get current authenticated user\n\"\"\"\n\nimport uuid\nimport secrets\nfrom datetime import datetime, timedelta, timezone\n\nimport jwt\nimport structlog\nfrom fastapi import APIRouter, Depends, HTTPException, Request\nfrom fastapi.security import HTTPBearer, HTTPAuthorizationCredentials\nfrom pydantic import BaseModel, EmailStr\nfrom sqlalchemy import select\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom backend.config import settings\nfrom backend.database import get_db\nfrom backend.models.auth import User, MagicLink\n\nlogger = structlog.get_logger(__name__)\nrouter = APIRouter()\nsecurity = HTTPBearer(auto_error=False)\n\n\n# ─── Schemas ─────────────────────────────────────────────────────────────────\n\nclass RequestLinkPayload(BaseModel):\n    \"\"\"Payload to request a magic link.\"\"\"\n    email: EmailStr\n\n\nclass RequestLinkResponse(BaseModel):\n    \"\"\"Response after requesting a magic link.\"\"\"\n    message: str\n    # In dev mode, we return the magic link directly so you can click it\n    magic_link: str | None = None\n    token: str | None = None\n\n\nclass VerifyTokenPayload(BaseModel):\n    \"\"\"Payload to verify a magic link token.\"\"\"\n    token: str\n\n\nclass AuthResponse(BaseModel):\n    \"\"\"Response with JWT access token.\"\"\"\n    access_token: str\n    token_type: str = \"bearer\"\n    user_id: str\n    email: str\n    is_onboarded: bool\n\n\nclass UserResponse(BaseModel):\n    \"\"\"Current user info.\"\"\"\n    id: str\n    email: str\n    name: str | None\n    is_onboarded: bool\n    candidate_id: str | None\n    created_at: str\n\n\n# ─── JWT Helpers ─────────────────────────────────────────────────────────────\n\ndef create_jwt(user_id: uuid.UUID, email: str) -> str:\n    \"\"\"Create a JWT access token for an authenticated user.\"\"\"\n    payload = {\n        \"sub\": str(user_id),\n        \"email\": email,\n        \"iat\": datetime.now(timezone.utc),\n        \"exp\": datetime.now(timezone.utc) + timedelta(days=7),\n    }\n    return jwt.encode(payload, settings.jwt_secret, algorithm=\"HS256\")\n\n\ndef decode_jwt(token: str) -> dict:\n    \"\"\"Decode and validate a JWT token.\"\"\"\n    try:\n        return jwt.decode(token, settings.jwt_secret, algorithms=[\"HS256\"])\n    except jwt.ExpiredSignatureError:\n        raise HTTPException(status_code=401, detail=\"Token expired\")\n    except jwt.InvalidTokenError:\n        raise HTTPException(status_code=401, detail=\"Invalid token\")\n\n\n# ─── Auth Dependency ─────────────────────────────────────────────────────────\n\nasync def get_current_user(\n    credentials: HTTPAuthorizationCredentials | None = Depends(security),\n    db: AsyncSession = Depends(get_db),\n) -> User:\n    \"\"\"FastAPI dependency that returns the current authenticated user.\"\"\"\n    if credentials is None:\n        raise HTTPException(status_code=401, detail=\"Not authenticated\")\n\n    payload = decode_jwt(credentials.credentials)\n    user_id = payload.get(\"sub\")\n    if not user_id:\n        raise HTTPException(status_code=401, detail=\"Invalid token payload\")\n\n    result = await db.execute(\n        select(User).where(User.id == uuid.UUID(user_id))\n    )\n    user = result.scalar_one_or_none()\n    if not user or not user.is_active:\n        raise HTTPException(status_code=401, detail=\"User not found or inactive\")\n\n    return user\n\n\n# ─── Endpoints ───────────────────────────────────────────────────────────────\n\n@router.post(\"/request-link\", response_model=RequestLinkResponse)\nasync def request_magic_link(\n    payload: RequestLinkPayload,\n    request: Request,\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"\n    Request a magic login link. Creates user if they don't exist.\n\n    In dev mode (DEBUG=true), returns the magic link directly in the response\n    so you can click it without needing email infrastructure.\n    In production, this would send the link via email.\n    \"\"\"\n    email = payload.email.lower().strip()\n\n    # Find or create user\n    result = await db.execute(select(User).where(User.email == email))\n    user = result.scalar_one_or_none()\n\n    if not user:\n        user = User(email=email)\n        db.add(user)\n        await db.flush()\n        logger.info(\"auth.user_created\", email=email, user_id=str(user.id))\n\n    # Generate magic link token\n    token = secrets.token_urlsafe(48)\n    expires_at = datetime.now(timezone.utc) + timedelta(minutes=settings.magic_link_expiry_minutes)\n\n    magic_link_record = MagicLink(\n        user_id=user.id,\n        token=token,\n        expires_at=expires_at,\n    )\n    db.add(magic_link_record)\n    await db.commit()\n\n    # Build the magic link URL\n    base_url = str(request.base_url).rstrip(\"/\")\n    # Frontend will handle this route\n    magic_link_url = f\"{request.headers.get('origin', 'http://localhost:5173')}/auth/verify?token={token}\"\n\n    logger.info(\"auth.magic_link_created\", email=email, expires_at=expires_at.isoformat())\n\n    if settings.debug:\n        return RequestLinkResponse(\n            message=\"Magic link created. Click to log in.\",\n            magic_link=magic_link_url,\n            token=token,\n        )\n    else:\n        # TODO: Send email with magic link via email service\n        return RequestLinkResponse(\n            message=\"Check your email for a login link.\",\n        )\n\n\n@router.post(\"/verify\", response_model=AuthResponse)\nasync def verify_magic_link(\n    payload: VerifyTokenPayload,\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"\n    Verify a magic link token and return a JWT access token.\n\n    The magic link token is single-use and time-limited.\n    \"\"\"\n    result = await db.execute(\n        select(MagicLink).where(MagicLink.token == payload.token)\n    )\n    magic_link = result.scalar_one_or_none()\n\n    if not magic_link:\n        raise HTTPException(status_code=401, detail=\"Invalid or expired link\")\n\n    if magic_link.is_used:\n        raise HTTPException(status_code=401, detail=\"This link has already been used\")\n\n    if magic_link.expires_at.replace(tzinfo=timezone.utc) < datetime.now(timezone.utc):\n        raise HTTPException(status_code=401, detail=\"This link has expired\")\n\n    # Mark as used\n    magic_link.is_used = True\n\n    # Get the user\n    user_result = await db.execute(\n        select(User).where(User.id == magic_link.user_id)\n    )\n    user = user_result.scalar_one_or_none()\n    if not user:\n        raise HTTPException(status_code=401, detail=\"User not found\")\n\n    # Update last login\n    user.last_login_at = datetime.now(timezone.utc)\n    await db.commit()\n\n    # Issue JWT\n    access_token = create_jwt(user.id, user.email)\n\n    logger.info(\"auth.login_success\", email=user.email, user_id=str(user.id))\n\n    return AuthResponse(\n        access_token=access_token,\n        user_id=str(user.id),\n        email=user.email,\n        is_onboarded=user.is_onboarded,\n    )\n\n\n@router.get(\"/me\", response_model=UserResponse)\nasync def get_me(\n    current_user: User = Depends(get_current_user),\n):\n    \"\"\"Get the current authenticated user's info.\"\"\"\n    return UserResponse(\n        id=str(current_user.id),\n        email=current_user.email,\n        name=current_user.name,\n        is_onboarded=current_user.is_onboarded,\n        candidate_id=str(current_user.candidate_id) if current_user.candidate_id else None,\n        created_at=current_user.created_at.isoformat(),\n    )\n","numLines":244,"startLine":1,"totalLines":244}}}}
{"t":"2026-05-20T19:59:39.311Z","event":"sdk_msg","msg":{"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_01CB5pitZfgh139LQ6bqoYnx","type":"message","role":"assistant","content":[{"type":"text","text":"Now I'll rewrite the auth.py with Resend integration and PII redaction:"}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":3162,"cache_read_input_tokens":57730,"cache_creation":{"ephemeral_5m_input_tokens":3162,"ephemeral_1h_input_tokens":0},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"922c085c-e35c-4179-9c95-d428c008504e","uuid":"ffc8ec6e-0226-468d-a63e-773891388df8"}}
{"t":"2026-05-20T20:00:16.107Z","event":"sdk_msg","msg":{"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_01CB5pitZfgh139LQ6bqoYnx","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01NVbsUcWBXHPKYRvUtM3wPG","name":"Write","input":{"file_path":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/api/auth.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nAuthentication API — passwordless magic link flow.\n\nPOST  /auth/request-link     → request a magic login link\nPOST  /auth/verify            → verify magic link token, return JWT\nGET   /auth/me                → get current authenticated user\n\"\"\"\n\nimport uuid\nimport secrets\nfrom datetime import datetime, timedelta, timezone\n\nimport jwt\nimport resend\nimport structlog\nfrom fastapi import APIRouter, Depends, HTTPException, Request\nfrom fastapi.security import HTTPBearer, HTTPAuthorizationCredentials\nfrom pydantic import BaseModel, EmailStr\nfrom sqlalchemy import select\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom backend.config import settings\nfrom backend.database import get_db\nfrom backend.models.auth import User, MagicLink\n\nlogger = structlog.get_logger(__name__)\nrouter = APIRouter()\nsecurity = HTTPBearer(auto_error=False)\n\n\n# ─── PII Redaction ────────────────────────────────────────────────────────────\n\ndef redact_email(email: str) -> str:\n    \"\"\"Redact email for safe logging. e.g. 'spy@seanyoung.biz' → 's**@s***.biz'\"\"\"\n    if not email or \"@\" not in email:\n        return \"[redacted]\"\n    local, domain = email.split(\"@\", 1)\n    domain_parts = domain.rsplit(\".\", 1)\n    redacted_local = local[0] + \"**\" if local else \"**\"\n    if len(domain_parts) == 2:\n        redacted_domain = domain_parts[0][0] + \"***.\" + domain_parts[1]\n    else:\n        redacted_domain = \"***\"\n    return f\"{redacted_local}@{redacted_domain}\"\n\n\n# ─── Schemas ─────────────────────────────────────────────────────────────────\n\nclass RequestLinkPayload(BaseModel):\n    \"\"\"Payload to request a magic link.\"\"\"\n    email: EmailStr\n\n\nclass RequestLinkResponse(BaseModel):\n    \"\"\"Response after requesting a magic link.\"\"\"\n    message: str\n    # In dev mode, we return the magic link directly so you can click it\n    magic_link: str | None = None\n    token: str | None = None\n\n\nclass VerifyTokenPayload(BaseModel):\n    \"\"\"Payload to verify a magic link token.\"\"\"\n    token: str\n\n\nclass AuthResponse(BaseModel):\n    \"\"\"Response with JWT access token.\"\"\"\n    access_token: str\n    token_type: str = \"bearer\"\n    user_id: str\n    email: str\n    is_onboarded: bool\n\n\nclass UserResponse(BaseModel):\n    \"\"\"Current user info.\"\"\"\n    id: str\n    email: str\n    name: str | None\n    is_onboarded: bool\n    candidate_id: str | None\n    created_at: str\n\n\n# ─── JWT Helpers ─────────────────────────────────────────────────────────────\n\ndef create_jwt(user_id: uuid.UUID, email: str) -> str:\n    \"\"\"Create a JWT access token for an authenticated user.\"\"\"\n    payload = {\n        \"sub\": str(user_id),\n        \"email\": email,\n        \"iat\": datetime.now(timezone.utc),\n        \"exp\": datetime.now(timezone.utc) + timedelta(days=7),\n    }\n    return jwt.encode(payload, settings.jwt_secret, algorithm=\"HS256\")\n\n\ndef decode_jwt(token: str) -> dict:\n    \"\"\"Decode and validate a JWT token.\"\"\"\n    try:\n        return jwt.decode(token, settings.jwt_secret, algorithms=[\"HS256\"])\n    except jwt.ExpiredSignatureError:\n        raise HTTPException(status_code=401, detail=\"Token expired\")\n    except jwt.InvalidTokenError:\n        raise HTTPException(status_code=401, detail=\"Invalid token\")\n\n\n# ─── Resend Email ─────────────────────────────────────────────────────────────\n\nasync def send_magic_link_email(email: str, magic_link_url: str) -> bool:\n    \"\"\"\n    Send magic link email via Resend.\n\n    Returns True if email was sent successfully, False otherwise.\n    Falls back gracefully if Resend is not configured.\n    \"\"\"\n    if not settings.resend_api_key:\n        logger.warning(\n            \"auth.resend_not_configured\",\n            email_redacted=redact_email(email),\n            message=\"Resend API key not set, email not sent\",\n        )\n        return False\n\n    resend.api_key = settings.resend_api_key\n\n    try:\n        resend.Emails.send({\n            \"from\": settings.resend_from_email,\n            \"to\": email,\n            \"subject\": \"Your Talent Agent Login Link\",\n            \"html\": f\"\"\"\n            <div style=\"font-family: 'DM Sans', -apple-system, sans-serif; max-width: 600px; margin: 0 auto; padding: 40px 20px; background-color: #0A0A0A; color: #FAFAFA;\">\n                <h1 style=\"font-family: 'Playfair Display', Georgia, serif; color: #C9A227; font-size: 28px; margin-bottom: 24px;\">\n                    Talent Agent\n                </h1>\n                <p style=\"font-size: 16px; line-height: 1.6; margin-bottom: 24px;\">\n                    Click the button below to sign in to your account. This link expires in {settings.magic_link_expiry_minutes} minutes.\n                </p>\n                <a href=\"{magic_link_url}\" style=\"display: inline-block; background-color: #C9A227; color: #0A0A0A; padding: 14px 28px; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px;\">\n                    Sign In\n                </a>\n                <p style=\"font-size: 14px; color: #737373; margin-top: 32px; line-height: 1.6;\">\n                    If you didn't request this link, you can safely ignore this email.\n                </p>\n                <hr style=\"border: none; border-top: 1px solid rgba(255,255,255,0.08); margin: 32px 0;\">\n                <p style=\"font-size: 12px; color: #737373;\">\n                    VibeSpace LLC · The Dot Connects\n                </p>\n            </div>\n            \"\"\",\n        })\n        logger.info(\n            \"auth.email_sent\",\n            email_redacted=redact_email(email),\n        )\n        return True\n    except Exception as e:\n        logger.error(\n            \"auth.email_send_failed\",\n            email_redacted=redact_email(email),\n            error=str(e),\n        )\n        return False\n\n\n# ─── Auth Dependency ─────────────────────────────────────────────────────────\n\nasync def get_current_user(\n    credentials: HTTPAuthorizationCredentials | None = Depends(security),\n    db: AsyncSession = Depends(get_db),\n) -> User:\n    \"\"\"FastAPI dependency that returns the current authenticated user.\"\"\"\n    if credentials is None:\n        raise HTTPException(status_code=401, detail=\"Not authenticated\")\n\n    payload = decode_jwt(credentials.credentials)\n    user_id = payload.get(\"sub\")\n    if not user_id:\n        raise HTTPException(status_code=401, detail=\"Invalid token payload\")\n\n    result = await db.execute(\n        select(User).where(User.id == uuid.UUID(user_id))\n    )\n    user = result.scalar_one_or_none()\n    if not user or not user.is_active:\n        raise HTTPException(status_code=401, detail=\"User not found or inactive\")\n\n    return user\n\n\n# ─── Endpoints ───────────────────────────────────────────────────────────────\n\n@router.post(\"/request-link\", response_model=RequestLinkResponse)\nasync def request_magic_link(\n    payload: RequestLinkPayload,\n    request: Request,\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"\n    Request a magic login link. Creates user if they don't exist.\n\n    In dev mode (DEBUG=true), returns the magic link directly in the response\n    so you can click it without needing email infrastructure.\n    In production, sends the link via Resend email service.\n    \"\"\"\n    email = payload.email.lower().strip()\n    email_redacted = redact_email(email)\n\n    # Find or create user\n    result = await db.execute(select(User).where(User.email == email))\n    user = result.scalar_one_or_none()\n\n    if not user:\n        user = User(email=email)\n        db.add(user)\n        await db.flush()\n        logger.info(\n            \"auth.user_created\",\n            email_redacted=email_redacted,\n            user_id=str(user.id),\n        )\n\n    # Generate magic link token\n    token = secrets.token_urlsafe(48)\n    expires_at = datetime.now(timezone.utc) + timedelta(minutes=settings.magic_link_expiry_minutes)\n\n    magic_link_record = MagicLink(\n        user_id=user.id,\n        token=token,\n        expires_at=expires_at,\n    )\n    db.add(magic_link_record)\n    await db.commit()\n\n    # Build the magic link URL using frontend origin\n    origin = request.headers.get(\"origin\", \"http://localhost:5173\")\n    magic_link_url = f\"{origin}/auth/verify?token={token}\"\n\n    logger.info(\n        \"auth.magic_link_created\",\n        email_redacted=email_redacted,\n        expires_at=expires_at.isoformat(),\n    )\n\n    if settings.debug:\n        # Dev mode: return link directly for easy testing\n        return RequestLinkResponse(\n            message=\"Magic link created. Click to log in.\",\n            magic_link=magic_link_url,\n            token=token,\n        )\n    else:\n        # Production: send email via Resend\n        email_sent = await send_magic_link_email(email, magic_link_url)\n        if email_sent:\n            return RequestLinkResponse(\n                message=\"Check your email for a login link.\",\n            )\n        else:\n            # Graceful degradation if email fails\n            logger.warning(\n                \"auth.email_fallback\",\n                email_redacted=email_redacted,\n                message=\"Email service unavailable\",\n            )\n            return RequestLinkResponse(\n                message=\"Check your email for a login link.\",\n            )\n\n\n@router.post(\"/verify\", response_model=AuthResponse)\nasync def verify_magic_link(\n    payload: VerifyTokenPayload,\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"\n    Verify a magic link token and return a JWT access token.\n\n    The magic link token is single-use and time-limited.\n    \"\"\"\n    result = await db.execute(\n        select(MagicLink).where(MagicLink.token == payload.token)\n    )\n    magic_link = result.scalar_one_or_none()\n\n    if not magic_link:\n        raise HTTPException(status_code=401, detail=\"Invalid or expired link\")\n\n    if magic_link.is_used:\n        raise HTTPException(status_code=401, detail=\"This link has already been used\")\n\n    if magic_link.expires_at.replace(tzinfo=timezone.utc) < datetime.now(timezone.utc):\n        raise HTTPException(status_code=401, detail=\"This link has expired\")\n\n    # Mark as used\n    magic_link.is_used = True\n\n    # Get the user\n    user_result = await db.execute(\n        select(User).where(User.id == magic_link.user_id)\n    )\n    user = user_result.scalar_one_or_none()\n    if not user:\n        raise HTTPException(status_code=401, detail=\"User not found\")\n\n    # Update last login\n    user.last_login_at = datetime.now(timezone.utc)\n    await db.commit()\n\n    # Issue JWT\n    access_token = create_jwt(user.id, user.email)\n\n    logger.info(\n        \"auth.login_success\",\n        email_redacted=redact_email(user.email),\n        user_id=str(user.id),\n    )\n\n    return AuthResponse(\n        access_token=access_token,\n        user_id=str(user.id),\n        email=user.email,\n        is_onboarded=user.is_onboarded,\n    )\n\n\n@router.get(\"/me\", response_model=UserResponse)\nasync def get_me(\n    current_user: User = Depends(get_current_user),\n):\n    \"\"\"Get the current authenticated user's info.\"\"\"\n    return UserResponse(\n        id=str(current_user.id),\n        email=current_user.email,\n        name=current_user.name,\n        is_onboarded=current_user.is_onboarded,\n        candidate_id=str(current_user.candidate_id) if current_user.candidate_id else None,\n        created_at=current_user.created_at.isoformat(),\n    )\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":3162,"cache_read_input_tokens":57730,"cache_creation":{"ephemeral_5m_input_tokens":3162,"ephemeral_1h_input_tokens":0},"output_tokens":3441,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"922c085c-e35c-4179-9c95-d428c008504e","uuid":"0dd802a9-901a-4bf6-920b-ccb2aa6d1216"}}
{"t":"2026-05-20T20:00:16.122Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NVbsUcWBXHPKYRvUtM3wPG","type":"tool_result","content":"The file /Users/spy/mfautomation/repos/creation-station/reverse-search/backend/api/auth.py has been updated. Here's the result of running `cat -n` on a snippet of the edited file:\n     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Authentication API — passwordless magic link flow.\n     6→\n     7→POST  /auth/request-link     → request a magic login link\n     8→POST  /auth/verify            → verify magic link token, return JWT\n     9→GET   /auth/me                → get current authenticated user\n    10→\"\"\"\n    11→\n    12→import uuid\n    13→import secrets\n    14→from datetime import datetime, timedelta, timezone\n    15→\n    16→import jwt\n    17→import resend\n    18→import structlog\n    19→from fastapi import APIRouter, Depends, HTTPException, Request\n    20→from fastapi.security import HTTPBearer, HTTPAuthorizationCredentials\n    21→from pydantic import BaseModel, EmailStr\n    22→from sqlalchemy import select\n    23→from sqlalchemy.ext.asyncio import AsyncSession\n    24→\n    25→from backend.config import settings\n    26→from backend.database import get_db\n    27→from backend.models.auth import User, MagicLink\n    28→\n    29→logger = structlog.get_logger(__name__)\n    30→router = APIRouter()\n    31→security = HTTPBearer(auto_error=False)\n    32→\n    33→\n    34→# ─── PII Redaction ────────────────────────────────────────────────────────────\n    35→\n    36→def redact_email(email: str) -> str:\n    37→    \"\"\"Redact email for safe logging. e.g. 'spy@seanyoung.biz' → 's**@s***.biz'\"\"\"\n    38→    if not email or \"@\" not in email:\n    39→        return \"[redacted]\"\n    40→    local, domain = email.split(\"@\", 1)\n    41→    domain_parts = domain.rsplit(\".\", 1)\n    42→    redacted_local = local[0] + \"**\" if local else \"**\"\n    43→    if len(domain_parts) == 2:\n    44→        redacted_domain = domain_parts[0][0] + \"***.\" + domain_parts[1]\n    45→    else:\n    46→        redacted_domain = \"***\"\n    47→    return f\"{redacted_local}@{redacted_domain}\"\n    48→\n    49→\n    50→# ─── Schemas ─────────────────────────────────────────────────────────────────\n    51→\n    52→class RequestLinkPayload(BaseModel):\n    53→    \"\"\"Payload to request a magic link.\"\"\"\n    54→    email: EmailStr\n    55→\n    56→\n    57→class RequestLinkResponse(BaseModel):\n    58→    \"\"\"Response after requesting a magic link.\"\"\"\n    59→    message: str\n    60→    # In dev mode, we return the magic link directly so you can click it\n    61→    magic_link: str | None = None\n    62→    token: str | None = None\n    63→\n    64→\n    65→class VerifyTokenPayload(BaseModel):\n    66→    \"\"\"Payload to verify a magic link token.\"\"\"\n    67→    token: str\n    68→\n    69→\n    70→class AuthResponse(BaseModel):\n    71→    \"\"\"Response with JWT access token.\"\"\"\n    72→    access_token: str\n    73→    token_type: str = \"bearer\"\n    74→    user_id: str\n    75→    email: str\n    76→    is_onboarded: bool\n    77→\n    78→\n    79→class UserResponse(BaseModel):\n    80→    \"\"\"Current user info.\"\"\"\n    81→    id: str\n    82→    email: str\n    83→    name: str | None\n    84→    is_onboarded: bool\n    85→    candidate_id: str | None\n    86→    created_at: str\n    87→\n    88→\n    89→# ─── JWT Helpers ─────────────────────────────────────────────────────────────\n    90→\n    91→def create_jwt(user_id: uuid.UUID, email: str) -> str:\n    92→    \"\"\"Create a JWT access token for an authenticated user.\"\"\"\n    93→    payload = {\n    94→        \"sub\": str(user_id),\n    95→        \"email\": email,\n    96→        \"iat\": datetime.now(timezone.utc),\n    97→        \"exp\": datetime.now(timezone.utc) + timedelta(days=7),\n    98→    }\n    99→    return jwt.encode(payload, settings.jwt_secret, algorithm=\"HS256\")\n   100→\n   101→\n   102→def decode_jwt(token: str) -> dict:\n   103→    \"\"\"Decode and validate a JWT token.\"\"\"\n   104→    try:\n   105→        return jwt.decode(token, settings.jwt_secret, algorithms=[\"HS256\"])\n   106→    except jwt.ExpiredSignatureError:\n   107→        raise HTTPException(status_code=401, detail=\"Token expired\")\n   108→    except jwt.InvalidTokenError:\n   109→        raise HTTPException(status_code=401, detail=\"Invalid token\")\n   110→\n   111→\n   112→# ─── Resend Email ─────────────────────────────────────────────────────────────\n   113→\n   114→async def send_magic_link_email(email: str, magic_link_url: str) -> bool:\n   115→    \"\"\"\n   116→    Send magic link email via Resend.\n   117→\n   118→    Returns True if email was sent successfully, False otherwise.\n   119→    Falls back gracefully if Resend is not configured.\n   120→    \"\"\"\n   121→    if not settings.resend_api_key:\n   122→        logger.warning(\n   123→            \"auth.resend_not_configured\",\n   124→            email_redacted=redact_email(email),\n   125→            message=\"Resend API key not set, email not sent\",\n   126→        )\n   127→        return False\n   128→\n   129→    resend.api_key = settings.resend_api_key\n   130→\n   131→    try:\n   132→        resend.Emails.send({\n   133→            \"from\": settings.resend_from_email,\n   134→            \"to\": email,\n   135→            \"subject\": \"Your Talent Agent Login Link\",\n   136→            \"html\": f\"\"\"\n   137→            <div style=\"font-family: 'DM Sans', -apple-system, sans-serif; max-width: 600px; margin: 0 auto; padding: 40px 20px; background-color: #0A0A0A; color: #FAFAFA;\">\n   138→                <h1 style=\"font-family: 'Playfair Display', Georgia, serif; color: #C9A227; font-size: 28px; margin-bottom: 24px;\">\n   139→                    Talent Agent\n   140→                </h1>\n   141→                <p style=\"font-size: 16px; line-height: 1.6; margin-bottom: 24px;\">\n   142→                    Click the button below to sign in to your account. This link expires in {settings.magic_link_expiry_minutes} minutes.\n   143→                </p>\n   144→                <a href=\"{magic_link_url}\" style=\"display: inline-block; background-color: #C9A227; color: #0A0A0A; padding: 14px 28px; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px;\">\n   145→                    Sign In\n   146→                </a>\n   147→                <p style=\"font-size: 14px; color: #737373; margin-top: 32px; line-height: 1.6;\">\n   148→                    If you didn't request this link, you can safely ignore this email.\n   149→                </p>\n   150→                <hr style=\"border: none; border-top: 1px solid rgba(255,255,255,0.08); margin: 32px 0;\">\n   151→                <p style=\"font-size: 12px; color: #737373;\">\n   152→                    VibeSpace LLC · The Dot Connects\n   153→                </p>\n   154→            </div>\n   155→            \"\"\",\n   156→        })\n   157→        logger.info(\n   158→            \"auth.email_sent\",\n   159→            email_redacted=redact_email(email),\n   160→        )\n   161→        return True\n   162→    except Exception as e:\n   163→        logger.error(\n   164→            \"auth.email_send_failed\",\n   165→            email_redacted=redact_email(email),\n   166→            error=str(e),\n   167→        )\n   168→        return False\n   169→\n   170→\n   171→# ─── Auth Dependency ─────────────────────────────────────────────────────────\n   172→\n   173→async def get_current_user(\n   174→    credentials: HTTPAuthorizationCredentials | None = Depends(security),\n   175→    db: AsyncSession = Depends(get_db),\n   176→) -> User:\n   177→    \"\"\"FastAPI dependency that returns the current authenticated user.\"\"\"\n   178→    if credentials is None:\n   179→        raise HTTPException(status_code=401, detail=\"Not authenticated\")\n   180→\n   181→    payload = decode_jwt(credentials.credentials)\n   182→    user_id = payload.get(\"sub\")\n   183→    if not user_id:\n   184→        raise HTTPException(status_code=401, detail=\"Invalid token payload\")\n   185→\n   186→    result = await db.execute(\n   187→        select(User).where(User.id == uuid.UUID(user_id))\n   188→    )\n   189→    user = result.scalar_one_or_none()\n   190→    if not user or not user.is_active:\n   191→        raise HTTPException(status_code=401, detail=\"User not found or inactive\")\n   192→\n   193→    return user\n   194→\n   195→\n   196→# ─── Endpoints ───────────────────────────────────────────────────────────────\n   197→\n   198→@router.post(\"/request-link\", response_model=RequestLinkResponse)\n   199→async def request_magic_link(\n   200→    payload: RequestLinkPayload,\n   201→    request: Request,\n   202→    db: AsyncSession = Depends(get_db),\n   203→):\n   204→    \"\"\"\n   205→    Request a magic login link. Creates user if they don't exist.\n   206→\n   207→    In dev mode (DEBUG=true), returns the magic link directly in the response\n   208→    so you can click it without needing email infrastructure.\n   209→    In production, sends the link via Resend email service.\n   210→    \"\"\"\n   211→    email = payload.email.lower().strip()\n   212→    email_redacted = redact_email(email)\n   213→\n   214→    # Find or create user\n   215→    result = await db.execute(select(User).where(User.email == email))\n   216→    user = result.scalar_one_or_none()\n   217→\n   218→    if not user:\n   219→        user = User(email=email)\n   220→        db.add(user)\n   221→        await db.flush()\n   222→        logger.info(\n   223→            \"auth.user_created\",\n   224→            email_redacted=email_redacted,\n   225→            user_id=str(user.id),\n   226→        )\n   227→\n   228→    # Generate magic link token\n   229→    token = secrets.token_urlsafe(48)\n   230→    expires_at = datetime.now(timezone.utc) + timedelta(minutes=settings.magic_link_expiry_minutes)\n   231→\n   232→    magic_link_record = MagicLink(\n   233→        user_id=user.id,\n   234→        token=token,\n   235→        expires_at=expires_at,\n   236→    )\n   237→    db.add(magic_link_record)\n   238→    await db.commit()\n   239→\n   240→    # Build the magic link URL using frontend origin\n   241→    origin = request.headers.get(\"origin\", \"http://localhost:5173\")\n   242→    magic_link_url = f\"{origin}/auth/verify?token={token}\"\n   243→\n   244→    logger.info(\n   245→        \"auth.magic_link_created\",\n   246→        email_redacted=email_redacted,\n   247→        expires_at=expires_at.isoformat(),\n   248→    )\n   249→\n   250→    if settings.debug:\n   251→        # Dev mode: return link directly for easy testing\n   252→        return RequestLinkResponse(\n   253→            message=\"Magic link created. Click to log in.\",\n   254→            magic_link=magic_link_url,\n   255→            token=token,\n   256→        )\n   257→    else:\n   258→        # Production: send email via Resend\n   259→        email_sent = await send_magic_link_email(email, magic_link_url)\n   260→        if email_sent:\n   261→            return RequestLinkResponse(\n   262→                message=\"Check your email for a login link.\",\n   263→            )\n   264→        else:\n   265→            # Graceful degradation if email fails\n   266→            logger.warning(\n   267→                \"auth.email_fallback\",\n   268→                email_redacted=email_redacted,\n   269→                message=\"Email service unavailable\",\n   270→            )\n   271→            return RequestLinkResponse(\n   272→                message=\"Check your email for a login link.\",\n   273→            )\n   274→\n   275→\n   276→@router.post(\"/verify\", response_model=AuthResponse)\n   277→async def verify_magic_link(\n   278→    payload: VerifyTokenPayload,\n   279→    db: AsyncSession = Depends(get_db),\n   280→):\n   281→    \"\"\"\n   282→    Verify a magic link token and return a JWT access token.\n   283→\n   284→    The magic link token is single-use and time-limited.\n   285→    \"\"\"\n   286→    result = await db.execute(\n   287→        select(MagicLink).where(MagicLink.token == payload.token)\n   288→    )\n   289→    magic_link = result.scalar_one_or_none()\n   290→\n   291→    if not magic_link:\n   292→        raise HTTPException(status_code=401, detail=\"Invalid or expired link\")\n   293→\n   294→    if magic_link.is_used:\n   295→        raise HTTPException(status_code=401, detail=\"This link has already been used\")\n   296→\n   297→    if magic_link.expires_at.replace(tzinfo=timezone.utc) < datetime.now(timezone.utc):\n   298→        raise HTTPException(status_code=401, detail=\"This link has expired\")\n   299→\n   300→    # Mark as used\n   301→    magic_link.is_used = True\n   302→\n   303→    # Get the user\n   304→    user_result = await db.execute(\n   305→        select(User).where(User.id == magic_link.user_id)\n   306→    )\n   307→    user = user_result.scalar_one_or_none()\n   308→    if not user:\n   309→        raise HTTPException(status_code=401, detail=\"User not found\")\n   310→\n   311→    # Update last login\n   312→    user.last_login_at = datetime.now(timezone.utc)\n   313→    await db.commit()\n   314→\n   315→    # Issue JWT\n   316→    access_token = create_jwt(user.id, user.email)\n   317→\n   318→    logger.info(\n   319→        \"auth.login_success\",\n   320→        email_redacted=redact_email(user.email),\n   321→        user_id=str(user.id),\n   322→    )\n   323→\n   324→    return AuthResponse(\n   325→        access_token=access_token,\n   326→        user_id=str(user.id),\n   327→        email=user.email,\n   328→        is_onboarded=user.is_onboarded,\n   329→    )\n   330→\n   331→\n   332→@router.get(\"/me\", response_model=UserResponse)\n   333→async def get_me(\n   334→    current_user: User = Depends(get_current_user),\n   335→):\n   336→    \"\"\"Get the current authenticated user's info.\"\"\"\n   337→    return UserResponse(\n   338→        id=str(current_user.id),\n   339→        email=current_user.email,\n   340→        name=current_user.name,\n   341→        is_onboarded=current_user.is_onboarded,\n   342→        candidate_id=str(current_user.candidate_id) if current_user.candidate_id else None,\n   343→        created_at=current_user.created_at.isoformat(),\n   344→    )\n   345→"}]},"parent_tool_use_id":null,"session_id":"922c085c-e35c-4179-9c95-d428c008504e","uuid":"6281ac9d-9197-4923-89e0-f9d6643c4237","tool_use_result":{"type":"update","filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/api/auth.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nAuthentication API — passwordless magic link flow.\n\nPOST  /auth/request-link     → request a magic login link\nPOST  /auth/verify            → verify magic link token, return JWT\nGET   /auth/me                → get current authenticated user\n\"\"\"\n\nimport uuid\nimport secrets\nfrom datetime import datetime, timedelta, timezone\n\nimport jwt\nimport resend\nimport structlog\nfrom fastapi import APIRouter, Depends, HTTPException, Request\nfrom fastapi.security import HTTPBearer, HTTPAuthorizationCredentials\nfrom pydantic import BaseModel, EmailStr\nfrom sqlalchemy import select\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom backend.config import settings\nfrom backend.database import get_db\nfrom backend.models.auth import User, MagicLink\n\nlogger = structlog.get_logger(__name__)\nrouter = APIRouter()\nsecurity = HTTPBearer(auto_error=False)\n\n\n# ─── PII Redaction ────────────────────────────────────────────────────────────\n\ndef redact_email(email: str) -> str:\n    \"\"\"Redact email for safe logging. e.g. 'spy@seanyoung.biz' → 's**@s***.biz'\"\"\"\n    if not email or \"@\" not in email:\n        return \"[redacted]\"\n    local, domain = email.split(\"@\", 1)\n    domain_parts = domain.rsplit(\".\", 1)\n    redacted_local = local[0] + \"**\" if local else \"**\"\n    if len(domain_parts) == 2:\n        redacted_domain = domain_parts[0][0] + \"***.\" + domain_parts[1]\n    else:\n        redacted_domain = \"***\"\n    return f\"{redacted_local}@{redacted_domain}\"\n\n\n# ─── Schemas ─────────────────────────────────────────────────────────────────\n\nclass RequestLinkPayload(BaseModel):\n    \"\"\"Payload to request a magic link.\"\"\"\n    email: EmailStr\n\n\nclass RequestLinkResponse(BaseModel):\n    \"\"\"Response after requesting a magic link.\"\"\"\n    message: str\n    # In dev mode, we return the magic link directly so you can click it\n    magic_link: str | None = None\n    token: str | None = None\n\n\nclass VerifyTokenPayload(BaseModel):\n    \"\"\"Payload to verify a magic link token.\"\"\"\n    token: str\n\n\nclass AuthResponse(BaseModel):\n    \"\"\"Response with JWT access token.\"\"\"\n    access_token: str\n    token_type: str = \"bearer\"\n    user_id: str\n    email: str\n    is_onboarded: bool\n\n\nclass UserResponse(BaseModel):\n    \"\"\"Current user info.\"\"\"\n    id: str\n    email: str\n    name: str | None\n    is_onboarded: bool\n    candidate_id: str | None\n    created_at: str\n\n\n# ─── JWT Helpers ─────────────────────────────────────────────────────────────\n\ndef create_jwt(user_id: uuid.UUID, email: str) -> str:\n    \"\"\"Create a JWT access token for an authenticated user.\"\"\"\n    payload = {\n        \"sub\": str(user_id),\n        \"email\": email,\n        \"iat\": datetime.now(timezone.utc),\n        \"exp\": datetime.now(timezone.utc) + timedelta(days=7),\n    }\n    return jwt.encode(payload, settings.jwt_secret, algorithm=\"HS256\")\n\n\ndef decode_jwt(token: str) -> dict:\n    \"\"\"Decode and validate a JWT token.\"\"\"\n    try:\n        return jwt.decode(token, settings.jwt_secret, algorithms=[\"HS256\"])\n    except jwt.ExpiredSignatureError:\n        raise HTTPException(status_code=401, detail=\"Token expired\")\n    except jwt.InvalidTokenError:\n        raise HTTPException(status_code=401, detail=\"Invalid token\")\n\n\n# ─── Resend Email ─────────────────────────────────────────────────────────────\n\nasync def send_magic_link_email(email: str, magic_link_url: str) -> bool:\n    \"\"\"\n    Send magic link email via Resend.\n\n    Returns True if email was sent successfully, False otherwise.\n    Falls back gracefully if Resend is not configured.\n    \"\"\"\n    if not settings.resend_api_key:\n        logger.warning(\n            \"auth.resend_not_configured\",\n            email_redacted=redact_email(email),\n            message=\"Resend API key not set, email not sent\",\n        )\n        return False\n\n    resend.api_key = settings.resend_api_key\n\n    try:\n        resend.Emails.send({\n            \"from\": settings.resend_from_email,\n            \"to\": email,\n            \"subject\": \"Your Talent Agent Login Link\",\n            \"html\": f\"\"\"\n            <div style=\"font-family: 'DM Sans', -apple-system, sans-serif; max-width: 600px; margin: 0 auto; padding: 40px 20px; background-color: #0A0A0A; color: #FAFAFA;\">\n                <h1 style=\"font-family: 'Playfair Display', Georgia, serif; color: #C9A227; font-size: 28px; margin-bottom: 24px;\">\n                    Talent Agent\n                </h1>\n                <p style=\"font-size: 16px; line-height: 1.6; margin-bottom: 24px;\">\n                    Click the button below to sign in to your account. This link expires in {settings.magic_link_expiry_minutes} minutes.\n                </p>\n                <a href=\"{magic_link_url}\" style=\"display: inline-block; background-color: #C9A227; color: #0A0A0A; padding: 14px 28px; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px;\">\n                    Sign In\n                </a>\n                <p style=\"font-size: 14px; color: #737373; margin-top: 32px; line-height: 1.6;\">\n                    If you didn't request this link, you can safely ignore this email.\n                </p>\n                <hr style=\"border: none; border-top: 1px solid rgba(255,255,255,0.08); margin: 32px 0;\">\n                <p style=\"font-size: 12px; color: #737373;\">\n                    VibeSpace LLC · The Dot Connects\n                </p>\n            </div>\n            \"\"\",\n        })\n        logger.info(\n            \"auth.email_sent\",\n            email_redacted=redact_email(email),\n        )\n        return True\n    except Exception as e:\n        logger.error(\n            \"auth.email_send_failed\",\n            email_redacted=redact_email(email),\n            error=str(e),\n        )\n        return False\n\n\n# ─── Auth Dependency ─────────────────────────────────────────────────────────\n\nasync def get_current_user(\n    credentials: HTTPAuthorizationCredentials | None = Depends(security),\n    db: AsyncSession = Depends(get_db),\n) -> User:\n    \"\"\"FastAPI dependency that returns the current authenticated user.\"\"\"\n    if credentials is None:\n        raise HTTPException(status_code=401, detail=\"Not authenticated\")\n\n    payload = decode_jwt(credentials.credentials)\n    user_id = payload.get(\"sub\")\n    if not user_id:\n        raise HTTPException(status_code=401, detail=\"Invalid token payload\")\n\n    result = await db.execute(\n        select(User).where(User.id == uuid.UUID(user_id))\n    )\n    user = result.scalar_one_or_none()\n    if not user or not user.is_active:\n        raise HTTPException(status_code=401, detail=\"User not found or inactive\")\n\n    return user\n\n\n# ─── Endpoints ───────────────────────────────────────────────────────────────\n\n@router.post(\"/request-link\", response_model=RequestLinkResponse)\nasync def request_magic_link(\n    payload: RequestLinkPayload,\n    request: Request,\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"\n    Request a magic login link. Creates user if they don't exist.\n\n    In dev mode (DEBUG=true), returns the magic link directly in the response\n    so you can click it without needing email infrastructure.\n    In production, sends the link via Resend email service.\n    \"\"\"\n    email = payload.email.lower().strip()\n    email_redacted = redact_email(email)\n\n    # Find or create user\n    result = await db.execute(select(User).where(User.email == email))\n    user = result.scalar_one_or_none()\n\n    if not user:\n        user = User(email=email)\n        db.add(user)\n        await db.flush()\n        logger.info(\n            \"auth.user_created\",\n            email_redacted=email_redacted,\n            user_id=str(user.id),\n        )\n\n    # Generate magic link token\n    token = secrets.token_urlsafe(48)\n    expires_at = datetime.now(timezone.utc) + timedelta(minutes=settings.magic_link_expiry_minutes)\n\n    magic_link_record = MagicLink(\n        user_id=user.id,\n        token=token,\n        expires_at=expires_at,\n    )\n    db.add(magic_link_record)\n    await db.commit()\n\n    # Build the magic link URL using frontend origin\n    origin = request.headers.get(\"origin\", \"http://localhost:5173\")\n    magic_link_url = f\"{origin}/auth/verify?token={token}\"\n\n    logger.info(\n        \"auth.magic_link_created\",\n        email_redacted=email_redacted,\n        expires_at=expires_at.isoformat(),\n    )\n\n    if settings.debug:\n        # Dev mode: return link directly for easy testing\n        return RequestLinkResponse(\n            message=\"Magic link created. Click to log in.\",\n            magic_link=magic_link_url,\n            token=token,\n        )\n    else:\n        # Production: send email via Resend\n        email_sent = await send_magic_link_email(email, magic_link_url)\n        if email_sent:\n            return RequestLinkResponse(\n                message=\"Check your email for a login link.\",\n            )\n        else:\n            # Graceful degradation if email fails\n            logger.warning(\n                \"auth.email_fallback\",\n                email_redacted=email_redacted,\n                message=\"Email service unavailable\",\n            )\n            return RequestLinkResponse(\n                message=\"Check your email for a login link.\",\n            )\n\n\n@router.post(\"/verify\", response_model=AuthResponse)\nasync def verify_magic_link(\n    payload: VerifyTokenPayload,\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"\n    Verify a magic link token and return a JWT access token.\n\n    The magic link token is single-use and time-limited.\n    \"\"\"\n    result = await db.execute(\n        select(MagicLink).where(MagicLink.token == payload.token)\n    )\n    magic_link = result.scalar_one_or_none()\n\n    if not magic_link:\n        raise HTTPException(status_code=401, detail=\"Invalid or expired link\")\n\n    if magic_link.is_used:\n        raise HTTPException(status_code=401, detail=\"This link has already been used\")\n\n    if magic_link.expires_at.replace(tzinfo=timezone.utc) < datetime.now(timezone.utc):\n        raise HTTPException(status_code=401, detail=\"This link has expired\")\n\n    # Mark as used\n    magic_link.is_used = True\n\n    # Get the user\n    user_result = await db.execute(\n        select(User).where(User.id == magic_link.user_id)\n    )\n    user = user_result.scalar_one_or_none()\n    if not user:\n        raise HTTPException(status_code=401, detail=\"User not found\")\n\n    # Update last login\n    user.last_login_at = datetime.now(timezone.utc)\n    await db.commit()\n\n    # Issue JWT\n    access_token = create_jwt(user.id, user.email)\n\n    logger.info(\n        \"auth.login_success\",\n        email_redacted=redact_email(user.email),\n        user_id=str(user.id),\n    )\n\n    return AuthResponse(\n        access_token=access_token,\n        user_id=str(user.id),\n        email=user.email,\n        is_onboarded=user.is_onboarded,\n    )\n\n\n@router.get(\"/me\", response_model=UserResponse)\nasync def get_me(\n    current_user: User = Depends(get_current_user),\n):\n    \"\"\"Get the current authenticated user's info.\"\"\"\n    return UserResponse(\n        id=str(current_user.id),\n        email=current_user.email,\n        name=current_user.name,\n        is_onboarded=current_user.is_onboarded,\n        candidate_id=str(current_user.candidate_id) if current_user.candidate_id else None,\n        created_at=current_user.created_at.isoformat(),\n    )\n","structuredPatch":[{"oldStart":14,"oldLines":6,"newStart":14,"newLines":7,"lines":[" from datetime import datetime, timedelta, timezone"," "," import jwt","+import resend"," import structlog"," from fastapi import APIRouter, Depends, HTTPException, Request"," from fastapi.security import HTTPBearer, HTTPAuthorizationCredentials"]},{"oldStart":30,"oldLines":6,"newStart":31,"newLines":22,"lines":[" security = HTTPBearer(auto_error=False)"," "," ","+# ─── PII Redaction ────────────────────────────────────────────────────────────","+","+def redact_email(email: str) -> str:","+    \"\"\"Redact email for safe logging. e.g. 'spy@seanyoung.biz' → 's**@s***.biz'\"\"\"","+    if not email or \"@\" not in email:","+        return \"[redacted]\"","+    local, domain = email.split(\"@\", 1)","+    domain_parts = domain.rsplit(\".\", 1)","+    redacted_local = local[0] + \"**\" if local else \"**\"","+    if len(domain_parts) == 2:","+        redacted_domain = domain_parts[0][0] + \"***.\" + domain_parts[1]","+    else:","+        redacted_domain = \"***\"","+    return f\"{redacted_local}@{redacted_domain}\"","+","+"," # ─── Schemas ─────────────────────────────────────────────────────────────────"," "," class RequestLinkPayload(BaseModel):"]},{"oldStart":92,"oldLines":6,"newStart":109,"newLines":65,"lines":["         raise HTTPException(status_code=401, detail=\"Invalid token\")"," "," ","+# ─── Resend Email ─────────────────────────────────────────────────────────────","+","+async def send_magic_link_email(email: str, magic_link_url: str) -> bool:","+    \"\"\"","+    Send magic link email via Resend.","+","+    Returns True if email was sent successfully, False otherwise.","+    Falls back gracefully if Resend is not configured.","+    \"\"\"","+    if not settings.resend_api_key:","+        logger.warning(","+            \"auth.resend_not_configured\",","+            email_redacted=redact_email(email),","+            message=\"Resend API key not set, email not sent\",","+        )","+        return False","+","+    resend.api_key = settings.resend_api_key","+","+    try:","+        resend.Emails.send({","+            \"from\": settings.resend_from_email,","+            \"to\": email,","+            \"subject\": \"Your Talent Agent Login Link\",","+            \"html\": f\"\"\"","+            <div style=\"font-family: 'DM Sans', -apple-system, sans-serif; max-width: 600px; margin: 0 auto; padding: 40px 20px; background-color: #0A0A0A; color: #FAFAFA;\">","+                <h1 style=\"font-family: 'Playfair Display', Georgia, serif; color: #C9A227; font-size: 28px; margin-bottom: 24px;\">","+                    Talent Agent","+                </h1>","+                <p style=\"font-size: 16px; line-height: 1.6; margin-bottom: 24px;\">","+                    Click the button below to sign in to your account. This link expires in {settings.magic_link_expiry_minutes} minutes.","+                </p>","+                <a href=\"{magic_link_url}\" style=\"display: inline-block; background-color: #C9A227; color: #0A0A0A; padding: 14px 28px; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px;\">","+                    Sign In","+                </a>","+                <p style=\"font-size: 14px; color: #737373; margin-top: 32px; line-height: 1.6;\">","+                    If you didn't request this link, you can safely ignore this email.","+                </p>","+                <hr style=\"border: none; border-top: 1px solid rgba(255,255,255,0.08); margin: 32px 0;\">","+                <p style=\"font-size: 12px; color: #737373;\">","+                    VibeSpace LLC · The Dot Connects","+                </p>","+            </div>","+            \"\"\",","+        })","+        logger.info(","+            \"auth.email_sent\",","+            email_redacted=redact_email(email),","+        )","+        return True","+    except Exception as e:","+        logger.error(","+            \"auth.email_send_failed\",","+            email_redacted=redact_email(email),","+            error=str(e),","+        )","+        return False","+","+"," # ─── Auth Dependency ─────────────────────────────────────────────────────────"," "," async def get_current_user("]},{"oldStart":130,"oldLines":9,"newStart":206,"newLines":10,"lines":[" ","     In dev mode (DEBUG=true), returns the magic link directly in the response","     so you can click it without needing email infrastructure.","-    In production, this would send the link via email.","+    In production, sends the link via Resend email service.","     \"\"\"","     email = payload.email.lower().strip()","+    email_redacted = redact_email(email)"," ","     # Find or create user","     result = await db.execute(select(User).where(User.email == email))"]},{"oldStart":142,"oldLines":7,"newStart":219,"newLines":11,"lines":["         user = User(email=email)","         db.add(user)","         await db.flush()","-        logger.info(\"auth.user_created\", email=email, user_id=str(user.id))","+        logger.info(","+            \"auth.user_created\",","+            email_redacted=email_redacted,","+            user_id=str(user.id),","+        )"," ","     # Generate magic link token","     token = secrets.token_urlsafe(48)"]},{"oldStart":156,"oldLines":24,"newStart":237,"newLines":40,"lines":["     db.add(magic_link_record)","     await db.commit()"," ","-    # Build the magic link URL","-    base_url = str(request.base_url).rstrip(\"/\")","-    # Frontend will handle this route","-    magic_link_url = f\"{request.headers.get('origin', 'http://localhost:5173')}/auth/verify?token={token}\"","+    # Build the magic link URL using frontend origin","+    origin = request.headers.get(\"origin\", \"http://localhost:5173\")","+    magic_link_url = f\"{origin}/auth/verify?token={token}\""," ","-    logger.info(\"auth.magic_link_created\", email=email, expires_at=expires_at.isoformat())","+    logger.info(","+        \"auth.magic_link_created\",","+        email_redacted=email_redacted,","+        expires_at=expires_at.isoformat(),","+    )"," ","     if settings.debug:","+        # Dev mode: return link directly for easy testing","         return RequestLinkResponse(","             message=\"Magic link created. Click to log in.\",","             magic_link=magic_link_url,","             token=token,","         )","     else:","-        # TODO: Send email with magic link via email service","-        return RequestLinkResponse(","-            message=\"Check your email for a login link.\",","-        )","+        # Production: send email via Resend","+        email_sent = await send_magic_link_email(email, magic_link_url)","+        if email_sent:","+            return RequestLinkResponse(","+                message=\"Check your email for a login link.\",","+            )","+        else:","+            # Graceful degradation if email fails","+            logger.warning(","+                \"auth.email_fallback\",","+                email_redacted=email_redacted,","+                message=\"Email service unavailable\",","+            )","+            return RequestLinkResponse(","+                message=\"Check your email for a login link.\",","+            )"," "," "," @router.post(\"/verify\", response_model=AuthResponse)"]},{"oldStart":218,"oldLines":7,"newStart":315,"newLines":11,"lines":["     # Issue JWT","     access_token = create_jwt(user.id, user.email)"," ","-    logger.info(\"auth.login_success\", email=user.email, user_id=str(user.id))","+    logger.info(","+        \"auth.login_success\",","+        email_redacted=redact_email(user.email),","+        user_id=str(user.id),","+    )"," ","     return AuthResponse(","         access_token=access_token,"]}],"originalFile":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nAuthentication API — passwordless magic link flow.\n\nPOST  /auth/request-link     → request a magic login link\nPOST  /auth/verify            → verify magic link token, return JWT\nGET   /auth/me                → get current authenticated user\n\"\"\"\n\nimport uuid\nimport secrets\nfrom datetime import datetime, timedelta, timezone\n\nimport jwt\nimport structlog\nfrom fastapi import APIRouter, Depends, HTTPException, Request\nfrom fastapi.security import HTTPBearer, HTTPAuthorizationCredentials\nfrom pydantic import BaseModel, EmailStr\nfrom sqlalchemy import select\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom backend.config import settings\nfrom backend.database import get_db\nfrom backend.models.auth import User, MagicLink\n\nlogger = structlog.get_logger(__name__)\nrouter = APIRouter()\nsecurity = HTTPBearer(auto_error=False)\n\n\n# ─── Schemas ─────────────────────────────────────────────────────────────────\n\nclass RequestLinkPayload(BaseModel):\n    \"\"\"Payload to request a magic link.\"\"\"\n    email: EmailStr\n\n\nclass RequestLinkResponse(BaseModel):\n    \"\"\"Response after requesting a magic link.\"\"\"\n    message: str\n    # In dev mode, we return the magic link directly so you can click it\n    magic_link: str | None = None\n    token: str | None = None\n\n\nclass VerifyTokenPayload(BaseModel):\n    \"\"\"Payload to verify a magic link token.\"\"\"\n    token: str\n\n\nclass AuthResponse(BaseModel):\n    \"\"\"Response with JWT access token.\"\"\"\n    access_token: str\n    token_type: str = \"bearer\"\n    user_id: str\n    email: str\n    is_onboarded: bool\n\n\nclass UserResponse(BaseModel):\n    \"\"\"Current user info.\"\"\"\n    id: str\n    email: str\n    name: str | None\n    is_onboarded: bool\n    candidate_id: str | None\n    created_at: str\n\n\n# ─── JWT Helpers ─────────────────────────────────────────────────────────────\n\ndef create_jwt(user_id: uuid.UUID, email: str) -> str:\n    \"\"\"Create a JWT access token for an authenticated user.\"\"\"\n    payload = {\n        \"sub\": str(user_id),\n        \"email\": email,\n        \"iat\": datetime.now(timezone.utc),\n        \"exp\": datetime.now(timezone.utc) + timedelta(days=7),\n    }\n    return jwt.encode(payload, settings.jwt_secret, algorithm=\"HS256\")\n\n\ndef decode_jwt(token: str) -> dict:\n    \"\"\"Decode and validate a JWT token.\"\"\"\n    try:\n        return jwt.decode(token, settings.jwt_secret, algorithms=[\"HS256\"])\n    except jwt.ExpiredSignatureError:\n        raise HTTPException(status_code=401, detail=\"Token expired\")\n    except jwt.InvalidTokenError:\n        raise HTTPException(status_code=401, detail=\"Invalid token\")\n\n\n# ─── Auth Dependency ─────────────────────────────────────────────────────────\n\nasync def get_current_user(\n    credentials: HTTPAuthorizationCredentials | None = Depends(security),\n    db: AsyncSession = Depends(get_db),\n) -> User:\n    \"\"\"FastAPI dependency that returns the current authenticated user.\"\"\"\n    if credentials is None:\n        raise HTTPException(status_code=401, detail=\"Not authenticated\")\n\n    payload = decode_jwt(credentials.credentials)\n    user_id = payload.get(\"sub\")\n    if not user_id:\n        raise HTTPException(status_code=401, detail=\"Invalid token payload\")\n\n    result = await db.execute(\n        select(User).where(User.id == uuid.UUID(user_id))\n    )\n    user = result.scalar_one_or_none()\n    if not user or not user.is_active:\n        raise HTTPException(status_code=401, detail=\"User not found or inactive\")\n\n    return user\n\n\n# ─── Endpoints ───────────────────────────────────────────────────────────────\n\n@router.post(\"/request-link\", response_model=RequestLinkResponse)\nasync def request_magic_link(\n    payload: RequestLinkPayload,\n    request: Request,\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"\n    Request a magic login link. Creates user if they don't exist.\n\n    In dev mode (DEBUG=true), returns the magic link directly in the response\n    so you can click it without needing email infrastructure.\n    In production, this would send the link via email.\n    \"\"\"\n    email = payload.email.lower().strip()\n\n    # Find or create user\n    result = await db.execute(select(User).where(User.email == email))\n    user = result.scalar_one_or_none()\n\n    if not user:\n        user = User(email=email)\n        db.add(user)\n        await db.flush()\n        logger.info(\"auth.user_created\", email=email, user_id=str(user.id))\n\n    # Generate magic link token\n    token = secrets.token_urlsafe(48)\n    expires_at = datetime.now(timezone.utc) + timedelta(minutes=settings.magic_link_expiry_minutes)\n\n    magic_link_record = MagicLink(\n        user_id=user.id,\n        token=token,\n        expires_at=expires_at,\n    )\n    db.add(magic_link_record)\n    await db.commit()\n\n    # Build the magic link URL\n    base_url = str(request.base_url).rstrip(\"/\")\n    # Frontend will handle this route\n    magic_link_url = f\"{request.headers.get('origin', 'http://localhost:5173')}/auth/verify?token={token}\"\n\n    logger.info(\"auth.magic_link_created\", email=email, expires_at=expires_at.isoformat())\n\n    if settings.debug:\n        return RequestLinkResponse(\n            message=\"Magic link created. Click to log in.\",\n            magic_link=magic_link_url,\n            token=token,\n        )\n    else:\n        # TODO: Send email with magic link via email service\n        return RequestLinkResponse(\n            message=\"Check your email for a login link.\",\n        )\n\n\n@router.post(\"/verify\", response_model=AuthResponse)\nasync def verify_magic_link(\n    payload: VerifyTokenPayload,\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"\n    Verify a magic link token and return a JWT access token.\n\n    The magic link token is single-use and time-limited.\n    \"\"\"\n    result = await db.execute(\n        select(MagicLink).where(MagicLink.token == payload.token)\n    )\n    magic_link = result.scalar_one_or_none()\n\n    if not magic_link:\n        raise HTTPException(status_code=401, detail=\"Invalid or expired link\")\n\n    if magic_link.is_used:\n        raise HTTPException(status_code=401, detail=\"This link has already been used\")\n\n    if magic_link.expires_at.replace(tzinfo=timezone.utc) < datetime.now(timezone.utc):\n        raise HTTPException(status_code=401, detail=\"This link has expired\")\n\n    # Mark as used\n    magic_link.is_used = True\n\n    # Get the user\n    user_result = await db.execute(\n        select(User).where(User.id == magic_link.user_id)\n    )\n    user = user_result.scalar_one_or_none()\n    if not user:\n        raise HTTPException(status_code=401, detail=\"User not found\")\n\n    # Update last login\n    user.last_login_at = datetime.now(timezone.utc)\n    await db.commit()\n\n    # Issue JWT\n    access_token = create_jwt(user.id, user.email)\n\n    logger.info(\"auth.login_success\", email=user.email, user_id=str(user.id))\n\n    return AuthResponse(\n        access_token=access_token,\n        user_id=str(user.id),\n        email=user.email,\n        is_onboarded=user.is_onboarded,\n    )\n\n\n@router.get(\"/me\", response_model=UserResponse)\nasync def get_me(\n    current_user: User = Depends(get_current_user),\n):\n    \"\"\"Get the current authenticated user's info.\"\"\"\n    return UserResponse(\n        id=str(current_user.id),\n        email=current_user.email,\n        name=current_user.name,\n        is_onboarded=current_user.is_onboarded,\n        candidate_id=str(current_user.candidate_id) if current_user.candidate_id else None,\n        created_at=current_user.created_at.isoformat(),\n    )\n"}}}
