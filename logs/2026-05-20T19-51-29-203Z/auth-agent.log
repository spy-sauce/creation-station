iscovery\", tags=[\"discovery\"])\nrouter.include_router(application.router, prefix=\"/application\", tags=[\"application\"])\nrouter.include_router(review.router, prefix=\"/review\", tags=[\"review\"])\n","numLines":14,"startLine":1,"totalLines":14}}}}
