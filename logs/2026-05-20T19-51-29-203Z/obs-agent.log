{"t":"2026-05-20T19:58:54.382Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DtMiUVefQ9Fa8DLWBALsvB","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Discovery Orchestrator — coordinates the full daily discovery run.\n     6→\n     7→This is the entry point for both the Celery cron job and the manual API trigger.\n     8→\n     9→Flow:\n    10→  load_candidate(candidate_id)\n    11→    → identity_profiler.build_profile()\n    12→    → archetype_generator.expand()\n    13→    → crawler_agent.run(manifest)           ← currently stubbed\n    14→    → relevance_scorer.score_batch(jobs)\n    15→    → digest_builder.compile(scored_jobs)\n    16→    → emit DIGEST_READY\n    17→\n    18→Concurrency:\n    19→  - Scoring runs with bounded concurrency (CRAWL_CONCURRENCY semaphore)\n    20→  - Digest build follows after all scoring is complete\n    21→\n    22→Status machine:\n    23→  QUEUED → RUNNING → COMPLETED\n    24→                   → FAILED\n    25→\"\"\"\n    26→\n    27→import asyncio\n    28→from datetime import datetime, timezone\n    29→from uuid import UUID\n    30→\n    31→import redis.asyncio as aioredis\n    32→import structlog\n    33→from anthropic import AsyncAnthropic\n    34→from sqlalchemy import select\n    35→from sqlalchemy.ext.asyncio import AsyncSession\n    36→\n    37→from backend.config import settings\n    38→from backend.agents.discovery.schemas import CandidateSchema, DailyDigestSchema\n    39→from backend.agents.discovery.identity_profiler import IdentityProfiler\n    40→from backend.agents.discovery.archetype_generator import ArchetypeGenerator\n    41→from backend.agents.discovery.crawler_agent import CrawlerAgent\n    42→from backend.agents.discovery.relevance_scorer import RelevanceScorer\n    43→from backend.agents.discovery.digest_builder import DigestBuilder\n    44→from backend.models.discovery import Candidate as CandidateORM, CrawlRun\n    45→\n    46→logger = structlog.get_logger(__name__)\n    47→\n    48→\n    49→class DiscoveryOrchestrator:\n    50→    \"\"\"\n    51→    Coordinates the full Discovery Engine pipeline for a single candidate.\n    52→\n    53→    Designed to run once per candidate per day via Celery cron,\n    54→    or on-demand via the API trigger endpoint.\n    55→    \"\"\"\n    56→\n    57→    def __init__(self, db: AsyncSession, redis_client: aioredis.Redis):\n    58→        self._db = db\n    59→        self._redis = redis_client\n    60→        self._claude = AsyncAnthropic(api_key=settings.anthropic_api_key)\n    61→\n    62→        self._profiler = IdentityProfiler(redis_client, self._claude)\n    63→        self._archetype_gen = ArchetypeGenerator()\n    64→        self._scorer = RelevanceScorer(self._claude)\n    65→        self._digest_builder = DigestBuilder(redis_client, self._claude, db)\n    66→\n    67→    async def run(\n    68→        self,\n    69→        candidate_id: UUID,\n    70→        dry_run: bool = False,\n    71→    ) -> DailyDigestSchema:\n    72→        \"\"\"\n    73→        Execute a full daily discovery run for a candidate.\n    74→\n    75→        Args:\n    76→            candidate_id: UUID of the candidate to run for\n    77→            dry_run: If True, don't write to DB or publish events\n    78→\n    79→        Returns:\n    80→            DailyDigestSchema with the full ranked digest\n    81→        \"\"\"\n    82→        crawl_run = await self._start_run(candidate_id, dry_run)\n    83→        log = logger.bind(candidate_id=str(candidate_id), dry_run=dry_run)\n    84→\n    85→        try:\n    86→            # 1. Load candidate\n    87→            candidate = await self._load_candidate(candidate_id)\n    88→            log.info(\"orchestrator.candidate_loaded\", name=candidate.name)\n    89→\n    90→            # 2. Build identity profile (cached 24h)\n    91→            profile = await self._profiler.build_profile(candidate)\n    92→            log.info(\n    93→                \"orchestrator.profile_built\",\n    94→                archetypes=len(profile.role_expansion),\n    95→                level=profile.leadership_level,\n    96→            )\n    97→\n    98→            # 3. Expand archetypes into search manifest\n    99→            excluded = {\n   100→                \"titles\": [],\n   101→                \"companies\": candidate.excluded_companies or [],\n   102→                \"industries\": candidate.excluded_industries or [],\n   103→            }\n   104→            manifest = self._archetype_gen.expand(profile, excluded)\n   105→            log.info(\n   106→                \"orchestrator.manifest_built\",\n   107→                target_titles=len(manifest.target_titles),\n   108→                keywords=len(manifest.keywords),\n   109→            )\n   110→\n   111→            # 4. Crawl (currently stubbed — Phase 1B)\n   112→            crawler = CrawlerAgent(candidate_id)\n   113→            raw_jobs = await crawler.run(manifest)\n   114→            log.info(\"orchestrator.crawl_complete\", jobs_found=len(raw_jobs))\n   115→\n   116→            # 5. Score with bounded concurrency\n   117→            semaphore = asyncio.Semaphore(settings.crawl_concurrency)\n   118→\n   119→            async def score_with_semaphore(job):\n   120→                async with semaphore:\n   121→                    return job\n   122→\n   123→            # Fan out scoring — respect the semaphore so we don't hammer Claude\n   124→            scored_jobs = await self._scorer.score_batch(\n   125→                raw_jobs, profile, min_score=settings.min_score\n   126→            )\n   127→            log.info(\n   128→                \"orchestrator.scoring_complete\",\n   129→                passed=len(scored_jobs),\n   130→                filtered=len(raw_jobs) - len(scored_jobs),\n   131→            )\n   132→\n   133→            # 6. Build and publish digest\n   134→            digest = await self._digest_builder.compile(\n   135→                candidate_id=candidate_id,\n   136→                scored_jobs=scored_jobs,\n   137→                total_discovered=len(raw_jobs),\n   138→            ) if not dry_run else self._build_dry_run_digest(candidate_id, scored_jobs, len(raw_jobs))\n   139→\n   140→            await self._complete_run(crawl_run, len(raw_jobs), len(scored_jobs), dry_run)\n   141→            log.info(\n   142→                \"orchestrator.run_complete\",\n   143→                top_picks=len(digest.top_picks),\n   144→                hot_picks=len(digest.hot_picks),\n   145→            )\n   146→            return digest\n   147→\n   148→        except Exception as e:\n   149→            log.error(\"orchestrator.run_failed\", error=str(e))\n   150→            await self._fail_run(crawl_run, str(e), dry_run)\n   151→            raise\n   152→\n   153→    async def _load_candidate(self, candidate_id: UUID) -> CandidateSchema:\n   154→        \"\"\"Load candidate from PostgreSQL and convert to schema.\"\"\"\n   155→        result = await self._db.execute(\n   156→            select(CandidateORM).where(CandidateORM.id == candidate_id)\n   157→        )\n   158→        orm = result.scalar_one_or_none()\n   159→        if not orm:\n   160→            raise ValueError(f\"Candidate {candidate_id} not found\")\n   161→        return CandidateSchema.model_validate(orm)\n   162→\n   163→    async def _start_run(self, candidate_id: UUID, dry_run: bool) -> CrawlRun | None:\n   164→        \"\"\"Create a CrawlRun record and return it (None in dry_run mode).\"\"\"\n   165→        if dry_run:\n   166→            return None\n   167→        run = CrawlRun(candidate_id=candidate_id, status=\"RUNNING\")\n   168→        self._db.add(run)\n   169→        await self._db.commit()\n   170→        await self._db.refresh(run)\n   171→        return run\n   172→\n   173→    async def _complete_run(\n   174→        self, run: CrawlRun | None, discovered: int, scored: int, dry_run: bool\n   175→    ) -> None:\n   176→        \"\"\"Mark the CrawlRun as COMPLETED.\"\"\"\n   177→        if dry_run or run is None:\n   178→            return\n   179→        run.status = \"COMPLETED\"\n   180→        run.completed_at = datetime.now(timezone.utc)\n   181→        run.jobs_discovered = discovered\n   182→        run.jobs_scored = scored\n   183→        await self._db.commit()\n   184→\n   185→    async def _fail_run(self, run: CrawlRun | None, error: str, dry_run: bool) -> None:\n   186→        \"\"\"Mark the CrawlRun as FAILED with error log.\"\"\"\n   187→        if dry_run or run is None:\n   188→            return\n   189→        run.status = \"FAILED\"\n   190→        run.completed_at = datetime.now(timezone.utc)\n   191→        run.error_log = error\n   192→        await self._db.commit()\n   193→\n   194→    def _build_dry_run_digest(self, candidate_id: UUID, scored_jobs, total_discovered: int):\n   195→        \"\"\"Build an in-memory digest without DB writes — for dry_run mode.\"\"\"\n   196→        from backend.agents.discovery.schemas import DailyDigestSchema\n   197→        from datetime import date\n   198→\n   199→        return DailyDigestSchema(\n   200→            candidate_id=candidate_id,\n   201→            run_date=date.today().isoformat(),\n   202→            total_discovered=total_discovered,\n   203→            total_scored=len(scored_jobs),\n   204→            top_picks=[],\n   205→            hot_picks=[],\n   206→            new_companies=[],\n   207→            digest_summary=\"[dry_run] No data written to DB.\",\n   208→        )\n   209→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"a1cd0453-8e62-43ca-a0ab-dba663c28138","uuid":"f3a20802-fe64-446b-85e6-d0c6f4acb2d5","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/discovery/orchestrator.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nDiscovery Orchestrator — coordinates the full daily discovery run.\n\nThis is the entry point for both the Celery cron job and the manual API trigger.\n\nFlow:\n  load_candidate(candidate_id)\n    → identity_profiler.build_profile()\n    → archetype_generator.expand()\n    → crawler_agent.run(manifest)           ← currently stubbed\n    → relevance_scorer.score_batch(jobs)\n    → digest_builder.compile(scored_jobs)\n    → emit DIGEST_READY\n\nConcurrency:\n  - Scoring runs with bounded concurrency (CRAWL_CONCURRENCY semaphore)\n  - Digest build follows after all scoring is complete\n\nStatus machine:\n  QUEUED → RUNNING → COMPLETED\n                   → FAILED\n\"\"\"\n\nimport asyncio\nfrom datetime import datetime, timezone\nfrom uuid import UUID\n\nimport redis.asyncio as aioredis\nimport structlog\nfrom anthropic import AsyncAnthropic\nfrom sqlalchemy import select\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom backend.config import settings\nfrom backend.agents.discovery.schemas import CandidateSchema, DailyDigestSchema\nfrom backend.agents.discovery.identity_profiler import IdentityProfiler\nfrom backend.agents.discovery.archetype_generator import ArchetypeGenerator\nfrom backend.agents.discovery.crawler_agent import CrawlerAgent\nfrom backend.agents.discovery.relevance_scorer import RelevanceScorer\nfrom backend.agents.discovery.digest_builder import DigestBuilder\nfrom backend.models.discovery import Candidate as CandidateORM, CrawlRun\n\nlogger = structlog.get_logger(__name__)\n\n\nclass DiscoveryOrchestrator:\n    \"\"\"\n    Coordinates the full Discovery Engine pipeline for a single candidate.\n\n    Designed to run once per candidate per day via Celery cron,\n    or on-demand via the API trigger endpoint.\n    \"\"\"\n\n    def __init__(self, db: AsyncSession, redis_client: aioredis.Redis):\n        self._db = db\n        self._redis = redis_client\n        self._claude = AsyncAnthropic(api_key=settings.anthropic_api_key)\n\n        self._profiler = IdentityProfiler(redis_client, self._claude)\n        self._archetype_gen = ArchetypeGenerator()\n        self._scorer = RelevanceScorer(self._claude)\n        self._digest_builder = DigestBuilder(redis_client, self._claude, db)\n\n    async def run(\n        self,\n        candidate_id: UUID,\n        dry_run: bool = False,\n    ) -> DailyDigestSchema:\n        \"\"\"\n        Execute a full daily discovery run for a candidate.\n\n        Args:\n            candidate_id: UUID of the candidate to run for\n            dry_run: If True, don't write to DB or publish events\n\n        Returns:\n            DailyDigestSchema with the full ranked digest\n        \"\"\"\n        crawl_run = await self._start_run(candidate_id, dry_run)\n        log = logger.bind(candidate_id=str(candidate_id), dry_run=dry_run)\n\n        try:\n            # 1. Load candidate\n            candidate = await self._load_candidate(candidate_id)\n            log.info(\"orchestrator.candidate_loaded\", name=candidate.name)\n\n            # 2. Build identity profile (cached 24h)\n            profile = await self._profiler.build_profile(candidate)\n            log.info(\n                \"orchestrator.profile_built\",\n                archetypes=len(profile.role_expansion),\n                level=profile.leadership_level,\n            )\n\n            # 3. Expand archetypes into search manifest\n            excluded = {\n                \"titles\": [],\n                \"companies\": candidate.excluded_companies or [],\n                \"industries\": candidate.excluded_industries or [],\n            }\n            manifest = self._archetype_gen.expand(profile, excluded)\n            log.info(\n                \"orchestrator.manifest_built\",\n                target_titles=len(manifest.target_titles),\n                keywords=len(manifest.keywords),\n            )\n\n            # 4. Crawl (currently stubbed — Phase 1B)\n            crawler = CrawlerAgent(candidate_id)\n            raw_jobs = await crawler.run(manifest)\n            log.info(\"orchestrator.crawl_complete\", jobs_found=len(raw_jobs))\n\n            # 5. Score with bounded concurrency\n            semaphore = asyncio.Semaphore(settings.crawl_concurrency)\n\n            async def score_with_semaphore(job):\n                async with semaphore:\n                    return job\n\n            # Fan out scoring — respect the semaphore so we don't hammer Claude\n            scored_jobs = await self._scorer.score_batch(\n                raw_jobs, profile, min_score=settings.min_score\n            )\n            log.info(\n                \"orchestrator.scoring_complete\",\n                passed=len(scored_jobs),\n                filtered=len(raw_jobs) - len(scored_jobs),\n            )\n\n            # 6. Build and publish digest\n            digest = await self._digest_builder.compile(\n                candidate_id=candidate_id,\n                scored_jobs=scored_jobs,\n                total_discovered=len(raw_jobs),\n            ) if not dry_run else self._build_dry_run_digest(candidate_id, scored_jobs, len(raw_jobs))\n\n            await self._complete_run(crawl_run, len(raw_jobs), len(scored_jobs), dry_run)\n            log.info(\n                \"orchestrator.run_complete\",\n                top_picks=len(digest.top_picks),\n                hot_picks=len(digest.hot_picks),\n            )\n            return digest\n\n        except Exception as e:\n            log.error(\"orchestrator.run_failed\", error=str(e))\n            await self._fail_run(crawl_run, str(e), dry_run)\n            raise\n\n    async def _load_candidate(self, candidate_id: UUID) -> CandidateSchema:\n        \"\"\"Load candidate from PostgreSQL and convert to schema.\"\"\"\n        result = await self._db.execute(\n            select(CandidateORM).where(CandidateORM.id == candidate_id)\n        )\n        orm = result.scalar_one_or_none()\n        if not orm:\n            raise ValueError(f\"Candidate {candidate_id} not found\")\n        return CandidateSchema.model_validate(orm)\n\n    async def _start_run(self, candidate_id: UUID, dry_run: bool) -> CrawlRun | None:\n        \"\"\"Create a CrawlRun record and return it (None in dry_run mode).\"\"\"\n        if dry_run:\n            return None\n        run = CrawlRun(candidate_id=candidate_id, status=\"RUNNING\")\n        self._db.add(run)\n        await self._db.commit()\n        await self._db.refresh(run)\n        return run\n\n    async def _complete_run(\n        self, run: CrawlRun | None, discovered: int, scored: int, dry_run: bool\n    ) -> None:\n        \"\"\"Mark the CrawlRun as COMPLETED.\"\"\"\n        if dry_run or run is None:\n            return\n        run.status = \"COMPLETED\"\n        run.completed_at = datetime.now(timezone.utc)\n        run.jobs_discovered = discovered\n        run.jobs_scored = scored\n        await self._db.commit()\n\n    async def _fail_run(self, run: CrawlRun | None, error: str, dry_run: bool) -> None:\n        \"\"\"Mark the CrawlRun as FAILED with error log.\"\"\"\n        if dry_run or run is None:\n            return\n        run.status = \"FAILED\"\n        run.completed_at = datetime.now(timezone.utc)\n        run.error_log = error\n        await self._db.commit()\n\n    def _build_dry_run_digest(self, candidate_id: UUID, scored_jobs, total_discovered: int):\n        \"\"\"Build an in-memory digest without DB writes — for dry_run mode.\"\"\"\n        from backend.agents.discovery.schemas import DailyDigestSchema\n        from datetime import date\n\n        return DailyDigestSchema(\n            candidate_id=candidate_id,\n            run_date=date.today().isoformat(),\n            total_discovered=total_discovered,\n            total_scored=len(scored_jobs),\n            top_picks=[],\n            hot_picks=[],\n            new_companies=[],\n            digest_summary=\"[dry_run] No data written to DB.\",\n        )\n","numLines":209,"startLine":1,"totalLines":209}}}}
