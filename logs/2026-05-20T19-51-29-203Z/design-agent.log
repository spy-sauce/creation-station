{"t":"2026-05-20T19:51:53.482Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DcVsRoszbE6qi99wero7NC","type":"tool_result","content":"     1→@import \"tailwindcss\";\n     2→\n     3→/* ═══════════════════════════════════════════════\n     4→   TALENT AGENT — DESIGN SYSTEM\n     5→   Derived from seanyoung.biz consulting site\n     6→   ═══════════════════════════════════════════════ */\n     7→\n     8→:root {\n     9→  --black: #080808;\n    10→  --off-black: #0f0f0f;\n    11→  --surface: #161616;\n    12→  --border: rgba(255,255,255,0.07);\n    13→  --gold: #C9A84C;\n    14→  --gold-light: #E8C97A;\n    15→  --white: #F4F1EB;\n    16→  --muted: rgba(244,241,235,0.45);\n    17→  --mono: 'DM Mono', monospace;\n    18→  --serif: 'Playfair Display', Georgia, serif;\n    19→  --sans: 'DM Sans', sans-serif;\n    20→  --nav-bg: rgba(8,8,8,0.95);\n    21→  --transition-theme: background 0.35s ease, color 0.35s ease, border-color 0.35s ease;\n    22→  /* status */\n    23→  --emerald: #34D399;\n    24→  --rose: #FB7185;\n    25→  --amber: #FBBF24;\n    26→}\n    27→\n    28→html { scroll-behavior: smooth; }\n    29→\n    30→body {\n    31→  background: var(--black);\n    32→  color: var(--white);\n    33→  font-family: var(--sans);\n    34→  font-weight: 300;\n    35→  line-height: 1.7;\n    36→  margin: 0;\n    37→  overflow-x: hidden;\n    38→  transition: var(--transition-theme);\n    39→  -webkit-font-smoothing: antialiased;\n    40→}\n    41→\n    42→::selection { background: rgba(201,168,76,0.3); color: var(--white); }\n    43→::-webkit-scrollbar { width: 6px; }\n    44→::-webkit-scrollbar-track { background: transparent; }\n    45→::-webkit-scrollbar-thumb { background: rgba(201,168,76,0.15); }\n    46→::-webkit-scrollbar-thumb:hover { background: rgba(201,168,76,0.3); }\n    47→\n    48→/* ── Typography ── */\n    49→.t-serif {\n    50→  font-family: var(--serif);\n    51→  font-weight: 400;\n    52→  line-height: 1.15;\n    53→}\n    54→.t-serif-bold {\n    55→  font-family: var(--serif);\n    56→  font-weight: 700;\n    57→  line-height: 1.1;\n    58→}\n    59→.t-label {\n    60→  font-family: var(--mono);\n    61→  font-size: 10px;\n    62→  letter-spacing: 0.25em;\n    63→  text-transform: uppercase;\n    64→  color: var(--muted);\n    65→}\n    66→.t-label-gold {\n    67→  font-family: var(--mono);\n    68→  font-size: 10px;\n    69→  letter-spacing: 0.25em;\n    70→  text-transform: uppercase;\n    71→  color: var(--gold);\n    72→}\n    73→.t-body {\n    74→  font-size: 14px;\n    75→  color: var(--muted);\n    76→  line-height: 1.8;\n    77→  font-weight: 300;\n    78→}\n    79→\n    80→/* ── Section label (with gold dash) ── */\n    81→.section-label {\n    82→  font-family: var(--mono);\n    83→  font-size: 10px;\n    84→  letter-spacing: 0.35em;\n    85→  text-transform: uppercase;\n    86→  color: var(--gold);\n    87→  margin-bottom: 48px;\n    88→  display: flex;\n    89→  align-items: center;\n    90→  gap: 16px;\n    91→}\n    92→.section-label::after {\n    93→  content: '';\n    94→  width: 40px;\n    95→  height: 1px;\n    96→  background: var(--gold);\n    97→  opacity: 0.4;\n    98→}\n    99→\n   100→/* ── Buttons (exact match) ── */\n   101→.btn-primary {\n   102→  display: inline-flex;\n   103→  align-items: center;\n   104→  justify-content: center;\n   105→  gap: 8px;\n   106→  padding: 16px 36px;\n   107→  background: var(--gold);\n   108→  color: #080808;\n   109→  font-family: var(--mono);\n   110→  font-size: 12px;\n   111→  letter-spacing: 0.15em;\n   112→  text-transform: uppercase;\n   113→  text-decoration: none;\n   114→  border: none;\n   115→  cursor: pointer;\n   116→  transition: background 0.2s;\n   117→}\n   118→.btn-primary:hover { background: var(--gold-light); }\n   119→.btn-primary:disabled { opacity: 0.35; cursor: not-allowed; }\n   120→\n   121→.btn-ghost {\n   122→  display: inline-flex;\n   123→  align-items: center;\n   124→  justify-content: center;\n   125→  gap: 8px;\n   126→  padding: 16px 36px;\n   127→  border: 1px solid var(--border);\n   128→  color: var(--muted);\n   129→  font-family: var(--mono);\n   130→  font-size: 12px;\n   131→  letter-spacing: 0.15em;\n   132→  text-transform: uppercase;\n   133→  text-decoration: none;\n   134→  background: transparent;\n   135→  cursor: pointer;\n   136→  transition: border-color 0.2s, color 0.2s;\n   137→}\n   138→.btn-ghost:hover { border-color: rgba(255,255,255,0.3); color: var(--white); }\n   139→\n   140→/* ── Inputs (exact form-group match) ── */\n   141→.input {\n   142→  background: var(--surface);\n   143→  border: 1px solid var(--border);\n   144→  color: var(--white);\n   145→  font-family: var(--sans);\n   146→  font-size: 14px;\n   147→  font-weight: 300;\n   148→  padding: 14px 18px;\n   149→  outline: none;\n   150→  transition: border-color 0.2s;\n   151→  width: 100%;\n   152→  appearance: none;\n   153→}\n   154→.input:focus { border-color: var(--gold); }\n   155→.input::placeholder { color: var(--muted); opacity: 0.6; }\n   156→.input:disabled { opacity: 0.45; }\n   157→\n   158→.input-label {\n   159→  font-family: var(--mono);\n   160→  font-size: 10px;\n   161→  letter-spacing: 0.2em;\n   162→  text-transform: uppercase;\n   163→  color: var(--muted);\n   164→  display: block;\n   165→  margin-bottom: 8px;\n   166→}\n   167→\n   168→/* ── Cards (1px grid gap pattern) ── */\n   169→.grid-border {\n   170→  display: grid;\n   171→  gap: 1px;\n   172→  background: var(--border);\n   173→  border: 1px solid var(--border);\n   174→}\n   175→.grid-border > * {\n   176→  background: var(--off-black);\n   177→}\n   178→\n   179→/* ── Card hover (gold top-border animation) ── */\n   180→.card-hover {\n   181→  position: relative;\n   182→  overflow: hidden;\n   183→}\n   184→.card-hover::before {\n   185→  content: '';\n   186→  position: absolute;\n   187→  top: 0;\n   188→  left: 0;\n   189→  right: 0;\n   190→  height: 2px;\n   191→  background: var(--gold);\n   192→  transform: scaleX(0);\n   193→  transform-origin: left;\n   194→  transition: transform 0.4s;\n   195→}\n   196→.card-hover:hover::before { transform: scaleX(1); }\n   197→\n   198→/* ── Stat row ── */\n   199→.stat-num {\n   200→  font-family: var(--serif);\n   201→  font-size: 36px;\n   202→  font-weight: 700;\n   203→  color: var(--gold);\n   204→  line-height: 1;\n   205→}\n   206→.stat-label {\n   207→  font-family: var(--mono);\n   208→  font-size: 10px;\n   209→  letter-spacing: 0.2em;\n   210→  text-transform: uppercase;\n   211→  color: var(--muted);\n   212→  margin-top: 8px;\n   213→}\n   214→\n   215→/* ── Tags ── */\n   216→.tag {\n   217→  font-family: var(--mono);\n   218→  font-size: 9px;\n   219→  letter-spacing: 0.15em;\n   220→  text-transform: uppercase;\n   221→  padding: 5px 10px;\n   222→  border: 1px solid var(--border);\n   223→  color: var(--muted);\n   224→}\n   225→\n   226→/* ── Nav ── */\n   227→.ta-nav {\n   228→  position: fixed;\n   229→  top: 0;\n   230→  left: 0;\n   231→  right: 0;\n   232→  z-index: 100;\n   233→  display: flex;\n   234→  justify-content: space-between;\n   235→  align-items: center;\n   236→  padding: 28px 60px;\n   237→  background: var(--nav-bg);\n   238→  backdrop-filter: blur(12px);\n   239→  border-bottom: 1px solid var(--border);\n   240→  transition: background 0.35s ease, border-color 0.35s ease;\n   241→}\n   242→.ta-nav-logo {\n   243→  font-family: var(--mono);\n   244→  font-size: 13px;\n   245→  letter-spacing: 0.15em;\n   246→  color: var(--gold);\n   247→  text-decoration: none;\n   248→}\n   249→.ta-nav-links {\n   250→  display: flex;\n   251→  gap: 40px;\n   252→  list-style: none;\n   253→}\n   254→.ta-nav-link {\n   255→  font-family: var(--mono);\n   256→  font-size: 11px;\n   257→  letter-spacing: 0.2em;\n   258→  text-transform: uppercase;\n   259→  color: var(--muted);\n   260→  text-decoration: none;\n   261→  transition: color 0.2s;\n   262→}\n   263→.ta-nav-link:hover { color: var(--white); }\n   264→\n   265→/* ── Animations ── */\n   266→@keyframes fadeIn {\n   267→  from { opacity: 0; transform: translateY(12px); }\n   268→  to { opacity: 1; transform: translateY(0); }\n   269→}\n   270→@keyframes spin {\n   271→  to { transform: rotate(360deg); }\n   272→}\n   273→.fade-in { animation: fadeIn 0.6s ease forwards; }\n   274→.fade-in-delay { animation: fadeIn 0.6s ease 0.15s forwards; opacity: 0; }\n   275→.fade-in-delay2 { animation: fadeIn 0.6s ease 0.3s forwards; opacity: 0; }\n   276→.spinner {\n   277→  width: 36px;\n   278→  height: 36px;\n   279→  border: 2px solid var(--border);\n   280→  border-top-color: var(--gold);\n   281→  border-radius: 50%;\n   282→  animation: spin 1s linear infinite;\n   283→}\n   284→\n   285→/* ── Footer ── */\n   286→.ta-footer {\n   287→  border-top: 1px solid var(--border);\n   288→  padding: 40px 60px;\n   289→  display: flex;\n   290→  justify-content: space-between;\n   291→  align-items: center;\n   292→}\n   293→\n   294→/* ── Sidebar (dashboard) ── */\n   295→.sidebar {\n   296→  width: 260px;\n   297→  background: var(--off-black);\n   298→  border-right: 1px solid var(--border);\n   299→  display: flex;\n   300→  flex-direction: column;\n   301→  flex-shrink: 0;\n   302→}\n   303→.sidebar-brand {\n   304→  padding: 28px 32px;\n   305→  border-bottom: 1px solid var(--border);\n   306→}\n   307→.sidebar-nav { flex: 1; padding: 24px 16px; }\n   308→.sidebar-link {\n   309→  display: flex;\n   310→  align-items: center;\n   311→  gap: 14px;\n   312→  padding: 12px 16px;\n   313→  font-family: var(--sans);\n   314→  font-size: 14px;\n   315→  font-weight: 300;\n   316→  color: var(--muted);\n   317→  text-decoration: none;\n   318→  border-left: 2px solid transparent;\n   319→  transition: color 0.2s, border-color 0.2s, background 0.2s;\n   320→  margin-bottom: 2px;\n   321→}\n   322→.sidebar-link:hover { color: var(--white); }\n   323→.sidebar-link.active {\n   324→  color: var(--gold);\n   325→  font-weight: 400;\n   326→  border-left-color: var(--gold);\n   327→  background: rgba(201,168,76,0.04);\n   328→}\n   329→.sidebar-link svg { width: 18px; height: 18px; stroke-width: 1.5; }\n   330→.sidebar-footer {\n   331→  padding: 16px;\n   332→  border-top: 1px solid var(--border);\n   333→}\n   334→\n   335→/* ── Topbar (dashboard) ── */\n   336→.topbar {\n   337→  height: 72px;\n   338→  border-bottom: 1px solid var(--border);\n   339→  background: rgba(15,15,15,0.6);\n   340→  backdrop-filter: blur(12px);\n   341→  display: flex;\n   342→  align-items: center;\n   343→  justify-content: space-between;\n   344→  padding: 0 32px;\n   345→  flex-shrink: 0;\n   346→}\n   347→.topbar-title {\n   348→  font-family: var(--serif);\n   349→  font-size: 20px;\n   350→  font-weight: 400;\n   351→}\n   352→.topbar-avatar {\n   353→  width: 34px;\n   354→  height: 34px;\n   355→  border: 1px solid var(--gold);\n   356→  border-radius: 50%;\n   357→  display: flex;\n   358→  align-items: center;\n   359→  justify-content: center;\n   360→  font-family: var(--mono);\n   361→  font-size: 10px;\n   362→  font-weight: 500;\n   363→  color: var(--gold);\n   364→  cursor: pointer;\n   365→  background: transparent;\n   366→  transition: background 0.2s;\n   367→}\n   368→.topbar-avatar:hover { background: rgba(201,168,76,0.06); }\n   369→\n   370→/* ── Dropdown ── */\n   371→.dropdown {\n   372→  position: absolute;\n   373→  right: 0;\n   374→  top: 44px;\n   375→  width: 220px;\n   376→  background: var(--surface);\n   377→  border: 1px solid var(--border);\n   378→  z-index: 50;\n   379→}\n   380→.dropdown-item {\n   381→  display: flex;\n   382→  align-items: center;\n   383→  gap: 10px;\n   384→  padding: 12px 16px;\n   385→  font-size: 13px;\n   386→  color: var(--muted);\n   387→  cursor: pointer;\n   388→  background: transparent;\n   389→  border: none;\n   390→  width: 100%;\n   391→  font-family: var(--sans);\n   392→  font-weight: 300;\n   393→  transition: color 0.2s;\n   394→}\n   395→.dropdown-item:hover { color: var(--white); }\n   396→\n   397→/* ── Status badge ── */\n   398→.status-badge {\n   399→  display: inline-flex;\n   400→  align-items: center;\n   401→  gap: 6px;\n   402→  font-family: var(--mono);\n   403→  font-size: 9px;\n   404→  letter-spacing: 0.1em;\n   405→  text-transform: uppercase;\n   406→  padding: 4px 10px;\n   407→  border: 1px solid;\n   408→}\n   409→.status-badge .dot {\n   410→  width: 5px;\n   411→  height: 5px;\n   412→  border-radius: 50%;\n   413→  background: currentColor;\n   414→}\n   415→\n   416→/* ── Table ── */\n   417→.ta-table { width: 100%; border-collapse: collapse; }\n   418→.ta-table th {\n   419→  font-family: var(--mono);\n   420→  font-size: 10px;\n   421→  letter-spacing: 0.2em;\n   422→  text-transform: uppercase;\n   423→  color: var(--muted);\n   424→  text-align: left;\n   425→  padding: 14px 20px;\n   426→  border-bottom: 1px solid var(--border);\n   427→  font-weight: 400;\n   428→}\n   429→.ta-table td {\n   430→  padding: 14px 20px;\n   431→  border-bottom: 1px solid var(--border);\n   432→  font-size: 14px;\n   433→  font-weight: 300;\n   434→}\n   435→.ta-table tr:last-child td { border-bottom: none; }\n   436→.ta-table tr:hover td { background: rgba(201,168,76,0.02); }\n   437→\n   438→/* ── Responsive ── */\n   439→@media (max-width: 768px) {\n   440→  .ta-nav { padding: 20px 24px; }\n   441→  .sidebar { display: none; }\n   442→}\n   443→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"9c7014da-04bf-4ee8-882d-fcd04d72e21b","uuid":"0816d21d-f81f-4cbe-9808-658f856089dd","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/frontend/src/index.css","content":"@import \"tailwindcss\";\n\n/* ═══════════════════════════════════════════════\n   TALENT AGENT — DESIGN SYSTEM\n   Derived from seanyoung.biz consulting site\n   ═══════════════════════════════════════════════ */\n\n:root {\n  --black: #080808;\n  --off-black: #0f0f0f;\n  --surface: #161616;\n  --border: rgba(255,255,255,0.07);\n  --gold: #C9A84C;\n  --gold-light: #E8C97A;\n  --white: #F4F1EB;\n  --muted: rgba(244,241,235,0.45);\n  --mono: 'DM Mono', monospace;\n  --serif: 'Playfair Display', Georgia, serif;\n  --sans: 'DM Sans', sans-serif;\n  --nav-bg: rgba(8,8,8,0.95);\n  --transition-theme: background 0.35s ease, color 0.35s ease, border-color 0.35s ease;\n  /* status */\n  --emerald: #34D399;\n  --rose: #FB7185;\n  --amber: #FBBF24;\n}\n\nhtml { scroll-behavior: smooth; }\n\nbody {\n  background: var(--black);\n  color: var(--white);\n  font-family: var(--sans);\n  font-weight: 300;\n  line-height: 1.7;\n  margin: 0;\n  overflow-x: hidden;\n  transition: var(--transition-theme);\n  -webkit-font-smoothing: antialiased;\n}\n\n::selection { background: rgba(201,168,76,0.3); color: var(--white); }\n::-webkit-scrollbar { width: 6px; }\n::-webkit-scrollbar-track { background: transparent; }\n::-webkit-scrollbar-thumb { background: rgba(201,168,76,0.15); }\n::-webkit-scrollbar-thumb:hover { background: rgba(201,168,76,0.3); }\n\n/* ── Typography ── */\n.t-serif {\n  font-family: var(--serif);\n  font-weight: 400;\n  line-height: 1.15;\n}\n.t-serif-bold {\n  font-family: var(--serif);\n  font-weight: 700;\n  line-height: 1.1;\n}\n.t-label {\n  font-family: var(--mono);\n  font-size: 10px;\n  letter-spacing: 0.25em;\n  text-transform: uppercase;\n  color: var(--muted);\n}\n.t-label-gold {\n  font-family: var(--mono);\n  font-size: 10px;\n  letter-spacing: 0.25em;\n  text-transform: uppercase;\n  color: var(--gold);\n}\n.t-body {\n  font-size: 14px;\n  color: var(--muted);\n  line-height: 1.8;\n  font-weight: 300;\n}\n\n/* ── Section label (with gold dash) ── */\n.section-label {\n  font-family: var(--mono);\n  font-size: 10px;\n  letter-spacing: 0.35em;\n  text-transform: uppercase;\n  color: var(--gold);\n  margin-bottom: 48px;\n  display: flex;\n  align-items: center;\n  gap: 16px;\n}\n.section-label::after {\n  content: '';\n  width: 40px;\n  height: 1px;\n  background: var(--gold);\n  opacity: 0.4;\n}\n\n/* ── Buttons (exact match) ── */\n.btn-primary {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  padding: 16px 36px;\n  background: var(--gold);\n  color: #080808;\n  font-family: var(--mono);\n  font-size: 12px;\n  letter-spacing: 0.15em;\n  text-transform: uppercase;\n  text-decoration: none;\n  border: none;\n  cursor: pointer;\n  transition: background 0.2s;\n}\n.btn-primary:hover { background: var(--gold-light); }\n.btn-primary:disabled { opacity: 0.35; cursor: not-allowed; }\n\n.btn-ghost {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  padding: 16px 36px;\n  border: 1px solid var(--border);\n  color: var(--muted);\n  font-family: var(--mono);\n  font-size: 12px;\n  letter-spacing: 0.15em;\n  text-transform: uppercase;\n  text-decoration: none;\n  background: transparent;\n  cursor: pointer;\n  transition: border-color 0.2s, color 0.2s;\n}\n.btn-ghost:hover { border-color: rgba(255,255,255,0.3); color: var(--white); }\n\n/* ── Inputs (exact form-group match) ── */\n.input {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  color: var(--white);\n  font-family: var(--sans);\n  font-size: 14px;\n  font-weight: 300;\n  padding: 14px 18px;\n  outline: none;\n  transition: border-color 0.2s;\n  width: 100%;\n  appearance: none;\n}\n.input:focus { border-color: var(--gold); }\n.input::placeholder { color: var(--muted); opacity: 0.6; }\n.input:disabled { opacity: 0.45; }\n\n.input-label {\n  font-family: var(--mono);\n  font-size: 10px;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n  color: var(--muted);\n  display: block;\n  margin-bottom: 8px;\n}\n\n/* ── Cards (1px grid gap pattern) ── */\n.grid-border {\n  display: grid;\n  gap: 1px;\n  background: var(--border);\n  border: 1px solid var(--border);\n}\n.grid-border > * {\n  background: var(--off-black);\n}\n\n/* ── Card hover (gold top-border animation) ── */\n.card-hover {\n  position: relative;\n  overflow: hidden;\n}\n.card-hover::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  height: 2px;\n  background: var(--gold);\n  transform: scaleX(0);\n  transform-origin: left;\n  transition: transform 0.4s;\n}\n.card-hover:hover::before { transform: scaleX(1); }\n\n/* ── Stat row ── */\n.stat-num {\n  font-family: var(--serif);\n  font-size: 36px;\n  font-weight: 700;\n  color: var(--gold);\n  line-height: 1;\n}\n.stat-label {\n  font-family: var(--mono);\n  font-size: 10px;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n  color: var(--muted);\n  margin-top: 8px;\n}\n\n/* ── Tags ── */\n.tag {\n  font-family: var(--mono);\n  font-size: 9px;\n  letter-spacing: 0.15em;\n  text-transform: uppercase;\n  padding: 5px 10px;\n  border: 1px solid var(--border);\n  color: var(--muted);\n}\n\n/* ── Nav ── */\n.ta-nav {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  z-index: 100;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 28px 60px;\n  background: var(--nav-bg);\n  backdrop-filter: blur(12px);\n  border-bottom: 1px solid var(--border);\n  transition: background 0.35s ease, border-color 0.35s ease;\n}\n.ta-nav-logo {\n  font-family: var(--mono);\n  font-size: 13px;\n  letter-spacing: 0.15em;\n  color: var(--gold);\n  text-decoration: none;\n}\n.ta-nav-links {\n  display: flex;\n  gap: 40px;\n  list-style: none;\n}\n.ta-nav-link {\n  font-family: var(--mono);\n  font-size: 11px;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n  color: var(--muted);\n  text-decoration: none;\n  transition: color 0.2s;\n}\n.ta-nav-link:hover { color: var(--white); }\n\n/* ── Animations ── */\n@keyframes fadeIn {\n  from { opacity: 0; transform: translateY(12px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n@keyframes spin {\n  to { transform: rotate(360deg); }\n}\n.fade-in { animation: fadeIn 0.6s ease forwards; }\n.fade-in-delay { animation: fadeIn 0.6s ease 0.15s forwards; opacity: 0; }\n.fade-in-delay2 { animation: fadeIn 0.6s ease 0.3s forwards; opacity: 0; }\n.spinner {\n  width: 36px;\n  height: 36px;\n  border: 2px solid var(--border);\n  border-top-color: var(--gold);\n  border-radius: 50%;\n  animation: spin 1s linear infinite;\n}\n\n/* ── Footer ── */\n.ta-footer {\n  border-top: 1px solid var(--border);\n  padding: 40px 60px;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n/* ── Sidebar (dashboard) ── */\n.sidebar {\n  width: 260px;\n  background: var(--off-black);\n  border-right: 1px solid var(--border);\n  display: flex;\n  flex-direction: column;\n  flex-shrink: 0;\n}\n.sidebar-brand {\n  padding: 28px 32px;\n  border-bottom: 1px solid var(--border);\n}\n.sidebar-nav { flex: 1; padding: 24px 16px; }\n.sidebar-link {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  padding: 12px 16px;\n  font-family: var(--sans);\n  font-size: 14px;\n  font-weight: 300;\n  color: var(--muted);\n  text-decoration: none;\n  border-left: 2px solid transparent;\n  transition: color 0.2s, border-color 0.2s, background 0.2s;\n  margin-bottom: 2px;\n}\n.sidebar-link:hover { color: var(--white); }\n.sidebar-link.active {\n  color: var(--gold);\n  font-weight: 400;\n  border-left-color: var(--gold);\n  background: rgba(201,168,76,0.04);\n}\n.sidebar-link svg { width: 18px; height: 18px; stroke-width: 1.5; }\n.sidebar-footer {\n  padding: 16px;\n  border-top: 1px solid var(--border);\n}\n\n/* ── Topbar (dashboard) ── */\n.topbar {\n  height: 72px;\n  border-bottom: 1px solid var(--border);\n  background: rgba(15,15,15,0.6);\n  backdrop-filter: blur(12px);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 32px;\n  flex-shrink: 0;\n}\n.topbar-title {\n  font-family: var(--serif);\n  font-size: 20px;\n  font-weight: 400;\n}\n.topbar-avatar {\n  width: 34px;\n  height: 34px;\n  border: 1px solid var(--gold);\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-family: var(--mono);\n  font-size: 10px;\n  font-weight: 500;\n  color: var(--gold);\n  cursor: pointer;\n  background: transparent;\n  transition: background 0.2s;\n}\n.topbar-avatar:hover { background: rgba(201,168,76,0.06); }\n\n/* ── Dropdown ── */\n.dropdown {\n  position: absolute;\n  right: 0;\n  top: 44px;\n  width: 220px;\n  background: var(--surface);\n  border: 1px solid var(--border);\n  z-index: 50;\n}\n.dropdown-item {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 12px 16px;\n  font-size: 13px;\n  color: var(--muted);\n  cursor: pointer;\n  background: transparent;\n  border: none;\n  width: 100%;\n  font-family: var(--sans);\n  font-weight: 300;\n  transition: color 0.2s;\n}\n.dropdown-item:hover { color: var(--white); }\n\n/* ── Status badge ── */\n.status-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  font-family: var(--mono);\n  font-size: 9px;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  padding: 4px 10px;\n  border: 1px solid;\n}\n.status-badge .dot {\n  width: 5px;\n  height: 5px;\n  border-radius: 50%;\n  background: currentColor;\n}\n\n/* ── Table ── */\n.ta-table { width: 100%; border-collapse: collapse; }\n.ta-table th {\n  font-family: var(--mono);\n  font-size: 10px;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n  color: var(--muted);\n  text-align: left;\n  padding: 14px 20px;\n  border-bottom: 1px solid var(--border);\n  font-weight: 400;\n}\n.ta-table td {\n  padding: 14px 20px;\n  border-bottom: 1px solid var(--border);\n  font-size: 14px;\n  font-weight: 300;\n}\n.ta-table tr:last-child td { border-bottom: none; }\n.ta-table tr:hover td { background: rgba(201,168,76,0.02); }\n\n/* ── Responsive ── */\n@media (max-width: 768px) {\n  .ta-nav { padding: 20px 24px; }\n  .sidebar { display: none; }\n}\n","numLines":443,"startLine":1,"totalLines":443}}}}
