{"t":"2026-05-20T19:55:17.137Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GqK6MgRwb8Q1Z9Y5iLeyFS","type":"tool_result","content":"     1→import { useState, useRef } from 'react'\n     2→import { useNavigate } from 'react-router-dom'\n     3→import { uploadResume, saveProfile } from '../lib/api'\n     4→import { useAuth } from '../context/AuthContext'\n     5→\n     6→/* ── Step dots ── */\n     7→function Steps({ current }) {\n     8→  return (\n     9→    <div style={{ display: 'flex', alignItems: 'center', gap: 12 }}>\n    10→      {[0, 1, 2].map((i) => (\n    11→        <div key={i} style={{ display: 'flex', alignItems: 'center', gap: 12 }}>\n    12→          <div style={{\n    13→            width: 30, height: 30, borderRadius: '50%',\n    14→            border: `1px solid ${i <= current ? 'var(--gold)' : 'var(--border)'}`,\n    15→            background: i < current ? 'var(--gold)' : 'transparent',\n    16→            display: 'flex', alignItems: 'center', justifyContent: 'center',\n    17→            fontFamily: 'var(--mono)', fontSize: 10,\n    18→            color: i < current ? '#080808' : i === current ? 'var(--gold)' : 'var(--muted)',\n    19→            transition: 'all 0.3s ease',\n    20→          }}>\n    21→            {i < current ? '✓' : i + 1}\n    22→          </div>\n    23→          {i < 2 && <div style={{ width: 24, height: 1, background: i < current ? 'var(--gold)' : 'var(--border)', transition: 'background 0.3s ease' }} />}\n    24→        </div>\n    25→      ))}\n    26→    </div>\n    27→  )\n    28→}\n    29→\n    30→/* ── Step 1: Resume ── */\n    31→function ResumeStep({ onNext, resumeData, setResumeData }) {\n    32→  const fileRef = useRef(null)\n    33→  const [dragging, setDragging] = useState(false)\n    34→  const [uploading, setUploading] = useState(false)\n    35→  const [error, setError] = useState('')\n    36→\n    37→  const handleFile = async (file) => {\n    38→    if (!file) return\n    39→    if (!file.type.includes('pdf')) { setError('PDF only'); return }\n    40→    if (file.size > 10 * 1024 * 1024) { setError('Max 10MB'); return }\n    41→    setUploading(true); setError('')\n    42→    try {\n    43→      const res = await uploadResume(file)\n    44→      setResumeData({ candidateId: res.candidate_id, textLength: res.text_length, preview: res.preview, fileName: file.name })\n    45→    } catch (err) { setError(err.message || 'Upload failed') }\n    46→    finally { setUploading(false) }\n    47→  }\n    48→\n    49→  return (\n    50→    <div className=\"fade-in\">\n    51→      <h2 className=\"t-serif\" style={{ fontSize: 28, marginBottom: 8 }}>Upload your resume</h2>\n    52→      <p className=\"t-body\" style={{ marginBottom: 32 }}>We'll extract your skills, experience, and context to power your AI talent agent.</p>\n    53→\n    54→      {!resumeData ? (\n    55→        <div\n    56→          onDragOver={(e) => { e.preventDefault(); setDragging(true) }}\n    57→          onDragLeave={() => setDragging(false)}\n    58→          onDrop={(e) => { e.preventDefault(); setDragging(false); handleFile(e.dataTransfer.files[0]) }}\n    59→          onClick={() => fileRef.current?.click()}\n    60→          style={{\n    61→            border: `1px dashed ${dragging ? 'var(--gold)' : 'rgba(255,255,255,0.14)'}`,\n    62→            padding: '64px 24px', textAlign: 'center', cursor: 'pointer',\n    63→            background: dragging ? 'rgba(201,168,76,0.03)' : 'transparent',\n    64→            transition: 'all 0.2s',\n    65→          }}\n    66→        >\n    67→          <input ref={fileRef} type=\"file\" accept=\".pdf\" style={{ display: 'none' }} onChange={(e) => handleFile(e.target.files[0])} />\n    68→          {uploading ? (\n    69→            <><div className=\"spinner\" style={{ margin: '0 auto 16px' }} /><p className=\"t-label\">Parsing...</p></>\n    70→          ) : (\n    71→            <>\n    72→              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--muted)\" strokeWidth=\"1\" style={{ width: 40, height: 40, margin: '0 auto 16px', opacity: 0.4 }}>\n    73→                <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\" /><polyline points=\"17 8 12 3 7 8\" /><line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\" />\n    74→              </svg>\n    75→              <p style={{ color: 'var(--white)', fontWeight: 400, marginBottom: 4 }}>Drop your resume here</p>\n    76→              <p className=\"t-label\">PDF only · Max 10MB</p>\n    77→            </>\n    78→          )}\n    79→        </div>\n    80→      ) : (\n    81→        <div className=\"fade-in\" style={{ background: 'var(--off-black)', border: '1px solid rgba(201,168,76,0.2)', padding: '24px 28px' }}>\n    82→          <div style={{ display: 'flex', alignItems: 'center', gap: 14, marginBottom: 16 }}>\n    83→            <div style={{ width: 36, height: 36, borderRadius: '50%', border: '1px solid var(--gold)', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>\n    84→              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--gold)\" strokeWidth=\"2\" style={{ width: 16, height: 16 }}><path d=\"M20 6 9 17l-5-5\" /></svg>\n    85→            </div>\n    86→            <div>\n    87→              <p style={{ color: 'var(--white)', fontWeight: 400, fontSize: 14 }}>{resumeData.fileName}</p>\n    88→              <p className=\"t-label\" style={{ marginTop: 2 }}>{resumeData.textLength.toLocaleString()} characters</p>\n    89→            </div>\n    90→          </div>\n    91→          <div style={{ background: 'var(--surface)', padding: 16, maxHeight: 120, overflow: 'auto' }}>\n    92→            <p style={{ fontFamily: 'var(--mono)', fontSize: 11, color: 'var(--muted)', whiteSpace: 'pre-wrap', lineHeight: 1.6 }}>{resumeData.preview}...</p>\n    93→          </div>\n    94→          <button onClick={() => setResumeData(null)} className=\"t-label\" style={{ marginTop: 12, background: 'none', border: 'none', cursor: 'pointer' }}>\n    95→            Upload different file\n    96→          </button>\n    97→        </div>\n    98→      )}\n    99→\n   100→      {error && <p style={{ color: 'var(--rose)', fontSize: 13, marginTop: 16 }}>{error}</p>}\n   101→\n   102→      <button onClick={onNext} disabled={!resumeData} className=\"btn-primary\" style={{ width: '100%', marginTop: 28 }}>\n   103→        Continue →\n   104→      </button>\n   105→    </div>\n   106→  )\n   107→}\n   108→\n   109→/* ── Step 2: Profile ── */\n   110→function ProfileStep({ onSubmit, loading }) {\n   111→  const [form, setForm] = useState({\n   112→    name: '', linkedin_url: '', github_url: '', personal_context: '',\n   113→    target_locations: '', remote_preference: 'flexible', min_compensation: '',\n   114→    excluded_companies: '', excluded_industries: '',\n   115→  })\n   116→  const u = (k, v) => setForm((f) => ({ ...f, [k]: v }))\n   117→\n   118→  const handleSubmit = (e) => {\n   119→    e.preventDefault()\n   120→    onSubmit({\n   121→      name: form.name,\n   122→      linkedin_url: form.linkedin_url || null,\n   123→      github_url: form.github_url || null,\n   124→      personal_context: form.personal_context || null,\n   125→      target_locations: form.target_locations ? form.target_locations.split(',').map(s => s.trim()).filter(Boolean) : null,\n   126→      remote_preference: form.remote_preference,\n   127→      min_compensation: form.min_compensation ? parseInt(form.min_compensation, 10) : null,\n   128→      excluded_companies: form.excluded_companies ? form.excluded_companies.split(',').map(s => s.trim()).filter(Boolean) : null,\n   129→      excluded_industries: form.excluded_industries ? form.excluded_industries.split(',').map(s => s.trim()).filter(Boolean) : null,\n   130→    })\n   131→  }\n   132→\n   133→  return (\n   134→    <form onSubmit={handleSubmit} className=\"fade-in\">\n   135→      <h2 className=\"t-serif\" style={{ fontSize: 28, marginBottom: 8 }}>Complete your profile</h2>\n   136→      <p className=\"t-body\" style={{ marginBottom: 32 }}>Tell us about yourself so your AI agent knows what to look for.</p>\n   137→\n   138→      <div style={{ display: 'flex', flexDirection: 'column', gap: 20 }}>\n   139→        <div><label className=\"input-label\">Full Name *</label><input type=\"text\" required placeholder=\"Sean Young\" value={form.name} onChange={(e) => u('name', e.target.value)} className=\"input\" /></div>\n   140→\n   141→        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 16 }}>\n   142→          <div><label className=\"input-label\">LinkedIn</label><input type=\"url\" placeholder=\"https://linkedin.com/in/...\" value={form.linkedin_url} onChange={(e) => u('linkedin_url', e.target.value)} className=\"input\" /></div>\n   143→          <div><label className=\"input-label\">GitHub</label><input type=\"url\" placeholder=\"https://github.com/...\" value={form.github_url} onChange={(e) => u('github_url', e.target.value)} className=\"input\" /></div>\n   144→        </div>\n   145→\n   146→        <div><label className=\"input-label\">Personal Context</label><textarea placeholder=\"What should your agent know beyond the resume?\" value={form.personal_context} onChange={(e) => u('personal_context', e.target.value)} className=\"input\" style={{ resize: 'vertical', minHeight: 100 }} /></div>\n   147→      </div>\n   148→\n   149→      {/* Preferences */}\n   150→      <div style={{ borderTop: '1px solid var(--border)', marginTop: 32, paddingTop: 28 }}>\n   151→        <div className=\"t-label-gold\" style={{ marginBottom: 20 }}>Preferences</div>\n   152→        <div style={{ display: 'flex', flexDirection: 'column', gap: 20 }}>\n   153→          <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 16 }}>\n   154→            <div><label className=\"input-label\">Locations</label><input type=\"text\" placeholder=\"Miami, NYC, Remote\" value={form.target_locations} onChange={(e) => u('target_locations', e.target.value)} className=\"input\" /></div>\n   155→            <div><label className=\"input-label\">Remote Preference</label><select value={form.remote_preference} onChange={(e) => u('remote_preference', e.target.value)} className=\"input\"><option value=\"remote_only\">Remote Only</option><option value=\"flexible\">Flexible / Hybrid</option><option value=\"on_site\">On-Site</option></select></div>\n   156→          </div>\n   157→          <div><label className=\"input-label\">Min Compensation (USD/yr)</label><input type=\"number\" placeholder=\"150000\" value={form.min_compensation} onChange={(e) => u('min_compensation', e.target.value)} className=\"input\" /></div>\n   158→          <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 16 }}>\n   159→            <div><label className=\"input-label\">Excluded Companies</label><input type=\"text\" placeholder=\"Company A, Company B\" value={form.excluded_companies} onChange={(e) => u('excluded_companies', e.target.value)} className=\"input\" /></div>\n   160→            <div><label className=\"input-label\">Excluded Industries</label><input type=\"text\" placeholder=\"Gambling, Defense\" value={form.excluded_industries} onChange={(e) => u('excluded_industries', e.target.value)} className=\"input\" /></div>\n   161→          </div>\n   162→        </div>\n   163→      </div>\n   164→\n   165→      <button type=\"submit\" disabled={loading || !form.name} className=\"btn-primary\" style={{ width: '100%', marginTop: 28 }}>\n   166→        {loading ? 'Saving...' : 'Launch my agent →'}\n   167→      </button>\n   168→    </form>\n   169→  )\n   170→}\n   171→\n   172→/* ── Step 3: Success ── */\n   173→function SuccessStep() {\n   174→  const navigate = useNavigate()\n   175→  return (\n   176→    <div className=\"fade-in\" style={{ textAlign: 'center', padding: '32px 0' }}>\n   177→      <div style={{ width: 64, height: 64, borderRadius: '50%', border: '1px solid var(--gold)', display: 'flex', alignItems: 'center', justifyContent: 'center', margin: '0 auto 28px' }}>\n   178→        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--gold)\" strokeWidth=\"1.5\" style={{ width: 28, height: 28 }}><path d=\"M20 6 9 17l-5-5\" /></svg>\n   179→      </div>\n   180→      <h2 className=\"t-serif\" style={{ fontSize: 28, marginBottom: 12 }}>You're all set, Space Cowboy.</h2>\n   181→      <p className=\"t-body\" style={{ marginBottom: 36 }}>Your AI talent agent is ready. Head to the dashboard to launch your first discovery run.</p>\n   182→      <button onClick={() => navigate('/dashboard')} className=\"btn-primary\">Go to dashboard →</button>\n   183→    </div>\n   184→  )\n   185→}\n   186→\n   187→/* ── Main ── */\n   188→export default function Onboarding() {\n   189→  const { refreshUser } = useAuth()\n   190→  const [step, setStep] = useState(0)\n   191→  const [resumeData, setResumeData] = useState(null)\n   192→  const [saving, setSaving] = useState(false)\n   193→  const [error, setError] = useState('')\n   194→\n   195→  const handleProfileSubmit = async (profile) => {\n   196→    setSaving(true); setError('')\n   197→    try { await saveProfile(profile); await refreshUser(); setStep(2) }\n   198→    catch (err) { setError(err.message || 'Failed to save') }\n   199→    finally { setSaving(false) }\n   200→  }\n   201→\n   202→  return (\n   203→    <div style={{ minHeight: '100vh', display: 'flex', alignItems: 'center', justifyContent: 'center', padding: '24px', background: 'var(--black)', position: 'relative' }}>\n   204→      <div style={{ position: 'absolute', width: 500, height: 500, borderRadius: '50%', background: 'radial-gradient(circle, rgba(201,168,76,0.06) 0%, transparent 70%)', top: '-10%', left: '30%', pointerEvents: 'none' }} />\n   205→\n   206→      <div style={{ width: '100%', maxWidth: 520, position: 'relative', zIndex: 1 }}>\n   207→        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 36 }}>\n   208→          <span className=\"t-label-gold\">Setup</span>\n   209→          <Steps current={step} />\n   210→        </div>\n   211→\n   212→        <div style={{ background: 'var(--surface)', border: '1px solid var(--border)', padding: '40px 36px' }}>\n   213→          {error && <div style={{ background: 'rgba(251,113,133,0.04)', border: '1px solid rgba(251,113,133,0.2)', padding: '12px 16px', marginBottom: 20 }}><p style={{ color: 'var(--rose)', fontSize: 13 }}>{error}</p></div>}\n   214→          {step === 0 && <ResumeStep onNext={() => setStep(1)} resumeData={resumeData} setResumeData={setResumeData} />}\n   215→          {step === 1 && <ProfileStep onSubmit={handleProfileSubmit} loading={saving} />}\n   216→          {step === 2 && <SuccessStep />}\n   217→        </div>\n   218→      </div>\n   219→    </div>\n   220→  )\n   221→}\n   222→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"9c7014da-04bf-4ee8-882d-fcd04d72e21b","uuid":"e622ac61-2184-4ac9-b2b4-ca040f920c53","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/frontend/src/pages/Onboarding.jsx","content":"import { useState, useRef } from 'react'\nimport { useNavigate } from 'react-router-dom'\nimport { uploadResume, saveProfile } from '../lib/api'\nimport { useAuth } from '../context/AuthContext'\n\n/* ── Step dots ── */\nfunction Steps({ current }) {\n  return (\n    <div style={{ display: 'flex', alignItems: 'center', gap: 12 }}>\n      {[0, 1, 2].map((i) => (\n        <div key={i} style={{ display: 'flex', alignItems: 'center', gap: 12 }}>\n          <div style={{\n            width: 30, height: 30, borderRadius: '50%',\n            border: `1px solid ${i <= current ? 'var(--gold)' : 'var(--border)'}`,\n            background: i < current ? 'var(--gold)' : 'transparent',\n            display: 'flex', alignItems: 'center', justifyContent: 'center',\n            fontFamily: 'var(--mono)', fontSize: 10,\n            color: i < current ? '#080808' : i === current ? 'var(--gold)' : 'var(--muted)',\n            transition: 'all 0.3s ease',\n          }}>\n            {i < current ? '✓' : i + 1}\n          </div>\n          {i < 2 && <div style={{ width: 24, height: 1, background: i < current ? 'var(--gold)' : 'var(--border)', transition: 'background 0.3s ease' }} />}\n        </div>\n      ))}\n    </div>\n  )\n}\n\n/* ── Step 1: Resume ── */\nfunction ResumeStep({ onNext, resumeData, setResumeData }) {\n  const fileRef = useRef(null)\n  const [dragging, setDragging] = useState(false)\n  const [uploading, setUploading] = useState(false)\n  const [error, setError] = useState('')\n\n  const handleFile = async (file) => {\n    if (!file) return\n    if (!file.type.includes('pdf')) { setError('PDF only'); return }\n    if (file.size > 10 * 1024 * 1024) { setError('Max 10MB'); return }\n    setUploading(true); setError('')\n    try {\n      const res = await uploadResume(file)\n      setResumeData({ candidateId: res.candidate_id, textLength: res.text_length, preview: res.preview, fileName: file.name })\n    } catch (err) { setError(err.message || 'Upload failed') }\n    finally { setUploading(false) }\n  }\n\n  return (\n    <div className=\"fade-in\">\n      <h2 className=\"t-serif\" style={{ fontSize: 28, marginBottom: 8 }}>Upload your resume</h2>\n      <p className=\"t-body\" style={{ marginBottom: 32 }}>We'll extract your skills, experience, and context to power your AI talent agent.</p>\n\n      {!resumeData ? (\n        <div\n          onDragOver={(e) => { e.preventDefault(); setDragging(true) }}\n          onDragLeave={() => setDragging(false)}\n          onDrop={(e) => { e.preventDefault(); setDragging(false); handleFile(e.dataTransfer.files[0]) }}\n          onClick={() => fileRef.current?.click()}\n          style={{\n            border: `1px dashed ${dragging ? 'var(--gold)' : 'rgba(255,255,255,0.14)'}`,\n            padding: '64px 24px', textAlign: 'center', cursor: 'pointer',\n            background: dragging ? 'rgba(201,168,76,0.03)' : 'transparent',\n            transition: 'all 0.2s',\n          }}\n        >\n          <input ref={fileRef} type=\"file\" accept=\".pdf\" style={{ display: 'none' }} onChange={(e) => handleFile(e.target.files[0])} />\n          {uploading ? (\n            <><div className=\"spinner\" style={{ margin: '0 auto 16px' }} /><p className=\"t-label\">Parsing...</p></>\n          ) : (\n            <>\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--muted)\" strokeWidth=\"1\" style={{ width: 40, height: 40, margin: '0 auto 16px', opacity: 0.4 }}>\n                <path d=\"M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4\" /><polyline points=\"17 8 12 3 7 8\" /><line x1=\"12\" y1=\"3\" x2=\"12\" y2=\"15\" />\n              </svg>\n              <p style={{ color: 'var(--white)', fontWeight: 400, marginBottom: 4 }}>Drop your resume here</p>\n              <p className=\"t-label\">PDF only · Max 10MB</p>\n            </>\n          )}\n        </div>\n      ) : (\n        <div className=\"fade-in\" style={{ background: 'var(--off-black)', border: '1px solid rgba(201,168,76,0.2)', padding: '24px 28px' }}>\n          <div style={{ display: 'flex', alignItems: 'center', gap: 14, marginBottom: 16 }}>\n            <div style={{ width: 36, height: 36, borderRadius: '50%', border: '1px solid var(--gold)', display: 'flex', alignItems: 'center', justifyContent: 'center' }}>\n              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--gold)\" strokeWidth=\"2\" style={{ width: 16, height: 16 }}><path d=\"M20 6 9 17l-5-5\" /></svg>\n            </div>\n            <div>\n              <p style={{ color: 'var(--white)', fontWeight: 400, fontSize: 14 }}>{resumeData.fileName}</p>\n              <p className=\"t-label\" style={{ marginTop: 2 }}>{resumeData.textLength.toLocaleString()} characters</p>\n            </div>\n          </div>\n          <div style={{ background: 'var(--surface)', padding: 16, maxHeight: 120, overflow: 'auto' }}>\n            <p style={{ fontFamily: 'var(--mono)', fontSize: 11, color: 'var(--muted)', whiteSpace: 'pre-wrap', lineHeight: 1.6 }}>{resumeData.preview}...</p>\n          </div>\n          <button onClick={() => setResumeData(null)} className=\"t-label\" style={{ marginTop: 12, background: 'none', border: 'none', cursor: 'pointer' }}>\n            Upload different file\n          </button>\n        </div>\n      )}\n\n      {error && <p style={{ color: 'var(--rose)', fontSize: 13, marginTop: 16 }}>{error}</p>}\n\n      <button onClick={onNext} disabled={!resumeData} className=\"btn-primary\" style={{ width: '100%', marginTop: 28 }}>\n        Continue →\n      </button>\n    </div>\n  )\n}\n\n/* ── Step 2: Profile ── */\nfunction ProfileStep({ onSubmit, loading }) {\n  const [form, setForm] = useState({\n    name: '', linkedin_url: '', github_url: '', personal_context: '',\n    target_locations: '', remote_preference: 'flexible', min_compensation: '',\n    excluded_companies: '', excluded_industries: '',\n  })\n  const u = (k, v) => setForm((f) => ({ ...f, [k]: v }))\n\n  const handleSubmit = (e) => {\n    e.preventDefault()\n    onSubmit({\n      name: form.name,\n      linkedin_url: form.linkedin_url || null,\n      github_url: form.github_url || null,\n      personal_context: form.personal_context || null,\n      target_locations: form.target_locations ? form.target_locations.split(',').map(s => s.trim()).filter(Boolean) : null,\n      remote_preference: form.remote_preference,\n      min_compensation: form.min_compensation ? parseInt(form.min_compensation, 10) : null,\n      excluded_companies: form.excluded_companies ? form.excluded_companies.split(',').map(s => s.trim()).filter(Boolean) : null,\n      excluded_industries: form.excluded_industries ? form.excluded_industries.split(',').map(s => s.trim()).filter(Boolean) : null,\n    })\n  }\n\n  return (\n    <form onSubmit={handleSubmit} className=\"fade-in\">\n      <h2 className=\"t-serif\" style={{ fontSize: 28, marginBottom: 8 }}>Complete your profile</h2>\n      <p className=\"t-body\" style={{ marginBottom: 32 }}>Tell us about yourself so your AI agent knows what to look for.</p>\n\n      <div style={{ display: 'flex', flexDirection: 'column', gap: 20 }}>\n        <div><label className=\"input-label\">Full Name *</label><input type=\"text\" required placeholder=\"Sean Young\" value={form.name} onChange={(e) => u('name', e.target.value)} className=\"input\" /></div>\n\n        <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 16 }}>\n          <div><label className=\"input-label\">LinkedIn</label><input type=\"url\" placeholder=\"https://linkedin.com/in/...\" value={form.linkedin_url} onChange={(e) => u('linkedin_url', e.target.value)} className=\"input\" /></div>\n          <div><label className=\"input-label\">GitHub</label><input type=\"url\" placeholder=\"https://github.com/...\" value={form.github_url} onChange={(e) => u('github_url', e.target.value)} className=\"input\" /></div>\n        </div>\n\n        <div><label className=\"input-label\">Personal Context</label><textarea placeholder=\"What should your agent know beyond the resume?\" value={form.personal_context} onChange={(e) => u('personal_context', e.target.value)} className=\"input\" style={{ resize: 'vertical', minHeight: 100 }} /></div>\n      </div>\n\n      {/* Preferences */}\n      <div style={{ borderTop: '1px solid var(--border)', marginTop: 32, paddingTop: 28 }}>\n        <div className=\"t-label-gold\" style={{ marginBottom: 20 }}>Preferences</div>\n        <div style={{ display: 'flex', flexDirection: 'column', gap: 20 }}>\n          <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 16 }}>\n            <div><label className=\"input-label\">Locations</label><input type=\"text\" placeholder=\"Miami, NYC, Remote\" value={form.target_locations} onChange={(e) => u('target_locations', e.target.value)} className=\"input\" /></div>\n            <div><label className=\"input-label\">Remote Preference</label><select value={form.remote_preference} onChange={(e) => u('remote_preference', e.target.value)} className=\"input\"><option value=\"remote_only\">Remote Only</option><option value=\"flexible\">Flexible / Hybrid</option><option value=\"on_site\">On-Site</option></select></div>\n          </div>\n          <div><label className=\"input-label\">Min Compensation (USD/yr)</label><input type=\"number\" placeholder=\"150000\" value={form.min_compensation} onChange={(e) => u('min_compensation', e.target.value)} className=\"input\" /></div>\n          <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: 16 }}>\n            <div><label className=\"input-label\">Excluded Companies</label><input type=\"text\" placeholder=\"Company A, Company B\" value={form.excluded_companies} onChange={(e) => u('excluded_companies', e.target.value)} className=\"input\" /></div>\n            <div><label className=\"input-label\">Excluded Industries</label><input type=\"text\" placeholder=\"Gambling, Defense\" value={form.excluded_industries} onChange={(e) => u('excluded_industries', e.target.value)} className=\"input\" /></div>\n          </div>\n        </div>\n      </div>\n\n      <button type=\"submit\" disabled={loading || !form.name} className=\"btn-primary\" style={{ width: '100%', marginTop: 28 }}>\n        {loading ? 'Saving...' : 'Launch my agent →'}\n      </button>\n    </form>\n  )\n}\n\n/* ── Step 3: Success ── */\nfunction SuccessStep() {\n  const navigate = useNavigate()\n  return (\n    <div className=\"fade-in\" style={{ textAlign: 'center', padding: '32px 0' }}>\n      <div style={{ width: 64, height: 64, borderRadius: '50%', border: '1px solid var(--gold)', display: 'flex', alignItems: 'center', justifyContent: 'center', margin: '0 auto 28px' }}>\n        <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"var(--gold)\" strokeWidth=\"1.5\" style={{ width: 28, height: 28 }}><path d=\"M20 6 9 17l-5-5\" /></svg>\n      </div>\n      <h2 className=\"t-serif\" style={{ fontSize: 28, marginBottom: 12 }}>You're all set, Space Cowboy.</h2>\n      <p className=\"t-body\" style={{ marginBottom: 36 }}>Your AI talent agent is ready. Head to the dashboard to launch your first discovery run.</p>\n      <button onClick={() => navigate('/dashboard')} className=\"btn-primary\">Go to dashboard →</button>\n    </div>\n  )\n}\n\n/* ── Main ── */\nexport default function Onboarding() {\n  const { refreshUser } = useAuth()\n  const [step, setStep] = useState(0)\n  const [resumeData, setResumeData] = useState(null)\n  const [saving, setSaving] = useState(false)\n  const [error, setError] = useState('')\n\n  const handleProfileSubmit = async (profile) => {\n    setSaving(true); setError('')\n    try { await saveProfile(profile); await refreshUser(); setStep(2) }\n    catch (err) { setError(err.message || 'Failed to save') }\n    finally { setSaving(false) }\n  }\n\n  return (\n    <div style={{ minHeight: '100vh', display: 'flex', alignItems: 'center', justifyContent: 'center', padding: '24px', background: 'var(--black)', position: 'relative' }}>\n      <div style={{ position: 'absolute', width: 500, height: 500, borderRadius: '50%', background: 'radial-gradient(circle, rgba(201,168,76,0.06) 0%, transparent 70%)', top: '-10%', left: '30%', pointerEvents: 'none' }} />\n\n      <div style={{ width: '100%', maxWidth: 520, position: 'relative', zIndex: 1 }}>\n        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: 36 }}>\n          <span className=\"t-label-gold\">Setup</span>\n          <Steps current={step} />\n        </div>\n\n        <div style={{ background: 'var(--surface)', border: '1px solid var(--border)', padding: '40px 36px' }}>\n          {error && <div style={{ background: 'rgba(251,113,133,0.04)', border: '1px solid rgba(251,113,133,0.2)', padding: '12px 16px', marginBottom: 20 }}><p style={{ color: 'var(--rose)', fontSize: 13 }}>{error}</p></div>}\n          {step === 0 && <ResumeStep onNext={() => setStep(1)} resumeData={resumeData} setResumeData={setResumeData} />}\n          {step === 1 && <ProfileStep onSubmit={handleProfileSubmit} loading={saving} />}\n          {step === 2 && <SuccessStep />}\n        </div>\n      </div>\n    </div>\n  )\n}\n","numLines":222,"startLine":1,"totalLines":222}}}}
