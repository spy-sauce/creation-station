   padding: 14px 20px;","   border-bottom: 1px solid var(--border);","   font-size: 14px;","   font-weight: 300;"," }","+"," .ta-table tr:last-child td { border-bottom: none; }","-.ta-table tr:hover td { background: rgba(201,168,76,0.02); }","+.ta-table tr:hover td { background: var(--gold-faint); }"," ","-/* ── Responsive ── */","+/* ═══════════════════════════════════════════════════════════════════════════════","+   FOOTER","+   ═══════════════════════════════════════════════════════════════════════════════ */","+","+.ta-footer {","+  border-top: 1px solid var(--border);","+  padding: 40px 60px;","+  display: flex;","+  justify-content: space-between;","+  align-items: center;","+}","+","+/* ═══════════════════════════════════════════════════════════════════════════════","+   ANIMATIONS","+   ═══════════════════════════════════════════════════════════════════════════════ */","+","+@keyframes fadeIn {","+  from { opacity: 0; transform: translateY(12px); }","+  to { opacity: 1; transform: translateY(0); }","+}","+","+@keyframes spin {","+  to { transform: rotate(360deg); }","+}","+","+.fade-in { animation: fadeIn 0.6s var(--ease-default) forwards; }","+.fade-in-delay { animation: fadeIn 0.6s var(--ease-default) 0.15s forwards; opacity: 0; }","+.fade-in-delay2 { animation: fadeIn 0.6s var(--ease-default) 0.3s forwards; opacity: 0; }","+","+.spinner {","+  width: 36px;","+  height: 36px;","+  border: 2px solid var(--border);","+  border-top-color: var(--gold);","+  border-radius: var(--radius-full);","+  animation: spin 1s linear infinite;","+}","+","+/* ═══════════════════════════════════════════════════════════════════════════════","+   RESPONSIVE","+   ═══════════════════════════════════════════════════════════════════════════════ */","+"," @media (max-width: 768px) {","   .ta-nav { padding: 20px 24px; }","   .sidebar { display: none; }"]}],"originalFile":"@import \"tailwindcss\";\n\n/* ═══════════════════════════════════════════════\n   TALENT AGENT — DESIGN SYSTEM\n   Derived from seanyoung.biz consulting site\n   ═══════════════════════════════════════════════ */\n\n:root {\n  --black: #080808;\n  --off-black: #0f0f0f;\n  --surface: #161616;\n  --border: rgba(255,255,255,0.07);\n  --gold: #C9A84C;\n  --gold-light: #E8C97A;\n  --white: #F4F1EB;\n  --muted: rgba(244,241,235,0.45);\n  --mono: 'DM Mono', monospace;\n  --serif: 'Playfair Display', Georgia, serif;\n  --sans: 'DM Sans', sans-serif;\n  --nav-bg: rgba(8,8,8,0.95);\n  --transition-theme: background 0.35s ease, color 0.35s ease, border-color 0.35s ease;\n  /* status */\n  --emerald: #34D399;\n  --rose: #FB7185;\n  --amber: #FBBF24;\n}\n\nhtml { scroll-behavior: smooth; }\n\nbody {\n  background: var(--black);\n  color: var(--white);\n  font-family: var(--sans);\n  font-weight: 300;\n  line-height: 1.7;\n  margin: 0;\n  overflow-x: hidden;\n  transition: var(--transition-theme);\n  -webkit-font-smoothing: antialiased;\n}\n\n::selection { background: rgba(201,168,76,0.3); color: var(--white); }\n::-webkit-scrollbar { width: 6px; }\n::-webkit-scrollbar-track { background: transparent; }\n::-webkit-scrollbar-thumb { background: rgba(201,168,76,0.15); }\n::-webkit-scrollbar-thumb:hover { background: rgba(201,168,76,0.3); }\n\n/* ── Typography ── */\n.t-serif {\n  font-family: var(--serif);\n  font-weight: 400;\n  line-height: 1.15;\n}\n.t-serif-bold {\n  font-family: var(--serif);\n  font-weight: 700;\n  line-height: 1.1;\n}\n.t-label {\n  font-family: var(--mono);\n  font-size: 10px;\n  letter-spacing: 0.25em;\n  text-transform: uppercase;\n  color: var(--muted);\n}\n.t-label-gold {\n  font-family: var(--mono);\n  font-size: 10px;\n  letter-spacing: 0.25em;\n  text-transform: uppercase;\n  color: var(--gold);\n}\n.t-body {\n  font-size: 14px;\n  color: var(--muted);\n  line-height: 1.8;\n  font-weight: 300;\n}\n\n/* ── Section label (with gold dash) ── */\n.section-label {\n  font-family: var(--mono);\n  font-size: 10px;\n  letter-spacing: 0.35em;\n  text-transform: uppercase;\n  color: var(--gold);\n  margin-bottom: 48px;\n  display: flex;\n  align-items: center;\n  gap: 16px;\n}\n.section-label::after {\n  content: '';\n  width: 40px;\n  height: 1px;\n  background: var(--gold);\n  opacity: 0.4;\n}\n\n/* ── Buttons (exact match) ── */\n.btn-primary {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  padding: 16px 36px;\n  background: var(--gold);\n  color: #080808;\n  font-family: var(--mono);\n  font-size: 12px;\n  letter-spacing: 0.15em;\n  text-transform: uppercase;\n  text-decoration: none;\n  border: none;\n  cursor: pointer;\n  transition: background 0.2s;\n}\n.btn-primary:hover { background: var(--gold-light); }\n.btn-primary:disabled { opacity: 0.35; cursor: not-allowed; }\n\n.btn-ghost {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  padding: 16px 36px;\n  border: 1px solid var(--border);\n  color: var(--muted);\n  font-family: var(--mono);\n  font-size: 12px;\n  letter-spacing: 0.15em;\n  text-transform: uppercase;\n  text-decoration: none;\n  background: transparent;\n  cursor: pointer;\n  transition: border-color 0.2s, color 0.2s;\n}\n.btn-ghost:hover { border-color: rgba(255,255,255,0.3); color: var(--white); }\n\n/* ── Inputs (exact form-group match) ── */\n.input {\n  background: var(--surface);\n  border: 1px solid var(--border);\n  color: var(--white);\n  font-family: var(--sans);\n  font-size: 14px;\n  font-weight: 300;\n  padding: 14px 18px;\n  outline: none;\n  transition: border-color 0.2s;\n  width: 100%;\n  appearance: none;\n}\n.input:focus { border-color: var(--gold); }\n.input::placeholder { color: var(--muted); opacity: 0.6; }\n.input:disabled { opacity: 0.45; }\n\n.input-label {\n  font-family: var(--mono);\n  font-size: 10px;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n  color: var(--muted);\n  display: block;\n  margin-bottom: 8px;\n}\n\n/* ── Cards (1px grid gap pattern) ── */\n.grid-border {\n  display: grid;\n  gap: 1px;\n  background: var(--border);\n  border: 1px solid var(--border);\n}\n.grid-border > * {\n  background: var(--off-black);\n}\n\n/* ── Card hover (gold top-border animation) ── */\n.card-hover {\n  position: relative;\n  overflow: hidden;\n}\n.card-hover::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n  height: 2px;\n  background: var(--gold);\n  transform: scaleX(0);\n  transform-origin: left;\n  transition: transform 0.4s;\n}\n.card-hover:hover::before { transform: scaleX(1); }\n\n/* ── Stat row ── */\n.stat-num {\n  font-family: var(--serif);\n  font-size: 36px;\n  font-weight: 700;\n  color: var(--gold);\n  line-height: 1;\n}\n.stat-label {\n  font-family: var(--mono);\n  font-size: 10px;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n  color: var(--muted);\n  margin-top: 8px;\n}\n\n/* ── Tags ── */\n.tag {\n  font-family: var(--mono);\n  font-size: 9px;\n  letter-spacing: 0.15em;\n  text-transform: uppercase;\n  padding: 5px 10px;\n  border: 1px solid var(--border);\n  color: var(--muted);\n}\n\n/* ── Nav ── */\n.ta-nav {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  z-index: 100;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 28px 60px;\n  background: var(--nav-bg);\n  backdrop-filter: blur(12px);\n  border-bottom: 1px solid var(--border);\n  transition: background 0.35s ease, border-color 0.35s ease;\n}\n.ta-nav-logo {\n  font-family: var(--mono);\n  font-size: 13px;\n  letter-spacing: 0.15em;\n  color: var(--gold);\n  text-decoration: none;\n}\n.ta-nav-links {\n  display: flex;\n  gap: 40px;\n  list-style: none;\n}\n.ta-nav-link {\n  font-family: var(--mono);\n  font-size: 11px;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n  color: var(--muted);\n  text-decoration: none;\n  transition: color 0.2s;\n}\n.ta-nav-link:hover { color: var(--white); }\n\n/* ── Animations ── */\n@keyframes fadeIn {\n  from { opacity: 0; transform: translateY(12px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n@keyframes spin {\n  to { transform: rotate(360deg); }\n}\n.fade-in { animation: fadeIn 0.6s ease forwards; }\n.fade-in-delay { animation: fadeIn 0.6s ease 0.15s forwards; opacity: 0; }\n.fade-in-delay2 { animation: fadeIn 0.6s ease 0.3s forwards; opacity: 0; }\n.spinner {\n  width: 36px;\n  height: 36px;\n  border: 2px solid var(--border);\n  border-top-color: var(--gold);\n  border-radius: 50%;\n  animation: spin 1s linear infinite;\n}\n\n/* ── Footer ── */\n.ta-footer {\n  border-top: 1px solid var(--border);\n  padding: 40px 60px;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n/* ── Sidebar (dashboard) ── */\n.sidebar {\n  width: 260px;\n  background: var(--off-black);\n  border-right: 1px solid var(--border);\n  display: flex;\n  flex-direction: column;\n  flex-shrink: 0;\n}\n.sidebar-brand {\n  padding: 28px 32px;\n  border-bottom: 1px solid var(--border);\n}\n.sidebar-nav { flex: 1; padding: 24px 16px; }\n.sidebar-link {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  padding: 12px 16px;\n  font-family: var(--sans);\n  font-size: 14px;\n  font-weight: 300;\n  color: var(--muted);\n  text-decoration: none;\n  border-left: 2px solid transparent;\n  transition: color 0.2s, border-color 0.2s, background 0.2s;\n  margin-bottom: 2px;\n}\n.sidebar-link:hover { color: var(--white); }\n.sidebar-link.active {\n  color: var(--gold);\n  font-weight: 400;\n  border-left-color: var(--gold);\n  background: rgba(201,168,76,0.04);\n}\n.sidebar-link svg { width: 18px; height: 18px; stroke-width: 1.5; }\n.sidebar-footer {\n  padding: 16px;\n  border-top: 1px solid var(--border);\n}\n\n/* ── Topbar (dashboard) ── */\n.topbar {\n  height: 72px;\n  border-bottom: 1px solid var(--border);\n  background: rgba(15,15,15,0.6);\n  backdrop-filter: blur(12px);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 32px;\n  flex-shrink: 0;\n}\n.topbar-title {\n  font-family: var(--serif);\n  font-size: 20px;\n  font-weight: 400;\n}\n.topbar-avatar {\n  width: 34px;\n  height: 34px;\n  border: 1px solid var(--gold);\n  border-radius: 50%;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-family: var(--mono);\n  font-size: 10px;\n  font-weight: 500;\n  color: var(--gold);\n  cursor: pointer;\n  background: transparent;\n  transition: background 0.2s;\n}\n.topbar-avatar:hover { background: rgba(201,168,76,0.06); }\n\n/* ── Dropdown ── */\n.dropdown {\n  position: absolute;\n  right: 0;\n  top: 44px;\n  width: 220px;\n  background: var(--surface);\n  border: 1px solid var(--border);\n  z-index: 50;\n}\n.dropdown-item {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 12px 16px;\n  font-size: 13px;\n  color: var(--muted);\n  cursor: pointer;\n  background: transparent;\n  border: none;\n  width: 100%;\n  font-family: var(--sans);\n  font-weight: 300;\n  transition: color 0.2s;\n}\n.dropdown-item:hover { color: var(--white); }\n\n/* ── Status badge ── */\n.status-badge {\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  font-family: var(--mono);\n  font-size: 9px;\n  letter-spacing: 0.1em;\n  text-transform: uppercase;\n  padding: 4px 10px;\n  border: 1px solid;\n}\n.status-badge .dot {\n  width: 5px;\n  height: 5px;\n  border-radius: 50%;\n  background: currentColor;\n}\n\n/* ── Table ── */\n.ta-table { width: 100%; border-collapse: collapse; }\n.ta-table th {\n  font-family: var(--mono);\n  font-size: 10px;\n  letter-spacing: 0.2em;\n  text-transform: uppercase;\n  color: var(--muted);\n  text-align: left;\n  padding: 14px 20px;\n  border-bottom: 1px solid var(--border);\n  font-weight: 400;\n}\n.ta-table td {\n  padding: 14px 20px;\n  border-bottom: 1px solid var(--border);\n  font-size: 14px;\n  font-weight: 300;\n}\n.ta-table tr:last-child td { border-bottom: none; }\n.ta-table tr:hover td { background: rgba(201,168,76,0.02); }\n\n/* ── Responsive ── */\n@media (max-width: 768px) {\n  .ta-nav { padding: 20px 24px; }\n  .sidebar { display: none; }\n}\n"}}}
