{"t":"2026-05-20T20:08:18.143Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ne5cx8Dr2dpeizXE4K3qLB","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→from fastapi import APIRouter\n     5→from backend.api import auth, onboarding, discovery, application, review\n     6→\n     7→router = APIRouter(prefix=\"/api/v1\")\n     8→\n     9→router.include_router(auth.router, prefix=\"/auth\", tags=[\"auth\"])\n    10→router.include_router(onboarding.router, prefix=\"/onboarding\", tags=[\"onboarding\"])\n    11→router.include_router(discovery.router, prefix=\"/discovery\", tags=[\"discovery\"])\n    12→router.include_router(application.router, prefix=\"/application\", tags=[\"application\"])\n    13→router.include_router(review.router, prefix=\"/review\", tags=[\"review\"])\n    14→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"3abdcdb3-ba6e-4956-81cd-bfbde81bb346","uuid":"8c6a09bd-b0e7-4d28-8801-35751b1cabe7","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/api/router.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\nfrom fastapi import APIRouter\nfrom backend.api import auth, onboarding, discovery, application, review\n\nrouter = APIRouter(prefix=\"/api/v1\")\n\nrouter.include_router(auth.router, prefix=\"/auth\", tags=[\"auth\"])\nrouter.include_router(onboarding.router, prefix=\"/onboarding\", tags=[\"onboarding\"])\nrouter.include_router(discovery.router, prefix=\"/discovery\", tags=[\"discovery\"])\nrouter.include_router(application.router, prefix=\"/application\", tags=[\"application\"])\nrouter.include_router(review.router, prefix=\"/review\", tags=[\"review\"])\n","numLines":14,"startLine":1,"totalLines":14}}}}
{"t":"2026-05-20T20:08:18.151Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HaUvnTPNsLVSSA8PLfHD96","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Authentication API — passwordless magic link flow.\n     6→\n     7→POST  /auth/request-link     → request a magic login link\n     8→POST  /auth/verify            → verify magic link token, return JWT\n     9→GET   /auth/me                → get current authenticated user\n    10→\"\"\"\n    11→\n    12→import uuid\n    13→import secrets\n    14→from datetime import datetime, timedelta, timezone\n    15→\n    16→import jwt\n    17→import resend\n    18→import structlog\n    19→from fastapi import APIRouter, Depends, HTTPException, Request\n    20→from fastapi.security import HTTPBearer, HTTPAuthorizationCredentials\n    21→from pydantic import BaseModel, EmailStr\n    22→from sqlalchemy import select\n    23→from sqlalchemy.ext.asyncio import AsyncSession\n    24→\n    25→from backend.config import settings\n    26→from backend.database import get_db\n    27→from backend.models.auth import User, MagicLink\n    28→\n    29→logger = structlog.get_logger(__name__)\n    30→router = APIRouter()\n    31→security = HTTPBearer(auto_error=False)\n    32→\n    33→\n    34→# ─── PII Redaction ────────────────────────────────────────────────────────────\n    35→\n    36→def redact_email(email: str) -> str:\n    37→    \"\"\"Redact email for safe logging. e.g. 'spy@seanyoung.biz' → 's**@s***.biz'\"\"\"\n    38→    if not email or \"@\" not in email:\n    39→        return \"[redacted]\"\n    40→    local, domain = email.split(\"@\", 1)\n    41→    domain_parts = domain.rsplit(\".\", 1)\n    42→    redacted_local = local[0] + \"**\" if local else \"**\"\n    43→    if len(domain_parts) == 2:\n    44→        redacted_domain = domain_parts[0][0] + \"***.\" + domain_parts[1]\n    45→    else:\n    46→        redacted_domain = \"***\"\n    47→    return f\"{redacted_local}@{redacted_domain}\"\n    48→\n    49→\n    50→# ─── Schemas ─────────────────────────────────────────────────────────────────\n    51→\n    52→class RequestLinkPayload(BaseModel):\n    53→    \"\"\"Payload to request a magic link.\"\"\"\n    54→    email: EmailStr\n    55→\n    56→\n    57→class RequestLinkResponse(BaseModel):\n    58→    \"\"\"Response after requesting a magic link.\"\"\"\n    59→    message: str\n    60→    # In dev mode, we return the magic link directly so you can click it\n    61→    magic_link: str | None = None\n    62→    token: str | None = None\n    63→\n    64→\n    65→class VerifyTokenPayload(BaseModel):\n    66→    \"\"\"Payload to verify a magic link token.\"\"\"\n    67→    token: str\n    68→\n    69→\n    70→class AuthResponse(BaseModel):\n    71→    \"\"\"Response with JWT access token.\"\"\"\n    72→    access_token: str\n    73→    token_type: str = \"bearer\"\n    74→    user_id: str\n    75→    email: str\n    76→    is_onboarded: bool\n    77→\n    78→\n    79→class UserResponse(BaseModel):\n    80→    \"\"\"Current user info.\"\"\"\n    81→    id: str\n    82→    email: str\n    83→    name: str | None\n    84→    is_onboarded: bool\n    85→    candidate_id: str | None\n    86→    created_at: str\n    87→\n    88→\n    89→# ─── JWT Helpers ─────────────────────────────────────────────────────────────\n    90→\n    91→def create_jwt(user_id: uuid.UUID, email: str) -> str:\n    92→    \"\"\"Create a JWT access token for an authenticated user.\"\"\"\n    93→    payload = {\n    94→        \"sub\": str(user_id),\n    95→        \"email\": email,\n    96→        \"iat\": datetime.now(timezone.utc),\n    97→        \"exp\": datetime.now(timezone.utc) + timedelta(days=7),\n    98→    }\n    99→    return jwt.encode(payload, settings.jwt_secret, algorithm=\"HS256\")\n   100→\n   101→\n   102→def decode_jwt(token: str) -> dict:\n   103→    \"\"\"Decode and validate a JWT token.\"\"\"\n   104→    try:\n   105→        return jwt.decode(token, settings.jwt_secret, algorithms=[\"HS256\"])\n   106→    except jwt.ExpiredSignatureError:\n   107→        raise HTTPException(status_code=401, detail=\"Token expired\")\n   108→    except jwt.InvalidTokenError:\n   109→        raise HTTPException(status_code=401, detail=\"Invalid token\")\n   110→\n   111→\n   112→# ─── Resend Email ─────────────────────────────────────────────────────────────\n   113→\n   114→async def send_magic_link_email(email: str, magic_link_url: str) -> bool:\n   115→    \"\"\"\n   116→    Send magic link email via Resend.\n   117→\n   118→    Returns True if email was sent successfully, False otherwise.\n   119→    Falls back gracefully if Resend is not configured.\n   120→    \"\"\"\n   121→    if not settings.resend_api_key:\n   122→        logger.warning(\n   123→            \"auth.resend_not_configured\",\n   124→            email_redacted=redact_email(email),\n   125→            message=\"Resend API key not set, email not sent\",\n   126→        )\n   127→        return False\n   128→\n   129→    resend.api_key = settings.resend_api_key\n   130→\n   131→    try:\n   132→        resend.Emails.send({\n   133→            \"from\": settings.resend_from_email,\n   134→            \"to\": email,\n   135→            \"subject\": \"Your Talent Agent Login Link\",\n   136→            \"html\": f\"\"\"\n   137→            <div style=\"font-family: 'DM Sans', -apple-system, sans-serif; max-width: 600px; margin: 0 auto; padding: 40px 20px; background-color: #0A0A0A; color: #FAFAFA;\">\n   138→                <h1 style=\"font-family: 'Playfair Display', Georgia, serif; color: #C9A227; font-size: 28px; margin-bottom: 24px;\">\n   139→                    Talent Agent\n   140→                </h1>\n   141→                <p style=\"font-size: 16px; line-height: 1.6; margin-bottom: 24px;\">\n   142→                    Click the button below to sign in to your account. This link expires in {settings.magic_link_expiry_minutes} minutes.\n   143→                </p>\n   144→                <a href=\"{magic_link_url}\" style=\"display: inline-block; background-color: #C9A227; color: #0A0A0A; padding: 14px 28px; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px;\">\n   145→                    Sign In\n   146→                </a>\n   147→                <p style=\"font-size: 14px; color: #737373; margin-top: 32px; line-height: 1.6;\">\n   148→                    If you didn't request this link, you can safely ignore this email.\n   149→                </p>\n   150→                <hr style=\"border: none; border-top: 1px solid rgba(255,255,255,0.08); margin: 32px 0;\">\n   151→                <p style=\"font-size: 12px; color: #737373;\">\n   152→                    VibeSpace LLC · The Dot Connects\n   153→                </p>\n   154→            </div>\n   155→            \"\"\",\n   156→        })\n   157→        logger.info(\n   158→            \"auth.email_sent\",\n   159→            email_redacted=redact_email(email),\n   160→        )\n   161→        return True\n   162→    except Exception as e:\n   163→        logger.error(\n   164→            \"auth.email_send_failed\",\n   165→            email_redacted=redact_email(email),\n   166→            error=str(e),\n   167→        )\n   168→        return False\n   169→\n   170→\n   171→# ─── Auth Dependency ─────────────────────────────────────────────────────────\n   172→\n   173→async def get_current_user(\n   174→    credentials: HTTPAuthorizationCredentials | None = Depends(security),\n   175→    db: AsyncSession = Depends(get_db),\n   176→) -> User:\n   177→    \"\"\"FastAPI dependency that returns the current authenticated user.\"\"\"\n   178→    if credentials is None:\n   179→        raise HTTPException(status_code=401, detail=\"Not authenticated\")\n   180→\n   181→    payload = decode_jwt(credentials.credentials)\n   182→    user_id = payload.get(\"sub\")\n   183→    if not user_id:\n   184→        raise HTTPException(status_code=401, detail=\"Invalid token payload\")\n   185→\n   186→    result = await db.execute(\n   187→        select(User).where(User.id == uuid.UUID(user_id))\n   188→    )\n   189→    user = result.scalar_one_or_none()\n   190→    if not user or not user.is_active:\n   191→        raise HTTPException(status_code=401, detail=\"User not found or inactive\")\n   192→\n   193→    return user\n   194→\n   195→\n   196→# ─── Endpoints ───────────────────────────────────────────────────────────────\n   197→\n   198→@router.post(\"/request-link\", response_model=RequestLinkResponse)\n   199→async def request_magic_link(\n   200→    payload: RequestLinkPayload,\n   201→    request: Request,\n   202→    db: AsyncSession = Depends(get_db),\n   203→):\n   204→    \"\"\"\n   205→    Request a magic login link. Creates user if they don't exist.\n   206→\n   207→    In dev mode (DEBUG=true), returns the magic link directly in the response\n   208→    so you can click it without needing email infrastructure.\n   209→    In production, sends the link via Resend email service.\n   210→    \"\"\"\n   211→    email = payload.email.lower().strip()\n   212→    email_redacted = redact_email(email)\n   213→\n   214→    # Find or create user\n   215→    result = await db.execute(select(User).where(User.email == email))\n   216→    user = result.scalar_one_or_none()\n   217→\n   218→    if not user:\n   219→        user = User(email=email)\n   220→        db.add(user)\n   221→        await db.flush()\n   222→        logger.info(\n   223→            \"auth.user_created\",\n   224→            email_redacted=email_redacted,\n   225→            user_id=str(user.id),\n   226→        )\n   227→\n   228→    # Generate magic link token\n   229→    token = secrets.token_urlsafe(48)\n   230→    expires_at = datetime.now(timezone.utc) + timedelta(minutes=settings.magic_link_expiry_minutes)\n   231→\n   232→    magic_link_record = MagicLink(\n   233→        user_id=user.id,\n   234→        token=token,\n   235→        expires_at=expires_at,\n   236→    )\n   237→    db.add(magic_link_record)\n   238→    await db.commit()\n   239→\n   240→    # Build the magic link URL using frontend origin\n   241→    origin = request.headers.get(\"origin\", \"http://localhost:5173\")\n   242→    magic_link_url = f\"{origin}/auth/verify?token={token}\"\n   243→\n   244→    logger.info(\n   245→        \"auth.magic_link_created\",\n   246→        email_redacted=email_redacted,\n   247→        expires_at=expires_at.isoformat(),\n   248→    )\n   249→\n   250→    if settings.debug:\n   251→        # Dev mode: return link directly for easy testing\n   252→        return RequestLinkResponse(\n   253→            message=\"Magic link created. Click to log in.\",\n   254→            magic_link=magic_link_url,\n   255→            token=token,\n   256→        )\n   257→    else:\n   258→        # Production: send email via Resend\n   259→        email_sent = await send_magic_link_email(email, magic_link_url)\n   260→        if email_sent:\n   261→            return RequestLinkResponse(\n   262→                message=\"Check your email for a login link.\",\n   263→            )\n   264→        else:\n   265→            # Graceful degradation if email fails\n   266→            logger.warning(\n   267→                \"auth.email_fallback\",\n   268→                email_redacted=email_redacted,\n   269→                message=\"Email service unavailable\",\n   270→            )\n   271→            return RequestLinkResponse(\n   272→                message=\"Check your email for a login link.\",\n   273→            )\n   274→\n   275→\n   276→@router.post(\"/verify\", response_model=AuthResponse)\n   277→async def verify_magic_link(\n   278→    payload: VerifyTokenPayload,\n   279→    db: AsyncSession = Depends(get_db),\n   280→):\n   281→    \"\"\"\n   282→    Verify a magic link token and return a JWT access token.\n   283→\n   284→    The magic link token is single-use and time-limited.\n   285→    \"\"\"\n   286→    result = await db.execute(\n   287→        select(MagicLink).where(MagicLink.token == payload.token)\n   288→    )\n   289→    magic_link = result.scalar_one_or_none()\n   290→\n   291→    if not magic_link:\n   292→        raise HTTPException(status_code=401, detail=\"Invalid or expired link\")\n   293→\n   294→    if magic_link.is_used:\n   295→        raise HTTPException(status_code=401, detail=\"This link has already been used\")\n   296→\n   297→    if magic_link.expires_at.replace(tzinfo=timezone.utc) < datetime.now(timezone.utc):\n   298→        raise HTTPException(status_code=401, detail=\"This link has expired\")\n   299→\n   300→    # Mark as used\n   301→    magic_link.is_used = True\n   302→\n   303→    # Get the user\n   304→    user_result = await db.execute(\n   305→        select(User).where(User.id == magic_link.user_id)\n   306→    )\n   307→    user = user_result.scalar_one_or_none()\n   308→    if not user:\n   309→        raise HTTPException(status_code=401, detail=\"User not found\")\n   310→\n   311→    # Update last login\n   312→    user.last_login_at = datetime.now(timezone.utc)\n   313→    await db.commit()\n   314→\n   315→    # Issue JWT\n   316→    access_token = create_jwt(user.id, user.email)\n   317→\n   318→    logger.info(\n   319→        \"auth.login_success\",\n   320→        email_redacted=redact_email(user.email),\n   321→        user_id=str(user.id),\n   322→    )\n   323→\n   324→    return AuthResponse(\n   325→        access_token=access_token,\n   326→        user_id=str(user.id),\n   327→        email=user.email,\n   328→        is_onboarded=user.is_onboarded,\n   329→    )\n   330→\n   331→\n   332→@router.get(\"/me\", response_model=UserResponse)\n   333→async def get_me(\n   334→    current_user: User = Depends(get_current_user),\n   335→):\n   336→    \"\"\"Get the current authenticated user's info.\"\"\"\n   337→    return UserResponse(\n   338→        id=str(current_user.id),\n   339→        email=current_user.email,\n   340→        name=current_user.name,\n   341→        is_onboarded=current_user.is_onboarded,\n   342→        candidate_id=str(current_user.candidate_id) if current_user.candidate_id else None,\n   343→        created_at=current_user.created_at.isoformat(),\n   344→    )\n   345→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"3abdcdb3-ba6e-4956-81cd-bfbde81bb346","uuid":"b55867b3-b9b7-4f2e-aaf8-80115ee3deec","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/api/auth.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nAuthentication API — passwordless magic link flow.\n\nPOST  /auth/request-link     → request a magic login link\nPOST  /auth/verify            → verify magic link token, return JWT\nGET   /auth/me                → get current authenticated user\n\"\"\"\n\nimport uuid\nimport secrets\nfrom datetime import datetime, timedelta, timezone\n\nimport jwt\nimport resend\nimport structlog\nfrom fastapi import APIRouter, Depends, HTTPException, Request\nfrom fastapi.security import HTTPBearer, HTTPAuthorizationCredentials\nfrom pydantic import BaseModel, EmailStr\nfrom sqlalchemy import select\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom backend.config import settings\nfrom backend.database import get_db\nfrom backend.models.auth import User, MagicLink\n\nlogger = structlog.get_logger(__name__)\nrouter = APIRouter()\nsecurity = HTTPBearer(auto_error=False)\n\n\n# ─── PII Redaction ────────────────────────────────────────────────────────────\n\ndef redact_email(email: str) -> str:\n    \"\"\"Redact email for safe logging. e.g. 'spy@seanyoung.biz' → 's**@s***.biz'\"\"\"\n    if not email or \"@\" not in email:\n        return \"[redacted]\"\n    local, domain = email.split(\"@\", 1)\n    domain_parts = domain.rsplit(\".\", 1)\n    redacted_local = local[0] + \"**\" if local else \"**\"\n    if len(domain_parts) == 2:\n        redacted_domain = domain_parts[0][0] + \"***.\" + domain_parts[1]\n    else:\n        redacted_domain = \"***\"\n    return f\"{redacted_local}@{redacted_domain}\"\n\n\n# ─── Schemas ─────────────────────────────────────────────────────────────────\n\nclass RequestLinkPayload(BaseModel):\n    \"\"\"Payload to request a magic link.\"\"\"\n    email: EmailStr\n\n\nclass RequestLinkResponse(BaseModel):\n    \"\"\"Response after requesting a magic link.\"\"\"\n    message: str\n    # In dev mode, we return the magic link directly so you can click it\n    magic_link: str | None = None\n    token: str | None = None\n\n\nclass VerifyTokenPayload(BaseModel):\n    \"\"\"Payload to verify a magic link token.\"\"\"\n    token: str\n\n\nclass AuthResponse(BaseModel):\n    \"\"\"Response with JWT access token.\"\"\"\n    access_token: str\n    token_type: str = \"bearer\"\n    user_id: str\n    email: str\n    is_onboarded: bool\n\n\nclass UserResponse(BaseModel):\n    \"\"\"Current user info.\"\"\"\n    id: str\n    email: str\n    name: str | None\n    is_onboarded: bool\n    candidate_id: str | None\n    created_at: str\n\n\n# ─── JWT Helpers ─────────────────────────────────────────────────────────────\n\ndef create_jwt(user_id: uuid.UUID, email: str) -> str:\n    \"\"\"Create a JWT access token for an authenticated user.\"\"\"\n    payload = {\n        \"sub\": str(user_id),\n        \"email\": email,\n        \"iat\": datetime.now(timezone.utc),\n        \"exp\": datetime.now(timezone.utc) + timedelta(days=7),\n    }\n    return jwt.encode(payload, settings.jwt_secret, algorithm=\"HS256\")\n\n\ndef decode_jwt(token: str) -> dict:\n    \"\"\"Decode and validate a JWT token.\"\"\"\n    try:\n        return jwt.decode(token, settings.jwt_secret, algorithms=[\"HS256\"])\n    except jwt.ExpiredSignatureError:\n        raise HTTPException(status_code=401, detail=\"Token expired\")\n    except jwt.InvalidTokenError:\n        raise HTTPException(status_code=401, detail=\"Invalid token\")\n\n\n# ─── Resend Email ─────────────────────────────────────────────────────────────\n\nasync def send_magic_link_email(email: str, magic_link_url: str) -> bool:\n    \"\"\"\n    Send magic link email via Resend.\n\n    Returns True if email was sent successfully, False otherwise.\n    Falls back gracefully if Resend is not configured.\n    \"\"\"\n    if not settings.resend_api_key:\n        logger.warning(\n            \"auth.resend_not_configured\",\n            email_redacted=redact_email(email),\n            message=\"Resend API key not set, email not sent\",\n        )\n        return False\n\n    resend.api_key = settings.resend_api_key\n\n    try:\n        resend.Emails.send({\n            \"from\": settings.resend_from_email,\n            \"to\": email,\n            \"subject\": \"Your Talent Agent Login Link\",\n            \"html\": f\"\"\"\n            <div style=\"font-family: 'DM Sans', -apple-system, sans-serif; max-width: 600px; margin: 0 auto; padding: 40px 20px; background-color: #0A0A0A; color: #FAFAFA;\">\n                <h1 style=\"font-family: 'Playfair Display', Georgia, serif; color: #C9A227; font-size: 28px; margin-bottom: 24px;\">\n                    Talent Agent\n                </h1>\n                <p style=\"font-size: 16px; line-height: 1.6; margin-bottom: 24px;\">\n                    Click the button below to sign in to your account. This link expires in {settings.magic_link_expiry_minutes} minutes.\n                </p>\n                <a href=\"{magic_link_url}\" style=\"display: inline-block; background-color: #C9A227; color: #0A0A0A; padding: 14px 28px; text-decoration: none; border-radius: 6px; font-weight: 600; font-size: 16px;\">\n                    Sign In\n                </a>\n                <p style=\"font-size: 14px; color: #737373; margin-top: 32px; line-height: 1.6;\">\n                    If you didn't request this link, you can safely ignore this email.\n                </p>\n                <hr style=\"border: none; border-top: 1px solid rgba(255,255,255,0.08); margin: 32px 0;\">\n                <p style=\"font-size: 12px; color: #737373;\">\n                    VibeSpace LLC · The Dot Connects\n                </p>\n            </div>\n            \"\"\",\n        })\n        logger.info(\n            \"auth.email_sent\",\n            email_redacted=redact_email(email),\n        )\n        return True\n    except Exception as e:\n        logger.error(\n            \"auth.email_send_failed\",\n            email_redacted=redact_email(email),\n            error=str(e),\n        )\n        return False\n\n\n# ─── Auth Dependency ─────────────────────────────────────────────────────────\n\nasync def get_current_user(\n    credentials: HTTPAuthorizationCredentials | None = Depends(security),\n    db: AsyncSession = Depends(get_db),\n) -> User:\n    \"\"\"FastAPI dependency that returns the current authenticated user.\"\"\"\n    if credentials is None:\n        raise HTTPException(status_code=401, detail=\"Not authenticated\")\n\n    payload = decode_jwt(credentials.credentials)\n    user_id = payload.get(\"sub\")\n    if not user_id:\n        raise HTTPException(status_code=401, detail=\"Invalid token payload\")\n\n    result = await db.execute(\n        select(User).where(User.id == uuid.UUID(user_id))\n    )\n    user = result.scalar_one_or_none()\n    if not user or not user.is_active:\n        raise HTTPException(status_code=401, detail=\"User not found or inactive\")\n\n    return user\n\n\n# ─── Endpoints ───────────────────────────────────────────────────────────────\n\n@router.post(\"/request-link\", response_model=RequestLinkResponse)\nasync def request_magic_link(\n    payload: RequestLinkPayload,\n    request: Request,\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"\n    Request a magic login link. Creates user if they don't exist.\n\n    In dev mode (DEBUG=true), returns the magic link directly in the response\n    so you can click it without needing email infrastructure.\n    In production, sends the link via Resend email service.\n    \"\"\"\n    email = payload.email.lower().strip()\n    email_redacted = redact_email(email)\n\n    # Find or create user\n    result = await db.execute(select(User).where(User.email == email))\n    user = result.scalar_one_or_none()\n\n    if not user:\n        user = User(email=email)\n        db.add(user)\n        await db.flush()\n        logger.info(\n            \"auth.user_created\",\n            email_redacted=email_redacted,\n            user_id=str(user.id),\n        )\n\n    # Generate magic link token\n    token = secrets.token_urlsafe(48)\n    expires_at = datetime.now(timezone.utc) + timedelta(minutes=settings.magic_link_expiry_minutes)\n\n    magic_link_record = MagicLink(\n        user_id=user.id,\n        token=token,\n        expires_at=expires_at,\n    )\n    db.add(magic_link_record)\n    await db.commit()\n\n    # Build the magic link URL using frontend origin\n    origin = request.headers.get(\"origin\", \"http://localhost:5173\")\n    magic_link_url = f\"{origin}/auth/verify?token={token}\"\n\n    logger.info(\n        \"auth.magic_link_created\",\n        email_redacted=email_redacted,\n        expires_at=expires_at.isoformat(),\n    )\n\n    if settings.debug:\n        # Dev mode: return link directly for easy testing\n        return RequestLinkResponse(\n            message=\"Magic link created. Click to log in.\",\n            magic_link=magic_link_url,\n            token=token,\n        )\n    else:\n        # Production: send email via Resend\n        email_sent = await send_magic_link_email(email, magic_link_url)\n        if email_sent:\n            return RequestLinkResponse(\n                message=\"Check your email for a login link.\",\n            )\n        else:\n            # Graceful degradation if email fails\n            logger.warning(\n                \"auth.email_fallback\",\n                email_redacted=email_redacted,\n                message=\"Email service unavailable\",\n            )\n            return RequestLinkResponse(\n                message=\"Check your email for a login link.\",\n            )\n\n\n@router.post(\"/verify\", response_model=AuthResponse)\nasync def verify_magic_link(\n    payload: VerifyTokenPayload,\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"\n    Verify a magic link token and return a JWT access token.\n\n    The magic link token is single-use and time-limited.\n    \"\"\"\n    result = await db.execute(\n        select(MagicLink).where(MagicLink.token == payload.token)\n    )\n    magic_link = result.scalar_one_or_none()\n\n    if not magic_link:\n        raise HTTPException(status_code=401, detail=\"Invalid or expired link\")\n\n    if magic_link.is_used:\n        raise HTTPException(status_code=401, detail=\"This link has already been used\")\n\n    if magic_link.expires_at.replace(tzinfo=timezone.utc) < datetime.now(timezone.utc):\n        raise HTTPException(status_code=401, detail=\"This link has expired\")\n\n    # Mark as used\n    magic_link.is_used = True\n\n    # Get the user\n    user_result = await db.execute(\n        select(User).where(User.id == magic_link.user_id)\n    )\n    user = user_result.scalar_one_or_none()\n    if not user:\n        raise HTTPException(status_code=401, detail=\"User not found\")\n\n    # Update last login\n    user.last_login_at = datetime.now(timezone.utc)\n    await db.commit()\n\n    # Issue JWT\n    access_token = create_jwt(user.id, user.email)\n\n    logger.info(\n        \"auth.login_success\",\n        email_redacted=redact_email(user.email),\n        user_id=str(user.id),\n    )\n\n    return AuthResponse(\n        access_token=access_token,\n        user_id=str(user.id),\n        email=user.email,\n        is_onboarded=user.is_onboarded,\n    )\n\n\n@router.get(\"/me\", response_model=UserResponse)\nasync def get_me(\n    current_user: User = Depends(get_current_user),\n):\n    \"\"\"Get the current authenticated user's info.\"\"\"\n    return UserResponse(\n        id=str(current_user.id),\n        email=current_user.email,\n        name=current_user.name,\n        is_onboarded=current_user.is_onboarded,\n        candidate_id=str(current_user.candidate_id) if current_user.candidate_id else None,\n        created_at=current_user.created_at.isoformat(),\n    )\n","numLines":345,"startLine":1,"totalLines":345}}}}
{"t":"2026-05-20T20:08:18.158Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XbuKWrej5m4Lrq9mY9SXKA","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Onboarding API — resume upload and candidate profile creation.\n     6→\n     7→POST  /onboarding/resume       → upload resume PDF, extract text\n     8→POST  /onboarding/profile      → save candidate profile + preferences\n     9→GET   /onboarding/status       → check onboarding completion status\n    10→\"\"\"\n    11→\n    12→import uuid\n    13→import os\n    14→import tempfile\n    15→from typing import Optional\n    16→\n    17→import structlog\n    18→from fastapi import APIRouter, Depends, HTTPException, UploadFile, File\n    19→from pydantic import BaseModel\n    20→from sqlalchemy import select\n    21→from sqlalchemy.ext.asyncio import AsyncSession\n    22→\n    23→from backend.config import settings\n    24→from backend.database import get_db\n    25→from backend.api.auth import get_current_user\n    26→from backend.models.auth import User\n    27→from backend.models.discovery import Candidate\n    28→\n    29→logger = structlog.get_logger(__name__)\n    30→router = APIRouter()\n    31→\n    32→\n    33→# ─── Schemas ─────────────────────────────────────────────────────────────────\n    34→\n    35→class ResumeUploadResponse(BaseModel):\n    36→    \"\"\"Response after uploading and parsing a resume.\"\"\"\n    37→    message: str\n    38→    candidate_id: str\n    39→    text_length: int\n    40→    preview: str  # First 500 chars of extracted text\n    41→\n    42→\n    43→class ProfilePayload(BaseModel):\n    44→    \"\"\"Candidate profile data from the onboarding wizard.\"\"\"\n    45→    name: str\n    46→    linkedin_url: Optional[str] = None\n    47→    github_url: Optional[str] = None\n    48→    personal_context: Optional[str] = None\n    49→    target_locations: Optional[list[str]] = None\n    50→    remote_preference: str = \"flexible\"\n    51→    min_compensation: Optional[int] = None\n    52→    excluded_companies: Optional[list[str]] = None\n    53→    excluded_industries: Optional[list[str]] = None\n    54→\n    55→\n    56→class ProfileResponse(BaseModel):\n    57→    \"\"\"Response after saving candidate profile.\"\"\"\n    58→    message: str\n    59→    candidate_id: str\n    60→    is_onboarded: bool\n    61→\n    62→\n    63→class OnboardingStatusResponse(BaseModel):\n    64→    \"\"\"Current onboarding status.\"\"\"\n    65→    is_onboarded: bool\n    66→    has_resume: bool\n    67→    has_profile: bool\n    68→    candidate_id: Optional[str] = None\n    69→\n    70→\n    71→# ─── PDF Text Extraction ────────────────────────────────────────────────────\n    72→\n    73→def extract_text_from_pdf(pdf_bytes: bytes) -> str:\n    74→    \"\"\"Extract text content from a PDF file using PyMuPDF.\"\"\"\n    75→    import fitz  # PyMuPDF\n    76→\n    77→    text_parts = []\n    78→    with fitz.open(stream=pdf_bytes, filetype=\"pdf\") as doc:\n    79→        for page in doc:\n    80→            text_parts.append(page.get_text())\n    81→\n    82→    full_text = \"\\n\".join(text_parts).strip()\n    83→    if not full_text:\n    84→        raise ValueError(\"Could not extract any text from the PDF\")\n    85→    return full_text\n    86→\n    87→\n    88→# ─── Endpoints ───────────────────────────────────────────────────────────────\n    89→\n    90→@router.post(\"/resume\", response_model=ResumeUploadResponse)\n    91→async def upload_resume(\n    92→    file: UploadFile = File(...),\n    93→    current_user: User = Depends(get_current_user),\n    94→    db: AsyncSession = Depends(get_db),\n    95→):\n    96→    \"\"\"\n    97→    Upload a resume PDF. Extracts text and creates/updates the candidate record.\n    98→\n    99→    Accepts: application/pdf\n   100→    Max size: 10MB\n   101→    \"\"\"\n   102→    # Validate file type\n   103→    if not file.content_type or \"pdf\" not in file.content_type.lower():\n   104→        raise HTTPException(\n   105→            status_code=422,\n   106→            detail=\"Only PDF files are accepted. Please upload a .pdf file.\",\n   107→        )\n   108→\n   109→    # Read file contents\n   110→    contents = await file.read()\n   111→    if len(contents) > 10 * 1024 * 1024:  # 10MB limit\n   112→        raise HTTPException(status_code=422, detail=\"File too large. Max 10MB.\")\n   113→\n   114→    # Extract text from PDF\n   115→    try:\n   116→        resume_text = extract_text_from_pdf(contents)\n   117→    except ValueError as e:\n   118→        raise HTTPException(status_code=422, detail=str(e))\n   119→    except Exception as e:\n   120→        logger.error(\"onboarding.pdf_extraction_failed\", error=str(e))\n   121→        raise HTTPException(\n   122→            status_code=500,\n   123→            detail=\"Failed to extract text from PDF. Please try a different file.\",\n   124→        )\n   125→\n   126→    # Find or create candidate record\n   127→    result = await db.execute(\n   128→        select(Candidate).where(Candidate.email == current_user.email)\n   129→    )\n   130→    candidate = result.scalar_one_or_none()\n   131→\n   132→    if candidate:\n   133→        candidate.resume_text = resume_text\n   134→    else:\n   135→        candidate = Candidate(\n   136→            email=current_user.email,\n   137→            name=current_user.name or current_user.email.split(\"@\")[0],\n   138→            resume_text=resume_text,\n   139→        )\n   140→        db.add(candidate)\n   141→        await db.flush()\n   142→\n   143→    # Link user to candidate\n   144→    current_user.candidate_id = candidate.id\n   145→    await db.commit()\n   146→\n   147→    logger.info(\n   148→        \"onboarding.resume_uploaded\",\n   149→        user_id=str(current_user.id),\n   150→        candidate_id=str(candidate.id),\n   151→        text_length=len(resume_text),\n   152→    )\n   153→\n   154→    return ResumeUploadResponse(\n   155→        message=\"Resume uploaded and parsed successfully\",\n   156→        candidate_id=str(candidate.id),\n   157→        text_length=len(resume_text),\n   158→        preview=resume_text[:500],\n   159→    )\n   160→\n   161→\n   162→@router.post(\"/profile\", response_model=ProfileResponse)\n   163→async def save_profile(\n   164→    payload: ProfilePayload,\n   165→    current_user: User = Depends(get_current_user),\n   166→    db: AsyncSession = Depends(get_db),\n   167→):\n   168→    \"\"\"\n   169→    Save candidate profile and preferences from the onboarding wizard.\n   170→\n   171→    Requires resume to be uploaded first (candidate record must exist).\n   172→    \"\"\"\n   173→    if not current_user.candidate_id:\n   174→        raise HTTPException(\n   175→            status_code=400,\n   176→            detail=\"Please upload your resume first before completing your profile.\",\n   177→        )\n   178→\n   179→    result = await db.execute(\n   180→        select(Candidate).where(Candidate.id == current_user.candidate_id)\n   181→    )\n   182→    candidate = result.scalar_one_or_none()\n   183→    if not candidate:\n   184→        raise HTTPException(status_code=404, detail=\"Candidate record not found\")\n   185→\n   186→    # Update candidate fields\n   187→    candidate.name = payload.name\n   188→    candidate.linkedin_url = payload.linkedin_url\n   189→    candidate.github_url = payload.github_url\n   190→    candidate.personal_context = payload.personal_context\n   191→    candidate.target_locations = payload.target_locations\n   192→    candidate.remote_preference = payload.remote_preference\n   193→    candidate.min_compensation = payload.min_compensation\n   194→    candidate.excluded_companies = payload.excluded_companies\n   195→    candidate.excluded_industries = payload.excluded_industries\n   196→\n   197→    # Update user\n   198→    current_user.name = payload.name\n   199→    current_user.is_onboarded = True\n   200→\n   201→    await db.commit()\n   202→\n   203→    logger.info(\n   204→        \"onboarding.profile_saved\",\n   205→        user_id=str(current_user.id),\n   206→        candidate_id=str(candidate.id),\n   207→    )\n   208→\n   209→    return ProfileResponse(\n   210→        message=\"Profile saved. You're all set!\",\n   211→        candidate_id=str(candidate.id),\n   212→        is_onboarded=True,\n   213→    )\n   214→\n   215→\n   216→@router.get(\"/status\", response_model=OnboardingStatusResponse)\n   217→async def get_onboarding_status(\n   218→    current_user: User = Depends(get_current_user),\n   219→    db: AsyncSession = Depends(get_db),\n   220→):\n   221→    \"\"\"Check the current user's onboarding completion status.\"\"\"\n   222→    has_resume = False\n   223→    candidate_id = None\n   224→\n   225→    if current_user.candidate_id:\n   226→        result = await db.execute(\n   227→            select(Candidate).where(Candidate.id == current_user.candidate_id)\n   228→        )\n   229→        candidate = result.scalar_one_or_none()\n   230→        if candidate:\n   231→            has_resume = bool(candidate.resume_text)\n   232→            candidate_id = str(candidate.id)\n   233→\n   234→    return OnboardingStatusResponse(\n   235→        is_onboarded=current_user.is_onboarded,\n   236→        has_resume=has_resume,\n   237→        has_profile=current_user.is_onboarded,\n   238→        candidate_id=candidate_id,\n   239→    )\n   240→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"3abdcdb3-ba6e-4956-81cd-bfbde81bb346","uuid":"44710cd4-85ff-4138-82d5-ee06c8605097","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/api/onboarding.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nOnboarding API — resume upload and candidate profile creation.\n\nPOST  /onboarding/resume       → upload resume PDF, extract text\nPOST  /onboarding/profile      → save candidate profile + preferences\nGET   /onboarding/status       → check onboarding completion status\n\"\"\"\n\nimport uuid\nimport os\nimport tempfile\nfrom typing import Optional\n\nimport structlog\nfrom fastapi import APIRouter, Depends, HTTPException, UploadFile, File\nfrom pydantic import BaseModel\nfrom sqlalchemy import select\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom backend.config import settings\nfrom backend.database import get_db\nfrom backend.api.auth import get_current_user\nfrom backend.models.auth import User\nfrom backend.models.discovery import Candidate\n\nlogger = structlog.get_logger(__name__)\nrouter = APIRouter()\n\n\n# ─── Schemas ─────────────────────────────────────────────────────────────────\n\nclass ResumeUploadResponse(BaseModel):\n    \"\"\"Response after uploading and parsing a resume.\"\"\"\n    message: str\n    candidate_id: str\n    text_length: int\n    preview: str  # First 500 chars of extracted text\n\n\nclass ProfilePayload(BaseModel):\n    \"\"\"Candidate profile data from the onboarding wizard.\"\"\"\n    name: str\n    linkedin_url: Optional[str] = None\n    github_url: Optional[str] = None\n    personal_context: Optional[str] = None\n    target_locations: Optional[list[str]] = None\n    remote_preference: str = \"flexible\"\n    min_compensation: Optional[int] = None\n    excluded_companies: Optional[list[str]] = None\n    excluded_industries: Optional[list[str]] = None\n\n\nclass ProfileResponse(BaseModel):\n    \"\"\"Response after saving candidate profile.\"\"\"\n    message: str\n    candidate_id: str\n    is_onboarded: bool\n\n\nclass OnboardingStatusResponse(BaseModel):\n    \"\"\"Current onboarding status.\"\"\"\n    is_onboarded: bool\n    has_resume: bool\n    has_profile: bool\n    candidate_id: Optional[str] = None\n\n\n# ─── PDF Text Extraction ────────────────────────────────────────────────────\n\ndef extract_text_from_pdf(pdf_bytes: bytes) -> str:\n    \"\"\"Extract text content from a PDF file using PyMuPDF.\"\"\"\n    import fitz  # PyMuPDF\n\n    text_parts = []\n    with fitz.open(stream=pdf_bytes, filetype=\"pdf\") as doc:\n        for page in doc:\n            text_parts.append(page.get_text())\n\n    full_text = \"\\n\".join(text_parts).strip()\n    if not full_text:\n        raise ValueError(\"Could not extract any text from the PDF\")\n    return full_text\n\n\n# ─── Endpoints ───────────────────────────────────────────────────────────────\n\n@router.post(\"/resume\", response_model=ResumeUploadResponse)\nasync def upload_resume(\n    file: UploadFile = File(...),\n    current_user: User = Depends(get_current_user),\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"\n    Upload a resume PDF. Extracts text and creates/updates the candidate record.\n\n    Accepts: application/pdf\n    Max size: 10MB\n    \"\"\"\n    # Validate file type\n    if not file.content_type or \"pdf\" not in file.content_type.lower():\n        raise HTTPException(\n            status_code=422,\n            detail=\"Only PDF files are accepted. Please upload a .pdf file.\",\n        )\n\n    # Read file contents\n    contents = await file.read()\n    if len(contents) > 10 * 1024 * 1024:  # 10MB limit\n        raise HTTPException(status_code=422, detail=\"File too large. Max 10MB.\")\n\n    # Extract text from PDF\n    try:\n        resume_text = extract_text_from_pdf(contents)\n    except ValueError as e:\n        raise HTTPException(status_code=422, detail=str(e))\n    except Exception as e:\n        logger.error(\"onboarding.pdf_extraction_failed\", error=str(e))\n        raise HTTPException(\n            status_code=500,\n            detail=\"Failed to extract text from PDF. Please try a different file.\",\n        )\n\n    # Find or create candidate record\n    result = await db.execute(\n        select(Candidate).where(Candidate.email == current_user.email)\n    )\n    candidate = result.scalar_one_or_none()\n\n    if candidate:\n        candidate.resume_text = resume_text\n    else:\n        candidate = Candidate(\n            email=current_user.email,\n            name=current_user.name or current_user.email.split(\"@\")[0],\n            resume_text=resume_text,\n        )\n        db.add(candidate)\n        await db.flush()\n\n    # Link user to candidate\n    current_user.candidate_id = candidate.id\n    await db.commit()\n\n    logger.info(\n        \"onboarding.resume_uploaded\",\n        user_id=str(current_user.id),\n        candidate_id=str(candidate.id),\n        text_length=len(resume_text),\n    )\n\n    return ResumeUploadResponse(\n        message=\"Resume uploaded and parsed successfully\",\n        candidate_id=str(candidate.id),\n        text_length=len(resume_text),\n        preview=resume_text[:500],\n    )\n\n\n@router.post(\"/profile\", response_model=ProfileResponse)\nasync def save_profile(\n    payload: ProfilePayload,\n    current_user: User = Depends(get_current_user),\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"\n    Save candidate profile and preferences from the onboarding wizard.\n\n    Requires resume to be uploaded first (candidate record must exist).\n    \"\"\"\n    if not current_user.candidate_id:\n        raise HTTPException(\n            status_code=400,\n            detail=\"Please upload your resume first before completing your profile.\",\n        )\n\n    result = await db.execute(\n        select(Candidate).where(Candidate.id == current_user.candidate_id)\n    )\n    candidate = result.scalar_one_or_none()\n    if not candidate:\n        raise HTTPException(status_code=404, detail=\"Candidate record not found\")\n\n    # Update candidate fields\n    candidate.name = payload.name\n    candidate.linkedin_url = payload.linkedin_url\n    candidate.github_url = payload.github_url\n    candidate.personal_context = payload.personal_context\n    candidate.target_locations = payload.target_locations\n    candidate.remote_preference = payload.remote_preference\n    candidate.min_compensation = payload.min_compensation\n    candidate.excluded_companies = payload.excluded_companies\n    candidate.excluded_industries = payload.excluded_industries\n\n    # Update user\n    current_user.name = payload.name\n    current_user.is_onboarded = True\n\n    await db.commit()\n\n    logger.info(\n        \"onboarding.profile_saved\",\n        user_id=str(current_user.id),\n        candidate_id=str(candidate.id),\n    )\n\n    return ProfileResponse(\n        message=\"Profile saved. You're all set!\",\n        candidate_id=str(candidate.id),\n        is_onboarded=True,\n    )\n\n\n@router.get(\"/status\", response_model=OnboardingStatusResponse)\nasync def get_onboarding_status(\n    current_user: User = Depends(get_current_user),\n    db: AsyncSession = Depends(get_db),\n):\n    \"\"\"Check the current user's onboarding completion status.\"\"\"\n    has_resume = False\n    candidate_id = None\n\n    if current_user.candidate_id:\n        result = await db.execute(\n            select(Candidate).where(Candidate.id == current_user.candidate_id)\n        )\n        candidate = result.scalar_one_or_none()\n        if candidate:\n            has_resume = bool(candidate.resume_text)\n            candidate_id = str(candidate.id)\n\n    return OnboardingStatusResponse(\n        is_onboarded=current_user.is_onboarded,\n        has_resume=has_resume,\n        has_profile=current_user.is_onboarded,\n        candidate_id=candidate_id,\n    )\n","numLines":240,"startLine":1,"totalLines":240}}}}
