r_default=func.now(), onupdate=func.now(), nullable=False\n    92→    )\n    93→\n    94→    # Relationships\n    95→    crawl_runs: Mapped[list[\"CrawlRun\"]] = relationship(\n    96→        back_populates=\"candidate\", cascade=\"all, delete-orphan\"\n    97→    )\n    98→    daily_digests: Mapped[list[\"DailyDigest\"]] = relationship(\n    99→        back_populates=\"candidate\", cascade=\"all, delete-orphan\"\n   100→    )\n   101→    scored_jobs: Mapped[list[\"ScoredJob\"]] = relationship(\n   102→        back_populates=\"candidate\", cascade=\"all, delete-orphan\"\n   103→    )\n   104→\n   105→\n   106→# ─── Discovered Job ──────────────────────────────────────────────────────────\n   107→\n   108→class DiscoveredJob(Base):\n   109→    \"\"\"A raw job posting discovered during a crawl run.\"\"\"\n   110→\n   111→    __tablename__ = \"discovered_jobs\"\n   112→\n   113→    id: Mapped[uuid.UUID] = mapped_column(\n   114→        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n   115→    )\n   116→    source: Mapped[JobSource] = mapped_column(\n   117→        Enum(JobSource, name=\"job_source\", create_type=False), nullable=False\n   118→    )\n   119→    source_id: Mapped[str] = mapped_column(String(255), nullable=False)\n   120→    title: Mapped[str] = mapped_column(String(500), nullable=False)\n   121→    company: Mapped[str] = mapped_column(String(255), nullable=False)\n   122→    location: Mapped[Optional[str]] = mapped_column(String(255))\n   123→    description: Mapped[Optional[str]] = mapped_column(Text)\n   124→    url: Mapped[str] = mapped_column(String(1000), nullable=False)\n   125→    posted_at: Mapped[Optional[datetime]] = mapped_column(DateTime(timezone=True))\n   126→    salary_min: Mapped[Optional[int]] = mapped_column(Integer)\n   127→    salary_max: Mapped[Optional[int]] = mapped_column(Integer)\n   128→    remote: Mapped[bool] = mapped_column(Boolean, server_default=\"false\", nullable=False)\n   129→    crawled_at: Mapped[datetime] 