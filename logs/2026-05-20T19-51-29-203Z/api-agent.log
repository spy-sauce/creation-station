m.Enum):\n    49→    \"\"\"Contact confidence level.\"\"\"\n    50→    HIGH = \"HIGH\"\n    51→    MEDIUM = \"MEDIUM\"\n    52→    LOW = \"LOW\"\n    53→\n    54→\n    55→class OutreachStatus(str, enum.Enum):\n    56→    \"\"\"Outreach email status.\"\"\"\n    57→    DRAFT = \"DRAFT\"\n    58→    SENT = \"SENT\"\n    59→    BOUNCED = \"BOUNCED\"\n    60→    REPLIED = \"REPLIED\"\n    61→\n    62→\n    63→# ─── Parsed JD ───────────────────────────────────────────────────────────────\n    64→\n    65→class ParsedJD(Base):\n    66→    \"\"\"Cached structured parse of a job description.\"\"\"\n    67→\n    68→    __tablename__ = \"parsed_jds\"\n    69→\n    70→    id: Mapped[uuid.UUID] = mapped_column(\n    71→        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n    72→    )\n    73→    job_id: Mapped[uuid.UUID] = mapped_column(\n    74→        ForeignKey(\"discovered_jobs.id\", ondelete=\"CASCADE\"),\n    75→        unique=True,\n    76→        nullable=False,\n    77→    )\n    78→    required_skills: Mapped[list[str]] = mapped_column(\n    79→        ARRAY(String), server_default=\"{}\", nullable=False\n    80→    )\n    81→    preferred_skills: Mapped[list[str]] = mapped_column(\n    82→        ARRAY(String), server_default=\"{}\", nullable=False\n    83→    )\n    84→    seniority_level: Mapped[Optional[str]] = mapped_column(String(100))\n    85→    tech_stack: Mapped[list[str]] = mapped_column(\n    86→        ARRAY(String), server_default=\"{}\", nullable=False\n    87→    )\n    88→    culture_signals: Mapped[list[str]] = mapped_column(\n    89→        ARRAY(String), server_default=\"{}\", nullable=False\n    90→    )\n    91→    tone: Mapped[Optional[str]] = mapped_column(String(50))\n    92→    pain_points: Mapped[list[str]] = mapped_column(\n    93→        ARRAY(String), server_default=\"{}\", nullable=False\n    94→    )\n    95→    compensation_range: Mapped[Optional[str]] = mapped_column(String(255))\n    96→    red_flags: Mapped[list[str]] = mapped_column(\n    97→        ARRAY(String), server_default=\"{}\", nullable=False\n    98→    )\n    99→    application_instructions: Mapped[Optional[str]] = mapped_column(Text)\n   100→    parsed_at: Mapped[datetime] = mapped_column(\n   101→        DateTime(timezone=True), server_default=func.now(), nullable=False\n   102→    )\n   103→    created_at: Mapped[datetime] = mapped_column(\n   104→        DateTime(timezone=True), server_default=func.now(), nullable=False\n   105→    )\n   106→\n   107→\n   108→# ─── Application Pipeline ────────────────────────────────────────────────────\n   109→\n   110→class ApplicationPipeline(Base):\n   111→    \"\"\"Full pipeline state for a single job application.\"\"\"\n   112→\n   113→    __tablename__ = \"application_pipelines\"\n   114→\n   115→    id: Mapped[uuid.UUID] = mapped_column(\n   116→        UUID(as_uuid=True), primary_key=True, default=uuid.uuid4\n   117→    )\n   118→    candidate_id: Mapped[uuid.UUID] = mapped_column(\n   119→        ForeignKey(\"candidates.id\", ondelete=\"CASCADE\"), nullable=False\n   120→    )\n   121→    job_id: Mapped[uuid.UUID] = mapped_column(\n   122→        ForeignKey(\"scored_jobs.id\", ondelete=\"CASCADE\"), nullable=False\n   123→    )\n   124→    status: Mapped[ApplicationPipelineStatus] = mapped_column(\n   125→        Enum(ApplicationPipelineStatus, name=\"application_pipeline_status\", create_type=False),\n   126→        server_default=\"QUEUED\",\n   127→        nullable=False,\n   128→    )\n   129→    approval_timestamp: Mapped[Optional[datetime]] = mapped_column(DateTime(timezone=True))\n   130→    submitted_at: Mapped[Optional[datetime]] = mapped_column(DateTime(timezone=True))\n   131→    screenshots: Mapped[list[str]] = mapped_column(\n   132→        ARRAY(String), server_default=\"{}\", nullable=False\n   133→    )\n   134→    created_at: Mapped[datetime] = mapped_column(\n   135→        DateTime(timezone=True), server_default=func.now(), nullable=False\n   136→    )