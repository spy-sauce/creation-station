{"t":"2026-05-20T20:02:25.879Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KqSpXGcRJdBmJaeBryQzmV","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Relevance Scorer — scores each discovered job against the candidate's identity profile.\n     6→\n     7→Scoring dimensions (each 0–100):\n     8→  technical_match   30%  — skills overlap between JD and candidate profile\n     9→  level_match       20%  — seniority alignment (penalise over AND under)\n    10→  culture_match     15%  — startup/enterprise, remote, mission alignment\n    11→  industry_match    15%  — domain expertise alignment\n    12→  growth_potential  10%  — does this expand the candidate's trajectory?\n    13→  compensation_match 10% — estimated band vs candidate target\n    14→\n    15→Claude parses the JD. Math runs locally. Claude writes 2-sentence reasoning.\n    16→\"\"\"\n    17→\n    18→import json\n    19→import re\n    20→from typing import Optional\n    21→\n    22→import structlog\n    23→from anthropic import AsyncAnthropic\n    24→from tenacity import retry, stop_after_attempt, wait_exponential\n    25→\n    26→from backend.config import settings\n    27→from backend.agents.discovery.schemas import (\n    28→    IdentityProfile,\n    29→    DiscoveredJobSchema,\n    30→    ScoredJobSchema,\n    31→    ScoreBreakdown,\n    32→)\n    33→\n    34→logger = structlog.get_logger(__name__)\n    35→\n    36→# Seniority levels for level_match scoring — lower index = more junior\n    37→_SENIORITY_LADDER = [\n    38→    \"intern\", \"junior\", \"associate\", \"mid\", \"senior\", \"staff\",\n    39→    \"principal\", \"lead\", \"manager\", \"director\", \"vp\", \"svp\",\n    40→    \"head\", \"cto\", \"coo\", \"ceo\", \"founder\", \"exec\",\n    41→]\n    42→\n    43→_LEADERSHIP_TO_LADDER = {\n    44→    \"ic\": \"senior\",\n    45→    \"lead\": \"lead\",\n    46→    \"staff\": \"staff\",\n    47→    \"principal\": \"principal\",\n    48→    \"founder\": \"founder\",\n    49→    \"exec\": \"vp\",\n    50→}\n    51→\n    52→_REMOTE_KEYWORD_MAP = {\n    53→    \"remote\": [\"remote\", \"distributed\", \"anywhere\", \"work from home\", \"wfh\"],\n    54→    \"hybrid\": [\"hybrid\", \"flexible\"],\n    55→    \"onsite\": [\"on-site\", \"onsite\", \"in-office\", \"in office\", \"office required\"],\n    56→}\n    57→\n    58→\n    59→class RelevanceScorer:\n    60→    \"\"\"\n    61→    Scores discovered jobs against a candidate's identity profile.\n    62→\n    63→    Uses Claude to parse JD requirements and generate reasoning.\n    64→    Scoring math runs locally — no LLM needed for the numbers.\n    65→    \"\"\"\n    66→\n    67→    def __init__(self, anthropic_client: AsyncAnthropic):\n    68→        self._claude = anthropic_client\n    69→\n    70→    async def score_batch(\n    71→        self,\n    72→        jobs: list[DiscoveredJobSchema],\n    73→        profile: IdentityProfile,\n    74→        min_score: int = 60,\n    75→    ) -> list[ScoredJobSchema]:\n    76→        \"\"\"\n    77→        Score a batch of discovered jobs, filtering out those below min_score.\n    78→\n    79→        Args:\n    80→            jobs: Raw discovered jobs to score\n    81→            profile: Candidate identity profile\n    82→            min_score: Jobs below this composite score are discarded\n    83→\n    84→        Returns:\n    85→            Sorted list of ScoredJobSchema, highest composite first\n    86→        \"\"\"\n    87→        logger.info(\n    88→            \"relevance_scorer.batch_start\",\n    89→            job_count=len(jobs),\n    90→            min_score=min_score,\n    91→        )\n    92→\n    93→        scored: list[ScoredJobSchema] = []\n    94→        for job in jobs:\n    95→            try:\n    96→                result = await self.score_job(job, profile)\n    97→                if result.composite_score >= min_score:\n    98→                    scored.append(result)\n    99→            except Exception as e:\n   100→                logger.error(\n   101→                    \"relevance_scorer.job_error\",\n   102→                    job_url=job.url,\n   103→                    error=str(e),\n   104→                )\n   105→\n   106→        scored.sort(key=lambda s: s.composite_score, reverse=True)\n   107→        logger.info(\n   108→            \"relevance_scorer.batch_complete\",\n   109→            scored=len(scored),\n   110→            filtered_out=len(jobs) - len(scored),\n   111→        )\n   112→        return scored\n   113→\n   114→    async def score_job(self, job: DiscoveredJobSchema, profile: IdentityProfile) -> ScoredJobSchema:\n   115→        \"\"\"\n   116→        Score a single job against the identity profile.\n   117→\n   118→        Args:\n   119→            job: Discovered job\n   120→            profile: Candidate identity profile\n   121→\n   122→        Returns:\n   123→            ScoredJobSchema with full breakdown and reasoning\n   124→        \"\"\"\n   125→        parsed_jd = await self._parse_jd(job)\n   126→        scores = self._compute_scores(parsed_jd, profile, job)\n   127→        composite = scores.composite\n   128→        reasoning = await self._generate_reasoning(job, profile, scores, composite)\n   129→\n   130→        return ScoredJobSchema(\n   131→            job=job,\n   132→            scores=scores,\n   133→            composite_score=composite,\n   134→            reasoning=reasoning,\n   135→            is_hot=composite >= 80,\n   136→        )\n   137→\n   138→    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n   139→    async def _parse_jd(self, job: DiscoveredJobSchema) -> dict:\n   140→        \"\"\"Use Claude to extract structured requirements from a job description.\"\"\"\n   141→        if not job.description:\n   142→            return {}\n   143→\n   144→        prompt = f\"\"\"Extract structured data from this job description. Return ONLY valid JSON, no markdown:\n   145→\n   146→Job Title: {job.title}\n   147→Company: {job.company}\n   148→Location: {job.location or \"Not specified\"}\n   149→\n   150→Description:\n   151→{job.description[:3000]}\n   152→\n   153→Return this exact JSON structure:\n   154→{{\n   155→  \"required_skills\": [\"<skill1>\", \"<skill2>\"],\n   156→  \"preferred_skills\": [\"<skill1>\"],\n   157→  \"seniority_level\": \"<intern|junior|mid|senior|staff|principal|lead|manager|director|vp|head|exec>\",\n   158→  \"remote_type\": \"<remote|hybrid|onsite|flexible>\",\n   159→  \"industries\": [\"<industry1>\"],\n   160→  \"comp_mentioned\": \"<salary string or null>\",\n   161→  \"culture_signals\": {{\n   162→    \"startup_vs_enterprise\": \"<startup|enterprise|both>\",\n   163→    \"mission_driven\": <true|false>\n   164→  }},\n   165→  \"growth_indicators\": [\"<indicator1>\"]\n   166→}}\"\"\"\n   167→\n   168→        response = await self._claude.messages.create(\n   169→            model=\"claude-sonnet-4-20250514\",\n   170→            max_tokens=1024,\n   171→            messages=[{\"role\": \"user\", \"content\": prompt}],\n   172→        )\n   173→\n   174→        raw = response.content[0].text.strip()\n   175→        try:\n   176→            return json.loads(raw)\n   177→        except json.JSONDecodeError:\n   178→            match = re.search(r\"\\{.*\\}\", raw, re.DOTALL)\n   179→            return json.loads(match.group()) if match else {}\n   180→\n   181→    def _compute_scores(\n   182→        self, parsed_jd: dict, profile: IdentityProfile, job: DiscoveredJobSchema\n   183→    ) -> ScoreBreakdown:\n   184→        \"\"\"Compute all six scoring dimensions locally.\"\"\"\n   185→        return ScoreBreakdown(\n   186→            technical_match=self._score_technical(parsed_jd, profile),\n   187→            level_match=self._score_level(parsed_jd, profile),\n   188→            culture_match=self._score_culture(parsed_jd, profile, job),\n   189→            industry_match=self._score_industry(parsed_jd, profile),\n   190→            growth_potential=self._score_growth(parsed_jd, profile),\n   191→            compensation_match=self._score_compensation(parsed_jd, profile),\n   192→        )\n   193→\n   194→    def _score_technical(self, parsed_jd: dict, profile: IdentityProfile) -> int:\n   195→        \"\"\"Score based on skills overlap between JD requirements and candidate skills.\"\"\"\n   196→        required = {s.lower() for s in parsed_jd.get(\"required_skills\", [])}\n   197→        preferred = {s.lower() for s in parsed_jd.get(\"preferred_skills\", [])}\n   198→        candidate_skills = {s.lower() for s in profile.technical_skills.keys()}\n   199→\n   200→        if not required:\n   201→            return 60  # No requirements listed — neutral score\n   202→\n   203→        required_hits = len(required & candidate_skills)\n   204→        preferred_hits = len(preferred & candidate_skills)\n   205→\n   206→        required_ratio = required_hits / len(required) if required else 0\n   207→        preferred_bonus = min(20, preferred_hits * 4) if preferred else 0\n   208→\n   209→        base = int(required_ratio * 80)\n   210→        return min(100, base + preferred_bonus)\n   211→\n   212→    def _score_level(self, parsed_jd: dict, profile: IdentityProfile) -> int:\n   213→        \"\"\"Score seniority alignment — penalise both under and over.\"\"\"\n   214→        jd_level = parsed_jd.get(\"seniority_level\", \"\").lower()\n   215→        candidate_level = _LEADERSHIP_TO_LADDER.get(profile.leadership_level, \"senior\")\n   216→\n   217→        try:\n   218→            jd_idx = _SENIORITY_LADDER.index(jd_level)\n   219→        except ValueError:\n   220→            return 70  # Unknown level — generous neutral\n   221→\n   222→        try:\n   223→            candidate_idx = _SENIORITY_LADDER.index(candidate_level)\n   224→        except ValueError:\n   225→            return 70\n   226→\n   227→        diff = abs(jd_idx - candidate_idx)\n   228→        if diff == 0:\n   229→            return 100\n   230→        elif diff == 1:\n   231→            return 80\n   232→        elif diff == 2:\n   233→            return 55\n   234→        elif diff == 3:\n   235→            return 30\n   236→        else:\n   237→            return 10\n   238→\n   239→    def _score_culture(\n   240→        self, parsed_jd: dict, profile: IdentityProfile, job: DiscoveredJobSchema\n   241→    ) -> int:\n   242→        \"\"\"Score culture alignment: startup/enterprise + remote preference.\"\"\"\n   243→        score = 60  # default neutral\n   244→\n   245→        # Startup vs enterprise alignment\n   246→        jd_type = parsed_jd.get(\"culture_signals\", {}).get(\"startup_vs_enterprise\", \"\")\n   247→        candidate_pref = profile.culture_signals.get(\"startup_vs_enterprise\", \"both\")\n   248→        if jd_type and candidate_pref != \"both\":\n   249→            if jd_type == candidate_pref:\n   250→                score += 20\n   251→            else:\n   252→                score -= 20\n   253→\n   254→        # Remote alignment\n   255→        jd_remote = parsed_jd.get(\"remote_type\", \"\")\n   256→        candidate_remote = profile.culture_signals.get(\"remote_preference\", \"flexible\")\n   257→        if jd_remote and candidate_remote != \"flexible\":\n   258→            if jd_remote == candidate_remote:\n   259→                score += 20\n   260→            elif jd_remote == \"onsite\" and candidate_remote == \"remote\":\n   261→                score -= 30\n   262→            else:\n   263→                score -= 10\n   264→\n   265→        return max(0, min(100, score))\n   266→\n   267→    def _score_industry(self, parsed_jd: dict, profile: IdentityProfile) -> int:\n   268→        \"\"\"Score how well the job's industries align with the candidate's domain expertise.\"\"\"\n   269→        jd_industries = {i.lower() for i in parsed_jd.get(\"industries\", [])}\n   270→        candidate_domains = {d.lower() for d in profile.domain_expertise}\n   271→\n   272→        if not jd_industries:\n   273→            return 60\n   274→\n   275→        overlap = len(jd_industries & candidate_domains)\n   276→        if overlap >= 2:\n   277→            return 100\n   278→        elif overlap == 1:\n   279→            return 75\n   280→        else:\n   281→            return 35\n   282→\n   283→    def _score_growth(self, parsed_jd: dict, profile: IdentityProfile) -> int:\n   284→        \"\"\"Score whether this role expands the candidate's trajectory.\"\"\"\n   285→        indicators = parsed_jd.get(\"growth_indicators\", [])\n   286→        growth_keywords = {\n   287→            \"build from scratch\", \"greenfield\", \"founding\", \"new team\",\n   288→            \"technical strategy\", \"shape the\", \"lead the\", \"define the\",\n   289→            \"architect\", \"platform\", \"0 to 1\",\n   290→        }\n   291→\n   292→        indicator_text = \" \".join(indicators).lower()\n   293→        matches = sum(1 for kw in growth_keywords if kw in indicator_text)\n   294→\n   295→        if matches >= 3:\n   296→            return 90\n   297→        elif matches >= 1:\n   298→            return 70\n   299→        else:\n   300→            return 50\n   301→\n   302→    def _score_compensation(self, parsed_jd: dict, profile: IdentityProfile) -> int:\n   303→        \"\"\"Score comp alignment — generous when comp isn't mentioned (common for senior roles).\"\"\"\n   304→        comp_str = parsed_jd.get(\"comp_mentioned\")\n   305→        if not comp_str:\n   306→            return 75  # No comp listed is common for senior/exec roles — assume competitive\n   307→\n   308→        # Extract numbers from comp string\n   309→        numbers = re.findall(r\"\\d[\\d,]*\", comp_str.replace(\",\", \"\"))\n   310→        if not numbers:\n   311→            return 70\n   312→\n   313→        amounts = [int(n) for n in numbers if len(n) <= 7]  # filter out noise\n   314→        if not amounts:\n   315→            return 70\n   316→\n   317→        jd_max = max(amounts)\n   318→        # Normalize to annual if looks like monthly (< 20000)\n   319→        if jd_max < 20_000:\n   320→            jd_max *= 12\n   321→\n   322→        candidate_min = profile.compensation_band.get(\"min\", 0)\n   323→        if candidate_min == 0:\n   324→            return 70\n   325→\n   326→        if jd_max >= candidate_min:\n   327→            return 100\n   328→        elif jd_max >= candidate_min * 0.85:\n   329→            return 70\n   330→        elif jd_max >= candidate_min * 0.70:\n   331→            return 40\n   332→        else:\n   333→            return 15\n   334→\n   335→    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n   336→    async def _generate_reasoning(\n   337→        self,\n   338→        job: DiscoveredJobSchema,\n   339→        profile: IdentityProfile,\n   340→        scores: ScoreBreakdown,\n   341→        composite: int,\n   342→    ) -> str:\n   343→        \"\"\"Generate a 2-sentence human-readable reasoning string via Claude.\"\"\"\n   344→        prompt = f\"\"\"You are writing a brief explanation for why a job matches a candidate in a talent agent digest.\n   345→\n   346→Candidate archetype tags: {\", \".join(profile.archetype_tags)}\n   347→Job: {job.title} at {job.company} ({job.location or \"location TBD\"})\n   348→Composite score: {composite}/100\n   349→\n   350→Score breakdown:\n   351→- Technical match: {scores.technical_match}/100\n   352→- Level match: {scores.level_match}/100\n   353→- Culture match: {scores.culture_match}/100\n   354→- Industry match: {scores.industry_match}/100\n   355→- Growth potential: {scores.growth_potential}/100\n   356→- Compensation match: {scores.compensation_match}/100\n   357→\n   358→Write exactly 2 sentences: one sentence on why this is a strong match, one on the key consideration or risk.\n   359→Be specific. Do not use filler phrases like \"This role offers\" or \"This position presents\". Start with the substance.\n   360→Return only the 2 sentences, no other text.\"\"\"\n   361→\n   362→        response = await self._claude.messages.create(\n   363→            model=\"claude-sonnet-4-20250514\",\n   364→            max_tokens=200,\n   365→            messages=[{\"role\": \"user\", \"content\": prompt}],\n   366→        )\n   367→        return response.content[0].text.strip()\n   368→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"ad28d7e9-1b93-44c5-b07f-443fa223218a","uuid":"aac2a1b2-639e-458f-8f2e-8812e692e1d6","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/discovery/relevance_scorer.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nRelevance Scorer — scores each discovered job against the candidate's identity profile.\n\nScoring dimensions (each 0–100):\n  technical_match   30%  — skills overlap between JD and candidate profile\n  level_match       20%  — seniority alignment (penalise over AND under)\n  culture_match     15%  — startup/enterprise, remote, mission alignment\n  industry_match    15%  — domain expertise alignment\n  growth_potential  10%  — does this expand the candidate's trajectory?\n  compensation_match 10% — estimated band vs candidate target\n\nClaude parses the JD. Math runs locally. Claude writes 2-sentence reasoning.\n\"\"\"\n\nimport json\nimport re\nfrom typing import Optional\n\nimport structlog\nfrom anthropic import AsyncAnthropic\nfrom tenacity import retry, stop_after_attempt, wait_exponential\n\nfrom backend.config import settings\nfrom backend.agents.discovery.schemas import (\n    IdentityProfile,\n    DiscoveredJobSchema,\n    ScoredJobSchema,\n    ScoreBreakdown,\n)\n\nlogger = structlog.get_logger(__name__)\n\n# Seniority levels for level_match scoring — lower index = more junior\n_SENIORITY_LADDER = [\n    \"intern\", \"junior\", \"associate\", \"mid\", \"senior\", \"staff\",\n    \"principal\", \"lead\", \"manager\", \"director\", \"vp\", \"svp\",\n    \"head\", \"cto\", \"coo\", \"ceo\", \"founder\", \"exec\",\n]\n\n_LEADERSHIP_TO_LADDER = {\n    \"ic\": \"senior\",\n    \"lead\": \"lead\",\n    \"staff\": \"staff\",\n    \"principal\": \"principal\",\n    \"founder\": \"founder\",\n    \"exec\": \"vp\",\n}\n\n_REMOTE_KEYWORD_MAP = {\n    \"remote\": [\"remote\", \"distributed\", \"anywhere\", \"work from home\", \"wfh\"],\n    \"hybrid\": [\"hybrid\", \"flexible\"],\n    \"onsite\": [\"on-site\", \"onsite\", \"in-office\", \"in office\", \"office required\"],\n}\n\n\nclass RelevanceScorer:\n    \"\"\"\n    Scores discovered jobs against a candidate's identity profile.\n\n    Uses Claude to parse JD requirements and generate reasoning.\n    Scoring math runs locally — no LLM needed for the numbers.\n    \"\"\"\n\n    def __init__(self, anthropic_client: AsyncAnthropic):\n        self._claude = anthropic_client\n\n    async def score_batch(\n        self,\n        jobs: list[DiscoveredJobSchema],\n        profile: IdentityProfile,\n        min_score: int = 60,\n    ) -> list[ScoredJobSchema]:\n        \"\"\"\n        Score a batch of discovered jobs, filtering out those below min_score.\n\n        Args:\n            jobs: Raw discovered jobs to score\n            profile: Candidate identity profile\n            min_score: Jobs below this composite score are discarded\n\n        Returns:\n            Sorted list of ScoredJobSchema, highest composite first\n        \"\"\"\n        logger.info(\n            \"relevance_scorer.batch_start\",\n            job_count=len(jobs),\n            min_score=min_score,\n        )\n\n        scored: list[ScoredJobSchema] = []\n        for job in jobs:\n            try:\n                result = await self.score_job(job, profile)\n                if result.composite_score >= min_score:\n                    scored.append(result)\n            except Exception as e:\n                logger.error(\n                    \"relevance_scorer.job_error\",\n                    job_url=job.url,\n                    error=str(e),\n                )\n\n        scored.sort(key=lambda s: s.composite_score, reverse=True)\n        logger.info(\n            \"relevance_scorer.batch_complete\",\n            scored=len(scored),\n            filtered_out=len(jobs) - len(scored),\n        )\n        return scored\n\n    async def score_job(self, job: DiscoveredJobSchema, profile: IdentityProfile) -> ScoredJobSchema:\n        \"\"\"\n        Score a single job against the identity profile.\n\n        Args:\n            job: Discovered job\n            profile: Candidate identity profile\n\n        Returns:\n            ScoredJobSchema with full breakdown and reasoning\n        \"\"\"\n        parsed_jd = await self._parse_jd(job)\n        scores = self._compute_scores(parsed_jd, profile, job)\n        composite = scores.composite\n        reasoning = await self._generate_reasoning(job, profile, scores, composite)\n\n        return ScoredJobSchema(\n            job=job,\n            scores=scores,\n            composite_score=composite,\n            reasoning=reasoning,\n            is_hot=composite >= 80,\n        )\n\n    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n    async def _parse_jd(self, job: DiscoveredJobSchema) -> dict:\n        \"\"\"Use Claude to extract structured requirements from a job description.\"\"\"\n        if not job.description:\n            return {}\n\n        prompt = f\"\"\"Extract structured data from this job description. Return ONLY valid JSON, no markdown:\n\nJob Title: {job.title}\nCompany: {job.company}\nLocation: {job.location or \"Not specified\"}\n\nDescription:\n{job.description[:3000]}\n\nReturn this exact JSON structure:\n{{\n  \"required_skills\": [\"<skill1>\", \"<skill2>\"],\n  \"preferred_skills\": [\"<skill1>\"],\n  \"seniority_level\": \"<intern|junior|mid|senior|staff|principal|lead|manager|director|vp|head|exec>\",\n  \"remote_type\": \"<remote|hybrid|onsite|flexible>\",\n  \"industries\": [\"<industry1>\"],\n  \"comp_mentioned\": \"<salary string or null>\",\n  \"culture_signals\": {{\n    \"startup_vs_enterprise\": \"<startup|enterprise|both>\",\n    \"mission_driven\": <true|false>\n  }},\n  \"growth_indicators\": [\"<indicator1>\"]\n}}\"\"\"\n\n        response = await self._claude.messages.create(\n            model=\"claude-sonnet-4-20250514\",\n            max_tokens=1024,\n            messages=[{\"role\": \"user\", \"content\": prompt}],\n        )\n\n        raw = response.content[0].text.strip()\n        try:\n            return json.loads(raw)\n        except json.JSONDecodeError:\n            match = re.search(r\"\\{.*\\}\", raw, re.DOTALL)\n            return json.loads(match.group()) if match else {}\n\n    def _compute_scores(\n        self, parsed_jd: dict, profile: IdentityProfile, job: DiscoveredJobSchema\n    ) -> ScoreBreakdown:\n        \"\"\"Compute all six scoring dimensions locally.\"\"\"\n        return ScoreBreakdown(\n            technical_match=self._score_technical(parsed_jd, profile),\n            level_match=self._score_level(parsed_jd, profile),\n            culture_match=self._score_culture(parsed_jd, profile, job),\n            industry_match=self._score_industry(parsed_jd, profile),\n            growth_potential=self._score_growth(parsed_jd, profile),\n            compensation_match=self._score_compensation(parsed_jd, profile),\n        )\n\n    def _score_technical(self, parsed_jd: dict, profile: IdentityProfile) -> int:\n        \"\"\"Score based on skills overlap between JD requirements and candidate skills.\"\"\"\n        required = {s.lower() for s in parsed_jd.get(\"required_skills\", [])}\n        preferred = {s.lower() for s in parsed_jd.get(\"preferred_skills\", [])}\n        candidate_skills = {s.lower() for s in profile.technical_skills.keys()}\n\n        if not required:\n            return 60  # No requirements listed — neutral score\n\n        required_hits = len(required & candidate_skills)\n        preferred_hits = len(preferred & candidate_skills)\n\n        required_ratio = required_hits / len(required) if required else 0\n        preferred_bonus = min(20, preferred_hits * 4) if preferred else 0\n\n        base = int(required_ratio * 80)\n        return min(100, base + preferred_bonus)\n\n    def _score_level(self, parsed_jd: dict, profile: IdentityProfile) -> int:\n        \"\"\"Score seniority alignment — penalise both under and over.\"\"\"\n        jd_level = parsed_jd.get(\"seniority_level\", \"\").lower()\n        candidate_level = _LEADERSHIP_TO_LADDER.get(profile.leadership_level, \"senior\")\n\n        try:\n            jd_idx = _SENIORITY_LADDER.index(jd_level)\n        except ValueError:\n            return 70  # Unknown level — generous neutral\n\n        try:\n            candidate_idx = _SENIORITY_LADDER.index(candidate_level)\n        except ValueError:\n            return 70\n\n        diff = abs(jd_idx - candidate_idx)\n        if diff == 0:\n            return 100\n        elif diff == 1:\n            return 80\n        elif diff == 2:\n            return 55\n        elif diff == 3:\n            return 30\n        else:\n            return 10\n\n    def _score_culture(\n        self, parsed_jd: dict, profile: IdentityProfile, job: DiscoveredJobSchema\n    ) -> int:\n        \"\"\"Score culture alignment: startup/enterprise + remote preference.\"\"\"\n        score = 60  # default neutral\n\n        # Startup vs enterprise alignment\n        jd_type = parsed_jd.get(\"culture_signals\", {}).get(\"startup_vs_enterprise\", \"\")\n        candidate_pref = profile.culture_signals.get(\"startup_vs_enterprise\", \"both\")\n        if jd_type and candidate_pref != \"both\":\n            if jd_type == candidate_pref:\n                score += 20\n            else:\n                score -= 20\n\n        # Remote alignment\n        jd_remote = parsed_jd.get(\"remote_type\", \"\")\n        candidate_remote = profile.culture_signals.get(\"remote_preference\", \"flexible\")\n        if jd_remote and candidate_remote != \"flexible\":\n            if jd_remote == candidate_remote:\n                score += 20\n            elif jd_remote == \"onsite\" and candidate_remote == \"remote\":\n                score -= 30\n            else:\n                score -= 10\n\n        return max(0, min(100, score))\n\n    def _score_industry(self, parsed_jd: dict, profile: IdentityProfile) -> int:\n        \"\"\"Score how well the job's industries align with the candidate's domain expertise.\"\"\"\n        jd_industries = {i.lower() for i in parsed_jd.get(\"industries\", [])}\n        candidate_domains = {d.lower() for d in profile.domain_expertise}\n\n        if not jd_industries:\n            return 60\n\n        overlap = len(jd_industries & candidate_domains)\n        if overlap >= 2:\n            return 100\n        elif overlap == 1:\n            return 75\n        else:\n            return 35\n\n    def _score_growth(self, parsed_jd: dict, profile: IdentityProfile) -> int:\n        \"\"\"Score whether this role expands the candidate's trajectory.\"\"\"\n        indicators = parsed_jd.get(\"growth_indicators\", [])\n        growth_keywords = {\n            \"build from scratch\", \"greenfield\", \"founding\", \"new team\",\n            \"technical strategy\", \"shape the\", \"lead the\", \"define the\",\n            \"architect\", \"platform\", \"0 to 1\",\n        }\n\n        indicator_text = \" \".join(indicators).lower()\n        matches = sum(1 for kw in growth_keywords if kw in indicator_text)\n\n        if matches >= 3:\n            return 90\n        elif matches >= 1:\n            return 70\n        else:\n            return 50\n\n    def _score_compensation(self, parsed_jd: dict, profile: IdentityProfile) -> int:\n        \"\"\"Score comp alignment — generous when comp isn't mentioned (common for senior roles).\"\"\"\n        comp_str = parsed_jd.get(\"comp_mentioned\")\n        if not comp_str:\n            return 75  # No comp listed is common for senior/exec roles — assume competitive\n\n        # Extract numbers from comp string\n        numbers = re.findall(r\"\\d[\\d,]*\", comp_str.replace(\",\", \"\"))\n        if not numbers:\n            return 70\n\n        amounts = [int(n) for n in numbers if len(n) <= 7]  # filter out noise\n        if not amounts:\n            return 70\n\n        jd_max = max(amounts)\n        # Normalize to annual if looks like monthly (< 20000)\n        if jd_max < 20_000:\n            jd_max *= 12\n\n        candidate_min = profile.compensation_band.get(\"min\", 0)\n        if candidate_min == 0:\n            return 70\n\n        if jd_max >= candidate_min:\n            return 100\n        elif jd_max >= candidate_min * 0.85:\n            return 70\n        elif jd_max >= candidate_min * 0.70:\n            return 40\n        else:\n            return 15\n\n    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n    async def _generate_reasoning(\n        self,\n        job: DiscoveredJobSchema,\n        profile: IdentityProfile,\n        scores: ScoreBreakdown,\n        composite: int,\n    ) -> str:\n        \"\"\"Generate a 2-sentence human-readable reasoning string via Claude.\"\"\"\n        prompt = f\"\"\"You are writing a brief explanation for why a job matches a candidate in a talent agent digest.\n\nCandidate archetype tags: {\", \".join(profile.archetype_tags)}\nJob: {job.title} at {job.company} ({job.location or \"location TBD\"})\nComposite score: {composite}/100\n\nScore breakdown:\n- Technical match: {scores.technical_match}/100\n- Level match: {scores.level_match}/100\n- Culture match: {scores.culture_match}/100\n- Industry match: {scores.industry_match}/100\n- Growth potential: {scores.growth_potential}/100\n- Compensation match: {scores.compensation_match}/100\n\nWrite exactly 2 sentences: one sentence on why this is a strong match, one on the key consideration or risk.\nBe specific. Do not use filler phrases like \"This role offers\" or \"This position presents\". Start with the substance.\nReturn only the 2 sentences, no other text.\"\"\"\n\n        response = await self._claude.messages.create(\n            model=\"claude-sonnet-4-20250514\",\n            max_tokens=200,\n            messages=[{\"role\": \"user\", \"content\": prompt}],\n        )\n        return response.content[0].text.strip()\n","numLines":368,"startLine":1,"totalLines":368}}}}
{"t":"2026-05-20T20:03:12.707Z","event":"sdk_msg","msg":{"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_01GmEpcwf8PH6PQFMtrLwAtM","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Tf3gxF4gn3oeZ8gZzFCma2","name":"Write","input":{"file_path":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/discovery/relevance_scorer.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nRelevance Scorer — scores each discovered job against the candidate's identity profile.\n\nScoring dimensions (each 0–100):\n  technical_match   30%  — skills overlap between JD and candidate profile\n  level_match       20%  — seniority alignment (penalise over AND under)\n  culture_match     15%  — startup/enterprise, remote, mission alignment\n  industry_match    15%  — domain expertise alignment\n  growth_potential  10%  — does this expand the candidate's trajectory?\n  compensation_match 10% — estimated band vs candidate target\n\nClaude parses the JD. Math runs locally. Claude writes 2-sentence reasoning.\n\"\"\"\n\nimport json\nimport re\nfrom datetime import datetime, timezone\nfrom uuid import UUID, uuid4\n\nimport structlog\nfrom anthropic import AsyncAnthropic\nfrom tenacity import retry, stop_after_attempt, wait_exponential\n\nfrom backend.agents.discovery.schemas import (\n    IdentityProfileSchema,\n    DiscoveredJobSchema,\n    ScoredJobSchema,\n    ScoreBreakdown,\n)\n\nlogger = structlog.get_logger(__name__)\n\n# Seniority levels for level_match scoring — lower index = more junior\n_SENIORITY_LADDER = [\n    \"intern\",\n    \"junior\",\n    \"associate\",\n    \"mid\",\n    \"senior\",\n    \"staff\",\n    \"principal\",\n    \"lead\",\n    \"manager\",\n    \"director\",\n    \"vp\",\n    \"svp\",\n    \"head\",\n    \"cto\",\n    \"coo\",\n    \"ceo\",\n    \"founder\",\n    \"exec\",\n    \"c-level\",\n]\n\n_LEADERSHIP_TO_LADDER = {\n    \"IC\": \"senior\",\n    \"Lead\": \"lead\",\n    \"Manager\": \"manager\",\n    \"Director\": \"director\",\n    \"VP\": \"vp\",\n    \"C-Level\": \"cto\",\n}\n\n\nclass RelevanceScorer:\n    \"\"\"\n    Scores discovered jobs against a candidate's identity profile.\n\n    Uses Claude to parse JD requirements and generate reasoning.\n    Scoring math runs locally — no LLM needed for the numbers.\n    \"\"\"\n\n    def __init__(self, anthropic_client: AsyncAnthropic):\n        \"\"\"\n        Initialize the RelevanceScorer.\n\n        Args:\n            anthropic_client: Async Anthropic client for Claude API\n        \"\"\"\n        self._claude = anthropic_client\n\n    async def score_batch(\n        self,\n        jobs: list[DiscoveredJobSchema],\n        profile: IdentityProfileSchema,\n        candidate_id: UUID,\n        min_score: int = 60,\n    ) -> list[ScoredJobSchema]:\n        \"\"\"\n        Score a batch of discovered jobs, filtering out those below min_score.\n\n        Args:\n            jobs: Raw discovered jobs to score\n            profile: Candidate identity profile\n            candidate_id: Candidate UUID for scored job records\n            min_score: Jobs below this composite score are discarded\n\n        Returns:\n            Sorted list of ScoredJobSchema, highest composite first\n        \"\"\"\n        logger.info(\n            \"relevance_scorer.batch_start\",\n            job_count=len(jobs),\n            min_score=min_score,\n        )\n\n        scored: list[ScoredJobSchema] = []\n        for job in jobs:\n            try:\n                result = await self.score_job(job, profile, candidate_id)\n                if result.composite_score >= min_score:\n                    scored.append(result)\n            except Exception as e:\n                logger.error(\n                    \"relevance_scorer.job_error\",\n                    job_url=job.url,\n                    error=str(e),\n                )\n\n        scored.sort(key=lambda s: s.composite_score, reverse=True)\n        logger.info(\n            \"relevance_scorer.batch_complete\",\n            scored=len(scored),\n            filtered_out=len(jobs) - len(scored),\n        )\n        return scored\n\n    async def score_job(\n        self,\n        job: DiscoveredJobSchema,\n        profile: IdentityProfileSchema,\n        candidate_id: UUID,\n    ) -> ScoredJobSchema:\n        \"\"\"\n        Score a single job against the identity profile.\n\n        Args:\n            job: Discovered job\n            profile: Candidate identity profile\n            candidate_id: Candidate UUID\n\n        Returns:\n            ScoredJobSchema with full breakdown and reasoning\n        \"\"\"\n        parsed_jd = await self._parse_jd(job)\n        scores = self._compute_scores(parsed_jd, profile, job)\n        composite = scores.composite\n        is_hot = composite >= 80\n        reasoning = await self._generate_reasoning(job, profile, scores, composite)\n\n        return ScoredJobSchema(\n            id=uuid4(),\n            discovered_job_id=job.id or uuid4(),\n            candidate_id=candidate_id,\n            score_breakdown=scores,\n            composite_score=composite,\n            is_hot=is_hot,\n            reasoning=reasoning,\n            scored_at=datetime.now(timezone.utc),\n            # Denormalized job fields for digest display\n            title=job.title,\n            company=job.company,\n            location=job.location,\n            url=job.url,\n        )\n\n    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n    async def _parse_jd(self, job: DiscoveredJobSchema) -> dict:\n        \"\"\"Use Claude to extract structured requirements from a job description.\"\"\"\n        if not job.description:\n            return {}\n\n        prompt = f\"\"\"Extract structured data from this job description. Return ONLY valid JSON, no markdown:\n\nJob Title: {job.title}\nCompany: {job.company}\nLocation: {job.location or \"Not specified\"}\n\nDescription:\n{job.description[:3000]}\n\nReturn this exact JSON structure:\n{{\n  \"required_skills\": [\"<skill1>\", \"<skill2>\"],\n  \"preferred_skills\": [\"<skill1>\"],\n  \"seniority_level\": \"<intern|junior|mid|senior|staff|principal|lead|manager|director|vp|head|exec>\",\n  \"remote_type\": \"<remote|hybrid|onsite|flexible>\",\n  \"industries\": [\"<industry1>\"],\n  \"comp_mentioned\": \"<salary string or null>\",\n  \"culture_signals\": {{\n    \"startup_vs_enterprise\": \"<startup|enterprise|both>\",\n    \"mission_driven\": true\n  }},\n  \"growth_indicators\": [\"<indicator1>\"]\n}}\"\"\"\n\n        response = await self._claude.messages.create(\n            model=\"claude-sonnet-4-20250514\",\n            max_tokens=1024,\n            messages=[{\"role\": \"user\", \"content\": prompt}],\n        )\n\n        raw = response.content[0].text.strip()\n        try:\n            return json.loads(raw)\n        except json.JSONDecodeError:\n            match = re.search(r\"\\{.*\\}\", raw, re.DOTALL)\n            return json.loads(match.group()) if match else {}\n\n    def _compute_scores(\n        self,\n        parsed_jd: dict,\n        profile: IdentityProfileSchema,\n        job: DiscoveredJobSchema,\n    ) -> ScoreBreakdown:\n        \"\"\"Compute all six scoring dimensions locally.\"\"\"\n        return ScoreBreakdown(\n            technical_match=self._score_technical(parsed_jd, profile),\n            level_match=self._score_level(parsed_jd, profile),\n            culture_match=self._score_culture(parsed_jd, profile, job),\n            industry_match=self._score_industry(parsed_jd, profile),\n            growth_potential=self._score_growth(parsed_jd, profile),\n            compensation_match=self._score_compensation(parsed_jd, profile),\n        )\n\n    def _score_technical(\n        self, parsed_jd: dict, profile: IdentityProfileSchema\n    ) -> int:\n        \"\"\"Score based on skills overlap between JD requirements and candidate skills.\"\"\"\n        required = {s.lower() for s in parsed_jd.get(\"required_skills\", [])}\n        preferred = {s.lower() for s in parsed_jd.get(\"preferred_skills\", [])}\n        candidate_skills = {s.lower() for s in profile.technical_skills}\n\n        if not required:\n            return 60  # No requirements listed — neutral score\n\n        required_hits = len(required & candidate_skills)\n        preferred_hits = len(preferred & candidate_skills)\n\n        required_ratio = required_hits / len(required) if required else 0\n        preferred_bonus = min(20, preferred_hits * 4) if preferred else 0\n\n        base = int(required_ratio * 80)\n        return min(100, base + preferred_bonus)\n\n    def _score_level(self, parsed_jd: dict, profile: IdentityProfileSchema) -> int:\n        \"\"\"Score seniority alignment — penalise both under and over.\"\"\"\n        jd_level = parsed_jd.get(\"seniority_level\", \"\").lower()\n        candidate_level = _LEADERSHIP_TO_LADDER.get(\n            profile.leadership_level, \"senior\"\n        )\n\n        try:\n            jd_idx = _SENIORITY_LADDER.index(jd_level)\n        except ValueError:\n            return 70  # Unknown level — generous neutral\n\n        try:\n            candidate_idx = _SENIORITY_LADDER.index(candidate_level)\n        except ValueError:\n            return 70\n\n        diff = abs(jd_idx - candidate_idx)\n        if diff == 0:\n            return 100\n        elif diff == 1:\n            return 80\n        elif diff == 2:\n            return 55\n        elif diff == 3:\n            return 30\n        else:\n            return 10\n\n    def _score_culture(\n        self,\n        parsed_jd: dict,\n        profile: IdentityProfileSchema,\n        job: DiscoveredJobSchema,\n    ) -> int:\n        \"\"\"Score culture alignment: startup/enterprise + remote preference.\"\"\"\n        score = 60  # default neutral\n\n        # Startup vs enterprise alignment\n        jd_type = parsed_jd.get(\"culture_signals\", {}).get(\n            \"startup_vs_enterprise\", \"\"\n        )\n        candidate_pref = profile.signals.get(\"startup_vs_enterprise\", \"both\")\n        if jd_type and candidate_pref != \"both\":\n            if jd_type == candidate_pref:\n                score += 20\n            else:\n                score -= 20\n\n        # Remote alignment\n        jd_remote = parsed_jd.get(\"remote_type\", \"\")\n        candidate_remote = profile.signals.get(\"remote_preference\", \"flexible\")\n        if jd_remote and candidate_remote != \"flexible\":\n            if jd_remote == candidate_remote:\n                score += 20\n            elif jd_remote == \"onsite\" and candidate_remote == \"remote\":\n                score -= 30\n            else:\n                score -= 10\n\n        return max(0, min(100, score))\n\n    def _score_industry(\n        self, parsed_jd: dict, profile: IdentityProfileSchema\n    ) -> int:\n        \"\"\"Score how well the job's industries align with the candidate's domain expertise.\"\"\"\n        jd_industries = {i.lower() for i in parsed_jd.get(\"industries\", [])}\n        candidate_domains = {d.lower() for d in profile.industry_experience}\n\n        if not jd_industries:\n            return 60\n\n        overlap = len(jd_industries & candidate_domains)\n        if overlap >= 2:\n            return 100\n        elif overlap == 1:\n            return 75\n        else:\n            return 35\n\n    def _score_growth(\n        self, parsed_jd: dict, profile: IdentityProfileSchema\n    ) -> int:\n        \"\"\"Score whether this role expands the candidate's trajectory.\"\"\"\n        indicators = parsed_jd.get(\"growth_indicators\", [])\n        growth_keywords = {\n            \"build from scratch\",\n            \"greenfield\",\n            \"founding\",\n            \"new team\",\n            \"technical strategy\",\n            \"shape the\",\n            \"lead the\",\n            \"define the\",\n            \"architect\",\n            \"platform\",\n            \"0 to 1\",\n        }\n\n        indicator_text = \" \".join(indicators).lower()\n        matches = sum(1 for kw in growth_keywords if kw in indicator_text)\n\n        if matches >= 3:\n            return 90\n        elif matches >= 1:\n            return 70\n        else:\n            return 50\n\n    def _score_compensation(\n        self, parsed_jd: dict, profile: IdentityProfileSchema\n    ) -> int:\n        \"\"\"Score comp alignment — generous when comp isn't mentioned.\"\"\"\n        comp_str = parsed_jd.get(\"comp_mentioned\")\n        if not comp_str:\n            return 75  # No comp listed is common for senior/exec roles\n\n        # Extract numbers from comp string\n        numbers = re.findall(r\"\\d[\\d,]*\", comp_str.replace(\",\", \"\"))\n        if not numbers:\n            return 70\n\n        amounts = [int(n) for n in numbers if len(n) <= 7]  # filter out noise\n        if not amounts:\n            return 70\n\n        # Without candidate min, return neutral\n        return 75\n\n    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n    async def _generate_reasoning(\n        self,\n        job: DiscoveredJobSchema,\n        profile: IdentityProfileSchema,\n        scores: ScoreBreakdown,\n        composite: int,\n    ) -> str:\n        \"\"\"Generate a 2-sentence human-readable reasoning string via Claude.\"\"\"\n        prompt = f\"\"\"You are writing a brief explanation for why a job matches a candidate in a talent agent digest.\n\nCandidate archetypes: {\", \".join(profile.archetypes[:5])}\nJob: {job.title} at {job.company} ({job.location or \"location TBD\"})\nComposite score: {composite}/100\n\nScore breakdown:\n- Technical match: {scores.technical_match}/100\n- Level match: {scores.level_match}/100\n- Culture match: {scores.culture_match}/100\n- Industry match: {scores.industry_match}/100\n- Growth potential: {scores.growth_potential}/100\n- Compensation match: {scores.compensation_match}/100\n\nWrite exactly 2 sentences: one sentence on why this is a strong match, one on the key consideration or risk.\nBe specific. Do not use filler phrases like \"This role offers\" or \"This position presents\". Start with the substance.\nReturn only the 2 sentences, no other text.\"\"\"\n\n        response = await self._claude.messages.create(\n            model=\"claude-sonnet-4-20250514\",\n            max_tokens=200,\n            messages=[{\"role\": \"user\", \"content\": prompt}],\n        )\n        return response.content[0].text.strip()\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":5008,"cache_read_input_tokens":102451,"cache_creation":{"ephemeral_5m_input_tokens":5008,"ephemeral_1h_input_tokens":0},"output_tokens":36,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"ad28d7e9-1b93-44c5-b07f-443fa223218a","uuid":"02b1154e-05e0-4c32-a622-a256822513fb"}}
