{"t":"2026-05-20T19:58:56.298Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SkbcXWXYzbtsaAZ7hZ44hN","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Relevance Scorer — scores each discovered job against the candidate's identity profile.\n     6→\n     7→Scoring dimensions (each 0–100):\n     8→  technical_match   30%  — skills overlap between JD and candidate profile\n     9→  level_match       20%  — seniority alignment (penalise over AND under)\n    10→  culture_match     15%  — startup/enterprise, remote, mission alignment\n    11→  industry_match    15%  — domain expertise alignment\n    12→  growth_potential  10%  — does this expand the candidate's trajectory?\n    13→  compensation_match 10% — estimated band vs candidate target\n    14→\n    15→Claude parses the JD. Math runs locally. Claude writes 2-sentence reasoning.\n    16→\"\"\"\n    17→\n    18→import json\n    19→import re\n    20→from typing import Optional\n    21→\n    22→import structlog\n    23→from anthropic import AsyncAnthropic\n    24→from tenacity import retry, stop_after_attempt, wait_exponential\n    25→\n    26→from backend.config import settings\n    27→from backend.agents.discovery.schemas import (\n    28→    IdentityProfile,\n    29→    DiscoveredJobSchema,\n    30→    ScoredJobSchema,\n    31→    ScoreBreakdown,\n    32→)\n    33→\n    34→logger = structlog.get_logger(__name__)\n    35→\n    36→# Seniority levels for level_match scoring — lower index = more junior\n    37→_SENIORITY_LADDER = [\n    38→    \"intern\", \"junior\", \"associate\", \"mid\", \"senior\", \"staff\",\n    39→    \"principal\", \"lead\", \"manager\", \"director\", \"vp\", \"svp\",\n    40→    \"head\", \"cto\", \"coo\", \"ceo\", \"founder\", \"exec\",\n    41→]\n    42→\n    43→_LEADERSHIP_TO_LADDER = {\n    44→    \"ic\": \"senior\",\n    45→    \"lead\": \"lead\",\n    46→    \"staff\": \"staff\",\n    47→    \"principal\": \"principal\",\n    48→    \"founder\": \"founder\",\n    49→    \"exec\": \"vp\",\n    50→}\n    51→\n    52→_REMOTE_KEYWORD_MAP = {\n    53→    \"remote\": [\"remote\", \"distributed\", \"anywhere\", \"work from home\", \"wfh\"],\n    54→    \"hybrid\": [\"hybrid\", \"flexible\"],\n    55→    \"onsite\": [\"on-site\", \"onsite\", \"in-office\", \"in office\", \"office required\"],\n    56→}\n    57→\n    58→\n    59→class RelevanceScorer:\n    60→    \"\"\"\n    61→    Scores discovered jobs against a candidate's identity profile.\n    62→\n    63→    Uses Claude to parse JD requirements and generate reasoning.\n    64→    Scoring math runs locally — no LLM needed for the numbers.\n    65→    \"\"\"\n    66→\n    67→    def __init__(self, anthropic_client: AsyncAnthropic):\n    68→        self._claude = anthropic_client\n    69→\n    70→    async def score_batch(\n    71→        self,\n    72→        jobs: list[DiscoveredJobSchema],\n    73→        profile: IdentityProfile,\n    74→        min_score: int = 60,\n    75→    ) -> list[ScoredJobSchema]:\n    76→        \"\"\"\n    77→        Score a batch of discovered jobs, filtering out those below min_score.\n    78→\n    79→        Args:\n    80→            jobs: Raw discovered jobs to score\n    81→            profile: Candidate identity profile\n    82→            min_score: Jobs below this composite score are discarded\n    83→\n    84→        Returns:\n    85→            Sorted list of ScoredJobSchema, highest composite first\n    86→        \"\"\"\n    87→        logger.info(\n    88→            \"relevance_scorer.batch_start\",\n    89→            job_count=len(jobs),\n    90→            min_score=min_score,\n    91→        )\n    92→\n    93→        scored: list[ScoredJobSchema] = []\n    94→        for job in jobs:\n    95→            try:\n    96→                result = await self.score_job(job, profile)\n    97→                if result.composite_score >= min_score:\n    98→                    scored.append(result)\n    99→            except Exception as e:\n   100→                logger.error(\n   101→                    \"relevance_scorer.job_error\",\n   102→                    job_url=job.url,\n   103→                    error=str(e),\n   104→                )\n   105→\n   106→        scored.sort(key=lambda s: s.composite_score, reverse=True)\n   107→        logger.info(\n   108→            \"relevance_scorer.batch_complete\",\n   109→            scored=len(scored),\n   110→            filtered_out=len(jobs) - len(scored),\n   111→        )\n   112→        return scored\n   113→\n   114→    async def score_job(self, job: DiscoveredJobSchema, profile: IdentityProfile) -> ScoredJobSchema:\n   115→        \"\"\"\n   116→        Score a single job against the identity profile.\n   117→\n   118→        Args:\n   119→            job: Discovered job\n   120→            profile: Candidate identity profile\n   121→\n   122→        Returns:\n   123→            ScoredJobSchema with full breakdown and reasoning\n   124→        \"\"\"\n   125→        parsed_jd = await self._parse_jd(job)\n   126→        scores = self._compute_scores(parsed_jd, profile, job)\n   127→        composite = scores.composite\n   128→        reasoning = await self._generate_reasoning(job, profile, scores, composite)\n   129→\n   130→        return ScoredJobSchema(\n   131→            job=job,\n   132→            scores=scores,\n   133→            composite_score=composite,\n   134→            reasoning=reasoning,\n   135→            is_hot=composite >= 80,\n   136→        )\n   137→\n   138→    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n   139→    async def _parse_jd(self, job: DiscoveredJobSchema) -> dict:\n   140→        \"\"\"Use Claude to extract structured requirements from a job description.\"\"\"\n   141→        if not job.description:\n   142→            return {}\n   143→\n   144→        prompt = f\"\"\"Extract structured data from this job description. Return ONLY valid JSON, no markdown:\n   145→\n   146→Job Title: {job.title}\n   147→Company: {job.company}\n   148→Location: {job.location or \"Not specified\"}\n   149→\n   150→Description:\n   151→{job.description[:3000]}\n   152→\n   153→Return this exact JSON structure:\n   154→{{\n   155→  \"required_skills\": [\"<skill1>\", \"<skill2>\"],\n   156→  \"preferred_skills\": [\"<skill1>\"],\n   157→  \"seniority_level\": \"<intern|junior|mid|senior|staff|principal|lead|manager|director|vp|head|exec>\",\n   158→  \"remote_type\": \"<remote|hybrid|onsite|flexible>\",\n   159→  \"industries\": [\"<industry1>\"],\n   160→  \"comp_mentioned\": \"<salary string or null>\",\n   161→  \"culture_signals\": {{\n   162→    \"startup_vs_enterprise\": \"<startup|enterprise|both>\",\n   163→    \"mission_driven\": <true|false>\n   164→  }},\n   165→  \"growth_indicators\": [\"<indicator1>\"]\n   166→}}\"\"\"\n   167→\n   168→        response = await self._claude.messages.create(\n   169→            model=\"claude-sonnet-4-20250514\",\n   170→            max_tokens=1024,\n   171→            messages=[{\"role\": \"user\", \"content\": prompt}],\n   172→        )\n   173→\n   174→        raw = response.content[0].text.strip()\n   175→        try:\n   176→            return json.loads(raw)\n   177→        except json.JSONDecodeError:\n   178→            match = re.search(r\"\\{.*\\}\", raw, re.DOTALL)\n   179→            return json.loads(match.group()) if match else {}\n   180→\n   181→    def _compute_scores(\n   182→        self, parsed_jd: dict, profile: IdentityProfile, job: DiscoveredJobSchema\n   183→    ) -> ScoreBreakdown:\n   184→        \"\"\"Compute all six scoring dimensions locally.\"\"\"\n   185→        return ScoreBreakdown(\n   186→            technical_match=self._score_technical(parsed_jd, profile),\n   187→            level_match=self._score_level(parsed_jd, profile),\n   188→            culture_match=self._score_culture(parsed_jd, profile, job),\n   189→            industry_match=self._score_industry(parsed_jd, profile),\n   190→            growth_potential=self._score_growth(parsed_jd, profile),\n   191→            compensation_match=self._score_compensation(parsed_jd, profile),\n   192→        )\n   193→\n   194→    def _score_technical(self, parsed_jd: dict, profile: IdentityProfile) -> int:\n   195→        \"\"\"Score based on skills overlap between JD requirements and candidate skills.\"\"\"\n   196→        required = {s.lower() for s in parsed_jd.get(\"required_skills\", [])}\n   197→        preferred = {s.lower() for s in parsed_jd.get(\"preferred_skills\", [])}\n   198→        candidate_skills = {s.lower() for s in profile.technical_skills.keys()}\n   199→\n   200→        if not required:\n   201→            return 60  # No requirements listed — neutral score\n   202→\n   203→        required_hits = len(required & candidate_skills)\n   204→        preferred_hits = len(preferred & candidate_skills)\n   205→\n   206→        required_ratio = required_hits / len(required) if required else 0\n   207→        preferred_bonus = min(20, preferred_hits * 4) if preferred else 0\n   208→\n   209→        base = int(required_ratio * 80)\n   210→        return min(100, base + preferred_bonus)\n   211→\n   212→    def _score_level(self, parsed_jd: dict, profile: IdentityProfile) -> int:\n   213→        \"\"\"Score seniority alignment — penalise both under and over.\"\"\"\n   214→        jd_level = parsed_jd.get(\"seniority_level\", \"\").lower()\n   215→        candidate_level = _LEADERSHIP_TO_LADDER.get(profile.leadership_level, \"senior\")\n   216→\n   217→        try:\n   218→            jd_idx = _SENIORITY_LADDER.index(jd_level)\n   219→        except ValueError:\n   220→            return 70  # Unknown level — generous neutral\n   221→\n   222→        try:\n   223→            candidate_idx = _SENIORITY_LADDER.index(candidate_level)\n   224→        except ValueError:\n   225→            return 70\n   226→\n   227→        diff = abs(jd_idx - candidate_idx)\n   228→        if diff == 0:\n   229→            return 100\n   230→        elif diff == 1:\n   231→            return 80\n   232→        elif diff == 2:\n   233→            return 55\n   234→        elif diff == 3:\n   235→            return 30\n   236→        else:\n   237→            return 10\n   238→\n   239→    def _score_culture(\n   240→        self, parsed_jd: dict, profile: IdentityProfile, job: DiscoveredJobSchema\n   241→    ) -> int:\n   242→        \"\"\"Score culture alignment: startup/enterprise + remote preference.\"\"\"\n   243→        score = 60  # default neutral\n   244→\n   245→        # Startup vs enterprise alignment\n   246→        jd_type = parsed_jd.get(\"culture_signals\", {}).get(\"startup_vs_enterprise\", \"\")\n   247→        candidate_pref = profile.culture_signals.get(\"startup_vs_enterprise\", \"both\")\n   248→        if jd_type and candidate_pref != \"both\":\n   249→            if jd_type == candidate_pref:\n   250→                score += 20\n   251→            else:\n   252→                score -= 20\n   253→\n   254→        # Remote alignment\n   255→        jd_remote = parsed_jd.get(\"remote_type\", \"\")\n   256→        candidate_remote = profile.culture_signals.get(\"remote_preference\", \"flexible\")\n   257→        if jd_remote and candidate_remote != \"flexible\":\n   258→            if jd_remote == candidate_remote:\n   259→                score += 20\n   260→            elif jd_remote == \"onsite\" and candidate_remote == \"remote\":\n   261→                score -= 30\n   262→            else:\n   263→                score -= 10\n   264→\n   265→        return max(0, min(100, score))\n   266→\n   267→    def _score_industry(self, parsed_jd: dict, profile: IdentityProfile) -> int:\n   268→        \"\"\"Score how well the job's industries align with the candidate's domain expertise.\"\"\"\n   269→        jd_industries = {i.lower() for i in parsed_jd.get(\"industries\", [])}\n   270→        candidate_domains = {d.lower() for d in profile.domain_expertise}\n   271→\n   272→        if not jd_industries:\n   273→            return 60\n   274→\n   275→        overlap = len(jd_industries & candidate_domains)\n   276→        if overlap >= 2:\n   277→            return 100\n   278→        elif overlap == 1:\n   279→            return 75\n   280→        else:\n   281→            return 35\n   282→\n   283→    def _score_growth(self, parsed_jd: dict, profile: IdentityProfile) -> int:\n   284→        \"\"\"Score whether this role expands the candidate's trajectory.\"\"\"\n   285→        indicators = parsed_jd.get(\"growth_indicators\", [])\n   286→        growth_keywords = {\n   287→            \"build from scratch\", \"greenfield\", \"founding\", \"new team\",\n   288→            \"technical strategy\", \"shape the\", \"lead the\", \"define the\",\n   289→            \"architect\", \"platform\", \"0 to 1\",\n   290→        }\n   291→\n   292→        indicator_text = \" \".join(indicators).lower()\n   293→        matches = sum(1 for kw in growth_keywords if kw in indicator_text)\n   294→\n   295→        if matches >= 3:\n   296→            return 90\n   297→        elif matches >= 1:\n   298→            return 70\n   299→        else:\n   300→            return 50\n   301→\n   302→    def _score_compensation(self, parsed_jd: dict, profile: IdentityProfile) -> int:\n   303→        \"\"\"Score comp alignment — generous when comp isn't mentioned (common for senior roles).\"\"\"\n   304→        comp_str = parsed_jd.get(\"comp_mentioned\")\n   305→        if not comp_str:\n   306→            return 75  # No comp listed is common for senior/exec roles — assume competitive\n   307→\n   308→        # Extract numbers from comp string\n   309→        numbers = re.findall(r\"\\d[\\d,]*\", comp_str.replace(\",\", \"\"))\n   310→        if not numbers:\n   311→            return 70\n   312→\n   313→        amounts = [int(n) for n in numbers if len(n) <= 7]  # filter out noise\n   314→        if not amounts:\n   315→            return 70\n   316→\n   317→        jd_max = max(amounts)\n   318→        # Normalize to annual if looks like monthly (< 20000)\n   319→        if jd_max < 20_000:\n   320→            jd_max *= 12\n   321→\n   322→        candidate_min = profile.compensation_band.get(\"min\", 0)\n   323→        if candidate_min == 0:\n   324→            return 70\n   325→\n   326→        if jd_max >= candidate_min:\n   327→            return 100\n   328→        elif jd_max >= candidate_min * 0.85:\n   329→            return 70\n   330→        elif jd_max >= candidate_min * 0.70:\n   331→            return 40\n   332→        else:\n   333→            return 15\n   334→\n   335→    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n   336→    async def _generate_reasoning(\n   337→        self,\n   338→        job: DiscoveredJobSchema,\n   339→        profile: IdentityProfile,\n   340→        scores: ScoreBreakdown,\n   341→        composite: int,\n   342→    ) -> str:\n   343→        \"\"\"Generate a 2-sentence human-readable reasoning string via Claude.\"\"\"\n   344→        prompt = f\"\"\"You are writing a brief explanation for why a job matches a candidate in a talent agent digest.\n   345→\n   346→Candidate archetype tags: {\", \".join(profile.archetype_tags)}\n   347→Job: {job.title} at {job.company} ({job.location or \"location TBD\"})\n   348→Composite score: {composite}/100\n   349→\n   350→Score breakdown:\n   351→- Technical match: {scores.technical_match}/100\n   352→- Level match: {scores.level_match}/100\n   353→- Culture match: {scores.culture_match}/100\n   354→- Industry match: {scores.industry_match}/100\n   355→- Growth potential: {scores.growth_potential}/100\n   356→- Compensation match: {scores.compensation_match}/100\n   357→\n   358→Write exactly 2 sentences: one sentence on why this is a strong match, one on the key consideration or risk.\n   359→Be specific. Do not use filler phrases like \"This role offers\" or \"This position presents\". Start with the substance.\n   360→Return only the 2 sentences, no other text.\"\"\"\n   361→\n   362→        response = await self._claude.messages.create(\n   363→            model=\"claude-sonnet-4-20250514\",\n   364→            max_tokens=200,\n   365→            messages=[{\"role\": \"user\", \"content\": prompt}],\n   366→        )\n   367→        return response.content[0].text.strip()\n   368→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"ad28d7e9-1b93-44c5-b07f-443fa223218a","uuid":"a65bdfb5-61f2-4176-82c4-6c087ace093f","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/discovery/relevance_scorer.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nRelevance Scorer — scores each discovered job against the candidate's identity profile.\n\nScoring dimensions (each 0–100):\n  technical_match   30%  — skills overlap between JD and candidate profile\n  level_match       20%  — seniority alignment (penalise over AND under)\n  culture_match     15%  — startup/enterprise, remote, mission alignment\n  industry_match    15%  — domain expertise alignment\n  growth_potential  10%  — does this expand the candidate's trajectory?\n  compensation_match 10% — estimated band vs candidate target\n\nClaude parses the JD. Math runs locally. Claude writes 2-sentence reasoning.\n\"\"\"\n\nimport json\nimport re\nfrom typing import Optional\n\nimport structlog\nfrom anthropic import AsyncAnthropic\nfrom tenacity import retry, stop_after_attempt, wait_exponential\n\nfrom backend.config import settings\nfrom backend.agents.discovery.schemas import (\n    IdentityProfile,\n    DiscoveredJobSchema,\n    ScoredJobSchema,\n    ScoreBreakdown,\n)\n\nlogger = structlog.get_logger(__name__)\n\n# Seniority levels for level_match scoring — lower index = more junior\n_SENIORITY_LADDER = [\n    \"intern\", \"junior\", \"associate\", \"mid\", \"senior\", \"staff\",\n    \"principal\", \"lead\", \"manager\", \"director\", \"vp\", \"svp\",\n    \"head\", \"cto\", \"coo\", \"ceo\", \"founder\", \"exec\",\n]\n\n_LEADERSHIP_TO_LADDER = {\n    \"ic\": \"senior\",\n    \"lead\": \"lead\",\n    \"staff\": \"staff\",\n    \"principal\": \"principal\",\n    \"founder\": \"founder\",\n    \"exec\": \"vp\",\n}\n\n_REMOTE_KEYWORD_MAP = {\n    \"remote\": [\"remote\", \"distributed\", \"anywhere\", \"work from home\", \"wfh\"],\n    \"hybrid\": [\"hybrid\", \"flexible\"],\n    \"onsite\": [\"on-site\", \"onsite\", \"in-office\", \"in office\", \"office required\"],\n}\n\n\nclass RelevanceScorer:\n    \"\"\"\n    Scores discovered jobs against a candidate's identity profile.\n\n    Uses Claude to parse JD requirements and generate reasoning.\n    Scoring math runs locally — no LLM needed for the numbers.\n    \"\"\"\n\n    def __init__(self, anthropic_client: AsyncAnthropic):\n        self._claude = anthropic_client\n\n    async def score_batch(\n        self,\n        jobs: list[DiscoveredJobSchema],\n        profile: IdentityProfile,\n        min_score: int = 60,\n    ) -> list[ScoredJobSchema]:\n        \"\"\"\n        Score a batch of discovered jobs, filtering out those below min_score.\n\n        Args:\n            jobs: Raw discovered jobs to score\n            profile: Candidate identity profile\n            min_score: Jobs below this composite score are discarded\n\n        Returns:\n            Sorted list of ScoredJobSchema, highest composite first\n        \"\"\"\n        logger.info(\n            \"relevance_scorer.batch_start\",\n            job_count=len(jobs),\n            min_score=min_score,\n        )\n\n        scored: list[ScoredJobSchema] = []\n        for job in jobs:\n            try:\n                result = await self.score_job(job, profile)\n                if result.composite_score >= min_score:\n                    scored.append(result)\n            except Exception as e:\n                logger.error(\n                    \"relevance_scorer.job_error\",\n                    job_url=job.url,\n                    error=str(e),\n                )\n\n        scored.sort(key=lambda s: s.composite_score, reverse=True)\n        logger.info(\n            \"relevance_scorer.batch_complete\",\n            scored=len(scored),\n            filtered_out=len(jobs) - len(scored),\n        )\n        return scored\n\n    async def score_job(self, job: DiscoveredJobSchema, profile: IdentityProfile) -> ScoredJobSchema:\n        \"\"\"\n        Score a single job against the identity profile.\n\n        Args:\n            job: Discovered job\n            profile: Candidate identity profile\n\n        Returns:\n            ScoredJobSchema with full breakdown and reasoning\n        \"\"\"\n        parsed_jd = await self._parse_jd(job)\n        scores = self._compute_scores(parsed_jd, profile, job)\n        composite = scores.composite\n        reasoning = await self._generate_reasoning(job, profile, scores, composite)\n\n        return ScoredJobSchema(\n            job=job,\n            scores=scores,\n            composite_score=composite,\n            reasoning=reasoning,\n            is_hot=composite >= 80,\n        )\n\n    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n    async def _parse_jd(self, job: DiscoveredJobSchema) -> dict:\n        \"\"\"Use Claude to extract structured requirements from a job description.\"\"\"\n        if not job.description:\n            return {}\n\n        prompt = f\"\"\"Extract structured data from this job description. Return ONLY valid JSON, no markdown:\n\nJob Title: {job.title}\nCompany: {job.company}\nLocation: {job.location or \"Not specified\"}\n\nDescription:\n{job.description[:3000]}\n\nReturn this exact JSON structure:\n{{\n  \"required_skills\": [\"<skill1>\", \"<skill2>\"],\n  \"preferred_skills\": [\"<skill1>\"],\n  \"seniority_level\": \"<intern|junior|mid|senior|staff|principal|lead|manager|director|vp|head|exec>\",\n  \"remote_type\": \"<remote|hybrid|onsite|flexible>\",\n  \"industries\": [\"<industry1>\"],\n  \"comp_mentioned\": \"<salary string or null>\",\n  \"culture_signals\": {{\n    \"startup_vs_enterprise\": \"<startup|enterprise|both>\",\n    \"mission_driven\": <true|false>\n  }},\n  \"growth_indicators\": [\"<indicator1>\"]\n}}\"\"\"\n\n        response = await self._claude.messages.create(\n            model=\"claude-sonnet-4-20250514\",\n            max_tokens=1024,\n            messages=[{\"role\": \"user\", \"content\": prompt}],\n        )\n\n        raw = response.content[0].text.strip()\n        try:\n            return json.loads(raw)\n        except json.JSONDecodeError:\n            match = re.search(r\"\\{.*\\}\", raw, re.DOTALL)\n            return json.loads(match.group()) if match else {}\n\n    def _compute_scores(\n        self, parsed_jd: dict, profile: IdentityProfile, job: DiscoveredJobSchema\n    ) -> ScoreBreakdown:\n        \"\"\"Compute all six scoring dimensions locally.\"\"\"\n        return ScoreBreakdown(\n            technical_match=self._score_technical(parsed_jd, profile),\n            level_match=self._score_level(parsed_jd, profile),\n            culture_match=self._score_culture(parsed_jd, profile, job),\n            industry_match=self._score_industry(parsed_jd, profile),\n            growth_potential=self._score_growth(parsed_jd, profile),\n            compensation_match=self._score_compensation(parsed_jd, profile),\n        )\n\n    def _score_technical(self, parsed_jd: dict, profile: IdentityProfile) -> int:\n        \"\"\"Score based on skills overlap between JD requirements and candidate skills.\"\"\"\n        required = {s.lower() for s in parsed_jd.get(\"required_skills\", [])}\n        preferred = {s.lower() for s in parsed_jd.get(\"preferred_skills\", [])}\n        candidate_skills = {s.lower() for s in profile.technical_skills.keys()}\n\n        if not required:\n            return 60  # No requirements listed — neutral score\n\n        required_hits = len(required & candidate_skills)\n        preferred_hits = len(preferred & candidate_skills)\n\n        required_ratio = required_hits / len(required) if required else 0\n        preferred_bonus = min(20, preferred_hits * 4) if preferred else 0\n\n        base = int(required_ratio * 80)\n        return min(100, base + preferred_bonus)\n\n    def _score_level(self, parsed_jd: dict, profile: IdentityProfile) -> int:\n        \"\"\"Score seniority alignment — penalise both under and over.\"\"\"\n        jd_level = parsed_jd.get(\"seniority_level\", \"\").lower()\n        candidate_level = _LEADERSHIP_TO_LADDER.get(profile.leadership_level, \"senior\")\n\n        try:\n            jd_idx = _SENIORITY_LADDER.index(jd_level)\n        except ValueError:\n            return 70  # Unknown level — generous neutral\n\n        try:\n            candidate_idx = _SENIORITY_LADDER.index(candidate_level)\n        except ValueError:\n            return 70\n\n        diff = abs(jd_idx - candidate_idx)\n        if diff == 0:\n            return 100\n        elif diff == 1:\n            return 80\n        elif diff == 2:\n            return 55\n        elif diff == 3:\n            return 30\n        else:\n            return 10\n\n    def _score_culture(\n        self, parsed_jd: dict, profile: IdentityProfile, job: DiscoveredJobSchema\n    ) -> int:\n        \"\"\"Score culture alignment: startup/enterprise + remote preference.\"\"\"\n        score = 60  # default neutral\n\n        # Startup vs enterprise alignment\n        jd_type = parsed_jd.get(\"culture_signals\", {}).get(\"startup_vs_enterprise\", \"\")\n        candidate_pref = profile.culture_signals.get(\"startup_vs_enterprise\", \"both\")\n        if jd_type and candidate_pref != \"both\":\n            if jd_type == candidate_pref:\n                score += 20\n            else:\n                score -= 20\n\n        # Remote alignment\n        jd_remote = parsed_jd.get(\"remote_type\", \"\")\n        candidate_remote = profile.culture_signals.get(\"remote_preference\", \"flexible\")\n        if jd_remote and candidate_remote != \"flexible\":\n            if jd_remote == candidate_remote:\n                score += 20\n            elif jd_remote == \"onsite\" and candidate_remote == \"remote\":\n                score -= 30\n            else:\n                score -= 10\n\n        return max(0, min(100, score))\n\n    def _score_industry(self, parsed_jd: dict, profile: IdentityProfile) -> int:\n        \"\"\"Score how well the job's industries align with the candidate's domain expertise.\"\"\"\n        jd_industries = {i.lower() for i in parsed_jd.get(\"industries\", [])}\n        candidate_domains = {d.lower() for d in profile.domain_expertise}\n\n        if not jd_industries:\n            return 60\n\n        overlap = len(jd_industries & candidate_domains)\n        if overlap >= 2:\n            return 100\n        elif overlap == 1:\n            return 75\n        else:\n            return 35\n\n    def _score_growth(self, parsed_jd: dict, profile: IdentityProfile) -> int:\n        \"\"\"Score whether this role expands the candidate's trajectory.\"\"\"\n        indicators = parsed_jd.get(\"growth_indicators\", [])\n        growth_keywords = {\n            \"build from scratch\", \"greenfield\", \"founding\", \"new team\",\n            \"technical strategy\", \"shape the\", \"lead the\", \"define the\",\n            \"architect\", \"platform\", \"0 to 1\",\n        }\n\n        indicator_text = \" \".join(indicators).lower()\n        matches = sum(1 for kw in growth_keywords if kw in indicator_text)\n\n        if matches >= 3:\n            return 90\n        elif matches >= 1:\n            return 70\n        else:\n            return 50\n\n    def _score_compensation(self, parsed_jd: dict, profile: IdentityProfile) -> int:\n        \"\"\"Score comp alignment — generous when comp isn't mentioned (common for senior roles).\"\"\"\n        comp_str = parsed_jd.get(\"comp_mentioned\")\n        if not comp_str:\n            return 75  # No comp listed is common for senior/exec roles — assume competitive\n\n        # Extract numbers from comp string\n        numbers = re.findall(r\"\\d[\\d,]*\", comp_str.replace(\",\", \"\"))\n        if not numbers:\n            return 70\n\n        amounts = [int(n) for n in numbers if len(n) <= 7]  # filter out noise\n        if not amounts:\n            return 70\n\n        jd_max = max(amounts)\n        # Normalize to annual if looks like monthly (< 20000)\n        if jd_max < 20_000:\n            jd_max *= 12\n\n        candidate_min = profile.compensation_band.get(\"min\", 0)\n        if candidate_min == 0:\n            return 70\n\n        if jd_max >= candidate_min:\n            return 100\n        elif jd_max >= candidate_min * 0.85:\n            return 70\n        elif jd_max >= candidate_min * 0.70:\n            return 40\n        else:\n            return 15\n\n    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n    async def _generate_reasoning(\n        self,\n        job: DiscoveredJobSchema,\n        profile: IdentityProfile,\n        scores: ScoreBreakdown,\n        composite: int,\n    ) -> str:\n        \"\"\"Generate a 2-sentence human-readable reasoning string via Claude.\"\"\"\n        prompt = f\"\"\"You are writing a brief explanation for why a job matches a candidate in a talent agent digest.\n\nCandidate archetype tags: {\", \".join(profile.archetype_tags)}\nJob: {job.title} at {job.company} ({job.location or \"location TBD\"})\nComposite score: {composite}/100\n\nScore breakdown:\n- Technical match: {scores.technical_match}/100\n- Level match: {scores.level_match}/100\n- Culture match: {scores.culture_match}/100\n- Industry match: {scores.industry_match}/100\n- Growth potential: {scores.growth_potential}/100\n- Compensation match: {scores.compensation_match}/100\n\nWrite exactly 2 sentences: one sentence on why this is a strong match, one on the key consideration or risk.\nBe specific. Do not use filler phrases like \"This role offers\" or \"This position presents\". Start with the substance.\nReturn only the 2 sentences, no other text.\"\"\"\n\n        response = await self._claude.messages.create(\n            model=\"claude-sonnet-4-20250514\",\n            max_tokens=200,\n            messages=[{\"role\": \"user\", \"content\": prompt}],\n        )\n        return response.content[0].text.strip()\n","numLines":368,"startLine":1,"totalLines":368}}}}
{"t":"2026-05-20T19:58:56.313Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NrfYHeqEWCfNCuF6nUPpEn","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Daily Digest Builder — assembles the ranked digest from scored jobs.\n     6→\n     7→Flow:\n     8→  1. Receive scored jobs from RelevanceScorer\n     9→  2. Separate HOT picks (80+) from top picks\n    10→  3. Identify new companies not seen in previous digests\n    11→  4. Generate Claude narrative summary of today's landscape\n    12→  5. Persist digest to PostgreSQL\n    13→  6. Publish DIGEST_READY event to Redis pub/sub\n    14→\"\"\"\n    15→\n    16→import json\n    17→from datetime import date, datetime\n    18→from uuid import UUID\n    19→\n    20→import redis.asyncio as aioredis\n    21→import structlog\n    22→from anthropic import AsyncAnthropic\n    23→from sqlalchemy.ext.asyncio import AsyncSession\n    24→from sqlalchemy import select\n    25→from tenacity import retry, stop_after_attempt, wait_exponential\n    26→\n    27→from backend.agents.discovery.schemas import (\n    28→    ScoredJobSchema,\n    29→    DailyDigestSchema,\n    30→    DigestJobPreview,\n    31→)\n    32→from backend.models.discovery import DailyDigest as DailyDigestORM\n    33→\n    34→logger = structlog.get_logger(__name__)\n    35→\n    36→_DIGEST_READY_CHANNEL = \"agent.status.digest\"\n    37→_SEEN_COMPANIES_KEY = \"seen_companies:{candidate_id}\"\n    38→_SEEN_COMPANIES_TTL = 86_400 * 30  # 30 days\n    39→\n    40→\n    41→class DigestBuilder:\n    42→    \"\"\"\n    43→    Compiles scored jobs into a daily digest, persists it, and fires the DIGEST_READY event.\n    44→    \"\"\"\n    45→\n    46→    def __init__(\n    47→        self,\n    48→        redis_client: aioredis.Redis,\n    49→        anthropic_client: AsyncAnthropic,\n    50→        db: AsyncSession,\n    51→    ):\n    52→        self._redis = redis_client\n    53→        self._claude = anthropic_client\n    54→        self._db = db\n    55→\n    56→    async def compile(\n    57→        self,\n    58→        candidate_id: UUID,\n    59→        scored_jobs: list[ScoredJobSchema],\n    60→        total_discovered: int,\n    61→    ) -> DailyDigestSchema:\n    62→        \"\"\"\n    63→        Build the full daily digest from scored jobs.\n    64→\n    65→        Args:\n    66→            candidate_id: Candidate this digest belongs to\n    67→            scored_jobs: All jobs that passed MIN_SCORE, sorted descending by composite\n    68→            total_discovered: Raw count before scoring/filtering\n    69→\n    70→        Returns:\n    71→            DailyDigestSchema ready for the Review Dashboard\n    72→        \"\"\"\n    73→        today = date.today().isoformat()\n    74→        logger.info(\n    75→            \"digest_builder.compiling\",\n    76→            candidate_id=str(candidate_id),\n    77→            scored_jobs=len(scored_jobs),\n    78→            run_date=today,\n    79→        )\n    80→\n    81→        hot_picks = [self._to_preview(s) for s in scored_jobs if s.is_hot]\n    82→        top_picks = [self._to_preview(s) for s in scored_jobs[:10]]\n    83→        new_companies = await self._find_new_companies(candidate_id, scored_jobs)\n    84→        summary = await self._generate_summary(scored_jobs, new_companies, today)\n    85→\n    86→        digest = DailyDigestSchema(\n    87→            candidate_id=candidate_id,\n    88→            run_date=today,\n    89→            total_discovered=total_discovered,\n    90→            total_scored=len(scored_jobs),\n    91→            top_picks=top_picks,\n    92→            hot_picks=hot_picks,\n    93→            new_companies=new_companies,\n    94→            digest_summary=summary,\n    95→        )\n    96→\n    97→        await self._persist(digest)\n    98→        await self._publish_ready_event(candidate_id, digest)\n    99→\n   100→        logger.info(\n   101→            \"digest_builder.complete\",\n   102→            candidate_id=str(candidate_id),\n   103→            top_picks=len(top_picks),\n   104→            hot_picks=len(hot_picks),\n   105→            new_companies=len(new_companies),\n   106→        )\n   107→        return digest\n   108→\n   109→    def _to_preview(self, scored: ScoredJobSchema) -> DigestJobPreview:\n   110→        \"\"\"Convert a ScoredJobSchema to a lightweight DigestJobPreview.\"\"\"\n   111→        return DigestJobPreview(\n   112→            job_id=scored.job.id or UUID(int=0),\n   113→            title=scored.job.title,\n   114→            company=scored.job.company,\n   115→            location=scored.job.location,\n   116→            url=scored.job.url,\n   117→            composite_score=scored.composite_score,\n   118→            is_hot=scored.is_hot,\n   119→            reasoning=scored.reasoning,\n   120→        )\n   121→\n   122→    async def _find_new_companies(\n   123→        self, candidate_id: UUID, scored_jobs: list[ScoredJobSchema]\n   124→    ) -> list[str]:\n   125→        \"\"\"\n   126→        Return companies appearing in today's digest that weren't in recent digests.\n   127→\n   128→        Uses a Redis set as a rolling 30-day seen-companies tracker.\n   129→        \"\"\"\n   130→        key = _SEEN_COMPANIES_KEY.format(candidate_id=str(candidate_id))\n   131→        today_companies = list({s.job.company for s in scored_jobs})\n   132→\n   133→        # Identify new ones\n   134→        seen_raw = await self._redis.smembers(key)\n   135→        seen = {c.decode() if isinstance(c, bytes) else c for c in seen_raw}\n   136→        new_companies = [c for c in today_companies if c not in seen]\n   137→\n   138→        # Update the seen set\n   139→        if today_companies:\n   140→            await self._redis.sadd(key, *today_companies)\n   141→            await self._redis.expire(key, _SEEN_COMPANIES_TTL)\n   142→\n   143→        return new_companies\n   144→\n   145→    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n   146→    async def _generate_summary(\n   147→        self,\n   148→        scored_jobs: list[ScoredJobSchema],\n   149→        new_companies: list[str],\n   150→        run_date: str,\n   151→    ) -> str:\n   152→        \"\"\"Generate a 3-sentence narrative summary of today's digest via Claude.\"\"\"\n   153→        if not scored_jobs:\n   154→            return \"No jobs met the scoring threshold today. The engine ran successfully — consider lowering MIN_SCORE or expanding the archetype manifest. Check back tomorrow.\"\n   155→\n   156→        top_companies = [s.job.company for s in scored_jobs[:5]]\n   157→        hot_count = sum(1 for s in scored_jobs if s.is_hot)\n   158→        avg_score = int(sum(s.composite_score for s in scored_jobs) / len(scored_jobs))\n   159→\n   160→        prompt = f\"\"\"Write a 3-sentence digest summary for a daily job discovery report. Be specific, direct, and useful. No filler.\n   161→\n   162→Date: {run_date}\n   163→Total jobs passing threshold: {len(scored_jobs)}\n   164→HOT picks (80+): {hot_count}\n   165→Average composite score: {avg_score}/100\n   166→Top companies appearing: {\", \".join(top_companies)}\n   167→New companies not seen before: {\", \".join(new_companies[:5]) if new_companies else \"none\"}\n   168→Top role: {scored_jobs[0].job.title} at {scored_jobs[0].job.company} (score: {scored_jobs[0].composite_score})\n   169→\n   170→Write exactly 3 sentences. Focus on: (1) what the landscape looks like today, (2) the standout opportunity, (3) one specific action to take. Return only the 3 sentences.\"\"\"\n   171→\n   172→        response = await self._claude.messages.create(\n   173→            model=\"claude-sonnet-4-20250514\",\n   174→            max_tokens=300,\n   175→            messages=[{\"role\": \"user\", \"content\": prompt}],\n   176→        )\n   177→        return response.content[0].text.strip()\n   178→\n   179→    async def _persist(self, digest: DailyDigestSchema) -> None:\n   180→        \"\"\"Persist the digest to PostgreSQL.\"\"\"\n   181→        orm = DailyDigestORM(\n   182→            candidate_id=digest.candidate_id,\n   183→            run_date=date.fromisoformat(digest.run_date),\n   184→            total_discovered=digest.total_discovered,\n   185→            total_scored=digest.total_scored,\n   186→            top_picks=[p.model_dump(mode=\"json\") for p in digest.top_picks],\n   187→            hot_picks=[p.model_dump(mode=\"json\") for p in digest.hot_picks],\n   188→            new_companies=digest.new_companies,\n   189→            digest_summary=digest.digest_summary,\n   190→        )\n   191→        self._db.add(orm)\n   192→        await self._db.commit()\n   193→        logger.info(\"digest_builder.persisted\", candidate_id=str(digest.candidate_id))\n   194→\n   195→    async def _publish_ready_event(self, candidate_id: UUID, digest: DailyDigestSchema) -> None:\n   196→        \"\"\"Publish DIGEST_READY event to Redis pub/sub for dashboard notification.\"\"\"\n   197→        payload = json.dumps({\n   198→            \"event\": \"DIGEST_READY\",\n   199→            \"candidate_id\": str(candidate_id),\n   200→            \"run_date\": digest.run_date,\n   201→            \"total_scored\": digest.total_scored,\n   202→            \"hot_count\": len(digest.hot_picks),\n   203→            \"top_score\": digest.top_picks[0].composite_score if digest.top_picks else 0,\n   204→        })\n   205→        await self._redis.publish(_DIGEST_READY_CHANNEL, payload)\n   206→        logger.info(\n   207→            \"digest_builder.event_published\",\n   208→            channel=_DIGEST_READY_CHANNEL,\n   209→            candidate_id=str(candidate_id),\n   210→        )\n   211→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"ad28d7e9-1b93-44c5-b07f-443fa223218a","uuid":"35da5ee7-8adc-4482-8ca7-246e781890ea","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/discovery/digest_builder.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nDaily Digest Builder — assembles the ranked digest from scored jobs.\n\nFlow:\n  1. Receive scored jobs from RelevanceScorer\n  2. Separate HOT picks (80+) from top picks\n  3. Identify new companies not seen in previous digests\n  4. Generate Claude narrative summary of today's landscape\n  5. Persist digest to PostgreSQL\n  6. Publish DIGEST_READY event to Redis pub/sub\n\"\"\"\n\nimport json\nfrom datetime import date, datetime\nfrom uuid import UUID\n\nimport redis.asyncio as aioredis\nimport structlog\nfrom anthropic import AsyncAnthropic\nfrom sqlalchemy.ext.asyncio import AsyncSession\nfrom sqlalchemy import select\nfrom tenacity import retry, stop_after_attempt, wait_exponential\n\nfrom backend.agents.discovery.schemas import (\n    ScoredJobSchema,\n    DailyDigestSchema,\n    DigestJobPreview,\n)\nfrom backend.models.discovery import DailyDigest as DailyDigestORM\n\nlogger = structlog.get_logger(__name__)\n\n_DIGEST_READY_CHANNEL = \"agent.status.digest\"\n_SEEN_COMPANIES_KEY = \"seen_companies:{candidate_id}\"\n_SEEN_COMPANIES_TTL = 86_400 * 30  # 30 days\n\n\nclass DigestBuilder:\n    \"\"\"\n    Compiles scored jobs into a daily digest, persists it, and fires the DIGEST_READY event.\n    \"\"\"\n\n    def __init__(\n        self,\n        redis_client: aioredis.Redis,\n        anthropic_client: AsyncAnthropic,\n        db: AsyncSession,\n    ):\n        self._redis = redis_client\n        self._claude = anthropic_client\n        self._db = db\n\n    async def compile(\n        self,\n        candidate_id: UUID,\n        scored_jobs: list[ScoredJobSchema],\n        total_discovered: int,\n    ) -> DailyDigestSchema:\n        \"\"\"\n        Build the full daily digest from scored jobs.\n\n        Args:\n            candidate_id: Candidate this digest belongs to\n            scored_jobs: All jobs that passed MIN_SCORE, sorted descending by composite\n            total_discovered: Raw count before scoring/filtering\n\n        Returns:\n            DailyDigestSchema ready for the Review Dashboard\n        \"\"\"\n        today = date.today().isoformat()\n        logger.info(\n            \"digest_builder.compiling\",\n            candidate_id=str(candidate_id),\n            scored_jobs=len(scored_jobs),\n            run_date=today,\n        )\n\n        hot_picks = [self._to_preview(s) for s in scored_jobs if s.is_hot]\n        top_picks = [self._to_preview(s) for s in scored_jobs[:10]]\n        new_companies = await self._find_new_companies(candidate_id, scored_jobs)\n        summary = await self._generate_summary(scored_jobs, new_companies, today)\n\n        digest = DailyDigestSchema(\n            candidate_id=candidate_id,\n            run_date=today,\n            total_discovered=total_discovered,\n            total_scored=len(scored_jobs),\n            top_picks=top_picks,\n            hot_picks=hot_picks,\n            new_companies=new_companies,\n            digest_summary=summary,\n        )\n\n        await self._persist(digest)\n        await self._publish_ready_event(candidate_id, digest)\n\n        logger.info(\n            \"digest_builder.complete\",\n            candidate_id=str(candidate_id),\n            top_picks=len(top_picks),\n            hot_picks=len(hot_picks),\n            new_companies=len(new_companies),\n        )\n        return digest\n\n    def _to_preview(self, scored: ScoredJobSchema) -> DigestJobPreview:\n        \"\"\"Convert a ScoredJobSchema to a lightweight DigestJobPreview.\"\"\"\n        return DigestJobPreview(\n            job_id=scored.job.id or UUID(int=0),\n            title=scored.job.title,\n            company=scored.job.company,\n            location=scored.job.location,\n            url=scored.job.url,\n            composite_score=scored.composite_score,\n            is_hot=scored.is_hot,\n            reasoning=scored.reasoning,\n        )\n\n    async def _find_new_companies(\n        self, candidate_id: UUID, scored_jobs: list[ScoredJobSchema]\n    ) -> list[str]:\n        \"\"\"\n        Return companies appearing in today's digest that weren't in recent digests.\n\n        Uses a Redis set as a rolling 30-day seen-companies tracker.\n        \"\"\"\n        key = _SEEN_COMPANIES_KEY.format(candidate_id=str(candidate_id))\n        today_companies = list({s.job.company for s in scored_jobs})\n\n        # Identify new ones\n        seen_raw = await self._redis.smembers(key)\n        seen = {c.decode() if isinstance(c, bytes) else c for c in seen_raw}\n        new_companies = [c for c in today_companies if c not in seen]\n\n        # Update the seen set\n        if today_companies:\n            await self._redis.sadd(key, *today_companies)\n            await self._redis.expire(key, _SEEN_COMPANIES_TTL)\n\n        return new_companies\n\n    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n    async def _generate_summary(\n        self,\n        scored_jobs: list[ScoredJobSchema],\n        new_companies: list[str],\n        run_date: str,\n    ) -> str:\n        \"\"\"Generate a 3-sentence narrative summary of today's digest via Claude.\"\"\"\n        if not scored_jobs:\n            return \"No jobs met the scoring threshold today. The engine ran successfully — consider lowering MIN_SCORE or expanding the archetype manifest. Check back tomorrow.\"\n\n        top_companies = [s.job.company for s in scored_jobs[:5]]\n        hot_count = sum(1 for s in scored_jobs if s.is_hot)\n        avg_score = int(sum(s.composite_score for s in scored_jobs) / len(scored_jobs))\n\n        prompt = f\"\"\"Write a 3-sentence digest summary for a daily job discovery report. Be specific, direct, and useful. No filler.\n\nDate: {run_date}\nTotal jobs passing threshold: {len(scored_jobs)}\nHOT picks (80+): {hot_count}\nAverage composite score: {avg_score}/100\nTop companies appearing: {\", \".join(top_companies)}\nNew companies not seen before: {\", \".join(new_companies[:5]) if new_companies else \"none\"}\nTop role: {scored_jobs[0].job.title} at {scored_jobs[0].job.company} (score: {scored_jobs[0].composite_score})\n\nWrite exactly 3 sentences. Focus on: (1) what the landscape looks like today, (2) the standout opportunity, (3) one specific action to take. Return only the 3 sentences.\"\"\"\n\n        response = await self._claude.messages.create(\n            model=\"claude-sonnet-4-20250514\",\n            max_tokens=300,\n            messages=[{\"role\": \"user\", \"content\": prompt}],\n        )\n        return response.content[0].text.strip()\n\n    async def _persist(self, digest: DailyDigestSchema) -> None:\n        \"\"\"Persist the digest to PostgreSQL.\"\"\"\n        orm = DailyDigestORM(\n            candidate_id=digest.candidate_id,\n            run_date=date.fromisoformat(digest.run_date),\n            total_discovered=digest.total_discovered,\n            total_scored=digest.total_scored,\n            top_picks=[p.model_dump(mode=\"json\") for p in digest.top_picks],\n            hot_picks=[p.model_dump(mode=\"json\") for p in digest.hot_picks],\n            new_companies=digest.new_companies,\n            digest_summary=digest.digest_summary,\n        )\n        self._db.add(orm)\n        await self._db.commit()\n        logger.info(\"digest_builder.persisted\", candidate_id=str(digest.candidate_id))\n\n    async def _publish_ready_event(self, candidate_id: UUID, digest: DailyDigestSchema) -> None:\n        \"\"\"Publish DIGEST_READY event to Redis pub/sub for dashboard notification.\"\"\"\n        payload = json.dumps({\n            \"event\": \"DIGEST_READY\",\n            \"candidate_id\": str(candidate_id),\n            \"run_date\": digest.run_date,\n            \"total_scored\": digest.total_scored,\n            \"hot_count\": len(digest.hot_picks),\n            \"top_score\": digest.top_picks[0].composite_score if digest.top_picks else 0,\n        })\n        await self._redis.publish(_DIGEST_READY_CHANNEL, payload)\n        logger.info(\n            \"digest_builder.event_published\",\n            channel=_DIGEST_READY_CHANNEL,\n            candidate_id=str(candidate_id),\n        )\n","numLines":211,"startLine":1,"totalLines":211}}}}
{"t":"2026-05-20T19:58:56.325Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R6hxp5ygZwGWXp98CNfdPv","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Discovery Orchestrator — coordinates the full daily discovery run.\n     6→\n     7→This is the entry point for both the Celery cron job and the manual API trigger.\n     8→\n     9→Flow:\n    10→  load_candidate(candidate_id)\n    11→    → identity_profiler.build_profile()\n    12→    → archetype_generator.expand()\n    13→    → crawler_agent.run(manifest)           ← currently stubbed\n    14→    → relevance_scorer.score_batch(jobs)\n    15→    → digest_builder.compile(scored_jobs)\n    16→    → emit DIGEST_READY\n    17→\n    18→Concurrency:\n    19→  - Scoring runs with bounded concurrency (CRAWL_CONCURRENCY semaphore)\n    20→  - Digest build follows after all scoring is complete\n    21→\n    22→Status machine:\n    23→  QUEUED → RUNNING → COMPLETED\n    24→                   → FAILED\n    25→\"\"\"\n    26→\n    27→import asyncio\n    28→from datetime import datetime, timezone\n    29→from uuid import UUID\n    30→\n    31→import redis.asyncio as aioredis\n    32→import structlog\n    33→from anthropic import AsyncAnthropic\n    34→from sqlalchemy import select\n    35→from sqlalchemy.ext.asyncio import AsyncSession\n    36→\n    37→from backend.config import settings\n    38→from backend.agents.discovery.schemas import CandidateSchema, DailyDigestSchema\n    39→from backend.agents.discovery.identity_profiler import IdentityProfiler\n    40→from backend.agents.discovery.archetype_generator import ArchetypeGenerator\n    41→from backend.agents.discovery.crawler_agent import CrawlerAgent\n    42→from backend.agents.discovery.relevance_scorer import RelevanceScorer\n    43→from backend.agents.discovery.digest_builder import DigestBuilder\n    44→from backend.models.discovery import Candidate as CandidateORM, CrawlRun\n    45→\n    46→logger = structlog.get_logger(__name__)\n    47→\n    48→\n    49→class DiscoveryOrchestrator:\n    50→    \"\"\"\n    51→    Coordinates the full Discovery Engine pipeline for a single candidate.\n    52→\n    53→    Designed to run once per candidate per day via Celery cron,\n    54→    or on-demand via the API trigger endpoint.\n    55→    \"\"\"\n    56→\n    57→    def __init__(self, db: AsyncSession, redis_client: aioredis.Redis):\n    58→        self._db = db\n    59→        self._redis = redis_client\n    60→        self._claude = AsyncAnthropic(api_key=settings.anthropic_api_key)\n    61→\n    62→        self._profiler = IdentityProfiler(redis_client, self._claude)\n    63→        self._archetype_gen = ArchetypeGenerator()\n    64→        self._scorer = RelevanceScorer(self._claude)\n    65→        self._digest_builder = DigestBuilder(redis_client, self._claude, db)\n    66→\n    67→    async def run(\n    68→        self,\n    69→        candidate_id: UUID,\n    70→        dry_run: bool = False,\n    71→    ) -> DailyDigestSchema:\n    72→        \"\"\"\n    73→        Execute a full daily discovery run for a candidate.\n    74→\n    75→        Args:\n    76→            candidate_id: UUID of the candidate to run for\n    77→            dry_run: If True, don't write to DB or publish events\n    78→\n    79→        Returns:\n    80→            DailyDigestSchema with the full ranked digest\n    81→        \"\"\"\n    82→        crawl_run = await self._start_run(candidate_id, dry_run)\n    83→        log = logger.bind(candidate_id=str(candidate_id), dry_run=dry_run)\n    84→\n    85→        try:\n    86→            # 1. Load candidate\n    87→            candidate = await self._load_candidate(candidate_id)\n    88→            log.info(\"orchestrator.candidate_loaded\", name=candidate.name)\n    89→\n    90→            # 2. Build identity profile (cached 24h)\n    91→            profile = await self._profiler.build_profile(candidate)\n    92→            log.info(\n    93→                \"orchestrator.profile_built\",\n    94→                archetypes=len(profile.role_expansion),\n    95→                level=profile.leadership_level,\n    96→            )\n    97→\n    98→            # 3. Expand archetypes into search manifest\n    99→            excluded = {\n   100→                \"titles\": [],\n   101→                \"companies\": candidate.excluded_companies or [],\n   102→                \"industries\": candidate.excluded_industries or [],\n   103→            }\n   104→            manifest = self._archetype_gen.expand(profile, excluded)\n   105→            log.info(\n   106→                \"orchestrator.manifest_built\",\n   107→                target_titles=len(manifest.target_titles),\n   108→                keywords=len(manifest.keywords),\n   109→            )\n   110→\n   111→            # 4. Crawl (currently stubbed — Phase 1B)\n   112→            crawler = CrawlerAgent(candidate_id)\n   113→            raw_jobs = await crawler.run(manifest)\n   114→            log.info(\"orchestrator.crawl_complete\", jobs_found=len(raw_jobs))\n   115→\n   116→            # 5. Score with bounded concurrency\n   117→            semaphore = asyncio.Semaphore(settings.crawl_concurrency)\n   118→\n   119→            async def score_with_semaphore(job):\n   120→                async with semaphore:\n   121→                    return job\n   122→\n   123→            # Fan out scoring — respect the semaphore so we don't hammer Claude\n   124→            scored_jobs = await self._scorer.score_batch(\n   125→                raw_jobs, profile, min_score=settings.min_score\n   126→            )\n   127→            log.info(\n   128→                \"orchestrator.scoring_complete\",\n   129→                passed=len(scored_jobs),\n   130→                filtered=len(raw_jobs) - len(scored_jobs),\n   131→            )\n   132→\n   133→            # 6. Build and publish digest\n   134→            digest = await self._digest_builder.compile(\n   135→                candidate_id=candidate_id,\n   136→                scored_jobs=scored_jobs,\n   137→                total_discovered=len(raw_jobs),\n   138→            ) if not dry_run else self._build_dry_run_digest(candidate_id, scored_jobs, len(raw_jobs))\n   139→\n   140→            await self._complete_run(crawl_run, len(raw_jobs), len(scored_jobs), dry_run)\n   141→            log.info(\n   142→                \"orchestrator.run_complete\",\n   143→                top_picks=len(digest.top_picks),\n   144→                hot_picks=len(digest.hot_picks),\n   145→            )\n   146→            return digest\n   147→\n   148→        except Exception as e:\n   149→            log.error(\"orchestrator.run_failed\", error=str(e))\n   150→            await self._fail_run(crawl_run, str(e), dry_run)\n   151→            raise\n   152→\n   153→    async def _load_candidate(self, candidate_id: UUID) -> CandidateSchema:\n   154→        \"\"\"Load candidate from PostgreSQL and convert to schema.\"\"\"\n   155→        result = await self._db.execute(\n   156→            select(CandidateORM).where(CandidateORM.id == candidate_id)\n   157→        )\n   158→        orm = result.scalar_one_or_none()\n   159→        if not orm:\n   160→            raise ValueError(f\"Candidate {candidate_id} not found\")\n   161→        return CandidateSchema.model_validate(orm)\n   162→\n   163→    async def _start_run(self, candidate_id: UUID, dry_run: bool) -> CrawlRun | None:\n   164→        \"\"\"Create a CrawlRun record and return it (None in dry_run mode).\"\"\"\n   165→        if dry_run:\n   166→            return None\n   167→        run = CrawlRun(candidate_id=candidate_id, status=\"RUNNING\")\n   168→        self._db.add(run)\n   169→        await self._db.commit()\n   170→        await self._db.refresh(run)\n   171→        return run\n   172→\n   173→    async def _complete_run(\n   174→        self, run: CrawlRun | None, discovered: int, scored: int, dry_run: bool\n   175→    ) -> None:\n   176→        \"\"\"Mark the CrawlRun as COMPLETED.\"\"\"\n   177→        if dry_run or run is None:\n   178→            return\n   179→        run.status = \"COMPLETED\"\n   180→        run.completed_at = datetime.now(timezone.utc)\n   181→        run.jobs_discovered = discovered\n   182→        run.jobs_scored = scored\n   183→        await self._db.commit()\n   184→\n   185→    async def _fail_run(self, run: CrawlRun | None, error: str, dry_run: bool) -> None:\n   186→        \"\"\"Mark the CrawlRun as FAILED with error log.\"\"\"\n   187→        if dry_run or run is None:\n   188→            return\n   189→        run.status = \"FAILED\"\n   190→        run.completed_at = datetime.now(timezone.utc)\n   191→        run.error_log = error\n   192→        await self._db.commit()\n   193→\n   194→    def _build_dry_run_digest(self, candidate_id: UUID, scored_jobs, total_discovered: int):\n   195→        \"\"\"Build an in-memory digest without DB writes — for dry_run mode.\"\"\"\n   196→        from backend.agents.discovery.schemas import DailyDigestSchema\n   197→        from datetime import date\n   198→\n   199→        return DailyDigestSchema(\n   200→            candidate_id=candidate_id,\n   201→            run_date=date.today().isoformat(),\n   202→            total_discovered=total_discovered,\n   203→            total_scored=len(scored_jobs),\n   204→            top_picks=[],\n   205→            hot_picks=[],\n   206→            new_companies=[],\n   207→            digest_summary=\"[dry_run] No data written to DB.\",\n   208→        )\n   209→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"ad28d7e9-1b93-44c5-b07f-443fa223218a","uuid":"ef4b51e8-e24b-43c1-9dde-5efdc5c10d3c","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/discovery/orchestrator.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nDiscovery Orchestrator — coordinates the full daily discovery run.\n\nThis is the entry point for both the Celery cron job and the manual API trigger.\n\nFlow:\n  load_candidate(candidate_id)\n    → identity_profiler.build_profile()\n    → archetype_generator.expand()\n    → crawler_agent.run(manifest)           ← currently stubbed\n    → relevance_scorer.score_batch(jobs)\n    → digest_builder.compile(scored_jobs)\n    → emit DIGEST_READY\n\nConcurrency:\n  - Scoring runs with bounded concurrency (CRAWL_CONCURRENCY semaphore)\n  - Digest build follows after all scoring is complete\n\nStatus machine:\n  QUEUED → RUNNING → COMPLETED\n                   → FAILED\n\"\"\"\n\nimport asyncio\nfrom datetime import datetime, timezone\nfrom uuid import UUID\n\nimport redis.asyncio as aioredis\nimport structlog\nfrom anthropic import AsyncAnthropic\nfrom sqlalchemy import select\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom backend.config import settings\nfrom backend.agents.discovery.schemas import CandidateSchema, DailyDigestSchema\nfrom backend.agents.discovery.identity_profiler import IdentityProfiler\nfrom backend.agents.discovery.archetype_generator import ArchetypeGenerator\nfrom backend.agents.discovery.crawler_agent import CrawlerAgent\nfrom backend.agents.discovery.relevance_scorer import RelevanceScorer\nfrom backend.agents.discovery.digest_builder import DigestBuilder\nfrom backend.models.discovery import Candidate as CandidateORM, CrawlRun\n\nlogger = structlog.get_logger(__name__)\n\n\nclass DiscoveryOrchestrator:\n    \"\"\"\n    Coordinates the full Discovery Engine pipeline for a single candidate.\n\n    Designed to run once per candidate per day via Celery cron,\n    or on-demand via the API trigger endpoint.\n    \"\"\"\n\n    def __init__(self, db: AsyncSession, redis_client: aioredis.Redis):\n        self._db = db\n        self._redis = redis_client\n        self._claude = AsyncAnthropic(api_key=settings.anthropic_api_key)\n\n        self._profiler = IdentityProfiler(redis_client, self._claude)\n        self._archetype_gen = ArchetypeGenerator()\n        self._scorer = RelevanceScorer(self._claude)\n        self._digest_builder = DigestBuilder(redis_client, self._claude, db)\n\n    async def run(\n        self,\n        candidate_id: UUID,\n        dry_run: bool = False,\n    ) -> DailyDigestSchema:\n        \"\"\"\n        Execute a full daily discovery run for a candidate.\n\n        Args:\n            candidate_id: UUID of the candidate to run for\n            dry_run: If True, don't write to DB or publish events\n\n        Returns:\n            DailyDigestSchema with the full ranked digest\n        \"\"\"\n        crawl_run = await self._start_run(candidate_id, dry_run)\n        log = logger.bind(candidate_id=str(candidate_id), dry_run=dry_run)\n\n        try:\n            # 1. Load candidate\n            candidate = await self._load_candidate(candidate_id)\n            log.info(\"orchestrator.candidate_loaded\", name=candidate.name)\n\n            # 2. Build identity profile (cached 24h)\n            profile = await self._profiler.build_profile(candidate)\n            log.info(\n                \"orchestrator.profile_built\",\n                archetypes=len(profile.role_expansion),\n                level=profile.leadership_level,\n            )\n\n            # 3. Expand archetypes into search manifest\n            excluded = {\n                \"titles\": [],\n                \"companies\": candidate.excluded_companies or [],\n                \"industries\": candidate.excluded_industries or [],\n            }\n            manifest = self._archetype_gen.expand(profile, excluded)\n            log.info(\n                \"orchestrator.manifest_built\",\n                target_titles=len(manifest.target_titles),\n                keywords=len(manifest.keywords),\n            )\n\n            # 4. Crawl (currently stubbed — Phase 1B)\n            crawler = CrawlerAgent(candidate_id)\n            raw_jobs = await crawler.run(manifest)\n            log.info(\"orchestrator.crawl_complete\", jobs_found=len(raw_jobs))\n\n            # 5. Score with bounded concurrency\n            semaphore = asyncio.Semaphore(settings.crawl_concurrency)\n\n            async def score_with_semaphore(job):\n                async with semaphore:\n                    return job\n\n            # Fan out scoring — respect the semaphore so we don't hammer Claude\n            scored_jobs = await self._scorer.score_batch(\n                raw_jobs, profile, min_score=settings.min_score\n            )\n            log.info(\n                \"orchestrator.scoring_complete\",\n                passed=len(scored_jobs),\n                filtered=len(raw_jobs) - len(scored_jobs),\n            )\n\n            # 6. Build and publish digest\n            digest = await self._digest_builder.compile(\n                candidate_id=candidate_id,\n                scored_jobs=scored_jobs,\n                total_discovered=len(raw_jobs),\n            ) if not dry_run else self._build_dry_run_digest(candidate_id, scored_jobs, len(raw_jobs))\n\n            await self._complete_run(crawl_run, len(raw_jobs), len(scored_jobs), dry_run)\n            log.info(\n                \"orchestrator.run_complete\",\n                top_picks=len(digest.top_picks),\n                hot_picks=len(digest.hot_picks),\n            )\n            return digest\n\n        except Exception as e:\n            log.error(\"orchestrator.run_failed\", error=str(e))\n            await self._fail_run(crawl_run, str(e), dry_run)\n            raise\n\n    async def _load_candidate(self, candidate_id: UUID) -> CandidateSchema:\n        \"\"\"Load candidate from PostgreSQL and convert to schema.\"\"\"\n        result = await self._db.execute(\n            select(CandidateORM).where(CandidateORM.id == candidate_id)\n        )\n        orm = result.scalar_one_or_none()\n        if not orm:\n            raise ValueError(f\"Candidate {candidate_id} not found\")\n        return CandidateSchema.model_validate(orm)\n\n    async def _start_run(self, candidate_id: UUID, dry_run: bool) -> CrawlRun | None:\n        \"\"\"Create a CrawlRun record and return it (None in dry_run mode).\"\"\"\n        if dry_run:\n            return None\n        run = CrawlRun(candidate_id=candidate_id, status=\"RUNNING\")\n        self._db.add(run)\n        await self._db.commit()\n        await self._db.refresh(run)\n        return run\n\n    async def _complete_run(\n        self, run: CrawlRun | None, discovered: int, scored: int, dry_run: bool\n    ) -> None:\n        \"\"\"Mark the CrawlRun as COMPLETED.\"\"\"\n        if dry_run or run is None:\n            return\n        run.status = \"COMPLETED\"\n        run.completed_at = datetime.now(timezone.utc)\n        run.jobs_discovered = discovered\n        run.jobs_scored = scored\n        await self._db.commit()\n\n    async def _fail_run(self, run: CrawlRun | None, error: str, dry_run: bool) -> None:\n        \"\"\"Mark the CrawlRun as FAILED with error log.\"\"\"\n        if dry_run or run is None:\n            return\n        run.status = \"FAILED\"\n        run.completed_at = datetime.now(timezone.utc)\n        run.error_log = error\n        await self._db.commit()\n\n    def _build_dry_run_digest(self, candidate_id: UUID, scored_jobs, total_discovered: int):\n        \"\"\"Build an in-memory digest without DB writes — for dry_run mode.\"\"\"\n        from backend.agents.discovery.schemas import DailyDigestSchema\n        from datetime import date\n\n        return DailyDigestSchema(\n            candidate_id=candidate_id,\n            run_date=date.today().isoformat(),\n            total_discovered=total_discovered,\n            total_scored=len(scored_jobs),\n            top_picks=[],\n            hot_picks=[],\n            new_companies=[],\n            digest_summary=\"[dry_run] No data written to DB.\",\n        )\n","numLines":209,"startLine":1,"totalLines":209}}}}
