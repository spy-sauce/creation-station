{"t":"2026-05-20T19:59:07.258Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RgS2p6ijkHqLw5F6GuRKcG","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Smoke tests for the RelevanceScorer — scoring math, not Claude API calls.\n     6→\n     7→These tests run fully offline (no Anthropic API, no DB, no Redis).\n     8→\"\"\"\n     9→\n    10→import pytest\n    11→from uuid import uuid4\n    12→\n    13→from backend.agents.discovery.schemas import (\n    14→    IdentityProfile,\n    15→    DiscoveredJobSchema,\n    16→    ScoreBreakdown,\n    17→)\n    18→from backend.agents.discovery.relevance_scorer import RelevanceScorer\n    19→\n    20→\n    21→# ─── Fixtures ─────────────────────────────────────────────────────────────────\n    22→\n    23→@pytest.fixture\n    24→def profile() -> IdentityProfile:\n    25→    \"\"\"A realistic identity profile for Sean Young.\"\"\"\n    26→    return IdentityProfile(\n    27→        candidate_id=uuid4(),\n    28→        technical_skills={\n    29→            \"Python\": 95,\n    30→            \"FastAPI\": 90,\n    31→            \"Java\": 85,\n    32→            \"Spring Boot\": 80,\n    33→            \"PostgreSQL\": 80,\n    34→            \"Redis\": 75,\n    35→            \"Docker\": 75,\n    36→            \"Kubernetes\": 70,\n    37→            \"Claude API\": 85,\n    38→            \"Solana\": 65,\n    39→        },\n    40→        domain_expertise=[\"fintech\", \"ai\", \"web3\", \"music\", \"creator-economy\"],\n    41→        leadership_level=\"founder\",\n    42→        archetype_tags=[\"technical-founder\", \"ai-builder\", \"creative-technologist\"],\n    43→        role_expansion=[\n    44→            \"Head of AI\",\n    45→            \"VP Engineering at music-tech startup\",\n    46→            \"Technical Co-Founder Series A\",\n    47→            \"AI Creative Director\",\n    48→            \"CTO fractional\",\n    49→        ],\n    50→        culture_signals={\n    51→            \"startup_vs_enterprise\": \"startup\",\n    52→            \"remote_preference\": \"remote\",\n    53→            \"mission_vs_comp\": \"mission\",\n    54→        },\n    55→        compensation_band={\"min\": 200_000, \"max\": 350_000},\n    56→        creative_layer=[\"DJ\", \"music producer\", \"Solana developer\"],\n    57→    )\n    58→\n    59→\n    60→@pytest.fixture\n    61→def strong_match_job() -> DiscoveredJobSchema:\n    62→    \"\"\"A job that should score high for this profile.\"\"\"\n    63→    return DiscoveredJobSchema(\n    64→        id=uuid4(),\n    65→        candidate_id=uuid4(),\n    66→        title=\"Head of AI Engineering\",\n    67→        company=\"MusicTech Startup\",\n    68→        location=\"Remote\",\n    69→        url=\"https://example.com/jobs/head-of-ai\",\n    70→        url_hash=\"abc123\",\n    71→        description=\"\"\"\n    72→        We're a Series B music-tech startup building AI tools for creators.\n    73→        Looking for a Head of AI Engineering to define our AI strategy from scratch.\n    74→\n    75→        Required: Python, FastAPI, PostgreSQL, Redis, LLMs, Claude API\n    76→        Preferred: Kubernetes, Solana, Web3\n    77→\n    78→        This is a 0-to-1 greenfield role. You'll shape the technical strategy,\n    79→        build the team from scratch, and report directly to the CTO.\n    80→\n    81→        Compensation: $250,000-$300,000 + equity\n    82→\n    83→        Remote-first. Mission-driven team.\n    84→        Industry: Music, AI, Creator Economy\n    85→        \"\"\",\n    86→        source=\"greenhouse\",\n    87→    )\n    88→\n    89→\n    90→@pytest.fixture\n    91→def weak_match_job() -> DiscoveredJobSchema:\n    92→    \"\"\"A job that should score low for this profile.\"\"\"\n    93→    return DiscoveredJobSchema(\n    94→        id=uuid4(),\n    95→        candidate_id=uuid4(),\n    96→        title=\"Junior Java Developer\",\n    97→        company=\"Big Bank Corp\",\n    98→        location=\"New York, NY (On-site required)\",\n    99→        url=\"https://bigbank.com/jobs/junior-java\",\n   100→        url_hash=\"def456\",\n   101→        description=\"\"\"\n   102→        Entry-level Java developer position. 0-2 years experience preferred.\n   103→        Required: Java basics, SQL\n   104→        On-site 5 days/week in Manhattan.\n   105→        Salary: $65,000 - $80,000\n   106→        Industry: Traditional Banking\n   107→        \"\"\",\n   108→        source=\"indeed\",\n   109→    )\n   110→\n   111→\n   112→# ─── ScoreBreakdown unit tests ────────────────────────────────────────────────\n   113→\n   114→class TestScoreBreakdown:\n   115→    def test_composite_weights_sum_to_full_score(self):\n   116→        \"\"\"All dimensions at 100 should produce composite of 100.\"\"\"\n   117→        breakdown = ScoreBreakdown(\n   118→            technical_match=100,\n   119→            level_match=100,\n   120→            culture_match=100,\n   121→            industry_match=100,\n   122→            growth_potential=100,\n   123→            compensation_match=100,\n   124→        )\n   125→        assert breakdown.composite == 100\n   126→\n   127→    def test_composite_is_weighted(self):\n   128→        \"\"\"Technical match at 100 (30% weight) + zeros = 30.\"\"\"\n   129→        breakdown = ScoreBreakdown(\n   130→            technical_match=100,\n   131→            level_match=0,\n   132→            culture_match=0,\n   133→            industry_match=0,\n   134→            growth_potential=0,\n   135→            compensation_match=0,\n   136→        )\n   137→        assert breakdown.composite == 30\n   138→\n   139→    def test_composite_rounds_down(self):\n   140→        \"\"\"Composite should be an integer.\"\"\"\n   141→        breakdown = ScoreBreakdown(\n   142→            technical_match=50,\n   143→            level_match=50,\n   144→            culture_match=50,\n   145→            industry_match=50,\n   146→            growth_potential=50,\n   147→            compensation_match=50,\n   148→        )\n   149→        assert breakdown.composite == 50\n   150→        assert isinstance(breakdown.composite, int)\n   151→\n   152→    def test_field_bounds(self):\n   153→        \"\"\"Scores outside 0-100 should be rejected by pydantic.\"\"\"\n   154→        import pytest as pt\n   155→        from pydantic import ValidationError\n   156→        with pt.raises(ValidationError):\n   157→            ScoreBreakdown(\n   158→                technical_match=101,\n   159→                level_match=0,\n   160→                culture_match=0,\n   161→                industry_match=0,\n   162→                growth_potential=0,\n   163→                compensation_match=0,\n   164→            )\n   165→\n   166→\n   167→# ─── RelevanceScorer local scoring tests (no Claude) ─────────────────────────\n   168→\n   169→class TestRelevanceScorerLocal:\n   170→    \"\"\"\n   171→    Tests for the local scoring methods that don't require Claude API.\n   172→\n   173→    Instantiates RelevanceScorer with a None client — only _score_* methods\n   174→    that don't call self._claude are tested here.\n   175→    \"\"\"\n   176→\n   177→    @pytest.fixture\n   178→    def scorer(self):\n   179→        return RelevanceScorer(anthropic_client=None)  # type: ignore\n   180→\n   181→    def test_technical_match_high_overlap(self, scorer, profile):\n   182→        parsed_jd = {\n   183→            \"required_skills\": [\"Python\", \"FastAPI\", \"PostgreSQL\", \"Redis\"],\n   184→            \"preferred_skills\": [\"Kubernetes\", \"Docker\"],\n   185→        }\n   186→        score = scorer._score_technical(parsed_jd, profile)\n   187→        assert score >= 80, f\"Expected >= 80, got {score}\"\n   188→\n   189→    def test_technical_match_no_overlap(self, scorer, profile):\n   190→        parsed_jd = {\n   191→            \"required_skills\": [\"COBOL\", \"Fortran\", \"RPGLE\"],\n   192→            \"preferred_skills\": [],\n   193→        }\n   194→        score = scorer._score_technical(parsed_jd, profile)\n   195→        assert score < 30, f\"Expected < 30, got {score}\"\n   196→\n   197→    def test_technical_match_no_requirements(self, scorer, profile):\n   198→        \"\"\"Empty requirements = neutral score.\"\"\"\n   199→        score = scorer._score_technical({}, profile)\n   200→        assert score == 60\n   201→\n   202→    def test_level_match_exact(self, scorer, profile):\n   203→        \"\"\"founder → founder should be 100.\"\"\"\n   204→        parsed_jd = {\"seniority_level\": \"founder\"}\n   205→        score = scorer._score_level(parsed_jd, profile)\n   206→        assert score == 100\n   207→\n   208→    def test_level_match_one_step_off(self, scorer, profile):\n   209→        \"\"\"founder → exec (1 step) should be 80.\"\"\"\n   210→        parsed_jd = {\"seniority_level\": \"exec\"}\n   211→        score = scorer._score_level(parsed_jd, profile)\n   212→        assert score == 80\n   213→\n   214→    def test_level_match_junior_job_for_founder(self, scorer, profile):\n   215→        \"\"\"founder vs junior (many steps) should be low.\"\"\"\n   216→        parsed_jd = {\"seniority_level\": \"junior\"}\n   217→        score = scorer._score_level(parsed_jd, profile)\n   218→        assert score <= 30\n   219→\n   220→    def test_culture_match_remote_alignment(self, scorer, profile):\n   221→        \"\"\"Remote candidate + remote job should score well.\"\"\"\n   222→        from backend.agents.discovery.schemas import DiscoveredJobSchema\n   223→        job = DiscoveredJobSchema(\n   224→            candidate_id=uuid4(),\n   225→            title=\"Test\",\n   226→            company=\"Test Co\",\n   227→            url=\"https://x.com\",\n   228→            url_hash=\"xyz\",\n   229→        )\n   230→        parsed_jd = {\n   231→            \"remote_type\": \"remote\",\n   232→            \"culture_signals\": {\"startup_vs_enterprise\": \"startup\"},\n   233→        }\n   234→        score = scorer._score_culture(parsed_jd, profile, job)\n   235→        assert score >= 80\n   236→\n   237→    def test_culture_match_onsite_penalty(self, scorer, profile):\n   238→        \"\"\"Remote candidate + onsite job should score low.\"\"\"\n   239→        from backend.agents.discovery.schemas import DiscoveredJobSchema\n   240→        job = DiscoveredJobSchema(\n   241→            candidate_id=uuid4(),\n   242→            title=\"Test\",\n   243→            company=\"Test Co\",\n   244→            url=\"https://x.com\",\n   245→            url_hash=\"xyz\",\n   246→        )\n   247→        parsed_jd = {\n   248→            \"remote_type\": \"onsite\",\n   249→            \"culture_signals\": {\"startup_vs_enterprise\": \"enterprise\"},\n   250→        }\n   251→        score = scorer._score_culture(parsed_jd, profile, job)\n   252→        assert score < 40\n   253→\n   254→    def test_compensation_above_minimum(self, scorer, profile):\n   255→        parsed_jd = {\"comp_mentioned\": \"$250,000 - $300,000\"}\n   256→        score = scorer._score_compensation(parsed_jd, profile)\n   257→        assert score == 100\n   258→\n   259→    def test_compensation_below_minimum(self, scorer, profile):\n   260→        parsed_jd = {\"comp_mentioned\": \"$65,000 - $80,000\"}\n   261→        score = scorer._score_compensation(parsed_jd, profile)\n   262→        assert score <= 15\n   263→\n   264→    def test_compensation_not_listed(self, scorer, profile):\n   265→        \"\"\"Senior roles often don't list comp — should be generous neutral.\"\"\"\n   266→        score = scorer._score_compensation({}, profile)\n   267→        assert score >= 70\n   268→\n   269→\n   270→# ─── Archetype generator tests ────────────────────────────────────────────────\n   271→\n   272→class TestArchetypeGenerator:\n   273→    def test_title_expansion_known_archetype(self, profile):\n   274→        from backend.agents.discovery.archetype_generator import ArchetypeGenerator\n   275→        gen = ArchetypeGenerator()\n   276→        manifest = gen.expand(\n   277→            profile,\n   278→            {\"titles\": [], \"companies\": [], \"industries\": []},\n   279→        )\n   280→        assert len(manifest.target_titles) > 0\n   281→        assert len(manifest.keywords) > 0\n   282→\n   283→    def test_company_profile_uses_culture_signals(self, profile):\n   284→        from backend.agents.discovery.archetype_generator import ArchetypeGenerator\n   285→        gen = ArchetypeGenerator()\n   286→        manifest = gen.expand(\n   287→            profile,\n   288→            {\"titles\": [], \"companies\": [], \"industries\": []},\n   289→        )\n   290→        # Startup profile should target early stages\n   291→        assert any(\n   292→            s in manifest.target_company_profile.stages\n   293→            for s in [\"seed\", \"series-a\", \"series-b\"]\n   294→        )\n   295→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"ad28d7e9-1b93-44c5-b07f-443fa223218a","uuid":"dc30c1f3-1821-4b73-bcd4-7626008794c8","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/tests/discovery/test_scorer.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nSmoke tests for the RelevanceScorer — scoring math, not Claude API calls.\n\nThese tests run fully offline (no Anthropic API, no DB, no Redis).\n\"\"\"\n\nimport pytest\nfrom uuid import uuid4\n\nfrom backend.agents.discovery.schemas import (\n    IdentityProfile,\n    DiscoveredJobSchema,\n    ScoreBreakdown,\n)\nfrom backend.agents.discovery.relevance_scorer import RelevanceScorer\n\n\n# ─── Fixtures ─────────────────────────────────────────────────────────────────\n\n@pytest.fixture\ndef profile() -> IdentityProfile:\n    \"\"\"A realistic identity profile for Sean Young.\"\"\"\n    return IdentityProfile(\n        candidate_id=uuid4(),\n        technical_skills={\n            \"Python\": 95,\n            \"FastAPI\": 90,\n            \"Java\": 85,\n            \"Spring Boot\": 80,\n            \"PostgreSQL\": 80,\n            \"Redis\": 75,\n            \"Docker\": 75,\n            \"Kubernetes\": 70,\n            \"Claude API\": 85,\n            \"Solana\": 65,\n        },\n        domain_expertise=[\"fintech\", \"ai\", \"web3\", \"music\", \"creator-economy\"],\n        leadership_level=\"founder\",\n        archetype_tags=[\"technical-founder\", \"ai-builder\", \"creative-technologist\"],\n        role_expansion=[\n            \"Head of AI\",\n            \"VP Engineering at music-tech startup\",\n            \"Technical Co-Founder Series A\",\n            \"AI Creative Director\",\n            \"CTO fractional\",\n        ],\n        culture_signals={\n            \"startup_vs_enterprise\": \"startup\",\n            \"remote_preference\": \"remote\",\n            \"mission_vs_comp\": \"mission\",\n        },\n        compensation_band={\"min\": 200_000, \"max\": 350_000},\n        creative_layer=[\"DJ\", \"music producer\", \"Solana developer\"],\n    )\n\n\n@pytest.fixture\ndef strong_match_job() -> DiscoveredJobSchema:\n    \"\"\"A job that should score high for this profile.\"\"\"\n    return DiscoveredJobSchema(\n        id=uuid4(),\n        candidate_id=uuid4(),\n        title=\"Head of AI Engineering\",\n        company=\"MusicTech Startup\",\n        location=\"Remote\",\n        url=\"https://example.com/jobs/head-of-ai\",\n        url_hash=\"abc123\",\n        description=\"\"\"\n        We're a Series B music-tech startup building AI tools for creators.\n        Looking for a Head of AI Engineering to define our AI strategy from scratch.\n\n        Required: Python, FastAPI, PostgreSQL, Redis, LLMs, Claude API\n        Preferred: Kubernetes, Solana, Web3\n\n        This is a 0-to-1 greenfield role. You'll shape the technical strategy,\n        build the team from scratch, and report directly to the CTO.\n\n        Compensation: $250,000-$300,000 + equity\n\n        Remote-first. Mission-driven team.\n        Industry: Music, AI, Creator Economy\n        \"\"\",\n        source=\"greenhouse\",\n    )\n\n\n@pytest.fixture\ndef weak_match_job() -> DiscoveredJobSchema:\n    \"\"\"A job that should score low for this profile.\"\"\"\n    return DiscoveredJobSchema(\n        id=uuid4(),\n        candidate_id=uuid4(),\n        title=\"Junior Java Developer\",\n        company=\"Big Bank Corp\",\n        location=\"New York, NY (On-site required)\",\n        url=\"https://bigbank.com/jobs/junior-java\",\n        url_hash=\"def456\",\n        description=\"\"\"\n        Entry-level Java developer position. 0-2 years experience preferred.\n        Required: Java basics, SQL\n        On-site 5 days/week in Manhattan.\n        Salary: $65,000 - $80,000\n        Industry: Traditional Banking\n        \"\"\",\n        source=\"indeed\",\n    )\n\n\n# ─── ScoreBreakdown unit tests ────────────────────────────────────────────────\n\nclass TestScoreBreakdown:\n    def test_composite_weights_sum_to_full_score(self):\n        \"\"\"All dimensions at 100 should produce composite of 100.\"\"\"\n        breakdown = ScoreBreakdown(\n            technical_match=100,\n            level_match=100,\n            culture_match=100,\n            industry_match=100,\n            growth_potential=100,\n            compensation_match=100,\n        )\n        assert breakdown.composite == 100\n\n    def test_composite_is_weighted(self):\n        \"\"\"Technical match at 100 (30% weight) + zeros = 30.\"\"\"\n        breakdown = ScoreBreakdown(\n            technical_match=100,\n            level_match=0,\n            culture_match=0,\n            industry_match=0,\n            growth_potential=0,\n            compensation_match=0,\n        )\n        assert breakdown.composite == 30\n\n    def test_composite_rounds_down(self):\n        \"\"\"Composite should be an integer.\"\"\"\n        breakdown = ScoreBreakdown(\n            technical_match=50,\n            level_match=50,\n            culture_match=50,\n            industry_match=50,\n            growth_potential=50,\n            compensation_match=50,\n        )\n        assert breakdown.composite == 50\n        assert isinstance(breakdown.composite, int)\n\n    def test_field_bounds(self):\n        \"\"\"Scores outside 0-100 should be rejected by pydantic.\"\"\"\n        import pytest as pt\n        from pydantic import ValidationError\n        with pt.raises(ValidationError):\n            ScoreBreakdown(\n                technical_match=101,\n                level_match=0,\n                culture_match=0,\n                industry_match=0,\n                growth_potential=0,\n                compensation_match=0,\n            )\n\n\n# ─── RelevanceScorer local scoring tests (no Claude) ─────────────────────────\n\nclass TestRelevanceScorerLocal:\n    \"\"\"\n    Tests for the local scoring methods that don't require Claude API.\n\n    Instantiates RelevanceScorer with a None client — only _score_* methods\n    that don't call self._claude are tested here.\n    \"\"\"\n\n    @pytest.fixture\n    def scorer(self):\n        return RelevanceScorer(anthropic_client=None)  # type: ignore\n\n    def test_technical_match_high_overlap(self, scorer, profile):\n        parsed_jd = {\n            \"required_skills\": [\"Python\", \"FastAPI\", \"PostgreSQL\", \"Redis\"],\n            \"preferred_skills\": [\"Kubernetes\", \"Docker\"],\n        }\n        score = scorer._score_technical(parsed_jd, profile)\n        assert score >= 80, f\"Expected >= 80, got {score}\"\n\n    def test_technical_match_no_overlap(self, scorer, profile):\n        parsed_jd = {\n            \"required_skills\": [\"COBOL\", \"Fortran\", \"RPGLE\"],\n            \"preferred_skills\": [],\n        }\n        score = scorer._score_technical(parsed_jd, profile)\n        assert score < 30, f\"Expected < 30, got {score}\"\n\n    def test_technical_match_no_requirements(self, scorer, profile):\n        \"\"\"Empty requirements = neutral score.\"\"\"\n        score = scorer._score_technical({}, profile)\n        assert score == 60\n\n    def test_level_match_exact(self, scorer, profile):\n        \"\"\"founder → founder should be 100.\"\"\"\n        parsed_jd = {\"seniority_level\": \"founder\"}\n        score = scorer._score_level(parsed_jd, profile)\n        assert score == 100\n\n    def test_level_match_one_step_off(self, scorer, profile):\n        \"\"\"founder → exec (1 step) should be 80.\"\"\"\n        parsed_jd = {\"seniority_level\": \"exec\"}\n        score = scorer._score_level(parsed_jd, profile)\n        assert score == 80\n\n    def test_level_match_junior_job_for_founder(self, scorer, profile):\n        \"\"\"founder vs junior (many steps) should be low.\"\"\"\n        parsed_jd = {\"seniority_level\": \"junior\"}\n        score = scorer._score_level(parsed_jd, profile)\n        assert score <= 30\n\n    def test_culture_match_remote_alignment(self, scorer, profile):\n        \"\"\"Remote candidate + remote job should score well.\"\"\"\n        from backend.agents.discovery.schemas import DiscoveredJobSchema\n        job = DiscoveredJobSchema(\n            candidate_id=uuid4(),\n            title=\"Test\",\n            company=\"Test Co\",\n            url=\"https://x.com\",\n            url_hash=\"xyz\",\n        )\n        parsed_jd = {\n            \"remote_type\": \"remote\",\n            \"culture_signals\": {\"startup_vs_enterprise\": \"startup\"},\n        }\n        score = scorer._score_culture(parsed_jd, profile, job)\n        assert score >= 80\n\n    def test_culture_match_onsite_penalty(self, scorer, profile):\n        \"\"\"Remote candidate + onsite job should score low.\"\"\"\n        from backend.agents.discovery.schemas import DiscoveredJobSchema\n        job = DiscoveredJobSchema(\n            candidate_id=uuid4(),\n            title=\"Test\",\n            company=\"Test Co\",\n            url=\"https://x.com\",\n            url_hash=\"xyz\",\n        )\n        parsed_jd = {\n            \"remote_type\": \"onsite\",\n            \"culture_signals\": {\"startup_vs_enterprise\": \"enterprise\"},\n        }\n        score = scorer._score_culture(parsed_jd, profile, job)\n        assert score < 40\n\n    def test_compensation_above_minimum(self, scorer, profile):\n        parsed_jd = {\"comp_mentioned\": \"$250,000 - $300,000\"}\n        score = scorer._score_compensation(parsed_jd, profile)\n        assert score == 100\n\n    def test_compensation_below_minimum(self, scorer, profile):\n        parsed_jd = {\"comp_mentioned\": \"$65,000 - $80,000\"}\n        score = scorer._score_compensation(parsed_jd, profile)\n        assert score <= 15\n\n    def test_compensation_not_listed(self, scorer, profile):\n        \"\"\"Senior roles often don't list comp — should be generous neutral.\"\"\"\n        score = scorer._score_compensation({}, profile)\n        assert score >= 70\n\n\n# ─── Archetype generator tests ────────────────────────────────────────────────\n\nclass TestArchetypeGenerator:\n    def test_title_expansion_known_archetype(self, profile):\n        from backend.agents.discovery.archetype_generator import ArchetypeGenerator\n        gen = ArchetypeGenerator()\n        manifest = gen.expand(\n            profile,\n            {\"titles\": [], \"companies\": [], \"industries\": []},\n        )\n        assert len(manifest.target_titles) > 0\n        assert len(manifest.keywords) > 0\n\n    def test_company_profile_uses_culture_signals(self, profile):\n        from backend.agents.discovery.archetype_generator import ArchetypeGenerator\n        gen = ArchetypeGenerator()\n        manifest = gen.expand(\n            profile,\n            {\"titles\": [], \"companies\": [], \"industries\": []},\n        )\n        # Startup profile should target early stages\n        assert any(\n            s in manifest.target_company_profile.stages\n            for s in [\"seed\", \"series-a\", \"series-b\"]\n        )\n","numLines":295,"startLine":1,"totalLines":295}}}}
