    run_date: str = Field(description=\"ISO date: YYYY-MM-DD\")\n   208→    top_picks: list[ScoredJobSchema] = Field(default_factory=list)\n   209→    hot_picks: list[ScoredJobSchema] = Field(default_factory=list)\n   210→    new_companies: list[str] = Field(default_factory=list)\n   211→    total_jobs_discovered: int = 0\n   212→    total_jobs_scored: int = 0\n   213→    created_at: Optional[datetime] = None\n   214→"}]},"parent_tool_use_id":null,"session_id":"ad28d7e9-1b93-44c5-b07f-443fa223218a","uuid":"3ec9a95e-a67d-4e97-bad2-677c0b5d222d","tool_use_result":{"type":"update","filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/discovery/schemas.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nPydantic v2 schemas for the Discovery Engine.\n\nThese are the data contracts between agents — separate from ORM models.\nAligns with NUTRIENTS.md DATA_CONTRACTS.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import datetime\nfrom typing import Optional\nfrom uuid import UUID\n\nfrom pydantic import BaseModel, Field, ConfigDict, computed_field\n\n\n# ─── Candidate ────────────────────────────────────────────────────────────────\n\n\nclass CandidateSchema(BaseModel):\n    \"\"\"Full candidate profile used as input to the Discovery Engine.\"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: UUID\n    name: str\n    email: str\n    resume_text: str\n    linkedin_url: Optional[str] = None\n    github_url: Optional[str] = None\n    personal_context: Optional[str] = None\n    target_locations: list[str] = Field(default_factory=list)\n    remote_preference: str = \"flexible\"\n    min_compensation: Optional[int] = None\n    excluded_companies: list[str] = Field(default_factory=list)\n    excluded_industries: list[str] = Field(default_factory=list)\n    created_at: Optional[datetime] = None\n    updated_at: Optional[datetime] = None\n\n\n# ─── Identity Profile ─────────────────────────────────────────────────────────\n\n\nclass IdentityProfileSchema(BaseModel):\n    \"\"\"\n    Multi-dimensional identity model for a candidate.\n\n    Generated by IdentityProfiler — the foundation of the entire discovery run.\n    Cached in Redis for 24h.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.IdentityProfile.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    archetypes: list[str] = Field(default_factory=list)\n    leadership_level: str = Field(\n        default=\"IC\",\n        description=\"IC | Lead | Manager | Director | VP | C-Level\",\n    )\n    technical_skills: list[str] = Field(default_factory=list)\n    soft_skills: list[str] = Field(default_factory=list)\n    industry_experience: list[str] = Field(default_factory=list)\n    notable_achievements: list[str] = Field(default_factory=list)\n    career_trajectory: str = \"\"\n    ideal_role_description: str = \"\"\n    signals: dict[str, str] = Field(default_factory=dict)\n\n\n# ─── Search Manifest ─────────────────────────────────────────────────────────\n\n\nclass SearchManifestSchema(BaseModel):\n    \"\"\"\n    Search instructions derived from an IdentityProfile.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.SearchManifest.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    target_titles: list[str] = Field(default_factory=list)\n    keywords: list[str] = Field(default_factory=list)\n    excluded_titles: list[str] = Field(default_factory=list)\n    excluded_companies: list[str] = Field(default_factory=list)\n    excluded_industries: list[str] = Field(default_factory=list)\n    location_filters: list[str] = Field(default_factory=list)\n    remote_preference: str = \"flexible\"\n    min_compensation: Optional[int] = None\n\n\n# ─── Discovered Job ───────────────────────────────────────────────────────────\n\n\nclass DiscoveredJobSchema(BaseModel):\n    \"\"\"\n    Raw job data from a crawl — before scoring.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.DiscoveredJob.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    source: str\n    source_id: str\n    title: str\n    company: str\n    location: Optional[str] = None\n    description: Optional[str] = None\n    url: str\n    posted_at: Optional[datetime] = None\n    salary_min: Optional[int] = None\n    salary_max: Optional[int] = None\n    remote: bool = False\n    crawled_at: Optional[datetime] = None\n\n\n# ─── Score Breakdown ─────────────────────────────────────────────────────────\n\n\nclass ScoreBreakdown(BaseModel):\n    \"\"\"\n    Dimension-level score breakdown (0-100 per dimension).\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.ScoreBreakdown.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    technical_match: int = Field(ge=0, le=100)\n    level_match: int = Field(ge=0, le=100)\n    culture_match: int = Field(ge=0, le=100)\n    industry_match: int = Field(ge=0, le=100)\n    growth_potential: int = Field(ge=0, le=100)\n    compensation_match: int = Field(ge=0, le=100)\n\n    @computed_field\n    @property\n    def composite(self) -> int:\n        \"\"\"\n        Weighted composite score.\n\n        Weights (sum to 100%):\n          - technical_match: 30%\n          - level_match: 20%\n          - culture_match: 15%\n          - industry_match: 15%\n          - growth_potential: 10%\n          - compensation_match: 10%\n        \"\"\"\n        return int(\n            self.technical_match * 0.30\n            + self.level_match * 0.20\n            + self.culture_match * 0.15\n            + self.industry_match * 0.15\n            + self.growth_potential * 0.10\n            + self.compensation_match * 0.10\n        )\n\n\n# ─── Scored Job ───────────────────────────────────────────────────────────────\n\n\nclass ScoredJobSchema(BaseModel):\n    \"\"\"\n    A discovered job with full scoring breakdown and reasoning.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.ScoredJob.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    discovered_job_id: UUID\n    candidate_id: UUID\n    score_breakdown: ScoreBreakdown\n    composite_score: int = Field(ge=0, le=100)\n    is_hot: bool = False\n    reasoning: str\n    scored_at: Optional[datetime] = None\n\n    # Denormalized job fields for digest display\n    title: str = \"\"\n    company: str = \"\"\n    location: Optional[str] = None\n    url: str = \"\"\n\n\n# ─── Daily Digest ─────────────────────────────────────────────────────────────\n\n\nclass DailyDigestSchema(BaseModel):\n    \"\"\"\n    Full daily digest — persisted to DB and published to Redis.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.DailyDigest.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    candidate_id: UUID\n    run_date: str = Field(description=\"ISO date: YYYY-MM-DD\")\n    top_picks: list[ScoredJobSchema] = Field(default_factory=list)\n    hot_picks: list[ScoredJobSchema] = Field(default_factory=list)\n    new_companies: list[str] = Field(default_factory=list)\n    total_jobs_discovered: int = 0\n    total_jobs_scored: int = 0\n    created_at: Optional[datetime] = None\n","structuredPatch":[{"oldStart":5,"oldLines":6,"newStart":5,"newLines":7,"lines":[" Pydantic v2 schemas for the Discovery Engine."," "," These are the data contracts between agents — separate from ORM models.","+Aligns with NUTRIENTS.md DATA_CONTRACTS."," \"\"\""," "," from __future__ import annotations"]},{"oldStart":13,"oldLines":7,"newStart":14,"newLines":7,"lines":[" from typing import Optional"," from uuid import UUID"," ","-from pydantic import BaseModel, Field, ConfigDict","+from pydantic import BaseModel, Field, ConfigDict, computed_field"," "," "," # ─── Candidate ────────────────────────────────────────────────────────────────"]},{"oldStart":49,"oldLines":6,"newStart":50,"newLines":8,"lines":[" ","     Generated by IdentityProfiler — the foundation of the entire discovery run.","     Cached in Redis for 24h.","+","+    Matches NUTRIENTS.md DATA_CONTRACTS.IdentityProfile.","     \"\"\""," ","     model_config = ConfigDict(from_attributes=True)"]},{"oldStart":71,"oldLines":8,"newStart":74,"newLines":12,"lines":[" "," "," class SearchManifestSchema(BaseModel):","-    \"\"\"Search instructions derived from an IdentityProfile.\"\"\"","+    \"\"\"","+    Search instructions derived from an IdentityProfile."," ","+    Matches NUTRIENTS.md DATA_CONTRACTS.SearchManifest.","+    \"\"\"","+","     model_config = ConfigDict(from_attributes=True)"," ","     target_titles: list[str] = Field(default_factory=list)"]},{"oldStart":89,"oldLines":8,"newStart":96,"newLines":12,"lines":[" "," "," class DiscoveredJobSchema(BaseModel):","-    \"\"\"Raw job data from a crawl — before scoring.\"\"\"","+    \"\"\"","+    Raw job data from a crawl — before scoring."," ","+    Matches NUTRIENTS.md DATA_CONTRACTS.DiscoveredJob.","+    \"\"\"","+","     model_config = ConfigDict(from_attributes=True)"," ","     id: Optional[UUID] = None"]},{"oldStart":112,"oldLines":8,"newStart":123,"newLines":12,"lines":[" "," "," class ScoreBreakdown(BaseModel):","-    \"\"\"Dimension-level score breakdown (0-100 per dimension).\"\"\"","+    \"\"\"","+    Dimension-level score breakdown (0-100 per dimension)."," ","+    Matches NUTRIENTS.md DATA_CONTRACTS.ScoreBreakdown.","+    \"\"\"","+","     model_config = ConfigDict(from_attributes=True)"," ","     technical_match: int = Field(ge=0, le=100)"]},{"oldStart":123,"oldLines":13,"newStart":138,"newLines":40,"lines":["     growth_potential: int = Field(ge=0, le=100)","     compensation_match: int = Field(ge=0, le=100)"," ","+    @computed_field","+    @property","+    def composite(self) -> int:","+        \"\"\"","+        Weighted composite score."," ","+        Weights (sum to 100%):","+          - technical_match: 30%","+          - level_match: 20%","+          - culture_match: 15%","+          - industry_match: 15%","+          - growth_potential: 10%","+          - compensation_match: 10%","+        \"\"\"","+        return int(","+            self.technical_match * 0.30","+            + self.level_match * 0.20","+            + self.culture_match * 0.15","+            + self.industry_match * 0.15","+            + self.growth_potential * 0.10","+            + self.compensation_match * 0.10","+        )","+","+"," # ─── Scored Job ───────────────────────────────────────────────────────────────"," "," "," class ScoredJobSchema(BaseModel):","-    \"\"\"A discovered job with full scoring breakdown and reasoning.\"\"\"","+    \"\"\"","+    A discovered job with full scoring breakdown and reasoning."," ","+    Matches NUTRIENTS.md DATA_CONTRACTS.ScoredJob.","+    \"\"\"","+","     model_config = ConfigDict(from_attributes=True)"," ","     id: Optional[UUID] = None"]},{"oldStart":141,"oldLines":13,"newStart":183,"newLines":23,"lines":["     reasoning: str","     scored_at: Optional[datetime] = None"," ","+    # Denormalized job fields for digest display","+    title: str = \"\"","+    company: str = \"\"","+    location: Optional[str] = None","+    url: str = \"\""," ","+"," # ─── Daily Digest ─────────────────────────────────────────────────────────────"," "," "," class DailyDigestSchema(BaseModel):","-    \"\"\"Full daily digest — persisted to DB and published to Redis.\"\"\"","+    \"\"\"","+    Full daily digest — persisted to DB and published to Redis."," ","+    Matches NUTRIENTS.md DATA_CONTRACTS.DailyDigest.","+    \"\"\"","+","     model_config = ConfigDict(from_attributes=True)"," ","     id: Optional[UUID] = None"]}],"originalFile":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nPydantic v2 schemas for the Discovery Engine.\n\nThese are the data contracts between agents — separate from ORM models.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import datetime\nfrom typing import Optional\nfrom uuid import UUID\n\nfrom pydantic import BaseModel, Field, ConfigDict\n\n\n# ─── Candidate ────────────────────────────────────────────────────────────────\n\n\nclass CandidateSchema(BaseModel):\n    \"\"\"Full candidate profile used as input to the Discovery Engine.\"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: UUID\n    name: str\n    email: str\n    resume_text: str\n    linkedin_url: Optional[str] = None\n    github_url: Optional[str] = None\n    personal_context: Optional[str] = None\n    target_locations: list[str] = Field(default_factory=list)\n    remote_preference: str = \"flexible\"\n    min_compensation: Optional[int] = None\n    excluded_companies: list[str] = Field(default_factory=list)\n    excluded_industries: list[str] = Field(default_factory=list)\n    created_at: Optional[datetime] = None\n    updated_at: Optional[datetime] = None\n\n\n# ─── Identity Profile ─────────────────────────────────────────────────────────\n\n\nclass IdentityProfileSchema(BaseModel):\n    \"\"\"\n    Multi-dimensional identity model for a candidate.\n\n    Generated by IdentityProfiler — the foundation of the entire discovery run.\n    Cached in Redis for 24h.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    archetypes: list[str] = Field(default_factory=list)\n    leadership_level: str = Field(\n        default=\"IC\",\n        description=\"IC | Lead | Manager | Director | VP | C-Level\",\n    )\n    technical_skills: list[str] = Field(default_factory=list)\n    soft_skills: list[str] = Field(default_factory=list)\n    industry_experience: list[str] = Field(default_factory=list)\n    notable_achievements: list[str] = Field(default_factory=list)\n    career_trajectory: str = \"\"\n    ideal_role_description: str = \"\"\n    signals: dict[str, str] = Field(default_factory=dict)\n\n\n# ─── Search Manifest ─────────────────────────────────────────────────────────\n\n\nclass SearchManifestSchema(BaseModel):\n    \"\"\"Search instructions derived from an IdentityProfile.\"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    target_titles: list[str] = Field(default_factory=list)\n    keywords: list[str] = Field(default_factory=list)\n    excluded_titles: list[str] = Field(default_factory=list)\n    excluded_companies: list[str] = Field(default_factory=list)\n    excluded_industries: list[str] = Field(default_factory=list)\n    location_filters: list[str] = Field(default_factory=list)\n    remote_preference: str = \"flexible\"\n    min_compensation: Optional[int] = None\n\n\n# ─── Discovered Job ───────────────────────────────────────────────────────────\n\n\nclass DiscoveredJobSchema(BaseModel):\n    \"\"\"Raw job data from a crawl — before scoring.\"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    source: str\n    source_id: str\n    title: str\n    company: str\n    location: Optional[str] = None\n    description: Optional[str] = None\n    url: str\n    posted_at: Optional[datetime] = None\n    salary_min: Optional[int] = None\n    salary_max: Optional[int] = None\n    remote: bool = False\n    crawled_at: Optional[datetime] = None\n\n\n# ─── Score Breakdown ─────────────────────────────────────────────────────────\n\n\nclass ScoreBreakdown(BaseModel):\n    \"\"\"Dimension-level score breakdown (0-100 per dimension).\"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    technical_match: int = Field(ge=0, le=100)\n    level_match: int = Field(ge=0, le=100)\n    culture_match: int = Field(ge=0, le=100)\n    industry_match: int = Field(ge=0, le=100)\n    growth_potential: int = Field(ge=0, le=100)\n    compensation_match: int = Field(ge=0, le=100)\n\n\n# ─── Scored Job ───────────────────────────────────────────────────────────────\n\n\nclass ScoredJobSchema(BaseModel):\n    \"\"\"A discovered job with full scoring breakdown and reasoning.\"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    discovered_job_id: UUID\n    candidate_id: UUID\n    score_breakdown: ScoreBreakdown\n    composite_score: int = Field(ge=0, le=100)\n    is_hot: bool = False\n    reasoning: str\n    scored_at: Optional[datetime] = None\n\n\n# ─── Daily Digest ─────────────────────────────────────────────────────────────\n\n\nclass DailyDigestSchema(BaseModel):\n    \"\"\"Full daily digest — persisted to DB and published to Redis.\"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    candidate_id: UUID\n    run_date: str = Field(description=\"ISO date: YYYY-MM-DD\")\n    top_picks: list[ScoredJobSchema] = Field(default_factory=list)\n    hot_picks: list[ScoredJobSchema] = Field(default_factory=list)\n    new_companies: list[str] = Field(default_factory=list)\n    total_jobs_discovered: int = 0\n    total_jobs_scored: int = 0\n    created_at: Optional[datetime] = None\n"}}}
