ile, scores, composite)\n   154→\n   155→        return ScoredJobSchema(\n   156→            id=uuid4(),\n   157→            discovered_job_id=job.id or uuid4(),\n   158→            candidate_id=candidate_id,\n   159→            score_breakdown=scores,\n   160→            composite_score=composite,\n   161→            is_hot=is_hot,\n   162→            reasoning=reasoning,\n   163→            scored_at=datetime.now(timezone.utc),\n   164→            # Denormalized job fields for digest display\n   165→            title=job.title,\n   166→            company=job.company,\n   167→            location=job.location,\n   168→            url=job.url,\n   169→        )\n   170→\n   171→    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n   172→    async def _parse_jd(self, job: DiscoveredJobSchema) -> dict:\n   173→        \"\"\"Use Claude to extract structured requirements from a job description.\"\"\"\n   174→        if not job.description:\n   175→            return {}\n   176→\n   177→        prompt = f\"\"\"Extract structured data from this job description. Return ONLY valid JSON, no markdown:\n   178→\n   179→Job Title: {job.title}\n   180→Company: {job.company}\n   181→Location: {job.location or \"Not specified\"}\n   182→\n   183→Description:\n   184→{job.description[:3000]}\n   185→\n   186→Return this exact JSON structure:\n   187→{{\n   188→  \"required_skills\": [\"<skill1>\", \"<skill2>\"],\n   189→  \"preferred_skills\": [\"<skill1>\"],\n   190→  \"seniority_level\": \"<intern|junior|mid|senior|staff|principal|lead|manager|director|vp|head|exec>\",\n   191→  \"remote_type\": \"<remote|hybrid|onsite|flexible>\",\n   192→  \"industries\": [\"<industry1>\"],\n   193→  \"comp_mentioned\": \"<salary string or null>\",\n   194→  \"culture_signals\": {{\n   195→    \"startup_vs_enterprise\": \"<startup|enterprise|both>\",\n   196→    \"mission_driven\": true\n   197→  }},\n   198→  \"growth_indicators\": [\"<indicator1>\"]\n   199→}}\"\"\"\n   200→\n   201→        response = await self._claude.messages.create(\n   202→            model=\"claude-sonnet-4-20250514\",\n   203→            max_tokens=1024,\n   204→            messages=[{\"role\": \"user\", \"content\": prompt}],\n   205→        )\n   206→\n   207→        raw = response.content[0].text.strip()\n   208→        try:\n   209→            return json.loads(raw)\n   210→        except json.JSONDecodeError:\n   211→            match = re.search(r\"\\{.*\\}\", raw, re.DOTALL)\n   212→            return json.loads(match.group()) if match else {}\n   213→\n   214→    def _compute_scores(\n   215→        self,\n   216→        parsed_jd: dict,\n   217→        profile: IdentityProfileSchema,\n   218→        job: DiscoveredJobSchema,\n   219→    ) -> ScoreBreakdown:\n   220→        \"\"\"Compute all six scoring dimensions locally.\"\"\"\n   221→        return ScoreBreakdown(\n   222→            technical_match=self._score_technical(parsed_jd, profile),\n   223→            level_match=self._score_level(parsed_jd, profile),\n   224→            culture_match=self._score_culture(parsed_jd, profile, job),\n   225→            industry_match=self._score_industry(parsed_jd, profile),\n   226→            growth_potential=self._score_growth(parsed_jd, profile),\n   227→            compensation_match=self._score_compensation(parsed_jd, profile),\n   228→        )\n   229→\n   230→    def _score_technical(\n   231→        self, parsed_jd: dict, profile: IdentityProfileSchema\n   232→    ) -> int:\n   233→        \"\"\"Score based on skills overlap between JD requirements and candidate skills.\"\"\"\n   234→        required = {s.lower() for s in parsed_jd.get(\"required_skills\", [])}\n   235→        preferred = {s.lower() for s in parsed_jd.get(\"preferred_skills\", [])}\n   236→        candidate_skills = {s.lower() for s in profile.technical_skills}\n   237→\n   238→        if not required:\n   239→            return 60  # No requirements listed — neutral score\n   240→\n   241→        required_hits = len(required & candidate_skills)\n   242→        preferred_hits = len(preferred & candidate_skills)\n   243→\n   244→        required_ratio = required_hits / len(required) if required else 0\n   245→        preferred_bonus = min(20, preferred_hits * 4) if preferred else 0\n   246→\n   247→        base = int(required_ratio * 80)\n   248→        return min(100, base + preferred_bonus)\n   249→\n   250→    def _score_level(self, parsed_jd: dict, profile: IdentityProfileSchema) -> int:\n   251→        \"\"\"Score seniority alignment — penalise both under and over.\"\"\"\n   252→        jd_level = parsed_jd.get(\"seniority_level\", \"\").lower()\n   253→        candidate_level = _LEADERSHIP_TO_LADDER.get(\n   254→            profile.leadership_level, \"senior\"\n   255→        )\n   256→\n   257→        try:\n   258→            jd_idx = _SENIORITY_LADDER.index(jd_level)\n   259→        except ValueError:\n   260→            return 70  # Unknown level — generous neutral\n   261→\n   262→        try:\n   263→            candidate_idx = _SENIORITY_LADDER.index(candidate_level)\n   264→        except ValueError:\n   265→            return 70\n   266→\n   267→        diff = abs(jd_idx - candidate_idx)\n   268→        if diff == 0:\n   269→            return 100\n   270→        elif diff == 1:\n   271→            return 80\n   272→        elif diff == 2:\n   273→            return 55\n   274→        elif diff == 3:\n   275→            return 30\n   276→        else:\n   277→            return 10\n   278→\n   279→    def _score_culture(\n   280→        self,\n   281→        parsed_jd: dict,\n   282→        profile: IdentityProfileSchema,\n   283→        job: DiscoveredJobSchema,\n   284→    ) -> int:\n   285→        \"\"\"Score culture alignment: startup/enterprise + remote preference.\"\"\"\n   286→        score = 60  # default neutral\n   287→\n   288→        # Startup vs enterprise alignment\n   289→        jd_type = parsed_jd.get(\"culture_signals\", {}).get(\n   290→            \"startup_vs_enterprise\", \"\"\n   291→        )\n   292→        candidate_pref = profile.signals.get(\"startup_vs_enterprise\", \"both\")\n   293→        if jd_type and candidate_pref != \"both\":\n   294→            if jd_type == candidate_pref:\n   295→                score += 20\n   296→            else:\n   297→                score -= 20\n   298→\n   299→        # Remote alignment\n   300→        jd_remote = parsed_jd.get(\"remote_type\", \"\")\n   301→        candidate_remote = profile.signals.get(\"remote_preference\", \"flexible\")\n   302→        if jd_remote and candidate_remote != \"flexible\":\n   303→            if jd_remote == candidate_remote:\n   304→                score += 20\n   305→            elif jd_remote == \"onsite\" and candidate_remote == \"remote\":\n   306→                score -= 30\n   307→            else:\n   308→                score -= 10\n   309→\n   310→        return max(0, min(100, score))\n   311→\n   312→    def _score_industry(\n   313→        self, parsed_jd: dict, profile: IdentityProfileSchema\n   314→    ) -> int:\n   315→        \"\"\"Score how well the job's industries align with the candidate's domain expertise.\"\"\"\n   316→        jd_industries = {i.lower() for i in parsed_jd.get(\"industries\", [])}\n   317→        candidate_domains = {d.lower() for d in profile.industry_experience}\n   318→\n   319→        if not jd_industries:\n   320→            return 60\n   321→\n   322→        overlap = len(jd_industries & candidate_domains)\n   323→        if overlap >= 2:\n   324→            return 100\n   325→        elif overlap == 1:\n   326→            return 75\n   327→        else:\n   328→            return 35\n   329→\n   330→    def _score_growth(\n   331→        self, parsed_jd: dict, profile: IdentityProfileSchema\n   332→    ) -> int:\n   333→        \"\"\"Score whether this role expands the candidate's trajectory.\"\"\"\n   334→        indicators = parsed_jd.get(\"growth_indicators\", [])\n   335→        growth_keywords = {\n   336→            \"build from scratch\",\n   337→            \"greenfield\",\n   338→            \"founding\",\n   339→            \"new team\",\n   340→            \"technical strategy\",\n   341→            \"shape the\",\n   342→            \"lead the\",\n   343→            \"define the\",\n   344→            \"architect\",\n   345→            \"platform\",\n   346→            \"0 to 1\",\n   347→        }\n   348→\n   349→        indicator_text = \" \".join(indicators).lower()\n   350→        matches = sum(1 for kw in growth_keywords if kw in indicator_text)\n   351→\n   352→        if matches >= 3:\n   353→            return 90\n   354→        elif matches >= 1:\n   355→            return 70\n   356→        else:\n   357→            return 50\n   358→\n   359→    def _score_compensation(\n   360→        self, parsed_jd: dict, profile: IdentityProfileSchema\n   361→    ) -> int:\n   362→        \"\"\"Score comp alignment — generous when comp isn't mentioned.\"\"\"\n   363→        comp_str = parsed_jd.get(\"comp_mentioned\")\n   364→        if not comp_str:\n   365→            return 75  # No comp listed is common for senior/exec roles\n   366→\n   367→        # Extract numbers from comp string\n   368→        numbers = re.findall(r\"\\d[\\d,]*\", comp_str.replace(\",\", \"\"))\n   369→        if not numbers:\n   370→            return 70\n   371→\n   372→        amounts = [int(n) for n in numbers if len(n) <= 7]  # filter out noise\n   373→        if not amounts:\n   374→            return 70\n   375→\n   376→        # Without candidate min, return neutral\n   377→        return 75\n   378→\n   379→    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n   380→    async def _generate_reasoning(\n   381→        self,\n   382→        job: DiscoveredJobSchema,\n   383→        profile: IdentityProfileSchema,\n   384→        scores: ScoreBreakdown,\n   385→        composite: int,\n   386→    ) -> str:\n   387→        \"\"\"Generate a 2-sentence human-readable reasoning string via Claude.\"\"\"\n   388→        prompt = f\"\"\"You are writing a brief explanation for why a job matches a candidate in a talent agent digest.\n   389→\n   390→Candidate archetypes: {\", \".join(profile.archetypes[:5])}\n   391→Job: {job.title} at {job.company} ({job.location or \"location TBD\"})\n   392→Composite score: {composite}/100\n   393→\n   394→Score breakdown:\n   395→- Technical match: {scores.technical_match}/100\n   396→- Level match: {scores.level_match}/100\n   397→- Culture match: {scores.culture_match}/100\n   398→- Industry match: {scores.industry_match}/100\n   399→- Growth potential: {scores.growth_potential}/100\n   400→- Compensation match: {scores.compensation_match}/100\n   401→\n   402→Write exactly 2 sentences: one sentence on why this is a strong match, one on the key consideration or risk.\n   403→Be specific. Do not use filler phrases like \"This role offers\" or \"This position presents\". Start with the substance.\n   404→Return only the 2 sentences, no other text.\"\"\"\n   405→\n   406→        response = await self._claude.messages.create(\n   407→            model=\"claude-sonnet-4-20250514\",\n   408→            max_tokens=200,\n   409→            messages=[{\"role\": \"user\", \"content\": prompt}],\n   410→        )\n   411→        return response.content[0].text.strip()\n   412→"}]},"parent_tool_use_id":null,"session_id":"ad28d7e9-1b93-44c5-b07f-443fa223218a","uuid":"83b2f116-1978-4c30-9c77-7bd1ac6bbd53","tool_use_result":{"type":"update","filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/discovery/relevance_scorer.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nRelevance Scorer — scores each discovered job against the candidate's identity profile.\n\nScoring dimensions (each 0–100):\n  technical_match   30%  — skills overlap between JD and candidate profile\n  level_match       20%  — seniority alignment (penalise over AND under)\n  culture_match     15%  — startup/enterprise, remote, mission alignment\n  industry_match    15%  — domain expertise alignment\n  growth_potential  10%  — does this expand the candidate's trajectory?\n  compensation_match 10% — estimated band vs candidate target\n\nClaude parses the JD. Math runs locally. Claude writes 2-sentence reasoning.\n\"\"\"\n\nimport json\nimport re\nfrom datetime import datetime, timezone\nfrom uuid import UUID, uuid4\n\nimport structlog\nfrom anthropic import AsyncAnthropic\nfrom tenacity import retry, stop_after_attempt, wait_exponential\n\nfrom backend.agents.discovery.schemas import (\n    IdentityProfileSchema,\n    DiscoveredJobSchema,\n    ScoredJobSchema,\n    ScoreBreakdown,\n)\n\nlogger = structlog.get_logger(__name__)\n\n# Seniority levels for level_match scoring — lower index = more junior\n_SENIORITY_LADDER = [\n    \"intern\",\n    \"junior\",\n    \"associate\",\n    \"mid\",\n    \"senior\",\n    \"staff\",\n    \"principal\",\n    \"lead\",\n    \"manager\",\n    \"director\",\n    \"vp\",\n    \"svp\",\n    \"head\",\n    \"cto\",\n    \"coo\",\n    \"ceo\",\n    \"founder\",\n    \"exec\",\n    \"c-level\",\n]\n\n_LEADERSHIP_TO_LADDER = {\n    \"IC\": \"senior\",\n    \"Lead\": \"lead\",\n    \"Manager\": \"manager\",\n    \"Director\": \"director\",\n    \"VP\": \"vp\",\n    \"C-Level\": \"cto\",\n}\n\n\nclass RelevanceScorer:\n    \"\"\"\n    Scores discovered jobs against a candidate's identity profile.\n\n    Uses Claude to parse JD requirements and generate reasoning.\n    Scoring math runs locally — no LLM needed for the numbers.\n    \"\"\"\n\n    def __init__(self, anthropic_client: AsyncAnthropic):\n        \"\"\"\n        Initialize the RelevanceScorer.\n\n        Args:\n            anthropic_client: Async Anthropic client for Claude API\n        \"\"\"\n        self._claude = anthropic_client\n\n    async def score_batch(\n        self,\n        jobs: list[DiscoveredJobSchema],\n        profile: IdentityProfileSchema,\n        candidate_id: UUID,\n        min_score: int = 60,\n    ) -> list[ScoredJobSchema]:\n        \"\"\"\n        Score a batch of discovered jobs, filtering out those below min_score.\n\n        Args:\n            jobs: Raw discovered jobs to score\n            profile: Candidate identity profile\n            candidate_id: Candidate UUID for scored job records\n            min_score: Jobs below this composite score are discarded\n\n        Returns:\n            Sorted list of ScoredJobSchema, highest composite first\n        \"\"\"\n        logger.info(\n            \"relevance_scorer.batch_start\",\n            job_count=len(jobs),\n            min_score=min_score,\n        )\n\n        scored: list[ScoredJobSchema] = []\n        for job in jobs:\n            try:\n                result = await self.score_job(job, profile, candidate_id)\n                if result.composite_score >= min_score:\n                    scored.append(result)\n            except Exception as e:\n                logger.error(\n                    \"relevance_scorer.job_error\",\n                    job_url=job.url,\n                    error=str(e),\n                )\n\n        scored.sort(key=lambda s: s.composite_score, reverse=True)\n        logger.info(\n            \"relevance_scorer.batch_complete\",\n            scored=len(scored),\n            filtered_out=len(jobs) - len(scored),\n        )\n        return scored\n\n    async def score_job(\n        self,\n        job: DiscoveredJobSchema,\n        profile: IdentityProfileSchema,\n        candidate_id: UUID,\n    ) -> ScoredJobSchema:\n        \"\"\"\n        Score a single job against the identity profile.\n\n        Args:\n            job: Discovered job\n            profile: Candidate identity profile\n            candidate_id: Candidate UUID\n\n        Returns:\n            ScoredJobSchema with full breakdown and reasoning\n        \"\"\"\n        parsed_jd = await self._parse_jd(job)\n        scores = self._compute_scores(parsed_jd, profile, job)\n        composite = scores.composite\n        is_hot = composite >= 80\n        reasoning = await self._generate_reasoning(job, profile, scores, composite)\n\n        return ScoredJobSchema(\n            id=uuid4(),\n            discovered_job_id=job.id or uuid4(),\n            candidate_id=candidate_id,\n            score_breakdown=scores,\n            composite_score=composite,\n            is_hot=is_hot,\n            reasoning=reasoning,\n            scored_at=datetime.now(timezone.utc),\n            # Denormalized job fields for digest display\n            title=job.title,\n            company=job.company,\n            location=job.location,\n            url=job.url,\n        )\n\n    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n    async def _parse_jd(self, job: DiscoveredJobSchema) -> dict:\n        \"\"\"Use Claude to extract structured requirements from a job description.\"\"\"\n        if not job.description:\n            return {}\n\n        prompt = f\"\"\"Extract structured data from this job description. Return ONLY valid JSON, no markdown:\n\nJob Title: {job.title}\nCompany: {job.company}\nLocation: {job.location or \"Not specified\"}\n\nDescription:\n{job.description[:3000]}\n\nReturn this exact JSON structure:\n{{\n  \"required_skills\": [\"<skill1>\", \"<skill2>\"],\n  \"preferred_skills\": [\"<skill1>\"],\n  \"seniority_level\": \"<intern|junior|mid|senior|staff|principal|lead|manager|director|vp|head|exec>\",\n  \"remote_type\": \"<remote|hybrid|onsite|flexible>\",\n  \"industries\": [\"<industry1>\"],\n  \"comp_mentioned\": \"<salary string or null>\",\n  \"culture_signals\": {{\n    \"startup_vs_enterprise\": \"<startup|enterprise|both>\",\n    \"mission_driven\": true\n  }},\n  \"growth_indicators\": [\"<indicator1>\"]\n}}\"\"\"\n\n        response = await self._claude.messages.create(\n            model=\"claude-sonnet-4-20250514\",\n            max_tokens=1024,\n            messages=[{\"role\": \"user\", \"content\": prompt}],\n        )\n\n        raw = response.content[0].text.strip()\n        try:\n            return json.loads(raw)\n        except json.JSONDecodeError:\n            match = re.search(r\"\\{.*\\}\", raw, re.DOTALL)\n            return json.loads(match.group()) if match else {}\n\n    def _compute_scores(\n        self,\n        parsed_jd: dict,\n        profile: IdentityProfileSchema,\n        job: DiscoveredJobSchema,\n    ) -> ScoreBreakdown:\n        \"\"\"Compute all six scoring dimensions locally.\"\"\"\n        return ScoreBreakdown(\n            technical_match=self._score_technical(parsed_jd, profile),\n            level_match=self._score_level(parsed_jd, profile),\n            culture_match=self._score_culture(parsed_jd, profile, job),\n            industry_match=self._score_industry(parsed_jd, profile),\n            growth_potential=self._score_growth(parsed_jd, profile),\n            compensation_match=self._score_compensation(parsed_jd, profile),\n        )\n\n    def _score_technical(\n        self, parsed_jd: dict, profile: IdentityProfileSchema\n    ) -> int:\n        \"\"\"Score based on skills overlap between JD requirements and candidate skills.\"\"\"\n        required = {s.lower() for s in parsed_jd.get(\"required_skills\", [])}\n        preferred = {s.lower() for s in parsed_jd.get(\"preferred_skills\", [])}\n        candidate_skills = {s.lower() for s in profile.technical_skills}\n\n        if not required:\n            return 60  # No requirements listed — neutral score\n\n        required_hits = len(required & candidate_skills)\n        preferred_hits = len(preferred & candidate_skills)\n\n        required_ratio = required_hits / len(required) if required else 0\n        preferred_bonus = min(20, preferred_hits * 4) if preferred else 0\n\n        base = int(required_ratio * 80)\n        return min(100, base + preferred_bonus)\n\n    def _score_level(self, parsed_jd: dict, profile: IdentityProfileSchema) -> int:\n        \"\"\"Score seniority alignment — penalise both under and over.\"\"\"\n        jd_level = parsed_jd.get(\"seniority_level\", \"\").lower()\n        candidate_level = _LEADERSHIP_TO_LADDER.get(\n            profile.leadership_level, \"senior\"\n        )\n\n        try:\n            jd_idx = _SENIORITY_LADDER.index(jd_level)\n        except ValueError:\n            return 70  # Unknown level — generous neutral\n\n        try:\n            candidate_idx = _SENIORITY_LADDER.index(candidate_level)\n        except ValueError:\n            return 70\n\n        diff = abs(jd_idx - candidate_idx)\n        if diff == 0:\n            return 100\n        elif diff == 1:\n            return 80\n        elif diff == 2:\n            return 55\n        elif diff == 3:\n            return 30\n        else:\n            return 10\n\n    def _score_culture(\n        self,\n        parsed_jd: dict,\n        profile: IdentityProfileSchema,\n        job: DiscoveredJobSchema,\n    ) -> int:\n        \"\"\"Score culture alignment: startup/enterprise + remote preference.\"\"\"\n        score = 60  # default neutral\n\n        # Startup vs enterprise alignment\n        jd_type = parsed_jd.get(\"culture_signals\", {}).get(\n            \"startup_vs_enterprise\", \"\"\n        )\n        candidate_pref = profile.signals.get(\"startup_vs_enterprise\", \"both\")\n        if jd_type and candidate_pref != \"both\":\n            if jd_type == candidate_pref:\n                score += 20\n            else:\n                score -= 20\n\n        # Remote alignment\n        jd_remote = parsed_jd.get(\"remote_type\", \"\")\n        candidate_remote = profile.signals.get(\"remote_preference\", \"flexible\")\n        if jd_remote and candidate_remote != \"flexible\":\n            if jd_remote == candidate_remote:\n                score += 20\n            elif jd_remote == \"onsite\" and candidate_remote == \"remote\":\n                score -= 30\n            else:\n                score -= 10\n\n        return max(0, min(100, score))\n\n    def _score_industry(\n        self, parsed_jd: dict, profile: IdentityProfileSchema\n    ) -> int:\n        \"\"\"Score how well the job's industries align with the candidate's domain expertise.\"\"\"\n        jd_industries = {i.lower() for i in parsed_jd.get(\"industries\", [])}\n        candidate_domains = {d.lower() for d in profile.industry_experience}\n\n        if not jd_industries:\n            return 60\n\n        overlap = len(jd_industries & candidate_domains)\n        if overlap >= 2:\n            return 100\n        elif overlap == 1:\n            return 75\n        else:\n            return 35\n\n    def _score_growth(\n        self, parsed_jd: dict, profile: IdentityProfileSchema\n    ) -> int:\n        \"\"\"Score whether this role expands the candidate's trajectory.\"\"\"\n        indicators = parsed_jd.get(\"growth_indicators\", [])\n        growth_keywords = {\n            \"build from scratch\",\n            \"greenfield\",\n            \"founding\",\n            \"new team\",\n            \"technical strategy\",\n            \"shape the\",\n            \"lead the\",\n            \"define the\",\n            \"architect\",\n            \"platform\",\n            \"0 to 1\",\n        }\n\n        indicator_text = \" \".join(indicators).lower()\n        matches = sum(1 for kw in growth_keywords if kw in indicator_text)\n\n        if matches >= 3:\n            return 90\n        elif matches >= 1:\n            return 70\n        else:\n            return 50\n\n    def _score_compensation(\n        self, parsed_jd: dict, profile: IdentityProfileSchema\n    ) -> int:\n        \"\"\"Score comp alignment — generous when comp isn't mentioned.\"\"\"\n        comp_str = parsed_jd.get(\"comp_mentioned\")\n        if not comp_str:\n            return 75  # No comp listed is common for senior/exec roles\n\n        # Extract numbers from comp string\n        numbers = re.findall(r\"\\d[\\d,]*\", comp_str.replace(\",\", \"\"))\n        if not numbers:\n            return 70\n\n        amounts = [int(n) for n in numbers if len(n) <= 7]  # filter out noise\n        if not amounts:\n            return 70\n\n        # Without candidate min, return neutral\n        return 75\n\n    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n    async def _generate_reasoning(\n        self,\n        job: DiscoveredJobSchema,\n        profile: IdentityProfileSchema,\n        scores: ScoreBreakdown,\n        composite: int,\n    ) -> str:\n        \"\"\"Generate a 2-sentence human-readable reasoning string via Claude.\"\"\"\n        prompt = f\"\"\"You are writing a brief explanation for why a job matches a candidate in a talent agent digest.\n\nCandidate archetypes: {\", \".join(profile.archetypes[:5])}\nJob: {job.title} at {job.company} ({job.location or \"location TBD\"})\nComposite score: {composite}/100\n\nScore breakdown:\n- Technical match: {scores.technical_match}/100\n- Level match: {scores.level_match}/100\n- Culture match: {scores.culture_match}/100\n- Industry match: {scores.industry_match}/100\n- Growth potential: {scores.growth_potential}/100\n- Compensation match: {scores.compensation_match}/100\n\nWrite exactly 2 sentences: one sentence on why this is a strong match, one on the key consideration or risk.\nBe specific. Do not use filler phrases like \"This role offers\" or \"This position presents\". Start with the substance.\nReturn only the 2 sentences, no other text.\"\"\"\n\n        response = await self._claude.messages.create(\n            model=\"claude-sonnet-4-20250514\",\n            max_tokens=200,\n            messages=[{\"role\": \"user\", \"content\": prompt}],\n        )\n        return response.content[0].text.strip()\n","structuredPatch":[{"oldStart":17,"oldLines":15,"newStart":17,"newLines":15,"lines":[" "," import json"," import re","-from typing import Optional","+from datetime import datetime, timezone","+from uuid import UUID, uuid4"," "," import structlog"," from anthropic import AsyncAnthropic"," from tenacity import retry, stop_after_attempt, wait_exponential"," ","-from backend.config import settings"," from backend.agents.discovery.schemas import (","-    IdentityProfile,","+    IdentityProfileSchema,","     DiscoveredJobSchema,","     ScoredJobSchema,","     ScoreBreakdown,"]},{"oldStart":35,"oldLines":27,"newStart":35,"newLines":37,"lines":[" "," # Seniority levels for level_match scoring — lower index = more junior"," _SENIORITY_LADDER = [","-    \"intern\", \"junior\", \"associate\", \"mid\", \"senior\", \"staff\",","-    \"principal\", \"lead\", \"manager\", \"director\", \"vp\", \"svp\",","-    \"head\", \"cto\", \"coo\", \"ceo\", \"founder\", \"exec\",","+    \"intern\",","+    \"junior\",","+    \"associate\",","+    \"mid\",","+    \"senior\",","+    \"staff\",","+    \"principal\",","+    \"lead\",","+    \"manager\",","+    \"director\",","+    \"vp\",","+    \"svp\",","+    \"head\",","+    \"cto\",","+    \"coo\",","+    \"ceo\",","+    \"founder\",","+    \"exec\",","+    \"c-level\","," ]"," "," _LEADERSHIP_TO_LADDER = {","-    \"ic\": \"senior\",","-    \"lead\": \"lead\",","-    \"staff\": \"staff\",","-    \"principal\": \"principal\",","-    \"founder\": \"founder\",","-    \"exec\": \"vp\",","+    \"IC\": \"senior\",","+    \"Lead\": \"lead\",","+    \"Manager\": \"manager\",","+    \"Director\": \"director\",","+    \"VP\": \"vp\",","+    \"C-Level\": \"cto\","," }"," ","-_REMOTE_KEYWORD_MAP = {","-    \"remote\": [\"remote\", \"distributed\", \"anywhere\", \"work from home\", \"wfh\"],","-    \"hybrid\": [\"hybrid\", \"flexible\"],","-    \"onsite\": [\"on-site\", \"onsite\", \"in-office\", \"in office\", \"office required\"],","-}"," ","-"," class RelevanceScorer:","     \"\"\"","     Scores discovered jobs against a candidate's identity profile."]},{"oldStart":65,"oldLines":12,"newStart":75,"newLines":19,"lines":["     \"\"\""," ","     def __init__(self, anthropic_client: AsyncAnthropic):","+        \"\"\"","+        Initialize the RelevanceScorer.","+","+        Args:","+            anthropic_client: Async Anthropic client for Claude API","+        \"\"\"","         self._claude = anthropic_client"," ","     async def score_batch(","         self,","         jobs: list[DiscoveredJobSchema],","-        profile: IdentityProfile,","+        profile: IdentityProfileSchema,","+        candidate_id: UUID,","         min_score: int = 60,","     ) -> list[ScoredJobSchema]:","         \"\"\""]},{"oldStart":79,"oldLines":6,"newStart":96,"newLines":7,"lines":["         Args:","             jobs: Raw discovered jobs to score","             profile: Candidate identity profile","+            candidate_id: Candidate UUID for scored job records","             min_score: Jobs below this composite score are discarded"," ","         Returns:"]},{"oldStart":93,"oldLines":7,"newStart":111,"newLines":7,"lines":["         scored: list[ScoredJobSchema] = []","         for job in jobs:","             try:","-                result = await self.score_job(job, profile)","+                result = await self.score_job(job, profile, candidate_id)","                 if result.composite_score >= min_score:","                     scored.append(result)","             except Exception as e:"]},{"oldStart":111,"oldLines":13,"newStart":129,"newLines":19,"lines":["         )","         return scored"," ","-    async def score_job(self, job: DiscoveredJobSchema, profile: IdentityProfile) -> ScoredJobSchema:","+    async def score_job(","+        self,","+        job: DiscoveredJobSchema,","+        profile: IdentityProfileSchema,","+        candidate_id: UUID,","+    ) -> ScoredJobSchema:","         \"\"\"","         Score a single job against the identity profile."," ","         Args:","             job: Discovered job","             profile: Candidate identity profile","+            candidate_id: Candidate UUID"," ","         Returns:","             ScoredJobSchema with full breakdown and reasoning"]},{"oldStart":125,"oldLines":14,"newStart":149,"newLines":23,"lines":["         parsed_jd = await self._parse_jd(job)","         scores = self._compute_scores(parsed_jd, profile, job)","         composite = scores.composite","+        is_hot = composite >= 80","         reasoning = await self._generate_reasoning(job, profile, scores, composite)"," ","         return ScoredJobSchema(","-            job=job,","-            scores=scores,","+            id=uuid4(),","+            discovered_job_id=job.id or uuid4(),","+            candidate_id=candidate_id,","+            score_breakdown=scores,","             composite_score=composite,","+            is_hot=is_hot,","             reasoning=reasoning,","-            is_hot=composite >= 80,","+            scored_at=datetime.now(timezone.utc),","+            # Denormalized job fields for digest display","+            title=job.title,","+            company=job.company,","+            location=job.location,","+            url=job.url,","         )"," ","     @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))"]},{"oldStart":160,"oldLines":7,"newStart":193,"newLines":7,"lines":["   \"comp_mentioned\": \"<salary string or null>\",","   \"culture_signals\": {{","     \"startup_vs_enterprise\": \"<startup|enterprise|both>\",","-    \"mission_driven\": <true|false>","+    \"mission_driven\": true","   }},","   \"growth_indicators\": [\"<indicator1>\"]"," }}\"\"\""]},{"oldStart":179,"oldLines":7,"newStart":212,"newLines":10,"lines":["             return json.loads(match.group()) if match else {}"," ","     def _compute_scores(","-        self, parsed_jd: dict, profile: IdentityProfile, job: DiscoveredJobSchema","+        self,","+        parsed_jd: dict,","+        profile: IdentityProfileSchema,","+        job: DiscoveredJobSchema,","     ) -> ScoreBreakdown:","         \"\"\"Compute all six scoring dimensions locally.\"\"\"","         return ScoreBreakdown("]},{"oldStart":191,"oldLines":11,"newStart":227,"newLines":13,"lines":["             compensation_match=self._score_compensation(parsed_jd, profile),","         )"," ","-    def _score_technical(self, parsed_jd: dict, profile: IdentityProfile) -> int:","+    def _score_technical(","+        self, parsed_jd: dict, profile: IdentityProfileSchema","+    ) -> int:","         \"\"\"Score based on skills overlap between JD requirements and candidate skills.\"\"\"","         required = {s.lower() for s in parsed_jd.get(\"required_skills\", [])}","         preferred = {s.lower() for s in parsed_jd.get(\"preferred_skills\", [])}","-        candidate_skills = {s.lower() for s in profile.technical_skills.keys()}","+        candidate_skills = {s.lower() for s in profile.technical_skills}"," ","         if not required:","             return 60  # No requirements listed — neutral score"]},{"oldStart":209,"oldLines":10,"newStart":247,"newLines":12,"lines":["         base = int(required_ratio * 80)","         return min(100, base + preferred_bonus)"," ","-    def _score_level(self, parsed_jd: dict, profile: IdentityProfile) -> int:","+    def _score_level(self, parsed_jd: dict, profile: IdentityProfileSchema) -> int:","         \"\"\"Score seniority alignment — penalise both under and over.\"\"\"","         jd_level = parsed_jd.get(\"seniority_level\", \"\").lower()","-        candidate_level = _LEADERSHIP_TO_LADDER.get(profile.leadership_level, \"senior\")","+        candidate_level = _LEADERSHIP_TO_LADDER.get(","+            profile.leadership_level, \"senior\"","+        )"," ","         try:","             jd_idx = _SENIORITY_LADDER.index(jd_level)"]},{"oldStart":237,"oldLines":14,"newStart":277,"newLines":19,"lines":["             return 10"," ","     def _score_culture(","-        self, parsed_jd: dict, profile: IdentityProfile, job: DiscoveredJobSchema","+        self,","+        parsed_jd: dict,","+        profile: IdentityProfileSchema,","+        job: DiscoveredJobSchema,","     ) -> int:","         \"\"\"Score culture alignment: startup/enterprise + remote preference.\"\"\"","         score = 60  # default neutral"," ","         # Startup vs enterprise alignment","-        jd_type = parsed_jd.get(\"culture_signals\", {}).get(\"startup_vs_enterprise\", \"\")","-        candidate_pref = profile.culture_signals.get(\"startup_vs_enterprise\", \"both\")","+        jd_type = parsed_jd.get(\"culture_signals\", {}).get(","+            \"startup_vs_enterprise\", \"\"","+        )","+        candidate_pref = profile.signals.get(\"startup_vs_enterprise\", \"both\")","         if jd_type and candidate_pref != \"both\":","             if jd_type == candidate_pref:","                 score += 20"]},{"oldStart":253,"oldLines":7,"newStart":298,"newLines":7,"lines":[" ","         # Remote alignment","         jd_remote = parsed_jd.get(\"remote_type\", \"\")","-        candidate_remote = profile.culture_signals.get(\"remote_preference\", \"flexible\")","+        candidate_remote = profile.signals.get(\"remote_preference\", \"flexible\")","         if jd_remote and candidate_remote != \"flexible\":","             if jd_remote == candidate_remote:","                 score += 20"]},{"oldStart":264,"oldLines":10,"newStart":309,"newLines":12,"lines":[" ","         return max(0, min(100, score))"," ","-    def _score_industry(self, parsed_jd: dict, profile: IdentityProfile) -> int:","+    def _score_industry(","+        self, parsed_jd: dict, profile: IdentityProfileSchema","+    ) -> int:","         \"\"\"Score how well the job's industries align with the candidate's domain expertise.\"\"\"","         jd_industries = {i.lower() for i in parsed_jd.get(\"industries\", [])}","-        candidate_domains = {d.lower() for d in profile.domain_expertise}","+        candidate_domains = {d.lower() for d in profile.industry_experience}"," ","         if not jd_industries:","             return 60"]},{"oldStart":280,"oldLines":13,"newStart":327,"newLines":23,"lines":["         else:","             return 35"," ","-    def _score_growth(self, parsed_jd: dict, profile: IdentityProfile) -> int:","+    def _score_growth(","+        self, parsed_jd: dict, profile: IdentityProfileSchema","+    ) -> int:","         \"\"\"Score whether this role expands the candidate's trajectory.\"\"\"","         indicators = parsed_jd.get(\"growth_indicators\", [])","         growth_keywords = {","-            \"build from scratch\", \"greenfield\", \"founding\", \"new team\",","-            \"technical strategy\", \"shape the\", \"lead the\", \"define the\",","-            \"architect\", \"platform\", \"0 to 1\",","+            \"build from scratch\",","+            \"greenfield\",","+            \"founding\",","+            \"new team\",","+            \"technical strategy\",","+            \"shape the\",","+            \"lead the\",","+            \"define the\",","+            \"architect\",","+            \"platform\",","+            \"0 to 1\",","         }"," ","         indicator_text = \" \".join(indicators).lower()"]},{"oldStart":299,"oldLines":11,"newStart":356,"newLines":13,"lines":["         else:","             return 50"," ","-    def _score_compensation(self, parsed_jd: dict, profile: IdentityProfile) -> int:","-        \"\"\"Score comp alignment — generous when comp isn't mentioned (common for senior roles).\"\"\"","+    def _score_compensation(","+        self, parsed_jd: dict, profile: IdentityProfileSchema","+    ) -> int:","+        \"\"\"Score comp alignment — generous when comp isn't mentioned.\"\"\"","         comp_str = parsed_jd.get(\"comp_mentioned\")","         if not comp_str:","-            return 75  # No comp listed is common for senior/exec roles — assume competitive","+            return 75  # No comp listed is common for senior/exec roles"," ","         # Extract numbers from comp string","         numbers = re.findall(r\"\\d[\\d,]*\", comp_str.replace(\",\", \"\"))"]},{"oldStart":314,"oldLines":36,"newStart":373,"newLines":21,"lines":["         if not amounts:","             return 70"," ","-        jd_max = max(amounts)","-        # Normalize to annual if looks like monthly (< 20000)","-        if jd_max < 20_000:","-            jd_max *= 12","+        # Without candidate min, return neutral","+        return 75"," ","-        candidate_min = profile.compensation_band.get(\"min\", 0)","-        if candidate_min == 0:","-            return 70","-","-        if jd_max >= candidate_min:","-            return 100","-        elif jd_max >= candidate_min * 0.85:","-            return 70","-        elif jd_max >= candidate_min * 0.70:","-            return 40","-        else:","-            return 15","-","     @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))","     async def _generate_reasoning(","         self,","         job: DiscoveredJobSchema,","-        profile: IdentityProfile,","+        profile: IdentityProfileSchema,","         scores: ScoreBreakdown,","         composite: int,","     ) -> str:","         \"\"\"Generate a 2-sentence human-readable reasoning string via Claude.\"\"\"","         prompt = f\"\"\"You are writing a brief explanation for why a job matches a candidate in a talent agent digest."," ","-Candidate archetype tags: {\", \".join(profile.archetype_tags)}","+Candidate archetypes: {\", \".join(profile.archetypes[:5])}"," Job: {job.title} at {job.company} ({job.location or \"location TBD\"})"," Composite score: {composite}/100"," "]}],"originalFile":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nRelevance Scorer — scores each discovered job against the candidate's identity profile.\n\nScoring dimensions (each 0–100):\n  technical_match   30%  — skills overlap between JD and candidate profile\n  level_match       20%  — seniority alignment (penalise over AND under)\n  culture_match     15%  — startup/enterprise, remote, mission alignment\n  industry_match    15%  — domain expertise alignment\n  growth_potential  10%  — does this expand the candidate's trajectory?\n  compensation_match 10% — estimated band vs candidate target\n\nClaude parses the JD. Math runs locally. Claude writes 2-sentence reasoning.\n\"\"\"\n\nimport json\nimport re\nfrom typing import Optional\n\nimport structlog\nfrom anthropic import AsyncAnthropic\nfrom tenacity import retry, stop_after_attempt, wait_exponential\n\nfrom backend.config import settings\nfrom backend.agents.discovery.schemas import (\n    IdentityProfile,\n    DiscoveredJobSchema,\n    ScoredJobSchema,\n    ScoreBreakdown,\n)\n\nlogger = structlog.get_logger(__name__)\n\n# Seniority levels for level_match scoring — lower index = more junior\n_SENIORITY_LADDER = [\n    \"intern\", \"junior\", \"associate\", \"mid\", \"senior\", \"staff\",\n    \"principal\", \"lead\", \"manager\", \"director\", \"vp\", \"svp\",\n    \"head\", \"cto\", \"coo\", \"ceo\", \"founder\", \"exec\",\n]\n\n_LEADERSHIP_TO_LADDER = {\n    \"ic\": \"senior\",\n    \"lead\": \"lead\",\n    \"staff\": \"staff\",\n    \"principal\": \"principal\",\n    \"founder\": \"founder\",\n    \"exec\": \"vp\",\n}\n\n_REMOTE_KEYWORD_MAP = {\n    \"remote\": [\"remote\", \"distributed\", \"anywhere\", \"work from home\", \"wfh\"],\n    \"hybrid\": [\"hybrid\", \"flexible\"],\n    \"onsite\": [\"on-site\", \"onsite\", \"in-office\", \"in office\", \"office required\"],\n}\n\n\nclass RelevanceScorer:\n    \"\"\"\n    Scores discovered jobs against a candidate's identity profile.\n\n    Uses Claude to parse JD requirements and generate reasoning.\n    Scoring math runs locally — no LLM needed for the numbers.\n    \"\"\"\n\n    def __init__(self, anthropic_client: AsyncAnthropic):\n        self._claude = anthropic_client\n\n    async def score_batch(\n        self,\n        jobs: list[DiscoveredJobSchema],\n        profile: IdentityProfile,\n        min_score: int = 60,\n    ) -> list[ScoredJobSchema]:\n        \"\"\"\n        Score a batch of discovered jobs, filtering out those below min_score.\n\n        Args:\n            jobs: Raw discovered jobs to score\n            profile: Candidate identity profile\n            min_score: Jobs below this composite score are discarded\n\n        Returns:\n            Sorted list of ScoredJobSchema, highest composite first\n        \"\"\"\n        logger.info(\n            \"relevance_scorer.batch_start\",\n            job_count=len(jobs),\n            min_score=min_score,\n        )\n\n        scored: list[ScoredJobSchema] = []\n        for job in jobs:\n            try:\n                result = await self.score_job(job, profile)\n                if result.composite_score >= min_score:\n                    scored.append(result)\n            except Exception as e:\n                logger.error(\n                    \"relevance_scorer.job_error\",\n                    job_url=job.url,\n                    error=str(e),\n                )\n\n        scored.sort(key=lambda s: s.composite_score, reverse=True)\n        logger.info(\n            \"relevance_scorer.batch_complete\",\n            scored=len(scored),\n            filtered_out=len(jobs) - len(scored),\n        )\n        return scored\n\n    async def score_job(self, job: DiscoveredJobSchema, profile: IdentityProfile) -> ScoredJobSchema:\n        \"\"\"\n        Score a single job against the identity profile.\n\n        Args:\n            job: Discovered job\n            profile: Candidate identity profile\n\n        Returns:\n            ScoredJobSchema with full breakdown and reasoning\n        \"\"\"\n        parsed_jd = await self._parse_jd(job)\n        scores = self._compute_scores(parsed_jd, profile, job)\n        composite = scores.composite\n        reasoning = await self._generate_reasoning(job, profile, scores, composite)\n\n        return ScoredJobSchema(\n            job=job,\n            scores=scores,\n            composite_score=composite,\n            reasoning=reasoning,\n            is_hot=composite >= 80,\n        )\n\n    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n    async def _parse_jd(self, job: DiscoveredJobSchema) -> dict:\n        \"\"\"Use Claude to extract structured requirements from a job description.\"\"\"\n        if not job.description:\n            return {}\n\n        prompt = f\"\"\"Extract structured data from this job description. Return ONLY valid JSON, no markdown:\n\nJob Title: {job.title}\nCompany: {job.company}\nLocation: {job.location or \"Not specified\"}\n\nDescription:\n{job.description[:3000]}\n\nReturn this exact JSON structure:\n{{\n  \"required_skills\": [\"<skill1>\", \"<skill2>\"],\n  \"preferred_skills\": [\"<skill1>\"],\n  \"seniority_level\": \"<intern|junior|mid|senior|staff|principal|lead|manager|director|vp|head|exec>\",\n  \"remote_type\": \"<remote|hybrid|onsite|flexible>\",\n  \"industries\": [\"<industry1>\"],\n  \"comp_mentioned\": \"<salary string or null>\",\n  \"culture_signals\": {{\n    \"startup_vs_enterprise\": \"<startup|enterprise|both>\",\n    \"mission_driven\": <true|false>\n  }},\n  \"growth_indicators\": [\"<indicator1>\"]\n}}\"\"\"\n\n        response = await self._claude.messages.create(\n            model=\"claude-sonnet-4-20250514\",\n            max_tokens=1024,\n            messages=[{\"role\": \"user\", \"content\": prompt}],\n        )\n\n        raw = response.content[0].text.strip()\n        try:\n            return json.loads(raw)\n        except json.JSONDecodeError:\n            match = re.search(r\"\\{.*\\}\", raw, re.DOTALL)\n            return json.loads(match.group()) if match else {}\n\n    def _compute_scores(\n        self, parsed_jd: dict, profile: IdentityProfile, job: DiscoveredJobSchema\n    ) -> ScoreBreakdown:\n        \"\"\"Compute all six scoring dimensions locally.\"\"\"\n        return ScoreBreakdown(\n            technical_match=self._score_technical(parsed_jd, profile),\n            level_match=self._score_level(parsed_jd, profile),\n            culture_match=self._score_culture(parsed_jd, profile, job),\n            industry_match=self._score_industry(parsed_jd, profile),\n            growth_potential=self._score_growth(parsed_jd, profile),\n            compensation_match=self._score_compensation(parsed_jd, profile),\n        )\n\n    def _score_technical(self, parsed_jd: dict, profile: IdentityProfile) -> int:\n        \"\"\"Score based on skills overlap between JD requirements and candidate skills.\"\"\"\n        required = {s.lower() for s in parsed_jd.get(\"required_skills\", [])}\n        preferred = {s.lower() for s in parsed_jd.get(\"preferred_skills\", [])}\n        candidate_skills = {s.lower() for s in profile.technical_skills.keys()}\n\n        if not required:\n            return 60  # No requirements listed — neutral score\n\n        required_hits = len(required & candidate_skills)\n        preferred_hits = len(preferred & candidate_skills)\n\n        required_ratio = required_hits / len(required) if required else 0\n        preferred_bonus = min(20, preferred_hits * 4) if preferred else 0\n\n        base = int(required_ratio * 80)\n        return min(100, base + preferred_bonus)\n\n    def _score_level(self, parsed_jd: dict, profile: IdentityProfile) -> int:\n        \"\"\"Score seniority alignment — penalise both under and over.\"\"\"\n        jd_level = parsed_jd.get(\"seniority_level\", \"\").lower()\n        candidate_level = _LEADERSHIP_TO_LADDER.get(profile.leadership_level, \"senior\")\n\n        try:\n            jd_idx = _SENIORITY_LADDER.index(jd_level)\n        except ValueError:\n            return 70  # Unknown level — generous neutral\n\n        try:\n            candidate_idx = _SENIORITY_LADDER.index(candidate_level)\n        except ValueError:\n            return 70\n\n        diff = abs(jd_idx - candidate_idx)\n        if diff == 0:\n            return 100\n        elif diff == 1:\n            return 80\n        elif diff == 2:\n            return 55\n        elif diff == 3:\n            return 30\n        else:\n            return 10\n\n    def _score_culture(\n        self, parsed_jd: dict, profile: IdentityProfile, job: DiscoveredJobSchema\n    ) -> int:\n        \"\"\"Score culture alignment: startup/enterprise + remote preference.\"\"\"\n        score = 60  # default neutral\n\n        # Startup vs enterprise alignment\n        jd_type = parsed_jd.get(\"culture_signals\", {}).get(\"startup_vs_enterprise\", \"\")\n        candidate_pref = profile.culture_signals.get(\"startup_vs_enterprise\", \"both\")\n        if jd_type and candidate_pref != \"both\":\n            if jd_type == candidate_pref:\n                score += 20\n            else:\n                score -= 20\n\n        # Remote alignment\n        jd_remote = parsed_jd.get(\"remote_type\", \"\")\n        candidate_remote = profile.culture_signals.get(\"remote_preference\", \"flexible\")\n        if jd_remote and candidate_remote != \"flexible\":\n            if jd_remote == candidate_remote:\n                score += 20\n            elif jd_remote == \"onsite\" and candidate_remote == \"remote\":\n                score -= 30\n            else:\n                score -= 10\n\n        return max(0, min(100, score))\n\n    def _score_industry(self, parsed_jd: dict, profile: IdentityProfile) -> int:\n        \"\"\"Score how well the job's industries align with the candidate's domain expertise.\"\"\"\n        jd_industries = {i.lower() for i in parsed_jd.get(\"industries\", [])}\n        candidate_domains = {d.lower() for d in profile.domain_expertise}\n\n        if not jd_industries:\n            return 60\n\n        overlap = len(jd_industries & candidate_domains)\n        if overlap >= 2:\n            return 100\n        elif overlap == 1:\n            return 75\n        else:\n            return 35\n\n    def _score_growth(self, parsed_jd: dict, profile: IdentityProfile) -> int:\n        \"\"\"Score whether this role expands the candidate's trajectory.\"\"\"\n        indicators = parsed_jd.get(\"growth_indicators\", [])\n        growth_keywords = {\n            \"build from scratch\", \"greenfield\", \"founding\", \"new team\",\n            \"technical strategy\", \"shape the\", \"lead the\", \"define the\",\n            \"architect\", \"platform\", \"0 to 1\",\n        }\n\n        indicator_text = \" \".join(indicators).lower()\n        matches = sum(1 for kw in growth_keywords if kw in indicator_text)\n\n        if matches >= 3:\n            return 90\n        elif matches >= 1:\n            return 70\n        else:\n            return 50\n\n    def _score_compensation(self, parsed_jd: dict, profile: IdentityProfile) -> int:\n        \"\"\"Score comp alignment — generous when comp isn't mentioned (common for senior roles).\"\"\"\n        comp_str = parsed_jd.get(\"comp_mentioned\")\n        if not comp_str:\n            return 75  # No comp listed is common for senior/exec roles — assume competitive\n\n        # Extract numbers from comp string\n        numbers = re.findall(r\"\\d[\\d,]*\", comp_str.replace(\",\", \"\"))\n        if not numbers:\n            return 70\n\n        amounts = [int(n) for n in numbers if len(n) <= 7]  # filter out noise\n        if not amounts:\n            return 70\n\n        jd_max = max(amounts)\n        # Normalize to annual if looks like monthly (< 20000)\n        if jd_max < 20_000:\n            jd_max *= 12\n\n        candidate_min = profile.compensation_band.get(\"min\", 0)\n        if candidate_min == 0:\n            return 70\n\n        if jd_max >= candidate_min:\n            return 100\n        elif jd_max >= candidate_min * 0.85:\n            return 70\n        elif jd_max >= candidate_min * 0.70:\n            return 40\n        else:\n            return 15\n\n    @retry(stop=stop_after_attempt(3), wait=wait_exponential(multiplier=1, min=2, max=10))\n    async def _generate_reasoning(\n        self,\n        job: DiscoveredJobSchema,\n        profile: IdentityProfile,\n        scores: ScoreBreakdown,\n        composite: int,\n    ) -> str:\n        \"\"\"Generate a 2-sentence human-readable reasoning string via Claude.\"\"\"\n        prompt = f\"\"\"You are writing a brief explanation for why a job matches a candidate in a talent agent digest.\n\nCandidate archetype tags: {\", \".join(profile.archetype_tags)}\nJob: {job.title} at {job.company} ({job.location or \"location TBD\"})\nComposite score: {composite}/100\n\nScore breakdown:\n- Technical match: {scores.technical_match}/100\n- Level match: {scores.level_match}/100\n- Culture match: {scores.culture_match}/100\n- Industry match: {scores.industry_match}/100\n- Growth potential: {scores.growth_potential}/100\n- Compensation match: {scores.compensation_match}/100\n\nWrite exactly 2 sentences: one sentence on why this is a strong match, one on the key consideration or risk.\nBe specific. Do not use filler phrases like \"This role offers\" or \"This position presents\". Start with the substance.\nReturn only the 2 sentences, no other text.\"\"\"\n\n        response = await self._claude.messages.create(\n            model=\"claude-sonnet-4-20250514\",\n            max_tokens=200,\n            messages=[{\"role\": \"user\", \"content\": prompt}],\n        )\n        return response.content[0].text.strip()\n"}}}
