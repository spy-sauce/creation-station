{"t":"2026-05-20T20:15:14.188Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KVHG3f1V7weWCwM9mYwTsn","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Pydantic v2 schemas for the Application Engine.\n     6→\n     7→These are the data contracts between application agents — separate from ORM models.\n     8→\"\"\"\n     9→\n    10→from __future__ import annotations\n    11→\n    12→from datetime import datetime\n    13→from typing import Optional, Union\n    14→from uuid import UUID\n    15→\n    16→from pydantic import BaseModel, Field, ConfigDict\n    17→\n    18→\n    19→# ─── Parsed JD ────────────────────────────────────────────────────────────────\n    20→\n    21→\n    22→class ParsedJDSchema(BaseModel):\n    23→    \"\"\"\n    24→    Deep-parsed job description — every signal needed for tailoring the application.\n    25→\n    26→    Generated by JDParser. Cached in PostgreSQL — reused if job is re-processed.\n    27→    \"\"\"\n    28→\n    29→    model_config = ConfigDict(from_attributes=True)\n    30→\n    31→    id: Optional[UUID] = None\n    32→    job_id: UUID\n    33→    required_skills: list[str] = Field(default_factory=list)\n    34→    preferred_skills: list[str] = Field(default_factory=list)\n    35→    seniority_level: str = \"senior\"\n    36→    team_context: Optional[str] = None\n    37→    key_responsibilities: list[str] = Field(default_factory=list)\n    38→    culture_signals: dict[str, str] = Field(default_factory=dict)\n    39→    tech_stack: list[str] = Field(default_factory=list)\n    40→    pain_points: Optional[str] = None\n    41→    tone: str = \"professional\"\n    42→    comp_mentioned: Optional[str] = None\n    43→    red_flags: list[str] = Field(default_factory=list)\n    44→    application_instructions: Optional[str] = None\n    45→    parsed_at: Optional[datetime] = N