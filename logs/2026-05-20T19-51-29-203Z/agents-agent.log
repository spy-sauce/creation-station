{"t":"2026-05-20T20:15:09.131Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01938v2Z3MLNmgw7Ex3ujonR","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Agent Manager — dispatches and coordinates application sub-agents via Claude Cloud.\n     6→\n     7→This is the agentic management layer that wraps each application sub-agent\n     8→as an autonomous Claude-powered worker. Instead of direct method calls,\n     9→each agent is dispatched as an independent Claude API call with its own\n    10→system prompt, tool definitions, and execution context.\n    11→\n    12→Architecture:\n    13→  AgentManager\n    14→    ├── SubAgentRegistry    ← defines available agents + their capabilities\n    15→    ├── SubAgentRunner      ← executes a single agent via Claude API tool_use loop\n    16→    ├── PipelineDispatcher  ← coordinates multi-agent pipelines with dependency graph\n    17→    └── AgentStateStore     ← persists agent state for resume/retry across processes\n    18→\n    19→Execution model:\n    20→  1. Master agent receives a pipeline request\n    21→  2. Builds a dependency graph of sub-agent tasks\n    22→  3. Dispatches independent agents concurrently\n    23→  4. Each agent runs its own Claude agentic loop (prompt → tool_use → result)\n    24→  5. Results flow back through schemas, feeding dependent agents\n    25→  6. State is persisted at every step — crash-safe, resumable\n    26→\n    27→Status per sub-agent:\n    28→  QUEUED → DISPATCHED → RUNNING → COMPLETED\n    29→                                → FAILED → RETRYING → COMPLETED\n    30→                                                    → DEAD\n    31→\"\"\"\n    32→\n    33→from __future__ import annotations\n    34→\n    35→import asyncio\n    36→import json\n    37→import time\n    38→from dataclasses import dataclass, field\n    39→from datetime import datetime, timezone\n    40→from enum import Enum\n    41→from typing import Any, Callable, Optional\n    42→from uuid import UUID, uuid4\n    43→\n    44→import redis.asyncio as aioredis\n    45→import structlog\n    46→from anthropic import AsyncAnthropic\n    47→from pydantic import BaseModel\n    48→from sqlalchemy.ext.asyncio import AsyncSession\n    49→\n    50→from backend.config import settings\n    51→\n    52→logger = structlog.get_logger(__name__)\n    53→\n    54→_AGENT_STATUS_CHANNEL = \"agent.status.subagent\"\n    55→\n    56→\n    57→# ─── Agent Status ────────────────────────────────────────────────────────────\n    58→\n    59→\n    60→class AgentStatus(str, Enum):\n    61→    \"\"\"Status lifecycle for each sub-agent execution.\"\"\"\n    62→\n    63→    QUEUED = \"QUEUED\"\n    64→    DISPATCHED = \"DISPATCHED\"\n    65→    RUNNING = \"RUNNING\"\n    66→    COMPLETED = \"COMPLETED\"\n    67→    FAILED = \"FAILED\"\n    68→    RETRYING = \"RETRYING\"\n    69→    DEAD = \"DEAD\"\n    70→\n    71→\n    72→# ─── Agent Definition ───────────────────────────────────────────────────────\n    73→\n    74→\n    75→@dataclass\n    76→class SubAgentDefinition:\n    77→    \"\"\"\n    78→    Declares a sub-agent's identity, capabilities, and execution context.\n    79→\n    80→    Each sub-agent gets its own Claude system prompt and tool definitions,\n    81→    making it a self-contained autonomous worker.\n    82→    \"\"\"\n    83→\n    84→    name: str\n    85→    description: str\n    86→    system_prompt: str\n    87→    tools: list[dict[str, Any]] = field(default_factory=list)\n    88→    model: str = \"claude-sonnet-4-20250514\"\n    89→    max_tokens: int = 4096\n    90→    max_retries: int = 3\n    91→    timeout_seconds: int = 120\n    92→    dependencies: list[str] = field(default_factory=list)\n    93→\n    94→\n    95→# ─── Agent Execution Record ─────────────────────────────────────────────────\n    96→\n    97→\n    98→class AgentExecutionRecord(BaseModel):\n    99→    \"\"\"Tracks a single sub-agent execution — persisted for observability and resume.\"\"\"\n   100→\n   101→    execution_id: UUID = None\n   102→    agent_name: str\n   103→    pipeline_id: UUID\n   104→    status: str = AgentStatus.QUEUED.value\n   105→    input_payload: dict = {}\n   106→    output_payload: Optional[dict] = None\n   107→    error: Optional[str] = None\n   108→    attempt: int = 1\n   109→    started_at: Optional[datetime] = None\n   110→    completed_at: Optional[datetime] = None\n   111→    duration_ms: Optional[int] = None\n   112→    token_usage: Optional[dict] = None\n   113→\n   114→    def model_post_init(self, __context: Any) -> None:\n   115→        \"\"\"Set execution_id if not provided.\"\"\"\n   116→        if self.execution_id is None:\n   117→            self.execution_id = uuid4()\n   118→\n   119→\n   120→# ─── Sub-Agent Registry ─────────────────────────────────────────────────────\n   121→\n   122→\n   123→class SubAgentRegistry:\n   124→    \"\"\"\n   125→    Registry of all available sub-agents and their definitions.\n   126→\n   127→    Each agent is declared with its system prompt, tool definitions,\n   128→    and dependency requirements. The registry is the source of truth\n   129→    for what agents exist and how they should be invoked.\n   130→    \"\"\"\n   131→\n   132→    def __init__(self) -> None:\n   133→        self._agents: dict[str, SubAgentDefinition] = {}\n   134→        self._register_defaults()\n   135→\n   136→    def register(self, agent: SubAgentDefinition) -> None:\n   137→        \"\"\"Register a sub-agent definition.\"\"\"\n   138→        self._agents[agent.name] = agent\n   139→        logger.info(\"agent_registry.registered\", agent=agent.name)\n   140→\n   141→    def get(self, name: str) -> SubAgentDefinition:\n   142→        \"\"\"Retrieve a registered agent definition by name.\"\"\"\n   143→        if name not in self._agents:\n   144→            raise KeyError(f\"Agent '{name}' not registered. Available: {list(self._agents.keys())}\")\n   145→        return self._agents[name]\n   146→\n   147→    def list_agents(self) -> list[str]:\n   148→        \"\"\"List all registered agent names.\"\"\"\n   149→        return list(self._agents.keys())\n   150→\n   151→    def get_dependency_order(self, agent_names: list[str]) -> list[list[str]]:\n   152→        \"\"\"\n   153→        Resolve execution order from dependency graph.\n   154→\n   155→        Returns a list of tiers — agents within a tier can run concurrently.\n   156→        Agents in tier N+1 depend on agents in tier N.\n   157→        \"\"\"\n   158→        resolved: set[str] = set()\n   159→        tiers: list[list[str]] = []\n   160→\n   161→        remaining = set(agent_names)\n   162→        while remaining:\n   163→            tier = []\n   164→            for name in list(remaining):\n   165→                agent = self.get(name)\n   166→                deps = set(agent.dependencies) & set(agent_names)\n   167→                if deps.issubset(resolved):\n   168→                    tier.append(name)\n   169→            if not tier:\n   170→                unresolved = {\n   171→                    n: self.get(n).dependencies for n in remaining\n   172→                }\n   173→                raise ValueError(f\"Circular dependency detected: {unresolved}\")\n   174→            for name in tier:\n   175→                remaining.discard(name)\n   176→                resolved.add(name)\n   177→            tiers.append(tier)\n   178→\n   179→        return tiers\n   180→\n   181→    def _register_defaults(self) -> None:\n   182→        \"\"\"Register the standard application engine sub-agents.\"\"\"\n   183→\n   184→        self.register(SubAgentDefinition(\n   185→            name=\"jd_parser\",\n   186→            description=\"Parses job descriptions into structured signals for resume tailoring\",\n   187→            system_prompt=(\n   188→                \"You are a JD parsing specialist. Extract structured signals from job descriptions: \"\n   189→                \"required skills, preferred skills, seniority level, team context, responsibilities, \"\n   190→                \"culture signals, tech stack, pain points, tone, compensation, red flags, and \"\n   191→                \"application instructions. Be precise — downstream agents depend on your accuracy.\"\n   192→            ),\n   193→            tools=[{\n   194→                \"name\": \"parse_job_description\",\n   195→                \"description\": \"Extract structured data from a raw job description\",\n   196→                \"input_schema\": {\n   197→                    \"type\": \"object\",\n   198→                    \"properties\": {\n   199→                        \"job_id\": {\"type\": \"string\", \"description\": \"UUID of the job\"},\n   200→                        \"title\": {\"type\": \"string\"},\n   201→                        \"company\": {\"type\": \"string\"},\n   202→                        \"description\": {\"type\": \"string\", \"description\": \"Raw JD text\"},\n   203→                    },\n   204→                    \"required\": [\"job_id\", \"title\", \"company\", \"description\"],\n   205→                },\n   206→            }],\n   207→            max_tokens=2048,\n   208→            dependencies=[],\n   209→        ))\n   210→\n   211→        self.register(SubAgentDefinition(\n   212→            name=\"resume_tailor\",\n   213→            description=\"Rewrites candidate resumes to align with specific job requirements\",\n   214→            system_prompt=(\n   215→                \"You are a resume tailoring specialist. Rewrite the candidate's resume to align \"\n   216→                \"with the target role. Rules: NEVER fabricate experience, titles, dates, or metrics. \"\n   217→                \"Mirror JD language naturally. Prioritize relevance over comprehensiveness. \"\n   218→                \"Flag skill gaps in change_log — never invent skills the candidate doesn't have.\"\n   219→            ),\n   220→            tools=[{\n   221→                \"name\": \"tailor_resume\",\n   222→                \"description\": \"Rewrite a resume for a specific role based on parsed JD signals\",\n   223→                \"input_schema\": {\n   224→                    \"type\": \"object\",\n   225→                    \"properties\": {\n   226→                        \"candidate_resume\": {\"type\": \"string\"},\n   227→                        \"candidate_name\": {\"type\": \"string\"},\n   228→                        \"parsed_jd\": {\"type\": \"object\", \"description\": \"Structured JD signals\"},\n   229→                        \"identity_profile\": {\"type\": \"object\", \"description\": \"Candidate identity profile\"},\n   230→                    },\n   231→                    \"required\": [\"candidate_resume\", \"candidate_name\", \"parsed_jd\"],\n   232→                },\n   233→            }],\n   234→            max_tokens=4096,\n   235→            dependencies=[\"jd_parser\"],\n   236→        ))\n   237→\n   238→        self.register(SubAgentDefinition(\n   239→            name=\"company_intel\",\n   240→            description=\"Researches companies to provide real context for outreach\",\n   241→            system_prompt=(\n   242→                \"You are a company research specialist. Gather intelligence about the target \"\n   243→                \"company: what they do, recent news, tech stack, engineering culture, growth stage, \"\n   244→                \"team size, and notable facts. The 'notable_facts' field is critical — it becomes \"\n   245→                \"the hook for the outreach email. Make it specific and real.\"\n   246→            ),\n   247→            tools=[{\n   248→                \"name\": \"research_company\",\n   249→                \"description\": \"Gather company intelligence from web sources\",\n   250→                \"input_schema\": {\n   251→                    \"type\": \"object\",\n   252→                    \"properties\": {\n   253→                        \"company_name\": {\"type\": \"string\"},\n   254→                        \"company_url\": {\"type\": \"string\"},\n   255→                        \"company_domain\": {\"type\": \"string\"},\n   256→                    },\n   257→                    \"required\": [\"company_name\"],\n   258→                },\n   259→            }],\n   260→            max_tokens=4096,\n   261→            dependencies=[\"jd_parser\"],\n   262→        ))\n   263→\n   264→        self.register(SubAgentDefinition(\n   265→            name=\"contact_finder\",\n   266→            description=\"Finds the right person to receive cold outreach at the target company\",\n   267→            system_prompt=(\n   268→                \"You are a contact discovery specialist. Find the right person to receive \"\n   269→                \"cold outreach — preferably the hiring manager or eng lead. Check the JD for \"\n   270→                \"named contacts first, then use email pattern discovery. Assign confidence: \"\n   271→                \"HIGH (verified), MEDIUM (pattern-matched), LOW (generic fallback). \"\n   272→                \"Never source from data brokers.\"\n   273→            ),\n   274→            tools=[{\n   275→                \"name\": \"find_contact\",\n   276→                \"description\": \"Discover the right contact person at a company\",\n   277→                \"input_schema\": {\n   278→                    \"type\": \"object\",\n   279→                    \"properties\": {\n   280→                        \"company_name\": {\"type\": \"string\"},\n   281→                        \"company_domain\": {\"type\": \"string\"},\n   282→                        \"parsed_jd\": {\"type\": \"object\"},\n   283→                        \"company_intel\": {\"type\": \"object\"},\n   284→                    },\n   285→                    \"required\": [\"company_name\"],\n   286→                },\n   287→            }],\n   288→            max_tokens=2048,\n   289→            dependencies=[\"company_intel\"],\n   290→        ))\n   291→\n   292→        self.register(SubAgentDefinition(\n   293→            name=\"outreach_composer\",\n   294→            description=\"Writes cold emails that don't read like cold emails\",\n   295→            system_prompt=(\n   296→                \"You are a cold outreach specialist. Write emails that feel personal and real. \"\n   297→                \"Structure: Hook (1 sentence, specific company fact) → Bridge (1-2 sentences) → \"\n   298→                \"Value (2-3 sentences, proof of impact) → Ask (1 sentence, low-friction CTA). \"\n   299→                \"Rules: 150-200 words max. Never 'I hope this finds you well.' Never 'I'm \"\n   300→                \"reaching out because...' Generate 3 subject line variants. Output stays DRAFT.\"\n   301→            ),\n   302→            tools=[{\n   303→                \"name\": \"compose_outreach\",\n   304→                \"description\": \"Compose a cold outreach email grounded in real context\",\n   305→                \"input_schema\": {\n   306→                    \"type\": \"object\",\n   307→                    \"properties\": {\n   308→                        \"parsed_jd\": {\"type\": \"object\"},\n   309→                        \"company_intel\": {\"type\": \"object\"},\n   310→                        \"contact\": {\"type\": \"object\"},\n   311→                        \"tailored_resume\": {\"type\": \"object\"},\n   312→                        \"candidate_name\": {\"type\": \"string\"},\n   313→                        \"candidate_email\": {\"type\": \"string\"},\n   314→                    },\n   315→                    \"required\": [\"parsed_jd\", \"company_intel\", \"contact\", \"tailored_resume\",\n   316→                                 \"candidate_name\", \"candidate_email\"],\n   317→                },\n   318→            }],\n   319→            max_tokens=2048,\n   320→            dependencies=[\"resume_tailor\", \"contact_finder\"],\n   321→        ))\n   322→\n   323→        self.register(SubAgentDefinition(\n   324→            name=\"auto_apply\",\n   325→            description=\"Navigates career pages and fills application forms via browser automation\",\n   326→            system_prompt=(\n   327→                \"You are a form submission specialist. Navigate ATS career pages (Greenhouse, \"\n   328→                \"Lever, Workday, Ashby) and fill application forms. CRITICAL: NEVER submit \"\n   329→                \"without explicit human approval. If CAPTCHA detected, mark as REQUIRES_MANUAL. \"\n   330→                \"Screenshot every major step for the audit trail.\"\n   331→            ),\n   332→            tools=[{\n   333→                \"name\": \"fill_application\",\n   334→                \"description\": \"Navigate to a job URL and fill the application form\",\n   335→                \"input_schema\": {\n   336→                    \"type\": \"object\",\n   337→                    \"properties\": {\n   338→                        \"job_url\": {\"type\": \"string\"},\n   339→                        \"job_id\": {\"type\": \"string\"},\n   340→                        \"candidate_info\": {\"type\": \"object\"},\n   341→                        \"tailored_resume\": {\"type\": \"object\"},\n   342→                    },\n   343→                    \"required\": [\"job_url\", \"job_id\", \"candidate_info\", \"tailored_resume\"],\n   344→                },\n   345→            }],\n   346→            max_tokens=2048,\n   347→            dependencies=[\"outreach_composer\"],\n   348→        ))\n   349→\n   350→\n   351→# ─── Sub-Agent Runner ───────────────────────────────────────────────────────\n   352→\n   353→\n   354→class SubAgentRunner:\n   355→    \"\"\"\n   356→    Executes a single sub-agent via Claude API tool_use agentic loop.\n   357→\n   358→    Each sub-agent runs as an independent Claude conversation:\n   359→      1. System prompt sets the agent's role and constraints\n   360→      2. User message provides the task context and input data\n   361→      3. Claude responds with tool_use calls\n   362→      4. Runner executes tools and feeds results back\n   363→      5. Loop continues until Claude produces a final text response\n   364→\n   365→    This is the core execution unit — crash-safe, retryable, and observable.\n   366→    \"\"\"\n   367→\n   368→    def __init__(\n   369→        self,\n   370→        claude: AsyncAnthropic,\n   371→        redis_client: aioredis.Redis,\n   372→        tool_handlers: dict[str, Callable] | None = None,\n   373→    ) -> None:\n   374→        self._claude = claude\n   375→        self._redis = redis_client\n   376→        self._tool_handlers: dict[str, Callable] = tool_handlers or {}\n   377→\n   378→    def register_tool_handler(self, tool_name: str, handler: Callable) -> None:\n   379→        \"\"\"Register a callable that executes when Claude invokes a tool.\"\"\"\n   380→        self._tool_handlers[tool_name] = handler\n   381→\n   382→    async def run(\n   383→        self,\n   384→        agent_def: SubAgentDefinition,\n   385→        input_payload: dict[str, Any],\n   386→        pipeline_id: UUID,\n   387→        attempt: int = 1,\n   388→    ) -> AgentExecutionRecord:\n   389→        \"\"\"\n   390→        Execute a sub-agent and return the execution record.\n   391→\n   392→        Runs the Claude agentic loop: prompt → tool_use → result → repeat\n   393→        until the agent produces a final response or exhausts retries.\n   394→\n   395→        Args:\n   396→            agent_def: The sub-agent definition from the registry\n   397→            input_payload: Context and data for this agent's task\n   398→            pipeline_id: Parent pipeline for tracking\n   399→            attempt: Current retry attempt number\n   400→\n   401→        Returns:\n   402→            AgentExecutionRecord with status, output, and telemetry\n   403→        \"\"\"\n   404→        record = AgentExecutionRecord(\n   405→            agent_name=agent_def.name,\n   406→            pipeline_id=pipeline_id,\n   407→            status=AgentStatus.DISPATCHED.value,\n   408→            input_payload=input_payload,\n   409→            attempt=attempt,\n   410→            started_at=datetime.now(timezone.utc),\n   411→        )\n   412→        log = logger.bind(\n   413→            agent=agent_def.name,\n   414→            pipeline_id=str(pipeline_id),\n   415→            attempt=attempt,\n   416→        )\n   417→        log.info(\"subagent_runner.dispatched\")\n   418→        await self._publish_status(record)\n   419→\n   420→        start_time = time.monotonic()\n   421→\n   422→        try:\n   423→            record.status = AgentStatus.RUNNING.value\n   424→            await self._publish_status(record)\n   425→\n   426→            # Build the initial messages for the agentic loop\n   427→            messages = [\n   428→                {\n   429→                    \"role\": \"user\",\n   430→                    \"content\": json.dumps(input_payload, default=str),\n   431→                },\n   432→            ]\n   433→\n   434→            final_output = await self._agentic_loop(\n   435→                agent_def=agent_def,\n   436→                messages=messages,\n   437→                log=log,\n   438→            )\n   439→\n   440→            record.status = AgentStatus.COMPLETED.value\n   441→            record.output_payload = final_output\n   442→            record.completed_at = datetime.now(timezone.utc)\n   443→            record.duration_ms = int((time.monotonic() - start_time) * 1000)\n   444→\n   445→            log.info(\n   446→                \"subagent_runner.completed\",\n   447→                duration_ms=record.duration_ms,\n   448→            )\n   449→\n   450→        except Exception as e:\n   451→            record.status = AgentStatus.FAILED.value\n   452→            record.error = str(e)\n   453→            record.completed_at = datetime.now(timezone.utc)\n   454→            record.duration_ms = int((time.monotonic() - start_time) * 1000)\n   455→\n   456→            log.error(\n   457→                \"subagent_runner.failed\",\n   458→                error=str(e),\n   459→                duration_ms=record.duration_ms,\n   460→            )\n   461→\n   462→            # Retry if attempts remain\n   463→            if attempt < agent_def.max_retries:\n   464→                record.status = AgentStatus.RETRYING.value\n   465→                await self._publish_status(record)\n   466→                backoff = 2 ** attempt\n   467→                log.info(\"subagent_runner.retrying\", backoff_seconds=backoff)\n   468→                await asyncio.sleep(backoff)\n   469→                return await self.run(\n   470→                    agent_def=agent_def,\n   471→                    input_payload=input_payload,\n   472→                    pipeline_id=pipeline_id,\n   473→                    attempt=attempt + 1,\n   474→                )\n   475→            else:\n   476→                record.status = AgentStatus.DEAD.value\n   477→                log.error(\"subagent_runner.dead\", attempts_exhausted=attempt)\n   478→\n   479→        await self._publish_status(record)\n   480→        return record\n   481→\n   482→    async def _agentic_loop(\n   483→        self,\n   484→        agent_def: SubAgentDefinition,\n   485→        messages: list[dict],\n   486→        log: Any,\n   487→        max_iterations: int = 10,\n   488→    ) -> dict[str, Any]:\n   489→        \"\"\"\n   490→        Run the Claude tool_use agentic loop until final response.\n   491→\n   492→        Claude calls tools → we execute them → feed results back → repeat.\n   493→        Exits when Claude responds with text (no tool_use) or max iterations hit.\n   494→        \"\"\"\n   495→        for iteration in range(max_iterations):\n   496→            log.info(\"subagent_runner.loop_iteration\", iteration=iteration)\n   497→\n   498→            response = await self._claude.messages.create(\n   499→                model=agent_def.model,\n   500→                max_tokens=agent_def.max_tokens,\n   501→                system=agent_def.system_prompt,\n   502→                tools=agent_def.tools,\n   503→                messages=messages,\n   504→            )\n   505→\n   506→            # Check if Claude wants to use tools\n   507→            tool_use_blocks = [\n   508→                block for block in response.content\n   509→                if block.type == \"tool_use\"\n   510→            ]\n   511→\n   512→            if not tool_use_blocks:\n   513→                # Final response — extract text content\n   514→                text_blocks = [\n   515→                    block.text for block in response.content\n   516→                    if block.type == \"text\"\n   517→                ]\n   518→                final_text = \"\\n\".join(text_blocks)\n   519→\n   520→                # Try to parse as JSON, fall back to raw text\n   521→                try:\n   522→                    return json.loads(final_text)\n   523→                except (json.JSONDecodeError, ValueError):\n   524→                    return {\"result\": final_text}\n   525→\n   526→            # Execute each tool call and collect results\n   527→            tool_results = []\n   528→            for tool_block in tool_use_blocks:\n   529→                tool_name = tool_block.name\n   530→                tool_input = tool_block.input\n   531→\n   532→                log.info(\n   533→                    \"subagent_runner.tool_call\",\n   534→                    tool=tool_name,\n   535→                    input_keys=list(tool_input.keys()) if isinstance(tool_input, dict) else None,\n   536→                )\n   537→\n   538→                if tool_name in self._tool_handlers:\n   539→                    try:\n   540→                        result = await self._tool_handlers[tool_name](tool_input)\n   541→                        tool_results.append({\n   542→                            \"type\": \"tool_result\",\n   543→                            \"tool_use_id\": tool_block.id,\n   544→                            \"content\": json.dumps(result, default=str),\n   545→                        })\n   546→                    except Exception as e:\n   547→                        log.error(\"subagent_runner.tool_error\", tool=tool_name, error=str(e))\n   548→                        tool_results.append({\n   549→                            \"type\": \"tool_result\",\n   550→                            \"tool_use_id\": tool_block.id,\n   551→                            \"content\": json.dumps({\"error\": str(e)}),\n   552→                            \"is_error\": True,\n   553→                        })\n   554→                else:\n   555→                    # No handler — return the tool input as the result\n   556→                    # This allows Claude to \"declare\" structured output via tool_use\n   557→                    tool_results.append({\n   558→                        \"type\": \"tool_result\",\n   559→                        \"tool_use_id\": tool_block.id,\n   560→                        \"content\": json.dumps(tool_input, default=str),\n   561→                    })\n   562→\n   563→            # Append assistant response and tool results for next iteration\n   564→            messages.append({\"role\": \"assistant\", \"content\": response.content})\n   565→            messages.append({\"role\": \"user\", \"content\": tool_results})\n   566→\n   567→        log.warning(\"subagent_runner.max_iterations\", iterations=max_iterations)\n   568→        return {\"error\": \"Max agentic loop iterations reached\", \"iterations\": max_iterations}\n   569→\n   570→    async def _publish_status(self, record: AgentExecutionRecord) -> None:\n   571→        \"\"\"Publish sub-agent status event to Redis pub/sub.\"\"\"\n   572→        payload = json.dumps({\n   573→            \"event\": \"SUBAGENT_STATUS\",\n   574→            \"execution_id\": str(record.execution_id),\n   575→            \"agent_name\": record.agent_name,\n   576→            \"pipeline_id\": str(record.pipeline_id),\n   577→            \"status\": record.status,\n   578→            \"attempt\": record.attempt,\n   579→            \"duration_ms\": record.duration_ms,\n   580→        })\n   581→        await self._redis.publish(_AGENT_STATUS_CHANNEL, payload)\n   582→\n   583→\n   584→# ─── Pipeline Dispatcher ────────────────────────────────────────────────────\n   585→\n   586→\n   587→class PipelineDispatcher:\n   588→    \"\"\"\n   589→    Coordinates multi-agent pipelines with dependency-aware execution.\n   590→\n   591→    Resolves the dependency graph into execution tiers, dispatches\n   592→    agents within each tier concurrently, and feeds outputs from\n   593→    completed agents into dependent agents as input context.\n   594→\n   595→    This is the brains of the agentic management layer — it decides\n   596→    what runs when and wires data between agents.\n   597→    \"\"\"\n   598→\n   599→    def __init__(\n   600→        self,\n   601→        registry: SubAgentRegistry,\n   602→        runner: SubAgentRunner,\n   603→        redis_client: aioredis.Redis,\n   604→        max_concurrency: int | None = None,\n   605→    ) -> None:\n   606→        self._registry = registry\n   607→        self._runner = runner\n   608→        self._redis = redis_client\n   609→        self._max_concurrency = max_concurrency or settings.max_parallel_applications\n   610→        self._semaphore = asyncio.Semaphore(self._max_concurrency)\n   611→\n   612→    async def dispatch_pipeline(\n   613→        self,\n   614→        pipeline_id: UUID,\n   615→        agent_names: list[str],\n   616→        initial_context: dict[str, Any],\n   617→        on_agent_complete: Callable | None = None,\n   618→    ) -> dict[str, AgentExecutionRecord]:\n   619→        \"\"\"\n   620→        Execute a full pipeline of sub-agents respecting dependencies.\n   621→\n   622→        Args:\n   623→            pipeline_id: Pipeline being executed\n   624→            agent_names: Which agents to run (subset of registry)\n   625→            initial_context: Starting data (candidate, job, etc.)\n   626→            on_agent_complete: Optional callback after each agent completes\n   627→\n   628→        Returns:\n   629→            Dict mapping agent_name → AgentExecutionRecord\n   630→        \"\"\"\n   631→        log = logger.bind(pipeline_id=str(pipeline_id))\n   632→        log.info(\n   633→            \"pipeline_dispatcher.starting\",\n   634→            agents=agent_names,\n   635→        )\n   636→\n   637→        # Resolve execution order\n   638→        tiers = self._registry.get_dependency_order(agent_names)\n   639→        log.info(\"pipeline_dispatcher.tiers_resolved\", tiers=tiers)\n   640→\n   641→        # Accumulated results from all completed agents\n   642→        context = dict(initial_context)\n   643→        results: dict[str, AgentExecutionRecord] = {}\n   644→\n   645→        for tier_idx, tier in enumerate(tiers):\n   646→            log.info(\n   647→                \"pipeline_dispatcher.tier_start\",\n   648→                tier=tier_idx,\n   649→                agents=tier,\n   650→            )\n   651→\n   652→            # Dispatch all agents in this tier concurrently\n   653→            tasks = []\n   654→            for agent_name in tier:\n   655→                agent_def = self._registry.get(agent_name)\n   656→                task = asyncio.create_task(\n   657→                    self._dispatch_with_semaphore(\n   658→                        agent_def=agent_def,\n   659→                        input_payload=context,\n   660→                        pipeline_id=pipeline_id,\n   661→                    )\n   662→                )\n   663→                tasks.append((agent_name, task))\n   664→\n   665→            # Await all agents in this tier\n   666→            for agent_name, task in tasks:\n   667→                record = await task\n   668→                results[agent_name] = record\n   669→\n   670→                if record.status == AgentStatus.COMPLETED.value and record.output_payload:\n   671→                    # Merge output into context for downstream agents\n   672→                    context[f\"{agent_name}_output\"] = record.output_payload\n   673→                    log.info(\n   674→                        \"pipeline_dispatcher.agent_completed\",\n   675→                        agent=agent_name,\n   676→                        duration_ms=record.duration_ms,\n   677→                    )\n   678→                elif record.status in (AgentStatus.FAILED.value, AgentStatus.DEAD.value):\n   679→                    log.error(\n   680→                        \"pipeline_dispatcher.agent_failed\",\n   681→                        agent=agent_name,\n   682→                        error=record.error,\n   683→                    )\n   684→\n   685→                if on_agent_complete:\n   686→                    await on_agent_complete(agent_name, record)\n   687→\n   688→            # Check if any critical agent failed — abort pipeline if so\n   689→            failed = [\n   690→                name for name, rec in results.items()\n   691→                if rec.status in (AgentStatus.FAILED.value, AgentStatus.DEAD.value)\n   692→            ]\n   693→            if failed:\n   694→                log.error(\n   695→                    \"pipeline_dispatcher.tier_failed\",\n   696→                    tier=tier_idx,\n   697→                    failed_agents=failed,\n   698→                )\n   699→                # Publish pipeline failure\n   700→                await self._publish_pipeline_status(pipeline_id, \"FAILED\", {\n   701→                    \"failed_agents\": failed,\n   702→                    \"completed_tier\": tier_idx,\n   703→                })\n   704→                break\n   705→\n   706→        log.info(\n   707→            \"pipeline_dispatcher.complete\",\n   708→            total_agents=len(results),\n   709→            completed=[n for n, r in results.items() if r.status == AgentStatus.COMPLETED.value],\n   710→            failed=[n for n, r in results.items() if r.status != AgentStatus.COMPLETED.value],\n   711→        )\n   712→\n   713→        return results\n   714→\n   715→    async def _dispatch_with_semaphore(\n   716→        self,\n   717→        agent_def: SubAgentDefinition,\n   718→        input_payload: dict[str, Any],\n   719→        pipeline_id: UUID,\n   720→    ) -> AgentExecutionRecord:\n   721→        \"\"\"Run a sub-agent within the concurrency semaphore.\"\"\"\n   722→        async with self._semaphore:\n   723→            return await self._runner.run(\n   724→                agent_def=agent_def,\n   725→                input_payload=input_payload,\n   726→                pipeline_id=pipeline_id,\n   727→            )\n   728→\n   729→    async def _publish_pipeline_status(\n   730→        self,\n   731→        pipeline_id: UUID,\n   732→        status: str,\n   733→        details: dict | None = None,\n   734→    ) -> None:\n   735→        \"\"\"Publish pipeline-level status to Redis pub/sub.\"\"\"\n   736→        payload = json.dumps({\n   737→            \"event\": \"PIPELINE_STATUS\",\n   738→            \"pipeline_id\": str(pipeline_id),\n   739→            \"status\": status,\n   740→            \"details\": details or {},\n   741→        })\n   742→        await self._redis.publish(\"agent.status.application\", payload)\n   743→\n   744→\n   745→# ─── Agent Manager (top-level facade) ───────────────────────────────────────\n   746→\n   747→\n   748→class AgentManager:\n   749→    \"\"\"\n   750→    Top-level facade for the agentic management layer.\n   751→\n   752→    Provides a clean interface for the API layer and orchestrator to dispatch\n   753→    sub-agent pipelines. Handles initialization of the registry, runner, and\n   754→    dispatcher, and exposes methods for common pipeline patterns.\n   755→\n   756→    Usage:\n   757→        manager = AgentManager(db, redis_client)\n   758→\n   759→        # Run the full application pipeline\n   760→        results = await manager.run_application_pipeline(\n   761→            pipeline_id=pipeline_id,\n   762→            job_data={...},\n   763→            candidate_data={...},\n   764→        )\n   765→\n   766→        # Run a single agent\n   767→        record = await manager.run_single_agent(\n   768→            agent_name=\"jd_parser\",\n   769→            input_payload={...},\n   770→            pipeline_id=pipeline_id,\n   771→        )\n   772→    \"\"\"\n   773→\n   774→    def __init__(\n   775→        self,\n   776→        db: AsyncSession,\n   777→        redis_client: aioredis.Redis,\n   778→    ) -> None:\n   779→        self._db = db\n   780→        self._redis = redis_client\n   781→        self._claude = AsyncAnthropic(api_key=settings.anthropic_api_key)\n   782→\n   783→        self._registry = SubAgentRegistry()\n   784→        self._runner = SubAgentRunner(\n   785→            claude=self._claude,\n   786→            redis_client=redis_client,\n   787→        )\n   788→        self._dispatcher = PipelineDispatcher(\n   789→            registry=self._registry,\n   790→            runner=self._runner,\n   791→            redis_client=redis_client,\n   792→        )\n   793→\n   794→        # Wire up tool handlers that connect Claude's tool_use to real agent code\n   795→        self._register_tool_handlers()\n   796→\n   797→    def _register_tool_handlers(self) -> None:\n   798→        \"\"\"\n   799→        Connect Claude tool_use calls to real agent implementations.\n   800→\n   801→        When Claude calls a tool like 'parse_job_description', the handler\n   802→        invokes the actual JDParser agent code and returns structured results.\n   803→        \"\"\"\n   804→        from backend.agents.application.jd_parser import JDParser\n   805→        from backend.agents.application.resume_tailor import ResumeTailor\n   806→        from backend.agents.application.company_intel import CompanyIntelAgent\n   807→        from backend.agents.application.contact_finder import ContactFinder\n   808→        from backend.agents.application.outreach_composer import OutreachComposer\n   809→        from backend.agents.application.auto_apply import AutoApplyAgent\n   810→\n   811→        jd_parser = JDParser(self._db, self._claude)\n   812→        resume_tailor = ResumeTailor(self._db, self._claude)\n   813→        company_intel = CompanyIntelAgent(self._db, self._redis, self._claude)\n   814→        contact_finder = ContactFinder(self._db)\n   815→        outreach_composer = OutreachComposer(self._db, self._claude)\n   816→        auto_apply = AutoApplyAgent()\n   817→\n   818→        async def handle_parse_jd(input_data: dict) -> dict:\n   819→            \"\"\"Execute JD parsing via the real JDParser agent.\"\"\"\n   820→            from backend.agents.discovery.schemas import DiscoveredJobSchema, ScoredJobSchema, ScoreBreakdown\n   821→            job_schema = DiscoveredJobSchema(\n   822→                id=input_data[\"job_id\"],\n   823→                candidate_id=input_data.get(\"candidate_id\", \"00000000-0000-0000-0000-000000000000\"),\n   824→                title=input_data[\"title\"],\n   825→                company=input_data[\"company\"],\n   826→                description=input_data[\"description\"],\n   827→                url=input_data.get(\"url\", \"\"),\n   828→                url_hash=input_data.get(\"url_hash\", \"\"),\n   829→                source=input_data.get(\"source\", \"cloud_agent\"),\n   830→            )\n   831→            scored = ScoredJobSchema(\n   832→                job=job_schema,\n   833→                scores=ScoreBreakdown(),\n   834→                composite_score=70,\n   835→                reasoning=\"\",\n   836→            )\n   837→            result = await jd_parser.parse(scored)\n   838→            return result.model_dump(mode=\"json\")\n   839→\n   840→        async def handle_tailor_resume(input_data: dict) -> dict:\n   841→            \"\"\"Execute resume tailoring via the real ResumeTailor agent.\"\"\"\n   842→            from backend.agents.application.schemas import ParsedJDSchema\n   843→            from backend.agents.discovery.schemas import CandidateSchema\n   844→            from backend.agents.discovery.identity_profiler import IdentityProfiler\n   845→\n   846→            parsed_jd = ParsedJDSchema(**input_data[\"parsed_jd\"])\n   847→            candidate = CandidateSchema(**input_data[\"candidate_info\"])\n   848→\n   849→            profiler = IdentityProfiler(self._redis, self._claude)\n   850→            profile = await profiler.build_profile(candidate)\n   851→\n   852→            result = await resume_tailor.tailor(parsed_jd, candidate, profile)\n   853→            return result.model_dump(mode=\"json\")\n   854→\n   855→        async def handle_research_company(input_data: dict) -> dict:\n   856→            \"\"\"Execute company research via the real CompanyIntelAgent.\"\"\"\n   857→            result = await company_intel.research(\n   858→                company_name=input_data[\"company_name\"],\n   859→                company_url=input_data.get(\"company_url\"),\n   860→            )\n   861→            return result.model_dump(mode=\"json\")\n   862→\n   863→        async def handle_find_contact(input_data: dict) -> dict:\n   864→            \"\"\"Execute contact discovery via the real ContactFinder.\"\"\"\n   865→            from backend.agents.application.schemas import CompanyIntelSchema, ParsedJDSchema\n   866→            intel = CompanyIntelSchema(**input_data[\"company_intel\"])\n   867→            parsed_jd = ParsedJDSchema(**input_data[\"parsed_jd\"])\n   868→            result = await contact_finder.find(intel, parsed_jd)\n   869→            return result.model_dump(mode=\"json\")\n   870→\n   871→        async def handle_compose_outreach(input_data: dict) -> dict:\n   872→            \"\"\"Execute outreach composition via the real OutreachComposer.\"\"\"\n   873→            from backend.agents.application.schemas import (\n   874→                ParsedJDSchema, CompanyIntelSchema, ContactSchema, TailoredResumeSchema,\n   875→            )\n   876→            from backend.agents.discovery.identity_profiler import IdentityProfiler\n   877→            from backend.agents.discovery.schemas import CandidateSchema\n   878→\n   879→            parsed_jd = ParsedJDSchema(**input_data[\"parsed_jd\"])\n   880→            intel = CompanyIntelSchema(**input_data[\"company_intel\"])\n   881→            contact = ContactSchema(**input_data[\"contact\"])\n   882→            resume = TailoredResumeSchema(**input_data[\"tailored_resume\"])\n   883→\n   884→            # Build profile for outreach context\n   885→            candidate_data = input_data.get(\"candidate_info\", {})\n   886→            candidate = CandidateSchema(**candidate_data) if candidate_data else None\n   887→            profile = None\n   888→            if candidate:\n   889→                profiler = IdentityProfiler(self._redis, self._claude)\n   890→                profile = await profiler.build_profile(candidate)\n   891→\n   892→            result = await outreach_composer.compose(\n   893→                parsed_jd=parsed_jd,\n   894→                intel=intel,\n   895→                contact=contact,\n   896→                resume=resume,\n   897→                profile=profile,\n   898→                candidate_name=input_data.get(\"candidate_name\", \"\"),\n   899→                candidate_email=input_data.get(\"candidate_email\", \"\"),\n   900→                candidate_github=input_data.get(\"candidate_github\"),\n   901→                candidate_linkedin=input_data.get(\"candidate_linkedin\"),\n   902→            )\n   903→            return result.model_dump(mode=\"json\")\n   904→\n   905→        async def handle_fill_application(input_data: dict) -> dict:\n   906→            \"\"\"Execute form filling via the real AutoApplyAgent.\"\"\"\n   907→            from backend.agents.application.schemas import TailoredResumeSchema\n   908→            from backend.agents.discovery.schemas import CandidateSchema\n   909→\n   910→            candidate = CandidateSchema(**input_data[\"candidate_info\"])\n   911→            resume = TailoredResumeSchema(**input_data[\"tailored_resume\"])\n   912→\n   913→            result = await auto_apply.submit(\n   914→                job_url=input_data[\"job_url\"],\n   915→                job_id=input_data[\"job_id\"],\n   916→                pipeline_id=input_data.get(\"pipeline_id\", \"00000000-0000-0000-0000-000000000000\"),\n   917→                candidate=candidate,\n   918→                resume=resume,\n   919→            )\n   920→            return result.model_dump(mode=\"json\")\n   921→\n   922→        # Register all handlers\n   923→        self._runner.register_tool_handler(\"parse_job_description\", handle_parse_jd)\n   924→        self._runner.register_tool_handler(\"tailor_resume\", handle_tailor_resume)\n   925→        self._runner.register_tool_handler(\"research_company\", handle_research_company)\n   926→        self._runner.register_tool_handler(\"find_contact\", handle_find_contact)\n   927→        self._runner.register_tool_handler(\"compose_outreach\", handle_compose_outreach)\n   928→        self._runner.register_tool_handler(\"fill_application\", handle_fill_application)\n   929→\n   930→    async def run_application_pipeline(\n   931→        self,\n   932→        pipeline_id: UUID,\n   933→        job_data: dict[str, Any],\n   934→        candidate_data: dict[str, Any],\n   935→        agents: list[str] | None = None,\n   936→        on_agent_complete: Callable | None = None,\n   937→    ) -> dict[str, AgentExecutionRecord]:\n   938→        \"\"\"\n   939→        Run the full application pipeline for an approved job.\n   940→\n   941→        Dispatches all sub-agents in dependency order, feeding outputs\n   942→        between agents automatically.\n   943→\n   944→        Args:\n   945→            pipeline_id: Pipeline ID for tracking\n   946→            job_data: Job details (id, title, company, description, url)\n   947→            candidate_data: Candidate details (name, email, resume, etc.)\n   948→            agents: Optional subset of agents to run (defaults to full pipeline)\n   949→            on_agent_complete: Optional callback after each agent finishes\n   950→\n   951→        Returns:\n   952→            Dict mapping agent_name → AgentExecutionRecord\n   953→        \"\"\"\n   954→        default_agents = [\n   955→            \"jd_parser\",\n   956→            \"resume_tailor\",\n   957→            \"company_intel\",\n   958→            \"contact_finder\",\n   959→            \"outreach_composer\",\n   960→        ]\n   961→        agent_names = agents or default_agents\n   962→\n   963→        initial_context = {\n   964→            \"job\": job_data,\n   965→            \"candidate_info\": candidate_data,\n   966→            \"pipeline_id\": str(pipeline_id),\n   967→            **job_data,\n   968→        }\n   969→\n   970→        return await self._dispatcher.dispatch_pipeline(\n   971→            pipeline_id=pipeline_id,\n   972→            agent_names=agent_names,\n   973→            initial_context=initial_context,\n   974→            on_agent_complete=on_agent_complete,\n   975→        )\n   976→\n   977→    async def run_single_agent(\n   978→        self,\n   979→        agent_name: str,\n   980→        input_payload: dict[str, Any],\n   981→        pipeline_id: UUID,\n   982→    ) -> AgentExecutionRecord:\n   983→        \"\"\"\n   984→        Run a single sub-agent in isolation.\n   985→\n   986→        Useful for re-running a failed agent, testing, or ad-hoc execution.\n   987→\n   988→        Args:\n   989→            agent_name: Name of the registered agent to run\n   990→            input_payload: Input data for the agent\n   991→            pipeline_id: Pipeline ID for tracking\n   992→\n   993→        Returns:\n   994→            AgentExecutionRecord with full execution details\n   995→        \"\"\"\n   996→        agent_def = self._registry.get(agent_name)\n   997→        return await self._runner.run(\n   998→            agent_def=agent_def,\n   999→            input_payload=input_payload,\n  1000→            pipeline_id=pipeline_id,\n  1001→        )\n  1002→\n  1003→    def list_agents(self) -> list[dict[str, Any]]:\n  1004→        \"\"\"List all registered agents with their metadata.\"\"\"\n  1005→        agents = []\n  1006→        for name in self._registry.list_agents():\n  1007→            agent_def = self._registry.get(name)\n  1008→            agents.append({\n  1009→                \"name\": agent_def.name,\n  1010→                \"description\": agent_def.description,\n  1011→                \"dependencies\": agent_def.dependencies,\n  1012→                \"model\": agent_def.model,\n  1013→                \"max_retries\": agent_def.max_retries,\n  1014→                \"timeout_seconds\": agent_def.timeout_seconds,\n  1015→            })\n  1016→        return agents\n  1017→\n  1018→    def get_execution_plan(\n  1019→        self, agent_names: list[str] | None = None\n  1020→    ) -> list[list[str]]:\n  1021→        \"\"\"\n  1022→        Preview the execution order without running anything.\n  1023→\n  1024→        Returns tiers of agents — agents within a tier run concurrently.\n  1025→\n  1026→        Args:\n  1027→            agent_names: Which agents to plan for (defaults to full pipeline)\n  1028→\n  1029→        Returns:\n  1030→            List of tiers, where each tier is a list of agent names\n  1031→        \"\"\"\n  1032→        default_agents = [\n  1033→            \"jd_parser\",\n  1034→            \"resume_tailor\",\n  1035→            \"company_intel\",\n  1036→            \"contact_finder\",\n  1037→            \"outreach_composer\",\n  1038→        ]\n  1039→        names = agent_names or default_agents\n  1040→        return self._registry.get_dependency_order(names)\n  1041→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"78b056f7-705e-4dcd-b620-10cb1067f6bf","uuid":"e6b89c98-f130-4cb3-9313-171239943ea7","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/application/agent_manager.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nAgent Manager — dispatches and coordinates application sub-agents via Claude Cloud.\n\nThis is the agentic management layer that wraps each application sub-agent\nas an autonomous Claude-powered worker. Instead of direct method calls,\neach agent is dispatched as an independent Claude API call with its own\nsystem prompt, tool definitions, and execution context.\n\nArchitecture:\n  AgentManager\n    ├── SubAgentRegistry    ← defines available agents + their capabilities\n    ├── SubAgentRunner      ← executes a single agent via Claude API tool_use loop\n    ├── PipelineDispatcher  ← coordinates multi-agent pipelines with dependency graph\n    └── AgentStateStore     ← persists agent state for resume/retry across processes\n\nExecution model:\n  1. Master agent receives a pipeline request\n  2. Builds a dependency graph of sub-agent tasks\n  3. Dispatches independent agents concurrently\n  4. Each agent runs its own Claude agentic loop (prompt → tool_use → result)\n  5. Results flow back through schemas, feeding dependent agents\n  6. State is persisted at every step — crash-safe, resumable\n\nStatus per sub-agent:\n  QUEUED → DISPATCHED → RUNNING → COMPLETED\n                                → FAILED → RETRYING → COMPLETED\n                                                    → DEAD\n\"\"\"\n\nfrom __future__ import annotations\n\nimport asyncio\nimport json\nimport time\nfrom dataclasses import dataclass, field\nfrom datetime import datetime, timezone\nfrom enum import Enum\nfrom typing import Any, Callable, Optional\nfrom uuid import UUID, uuid4\n\nimport redis.asyncio as aioredis\nimport structlog\nfrom anthropic import AsyncAnthropic\nfrom pydantic import BaseModel\nfrom sqlalchemy.ext.asyncio import AsyncSession\n\nfrom backend.config import settings\n\nlogger = structlog.get_logger(__name__)\n\n_AGENT_STATUS_CHANNEL = \"agent.status.subagent\"\n\n\n# ─── Agent Status ────────────────────────────────────────────────────────────\n\n\nclass AgentStatus(str, Enum):\n    \"\"\"Status lifecycle for each sub-agent execution.\"\"\"\n\n    QUEUED = \"QUEUED\"\n    DISPATCHED = \"DISPATCHED\"\n    RUNNING = \"RUNNING\"\n    COMPLETED = \"COMPLETED\"\n    FAILED = \"FAILED\"\n    RETRYING = \"RETRYING\"\n    DEAD = \"DEAD\"\n\n\n# ─── Agent Definition ───────────────────────────────────────────────────────\n\n\n@dataclass\nclass SubAgentDefinition:\n    \"\"\"\n    Declares a sub-agent's identity, capabilities, and execution context.\n\n    Each sub-agent gets its own Claude system prompt and tool definitions,\n    making it a self-contained autonomous worker.\n    \"\"\"\n\n    name: str\n    description: str\n    system_prompt: str\n    tools: list[dict[str, Any]] = field(default_factory=list)\n    model: str = \"claude-sonnet-4-20250514\"\n    max_tokens: int = 4096\n    max_retries: int = 3\n    timeout_seconds: int = 120\n    dependencies: list[str] = field(default_factory=list)\n\n\n# ─── Agent Execution Record ─────────────────────────────────────────────────\n\n\nclass AgentExecutionRecord(BaseModel):\n    \"\"\"Tracks a single sub-agent execution — persisted for observability and resume.\"\"\"\n\n    execution_id: UUID = None\n    agent_name: str\n    pipeline_id: UUID\n    status: str = AgentStatus.QUEUED.value\n    input_payload: dict = {}\n    output_payload: Optional[dict] = None\n    error: Optional[str] = None\n    attempt: int = 1\n    started_at: Optional[datetime] = None\n    completed_at: Optional[datetime] = None\n    duration_ms: Optional[int] = None\n    token_usage: Optional[dict] = None\n\n    def model_post_init(self, __context: Any) -> None:\n        \"\"\"Set execution_id if not provided.\"\"\"\n        if self.execution_id is None:\n            self.execution_id = uuid4()\n\n\n# ─── Sub-Agent Registry ─────────────────────────────────────────────────────\n\n\nclass SubAgentRegistry:\n    \"\"\"\n    Registry of all available sub-agents and their definitions.\n\n    Each agent is declared with its system prompt, tool definitions,\n    and dependency requirements. The registry is the source of truth\n    for what agents exist and how they should be invoked.\n    \"\"\"\n\n    def __init__(self) -> None:\n        self._agents: dict[str, SubAgentDefinition] = {}\n        self._register_defaults()\n\n    def register(self, agent: SubAgentDefinition) -> None:\n        \"\"\"Register a sub-agent definition.\"\"\"\n        self._agents[agent.name] = agent\n        logger.info(\"agent_registry.registered\", agent=agent.name)\n\n    def get(self, name: str) -> SubAgentDefinition:\n        \"\"\"Retrieve a registered agent definition by name.\"\"\"\n        if name not in self._agents:\n            raise KeyError(f\"Agent '{name}' not registered. Available: {list(self._agents.keys())}\")\n        return self._agents[name]\n\n    def list_agents(self) -> list[str]:\n        \"\"\"List all registered agent names.\"\"\"\n        return list(self._agents.keys())\n\n    def get_dependency_order(self, agent_names: list[str]) -> list[list[str]]:\n        \"\"\"\n        Resolve execution order from dependency graph.\n\n        Returns a list of tiers — agents within a tier can run concurrently.\n        Agents in tier N+1 depend on agents in tier N.\n        \"\"\"\n        resolved: set[str] = set()\n        tiers: list[list[str]] = []\n\n        remaining = set(agent_names)\n        while remaining:\n            tier = []\n            for name in list(remaining):\n                agent = self.get(name)\n                deps = set(agent.dependencies) & set(agent_names)\n                if deps.issubset(resolved):\n                    tier.append(name)\n            if not tier:\n                unresolved = {\n                    n: self.get(n).dependencies for n in remaining\n                }\n                raise ValueError(f\"Circular dependency detected: {unresolved}\")\n            for name in tier:\n                remaining.discard(name)\n                resolved.add(name)\n            tiers.append(tier)\n\n        return tiers\n\n    def _register_defaults(self) -> None:\n        \"\"\"Register the standard application engine sub-agents.\"\"\"\n\n        self.register(SubAgentDefinition(\n            name=\"jd_parser\",\n            description=\"Parses job descriptions into structured signals for resume tailoring\",\n            system_prompt=(\n                \"You are a JD parsing specialist. Extract structured signals from job descriptions: \"\n                \"required skills, preferred skills, seniority level, team context, responsibilities, \"\n                \"culture signals, tech stack, pain points, tone, compensation, red flags, and \"\n                \"application instructions. Be precise — downstream agents depend on your accuracy.\"\n            ),\n            tools=[{\n                \"name\": \"parse_job_description\",\n                \"description\": \"Extract structured data from a raw job description\",\n                \"input_schema\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                        \"job_id\": {\"type\": \"string\", \"description\": \"UUID of the job\"},\n                        \"title\": {\"type\": \"string\"},\n                        \"company\": {\"type\": \"string\"},\n                        \"description\": {\"type\": \"string\", \"description\": \"Raw JD text\"},\n                    },\n                    \"required\": [\"job_id\", \"title\", \"company\", \"description\"],\n                },\n            }],\n            max_tokens=2048,\n            dependencies=[],\n        ))\n\n        self.register(SubAgentDefinition(\n            name=\"resume_tailor\",\n            description=\"Rewrites candidate resumes to align with specific job requirements\",\n            system_prompt=(\n                \"You are a resume tailoring specialist. Rewrite the candidate's resume to align \"\n                \"with the target role. Rules: NEVER fabricate experience, titles, dates, or metrics. \"\n                \"Mirror JD language naturally. Prioritize relevance over comprehensiveness. \"\n                \"Flag skill gaps in change_log — never invent skills the candidate doesn't have.\"\n            ),\n            tools=[{\n                \"name\": \"tailor_resume\",\n                \"description\": \"Rewrite a resume for a specific role based on parsed JD signals\",\n                \"input_schema\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                        \"candidate_resume\": {\"type\": \"string\"},\n                        \"candidate_name\": {\"type\": \"string\"},\n                        \"parsed_jd\": {\"type\": \"object\", \"description\": \"Structured JD signals\"},\n                        \"identity_profile\": {\"type\": \"object\", \"description\": \"Candidate identity profile\"},\n                    },\n                    \"required\": [\"candidate_resume\", \"candidate_name\", \"parsed_jd\"],\n                },\n            }],\n            max_tokens=4096,\n            dependencies=[\"jd_parser\"],\n        ))\n\n        self.register(SubAgentDefinition(\n            name=\"company_intel\",\n            description=\"Researches companies to provide real context for outreach\",\n            system_prompt=(\n                \"You are a company research specialist. Gather intelligence about the target \"\n                \"company: what they do, recent news, tech stack, engineering culture, growth stage, \"\n                \"team size, and notable facts. The 'notable_facts' field is critical — it becomes \"\n                \"the hook for the outreach email. Make it specific and real.\"\n            ),\n            tools=[{\n                \"name\": \"research_company\",\n                \"description\": \"Gather company intelligence from web sources\",\n                \"input_schema\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                        \"company_name\": {\"type\": \"string\"},\n                        \"company_url\": {\"type\": \"string\"},\n                        \"company_domain\": {\"type\": \"string\"},\n                    },\n                    \"required\": [\"company_name\"],\n                },\n            }],\n            max_tokens=4096,\n            dependencies=[\"jd_parser\"],\n        ))\n\n        self.register(SubAgentDefinition(\n            name=\"contact_finder\",\n            description=\"Finds the right person to receive cold outreach at the target company\",\n            system_prompt=(\n                \"You are a contact discovery specialist. Find the right person to receive \"\n                \"cold outreach — preferably the hiring manager or eng lead. Check the JD for \"\n                \"named contacts first, then use email pattern discovery. Assign confidence: \"\n                \"HIGH (verified), MEDIUM (pattern-matched), LOW (generic fallback). \"\n                \"Never source from data brokers.\"\n            ),\n            tools=[{\n                \"name\": \"find_contact\",\n                \"description\": \"Discover the right contact person at a company\",\n                \"input_schema\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                        \"company_name\": {\"type\": \"string\"},\n                        \"company_domain\": {\"type\": \"string\"},\n                        \"parsed_jd\": {\"type\": \"object\"},\n                        \"company_intel\": {\"type\": \"object\"},\n                    },\n                    \"required\": [\"company_name\"],\n                },\n            }],\n            max_tokens=2048,\n            dependencies=[\"company_intel\"],\n        ))\n\n        self.register(SubAgentDefinition(\n            name=\"outreach_composer\",\n            description=\"Writes cold emails that don't read like cold emails\",\n            system_prompt=(\n                \"You are a cold outreach specialist. Write emails that feel personal and real. \"\n                \"Structure: Hook (1 sentence, specific company fact) → Bridge (1-2 sentences) → \"\n                \"Value (2-3 sentences, proof of impact) → Ask (1 sentence, low-friction CTA). \"\n                \"Rules: 150-200 words max. Never 'I hope this finds you well.' Never 'I'm \"\n                \"reaching out because...' Generate 3 subject line variants. Output stays DRAFT.\"\n            ),\n            tools=[{\n                \"name\": \"compose_outreach\",\n                \"description\": \"Compose a cold outreach email grounded in real context\",\n                \"input_schema\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                        \"parsed_jd\": {\"type\": \"object\"},\n                        \"company_intel\": {\"type\": \"object\"},\n                        \"contact\": {\"type\": \"object\"},\n                        \"tailored_resume\": {\"type\": \"object\"},\n                        \"candidate_name\": {\"type\": \"string\"},\n                        \"candidate_email\": {\"type\": \"string\"},\n                    },\n                    \"required\": [\"parsed_jd\", \"company_intel\", \"contact\", \"tailored_resume\",\n                                 \"candidate_name\", \"candidate_email\"],\n                },\n            }],\n            max_tokens=2048,\n            dependencies=[\"resume_tailor\", \"contact_finder\"],\n        ))\n\n        self.register(SubAgentDefinition(\n            name=\"auto_apply\",\n            description=\"Navigates career pages and fills application forms via browser automation\",\n            system_prompt=(\n                \"You are a form submission specialist. Navigate ATS career pages (Greenhouse, \"\n                \"Lever, Workday, Ashby) and fill application forms. CRITICAL: NEVER submit \"\n                \"without explicit human approval. If CAPTCHA detected, mark as REQUIRES_MANUAL. \"\n                \"Screenshot every major step for the audit trail.\"\n            ),\n            tools=[{\n                \"name\": \"fill_application\",\n                \"description\": \"Navigate to a job URL and fill the application form\",\n                \"input_schema\": {\n                    \"type\": \"object\",\n                    \"properties\": {\n                        \"job_url\": {\"type\": \"string\"},\n                        \"job_id\": {\"type\": \"string\"},\n                        \"candidate_info\": {\"type\": \"object\"},\n                        \"tailored_resume\": {\"type\": \"object\"},\n                    },\n                    \"required\": [\"job_url\", \"job_id\", \"candidate_info\", \"tailored_resume\"],\n                },\n            }],\n            max_tokens=2048,\n            dependencies=[\"outreach_composer\"],\n        ))\n\n\n# ─── Sub-Agent Runner ───────────────────────────────────────────────────────\n\n\nclass SubAgentRunner:\n    \"\"\"\n    Executes a single sub-agent via Claude API tool_use agentic loop.\n\n    Each sub-agent runs as an independent Claude conversation:\n      1. System prompt sets the agent's role and constraints\n      2. User message provides the task context and input data\n      3. Claude responds with tool_use calls\n      4. Runner executes tools and feeds results back\n      5. Loop continues until Claude produces a final text response\n\n    This is the core execution unit — crash-safe, retryable, and observable.\n    \"\"\"\n\n    def __init__(\n        self,\n        claude: AsyncAnthropic,\n        redis_client: aioredis.Redis,\n        tool_handlers: dict[str, Callable] | None = None,\n    ) -> None:\n        self._claude = claude\n        self._redis = redis_client\n        self._tool_handlers: dict[str, Callable] = tool_handlers or {}\n\n    def register_tool_handler(self, tool_name: str, handler: Callable) -> None:\n        \"\"\"Register a callable that executes when Claude invokes a tool.\"\"\"\n        self._tool_handlers[tool_name] = handler\n\n    async def run(\n        self,\n        agent_def: SubAgentDefinition,\n        input_payload: dict[str, Any],\n        pipeline_id: UUID,\n        attempt: int = 1,\n    ) -> AgentExecutionRecord:\n        \"\"\"\n        Execute a sub-agent and return the execution record.\n\n        Runs the Claude agentic loop: prompt → tool_use → result → repeat\n        until the agent produces a final response or exhausts retries.\n\n        Args:\n            agent_def: The sub-agent definition from the registry\n            input_payload: Context and data for this agent's task\n            pipeline_id: Parent pipeline for tracking\n            attempt: Current retry attempt number\n\n        Returns:\n            AgentExecutionRecord with status, output, and telemetry\n        \"\"\"\n        record = AgentExecutionRecord(\n            agent_name=agent_def.name,\n            pipeline_id=pipeline_id,\n            status=AgentStatus.DISPATCHED.value,\n            input_payload=input_payload,\n            attempt=attempt,\n            started_at=datetime.now(timezone.utc),\n        )\n        log = logger.bind(\n            agent=agent_def.name,\n            pipeline_id=str(pipeline_id),\n            attempt=attempt,\n        )\n        log.info(\"subagent_runner.dispatched\")\n        await self._publish_status(record)\n\n        start_time = time.monotonic()\n\n        try:\n            record.status = AgentStatus.RUNNING.value\n            await self._publish_status(record)\n\n            # Build the initial messages for the agentic loop\n            messages = [\n                {\n                    \"role\": \"user\",\n                    \"content\": json.dumps(input_payload, default=str),\n                },\n            ]\n\n            final_output = await self._agentic_loop(\n                agent_def=agent_def,\n                messages=messages,\n                log=log,\n            )\n\n            record.status = AgentStatus.COMPLETED.value\n            record.output_payload = final_output\n            record.completed_at = datetime.now(timezone.utc)\n            record.duration_ms = int((time.monotonic() - start_time) * 1000)\n\n            log.info(\n                \"subagent_runner.completed\",\n                duration_ms=record.duration_ms,\n            )\n\n        except Exception as e:\n            record.status = AgentStatus.FAILED.value\n            record.error = str(e)\n            record.completed_at = datetime.now(timezone.utc)\n            record.duration_ms = int((time.monotonic() - start_time) * 1000)\n\n            log.error(\n                \"subagent_runner.failed\",\n                error=str(e),\n                duration_ms=record.duration_ms,\n            )\n\n            # Retry if attempts remain\n            if attempt < agent_def.max_retries:\n                record.status = AgentStatus.RETRYING.value\n                await self._publish_status(record)\n                backoff = 2 ** attempt\n                log.info(\"subagent_runner.retrying\", backoff_seconds=backoff)\n                await asyncio.sleep(backoff)\n                return await self.run(\n                    agent_def=agent_def,\n                    input_payload=input_payload,\n                    pipeline_id=pipeline_id,\n                    attempt=attempt + 1,\n                )\n            else:\n                record.status = AgentStatus.DEAD.value\n                log.error(\"subagent_runner.dead\", attempts_exhausted=attempt)\n\n        await self._publish_status(record)\n        return record\n\n    async def _agentic_loop(\n        self,\n        agent_def: SubAgentDefinition,\n        messages: list[dict],\n        log: Any,\n        max_iterations: int = 10,\n    ) -> dict[str, Any]:\n        \"\"\"\n        Run the Claude tool_use agentic loop until final response.\n\n        Claude calls tools → we execute them → feed results back → repeat.\n        Exits when Claude responds with text (no tool_use) or max iterations hit.\n        \"\"\"\n        for iteration in range(max_iterations):\n            log.info(\"subagent_runner.loop_iteration\", iteration=iteration)\n\n            response = await self._claude.messages.create(\n                model=agent_def.model,\n                max_tokens=agent_def.max_tokens,\n                system=agent_def.system_prompt,\n                tools=agent_def.tools,\n                messages=messages,\n            )\n\n            # Check if Claude wants to use tools\n            tool_use_blocks = [\n                block for block in response.content\n                if block.type == \"tool_use\"\n            ]\n\n            if not tool_use_blocks:\n                # Final response — extract text content\n                text_blocks = [\n                    block.text for block in response.content\n                    if block.type == \"text\"\n                ]\n                final_text = \"\\n\".join(text_blocks)\n\n                # Try to parse as JSON, fall back to raw text\n                try:\n                    return json.loads(final_text)\n                except (json.JSONDecodeError, ValueError):\n                    return {\"result\": final_text}\n\n            # Execute each tool call and collect results\n            tool_results = []\n            for tool_block in tool_use_blocks:\n                tool_name = tool_block.name\n                tool_input = tool_block.input\n\n                log.info(\n                    \"subagent_runner.tool_call\",\n                    tool=tool_name,\n                    input_keys=list(tool_input.keys()) if isinstance(tool_input, dict) else None,\n                )\n\n                if tool_name in self._tool_handlers:\n                    try:\n                        result = await self._tool_handlers[tool_name](tool_input)\n                        tool_results.append({\n                            \"type\": \"tool_result\",\n                            \"tool_use_id\": tool_block.id,\n                            \"content\": json.dumps(result, default=str),\n                        })\n                    except Exception as e:\n                        log.error(\"subagent_runner.tool_error\", tool=tool_name, error=str(e))\n                        tool_results.append({\n                            \"type\": \"tool_result\",\n                            \"tool_use_id\": tool_block.id,\n                            \"content\": json.dumps({\"error\": str(e)}),\n                            \"is_error\": True,\n                        })\n                else:\n                    # No handler — return the tool input as the result\n                    # This allows Claude to \"declare\" structured output via tool_use\n                    tool_results.append({\n                        \"type\": \"tool_result\",\n                        \"tool_use_id\": tool_block.id,\n                        \"content\": json.dumps(tool_input, default=str),\n                    })\n\n            # Append assistant response and tool results for next iteration\n            messages.append({\"role\": \"assistant\", \"content\": response.content})\n            messages.append({\"role\": \"user\", \"content\": tool_results})\n\n        log.warning(\"subagent_runner.max_iterations\", iterations=max_iterations)\n        return {\"error\": \"Max agentic loop iterations reached\", \"iterations\": max_iterations}\n\n    async def _publish_status(self, record: AgentExecutionRecord) -> None:\n        \"\"\"Publish sub-agent status event to Redis pub/sub.\"\"\"\n        payload = json.dumps({\n            \"event\": \"SUBAGENT_STATUS\",\n            \"execution_id\": str(record.execution_id),\n            \"agent_name\": record.agent_name,\n            \"pipeline_id\": str(record.pipeline_id),\n            \"status\": record.status,\n            \"attempt\": record.attempt,\n            \"duration_ms\": record.duration_ms,\n        })\n        await self._redis.publish(_AGENT_STATUS_CHANNEL, payload)\n\n\n# ─── Pipeline Dispatcher ────────────────────────────────────────────────────\n\n\nclass PipelineDispatcher:\n    \"\"\"\n    Coordinates multi-agent pipelines with dependency-aware execution.\n\n    Resolves the dependency graph into execution tiers, dispatches\n    agents within each tier concurrently, and feeds outputs from\n    completed agents into dependent agents as input context.\n\n    This is the brains of the agentic management layer — it decides\n    what runs when and wires data between agents.\n    \"\"\"\n\n    def __init__(\n        self,\n        registry: SubAgentRegistry,\n        runner: SubAgentRunner,\n        redis_client: aioredis.Redis,\n        max_concurrency: int | None = None,\n    ) -> None:\n        self._registry = registry\n        self._runner = runner\n        self._redis = redis_client\n        self._max_concurrency = max_concurrency or settings.max_parallel_applications\n        self._semaphore = asyncio.Semaphore(self._max_concurrency)\n\n    async def dispatch_pipeline(\n        self,\n        pipeline_id: UUID,\n        agent_names: list[str],\n        initial_context: dict[str, Any],\n        on_agent_complete: Callable | None = None,\n    ) -> dict[str, AgentExecutionRecord]:\n        \"\"\"\n        Execute a full pipeline of sub-agents respecting dependencies.\n\n        Args:\n            pipeline_id: Pipeline being executed\n            agent_names: Which agents to run (subset of registry)\n            initial_context: Starting data (candidate, job, etc.)\n            on_agent_complete: Optional callback after each agent completes\n\n        Returns:\n            Dict mapping agent_name → AgentExecutionRecord\n        \"\"\"\n        log = logger.bind(pipeline_id=str(pipeline_id))\n        log.info(\n            \"pipeline_dispatcher.starting\",\n            agents=agent_names,\n        )\n\n        # Resolve execution order\n        tiers = self._registry.get_dependency_order(agent_names)\n        log.info(\"pipeline_dispatcher.tiers_resolved\", tiers=tiers)\n\n        # Accumulated results from all completed agents\n        context = dict(initial_context)\n        results: dict[str, AgentExecutionRecord] = {}\n\n        for tier_idx, tier in enumerate(tiers):\n            log.info(\n                \"pipeline_dispatcher.tier_start\",\n                tier=tier_idx,\n                agents=tier,\n            )\n\n            # Dispatch all agents in this tier concurrently\n            tasks = []\n            for agent_name in tier:\n                agent_def = self._registry.get(agent_name)\n                task = asyncio.create_task(\n                    self._dispatch_with_semaphore(\n                        agent_def=agent_def,\n                        input_payload=context,\n                        pipeline_id=pipeline_id,\n                    )\n                )\n                tasks.append((agent_name, task))\n\n            # Await all agents in this tier\n            for agent_name, task in tasks:\n                record = await task\n                results[agent_name] = record\n\n                if record.status == AgentStatus.COMPLETED.value and record.output_payload:\n                    # Merge output into context for downstream agents\n                    context[f\"{agent_name}_output\"] = record.output_payload\n                    log.info(\n                        \"pipeline_dispatcher.agent_completed\",\n                        agent=agent_name,\n                        duration_ms=record.duration_ms,\n                    )\n                elif record.status in (AgentStatus.FAILED.value, AgentStatus.DEAD.value):\n                    log.error(\n                        \"pipeline_dispatcher.agent_failed\",\n                        agent=agent_name,\n                        error=record.error,\n                    )\n\n                if on_agent_complete:\n                    await on_agent_complete(agent_name, record)\n\n            # Check if any critical agent failed — abort pipeline if so\n            failed = [\n                name for name, rec in results.items()\n                if rec.status in (AgentStatus.FAILED.value, AgentStatus.DEAD.value)\n            ]\n            if failed:\n                log.error(\n                    \"pipeline_dispatcher.tier_failed\",\n                    tier=tier_idx,\n                    failed_agents=failed,\n                )\n                # Publish pipeline failure\n                await self._publish_pipeline_status(pipeline_id, \"FAILED\", {\n                    \"failed_agents\": failed,\n                    \"completed_tier\": tier_idx,\n                })\n                break\n\n        log.info(\n            \"pipeline_dispatcher.complete\",\n            total_agents=len(results),\n            completed=[n for n, r in results.items() if r.status == AgentStatus.COMPLETED.value],\n            failed=[n for n, r in results.items() if r.status != AgentStatus.COMPLETED.value],\n        )\n\n        return results\n\n    async def _dispatch_with_semaphore(\n        self,\n        agent_def: SubAgentDefinition,\n        input_payload: dict[str, Any],\n        pipeline_id: UUID,\n    ) -> AgentExecutionRecord:\n        \"\"\"Run a sub-agent within the concurrency semaphore.\"\"\"\n        async with self._semaphore:\n            return await self._runner.run(\n                agent_def=agent_def,\n                input_payload=input_payload,\n                pipeline_id=pipeline_id,\n            )\n\n    async def _publish_pipeline_status(\n        self,\n        pipeline_id: UUID,\n        status: str,\n        details: dict | None = None,\n    ) -> None:\n        \"\"\"Publish pipeline-level status to Redis pub/sub.\"\"\"\n        payload = json.dumps({\n            \"event\": \"PIPELINE_STATUS\",\n            \"pipeline_id\": str(pipeline_id),\n            \"status\": status,\n            \"details\": details or {},\n        })\n        await self._redis.publish(\"agent.status.application\", payload)\n\n\n# ─── Agent Manager (top-level facade) ───────────────────────────────────────\n\n\nclass AgentManager:\n    \"\"\"\n    Top-level facade for the agentic management layer.\n\n    Provides a clean interface for the API layer and orchestrator to dispatch\n    sub-agent pipelines. Handles initialization of the registry, runner, and\n    dispatcher, and exposes methods for common pipeline patterns.\n\n    Usage:\n        manager = AgentManager(db, redis_client)\n\n        # Run the full application pipeline\n        results = await manager.run_application_pipeline(\n            pipeline_id=pipeline_id,\n            job_data={...},\n            candidate_data={...},\n        )\n\n        # Run a single agent\n        record = await manager.run_single_agent(\n            agent_name=\"jd_parser\",\n            input_payload={...},\n            pipeline_id=pipeline_id,\n        )\n    \"\"\"\n\n    def __init__(\n        self,\n        db: AsyncSession,\n        redis_client: aioredis.Redis,\n    ) -> None:\n        self._db = db\n        self._redis = redis_client\n        self._claude = AsyncAnthropic(api_key=settings.anthropic_api_key)\n\n        self._registry = SubAgentRegistry()\n        self._runner = SubAgentRunner(\n            claude=self._claude,\n            redis_client=redis_client,\n        )\n        self._dispatcher = PipelineDispatcher(\n            registry=self._registry,\n            runner=self._runner,\n            redis_client=redis_client,\n        )\n\n        # Wire up tool handlers that connect Claude's tool_use to real agent code\n        self._register_tool_handlers()\n\n    def _register_tool_handlers(self) -> None:\n        \"\"\"\n        Connect Claude tool_use calls to real agent implementations.\n\n        When Claude calls a tool like 'parse_job_description', the handler\n        invokes the actual JDParser agent code and returns structured results.\n        \"\"\"\n        from backend.agents.application.jd_parser import JDParser\n        from backend.agents.application.resume_tailor import ResumeTailor\n        from backend.agents.application.company_intel import CompanyIntelAgent\n        from backend.agents.application.contact_finder import ContactFinder\n        from backend.agents.application.outreach_composer import OutreachComposer\n        from backend.agents.application.auto_apply import AutoApplyAgent\n\n        jd_parser = JDParser(self._db, self._claude)\n        resume_tailor = ResumeTailor(self._db, self._claude)\n        company_intel = CompanyIntelAgent(self._db, self._redis, self._claude)\n        contact_finder = ContactFinder(self._db)\n        outreach_composer = OutreachComposer(self._db, self._claude)\n        auto_apply = AutoApplyAgent()\n\n        async def handle_parse_jd(input_data: dict) -> dict:\n            \"\"\"Execute JD parsing via the real JDParser agent.\"\"\"\n            from backend.agents.discovery.schemas import DiscoveredJobSchema, ScoredJobSchema, ScoreBreakdown\n            job_schema = DiscoveredJobSchema(\n                id=input_data[\"job_id\"],\n                candidate_id=input_data.get(\"candidate_id\", \"00000000-0000-0000-0000-000000000000\"),\n                title=input_data[\"title\"],\n                company=input_data[\"company\"],\n                description=input_data[\"description\"],\n                url=input_data.get(\"url\", \"\"),\n                url_hash=input_data.get(\"url_hash\", \"\"),\n                source=input_data.get(\"source\", \"cloud_agent\"),\n            )\n            scored = ScoredJobSchema(\n                job=job_schema,\n                scores=ScoreBreakdown(),\n                composite_score=70,\n                reasoning=\"\",\n            )\n            result = await jd_parser.parse(scored)\n            return result.model_dump(mode=\"json\")\n\n        async def handle_tailor_resume(input_data: dict) -> dict:\n            \"\"\"Execute resume tailoring via the real ResumeTailor agent.\"\"\"\n            from backend.agents.application.schemas import ParsedJDSchema\n            from backend.agents.discovery.schemas import CandidateSchema\n            from backend.agents.discovery.identity_profiler import IdentityProfiler\n\n            parsed_jd = ParsedJDSchema(**input_data[\"parsed_jd\"])\n            candidate = CandidateSchema(**input_data[\"candidate_info\"])\n\n            profiler = IdentityProfiler(self._redis, self._claude)\n            profile = await profiler.build_profile(candidate)\n\n            result = await resume_tailor.tailor(parsed_jd, candidate, profile)\n            return result.model_dump(mode=\"json\")\n\n        async def handle_research_company(input_data: dict) -> dict:\n            \"\"\"Execute company research via the real CompanyIntelAgent.\"\"\"\n            result = await company_intel.research(\n                company_name=input_data[\"company_name\"],\n                company_url=input_data.get(\"company_url\"),\n            )\n            return result.model_dump(mode=\"json\")\n\n        async def handle_find_contact(input_data: dict) -> dict:\n            \"\"\"Execute contact discovery via the real ContactFinder.\"\"\"\n            from backend.agents.application.schemas import CompanyIntelSchema, ParsedJDSchema\n            intel = CompanyIntelSchema(**input_data[\"company_intel\"])\n            parsed_jd = ParsedJDSchema(**input_data[\"parsed_jd\"])\n            result = await contact_finder.find(intel, parsed_jd)\n            return result.model_dump(mode=\"json\")\n\n        async def handle_compose_outreach(input_data: dict) -> dict:\n            \"\"\"Execute outreach composition via the real OutreachComposer.\"\"\"\n            from backend.agents.application.schemas import (\n                ParsedJDSchema, CompanyIntelSchema, ContactSchema, TailoredResumeSchema,\n            )\n            from backend.agents.discovery.identity_profiler import IdentityProfiler\n            from backend.agents.discovery.schemas import CandidateSchema\n\n            parsed_jd = ParsedJDSchema(**input_data[\"parsed_jd\"])\n            intel = CompanyIntelSchema(**input_data[\"company_intel\"])\n            contact = ContactSchema(**input_data[\"contact\"])\n            resume = TailoredResumeSchema(**input_data[\"tailored_resume\"])\n\n            # Build profile for outreach context\n            candidate_data = input_data.get(\"candidate_info\", {})\n            candidate = CandidateSchema(**candidate_data) if candidate_data else None\n            profile = None\n            if candidate:\n                profiler = IdentityProfiler(self._redis, self._claude)\n                profile = await profiler.build_profile(candidate)\n\n            result = await outreach_composer.compose(\n                parsed_jd=parsed_jd,\n                intel=intel,\n                contact=contact,\n                resume=resume,\n                profile=profile,\n                candidate_name=input_data.get(\"candidate_name\", \"\"),\n                candidate_email=input_data.get(\"candidate_email\", \"\"),\n                candidate_github=input_data.get(\"candidate_github\"),\n                candidate_linkedin=input_data.get(\"candidate_linkedin\"),\n            )\n            return result.model_dump(mode=\"json\")\n\n        async def handle_fill_application(input_data: dict) -> dict:\n            \"\"\"Execute form filling via the real AutoApplyAgent.\"\"\"\n            from backend.agents.application.schemas import TailoredResumeSchema\n            from backend.agents.discovery.schemas import CandidateSchema\n\n            candidate = CandidateSchema(**input_data[\"candidate_info\"])\n            resume = TailoredResumeSchema(**input_data[\"tailored_resume\"])\n\n            result = await auto_apply.submit(\n                job_url=input_data[\"job_url\"],\n                job_id=input_data[\"job_id\"],\n                pipeline_id=input_data.get(\"pipeline_id\", \"00000000-0000-0000-0000-000000000000\"),\n                candidate=candidate,\n                resume=resume,\n            )\n            return result.model_dump(mode=\"json\")\n\n        # Register all handlers\n        self._runner.register_tool_handler(\"parse_job_description\", handle_parse_jd)\n        self._runner.register_tool_handler(\"tailor_resume\", handle_tailor_resume)\n        self._runner.register_tool_handler(\"research_company\", handle_research_company)\n        self._runner.register_tool_handler(\"find_contact\", handle_find_contact)\n        self._runner.register_tool_handler(\"compose_outreach\", handle_compose_outreach)\n        self._runner.register_tool_handler(\"fill_application\", handle_fill_application)\n\n    async def run_application_pipeline(\n        self,\n        pipeline_id: UUID,\n        job_data: dict[str, Any],\n        candidate_data: dict[str, Any],\n        agents: list[str] | None = None,\n        on_agent_complete: Callable | None = None,\n    ) -> dict[str, AgentExecutionRecord]:\n        \"\"\"\n        Run the full application pipeline for an approved job.\n\n        Dispatches all sub-agents in dependency order, feeding outputs\n        between agents automatically.\n\n        Args:\n            pipeline_id: Pipeline ID for tracking\n            job_data: Job details (id, title, company, description, url)\n            candidate_data: Candidate details (name, email, resume, etc.)\n            agents: Optional subset of agents to run (defaults to full pipeline)\n            on_agent_complete: Optional callback after each agent finishes\n\n        Returns:\n            Dict mapping agent_name → AgentExecutionRecord\n        \"\"\"\n        default_agents = [\n            \"jd_parser\",\n            \"resume_tailor\",\n            \"company_intel\",\n            \"contact_finder\",\n            \"outreach_composer\",\n        ]\n        agent_names = agents or default_agents\n\n        initial_context = {\n            \"job\": job_data,\n            \"candidate_info\": candidate_data,\n            \"pipeline_id\": str(pipeline_id),\n            **job_data,\n        }\n\n        return await self._dispatcher.dispatch_pipeline(\n            pipeline_id=pipeline_id,\n            agent_names=agent_names,\n            initial_context=initial_context,\n            on_agent_complete=on_agent_complete,\n        )\n\n    async def run_single_agent(\n        self,\n        agent_name: str,\n        input_payload: dict[str, Any],\n        pipeline_id: UUID,\n    ) -> AgentExecutionRecord:\n        \"\"\"\n        Run a single sub-agent in isolation.\n\n        Useful for re-running a failed agent, testing, or ad-hoc execution.\n\n        Args:\n            agent_name: Name of the registered agent to run\n            input_payload: Input data for the agent\n            pipeline_id: Pipeline ID for tracking\n\n        Returns:\n            AgentExecutionRecord with full execution details\n        \"\"\"\n        agent_def = self._registry.get(agent_name)\n        return await self._runner.run(\n            agent_def=agent_def,\n            input_payload=input_payload,\n            pipeline_id=pipeline_id,\n        )\n\n    def list_agents(self) -> list[dict[str, Any]]:\n        \"\"\"List all registered agents with their metadata.\"\"\"\n        agents = []\n        for name in self._registry.list_agents():\n            agent_def = self._registry.get(name)\n            agents.append({\n                \"name\": agent_def.name,\n                \"description\": agent_def.description,\n                \"dependencies\": agent_def.dependencies,\n                \"model\": agent_def.model,\n                \"max_retries\": agent_def.max_retries,\n                \"timeout_seconds\": agent_def.timeout_seconds,\n            })\n        return agents\n\n    def get_execution_plan(\n        self, agent_names: list[str] | None = None\n    ) -> list[list[str]]:\n        \"\"\"\n        Preview the execution order without running anything.\n\n        Returns tiers of agents — agents within a tier run concurrently.\n\n        Args:\n            agent_names: Which agents to plan for (defaults to full pipeline)\n\n        Returns:\n            List of tiers, where each tier is a list of agent names\n        \"\"\"\n        default_agents = [\n            \"jd_parser\",\n            \"resume_tailor\",\n            \"company_intel\",\n            \"contact_finder\",\n            \"outreach_composer\",\n        ]\n        names = agent_names or default_agents\n        return self._registry.get_dependency_order(names)\n","numLines":1041,"startLine":1,"totalLines":1041}}}}
