{"t":"2026-05-20T20:18:21.850Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PQ7L5kFF7NH3CUcfDHErzL","type":"tool_result","content":"181:    def _register_defaults(self) -> None:\n182-        \"\"\"Register the standard application engine sub-agents.\"\"\"\n183-\n184-        self.register(SubAgentDefinition(\n185-            name=\"jd_parser\",\n186-            description=\"Parses job descriptions into structured signals for resume tailoring\",\n187-            system_prompt=(\n188-                \"You are a JD parsing specialist. Extract structured signals from job descriptions: \"\n189-                \"required skills, preferred skills, seniority level, team context, responsibilities, \"\n190-                \"culture signals, tech stack, pain points, tone, compensation, red flags, and \"\n191-                \"application instructions. Be precise — downstream agents depend on your accuracy.\"\n192-            ),\n193-            tools=[{\n194-                \"name\": \"parse_job_description\",\n195-                \"description\": \"Extract structured data from a raw job description\",\n196-                \"input_schema\": {\n197-                    \"type\": \"object\",\n198-                    \"properties\": {\n199-                        \"job_id\": {\"type\": \"string\", \"description\": \"UUID of the job\"},\n200-                        \"title\": {\"type\": \"string\"},\n201-                        \"company\": {\"type\": \"string\"},\n202-                        \"description\": {\"type\": \"string\", \"description\": \"Raw JD text\"},\n203-                    },\n204-                    \"required\": [\"job_id\", \"title\", \"company\", \"description\"],\n205-                },\n206-            }],\n207-            max_tokens=2048,\n208-            dependencies=[],\n209-        ))\n210-\n211-        self.register(SubAgentDefinition(\n212-            name=\"resume_tailor\",\n213-            description=\"Rewrites candidate resumes to align with specific job requirements\",\n214-            system_prompt=(\n215-                \"You are a resume tailoring specialist. Rewrite the candidate's resume to align \"\n216-                \"with the target role. Rules: NEVER fabricate experience, titles, dates, or metrics. \"\n217-                \"Mirror JD language naturally. Prioritize relevance over comprehensiveness. \"\n218-                \"Flag skill gaps in change_log — never invent skills the candidate doesn't have.\"\n219-            ),\n220-            tools=[{\n221-                \"name\": \"tailor_resume\",\n222-                \"description\": \"Rewrite a resume for a specific role based on parsed JD signals\",\n223-                \"input_schema\": {\n224-                    \"type\": \"object\",\n225-                    \"properties\": {\n226-                        \"candidate_resume\": {\"type\": \"string\"},\n227-                        \"candidate_name\": {\"type\": \"string\"},\n228-                        \"parsed_jd\": {\"type\": \"object\", \"description\": \"Structured JD signals\"},\n229-                        \"identity_profile\": {\"type\": \"object\", \"description\": \"Candidate identity profile\"},\n230-                    },\n231-                    \"required\": [\"candidate_resume\", \"candidate_name\", \"parsed_jd\"],\n232-                },\n233-            }],\n234-            max_tokens=4096,\n235-            dependencies=[\"jd_parser\"],\n236-        ))\n237-\n238-        self.register(SubAgentDefinition(\n239-            name=\"company_intel\",\n240-            description=\"Researches companies to provide real context for outreach\",\n241-            system_prompt=(\n242-                \"You are a company research specialist. Gather intelligence about the target \"\n243-                \"company: what they do, recent news, tech stack, engineering culture, growth stage, \"\n244-                \"team size, and notable facts.