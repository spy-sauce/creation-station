efault_factory=list)\n   152→    body: str = Field(default=\"\", description=\"Email body — 150–200 words max\")\n   153→    tone_used: Optional[str] = None\n   154→    hook_used: Optional[str] = None\n   155→    status: str = \"DRAFT\"  # DRAFT | SENT | BOUNCED | REPLIED\n   156→    created_at: Optional[datetime] = None\n   157→\n   158→\n   159→# ─── Application Result ───────────────────────────────────────────────────────\n   160→\n   161→\n   162→class ApplicationResultSchema(BaseModel):\n   163→    \"\"\"\n   164→    Result of an auto-apply submission attempt.\n   165→\n   166→    Status can be: SUBMITTED, FAILED, REQUIRES_MANUAL\n   167→    \"\"\"\n   168→\n   169→    model_config = ConfigDict(from_attributes=True)\n   170→\n   171→    pipeline_id: UUID\n   172→    job_id: UUID\n   173→    status: str  # SUBMITTED | FAILED | REQUIRES_MANUAL\n   174→    confirmation_number: Optional[str] = None\n   175→    screenshot_path: Optional[str] = None\n   176→    fields_completed: list[str] = Field(default_factory=list)\n   177→    error: Optional[str] = None\n   178→    fallback_url: Optional[str] = None\n   179→\n   180→\n   181→# ─── Application Pipeline ─────────────────────────────────────────────────────\n   182→\n   183→\n   184→class ApplicationPipelineSchema(BaseModel):\n   185→    \"\"\"\n   186→    Full pipeline state for a single approved job application.\n   187→\n   188→    Status flow:\n   189→      QUEUED → PARSING → TAILORING → RESEARCHING → COMPOSING →\n   190→      AWAITING_REVIEW → APPROVED/REJECTED → SUBMITTED → SENT → TRACKED\n   191→    \"\"\"\n   192→\n   193→    model_config = ConfigDict(from_attributes=True)\n   194→\n   195→    id: Optional[UUID] = None\n   196→    candidate_id: UUID\n   197→    job_id: UUID\n   198→    status: str = \"QUEUED\"\n   199→    parsed_jd: Optional[ParsedJDSchema] = None\n   200→    tailored_resume: Optional[TailoredResumeSchema] = None\n   201→    company_intel: Optional[CompanyIntelSchema] = None\n   202→    contact: Optional[ContactSchema] = None\n   203→    outreach_email: Optional[OutreachEmailSchema] = None\n   204→    approval_timestamp: Optional[datetime] = None\n   205→    submitted_at: Optional[datetime] = None\n   206→    screenshots: list[str] = Field(default_factory=list)\n   207→    created_at: Optional[datetime] = None\n   208→    updated_at: Optional[datetime] = None\n   209→\n   210→\n   211→# ─── CRM Event ────────────────────────────────────────────────────────────────\n   212→\n   213→\n   214→class CRMEventSchema(BaseModel):\n   215→    \"\"\"An immutable timeline event in the application journey.\"\"\"\n   216→\n   217→    model_config = ConfigDict(from_attributes=True)\n   218→\n   219→    id: Optional[UUID] = None\n   220→    pipeline_id: UUID\n   221→    event_type: str = Field(\n   222→        default=\"\",\n   223→        description=\"JD_PARSED | RESUME_TAILORED | COMPANY_RESEARCHED | CONTACT_FOUND | \"\n   224→        \"EMAIL_DRAFTED | SUBMITTED | PIPELINE_FAILED | APPROVED | REJECTED\",\n   225→    )\n   226→    payload: Optional[dict] = Field(default_factory=dict)\n   227→    created_at: Optional[datetime] = None\n   228→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"78b056f7-705e-4dcd-b620-10cb1067f6bf","uuid":"cd185eb1-f352-447e-bfaa-cfd615825662","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/application/schemas.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nPydantic v2 schemas for the Application Engine.\n\nThese are the data contracts between application agents — separate from ORM models.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import datetime\nfrom typing import Optional, Union\nfrom uuid import UUID\n\nfrom pydantic import BaseModel, Field, ConfigDict\n\n\n# ─── Parsed JD ────────────────────────────────────────────────────────────────\n\n\nclass ParsedJDSchema(BaseModel):\n    \"\"\"\n    Deep-parsed job description — every signal needed for tailoring the application.\n\n    Generated by JDParser. Cached in PostgreSQL — reused if job is re-processed.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    job_id: UUID\n    required_skills: list[str] = Field(default_factory=list)\n    preferred_skills: list[str] = Field(default_factory=list)\n    seniority_level: str = \"senior\"\n    team_context: Optional[str] = None\n    key_responsibilities: list[str] = Field(default_factory=list)\n    culture_signals: dict[str, str] = Field(default_factory=dict)\n    tech_stack: list[str] = Field(default_factory=list)\n    pain_points: Optional[str] = None\n    tone: str = \"professional\"\n    comp_mentioned: Optional[str] = None\n    red_flags: list[str] = Field(default_factory=list)\n    application_instructions: Optional[str] = None\n    parsed_at: Optional[datetime] = None\n\n\n# ─── Tailored Resume ──────────────────────────────────────────────────────────\n\n\nclass TailoredResumeSchema(BaseModel):\n    \"\"\"\n    Rewritten resume tailored for a specific role.\n\n    Never fabricates experience — rewrites framing, ordering, and emphasis.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    pipeline_id: Optional[UUID] = None\n    job_id: Optional[UUID] = None\n    candidate_id: Optional[UUID] = None\n    original_text: str = \"\"\n    tailored_text: str = \"\"\n    summary: str = \"\"\n    full_text: str = \"\"\n    change_log: Union[str, list[str]] = \"\"\n    gap_analysis: Optional[str] = None\n    version: int = 1\n    pdf_path: Optional[str] = None\n    created_at: Optional[datetime] = None\n\n\n# ─── Company Intel ────────────────────────────────────────────────────────────\n\n\nclass CompanyIntelSchema(BaseModel):\n    \"\"\"\n    Synthesized company research for outreach composition.\n\n    Cached 7 days — don't re-scrape the same company within a week.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    pipeline_id: Optional[UUID] = None\n    company_name: str\n    domain: Optional[str] = None\n    about: Optional[str] = None\n    recent_news: Optional[str] = None\n    tech_stack: list[str] = Field(default_factory=list)\n    engineering_culture: Optional[str] = None\n    glassdoor_signals: Optional[str] = None\n    growth_stage: Optional[str] = None\n    team_size: Optional[str] = None\n    notable_facts: Optional[str] = None\n    cache_age: Optional[datetime] = None\n    researched_at: Optional[datetime] = None\n\n\n# ─── Contact ──────────────────────────────────────────────────────────────────\n\n\nclass ContactSchema(BaseModel):\n    \"\"\"\n    The right person to send the cold outreach to.\n\n    Confidence levels: HIGH = verified email; MEDIUM = pattern-matched; LOW = generic fallback.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    pipeline_id: Optional[UUID] = None\n    company_intel_id: Optional[UUID] = None\n    name: Optional[str] = None\n    title: Optional[str] = None\n    email: Optional[str] = None\n    linkedin_url: Optional[str] = None\n    confidence: str = \"LOW\"  # HIGH | MEDIUM | LOW\n    fallback_email: Optional[str] = None\n    source: Optional[str] = None\n    found_at: Optional[datetime] = None\n\n\n# ─── Outreach Email ───────────────────────────────────────────────────────────\n\n\nclass OutreachEmailSchema(BaseModel):\n    \"\"\"\n    A cold email that doesn't read like a cold email.\n\n    Stays in DRAFT status until approved in the Review Dashboard.\n    Max 150–200 words. Grounded in real company context.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    pipeline_id: Optional[UUID] = None\n    job_id: Optional[UUID] = None\n    candidate_id: Optional[UUID] = None\n    to: Optional[str] = None\n    subject: str = \"\"\n    subject_lines: list[str] = Field(\n        default_factory=list,\n        description=\"3 subject line variants shown in Review Dashboard\",\n    )\n    subject_variants: list[str] = Field(default_factory=list)\n    body: str = Field(default=\"\", description=\"Email body — 150–200 words max\")\n    tone_used: Optional[str] = None\n    hook_used: Optional[str] = None\n    status: str = \"DRAFT\"  # DRAFT | SENT | BOUNCED | REPLIED\n    created_at: Optional[datetime] = None\n\n\n# ─── Application Result ───────────────────────────────────────────────────────\n\n\nclass ApplicationResultSchema(BaseModel):\n    \"\"\"\n    Result of an auto-apply submission attempt.\n\n    Status can be: SUBMITTED, FAILED, REQUIRES_MANUAL\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    pipeline_id: UUID\n    job_id: UUID\n    status: str  # SUBMITTED | FAILED | REQUIRES_MANUAL\n    confirmation_number: Optional[str] = None\n    screenshot_path: Optional[str] = None\n    fields_completed: list[str] = Field(default_factory=list)\n    error: Optional[str] = None\n    fallback_url: Optional[str] = None\n\n\n# ─── Application Pipeline ─────────────────────────────────────────────────────\n\n\nclass ApplicationPipelineSchema(BaseModel):\n    \"\"\"\n    Full pipeline state for a single approved job application.\n\n    Status flow:\n      QUEUED → PARSING → TAILORING → RESEARCHING → COMPOSING →\n      AWAITING_REVIEW → APPROVED/REJECTED → SUBMITTED → SENT → TRACKED\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    candidate_id: UUID\n    job_id: UUID\n    status: str = \"QUEUED\"\n    parsed_jd: Optional[ParsedJDSchema] = None\n    tailored_resume: Optional[TailoredResumeSchema] = None\n    company_intel: Optional[CompanyIntelSchema] = None\n    contact: Optional[ContactSchema] = None\n    outreach_email: Optional[OutreachEmailSchema] = None\n    approval_timestamp: Optional[datetime] = None\n    submitted_at: Optional[datetime] = None\n    screenshots: list[str] = Field(default_factory=list)\n    created_at: Optional[datetime] = None\n    updated_at: Optional[datetime] = None\n\n\n# ─── CRM Event ────────────────────────────────────────────────────────────────\n\n\nclass CRMEventSchema(BaseModel):\n    \"\"\"An immutable timeline event in the application journey.\"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    pipeline_id: UUID\n    event_type: str = Field(\n        default=\"\",\n        description=\"JD_PARSED | RESUME_TAILORED | COMPANY_RESEARCHED | CONTACT_FOUND | \"\n        \"EMAIL_DRAFTED | SUBMITTED | PIPELINE_FAILED | APPROVED | REJECTED\",\n    )\n    payload: Optional[dict] = Field(default_factory=dict)\n    created_at: Optional[datetime] = None\n","numLines":228,"startLine":1,"totalLines":228}}}}
