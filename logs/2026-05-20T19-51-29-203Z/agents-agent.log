{"t":"2026-05-20T20:15:20.438Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018tSK2Ahm3jzcZ16RPLJAMh","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Pydantic v2 schemas for the Discovery Engine.\n     6→\n     7→These are the data contracts between agents — separate from ORM models.\n     8→Aligns with NUTRIENTS.md DATA_CONTRACTS.\n     9→\"\"\"\n    10→\n    11→from __future__ import annotations\n    12→\n    13→from datetime import datetime\n    14→from typing import Optional, Union\n    15→from uuid import UUID\n    16→\n    17→from pydantic import BaseModel, Field, ConfigDict, computed_field\n    18→\n    19→\n    20→# ─── Candidate ────────────────────────────────────────────────────────────────\n    21→\n    22→\n    23→class CandidateSchema(BaseModel):\n    24→    \"\"\"Full candidate profile used as input to the Discovery Engine.\"\"\"\n    25→\n    26→    model_config = ConfigDict(from_attributes=True)\n    27→\n    28→    id: UUID\n    29→    name: str\n    30→    email: str\n    31→    resume_text: str\n    32→    linkedin_url: Optional[str] = None\n    33→    github_url: Optional[str] = None\n    34→    personal_context: Optional[str] = None\n    35→    target_locations: list[str] = Field(default_factory=list)\n    36→    remote_preference: str = \"flexible\"\n    37→    min_compensation: Optional[int] = None\n    38→    excluded_companies: list[str] = Field(default_factory=list)\n    39→    excluded_industries: list[str] = Field(default_factory=list)\n    40→    created_at: Optional[datetime] = None\n    41→    updated_at: Optional[datetime] = None\n    42→\n    43→\n    44→# ─── Identity Profile ─────────────────────────────────────────────────────────\n    45→\n    46→\n    47→class IdentityProfileSchema(BaseModel):\n    48→    \"\"\"\n    49→    Multi-dimensional identity model for a candidate.\n    50→\n    51→    Generated by IdentityProfiler — the foundation of the entire discovery run.\n    52→    Cached in Redis for 24h.\n    53→\n    54→    Matches NUTRIENTS.md DATA_CONTRACTS.IdentityProfile.\n    55→    \"\"\"\n    56→\n    57→    model_config = ConfigDict(from_attributes=True)\n    58→\n    59→    archetypes: list[str] = Field(default_factory=list)\n    60→    archetype_tags: list[str] = Field(default_factory=list)  # Alias for agents\n    61→    leadership_level: str = Field(\n    62→        default=\"IC\",\n    63→        description=\"IC | Lead | Manager | Director | VP | C-Level\",\n    64→    )\n    65→    technical_skills: Union[dict[str, int], list[str]] = Field(default_factory=dict)\n    66→    soft_skills: list[str] = Field(default_factory=list)\n    67→    domain_expertise: list[str] = Field(default_factory=list)\n    68→    industry_experience: list[str] = Field(default_factory=list)\n    69→    notable_achievements: list[str] = Field(default_factory=list)\n    70→    career_trajectory: str = \"\"\n    71→    ideal_role_description: str = \"\"\n    72→    creative_layer: list[str] = Field(default_factory=list)\n    73→    signals: dict[str, str] = Field(default_factory=dict)\n    74→\n    75→\n    76→# Alias for backward compatibility\n    77→IdentityProfile = IdentityProfileSchema\n    78→\n    79→\n    80→# ─── Search Manifest ─────────────────────────────────────────────────────────\n    81→\n    82→\n    83→class SearchManifestSchema(BaseModel):\n    84→    \"\"\"\n    85→    Search instructions derived from an IdentityProfile.\n    86→\n    87→    Matches NUTRIENTS.md DATA_CONTRACTS.SearchManifest.\n    88→    \"\"\"\n    89→\n    90→    model_config = ConfigDict(from_attributes=True)\n    91→\n    92→    target_titles: list[str] = Field(default_factory=list)\n    93→    keywords: list[str] = Field(default_factory=list)\n    94→    excluded_titles: list[str] = Field(default_factory=list)\n    95→    excluded_companies: list[str] = Field(default_factory=list)\n    96→    excluded_industries: list[str] = Field(default_factory=list)\n    97→    location_filters: list[str] = Field(default_factory=list)\n    98→    remote_preference: str = \"flexible\"\n    99→    min_compensation: Optional[int] = None\n   100→\n   101→\n   102→# ─── Discovered Job ───────────────────────────────────────────────────────────\n   103→\n   104→\n   105→class DiscoveredJobSchema(BaseModel):\n   106→    \"\"\"\n   107→    Raw job data from a crawl — before scoring.\n   108→\n   109→    Matches NUTRIENTS.md DATA_CONTRACTS.DiscoveredJob.\n   110→    \"\"\"\n   111→\n   112→    model_config = ConfigDict(from_attributes=True)\n   113→\n   114→    id: Optional[UUID] = None\n   115→    source: str\n   116→    source_id: str\n   117→    title: str\n   118→    company: str\n   119→    location: Optional[str] = None\n   120→    description: Optional[str] = None\n   121→    url: str\n   122→    posted_at: Optional[datetime] = None\n   123→    salary_min: Optional[int] = None\n   124→    salary_max: Optional[int] = None\n   125→    remote: bool = False\n   126→    crawled_at: Optional[datetime] = None\n   127→\n   128→\n   129→# ─── Score Breakdown ─────────────────────────────────────────────────────────\n   130→\n   131→\n   132→class ScoreBreakdown(BaseModel):\n   133→    \"\"\"\n   134→    Dimension-level score breakdown (0-100 per dimension).\n   135→\n   136→    Matches NUTRIENTS.md DATA_CONTRACTS.ScoreBreakdown.\n   137→    \"\"\"\n   138→\n   139→    model_config = ConfigDict(from_attributes=True)\n   140→\n   141→    technical_match: int = Field(ge=0, le=100)\n   142→    level_match: int = Field(ge=0, le=100)\n   143→    culture_match: int = Field(ge=0, le=100)\n   144→    industry_match: int = Field(ge=0, le=100)\n   145→    growth_potential: int = Field(ge=0, le=100)\n   146→    compensation_match: int = Field(ge=0, le=100)\n   147→\n   148→    @computed_field\n   149→    @property\n   150→    def composite(self) -> int:\n   151→        \"\"\"\n   152→        Weighted composite score.\n   153→\n   154→        Weights (sum to 100%):\n   155→          - technical_match: 30%\n   156→          - level_match: 20%\n   157→          - culture_match: 15%\n   158→          - industry_match: 15%\n   159→          - growth_potential: 10%\n   160→          - compensation_match: 10%\n   161→        \"\"\"\n   162→        return int(\n   163→            self.technical_match * 0.30\n   164→            + self.level_match * 0.20\n   165→            + self.culture_match * 0.15\n   166→            + self.industry_match * 0.15\n   167→            + self.growth_potential * 0.10\n   168→            + self.compensation_match * 0.10\n   169→        )\n   170→\n   171→\n   172→# ─── Scored Job ───────────────────────────────────────────────────────────────\n   173→\n   174→\n   175→class ScoredJobSchema(BaseModel):\n   176→    \"\"\"\n   177→    A discovered job with full scoring breakdown and reasoning.\n   178→\n   179→    Matches NUTRIENTS.md DATA_CONTRACTS.ScoredJob.\n   180→    \"\"\"\n   181→\n   182→    model_config = ConfigDict(from_attributes=True)\n   183→\n   184→    id: Optional[UUID] = None\n   185→    discovered_job_id: UUID\n   186→    candidate_id: UUID\n   187→    score_breakdown: ScoreBreakdown\n   188→    composite_score: int = Field(ge=0, le=100)\n   189→    is_hot: bool = False\n   190→    reasoning: str\n   191→    scored_at: Optional[datetime] = None\n   192→\n   193→    # Denormalized job fields for digest display\n   194→    title: str = \"\"\n   195→    company: str = \"\"\n   196→    location: Optional[str] = None\n   197→    url: str = \"\"\n   198→\n   199→\n   200→# ─── Daily Digest ─────────────────────────────────────────────────────────────\n   201→\n   202→\n   203→class DailyDigestSchema(BaseModel):\n   204→    \"\"\"\n   205→    Full daily digest — persisted to DB and published to Redis.\n   206→\n   207→    Matches NUTRIENTS.md DATA_CONTRACTS.DailyDigest.\n   208→    \"\"\"\n   209→\n   210→    model_config = ConfigDict(from_attributes=True)\n   211→\n   212→    id: Optional[UUID] = None\n   213→    candidate_id: UUID\n   214→    run_date: str = Field(description=\"ISO date: YYYY-MM-DD\")\n   215→    top_picks: list[ScoredJobSchema] = Field(default_factory=list)\n   216→    hot_picks: list[ScoredJobSchema] = Field(default_factory=list)\n   217→    new_companies: list[str] = Field(default_factory=list)\n   218→    total_jobs_discovered: int = 0\n   219→    total_jobs_scored: int = 0\n   220→    created_at: Optional[datetime] = None\n   221→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"78b056f7-705e-4dcd-b620-10cb1067f6bf","uuid":"f9f0efe9-e8ca-4875-8c6f-35e8c7d9b027","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/discovery/schemas.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nPydantic v2 schemas for the Discovery Engine.\n\nThese are the data contracts between agents — separate from ORM models.\nAligns with NUTRIENTS.md DATA_CONTRACTS.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import datetime\nfrom typing import Optional, Union\nfrom uuid import UUID\n\nfrom pydantic import BaseModel, Field, ConfigDict, computed_field\n\n\n# ─── Candidate ────────────────────────────────────────────────────────────────\n\n\nclass CandidateSchema(BaseModel):\n    \"\"\"Full candidate profile used as input to the Discovery Engine.\"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: UUID\n    name: str\n    email: str\n    resume_text: str\n    linkedin_url: Optional[str] = None\n    github_url: Optional[str] = None\n    personal_context: Optional[str] = None\n    target_locations: list[str] = Field(default_factory=list)\n    remote_preference: str = \"flexible\"\n    min_compensation: Optional[int] = None\n    excluded_companies: list[str] = Field(default_factory=list)\n    excluded_industries: list[str] = Field(default_factory=list)\n    created_at: Optional[datetime] = None\n    updated_at: Optional[datetime] = None\n\n\n# ─── Identity Profile ─────────────────────────────────────────────────────────\n\n\nclass IdentityProfileSchema(BaseModel):\n    \"\"\"\n    Multi-dimensional identity model for a candidate.\n\n    Generated by IdentityProfiler — the foundation of the entire discovery run.\n    Cached in Redis for 24h.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.IdentityProfile.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    archetypes: list[str] = Field(default_factory=list)\n    archetype_tags: list[str] = Field(default_factory=list)  # Alias for agents\n    leadership_level: str = Field(\n        default=\"IC\",\n        description=\"IC | Lead | Manager | Director | VP | C-Level\",\n    )\n    technical_skills: Union[dict[str, int], list[str]] = Field(default_factory=dict)\n    soft_skills: list[str] = Field(default_factory=list)\n    domain_expertise: list[str] = Field(default_factory=list)\n    industry_experience: list[str] = Field(default_factory=list)\n    notable_achievements: list[str] = Field(default_factory=list)\n    career_trajectory: str = \"\"\n    ideal_role_description: str = \"\"\n    creative_layer: list[str] = Field(default_factory=list)\n    signals: dict[str, str] = Field(default_factory=dict)\n\n\n# Alias for backward compatibility\nIdentityProfile = IdentityProfileSchema\n\n\n# ─── Search Manifest ─────────────────────────────────────────────────────────\n\n\nclass SearchManifestSchema(BaseModel):\n    \"\"\"\n    Search instructions derived from an IdentityProfile.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.SearchManifest.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    target_titles: list[str] = Field(default_factory=list)\n    keywords: list[str] = Field(default_factory=list)\n    excluded_titles: list[str] = Field(default_factory=list)\n    excluded_companies: list[str] = Field(default_factory=list)\n    excluded_industries: list[str] = Field(default_factory=list)\n    location_filters: list[str] = Field(default_factory=list)\n    remote_preference: str = \"flexible\"\n    min_compensation: Optional[int] = None\n\n\n# ─── Discovered Job ───────────────────────────────────────────────────────────\n\n\nclass DiscoveredJobSchema(BaseModel):\n    \"\"\"\n    Raw job data from a crawl — before scoring.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.DiscoveredJob.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    source: str\n    source_id: str\n    title: str\n    company: str\n    location: Optional[str] = None\n    description: Optional[str] = None\n    url: str\n    posted_at: Optional[datetime] = None\n    salary_min: Optional[int] = None\n    salary_max: Optional[int] = None\n    remote: bool = False\n    crawled_at: Optional[datetime] = None\n\n\n# ─── Score Breakdown ─────────────────────────────────────────────────────────\n\n\nclass ScoreBreakdown(BaseModel):\n    \"\"\"\n    Dimension-level score breakdown (0-100 per dimension).\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.ScoreBreakdown.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    technical_match: int = Field(ge=0, le=100)\n    level_match: int = Field(ge=0, le=100)\n    culture_match: int = Field(ge=0, le=100)\n    industry_match: int = Field(ge=0, le=100)\n    growth_potential: int = Field(ge=0, le=100)\n    compensation_match: int = Field(ge=0, le=100)\n\n    @computed_field\n    @property\n    def composite(self) -> int:\n        \"\"\"\n        Weighted composite score.\n\n        Weights (sum to 100%):\n          - technical_match: 30%\n          - level_match: 20%\n          - culture_match: 15%\n          - industry_match: 15%\n          - growth_potential: 10%\n          - compensation_match: 10%\n        \"\"\"\n        return int(\n            self.technical_match * 0.30\n            + self.level_match * 0.20\n            + self.culture_match * 0.15\n            + self.industry_match * 0.15\n            + self.growth_potential * 0.10\n            + self.compensation_match * 0.10\n        )\n\n\n# ─── Scored Job ───────────────────────────────────────────────────────────────\n\n\nclass ScoredJobSchema(BaseModel):\n    \"\"\"\n    A discovered job with full scoring breakdown and reasoning.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.ScoredJob.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    discovered_job_id: UUID\n    candidate_id: UUID\n    score_breakdown: ScoreBreakdown\n    composite_score: int = Field(ge=0, le=100)\n    is_hot: bool = False\n    reasoning: str\n    scored_at: Optional[datetime] = None\n\n    # Denormalized job fields for digest display\n    title: str = \"\"\n    company: str = \"\"\n    location: Optional[str] = None\n    url: str = \"\"\n\n\n# ─── Daily Digest ─────────────────────────────────────────────────────────────\n\n\nclass DailyDigestSchema(BaseModel):\n    \"\"\"\n    Full daily digest — persisted to DB and published to Redis.\n\n    Matches NUTRIENTS.md DATA_CONTRACTS.DailyDigest.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    candidate_id: UUID\n    run_date: str = Field(description=\"ISO date: YYYY-MM-DD\")\n    top_picks: list[ScoredJobSchema] = Field(default_factory=list)\n    hot_picks: list[ScoredJobSchema] = Field(default_factory=list)\n    new_companies: list[str] = Field(default_factory=list)\n    total_jobs_discovered: int = 0\n    total_jobs_scored: int = 0\n    created_at: Optional[datetime] = None\n","numLines":221,"startLine":1,"totalLines":221}}}}
