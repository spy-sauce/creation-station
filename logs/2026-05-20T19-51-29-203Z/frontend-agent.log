isplay: 'block' }}>Why this matches</span>\n   111→                    {item.highlights.map((h, i) => (\n   112→                      <div key={i} style={{ display: 'flex', gap: 8, marginBottom: 6, color: 'var(--muted)', fontSize: 14 }}>\n   113→                        <Check style={{ width: 14, height: 14, color: 'var(--emerald)', flexShrink: 0, marginTop: 3 }} />{h}\n   114→                      </div>\n   115→                    ))}\n   116→                  </div>\n   117→\n   118→                  {item.concerns.length > 0 && (\n   119→                    <div style={{ marginBottom: 20 }}>\n   120→                      <span className=\"t-label\" style={{ color: 'var(--amber)', marginBottom: 10, display: 'block' }}>Concerns</span>\n   121→                      {item.concerns.map((c, i) => (\n   122→                        <div key={i} style={{ display: 'flex', gap: 8, color: 'var(--muted)', fontSize: 14 }}>\n   123→                          <span style={{ color: 'var(--amber)', flexShrink: 0, width: 14, textAlign: 'center' }}>!</span>{c}\n   124→                        </div>\n   125→                      ))}\n   126→                    </div>\n   127→                  )}\n   128→\n   129→                  <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', paddingTop: 16, borderTop: '1px solid var(--border)' }}>\n   130→                    <div style={{ display: 'flex', gap: 20 }}>\n   131→                      <span className=\"t-label\">Source: {item.source}</span>\n   132→                      <span className=\"t-label\">Found {item.discovered}</span>\n   133→                    </div>\n   134→                    <div style={{ display: 'flex', gap: 10 }}>\n   135→                      <a href=\"#\" className=\"btn-ghost\" style={{ padding: '10px 16px', fontSize: 10, display: 'flex', alignItems: 'center', gap: 6 }}>\n   136→                        <ExternalLink style={{ width: 12, height: 12 }} /> View\n   137→              