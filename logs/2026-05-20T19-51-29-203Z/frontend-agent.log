{"t":"2026-05-20T19:59:17.083Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Mvb8iJz2wR6kWgjgDqJHYX","type":"tool_result","content":"     1→import { NavLink } from 'react-router-dom'\n     2→import { LayoutDashboard, Users, GitPullRequestArrow, ClipboardCheck, BarChart3, Settings, Zap } from 'lucide-react'\n     3→\n     4→const nav = [\n     5→  { to: '/dashboard', icon: LayoutDashboard, label: 'Overview', end: true },\n     6→  { to: '/dashboard/candidates', icon: Users, label: 'Candidates' },\n     7→  { to: '/dashboard/pipeline', icon: GitPullRequestArrow, label: 'Pipeline' },\n     8→  { to: '/dashboard/review', icon: ClipboardCheck, label: 'Review Queue' },\n     9→  { to: '/dashboard/analytics', icon: BarChart3, label: 'Analytics' },\n    10→]\n    11→\n    12→export default function Sidebar() {\n    13→  return (\n    14→    <aside className=\"sidebar\">\n    15→      <div className=\"sidebar-brand\">\n    16→        <a href=\"/dashboard\" className=\"t-label-gold\" style={{ textDecoration: 'none' }}>Talent Agent</a>\n    17→      </div>\n    18→\n    19→      <nav className=\"sidebar-nav\">\n    20→        {nav.map((item) => (\n    21→          <NavLink key={item.to} to={item.to} end={item.end} className={({ isActive }) => `sidebar-link${isActive ? ' active' : ''}`}>\n    22→            <item.icon />\n    23→            {item.label}\n    24→          </NavLink>\n    25→        ))}\n    26→      </nav>\n    27→\n    28→      <div className=\"sidebar-footer\">\n    29→        <NavLink to=\"/dashboard/settings\" className={({ isActive }) => `sidebar-link${isActive ? ' active' : ''}`}>\n    30→          <Settings />\n    31→          Settings\n    32→        </NavLink>\n    33→        <div style={{ margin: '16px 16px 0', padding: '14px 16px', background: 'var(--surface)', border: '1px solid var(--border)' }}>\n    34→          <div style={{ display: 'flex', alignItems: 'center', gap: 8, marginBottom: 4 }}>\n    35→            <Zap style={{ width: 12, height: 12, color: 'var(--gold)' }} />\n    36→            <span className=\"t-label-gold\">Agent Status</span>\n    37→          </div>\n    38→          <p style={{ fontFamily: 'var(--mono)', fontSize: 11, color: 'var(--muted)' }}>System ready</p>\n    39→        </div>\n    40→      </div>\n    41→    </aside>\n    42→  )\n    43→}\n    44→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"4a9e8a7b-c074-497d-a64e-220d47ef23aa","uuid":"49995bd1-8c7b-4fee-a37e-6df8c17964b4","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/frontend/src/components/Sidebar.jsx","content":"import { NavLink } from 'react-router-dom'\nimport { LayoutDashboard, Users, GitPullRequestArrow, ClipboardCheck, BarChart3, Settings, Zap } from 'lucide-react'\n\nconst nav = [\n  { to: '/dashboard', icon: LayoutDashboard, label: 'Overview', end: true },\n  { to: '/dashboard/candidates', icon: Users, label: 'Candidates' },\n  { to: '/dashboard/pipeline', icon: GitPullRequestArrow, label: 'Pipeline' },\n  { to: '/dashboard/review', icon: ClipboardCheck, label: 'Review Queue' },\n  { to: '/dashboard/analytics', icon: BarChart3, label: 'Analytics' },\n]\n\nexport default function Sidebar() {\n  return (\n    <aside className=\"sidebar\">\n      <div className=\"sidebar-brand\">\n        <a href=\"/dashboard\" className=\"t-label-gold\" style={{ textDecoration: 'none' }}>Talent Agent</a>\n      </div>\n\n      <nav className=\"sidebar-nav\">\n        {nav.map((item) => (\n          <NavLink key={item.to} to={item.to} end={item.end} className={({ isActive }) => `sidebar-link${isActive ? ' active' : ''}`}>\n            <item.icon />\n            {item.label}\n          </NavLink>\n        ))}\n      </nav>\n\n      <div className=\"sidebar-footer\">\n        <NavLink to=\"/dashboard/settings\" className={({ isActive }) => `sidebar-link${isActive ? ' active' : ''}`}>\n          <Settings />\n          Settings\n        </NavLink>\n        <div style={{ margin: '16px 16px 0', padding: '14px 16px', background: 'var(--surface)', border: '1px solid var(--border)' }}>\n          <div style={{ display: 'flex', alignItems: 'center', gap: 8, marginBottom: 4 }}>\n            <Zap style={{ width: 12, height: 12, color: 'var(--gold)' }} />\n            <span className=\"t-label-gold\">Agent Status</span>\n          </div>\n          <p style={{ fontFamily: 'var(--mono)', fontSize: 11, color: 'var(--muted)' }}>System ready</p>\n        </div>\n      </div>\n    </aside>\n  )\n}\n","numLines":44,"startLine":1,"totalLines":44}}}}
{"t":"2026-05-20T19:59:17.091Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TkJTFHQfqCD8hsA2B6v2QZ","type":"tool_result","content":"     1→import { useState } from 'react'\n     2→import { useLocation, useNavigate } from 'react-router-dom'\n     3→import { Bell, Search, LogOut } from 'lucide-react'\n     4→import { useAuth } from '../context/AuthContext'\n     5→\n     6→const titles = {\n     7→  '/dashboard': 'Overview',\n     8→  '/dashboard/candidates': 'Candidates',\n     9→  '/dashboard/pipeline': 'Pipeline',\n    10→  '/dashboard/review': 'Review Queue',\n    11→  '/dashboard/analytics': 'Analytics',\n    12→  '/dashboard/settings': 'Settings',\n    13→}\n    14→\n    15→export default function TopBar() {\n    16→  const { pathname } = useLocation()\n    17→  const navigate = useNavigate()\n    18→  const { user, logout } = useAuth()\n    19→  const [showMenu, setShowMenu] = useState(false)\n    20→  const title = titles[pathname] || 'Dashboard'\n    21→\n    22→  const initials = user?.name\n    23→    ? user.name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2)\n    24→    : user?.email?.slice(0, 2).toUpperCase() || '??'\n    25→\n    26→  const handleLogout = () => { logout(); navigate('/login') }\n    27→\n    28→  return (\n    29→    <div className=\"topbar\">\n    30→      <h1 className=\"topbar-title\">{title}</h1>\n    31→\n    32→      <div style={{ display: 'flex', alignItems: 'center', gap: 16 }}>\n    33→        {/* Search */}\n    34→        <div style={{ position: 'relative' }} className=\"hidden md:block\">\n    35→          <Search style={{ position: 'absolute', left: 12, top: '50%', transform: 'translateY(-50%)', width: 14, height: 14, color: 'var(--muted)' }} />\n    36→          <input type=\"text\" placeholder=\"Search...\" className=\"input\" style={{ paddingLeft: 36, paddingTop: 10, paddingBottom: 10, width: 220, fontSize: 13 }} />\n    37→        </div>\n    38→\n    39→        {/* Notifications */}\n    40→        <button style={{ position: 'relative', background: 'none', border: 'none', cursor: 'pointer', color: 'var(--muted)', padding: 8 }}>\n    41→          <Bell style={{ width: 16, height: 16, strokeWidth: 1.5 }} />\n    42→          <span style={{ position: 'absolute', top: 6, right: 6, width: 6, height: 6, borderRadius: '50%', background: 'var(--gold)' }} />\n    43→        </button>\n    44→\n    45→        {/* Avatar + dropdown */}\n    46→        <div style={{ position: 'relative' }}>\n    47→          <button className=\"topbar-avatar\" onClick={() => setShowMenu(!showMenu)}>\n    48→            {initials}\n    49→          </button>\n    50→\n    51→          {showMenu && (\n    52→            <>\n    53→              <div style={{ position: 'fixed', inset: 0, zIndex: 40 }} onClick={() => setShowMenu(false)} />\n    54→              <div className=\"dropdown\">\n    55→                <div style={{ padding: '12px 16px', borderBottom: '1px solid var(--border)' }}>\n    56→                  <p style={{ color: 'var(--white)', fontSize: 13, fontWeight: 400 }}>{user?.name || 'User'}</p>\n    57→                  <p style={{ fontFamily: 'var(--mono)', fontSize: 11, color: 'var(--muted)' }}>{user?.email}</p>\n    58→                </div>\n    59→                <button className=\"dropdown-item\" onClick={handleLogout}>\n    60→                  <LogOut style={{ width: 14, height: 14, strokeWidth: 1.5 }} />\n    61→                  Log out\n    62→                </button>\n    63→              </div>\n    64→            </>\n    65→          )}\n    66→        </div>\n    67→      </div>\n    68→    </div>\n    69→  )\n    70→}\n    71→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"4a9e8a7b-c074-497d-a64e-220d47ef23aa","uuid":"71de2079-dc89-4827-a28f-d4aedf14016c","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/frontend/src/components/TopBar.jsx","content":"import { useState } from 'react'\nimport { useLocation, useNavigate } from 'react-router-dom'\nimport { Bell, Search, LogOut } from 'lucide-react'\nimport { useAuth } from '../context/AuthContext'\n\nconst titles = {\n  '/dashboard': 'Overview',\n  '/dashboard/candidates': 'Candidates',\n  '/dashboard/pipeline': 'Pipeline',\n  '/dashboard/review': 'Review Queue',\n  '/dashboard/analytics': 'Analytics',\n  '/dashboard/settings': 'Settings',\n}\n\nexport default function TopBar() {\n  const { pathname } = useLocation()\n  const navigate = useNavigate()\n  const { user, logout } = useAuth()\n  const [showMenu, setShowMenu] = useState(false)\n  const title = titles[pathname] || 'Dashboard'\n\n  const initials = user?.name\n    ? user.name.split(' ').map((n) => n[0]).join('').toUpperCase().slice(0, 2)\n    : user?.email?.slice(0, 2).toUpperCase() || '??'\n\n  const handleLogout = () => { logout(); navigate('/login') }\n\n  return (\n    <div className=\"topbar\">\n      <h1 className=\"topbar-title\">{title}</h1>\n\n      <div style={{ display: 'flex', alignItems: 'center', gap: 16 }}>\n        {/* Search */}\n        <div style={{ position: 'relative' }} className=\"hidden md:block\">\n          <Search style={{ position: 'absolute', left: 12, top: '50%', transform: 'translateY(-50%)', width: 14, height: 14, color: 'var(--muted)' }} />\n          <input type=\"text\" placeholder=\"Search...\" className=\"input\" style={{ paddingLeft: 36, paddingTop: 10, paddingBottom: 10, width: 220, fontSize: 13 }} />\n        </div>\n\n        {/* Notifications */}\n        <button style={{ position: 'relative', background: 'none', border: 'none', cursor: 'pointer', color: 'var(--muted)', padding: 8 }}>\n          <Bell style={{ width: 16, height: 16, strokeWidth: 1.5 }} />\n          <span style={{ position: 'absolute', top: 6, right: 6, width: 6, height: 6, borderRadius: '50%', background: 'var(--gold)' }} />\n        </button>\n\n        {/* Avatar + dropdown */}\n        <div style={{ position: 'relative' }}>\n          <button className=\"topbar-avatar\" onClick={() => setShowMenu(!showMenu)}>\n            {initials}\n          </button>\n\n          {showMenu && (\n            <>\n              <div style={{ position: 'fixed', inset: 0, zIndex: 40 }} onClick={() => setShowMenu(false)} />\n              <div className=\"dropdown\">\n                <div style={{ padding: '12px 16px', borderBottom: '1px solid var(--border)' }}>\n                  <p style={{ color: 'var(--white)', fontSize: 13, fontWeight: 400 }}>{user?.name || 'User'}</p>\n                  <p style={{ fontFamily: 'var(--mono)', fontSize: 11, color: 'var(--muted)' }}>{user?.email}</p>\n                </div>\n                <button className=\"dropdown-item\" onClick={handleLogout}>\n                  <LogOut style={{ width: 14, height: 14, strokeWidth: 1.5 }} />\n                  Log out\n                </button>\n              </div>\n            </>\n          )}\n        </div>\n      </div>\n    </div>\n  )\n}\n","numLines":71,"startLine":1,"totalLines":71}}}}
{"t":"2026-05-20T19:59:17.098Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BCjhC3wcQveG7dp3BYPRmR","type":"tool_result","content":"     1→/**\n     2→ * StatusBadge — Canonical status-to-color mapping\n     3→ *\n     4→ * This is the ONLY place status colors are mapped. Per HYPHA-DESIGN-CORE.md,\n     5→ * no other component duplicates this logic. All status display flows through\n     6→ * this component.\n     7→ *\n     8→ * Status colors use CSS custom properties from index.css:\n     9→ * - --status-success: Completed, approved, active, placed\n    10→ * - --status-warning: Reviewing, interviewing, in-progress\n    11→ * - --status-error: Failed, rejected, errors\n    12→ * - --status-info: Discovered, new, informational\n    13→ * - --status-pending: Queued, waiting\n    14→ * - --status-hot: Hot picks, urgent opportunities\n    15→ * - --gold: Applied, sent (brand accent for positive actions)\n    16→ */\n    17→\n    18→/**\n    19→ * Canonical status-to-color map\n    20→ * Maps status strings to CSS custom property values\n    21→ */\n    22→const statusColors = {\n    23→  // Success states (green)\n    24→  active: 'var(--status-success)',\n    25→  approved: 'var(--status-success)',\n    26→  completed: 'var(--status-success)',\n    27→  placed: 'var(--status-success)',\n    28→  running: 'var(--status-success)',\n    29→  tracked: 'var(--status-success)',\n    30→\n    31→  // Warning states (yellow)\n    32→  reviewing: 'var(--status-warning)',\n    33→  interviewing: 'var(--status-warning)',\n    34→  parsing: 'var(--status-warning)',\n    35→  tailoring: 'var(--status-warning)',\n    36→  researching: 'var(--status-warning)',\n    37→  composing: 'var(--status-warning)',\n    38→  retrying: 'var(--status-warning)',\n    39→\n    40→  // Error states (red)\n    41→  failed: 'var(--status-error)',\n    42→  rejected: 'var(--status-error)',\n    43→  dead: 'var(--status-error)',\n    44→  bounced: 'var(--status-error)',\n    45→\n    46→  // Info states (blue)\n    47→  discovered: 'var(--status-info)',\n    48→  new: 'var(--status-info)',\n    49→  dispatched: 'var(--status-info)',\n    50→\n    51→  // Pending states (purple)\n    52→  queued: 'var(--status-pending)',\n    53→  paused: 'var(--status-pending)',\n    54→  awaiting_review: 'var(--status-pending)',\n    55→  draft: 'var(--status-pending)',\n    56→\n    57→  // Hot states (orange)\n    58→  hot: 'var(--status-hot)',\n    59→  requires_manual: 'var(--status-hot)',\n    60→\n    61→  // Brand accent states (gold)\n    62→  applied: 'var(--gold)',\n    63→  sent: 'var(--gold)',\n    64→  submitted: 'var(--gold)',\n    65→  replied: 'var(--gold)',\n    66→\n    67→  // Muted states (text-muted)\n    68→  idle: 'var(--text-muted)',\n    69→}\n    70→\n    71→/**\n    72→ * StatusBadge component\n    73→ *\n    74→ * @param {Object} props\n    75→ * @param {string} props.status - The status string to display (case-insensitive)\n    76→ * @returns {JSX.Element}\n    77→ */\n    78→export default function StatusBadge({ status }) {\n    79→  // Normalize status to lowercase for consistent lookup\n    80→  const normalizedStatus = status?.toLowerCase().replace(/-/g, '_')\n    81→  const color = statusColors[normalizedStatus] || 'var(--text-muted)'\n    82→\n    83→  // Display the original status (preserving case) or normalized version\n    84→  const displayStatus = status?.replace(/_/g, ' ') || 'unknown'\n    85→\n    86→  return (\n    87→    <span className=\"status-badge\" style={{ color, borderColor: color }}>\n    88→      <span className=\"dot\" />\n    89→      {displayStatus}\n    90→    </span>\n    91→  )\n    92→}\n    93→\n    94→/**\n    95→ * Export the status colors map for edge cases where components\n    96→ * need to access the color directly (e.g., custom charts)\n    97→ */\n    98→export { statusColors }\n    99→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"4a9e8a7b-c074-497d-a64e-220d47ef23aa","uuid":"433a53a2-725c-4f36-b08b-658c525ecd31","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/frontend/src/components/StatusBadge.jsx","content":"/**\n * StatusBadge — Canonical status-to-color mapping\n *\n * This is the ONLY place status colors are mapped. Per HYPHA-DESIGN-CORE.md,\n * no other component duplicates this logic. All status display flows through\n * this component.\n *\n * Status colors use CSS custom properties from index.css:\n * - --status-success: Completed, approved, active, placed\n * - --status-warning: Reviewing, interviewing, in-progress\n * - --status-error: Failed, rejected, errors\n * - --status-info: Discovered, new, informational\n * - --status-pending: Queued, waiting\n * - --status-hot: Hot picks, urgent opportunities\n * - --gold: Applied, sent (brand accent for positive actions)\n */\n\n/**\n * Canonical status-to-color map\n * Maps status strings to CSS custom property values\n */\nconst statusColors = {\n  // Success states (green)\n  active: 'var(--status-success)',\n  approved: 'var(--status-success)',\n  completed: 'var(--status-success)',\n  placed: 'var(--status-success)',\n  running: 'var(--status-success)',\n  tracked: 'var(--status-success)',\n\n  // Warning states (yellow)\n  reviewing: 'var(--status-warning)',\n  interviewing: 'var(--status-warning)',\n  parsing: 'var(--status-warning)',\n  tailoring: 'var(--status-warning)',\n  researching: 'var(--status-warning)',\n  composing: 'var(--status-warning)',\n  retrying: 'var(--status-warning)',\n\n  // Error states (red)\n  failed: 'var(--status-error)',\n  rejected: 'var(--status-error)',\n  dead: 'var(--status-error)',\n  bounced: 'var(--status-error)',\n\n  // Info states (blue)\n  discovered: 'var(--status-info)',\n  new: 'var(--status-info)',\n  dispatched: 'var(--status-info)',\n\n  // Pending states (purple)\n  queued: 'var(--status-pending)',\n  paused: 'var(--status-pending)',\n  awaiting_review: 'var(--status-pending)',\n  draft: 'var(--status-pending)',\n\n  // Hot states (orange)\n  hot: 'var(--status-hot)',\n  requires_manual: 'var(--status-hot)',\n\n  // Brand accent states (gold)\n  applied: 'var(--gold)',\n  sent: 'var(--gold)',\n  submitted: 'var(--gold)',\n  replied: 'var(--gold)',\n\n  // Muted states (text-muted)\n  idle: 'var(--text-muted)',\n}\n\n/**\n * StatusBadge component\n *\n * @param {Object} props\n * @param {string} props.status - The status string to display (case-insensitive)\n * @returns {JSX.Element}\n */\nexport default function StatusBadge({ status }) {\n  // Normalize status to lowercase for consistent lookup\n  const normalizedStatus = status?.toLowerCase().replace(/-/g, '_')\n  const color = statusColors[normalizedStatus] || 'var(--text-muted)'\n\n  // Display the original status (preserving case) or normalized version\n  const displayStatus = status?.replace(/_/g, ' ') || 'unknown'\n\n  return (\n    <span className=\"status-badge\" style={{ color, borderColor: color }}>\n      <span className=\"dot\" />\n      {displayStatus}\n    </span>\n  )\n}\n\n/**\n * Export the status colors map for edge cases where components\n * need to access the color directly (e.g., custom charts)\n */\nexport { statusColors }\n","numLines":99,"startLine":1,"totalLines":99}}}}
{"t":"2026-05-20T19:59:17.105Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Fhhz6eFKHKiD4seoPNaMxU","type":"tool_result","content":"     1→/**\n     2→ * StatCard — Primitive card treatment for metrics display\n     3→ *\n     4→ * Per HYPHA-DESIGN-CORE.md, this encodes the canonical stat card treatment:\n     5→ * - card-hover class for gold top-border animation\n     6→ * - stat-num class for large serif numbers in gold\n     7→ * - stat-label class for monospace labels below\n     8→ * - All colors via CSS custom properties (no hex literals)\n     9→ *\n    10→ * @param {Object} props\n    11→ * @param {string} props.label - The metric label (displayed below the value)\n    12→ * @param {string|number} props.value - The metric value (large display)\n    13→ * @param {number} [props.change] - Optional percentage change (+/- indicator)\n    14→ * @param {React.ComponentType} props.icon - Lucide icon component\n    15→ */\n    16→export default function StatCard({ label, value, change, icon: Icon }) {\n    17→  return (\n    18→    <div className=\"card-hover\" style={{ padding: '28px 24px' }}>\n    19→      <div style={{\n    20→        display: 'flex',\n    21→        alignItems: 'center',\n    22→        justifyContent: 'space-between',\n    23→        marginBottom: 16\n    24→      }}>\n    25→        <Icon style={{\n    26→          width: 18,\n    27→          height: 18,\n    28→          color: 'var(--gold)',\n    29→          strokeWidth: 1.5\n    30→        }} />\n    31→        {change !== 0 && change !== undefined && (\n    32→          <span style={{\n    33→            fontFamily: 'var(--font-mono)',\n    34→            fontSize: 11,\n    35→            color: change > 0 ? 'var(--status-success)' : 'var(--status-error)'\n    36→          }}>\n    37→            {change > 0 ? '+' : ''}{change}%\n    38→          </span>\n    39→        )}\n    40→      </div>\n    41→      <div className=\"stat-num\" style={{ fontSize: 32 }}>{value}</div>\n    42→      <div className=\"stat-label\">{label}</div>\n    43→    </div>\n    44→  )\n    45→}\n    46→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"4a9e8a7b-c074-497d-a64e-220d47ef23aa","uuid":"3d6212df-8b32-4260-8900-2b52c05066b0","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/frontend/src/components/StatCard.jsx","content":"/**\n * StatCard — Primitive card treatment for metrics display\n *\n * Per HYPHA-DESIGN-CORE.md, this encodes the canonical stat card treatment:\n * - card-hover class for gold top-border animation\n * - stat-num class for large serif numbers in gold\n * - stat-label class for monospace labels below\n * - All colors via CSS custom properties (no hex literals)\n *\n * @param {Object} props\n * @param {string} props.label - The metric label (displayed below the value)\n * @param {string|number} props.value - The metric value (large display)\n * @param {number} [props.change] - Optional percentage change (+/- indicator)\n * @param {React.ComponentType} props.icon - Lucide icon component\n */\nexport default function StatCard({ label, value, change, icon: Icon }) {\n  return (\n    <div className=\"card-hover\" style={{ padding: '28px 24px' }}>\n      <div style={{\n        display: 'flex',\n        alignItems: 'center',\n        justifyContent: 'space-between',\n        marginBottom: 16\n      }}>\n        <Icon style={{\n          width: 18,\n          height: 18,\n          color: 'var(--gold)',\n          strokeWidth: 1.5\n        }} />\n        {change !== 0 && change !== undefined && (\n          <span style={{\n            fontFamily: 'var(--font-mono)',\n            fontSize: 11,\n            color: change > 0 ? 'var(--status-success)' : 'var(--status-error)'\n          }}>\n            {change > 0 ? '+' : ''}{change}%\n          </span>\n        )}\n      </div>\n      <div className=\"stat-num\" style={{ fontSize: 32 }}>{value}</div>\n      <div className=\"stat-label\">{label}</div>\n    </div>\n  )\n}\n","numLines":46,"startLine":1,"totalLines":46}}}}
