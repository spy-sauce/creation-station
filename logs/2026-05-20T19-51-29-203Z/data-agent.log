","-            + self.compensation_match * 0.10","-        )"," ","+# ─── Scored Job ───────────────────────────────────────────────────────────────"," ","+"," class ScoredJobSchema(BaseModel):","     \"\"\"A discovered job with full scoring breakdown and reasoning.\"\"\""," ","-    job: DiscoveredJobSchema","-    scores: ScoreBreakdown","+    model_config = ConfigDict(from_attributes=True)","+","+    id: Optional[UUID] = None","+    discovered_job_id: UUID","+    candidate_id: UUID","+    score_breakdown: ScoreBreakdown","     composite_score: int = Field(ge=0, le=100)","-    reasoning: str = Field(description=\"2-sentence human-readable reasoning for the score\")","     is_hot: bool = False","+    reasoning: str","+    scored_at: Optional[datetime] = None"," ","-    model_config = {\"from_attributes\": True}"," ","-"," # ─── Daily Digest ─────────────────────────────────────────────────────────────"," ","-class DigestJobPreview(BaseModel):","-    \"\"\"Lightweight job preview for the digest list.\"\"\""," ","-    job_id: UUID","-    title: str","-    company: str","-    location: Optional[str]","-    url: str","-    composite_score: int","-    is_hot: bool","-    reasoning: str","-","-"," class DailyDigestSchema(BaseModel):","     \"\"\"Full daily digest — persisted to DB and published to Redis.\"\"\""," ","+    model_config = ConfigDict(from_attributes=True)","+","+    id: Optional[UUID] = None","     candidate_id: UUID","     run_date: str = Field(description=\"ISO date: YYYY-MM-DD\")","-    total_discovered: int","-    total_scored: int","-    top_picks: list[DigestJobPreview]","-    hot_picks: list[DigestJobPreview]","-    new_companies: list[str]","-    digest_summary: str = Field(description=\"Claude-generated 3-sentence narrative\")","+    top_picks: list[ScoredJobSchema] = Field(default_factory=list)","+    hot_picks: list[ScoredJobSchema] = Field(default_factory=list)","+    new_companies: list[str] = Field(default_factory=list)","+    total_jobs_discovered: int = 0","+    total_jobs_scored: int = 0","+    created_at: Optional[datetime] = None"]}],"originalFile":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nPydantic v2 schemas for the Discovery Engine.\n\nThese are the data contracts between agents — separate from ORM models.\n\"\"\"\n\nfrom __future__ import annotations\nfrom datetime import datetime\nfrom typing import Optional\nfrom uuid import UUID\nfrom pydantic import BaseModel, Field, EmailStr\n\n\n# ─── Candidate ────────────────────────────────────────────────────────────────\n\nclass CandidateSchema(BaseModel):\n    \"\"\"Full candidate profile used as input to the Discovery Engine.\"\"\"\n\n    id: UUID\n    name: str\n    email: str\n    resume_text: str\n    linkedin_url: Optional[str] = None\n    github_url: Optional[str] = None\n    personal_context: str = \"\"\n    target_locations: list[str] = Field(default_factory=list)\n    remote_preference: str = \"flexible\"\n    min_compensation: Optional[int] = None\n    excluded_companies: list[str] = Field(default_factory=list)\n    excluded_industries: list[str] = Field(default_factory=list)\n\n    model_config = {\"from_attributes\": True}\n\n\n# ─── Identity Profile ─────────────────────────────────────────────────────────\n\nclass IdentityProfile(BaseModel):\n    \"\"\"\n    Multi-dimensional identity model for a candidate.\n\n    Generated by IdentityProfiler — the foundation of the entire discovery run.\n    Cached in Redis for 24h.\n    \"\"\"\n\n    candidate_id: UUID\n    technical_skills: dict[str, int] = Field(\n        description=\"Skill → proficiency score 0–100, weighted by recency\"\n    )\n    domain_expertise: list[str] = Field(\n        description=\"Industries and problem spaces: fintech, web3, ai, music, creator-economy, etc.\"\n    )\n    leadership_level: str = Field(\n        description=\"ic | lead | staff | principal | founder | exec\"\n    )\n    archetype_tags: list[str] = Field(\n        description=\"Human-readable identity descriptors: technical-founder, ai-builder, creative-technologist\"\n    )\n    role_expansion: list[str] = Field(\n        description=\"15–20 non-obvious role archetypes this candidate should target\"\n    )\n    culture_signals: dict[str, str] = Field(\n        description=\"Preferences: startup_vs_enterprise, remote_preference, mission_vs_comp\"\n    )\n    compensation_band: dict[str, int] = Field(\n        description=\"min/max estimated target comp in USD\"\n    )\n    creative_layer: list[str] = Field(\n        default_factory=list,\n        description=\"Non-technical identity: music, art, entrepreneurship — used for culture matching\"\n    )\n    generated_at: datetime = Field(default_factory=datetime.utcnow)\n\n\n# ─── Archetype Manifest ───────────────────────────────────────────────────────\n\nclass TargetCompanyProfile(BaseModel):\n    \"\"\"A profile of the type of company to watch.\"\"\"\n\n    industries: list[str]\n    stages: list[str] = Field(description=\"seed, series-a, series-b, growth, public\")\n    size_range: str = Field(description=\"e.g. '10-200', '200-2000'\")\n    tech_signals: list[str] = Field(description=\"Technologies that signal a good fit\")\n    culture_signals: list[str]\n\n\nclass ArchetypeManifest(BaseModel):\n    \"\"\"\n    Search instructions derived from an IdentityProfile.\n\n    The crawler uses this as its target list.\n    \"\"\"\n\n    candidate_id: UUID\n    target_titles: list[str] = Field(description=\"Specific job titles to search\")\n    title_variants: dict[str, list[str]] = Field(\n        description=\"Archetype → list of title search variants\"\n    )\n    target_company_profile: TargetCompanyProfile\n    target_industries: list[str] = Field(description=\"Industries ranked by fit\")\n    keywords: list[str] = Field(description=\"Search keyword combinations\")\n    exclusions: dict[str, list[str]] = Field(\n        description=\"titles and companies to skip: {titles: [...], companies: [...]}\"\n    )\n    generated_at: datetime = Field(default_factory=datetime.utcnow)\n\n\n# ─── Discovered Job ───────────────────────────────────────────────────────────\n\nclass DiscoveredJobSchema(BaseModel):\n    \"\"\"Raw job data from a crawl — before scoring.\"\"\"\n\n    id: Optional[UUID] = None\n    candidate_id: UUID\n    title: str\n    company: str\n    location: Optional[str] = None\n    url: str\n    url_hash: str\n    description: Optional[str] = None\n    source: Optional[str] = None\n    posted_date: Optional[datetime] = None\n    status: str = \"DISCOVERED\"\n\n    model_config = {\"from_attributes\": True}\n\n\n# ─── Scored Job ───────────────────────────────────────────────────────────────\n\nclass ScoreBreakdown(BaseModel):\n    \"\"\"Dimension-level score breakdown.\"\"\"\n\n    technical_match: int = Field(ge=0, le=100)\n    level_match: int = Field(ge=0, le=100)\n    culture_match: int = Field(ge=0, le=100)\n    industry_match: int = Field(ge=0, le=100)\n    growth_potential: int = Field(ge=0, le=100)\n    compensation_match: int = Field(ge=0, le=100)\n\n    @property\n    def composite(self) -> int:\n        \"\"\"Weighted composite score.\"\"\"\n        return int(\n            self.technical_match * 0.30\n            + self.level_match * 0.20\n            + self.culture_match * 0.15\n            + self.industry_match * 0.15\n            + self.growth_potential * 0.10\n            + self.compensation_match * 0.10\n        )\n\n\nclass ScoredJobSchema(BaseModel):\n    \"\"\"A discovered job with full scoring breakdown and reasoning.\"\"\"\n\n    job: DiscoveredJobSchema\n    scores: ScoreBreakdown\n    composite_score: int = Field(ge=0, le=100)\n    reasoning: str = Field(description=\"2-sentence human-readable reasoning for the score\")\n    is_hot: bool = False\n\n    model_config = {\"from_attributes\": True}\n\n\n# ─── Daily Digest ─────────────────────────────────────────────────────────────\n\nclass DigestJobPreview(BaseModel):\n    \"\"\"Lightweight job preview for the digest list.\"\"\"\n\n    job_id: UUID\n    title: str\n    company: str\n    location: Optional[str]\n    url: str\n    composite_score: int\n    is_hot: bool\n    reasoning: str\n\n\nclass DailyDigestSchema(BaseModel):\n    \"\"\"Full daily digest — persisted to DB and published to Redis.\"\"\"\n\n    candidate_id: UUID\n    run_date: str = Field(description=\"ISO date: YYYY-MM-DD\")\n    total_discovered: int\n    total_scored: int\n    top_picks: list[DigestJobPreview]\n    hot_picks: list[DigestJobPreview]\n    new_companies: list[str]\n    digest_summary: str = Field(description=\"Claude-generated 3-sentence narrative\")\n"}}}
{"t":"2026-05-20T19:56:45.237Z","event":"sdk_msg","msg":{"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_01JWpN7itopiWeMvt7J3Ly1H","type":"message","role":"assistant","content":[{"type":"text","text":"Now update the application schemas:"}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":3713,"cache_read_input_tokens":101379,"cache_creation":{"ephemeral_5m_input_tokens":3713,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"d3783399-0812-43e2-8211-a8e30972bdd8","uuid":"a7585139-4489-4ac3-945a-9e74b542ace9"}}
{"t":"2026-05-20T19:57:08.498Z","event":"sdk_msg","msg":{"type":"assistant","message":{"model":"claude-opus-4-5-20251101","id":"msg_01JWpN7itopiWeMvt7J3Ly1H","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01QUxSpZEKLp428DRwZJMzga","name":"Write","input":{"file_path":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/application/schemas.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nPydantic v2 schemas for the Application Engine.\n\nThese are the data contracts between application agents — separate from ORM models.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import datetime\nfrom typing import Optional\nfrom uuid import UUID\n\nfrom pydantic import BaseModel, Field, ConfigDict\n\n\n# ─── Parsed JD ────────────────────────────────────────────────────────────────\n\n\nclass ParsedJDSchema(BaseModel):\n    \"\"\"\n    Deep-parsed job description — every signal needed for tailoring the application.\n\n    Generated by JDParser. Cached in PostgreSQL — reused if job is re-processed.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    job_id: UUID\n    required_skills: list[str] = Field(default_factory=list)\n    preferred_skills: list[str] = Field(default_factory=list)\n    seniority_level: str = \"senior\"\n    tech_stack: list[str] = Field(default_factory=list)\n    culture_signals: list[str] = Field(default_factory=list)\n    tone: str = \"professional\"\n    pain_points: list[str] = Field(default_factory=list)\n    compensation_range: Optional[str] = None\n    red_flags: list[str] = Field(default_factory=list)\n    application_instructions: Optional[str] = None\n    parsed_at: Optional[datetime] = None\n\n\n# ─── Tailored Resume ──────────────────────────────────────────────────────────\n\n\nclass TailoredResumeSchema(BaseModel):\n    \"\"\"\n    Rewritten resume tailored for a specific role.\n\n    Never fabricates experience — rewrites framing, ordering, and emphasis.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    pipeline_id: UUID\n    original_text: str\n    tailored_text: str\n    change_log: list[str] = Field(default_factory=list)\n    gap_analysis: Optional[str] = None\n    created_at: Optional[datetime] = None\n\n\n# ─── Company Intel ────────────────────────────────────────────────────────────\n\n\nclass CompanyIntelSchema(BaseModel):\n    \"\"\"\n    Synthesized company research for outreach composition.\n\n    Cached 7 days — don't re-scrape the same company within a week.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    pipeline_id: UUID\n    company_name: str\n    about: Optional[str] = None\n    recent_news: list[str] = Field(default_factory=list)\n    tech_stack: list[str] = Field(default_factory=list)\n    engineering_culture: Optional[str] = None\n    growth_stage: Optional[str] = None\n    team_size: Optional[str] = None\n    notable_facts: list[str] = Field(default_factory=list)\n    researched_at: Optional[datetime] = None\n\n\n# ─── Contact ──────────────────────────────────────────────────────────────────\n\n\nclass ContactSchema(BaseModel):\n    \"\"\"\n    The right person to send the cold outreach to.\n\n    Confidence levels: HIGH = verified email; MEDIUM = pattern-matched; LOW = generic fallback.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    pipeline_id: UUID\n    name: str\n    title: str\n    email: str\n    linkedin_url: Optional[str] = None\n    confidence: str = \"LOW\"  # HIGH | MEDIUM | LOW\n    fallback_email: Optional[str] = None\n    source: Optional[str] = None\n    found_at: Optional[datetime] = None\n\n\n# ─── Outreach Email ───────────────────────────────────────────────────────────\n\n\nclass OutreachEmailSchema(BaseModel):\n    \"\"\"\n    A cold email that doesn't read like a cold email.\n\n    Stays in DRAFT status until approved in the Review Dashboard.\n    Max 150–200 words. Grounded in real company context.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    pipeline_id: UUID\n    subject_lines: list[str] = Field(\n        default_factory=list,\n        description=\"3 subject line variants shown in Review Dashboard\",\n    )\n    body: str = Field(description=\"Email body — 150–200 words max\")\n    status: str = \"DRAFT\"  # DRAFT | SENT | BOUNCED | REPLIED\n    created_at: Optional[datetime] = None\n\n\n# ─── Application Pipeline ─────────────────────────────────────────────────────\n\n\nclass ApplicationPipelineSchema(BaseModel):\n    \"\"\"\n    Full pipeline state for a single approved job application.\n\n    Status flow:\n      QUEUED → PARSING → TAILORING → RESEARCHING → COMPOSING →\n      AWAITING_REVIEW → APPROVED/REJECTED → SUBMITTED → SENT → TRACKED\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    candidate_id: UUID\n    job_id: UUID\n    status: str = \"QUEUED\"\n    parsed_jd: Optional[ParsedJDSchema] = None\n    tailored_resume: Optional[TailoredResumeSchema] = None\n    company_intel: Optional[CompanyIntelSchema] = None\n    contact: Optional[ContactSchema] = None\n    outreach_email: Optional[OutreachEmailSchema] = None\n    approval_timestamp: Optional[datetime] = None\n    submitted_at: Optional[datetime] = None\n    screenshots: list[str] = Field(default_factory=list)\n    created_at: Optional[datetime] = None\n    updated_at: Optional[datetime] = None\n\n\n# ─── CRM Event ────────────────────────────────────────────────────────────────\n\n\nclass CRMEventSchema(BaseModel):\n    \"\"\"An immutable timeline event in the application journey.\"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    pipeline_id: UUID\n    event_type: str = Field(\n        description=\"APPLIED | EMAIL_SENT | EMAIL_OPENED | RESPONDED | INTERVIEW_SCHEDULED | OFFER_RECEIVED | REJECTED | PLACED\"\n    )\n    payload: Optional[dict] = Field(default_factory=dict)\n    created_at: Optional[datetime] = None\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":3713,"cache_read_input_tokens":101379,"cache_creation":{"ephemeral_5m_input_tokens":3713,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"d3783399-0812-43e2-8211-a8e30972bdd8","uuid":"e32daaa4-d113-4287-9941-702731b9b066"}}
