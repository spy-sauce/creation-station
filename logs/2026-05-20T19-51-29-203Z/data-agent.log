ld outreach to.\n    94→\n    95→    Confidence levels: HIGH = verified email; MEDIUM = pattern-matched; LOW = generic fallback.\n    96→    \"\"\"\n    97→\n    98→    name: Optional[str] = None\n    99→    title: Optional[str] = None\n   100→    email: Optional[str] = None\n   101→    linkedin_url: Optional[str] = None\n   102→    confidence: str = \"LOW\"  # HIGH | MEDIUM | LOW\n   103→    source: Optional[str] = None\n   104→    fallback_email: Optional[str] = None\n   105→\n   106→\n   107→# ─── Outreach Email ───────────────────────────────────────────────────────────\n   108→\n   109→class OutreachEmailSchema(BaseModel):\n   110→    \"\"\"\n   111→    A cold email that doesn't read like a cold email.\n   112→\n   113→    Stays in DRAFT status until approved in the Review Dashboard.\n   114→    Max 150–200 words. Grounded in real company context.\n   115→    \"\"\"\n   116→\n   117→    job_id: UUID\n   118→    candidate_id: UUID\n   119→    to: Optional[str] = None\n   120→    subject: str = Field(description=\"Primary subject line\")\n   121→    subject_variants: list[str] = Field(\n   122→        default_factory=list,\n   123→        description=\"3 subject line variants shown in Review Dashboard\"\n   124→    )\n   125→    body: str = Field(description=\"Email body — 150–200 words max\")\n   126→    tone_used: str = \"professional\"\n   127→    hook_used: Optional[str] = Field(\n   128→        description=\"The specific company fact used as opening hook\"\n   129→    )\n   130→    status: str = \"DRAFT\"\n   131→\n   132→\n   133→# ─── Application Result ───────────────────────────────────────────────────────\n   134→\n   135→class ApplicationResultSchema(BaseModel):\n   136→    \"\"\"\n   137→    Outcome of a form submission attempt.\n   138→\n   139→    Never submitted without explicit Review Dashboard approval.\n   140→    \"\"\"\n   141→\n   142→    pipeline_id: UUID\n   143→    job_id: UUID\n   144→    status: str = Field(description=\"SUCCESS | FAILED | REQUIRES_MANUAL\")\n   145→    confirmation_number: Optional[str] = None\n   146→    screenshot_path: Optional[str] = None\n   147→    fields_completed: list[str] = Field(default_factory=list)\n   148→    error: Optional[str] = None\n   149→    fallback_url: Optional[str] = Field(\n   150→        description=\"Direct link for manual submission if auto-apply fails\"\n   151→    )\n   152→\n   153→\n   154→# ─── Application Pipeline ─────────────────────────────────────────────────────\n   155→\n   156→class ApplicationPipelineSchema(BaseModel):\n   157→    \"\"\"\n   158→    Full pipeline state for a single approved job application.\n   159→\n   160→    Status flow:\n   161→      QUEUED → PARSING → TAILORING → RESEARCHING → COMPOSING →\n   162→      AWAITING_REVIEW → APPROVED/REJECTED → SUBMITTED → SENT → TRACKED\n   163→    \"\"\"\n   164→\n   165→    id: Optional[UUID] = None\n   166→    job_id: UUID\n   167→    candidate_id: UUID\n   168→    status: str = \"QUEUED\"\n   169→    current_step: Optional[str] = None\n   170→    parsed_jd: Optional[ParsedJDSchema] = None\n   171→    tailored_resume: Optional[TailoredResumeSchema] = None\n   172→    company_intel: Optional[CompanyIntelSchema] = None\n   173→    contact: Optional[ContactSchema] = None\n   174→    outreach_email: Optional[OutreachEmailSchema] = None\n   175→    result: Optional[ApplicationResultSchema] = None\n   176→\n   177→    model_config = {\"from_attributes\": True}\n   178→\n   179→\n   180→# ─── CRM Event ────────────────────────────────────────────────────────────────\n   181→\n   182→class CRMEventSchema(BaseModel):\n   183→    \"\"\"An immutable timeline event in the application journey.\"\"\"\n   184→\n   185→    pipeline_id: UUID\n   186→    candidate_id: UUID\n   187→    job_id: UUID\n   188→    event_type: str = Field(description=\"APPLIED | EMAIL_SENT | EMAIL_OPENED | RESPONDED | INTERVIEW_SCHEDULED | OFFER_RECEIVED | REJECTED | PLACED\")\n   189→    details: Optional[dict] = None\n   190→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"d3783399-0812-43e2-8211-a8e30972bdd8","uuid":"03c5b2bc-3cb9-4b34-b2c1-3ba2629a9e99","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/application/schemas.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nPydantic v2 schemas for the Application Engine.\n\nThese are the data contracts between application agents — separate from ORM models.\n\"\"\"\n\nfrom __future__ import annotations\nfrom datetime import datetime\nfrom typing import Optional\nfrom uuid import UUID\nfrom pydantic import BaseModel, Field\n\n\n# ─── Parsed JD ────────────────────────────────────────────────────────────────\n\nclass ParsedJDSchema(BaseModel):\n    \"\"\"\n    Deep-parsed job description — every signal needed for tailoring the application.\n\n    Generated by JDParser. Cached in PostgreSQL — reused if job is re-processed.\n    \"\"\"\n\n    job_id: UUID\n    required_skills: list[str] = Field(default_factory=list)\n    preferred_skills: list[str] = Field(default_factory=list)\n    seniority_level: str = \"senior\"\n    team_context: Optional[str] = None\n    key_responsibilities: list[str] = Field(default_factory=list)\n    culture_signals: dict[str, str] = Field(default_factory=dict)\n    tech_stack: list[str] = Field(default_factory=list)\n    pain_points: Optional[str] = None\n    tone: str = \"professional\"\n    comp_mentioned: Optional[str] = None\n    red_flags: list[str] = Field(default_factory=list)\n    application_instructions: Optional[str] = None\n\n    model_config = {\"from_attributes\": True}\n\n\n# ─── Tailored Resume ──────────────────────────────────────────────────────────\n\nclass TailoredResumeSchema(BaseModel):\n    \"\"\"\n    Rewritten resume tailored for a specific role.\n\n    Never fabricates experience — rewrites framing, ordering, and emphasis.\n    \"\"\"\n\n    job_id: UUID\n    candidate_id: UUID\n    summary: str = Field(description=\"Rewritten profile/summary targeting this role\")\n    full_text: str = Field(description=\"Complete resume text ready for PDF generation\")\n    change_log: str = Field(description=\"What changed from base resume and why — shown in Review Dashboard\")\n    pdf_path: Optional[str] = None\n    version: int = 1\n\n    model_config = {\"from_attributes\": True}\n\n\n# ─── Company Intel ────────────────────────────────────────────────────────────\n\nclass CompanyIntelSchema(BaseModel):\n    \"\"\"\n    Synthesized company research for outreach composition.\n\n    Cached 7 days — don't re-scrape the same company within a week.\n    \"\"\"\n\n    company_name: str\n    domain: Optional[str] = None\n    about: Optional[str] = None\n    recent_news: Optional[str] = None\n    tech_stack: list[str] = Field(default_factory=list)\n    engineering_culture: Optional[str] = None\n    glassdoor_signals: Optional[str] = None\n    growth_stage: Optional[str] = None\n    team_size: Optional[str] = None\n    notable_facts: Optional[str] = Field(\n        description=\"The hook — specific and real, used to open the outreach email\"\n    )\n    cache_age: Optional[datetime] = None\n\n    model_config = {\"from_attributes\": True}\n\n\n# ─── Contact ──────────────────────────────────────────────────────────────────\n\nclass ContactSchema(BaseModel):\n    \"\"\"\n    The right person to send the cold outreach to.\n\n    Confidence levels: HIGH = verified email; MEDIUM = pattern-matched; LOW = generic fallback.\n    \"\"\"\n\n    name: Optional[str] = None\n    title: Optional[str] = None\n    email: Optional[str] = None\n    linkedin_url: Optional[str] = None\n    confidence: str = \"LOW\"  # HIGH | MEDIUM | LOW\n    source: Optional[str] = None\n    fallback_email: Optional[str] = None\n\n\n# ─── Outreach Email ───────────────────────────────────────────────────────────\n\nclass OutreachEmailSchema(BaseModel):\n    \"\"\"\n    A cold email that doesn't read like a cold email.\n\n    Stays in DRAFT status until approved in the Review Dashboard.\n    Max 150–200 words. Grounded in real company context.\n    \"\"\"\n\n    job_id: UUID\n    candidate_id: UUID\n    to: Optional[str] = None\n    subject: str = Field(description=\"Primary subject line\")\n    subject_variants: list[str] = Field(\n        default_factory=list,\n        description=\"3 subject line variants shown in Review Dashboard\"\n    )\n    body: str = Field(description=\"Email body — 150–200 words max\")\n    tone_used: str = \"professional\"\n    hook_used: Optional[str] = Field(\n        description=\"The specific company fact used as opening hook\"\n    )\n    status: str = \"DRAFT\"\n\n\n# ─── Application Result ───────────────────────────────────────────────────────\n\nclass ApplicationResultSchema(BaseModel):\n    \"\"\"\n    Outcome of a form submission attempt.\n\n    Never submitted without explicit Review Dashboard approval.\n    \"\"\"\n\n    pipeline_id: UUID\n    job_id: UUID\n    status: str = Field(description=\"SUCCESS | FAILED | REQUIRES_MANUAL\")\n    confirmation_number: Optional[str] = None\n    screenshot_path: Optional[str] = None\n    fields_completed: list[str] = Field(default_factory=list)\n    error: Optional[str] = None\n    fallback_url: Optional[str] = Field(\n        description=\"Direct link for manual submission if auto-apply fails\"\n    )\n\n\n# ─── Application Pipeline ─────────────────────────────────────────────────────\n\nclass ApplicationPipelineSchema(BaseModel):\n    \"\"\"\n    Full pipeline state for a single approved job application.\n\n    Status flow:\n      QUEUED → PARSING → TAILORING → RESEARCHING → COMPOSING →\n      AWAITING_REVIEW → APPROVED/REJECTED → SUBMITTED → SENT → TRACKED\n    \"\"\"\n\n    id: Optional[UUID] = None\n    job_id: UUID\n    candidate_id: UUID\n    status: str = \"QUEUED\"\n    current_step: Optional[str] = None\n    parsed_jd: Optional[ParsedJDSchema] = None\n    tailored_resume: Optional[TailoredResumeSchema] = None\n    company_intel: Optional[CompanyIntelSchema] = None\n    contact: Optional[ContactSchema] = None\n    outreach_email: Optional[OutreachEmailSchema] = None\n    result: Optional[ApplicationResultSchema] = None\n\n    model_config = {\"from_attributes\": True}\n\n\n# ─── CRM Event ────────────────────────────────────────────────────────────────\n\nclass CRMEventSchema(BaseModel):\n    \"\"\"An immutable timeline event in the application journey.\"\"\"\n\n    pipeline_id: UUID\n    candidate_id: UUID\n    job_id: UUID\n    event_type: str = Field(description=\"APPLIED | EMAIL_SENT | EMAIL_OPENED | RESPONDED | INTERVIEW_SCHEDULED | OFFER_RECEIVED | REJECTED | PLACED\")\n    details: Optional[dict] = None\n","numLines":190,"startLine":1,"totalLines":190}}}}
