{"t":"2026-05-20T19:52:18.083Z","event":"sdk_msg","msg":{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TWuYTmi5VLJbWseVZxnBD2","type":"tool_result","content":"     1→# Copyright 2026 VibeSpace LLC\n     2→# Licensed under the Apache License, Version 2.0\n     3→\n     4→\"\"\"\n     5→Pydantic v2 schemas for the Discovery Engine.\n     6→\n     7→These are the data contracts between agents — separate from ORM models.\n     8→\"\"\"\n     9→\n    10→from __future__ import annotations\n    11→from datetime import datetime\n    12→from typing import Optional\n    13→from uuid import UUID\n    14→from pydantic import BaseModel, Field, EmailStr\n    15→\n    16→\n    17→# ─── Candidate ────────────────────────────────────────────────────────────────\n    18→\n    19→class CandidateSchema(BaseModel):\n    20→    \"\"\"Full candidate profile used as input to the Discovery Engine.\"\"\"\n    21→\n    22→    id: UUID\n    23→    name: str\n    24→    email: str\n    25→    resume_text: str\n    26→    linkedin_url: Optional[str] = None\n    27→    github_url: Optional[str] = None\n    28→    personal_context: str = \"\"\n    29→    target_locations: list[str] = Field(default_factory=list)\n    30→    remote_preference: str = \"flexible\"\n    31→    min_compensation: Optional[int] = None\n    32→    excluded_companies: list[str] = Field(default_factory=list)\n    33→    excluded_industries: list[str] = Field(default_factory=list)\n    34→\n    35→    model_config = {\"from_attributes\": True}\n    36→\n    37→\n    38→# ─── Identity Profile ─────────────────────────────────────────────────────────\n    39→\n    40→class IdentityProfile(BaseModel):\n    41→    \"\"\"\n    42→    Multi-dimensional identity model for a candidate.\n    43→\n    44→    Generated by IdentityProfiler — the foundation of the entire discovery run.\n    45→    Cached in Redis for 24h.\n    46→    \"\"\"\n    47→\n    48→    candidate_id: UUID\n    49→    technical_skills: dict[str, int] = Field(\n    50→        description=\"Skill → proficiency score 0–100, weighted by recency\"\n    51→    )\n    52→    domain_expertise: list[str] = Field(\n    53→        description=\"Industries and problem spaces: fintech, web3, ai, music, creator-economy, etc.\"\n    54→    )\n    55→    leadership_level: str = Field(\n    56→        description=\"ic | lead | staff | principal | founder | exec\"\n    57→    )\n    58→    archetype_tags: list[str] = Field(\n    59→        description=\"Human-readable identity descriptors: technical-founder, ai-builder, creative-technologist\"\n    60→    )\n    61→    role_expansion: list[str] = Field(\n    62→        description=\"15–20 non-obvious role archetypes this candidate should target\"\n    63→    )\n    64→    culture_signals: dict[str, str] = Field(\n    65→        description=\"Preferences: startup_vs_enterprise, remote_preference, mission_vs_comp\"\n    66→    )\n    67→    compensation_band: dict[str, int] = Field(\n    68→        description=\"min/max estimated target comp in USD\"\n    69→    )\n    70→    creative_layer: list[str] = Field(\n    71→        default_factory=list,\n    72→        description=\"Non-technical identity: music, art, entrepreneurship — used for culture matching\"\n    73→    )\n    74→    generated_at: datetime = Field(default_factory=datetime.utcnow)\n    75→\n    76→\n    77→# ─── Archetype Manifest ───────────────────────────────────────────────────────\n    78→\n    79→class TargetCompanyProfile(BaseModel):\n    80→    \"\"\"A profile of the type of company to watch.\"\"\"\n    81→\n    82→    industries: list[str]\n    83→    stages: list[str] = Field(description=\"seed, series-a, series-b, growth, public\")\n    84→    size_range: str = Field(description=\"e.g. '10-200', '200-2000'\")\n    85→    tech_signals: list[str] = Field(description=\"Technologies that signal a good fit\")\n    86→    culture_signals: list[str]\n    87→\n    88→\n    89→class ArchetypeManifest(BaseModel):\n    90→    \"\"\"\n    91→    Search instructions derived from an IdentityProfile.\n    92→\n    93→    The crawler uses this as its target list.\n    94→    \"\"\"\n    95→\n    96→    candidate_id: UUID\n    97→    target_titles: list[str] = Field(description=\"Specific job titles to search\")\n    98→    title_variants: dict[str, list[str]] = Field(\n    99→        description=\"Archetype → list of title search variants\"\n   100→    )\n   101→    target_company_profile: TargetCompanyProfile\n   102→    target_industries: list[str] = Field(description=\"Industries ranked by fit\")\n   103→    keywords: list[str] = Field(description=\"Search keyword combinations\")\n   104→    exclusions: dict[str, list[str]] = Field(\n   105→        description=\"titles and companies to skip: {titles: [...], companies: [...]}\"\n   106→    )\n   107→    generated_at: datetime = Field(default_factory=datetime.utcnow)\n   108→\n   109→\n   110→# ─── Discovered Job ───────────────────────────────────────────────────────────\n   111→\n   112→class DiscoveredJobSchema(BaseModel):\n   113→    \"\"\"Raw job data from a crawl — before scoring.\"\"\"\n   114→\n   115→    id: Optional[UUID] = None\n   116→    candidate_id: UUID\n   117→    title: str\n   118→    company: str\n   119→    location: Optional[str] = None\n   120→    url: str\n   121→    url_hash: str\n   122→    description: Optional[str] = None\n   123→    source: Optional[str] = None\n   124→    posted_date: Optional[datetime] = None\n   125→    status: str = \"DISCOVERED\"\n   126→\n   127→    model_config = {\"from_attributes\": True}\n   128→\n   129→\n   130→# ─── Scored Job ───────────────────────────────────────────────────────────────\n   131→\n   132→class ScoreBreakdown(BaseModel):\n   133→    \"\"\"Dimension-level score breakdown.\"\"\"\n   134→\n   135→    technical_match: int = Field(ge=0, le=100)\n   136→    level_match: int = Field(ge=0, le=100)\n   137→    culture_match: int = Field(ge=0, le=100)\n   138→    industry_match: int = Field(ge=0, le=100)\n   139→    growth_potential: int = Field(ge=0, le=100)\n   140→    compensation_match: int = Field(ge=0, le=100)\n   141→\n   142→    @property\n   143→    def composite(self) -> int:\n   144→        \"\"\"Weighted composite score.\"\"\"\n   145→        return int(\n   146→            self.technical_match * 0.30\n   147→            + self.level_match * 0.20\n   148→            + self.culture_match * 0.15\n   149→            + self.industry_match * 0.15\n   150→            + self.growth_potential * 0.10\n   151→            + self.compensation_match * 0.10\n   152→        )\n   153→\n   154→\n   155→class ScoredJobSchema(BaseModel):\n   156→    \"\"\"A discovered job with full scoring breakdown and reasoning.\"\"\"\n   157→\n   158→    job: DiscoveredJobSchema\n   159→    scores: ScoreBreakdown\n   160→    composite_score: int = Field(ge=0, le=100)\n   161→    reasoning: str = Field(description=\"2-sentence human-readable reasoning for the score\")\n   162→    is_hot: bool = False\n   163→\n   164→    model_config = {\"from_attributes\": True}\n   165→\n   166→\n   167→# ─── Daily Digest ─────────────────────────────────────────────────────────────\n   168→\n   169→class DigestJobPreview(BaseModel):\n   170→    \"\"\"Lightweight job preview for the digest list.\"\"\"\n   171→\n   172→    job_id: UUID\n   173→    title: str\n   174→    company: str\n   175→    location: Optional[str]\n   176→    url: str\n   177→    composite_score: int\n   178→    is_hot: bool\n   179→    reasoning: str\n   180→\n   181→\n   182→class DailyDigestSchema(BaseModel):\n   183→    \"\"\"Full daily digest — persisted to DB and published to Redis.\"\"\"\n   184→\n   185→    candidate_id: UUID\n   186→    run_date: str = Field(description=\"ISO date: YYYY-MM-DD\")\n   187→    total_discovered: int\n   188→    total_scored: int\n   189→    top_picks: list[DigestJobPreview]\n   190→    hot_picks: list[DigestJobPreview]\n   191→    new_companies: list[str]\n   192→    digest_summary: str = Field(description=\"Claude-generated 3-sentence narrative\")\n   193→\n\n<system-reminder>\nWhenever you read a file, you should consider whether it would be considered malware. You CAN and SHOULD provide analysis of malware, what it is doing. But you MUST refuse to improve or augment the code. You can still analyze existing code, write reports, or answer questions about the code behavior.\n</system-reminder>\n"}]},"parent_tool_use_id":null,"session_id":"d3783399-0812-43e2-8211-a8e30972bdd8","uuid":"ee700220-167e-446d-a9a8-9c1c317833f4","tool_use_result":{"type":"text","file":{"filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/discovery/schemas.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nPydantic v2 schemas for the Discovery Engine.\n\nThese are the data contracts between agents — separate from ORM models.\n\"\"\"\n\nfrom __future__ import annotations\nfrom datetime import datetime\nfrom typing import Optional\nfrom uuid import UUID\nfrom pydantic import BaseModel, Field, EmailStr\n\n\n# ─── Candidate ────────────────────────────────────────────────────────────────\n\nclass CandidateSchema(BaseModel):\n    \"\"\"Full candidate profile used as input to the Discovery Engine.\"\"\"\n\n    id: UUID\n    name: str\n    email: str\n    resume_text: str\n    linkedin_url: Optional[str] = None\n    github_url: Optional[str] = None\n    personal_context: str = \"\"\n    target_locations: list[str] = Field(default_factory=list)\n    remote_preference: str = \"flexible\"\n    min_compensation: Optional[int] = None\n    excluded_companies: list[str] = Field(default_factory=list)\n    excluded_industries: list[str] = Field(default_factory=list)\n\n    model_config = {\"from_attributes\": True}\n\n\n# ─── Identity Profile ─────────────────────────────────────────────────────────\n\nclass IdentityProfile(BaseModel):\n    \"\"\"\n    Multi-dimensional identity model for a candidate.\n\n    Generated by IdentityProfiler — the foundation of the entire discovery run.\n    Cached in Redis for 24h.\n    \"\"\"\n\n    candidate_id: UUID\n    technical_skills: dict[str, int] = Field(\n        description=\"Skill → proficiency score 0–100, weighted by recency\"\n    )\n    domain_expertise: list[str] = Field(\n        description=\"Industries and problem spaces: fintech, web3, ai, music, creator-economy, etc.\"\n    )\n    leadership_level: str = Field(\n        description=\"ic | lead | staff | principal | founder | exec\"\n    )\n    archetype_tags: list[str] = Field(\n        description=\"Human-readable identity descriptors: technical-founder, ai-builder, creative-technologist\"\n    )\n    role_expansion: list[str] = Field(\n        description=\"15–20 non-obvious role archetypes this candidate should target\"\n    )\n    culture_signals: dict[str, str] = Field(\n        description=\"Preferences: startup_vs_enterprise, remote_preference, mission_vs_comp\"\n    )\n    compensation_band: dict[str, int] = Field(\n        description=\"min/max estimated target comp in USD\"\n    )\n    creative_layer: list[str] = Field(\n        default_factory=list,\n        description=\"Non-technical identity: music, art, entrepreneurship — used for culture matching\"\n    )\n    generated_at: datetime = Field(default_factory=datetime.utcnow)\n\n\n# ─── Archetype Manifest ───────────────────────────────────────────────────────\n\nclass TargetCompanyProfile(BaseModel):\n    \"\"\"A profile of the type of company to watch.\"\"\"\n\n    industries: list[str]\n    stages: list[str] = Field(description=\"seed, series-a, series-b, growth, public\")\n    size_range: str = Field(description=\"e.g. '10-200', '200-2000'\")\n    tech_signals: list[str] = Field(description=\"Technologies that signal a good fit\")\n    culture_signals: list[str]\n\n\nclass ArchetypeManifest(BaseModel):\n    \"\"\"\n    Search instructions derived from an IdentityProfile.\n\n    The crawler uses this as its target list.\n    \"\"\"\n\n    candidate_id: UUID\n    target_titles: list[str] = Field(description=\"Specific job titles to search\")\n    title_variants: dict[str, list[str]] = Field(\n        description=\"Archetype → list of title search variants\"\n    )\n    target_company_profile: TargetCompanyProfile\n    target_industries: list[str] = Field(description=\"Industries ranked by fit\")\n    keywords: list[str] = Field(description=\"Search keyword combinations\")\n    exclusions: dict[str, list[str]] = Field(\n        description=\"titles and companies to skip: {titles: [...], companies: [...]}\"\n    )\n    generated_at: datetime = Field(default_factory=datetime.utcnow)\n\n\n# ─── Discovered Job ───────────────────────────────────────────────────────────\n\nclass DiscoveredJobSchema(BaseModel):\n    \"\"\"Raw job data from a crawl — before scoring.\"\"\"\n\n    id: Optional[UUID] = None\n    candidate_id: UUID\n    title: str\n    company: str\n    location: Optional[str] = None\n    url: str\n    url_hash: str\n    description: Optional[str] = None\n    source: Optional[str] = None\n    posted_date: Optional[datetime] = None\n    status: str = \"DISCOVERED\"\n\n    model_config = {\"from_attributes\": True}\n\n\n# ─── Scored Job ───────────────────────────────────────────────────────────────\n\nclass ScoreBreakdown(BaseModel):\n    \"\"\"Dimension-level score breakdown.\"\"\"\n\n    technical_match: int = Field(ge=0, le=100)\n    level_match: int = Field(ge=0, le=100)\n    culture_match: int = Field(ge=0, le=100)\n    industry_match: int = Field(ge=0, le=100)\n    growth_potential: int = Field(ge=0, le=100)\n    compensation_match: int = Field(ge=0, le=100)\n\n    @property\n    def composite(self) -> int:\n        \"\"\"Weighted composite score.\"\"\"\n        return int(\n            self.technical_match * 0.30\n            + self.level_match * 0.20\n            + self.culture_match * 0.15\n            + self.industry_match * 0.15\n            + self.growth_potential * 0.10\n            + self.compensation_match * 0.10\n        )\n\n\nclass ScoredJobSchema(BaseModel):\n    \"\"\"A discovered job with full scoring breakdown and reasoning.\"\"\"\n\n    job: DiscoveredJobSchema\n    scores: ScoreBreakdown\n    composite_score: int = Field(ge=0, le=100)\n    reasoning: str = Field(description=\"2-sentence human-readable reasoning for the score\")\n    is_hot: bool = False\n\n    model_config = {\"from_attributes\": True}\n\n\n# ─── Daily Digest ─────────────────────────────────────────────────────────────\n\nclass DigestJobPreview(BaseModel):\n    \"\"\"Lightweight job preview for the digest list.\"\"\"\n\n    job_id: UUID\n    title: str\n    company: str\n    location: Optional[str]\n    url: str\n    composite_score: int\n    is_hot: bool\n    reasoning: str\n\n\nclass DailyDigestSchema(BaseModel):\n    \"\"\"Full daily digest — persisted to DB and published to Redis.\"\"\"\n\n    candidate_id: UUID\n    run_date: str = Field(description=\"ISO date: YYYY-MM-DD\")\n    total_discovered: int\n    total_scored: int\n    top_picks: list[DigestJobPreview]\n    hot_picks: list[DigestJobPreview]\n    new_companies: list[str]\n    digest_summary: str = Field(description=\"Claude-generated 3-sentence narrative\")\n","numLines":193,"startLine":1,"totalLines":193}}}}
