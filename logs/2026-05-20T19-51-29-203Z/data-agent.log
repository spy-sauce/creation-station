;\n"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":3700,"cache_read_input_tokens":75842,"cache_creation":{"ephemeral_5m_input_tokens":3700,"ephemeral_1h_input_tokens":0},"output_tokens":559,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"d3783399-0812-43e2-8211-a8e30972bdd8","uuid":"19fa6290-3e8d-46c8-9626-5d7b3c2c00af"}}
