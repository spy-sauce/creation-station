pped[Optional[list]] = mapped_column(ARRAY(String))\n    40→    pain_points: Mapped[Optional[str]] = mapped_column(Text)\n    41→    culture_signals: Mapped[Optional[dict]] = mapped_column(JSON)\n    42→    tone: Mapped[Optional[str]] = mapped_column(String(50))\n    43→    comp_mentioned: Mapped[Optional[str]] = mapped_column(String(255))\n    44→    red_flags: Mapped[Optional[list]] = mapped_column(ARRAY(String))\n    45→    application_instructions: Mapped[Optional[str]] = mapped_column(Text)\n    46→    team_context: Mapped[Optional[str]] = mapped_column(Text)\n    47→    raw_data: Mapped[Optional[dict]] = mapped_column(JSON)\n    48→    created_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), server_default=func.now())\n    49→\n    50→\n    51→class TailoredResume(Base):\n    52→    \"\"\"Version-controlled tailored resume for a specific job application.\"\"\"\n    53→\n    54→    __tablename__ = \"tailored_resumes\"\n    55→\n    56→    id: Mapped[uuid.UUID] = mapped_column(UUID(as_uuid=True), primary_key=True, default=uuid.uuid4)\n    57→    job_id: Mapped[uuid.UUID] = mapped_column(ForeignKey(\"discovered_jobs.id\"), nullable=False)\n    58→    candidate_id: Mapped[uuid.UUID] = mapped_column(ForeignKey(\"candidates.id\"), nullable=False)\n    59→    summary: Mapped[Optional[str]] = mapped_column(Text)\n    60→    full_text: Mapped[str] = mapped_column(Text, nullable=False)\n    61→    change_log: Mapped[Optional[str]] = mapped_column(Text)\n    62→    pdf_path: Mapped[Optional[str]] = mapped_column(String(500))\n    63→    version: Mapped[int] = mapped_column(Integer, default=1)\n    64→    created_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), server_default=func.now())\n    65→\n    66→\n    67→class CompanyIntel(Base):\n    68→    \"\"\"Cached company research. TTL: 7 days — don't re-scrape within a week.\"\"\"\n    69→\n    70→    __tablename__ = \"company_intel\"\n    71→\n    72→    id: Mapped[uuid.UUID] = mapped_column(UUID(as_uuid=True), primary_key=True, default=uuid.uuid4)\n    73→    company_name: Mapped[str] = mapped_column(String(255), nullable=False, index=True)\n    74→    domain: Mapped[Optional[str]] = mapped_column(String(255))\n    75→    about: Mapped[Optional[str]] = mapped_column(Text)\n    76→    recent_news: Mapped[Optional[str]] = mapped_column(Text)\n    77→    tech_stack: Mapped[Optional[list]] = mapped_column(ARRAY(String))\n    78→    engineering_culture: Mapped[Optional[str]] = mapped_column(Text)\n    79→    glassdoor_signals: Mapped[Optional[str]] = mapped_column(Text)\n    80→    growth_stage: Mapped[Optional[str]] = mapped_column(String(100))\n    81→    team_size: Mapped[Optional[str]] = mapped_column(String(100))\n    82→    notable_facts: Mapped[Optional[str]] = mapped_column(Text)\n    83→    cache_expires_at: Mapped[Optional[datetime]] = mapped_column(DateTime(timezone=True))\n    84→    created_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), server_default=func.now())\n    85→    updated_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), server_default=func.now(), onupdate=func.now())\n    86→\n    87→    contacts: Mapped[list[\"Contact\"]] = relationship(back_populates=\"company_intel\")\n    88→\n    89→\n    90→class Contact(Base):\n    91→    \"\"\"A contact person discovered for a company (hiring manager, eng lead, etc.).\"\"\"\n    92→\n    93→    __tablename__ = \"contacts\"\n    94→\n    95→    id: Mapped[uuid.UUID] = mapped_column(UUID(as_uuid=True), primary_key=True, default=uuid.uuid4)\n    96→    company_intel_id: Mapped[Optional[uuid.UUID]] = mapped_column(ForeignKey(\"company_intel.id\"))\n    97→    name: Mapped[Optional[str]] = mapped_column(String(255))\n    98→    title: Mapped[Optional[str]] = mapped_column(String(255))\n    99→    email: Mapped[Optional[str]] = mapped_column(String(255))\n   100→    linkedin_url: Mapped[Optional[str]] = mapped_column(String(500))\n   101→    confidence: Mapped[str] = mapped