───────────────────────────────────────────────────────\n   146→\n   147→\n   148→class DailyDigestSchema(BaseModel):\n   149→    \"\"\"Full daily digest — persisted to DB and published to Redis.\"\"\"\n   150→\n   151→    model_config = ConfigDict(from_attributes=True)\n   152→\n   153→    id: Optional[UUID] = None\n   154→    candidate_id: UUID\n   155→    run_date: str = Field(description=\"ISO date: YYYY-MM-DD\")\n   156→    top_picks: list[ScoredJobSchema] = Field(default_factory=list)\n   157→    hot_picks: list[ScoredJobSchema] = Field(default_factory=list)\n   158→    new_companies: list[str] = Field(default_factory=list)\n   159→    total_jobs_discovered: int = 0\n   160→    total_jobs_scored: int = 0\n   161→    created_at: Optional[datetime] = None\n   162→"}]},"parent_tool_use_id":null,"session_id":"d3783399-0812-43e2-8211-a8e30972bdd8","uuid":"a9ac38b1-58fa-429f-b1ac-44d6f6441e6d","tool_use_result":{"type":"update","filePath":"/Users/spy/mfautomation/repos/creation-station/reverse-search/backend/agents/discovery/schemas.py","content":"# Copyright 2026 VibeSpace LLC\n# Licensed under the Apache License, Version 2.0\n\n\"\"\"\nPydantic v2 schemas for the Discovery Engine.\n\nThese are the data contracts between agents — separate from ORM models.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import datetime\nfrom typing import Optional\nfrom uuid import UUID\n\nfrom pydantic import BaseModel, Field, ConfigDict\n\n\n# ─── Candidate ────────────────────────────────────────────────────────────────\n\n\nclass CandidateSchema(BaseModel):\n    \"\"\"Full candidate profile used as input to the Discovery Engine.\"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: UUID\n    name: str\n    email: str\n    resume_text: str\n    linkedin_url: Optional[str] = None\n    github_url: Optional[str] = None\n    personal_context: Optional[str] = None\n    target_locations: list[str] = Field(default_factory=list)\n    remote_preference: str = \"flexible\"\n    min_compensation: Optional[int] = None\n    excluded_companies: list[str] = Field(default_factory=list)\n    excluded_industries: list[str] = Field(default_factory=list)\n    created_at: Optional[datetime] = None\n    updated_at: Optional[datetime] = None\n\n\n# ─── Identity Profile ─────────────────────────────────────────────────────────\n\n\nclass IdentityProfileSchema(BaseModel):\n    \"\"\"\n    Multi-dimensional identity model for a candidate.\n\n    Generated by IdentityProfiler — the foundation of the entire discovery run.\n    Cached in Redis for 24h.\n    \"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    archetypes: list[str] = Field(default_factory=list)\n    leadership_level: str = Field(\n        default=\"IC\",\n        description=\"IC | Lead | Manager | Director | VP | C-Level\",\n    )\n    technical_skills: list[str] = Field(default_factory=list)\n    soft_skills: list[str] = Field(default_factory=list)\n    industry_experience: list[str] = Field(default_factory=list)\n    notable_achievements: list[str] = Field(default_factory=list)\n    career_trajectory: str = \"\"\n    ideal_role_description: str = \"\"\n    signals: dict[str, str] = Field(default_factory=dict)\n\n\n# ─── Search Manifest ─────────────────────────────────────────────────────────\n\n\nclass SearchManifestSchema(BaseModel):\n    \"\"\"Search instructions derived from an IdentityProfile.\"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    target_titles: list[str] = Field(default_factory=list)\n    keywords: list[str] = Field(default_factory=list)\n    excluded_titles: list[str] = Field(default_factory=list)\n    excluded_companies: list[str] = Field(default_factory=list)\n    excluded_industries: list[str] = Field(default_factory=list)\n    location_filters: list[str] = Field(default_factory=list)\n    remote_preference: str = \"flexible\"\n    min_compensation: Optional[int] = None\n\n\n# ─── Discovered Job ───────────────────────────────────────────────────────────\n\n\nclass DiscoveredJobSchema(BaseModel):\n    \"\"\"Raw job data from a crawl — before scoring.\"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    source: str\n    source_id: str\n    title: str\n    company: str\n    location: Optional[str] = None\n    description: Optional[str] = None\n    url: str\n    posted_at: Optional[datetime] = None\n    salary_min: Optional[int] = None\n    salary_max: Optional[int] = None\n    remote: bool = False\n    crawled_at: Optional[datetime] = None\n\n\n# ─── Score Breakdown ─────────────────────────────────────────────────────────\n\n\nclass ScoreBreakdown(BaseModel):\n    \"\"\"Dimension-level score breakdown (0-100 per dimension).\"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    technical_match: int = Field(ge=0, le=100)\n    level_match: int = Field(ge=0, le=100)\n    culture_match: int = Field(ge=0, le=100)\n    industry_match: int = Field(ge=0, le=100)\n    growth_potential: int = Field(ge=0, le=100)\n    compensation_match: int = Field(ge=0, le=100)\n\n\n# ─── Scored Job ───────────────────────────────────────────────────────────────\n\n\nclass ScoredJobSchema(BaseModel):\n    \"\"\"A discovered job with full scoring breakdown and reasoning.\"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    discovered_job_id: UUID\n    candidate_id: UUID\n    score_breakdown: ScoreBreakdown\n    composite_score: int = Field(ge=0, le=100)\n    is_hot: bool = False\n    reasoning: str\n    scored_at: Optional[datetime] = None\n\n\n# ─── Daily Digest ─────────────────────────────────────────────────────────────\n\n\nclass DailyDigestSchema(BaseModel):\n    \"\"\"Full daily digest — persisted to DB and published to Redis.\"\"\"\n\n    model_config = ConfigDict(from_attributes=True)\n\n    id: Optional[UUID] = None\n    candidate_id: UUID\n    run_date: str = Field(description=\"ISO date: YYYY-MM-DD\")\n    top_picks: list[ScoredJobSchema] = Field(default_factory=list)\n    hot_picks: list[ScoredJobSchema] = Field(default_factory=list)\n    new_companies: list[str] = Field(default_factory=list)\n    total_jobs_discovered: int = 0\n    total_jobs_scored: int = 0\n    created_at: Optional[datetime] = None\n","structuredPatch":[{"oldStart":8,"oldLines":36,"newStart":8,"newLines":42,"lines":[" \"\"\""," "," from __future__ import annotations","+"," from datetime import datetime"," from typing import Optional"," from uuid import UUID","-from pydantic import BaseModel, Field, EmailStr"," ","+from pydantic import BaseModel, Field, ConfigDict"," ","+"," # ─── Candidate ────────────────────────────────────────────────────────────────"," ","+"," class CandidateSchema(BaseModel):","     \"\"\"Full candidate profile used as input to the Discovery Engine.\"\"\""," ","+    model_config = ConfigDict(from_attributes=True)","+","     id: UUID","     name: str","     email: str","     resume_text: str","     linkedin_url: Optional[str] = None","     github_url: Optional[str] = None","-    personal_context: str = \"\"","+    personal_context: Optional[str] = None","     target_locations: list[str] = Field(default_factory=list)","     remote_preference: str = \"flexible\"","     min_compensation: Optional[int] = None","     excluded_companies: list[str] = Field(default_factory=list)","     excluded_industries: list[str] = Field(default_factory=list)","+    created_at: Optional[datetime] = None","+    updated_at: Optional[datetime] = None"," ","-    model_config = {\"from_attributes\": True}"," ","-"," # ─── Identity Profile ─────────────────────────────────────────────────────────"," ","-class IdentityProfile(BaseModel):","+","+class IdentityProfileSchema(BaseModel):","     \"\"\"","     Multi-dimensional identity model for a candidate."," "]},{"oldStart":45,"oldLines":93,"newStart":51,"newLines":71,"lines":["     Cached in Redis for 24h.","     \"\"\""," ","-    cand